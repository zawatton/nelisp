#!/usr/bin/env bash
# nemacs — nelisp-emacs Layer 2 launcher
#
# Wraps the host Emacs (default driver) or `nelisp` (experimental driver)
# so that users can spawn nemacs the same way they would spawn Emacs.
# Usage shape mirrors `emacs --batch ...`:
#
#   nemacs                          interactive TUI runner
#   nemacs --batch                  batch entry (= boots, runs --eval/-l, exits)
#   nemacs -q|--no-init-file        skip user early-init.el/init.el
#   nemacs -Q|--quick               skip user init and package startup
#   nemacs --batch -l FILE          batch + load FILE
#   nemacs --batch -L DIR           batch + prepend DIR to load-path
#   nemacs --batch -f FUNCTION      batch + call FUNCTION after load/eval
#   nemacs --batch --runtime-image FILE load a NeLisp .nlri runtime image first
#   nemacs --runtime-image auto       choose build/*.nlri by batch/interactive mode
#   nemacs --cold-image FILE --cold-artifact FILE
#                                  prepare/use a validated flat-arena cold image
#   nemacs --batch --load-image FILE legacy: restore Lisp-visible .nli state
#   nemacs --batch --eval FORM      batch + eval FORM
#   nemacs --batch -l a -l b --eval '(...)'
#   nemacs --driver=nelisp ...      use NeLisp as driver
#   nemacs --driver=host ...        force host emacs driver (= default)
#   nemacs --print-paths            dump the resolved load-path / vendor root
#   nemacs --doctor                 run host/NeLisp driver readiness checks
#   nemacs --version                print nemacs version + driver
#   nemacs --help                   this message
#
# Environment overrides:
#   NEMACS_HOME      directory containing src/ (default: this script's parent)
#   NELISP_HOME      nelisp checkout (default: vendor/nelisp, then ../nelisp)
#   NEMACS_DRIVER    `host' (default) or `nelisp'
#   NEMACS_EMACS     emacs binary path (default: emacs)
#   NEMACS_NELISP    nelisp binary path (default: standalone-reader)
#   NEMACS_NELISP_STACK stack limit for the nelisp driver (default: unlimited)
#   NEMACS_BOOTSTRAP_BUNDLE optional generated NeLisp preload bundle
#                    (default: $NEMACS_HOME/build/nemacs-bootstrap.el)
#   NEMACS_BOOTSTRAP_REPL optional generated NeLisp REPL bootstrap input
#                    (default: $NEMACS_HOME/build/nemacs-bootstrap.repl)
#   NEMACS_RUNTIME_IMAGE optional NeLisp .nlri runtime image for --driver=nelisp
#                    (set to `auto' to choose build/*.nlri by mode)
#   NEMACS_COLD_IMAGE flat-arena cold image output/cache path
#                    (default: ${XDG_CACHE_HOME:-$HOME/.cache}/nemacs/)
#   NEMACS_COLD_ARTIFACT bootstrap .neln cache path
#                    (default: beside NEMACS_COLD_IMAGE)
#   NEMACS_COLD_CACHE_ROOT root for binary-keyed cold cache entries
#                    (default: ${XDG_CACHE_HOME:-$HOME/.cache}/nemacs)
#   NEMACS_DISABLE_COLD_CACHE set to 1/t/true/yes to use normal bootstrap
#   NEMACS_COLD_LOCK_TIMEOUT seconds to wait for another cache builder
#                    (default: 120)

set -euo pipefail

SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)"
NEMACS_HOME="${NEMACS_HOME:-$(cd "$SCRIPT_PATH/.." && pwd)}"

# NeLisp provides a pure-Elisp standalone reader at target/nelisp.
# Prefer this repo's vendored checkout,
# then the common sibling checkout used during joint development, then
# the legacy ~/Notes/dev path.
DEFAULT_VENDOR_NELISP="$NEMACS_HOME/vendor/nelisp"
DEFAULT_SIBLING_NELISP="$(cd "$NEMACS_HOME/.." && pwd)/nelisp"
DEFAULT_LEGACY_NELISP="$HOME/Notes/dev/nelisp"
nelisp_default_bin() {
  local root="$1"
  if [[ -x "$root/target/nelisp" ]]; then
    printf '%s\n' "$root/target/nelisp"
    return 0
  fi
  if [[ -x "$root/target/nelisp-standalone-reader" ]]; then
    printf '%s\n' "$root/target/nelisp-standalone-reader"
  fi
}
if [[ -z "${NELISP_HOME:-}" ]]; then
  if [[ -n "$(nelisp_default_bin "$DEFAULT_VENDOR_NELISP")" ]]; then
    NELISP_HOME="$DEFAULT_VENDOR_NELISP"
  elif [[ -n "$(nelisp_default_bin "$DEFAULT_SIBLING_NELISP")" ]]; then
    NELISP_HOME="$DEFAULT_SIBLING_NELISP"
  elif [[ -n "$(nelisp_default_bin "$DEFAULT_LEGACY_NELISP")" ]]; then
    NELISP_HOME="$DEFAULT_LEGACY_NELISP"
  else
    NELISP_HOME="$DEFAULT_VENDOR_NELISP"
  fi
fi
NEMACS_DRIVER="${NEMACS_DRIVER:-host}"
NEMACS_EMACS="${NEMACS_EMACS:-emacs}"
NEMACS_NELISP="${NEMACS_NELISP:-$(nelisp_default_bin "$NELISP_HOME")}"
NEMACS_NELISP="${NEMACS_NELISP:-$NELISP_HOME/target/nelisp}"
NEMACS_NELISP_STACK="${NEMACS_NELISP_STACK:-unlimited}"
# Address-space cap (ulimit -v, KiB) for the nelisp driver.  The standalone
# reader only reclaims transient allocations at top-level form boundaries, so a
# long-lived single form (e.g. the `nemacs-main--event-loop' while form) leaks
# ~8 KiB/iteration and can grow unbounded (Doc 152 §11.33/§11.34).  Capping the
# address space makes a runaway exit cleanly (rc=88 on mmap failure) at the
# limit instead of exhausting host RAM and freezing the machine.  8 GiB is far
# above any legitimate editor session (baseline ~60 MiB) yet well under host RAM.
# Set NEMACS_NELISP_MEMORY=unlimited to disable.
NEMACS_NELISP_MEMORY="${NEMACS_NELISP_MEMORY:-8388608}"
NEMACS_BOOTSTRAP_BUNDLE="${NEMACS_BOOTSTRAP_BUNDLE:-$NEMACS_HOME/build/nemacs-bootstrap.el}"
NEMACS_BOOTSTRAP_REPL="${NEMACS_BOOTSTRAP_REPL:-$NEMACS_HOME/build/nemacs-bootstrap.repl}"
NEMACS_RUNTIME_IMAGE="${NEMACS_RUNTIME_IMAGE:-}"

# A flat arena is tied to the exact NeLisp executable that wrote it.  Content
# hashing alone is insufficient: an unchanged copy at a different path, or a
# binary replaced with bytes that retain the same digest but different file
# metadata, is a distinct runtime identity for cache-validity purposes.  Keep
# the record human-readable in the source sidecar and hash it only for the
# default cache directory name.  The shipped standalone reader has no
# successful `--version' command, so do not start it merely to add a version
# string; its path and stat identity are available without runtime startup.
NEMACS_NELISP_IDENTITY_PATH="$NEMACS_NELISP"
identity_dir="$(dirname -- "$NEMACS_NELISP")"
if identity_dir="$(cd "$identity_dir" 2>/dev/null && pwd -P)"; then
  NEMACS_NELISP_IDENTITY_PATH="$identity_dir/$(basename -- "$NEMACS_NELISP")"
elif [[ "$NEMACS_NELISP" != /* ]]; then
  NEMACS_NELISP_IDENTITY_PATH="$(pwd -P)/$NEMACS_NELISP"
fi
NEMACS_NELISP_IDENTITY_SIZE="$(stat -Lc '%s' -- "$NEMACS_NELISP" 2>/dev/null || printf 'unavailable')"
NEMACS_NELISP_IDENTITY_MTIME="$(stat -Lc '%Y:%y' -- "$NEMACS_NELISP" 2>/dev/null || printf 'unavailable')"
NEMACS_NELISP_IDENTITY="$(printf 'v1\npath=%s\nsize=%s\nmtime=%s\n' \
  "$NEMACS_NELISP_IDENTITY_PATH" \
  "$NEMACS_NELISP_IDENTITY_SIZE" \
  "$NEMACS_NELISP_IDENTITY_MTIME")"
NEMACS_COLD_CACHE_KEY="$(printf '%s\n' "$NEMACS_NELISP_IDENTITY" |
  sha256sum | awk '{print $1}')"
NEMACS_COLD_CACHE_ROOT="${NEMACS_COLD_CACHE_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/nemacs}"
NEMACS_COLD_CACHE_DIR="$NEMACS_COLD_CACHE_ROOT/$NEMACS_COLD_CACHE_KEY"
NEMACS_COLD_ARTIFACT="${NEMACS_COLD_ARTIFACT:-$NEMACS_COLD_CACHE_DIR/nemacs-bootstrap.neln}"
NEMACS_COLD_IMAGE="${NEMACS_COLD_IMAGE:-$NEMACS_COLD_CACHE_DIR/nemacs-bootstrap.flat.nlri}"
NEMACS_DISABLE_COLD_CACHE="${NEMACS_DISABLE_COLD_CACHE:-}"
# Set to 0 to always ask `compile-runtime-image' itself whether the cached
# image is current, instead of the cheap sidecar probe (see `cold_cache_probe_hit').
NEMACS_COLD_CACHE_PROBE="${NEMACS_COLD_CACHE_PROBE:-1}"
# Build the cold image by loading the source bundle, not by replaying the
# `.neln' AOT artifact.  Set to 0 for the old artifact route.
#
# Measured 2026-08-12, same machine, both routes tried on both binaries:
#
#                       source route          .neln replay
#   dev bin 4268fe9a    131 s  rc=0  82 MB    4949 s  rc=1
#   vendor  e6eae129    133 s  rc=0  82 MB    2913 s  rc=139 (SEGV)
#
# The replay route did not produce an image at all in either attempt, and the
# one it produced earlier (2026-08-11, 116 MB, still in the cache) is broken:
# on a 22-check functional probe it failed 6, including `(void-function
# point-max)', and `with-temp-buffer' did not isolate, so every check wrote
# into the shared scratch buffer.  Cause: replaying through the sandbox
# evaluator puts names in `nelisp--functions' without installing the host
# function cell -- `point-max' is IN-TABLE with `fboundp' nil while `point-min'
# has a cell.  The source route installs host cells directly and has no sandbox
# table at all, which src/nelisp-bytecode.el:2087 documents as the correct
# standalone shape.  Same probe on the source image: 22/22, ~1 s.
NEMACS_COLD_SOURCE_ROUTE="${NEMACS_COLD_SOURCE_ROUTE:-1}"
NEMACS_COLD_SIDECAR="${NEMACS_COLD_SIDECAR:-$NEMACS_COLD_IMAGE.srcinputs}"
NEMACS_COLD_LOCK_TIMEOUT="${NEMACS_COLD_LOCK_TIMEOUT:-120}"
NEMACS_BATCH_RUNTIME_IMAGE="${NEMACS_BATCH_RUNTIME_IMAGE:-$NEMACS_HOME/build/nemacs-runtime.nlri}"
NEMACS_INTERACTIVE_RUNTIME_IMAGE="${NEMACS_INTERACTIVE_RUNTIME_IMAGE:-$NEMACS_HOME/build/nemacs-interactive-runtime.nlri}"
NEMACS_VENDOR_CORE_RUNTIME_IMAGE="${NEMACS_VENDOR_CORE_RUNTIME_IMAGE:-$NEMACS_HOME/build/nemacs-vendor-core-runtime.nlri}"
NEMACS_KEEP_REPL_BOOT="${NEMACS_KEEP_REPL_BOOT:-}"
if [[ "$NEMACS_BOOTSTRAP_BUNDLE" == "none" ]]; then
  NEMACS_BOOTSTRAP_BUNDLE=""
fi
NEMACS_VERSION="0.1.0-mvp"

usage() {
  sed -n '2,30p' "$0"
}

print_paths() {
  cat <<EOF
nemacs paths:
  NEMACS_HOME      = $NEMACS_HOME
  NELISP_HOME      = $NELISP_HOME
  NEMACS_DRIVER    = $NEMACS_DRIVER
  NEMACS_EMACS     = $NEMACS_EMACS
  NEMACS_NELISP    = $NEMACS_NELISP
  NEMACS_NELISP_STACK = $NEMACS_NELISP_STACK
  NEMACS_NELISP_MEMORY = $NEMACS_NELISP_MEMORY
  NEMACS_BOOTSTRAP_BUNDLE = ${NEMACS_BOOTSTRAP_BUNDLE:-<disabled>}
  NEMACS_BOOTSTRAP_REPL = ${NEMACS_BOOTSTRAP_REPL:-<disabled>}
  NEMACS_RUNTIME_IMAGE = ${NEMACS_RUNTIME_IMAGE:-<disabled>}
  NEMACS_COLD_CACHE_ROOT = $NEMACS_COLD_CACHE_ROOT
  NEMACS_COLD_CACHE_KEY = $NEMACS_COLD_CACHE_KEY
  NEMACS_COLD_IMAGE = $NEMACS_COLD_IMAGE
  NEMACS_COLD_ARTIFACT = $NEMACS_COLD_ARTIFACT
  NEMACS_NELISP_IDENTITY_PATH = $NEMACS_NELISP_IDENTITY_PATH
  NEMACS_NELISP_IDENTITY_SIZE = $NEMACS_NELISP_IDENTITY_SIZE
  NEMACS_NELISP_IDENTITY_MTIME = $NEMACS_NELISP_IDENTITY_MTIME
  NEMACS_DISABLE_COLD_CACHE = ${NEMACS_DISABLE_COLD_CACHE:-<disabled>}
  NEMACS_COLD_CACHE_PROBE = $NEMACS_COLD_CACHE_PROBE
  NEMACS_COLD_SOURCE_ROUTE = $NEMACS_COLD_SOURCE_ROUTE
  NEMACS_COLD_SIDECAR = $NEMACS_COLD_SIDECAR
  NEMACS_COLD_LOCK_TIMEOUT = $NEMACS_COLD_LOCK_TIMEOUT
  NEMACS_BATCH_RUNTIME_IMAGE = $NEMACS_BATCH_RUNTIME_IMAGE
  NEMACS_INTERACTIVE_RUNTIME_IMAGE = $NEMACS_INTERACTIVE_RUNTIME_IMAGE
  NEMACS_VENDOR_CORE_RUNTIME_IMAGE = $NEMACS_VENDOR_CORE_RUNTIME_IMAGE
  src/             = $NEMACS_HOME/src
  vendor/          = $NEMACS_HOME/vendor
EOF
}

doctor_block() {
  local text="$1"
  if [[ -n "$text" ]]; then
    printf '%s\n' "$text" | sed 's/^/    /'
  fi
}

nelisp_driver_kind() {
  case "$(basename "$NEMACS_NELISP")" in
    nelisp|nelisp-standalone-reader) printf '%s\n' "standalone-reader" ;;
    *) printf '%s\n' "cli" ;;
  esac
}

cold_cache_disabled_p() {
  case "$NEMACS_DISABLE_COLD_CACHE" in
    1|t|T|true|TRUE|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

cold_cache_lock_owned=0
cold_cache_lock_dir=""

release_cold_cache_lock() {
  if (( cold_cache_lock_owned )) && [[ -n "$cold_cache_lock_dir" ]]; then
    rm -f "$cold_cache_lock_dir/pid"
    rmdir "$cold_cache_lock_dir" 2>/dev/null || true
  fi
  cold_cache_lock_owned=0
}

acquire_cold_cache_lock() {
  local waited=0 owner=""
  local timeout="$NEMACS_COLD_LOCK_TIMEOUT"
  case "$timeout" in
    ""|*[!0-9]*) timeout=120 ;;
  esac
  cold_cache_lock_dir="${NEMACS_COLD_IMAGE}.lock"
  while ! mkdir "$cold_cache_lock_dir" 2>/dev/null; do
    if [[ -r "$cold_cache_lock_dir/pid" ]]; then
      owner="$(sed -n '1p' "$cold_cache_lock_dir/pid" 2>/dev/null || true)"
      case "$owner" in
        ""|*[!0-9]*) ;;
        *)
          if ! kill -0 "$owner" 2>/dev/null; then
            rm -f "$cold_cache_lock_dir/pid"
            rmdir "$cold_cache_lock_dir" 2>/dev/null || true
            continue
          fi
          ;;
      esac
    fi
    if (( waited >= timeout )); then
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  printf '%s\n' "$$" > "$cold_cache_lock_dir/pid"
  cold_cache_lock_owned=1
  trap 'release_cold_cache_lock' EXIT
  trap 'release_cold_cache_lock; exit 130' INT
  trap 'release_cold_cache_lock; exit 143' TERM HUP
}

compile_bootstrap_artifact() {
  [[ -n "$NEMACS_BOOTSTRAP_BUNDLE" && -r "$NEMACS_BOOTSTRAP_BUNDLE" ]] || return 1
  "$NEMACS_NELISP" compile-elisp-artifact \
    --kind neln \
    --input "$NEMACS_BOOTSTRAP_BUNDLE" \
    --output "$NEMACS_COLD_ARTIFACT" \
    --native-policy opportunistic \
    --load-path "$NEMACS_HOME/src" \
    --load-path "$NEMACS_HOME/vendor/emacs-lisp" \
    --load-path "$NEMACS_HOME/vendor/emacs-lisp/emacs-lisp"
}

# Reached only when the artifact route is enabled -- see
# `cold_artifact_route_available_p' below for why it is off by default.
#
# `compile-runtime-image --flat-artifact-cache' cannot look at the freshness
# sidecar until its artifact runtime is up, and in the standalone reader that
# bootstrap is a fixed cost paid on every start.  Measured 2026-08-10 against a
# deliberately absent input, so only the fixed cost was timed: 531 s total, of
# which 5.7 s is interpreted preamble and 525 s is replaying
# `target/nelisp-artifact-runtime.el.neln'.  Sixty-six stack samples put that
# replay entirely in the tree-walking interpreter -- no bytecode, no native
# frame, 71% of leaves in the allocator/GC -- so the AOT cache buys nothing
# there.
#
# The decision itself reads a 1,874-byte plist and hashes four files.  Run it
# on the bare reader route instead: same predicate
# (`nelisp-artifact--flat-image-cache-sidecar-hit', loaded from source rather
# than replayed), about 4 s.
#
# Only `hit' short-circuits.  `miss', `error', a missing probe, a non-reader
# driver, and any nonzero exit all fall through to the real command, so the
# worst a broken probe can do is cost 4 s -- it cannot approve a stale image.
cold_cache_probe_hit() {
  local probe="$NELISP_HOME/tools/nelisp-flat-image-cache-probe.el"
  [[ "$NEMACS_COLD_CACHE_PROBE" != "0" ]] || return 1
  [[ -r "$probe" ]] || return 1
  [[ "$(nelisp_driver_kind)" == "standalone-reader" ]] || return 1
  local out=""
  out="$(NELISP_HOME="$NELISP_HOME" \
         NELISP_FLAT_CACHE_ARTIFACT="$NEMACS_COLD_ARTIFACT" \
         NELISP_FLAT_CACHE_IMAGE="$NEMACS_COLD_IMAGE" \
         NELISP_FLAT_CACHE_RUNTIME="$NEMACS_NELISP" \
         "$NEMACS_NELISP" --load "$probe")" || return 1
  [[ "$out" == *"flat-image-cache-probe=hit"* ]]
}

# --- cold image, source route ------------------------------------------
#
# The image is a pure function of these four source files plus the NeLisp
# executable identity recorded above.  Freshness is therefore decided in the
# shell with four sha256sums plus stat metadata (~30 ms) instead of by starting
# the runtime: the artifact route had to boot its own artifact runtime before
# it could read a 1,874-byte sidecar, and that bootstrap alone cost 531 s.
cold_source_inputs() {
  printf '%s\n' \
    "$NEMACS_BOOTSTRAP_BUNDLE" \
    "$NEMACS_HOME/scripts/nemacs-runtime-process-preload.el" \
    "$NEMACS_HOME/scripts/nemacs-runtime-frame-tab-preload.el" \
    "$NEMACS_HOME/scripts/nemacs-runtime-image-preload.el"
}

cold_source_route_available_p() {
  [[ "$NEMACS_COLD_SOURCE_ROUTE" != "0" ]] || return 1
  [[ -n "$NEMACS_BOOTSTRAP_BUNDLE" ]] || return 1
  [[ "$(nelisp_driver_kind)" == "standalone-reader" ]] || return 1
  [[ -r "$NEMACS_NELISP" ]] || return 1
  local f
  while read -r f; do
    [[ -r "$f" ]] || return 1
  done < <(cold_source_inputs)
  return 0
}

# Binary identity, inputs' hashes, and the image's own size.  The size catches
# a truncated or half-written image without hashing 82 MB on every start.
cold_source_fingerprint() {
  local sums size
  sums="$(cold_source_inputs | tr '\n' '\0' | xargs -0 sha256sum 2>/dev/null |
          awk '{printf "%s ", $1}')" || return 1
  [[ -n "$sums" ]] || return 1
  size="$(stat -Lc%s "$NEMACS_COLD_IMAGE" 2>/dev/null || echo 0)"
  printf 'v2\nnelisp-cache-key=%s\n%s\nsource-sha256=%s\nimage-size=%s\n' \
    "$NEMACS_COLD_CACHE_KEY" "$NEMACS_NELISP_IDENTITY" "$sums" "$size"
}

cold_source_cache_hit_p() {
  [[ -s "$NEMACS_COLD_IMAGE" ]] || return 1
  [[ -r "$NEMACS_COLD_SIDECAR" ]] || return 1
  [[ "$(cat "$NEMACS_COLD_SIDECAR" 2>/dev/null)" == "$(cold_source_fingerprint)" ]]
}

invalidate_cold_source_cache() {
  rm -f -- "$NEMACS_COLD_IMAGE" "$NEMACS_COLD_SIDECAR" \
    "$NEMACS_COLD_IMAGE.manifest.el"
}

build_cold_image_from_source() {
  local tmp="$NEMACS_COLD_IMAGE.tmp.$$" sidecar_tmp="$NEMACS_COLD_SIDECAR.tmp.$$"
  local drv rc=0
  drv="$(mktemp "${TMPDIR:-/tmp}/nemacs-cold-src.XXXXXX.el")" || return 1
  {
    printf '(progn '
    printf '(load "%s" nil (quote no-message) t t) ' \
      "$NEMACS_HOME/scripts/nemacs-runtime-process-preload.el" \
      "$NEMACS_HOME/scripts/nemacs-runtime-frame-tab-preload.el" \
      "$NEMACS_HOME/scripts/nemacs-runtime-image-preload.el"
    # `-batch' is the verified entry (22/22 functional checks on its image).
    # `nemacs-runtime-image-preload-interactive' bakes the TUI too and would
    # plausibly start faster, but it has not been checked -- do not swap it in
    # without running the probe again.
    printf '(nemacs-runtime-image-preload-batch "%s" "%s") ' \
      "$NEMACS_HOME" "$NEMACS_BOOTSTRAP_BUNDLE"
    printf '(nelisp--arena-dump-image-stream "%s"))\n' "$tmp"
  } > "$drv"
  NELISP_HOME="$NELISP_HOME" "$NEMACS_NELISP" --load "$drv" >/dev/null || rc=$?
  rm -f "$drv"
  if (( rc != 0 )) || [[ ! -s "$tmp" ]]; then
    rm -f "$tmp"
    printf 'flat-image-cache=failed route=source rc=%s\n' "$rc"
    return 1
  fi
  mv -f "$tmp" "$NEMACS_COLD_IMAGE" || { rm -f "$tmp"; return 1; }
  # The artifact route's sidecar describes an image that no longer exists here.
  # Left in place it would let `cold_cache_probe_hit' approve this image on a
  # later fallback run, on evidence about a different file.
  rm -f "$NEMACS_COLD_IMAGE.manifest.el"
  if ! cold_source_fingerprint > "$sidecar_tmp" ||
     ! mv -f "$sidecar_tmp" "$NEMACS_COLD_SIDECAR"; then
    rm -f "$sidecar_tmp" "$NEMACS_COLD_IMAGE"
    return 1
  fi
  printf 'flat-image-cache=rebuilt route=source image=%s (%s B)\n' \
    "$NEMACS_COLD_IMAGE" "$(stat -Lc%s "$NEMACS_COLD_IMAGE" 2>/dev/null || echo '?')"
}

# The artifact route needs `compile-runtime-image --flat-artifact-cache
# --runtime', which turns the .neln bootstrap artifact into a flat .nlri cold
# image.  No released NeLisp has those flags -- they exist only on the abandoned
# local branch `local/pre-v1.1.0-sync-20260828', and the shipped
# `compile-runtime-image' goes the other way (.nlri in, .nelc/.neln out).  So
# the route is off by default: without this gate every cold start printed
# `nelisp: compile-runtime-image: unknown flag --flat-artifact-cache', then paid
# for a full bootstrap AOT compile, then failed the same way again.  The source
# route above uses only shipped CLI and is the supported path.  Set
# NEMACS_FLAT_ARTIFACT_CACHE=1 for a NeLisp build that does carry the flags.
cold_artifact_route_available_p() {
  [[ "${NEMACS_FLAT_ARTIFACT_CACHE:-0}" == "1" ]]
}

prepare_cold_cache() {
  if cold_cache_probe_hit; then
    printf 'flat-image-cache=hit image=%s probe=sidecar\n' "$NEMACS_COLD_IMAGE"
    return 0
  fi
  "$NEMACS_NELISP" compile-runtime-image \
    --flat-artifact-cache \
    --runtime "$NEMACS_NELISP" \
    --input "$NEMACS_COLD_ARTIFACT" \
    --output "$NEMACS_COLD_IMAGE"
}

nelisp_standalone_eval_value() {
  local form="$1"
  local expected="$2"
  local rc out
  set +e
  out=$("$NEMACS_NELISP" --eval "$form" 2>&1)
  rc=$?
  set -e
  local trimmed="${out//[$' \t\r\n']/}"
  # The pure-Elisp standalone reader signals an `--eval' result either by
  # printing the value and exiting 0, or by exiting *with* the value as the
  # process exit code.  Accept both so the readiness probe stays convention-
  # agnostic across reader builds.
  if [[ "$rc" == 0 && "$trimmed" == "$expected" ]]; then
    printf 'exit=%s value=%s\n' "$rc" "$out"
    return 0
  fi
  if [[ "$rc" == "$expected" ]]; then
    printf 'exit=%s value=%s\n' "$rc" "$rc"
    return 0
  fi
  printf 'exit=%s expected-value=%s\n' "$rc" "$expected"
  if [[ -n "$out" ]]; then
    printf '%s\n' "$out"
  fi
  return 1
}

run_doctor() {
  local failures=0
  local out
  local nelisp_kind

  echo "nemacs doctor:"
  echo "  NEMACS_HOME=$NEMACS_HOME"
  echo "  NELISP_HOME=$NELISP_HOME"
  echo "  NEMACS_EMACS=$NEMACS_EMACS"
  echo "  NEMACS_NELISP=$NEMACS_NELISP"

  if out=$("$NEMACS_EMACS" -Q --batch \
           --eval '(setq native-comp-enable-subr-trampolines nil comp-enable-subr-trampolines nil)' \
           --eval '(princ "HOST=ok\n")' 2>&1); then
    echo "  host-batch: ok"
  else
    echo "  host-batch: fail"
    doctor_block "$out"
    failures=$((failures + 1))
  fi

  if out=$(NEMACS_HOME="$NEMACS_HOME" \
           NEMACS_EMACS="$NEMACS_EMACS" \
           NEMACS_DRIVER=host \
           "$SCRIPT_PATH/nemacs" --driver=host --batch --no-banner \
           --eval '(princ "NEMACS_HOST=ok\n")' 2>&1); then
    echo "  nemacs-host-batch: ok"
    doctor_block "$out"
  else
    echo "  nemacs-host-batch: fail"
    doctor_block "$out"
    failures=$((failures + 1))
  fi

  if [[ ! -x "$NEMACS_NELISP" ]]; then
    echo "  nelisp-binary: fail"
    echo "    not executable: $NEMACS_NELISP"
    failures=$((failures + 1))
  else
    echo "  nelisp-binary: ok"
    nelisp_kind="$(nelisp_driver_kind)"
    echo "  nelisp-driver-kind: $nelisp_kind"

    ulimit -s "$NEMACS_NELISP_STACK" 2>/dev/null || true
    [[ "$NEMACS_NELISP_MEMORY" == "unlimited" ]] || ulimit -v "$NEMACS_NELISP_MEMORY" 2>/dev/null || true
    if [[ "$nelisp_kind" == "standalone-reader" ]]; then
      echo "  nelisp-version: skip"
      echo "    standalone-reader has no --version command"

      if out=$(nelisp_standalone_eval_value 42 42); then
        echo "  nelisp-literal-eval: ok"
        doctor_block "$out"
      else
        echo "  nelisp-literal-eval: fail"
        doctor_block "$out"
        failures=$((failures + 1))
      fi

      if out=$(nelisp_standalone_eval_value '(+ 40 2)' 42); then
        echo "  nelisp-list-eval: ok"
        doctor_block "$out"
      else
        echo "  nelisp-list-eval: fail"
        doctor_block "$out"
        failures=$((failures + 1))
      fi
    else
      if out=$("$NEMACS_NELISP" --version 2>&1); then
        echo "  nelisp-version: ok"
        doctor_block "$out"
      else
        echo "  nelisp-version: fail"
        doctor_block "$out"
        failures=$((failures + 1))
      fi

      if out=$("$NEMACS_NELISP" --eval 42 2>&1); then
        echo "  nelisp-literal-eval: ok"
        doctor_block "$out"
      else
        echo "  nelisp-literal-eval: fail"
        doctor_block "$out"
        failures=$((failures + 1))
      fi

      if out=$("$NEMACS_NELISP" --eval '(identity 42)' 2>&1); then
        echo "  nelisp-list-eval: ok"
        doctor_block "$out"
      else
        echo "  nelisp-list-eval: fail"
        doctor_block "$out"
        failures=$((failures + 1))
      fi
    fi
  fi

  if (( failures == 0 )); then
    echo "  summary: ok"
  else
    echo "  summary: fail ($failures)"
  fi
  return "$failures"
}

# --- parse args ----------------------------------------------------

BATCH=0
NO_BANNER=0
NO_INIT=0
QUICK=0
DOCTOR=0
LOAD_FILES=()
LOAD_PATHS=()
IMAGE_FILES=()
EVAL_FORMS=()
FUNCALLS=()
EXTRA_ARGS=()
HOST_EARLY_ARGS=()

while (( $# > 0 )); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --version)
      echo "nemacs $NEMACS_VERSION (driver=$NEMACS_DRIVER)"
      exit 0 ;;
    --print-paths) print_paths; exit 0 ;;
    --doctor) DOCTOR=1; shift ;;
    -q|--no-init-file) NO_INIT=1; shift ;;
    -Q|--quick) NO_INIT=1; QUICK=1; shift ;;
    -nw|--no-window-system)
      HOST_EARLY_ARGS+=("$1"); shift ;;
    --batch) BATCH=1; shift ;;
    --no-banner) NO_BANNER=1; shift ;;
    --driver=*) NEMACS_DRIVER="${1#--driver=}"; shift ;;
    --driver) NEMACS_DRIVER="$2"; shift 2 ;;
    -L|--directory)
      [[ -n "${2-}" ]] || { echo "nemacs: $1 requires an argument" >&2; exit 2; }
      LOAD_PATHS+=("$2"); shift 2 ;;
    -L*) LOAD_PATHS+=("${1#-L}"); shift ;;
    --directory=*) LOAD_PATHS+=("${1#--directory=}"); shift ;;
    -l)
      [[ -n "${2-}" ]] || { echo "nemacs: -l requires an argument" >&2; exit 2; }
      LOAD_FILES+=("$2"); shift 2 ;;
    --load)
      [[ -n "${2-}" ]] || { echo "nemacs: --load requires an argument" >&2; exit 2; }
      LOAD_FILES+=("$2"); shift 2 ;;
    --load=*) LOAD_FILES+=("${1#--load=}"); shift ;;
    --load-image|--image)
      [[ -n "${2-}" ]] || { echo "nemacs: $1 requires an argument" >&2; exit 2; }
      IMAGE_FILES+=("$2"); shift 2 ;;
    --load-image=*|--image=*) IMAGE_FILES+=("${1#*=}"); shift ;;
    --runtime-image)
      [[ -n "${2-}" ]] || { echo "nemacs: --runtime-image requires an argument" >&2; exit 2; }
      NEMACS_RUNTIME_IMAGE="$2"; shift 2 ;;
    --runtime-image=*) NEMACS_RUNTIME_IMAGE="${1#*=}"; shift ;;
    --cold-image)
      [[ -n "${2-}" ]] || { echo "nemacs: --cold-image requires an argument" >&2; exit 2; }
      NEMACS_COLD_IMAGE="$2"; shift 2 ;;
    --cold-image=*) NEMACS_COLD_IMAGE="${1#*=}"; shift ;;
    --cold-artifact)
      [[ -n "${2-}" ]] || { echo "nemacs: --cold-artifact requires an argument" >&2; exit 2; }
      NEMACS_COLD_ARTIFACT="$2"; shift 2 ;;
    --cold-artifact=*) NEMACS_COLD_ARTIFACT="${1#*=}"; shift ;;
    --eval)
      [[ -n "${2-}" ]] || { echo "nemacs: --eval requires an argument" >&2; exit 2; }
      EVAL_FORMS+=("$2"); shift 2 ;;
    --eval=*) EVAL_FORMS+=("${1#--eval=}"); shift ;;
    -f|--funcall)
      [[ -n "${2-}" ]] || { echo "nemacs: $1 requires an argument" >&2; exit 2; }
      FUNCALLS+=("$2"); shift 2 ;;
    --funcall=*) FUNCALLS+=("${1#--funcall=}"); shift ;;
    --) shift; while (($#>0)); do EXTRA_ARGS+=("$1"); shift; done ;;
    *) EXTRA_ARGS+=("$1"); shift ;;
  esac
done

if (( DOCTOR )); then
  run_doctor
  exit $?
fi

# --- bootstrap form ------------------------------------------------

# Build the lisp form we hand to the driver.  The form sets the
# nemacs-main-options plist + load-path then requires nemacs-main +
# calls nemacs-main / nemacs-batch-main.

shell_quote() {
  # Emacs/nelisp string literal escaping for filenames + sexps.
  printf '%s' "$1" | perl -0777 -pe 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g'
}

lisp_file_string() {
  # Escape a file as one Emacs/NeLisp string literal body.
  perl -0777 -pe 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g' "$1"
}

one_line_form() {
  # The standalone reader REPL consumes one input form per line.
  printf '%s' "$1" | perl -0777 -pe 's/\r?\n/ /g'
}

resolve_repl_load_path() {
  case "$1" in
    /*)
      printf '%s\n' "$1"
      return
      ;;
    */*)
      printf '%s\n' "$PWD/$1"
      return
      ;;
  esac
  local dir
  for dir in "${LOAD_PATHS[@]+"${LOAD_PATHS[@]}"}" \
             "$NEMACS_HOME/src" \
             "$NEMACS_HOME/vendor/emacs-lisp" \
             "$NEMACS_HOME/vendor/emacs-lisp/emacs-lisp"; do
    if [[ -r "$dir/$1" ]]; then
      printf '%s\n' "$dir/$1"
      return
    fi
    if [[ -r "$dir/$1.el" ]]; then
      printf '%s\n' "$dir/$1.el"
      return
    fi
  done
  printf '%s\n' "$1"
}

LOAD_LIST=""
for f in "${LOAD_FILES[@]+"${LOAD_FILES[@]}"}"; do
  LOAD_LIST+=" \"$(shell_quote "$f")\""
done

LOAD_PATH_LIST=""
for f in "${LOAD_PATHS[@]+"${LOAD_PATHS[@]}"}"; do
  LOAD_PATH_LIST+=" \"$(shell_quote "$f")\""
done

IMAGE_LIST=""
for f in "${IMAGE_FILES[@]+"${IMAGE_FILES[@]}"}"; do
  IMAGE_LIST+=" \"$(shell_quote "$f")\""
done

EVAL_LIST=""
for f in "${EVAL_FORMS[@]+"${EVAL_FORMS[@]}"}"; do
  # Each --eval is itself elisp source.  Host Emacs can parse it inside
  # the boot form; standalone NeLisp does not require `read' at boot time
  # and evaluates string forms through `nelisp--eval-source-string'.
  if [[ "$NEMACS_DRIVER" == "nelisp" ]]; then
    EVAL_LIST+=" \"$(shell_quote "$f")\""
  else
    EVAL_LIST+=" (read \"$(shell_quote "$f")\")"
  fi
done

FUNCALL_LIST=""
for f in "${FUNCALLS[@]+"${FUNCALLS[@]}"}"; do
  FUNCALL_LIST+=" '$(shell_quote "$f")"
done

ARG_LIST=""
for f in "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"; do
  ARG_LIST+=" \"$(shell_quote "$f")\""
done

if (( BATCH )); then
  ENTRY_CALL='(nemacs-batch-main)'
else
  ENTRY_CALL='(nemacs-main)'
fi

if [[ "$NEMACS_RUNTIME_IMAGE" == "auto" ]]; then
  if (( BATCH )); then
    NEMACS_RUNTIME_IMAGE="$NEMACS_BATCH_RUNTIME_IMAGE"
  else
    NEMACS_RUNTIME_IMAGE="$NEMACS_INTERACTIVE_RUNTIME_IMAGE"
  fi
  if [[ ! -r "$NEMACS_RUNTIME_IMAGE" ]]; then
    NEMACS_RUNTIME_IMAGE=""
  fi
fi

if [[ "$NEMACS_DRIVER" == "host" ]]; then
  BOOT_HOST_PRELOAD_FORM="$(cat <<EOF
  (require 'cl-lib)
  (require 'cl-generic)
EOF
)"
  BOOT_LOAD_PATH_FORM="$(cat <<EOF
  (setq load-path
        (append (list$LOAD_PATH_LIST
                      "$(shell_quote "$NEMACS_HOME/src")")
                (and (boundp 'load-path) load-path)
                (list "$(shell_quote "$NEMACS_HOME/vendor/emacs-lisp")"
                      "$(shell_quote "$NEMACS_HOME/vendor/emacs-lisp/emacs-lisp")")))
EOF
)"
else
  BOOT_HOST_PRELOAD_FORM=""
  BOOT_LOAD_PATH_FORM="$(cat <<EOF
  (setq load-path
        (append (list$LOAD_PATH_LIST
                      "$(shell_quote "$NEMACS_HOME/src")"
                      "$(shell_quote "$NEMACS_HOME/vendor/emacs-lisp")"
                      "$(shell_quote "$NEMACS_HOME/vendor/emacs-lisp/emacs-lisp")")
                (and (boundp 'load-path) load-path)))
EOF
)"
fi

BOOTSTRAP_BUNDLE_LOAD=""
if [[ "$NEMACS_DRIVER" == "nelisp" && -z "$NEMACS_RUNTIME_IMAGE" && -n "$NEMACS_BOOTSTRAP_BUNDLE" && -r "$NEMACS_BOOTSTRAP_BUNDLE" && ! -r "$NEMACS_BOOTSTRAP_REPL" ]]; then
  BOOTSTRAP_BUNDLE_LOAD="  (load \"$(shell_quote "$NEMACS_BOOTSTRAP_BUNDLE")\" nil 'no-message t t)"
fi

BOOT_NELISP_SOURCE_REFRESH=""
if [[ "$NEMACS_DRIVER" == "nelisp" ]]; then
  BOOT_NELISP_SOURCE_REFRESH="$(cat <<EOF
  (load "$(shell_quote "$NEMACS_HOME/src/emacs-fns.el")" nil 'no-message)
  (load "$(shell_quote "$NEMACS_HOME/src/nemacs-main.el")" nil 'no-message)
EOF
)"
fi

if [[ "$NEMACS_DRIVER" == "nelisp" ]]; then
  if (( BATCH )); then
    BOOT_ENTRY_FORM="$(cat <<'EOF'
  (when (fboundp 'install-sigint-handler) (install-sigint-handler))
  (unless nemacs-initialized (nemacs-init t))
  (nemacs-main--apply-options)
  (unless (nemacs-main-option :no-banner)
    (when (fboundp 'message)
      (message "%s" (nemacs-main-status-banner))))
EOF
)"
  else
    BOOT_ENTRY_FORM="$(cat <<EOF
  (when (fboundp 'install-sigint-handler) (install-sigint-handler))
  (when (fboundp 'install-winsize-handler) (install-winsize-handler))
  (when (fboundp 'install-jobctrl-handlers) (install-jobctrl-handlers))
  (unless nemacs-initialized (nemacs-init))
  (nemacs-main--apply-options)
  (setq nemacs-main--repl-tui-ok (nemacs-main--realise-tui))
  (if nemacs-main--repl-tui-ok
      (unwind-protect
          (progn
            (nemacs-main--enable-tty-raw-input)
            (nemacs-main--enter-fullscreen)
            (nemacs-main--initial-paint)
            (nemacs-main--event-loop))
        (nemacs-main--disable-tty-raw-input))
    (progn
      (when (fboundp 'message)
        (message "nemacs: TUI not available, running batch-style"))
      (nemacs-main--apply-options)))
EOF
)"
  fi
else
  BOOT_ENTRY_FORM="  $ENTRY_CALL"
fi

if (( BATCH || NO_INIT )); then
  NEMACS_INIT_GATE_FORM="(setq init-file-user nil)"
else
  NEMACS_INIT_GATE_FORM="(setq init-file-user \"\")"
fi

if (( BATCH || NO_INIT || QUICK )); then
  NEMACS_PACKAGE_STARTUP_FORM="(setq package-enable-at-startup nil)"
else
  NEMACS_PACKAGE_STARTUP_FORM="(setq package-enable-at-startup t)"
fi

BOOT_FORM="$(cat <<EOF
(progn
  (setq native-comp-enable-subr-trampolines nil
        comp-enable-subr-trampolines nil)
  (unless (boundp 'load-file-name) (defvar load-file-name nil))
  (unless (boundp 'buffer-file-name) (defvar buffer-file-name nil))
  (unless (boundp 'default-directory)
    (defvar default-directory "$(shell_quote "$NEMACS_HOME")/"))
  (unless (boundp 'nemacs-nelisp-executable)
    (defvar nemacs-nelisp-executable nil))
  (setq nemacs-nelisp-executable "$(shell_quote "$NEMACS_NELISP")")
  (unless (boundp 'load-path) (defvar load-path nil))
  $NEMACS_INIT_GATE_FORM
  $NEMACS_PACKAGE_STARTUP_FORM
  (setq nelisp-emacs-vendor-root "$(shell_quote "$NEMACS_HOME/vendor")")
$BOOT_HOST_PRELOAD_FORM
$BOOT_LOAD_PATH_FORM
(setq emacs-load-auto-native-compile nil)
$BOOTSTRAP_BUNDLE_LOAD
$BOOT_NELISP_SOURCE_REFRESH
(setq emacs-load-auto-native-compile t)
  (require 'emacs-cl-macros)
  (require 'nemacs-main)
  (setq nemacs-main-options
        (list :batch $([ "$BATCH" = "1" ] && echo t || echo nil)
              :no-banner $([ "$NO_BANNER" = "1" ] && echo t || echo nil)
              :driver '$NEMACS_DRIVER
              :images (list$IMAGE_LIST)
              :load-path (list$LOAD_PATH_LIST)
              :load (list$LOAD_LIST)
              :eval-forms (list$EVAL_LIST)
              :funcall (list$FUNCALL_LIST)
              :args (list$ARG_LIST)))
$BOOT_ENTRY_FORM)
EOF
)"

# A cold image already contains the bootstrap artifact.  Reassert only
# per-process context and command-line options: snapshots must not pin the
# caller's default-directory/load-path, and warm startup must not replay the
# bootstrap bundle or source files.
COLD_BOOT_FORM="$(cat <<EOF
(progn
  (setq native-comp-enable-subr-trampolines nil
        comp-enable-subr-trampolines nil)
  (unless (boundp 'load-file-name) (defvar load-file-name nil))
  (unless (boundp 'buffer-file-name) (defvar buffer-file-name nil))
  (unless (boundp 'default-directory) (defvar default-directory nil))
  (setq default-directory "$(shell_quote "$NEMACS_HOME")/")
  (unless (boundp 'nemacs-nelisp-executable)
    (defvar nemacs-nelisp-executable nil))
  (setq nemacs-nelisp-executable "$(shell_quote "$NEMACS_NELISP")")
  (unless (boundp 'load-path) (defvar load-path nil))
  $NEMACS_INIT_GATE_FORM
  $NEMACS_PACKAGE_STARTUP_FORM
  (setq nelisp-emacs-vendor-root "$(shell_quote "$NEMACS_HOME/vendor")")
$BOOT_LOAD_PATH_FORM
  (setq emacs-load-auto-native-compile t)
  (setq nemacs-main-options
        (list :batch $([ "$BATCH" = "1" ] && echo t || echo nil)
              :no-banner $([ "$NO_BANNER" = "1" ] && echo t || echo nil)
              :driver '$NEMACS_DRIVER
              :images (list$IMAGE_LIST)
              :load-path (list$LOAD_PATH_LIST)
              :load (list$LOAD_LIST)
              :eval-forms (list$EVAL_LIST)
              :funcall (list$FUNCALL_LIST)
              :args (list$ARG_LIST)))
$BOOT_ENTRY_FORM)
EOF
)"

# --- driver dispatch -----------------------------------------------

case "$NEMACS_DRIVER" in
  host)
    if (( BATCH )); then
      exec "$NEMACS_EMACS" -Q --batch "${HOST_EARLY_ARGS[@]+"${HOST_EARLY_ARGS[@]}"}" --eval "$BOOT_FORM" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    else
      # Host -Q keeps host Emacs startup out of the way; nemacs owns init loading.
      exec "$NEMACS_EMACS" -Q "${HOST_EARLY_ARGS[@]+"${HOST_EARLY_ARGS[@]}"}" --eval "$BOOT_FORM" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}"
    fi
    ;;
  nelisp)
    if [[ ! -x "$NEMACS_NELISP" ]]; then
      echo "nemacs: nelisp driver requested but $NEMACS_NELISP is not executable" >&2
      echo "  Set NEMACS_NELISP, export NELISP_HOME, or build it via: bin/build-nelisp" >&2
      echo "  Direct build: cd $NELISP_HOME && make standalone-reader" >&2
      exit 1
    fi
    ulimit -s "$NEMACS_NELISP_STACK" 2>/dev/null || true
    [[ "$NEMACS_NELISP_MEMORY" == "unlimited" ]] || ulimit -v "$NEMACS_NELISP_MEMORY" 2>/dev/null || true
    cold_image_ready=0
    if cold_cache_disabled_p; then
      :
    elif mkdir -p "$(dirname "$NEMACS_COLD_ARTIFACT")" \
                   "$(dirname "$NEMACS_COLD_IMAGE")"; then
      if acquire_cold_cache_lock; then
        cold_prepare_status=""
        cold_needs_compile=0
        # Source route first; the artifact route stays as the fallback so a
        # tree without build/nemacs-bootstrap.el still starts.
        if cold_source_route_available_p; then
          if cold_source_cache_hit_p; then
            cold_prepare_status="flat-image-cache=hit route=source image=$NEMACS_COLD_IMAGE"
            cold_image_ready=1
          else
            # Never leave a known-stale image available to a fallback or later
            # launch.  This also rejects legacy v1 sidecars on first use.
            if ! invalidate_cold_source_cache; then
              echo "nemacs: cannot remove stale cold image; no cold image this start" >&2
            else
              # 131 s measured.  Say so before the wait rather than after: the
              # artifact route's equivalent silence lasted 85 minutes and read as
              # a hang.
              echo "nemacs: building cold image from source (~2 min)" >&2
              if cold_prepare_status="$(build_cold_image_from_source)"; then
                cold_image_ready=1
              elif cold_artifact_route_available_p; then
                echo "nemacs: source-route image build failed; trying the artifact route" >&2
              else
                echo "nemacs: source-route image build failed; no cold image this start" >&2
              fi
            fi
          fi
        fi
        if (( cold_image_ready )); then
          :
        elif ! cold_artifact_route_available_p; then
          :
        elif [[ -r "$NEMACS_COLD_ARTIFACT" &&
                -r "$NEMACS_COLD_ARTIFACT.manifest.el" ]]; then
          if cold_prepare_status="$(prepare_cold_cache)"; then
            cold_image_ready=1
          else
            cold_needs_compile=1
            echo "nemacs: cached bootstrap artifact is stale or unusable; rebuilding" >&2
          fi
        else
          cold_needs_compile=1
        fi
        if (( cold_needs_compile )); then
          if compile_bootstrap_artifact; then
            if cold_prepare_status="$(prepare_cold_cache)"; then
              cold_image_ready=1
            else
              echo "nemacs: cold image prepare failed after AOT compile" >&2
            fi
          else
            echo "nemacs: bootstrap AOT compile failed or source is unavailable" >&2
          fi
        fi
        release_cold_cache_lock
        trap - EXIT INT TERM HUP
        # Report the prepare output on both outcomes.  Gating it on success
        # discarded exactly the diagnostics that explain a failure: a SEGV
        # after the image was already written, or a multi-minute stall inside
        # `compile-runtime-image', both looked like a bare "prepare failed"
        # line with no detail (measured 2026-08-09).
        if [[ -n "$cold_prepare_status" ]]; then
          printf '%s\n' "$cold_prepare_status" >&2
        fi
      else
        echo "nemacs: cold cache lock timed out after ${NEMACS_COLD_LOCK_TIMEOUT}s" >&2
      fi
      if (( ! cold_image_ready )); then
        echo "nemacs: cold cache unavailable; falling back to normal startup" >&2
      fi
    else
      echo "nemacs: cannot create cold cache directory; falling back to normal startup" >&2
    fi
    if (( ! cold_image_ready )) &&
       [[ -n "$NEMACS_RUNTIME_IMAGE" && ! -r "$NEMACS_RUNTIME_IMAGE" ]]; then
      echo "nemacs: runtime image is not readable: $NEMACS_RUNTIME_IMAGE" >&2
      exit 1
    fi
    # The cold-load stdin reader is line-oriented: it evaluates the first
    # complete form on each line and discards the rest.  A multi-line boot
    # form is therefore shredded, and inner forms that happen to start a line
    # run on their own, outside the guards that enclose them in the source.
    # That -- not the image -- is what made warm starts fail: the banner's
    # `(message "%s" (nemacs-main-status-banner))' ran detached from its
    # `(when (fboundp 'message)' guard and signalled, while the 118 MB image
    # itself cold-loads in under a second (measured 2026-08-09).
    #
    # Collapse the form onto one line.  A `;' comment would then swallow the
    # remainder of that line, so refuse the cold path rather than boot a
    # silently truncated form.
    COLD_BOOT_LINE="${COLD_BOOT_FORM//$'\n'/ }"
    if (( cold_image_ready )) && [[ "$COLD_BOOT_LINE" == *";"* ]]; then
      echo "nemacs: cold boot form contains a ';' comment and cannot be put" >&2
      echo "  on one line for the cold-load reader; using normal startup" >&2
      cold_image_ready=0
    fi
    if [[ "$(nelisp_driver_kind)" == "standalone-reader" ]]; then
      if (( cold_image_ready )); then
        tmp="$(mktemp "${TMPDIR:-/tmp}/nemacs-cold-boot.XXXXXX.el")"
        printf '%s\n0\n' "$COLD_BOOT_LINE" > "$tmp"
        set +e
        "$NEMACS_NELISP" --cold-load-from "$NEMACS_COLD_IMAGE" \
          --no-prompt --no-print < "$tmp"
        rc=$?
        set -e
        rm -f "$tmp"
        exit "$rc"
      elif [[ -n "$NEMACS_RUNTIME_IMAGE" ]]; then
        exec "$NEMACS_NELISP" exec-runtime-image "$NEMACS_RUNTIME_IMAGE" "$BOOT_FORM"
      elif [[ -r "$NEMACS_BOOTSTRAP_REPL" ]]; then
        tmp="$(mktemp "${TMPDIR:-/tmp}/nemacs-repl-boot.XXXXXX.el")"
        : > "$tmp"
        if [[ -r "$NELISP_HOME/scripts/nelisp-stdlib-prelude.el" ]]; then
          printf '(nelisp--eval-source-string "%s")\n' \
            "$(lisp_file_string "$NELISP_HOME/scripts/nelisp-stdlib-prelude.el")" >> "$tmp"
        fi
        printf '%s\n' "(unless (boundp 'load-file-name) (defvar load-file-name nil))" >> "$tmp"
        printf '%s\n' "(unless (boundp 'buffer-file-name) (defvar buffer-file-name nil))" >> "$tmp"
        printf '%s\n' "(unless (boundp 'default-directory) (defvar default-directory \"$(shell_quote "$NEMACS_HOME")/\"))" >> "$tmp"
        printf '%s\n' "(unless (boundp 'nemacs-nelisp-executable) (defvar nemacs-nelisp-executable nil))" >> "$tmp"
        printf '%s\n' "(setq nemacs-nelisp-executable \"$(shell_quote "$NEMACS_NELISP")\")" >> "$tmp"
        printf '%s\n' "(setq native-comp-enable-subr-trampolines nil comp-enable-subr-trampolines nil)" >> "$tmp"
        printf '%s\n' "(unless (boundp 'load-path) (defvar load-path nil))" >> "$tmp"
        printf '%s\n' "$NEMACS_INIT_GATE_FORM" >> "$tmp"
        if [[ -n "$NEMACS_PACKAGE_STARTUP_FORM" ]]; then
          printf '%s\n' "$NEMACS_PACKAGE_STARTUP_FORM" >> "$tmp"
        fi
        printf '%s\n' "(setq emacs-load-auto-native-compile nil)" >> "$tmp"
        cat "$NEMACS_BOOTSTRAP_REPL" >> "$tmp"
        printf '%s\n' "(setq nelisp-emacs-vendor-root \"$(shell_quote "$NEMACS_HOME/vendor")\")" >> "$tmp"
        printf '%s\n' "$(one_line_form "$BOOT_LOAD_PATH_FORM")" >> "$tmp"
        printf '%s\n' "(require 'emacs-cl-macros)" >> "$tmp"
        printf '%s\n' "(require 'nemacs-main)" >> "$tmp"
        printf '%s\n' "(setq emacs-load-auto-native-compile t)" >> "$tmp"
        REPL_OPTIONS_FORM="$(cat <<EOF
(setq nemacs-main-options
      (list :batch $([ "$BATCH" = "1" ] && echo t || echo nil)
            :no-banner $([ "$NO_BANNER" = "1" ] && echo t || echo nil)
            :driver '$NEMACS_DRIVER
            :images (list$IMAGE_LIST)
            :load-path (list$LOAD_PATH_LIST)
            :load (list$LOAD_LIST)
            :eval-forms (list$EVAL_LIST)
            :funcall (list$FUNCALL_LIST)
            :args (list$ARG_LIST)))
EOF
)"
        printf '%s\n' "$(one_line_form "$REPL_OPTIONS_FORM")" >> "$tmp"
        if (( BATCH )); then
          # The standalone-reader REPL can capture top-level option defvars as
          # nil when one closure calls another.  Keep batch CLI processing at
          # top level so -L/-l/--eval/-f see the plist installed above.
          printf '%s\n' "(when (fboundp 'install-sigint-handler) (install-sigint-handler))" >> "$tmp"
          printf '%s\n' "(unless nemacs-initialized (nemacs-init t))" >> "$tmp"
          printf '%s\n' "(nemacs-main--apply-options)" >> "$tmp"
          printf '%s\n' "(unless (nemacs-main-option :no-banner) (when (fboundp 'message) (message \"%s\" (nemacs-main-status-banner))))" >> "$tmp"
        else
          printf '%s\n' "(when (fboundp 'install-sigint-handler) (install-sigint-handler))" >> "$tmp"
          printf '%s\n' "(when (fboundp 'install-winsize-handler) (install-winsize-handler))" >> "$tmp"
          printf '%s\n' "(when (fboundp 'install-jobctrl-handlers) (install-jobctrl-handlers))" >> "$tmp"
          printf '%s\n' "(unless nemacs-initialized (nemacs-init))" >> "$tmp"
          printf '%s\n' "(nemacs-main--apply-options)" >> "$tmp"
          printf '%s\n' "(setq nemacs-main--repl-tui-ok (nemacs-main--realise-tui))" >> "$tmp"
          if (( ! NO_BANNER )); then
            printf '%s\n' "(when (and nemacs-main--repl-tui-ok (fboundp 'message)) (message \"%s\" (nemacs-main-status-banner)))" >> "$tmp"
          fi
          if [[ "$NEMACS_DRIVER" == "host" ]]; then
            printf '%s\n' "(if (and nemacs-main--repl-tui-ok (boundp 'noninteractive) (not noninteractive)) (nemacs-main--install-keymap-host) (when nemacs-main--repl-tui-ok (unwind-protect (progn (princ \"NEMACS_TUI_TAIL_REACHED\\n\") (nemacs-main--enable-tty-raw-input) (nemacs-main--enter-fullscreen) (nemacs-main--initial-paint) (nemacs-main--event-loop)) (nemacs-main--disable-tty-raw-input))))" >> "$tmp"
          else
            # Cheap unconditional diagnosability marker: emitted just before the
            # raw-input handoff so pty smoke probes can tell "boot form reached
            # the interactive tail" apart from "boot form never got this far"
            # even when the rest of the TUI never becomes observable. Batch mode
            # never reaches this branch, so the marker cannot leak into scripted
            # --batch output.
            printf '%s\n' "(if nemacs-main--repl-tui-ok (unwind-protect (progn (princ \"NEMACS_TUI_TAIL_REACHED\\n\") (nemacs-main--enable-tty-raw-input) (nemacs-main--enter-fullscreen) (nemacs-main--initial-paint) (nemacs-main--event-loop)) (nemacs-main--disable-tty-raw-input)) (progn (when (fboundp 'message) (message \"nemacs: TUI not available, running batch-style\")) (nemacs-main--apply-options)))" >> "$tmp"
          fi
        fi
        printf '%s\n' "0" >> "$tmp"
        restore_repl_tty() {
          if (( ! BATCH )); then
            stty sane < /dev/tty 2>/dev/null || true
          fi
        }
        if (( ! BATCH )); then
          trap 'restore_repl_tty; exit 143' TERM HUP
          trap 'restore_repl_tty; exit 130' INT
        fi
        set +e
        "$NEMACS_NELISP" --repl --no-prompt --no-print < "$tmp"
        rc=$?
        set -e
        restore_repl_tty
        if (( ! BATCH )); then
          trap - TERM HUP INT
        fi
        if [[ -n "$NEMACS_KEEP_REPL_BOOT" ]]; then
          echo "nemacs: keeping repl boot file $tmp" >&2
        else
          rm -f "$tmp"
        fi
        exit "$rc"
      else
        tmp="$(mktemp "${TMPDIR:-/tmp}/nemacs-boot.XXXXXX.el")"
        printf '%s\n0\n' "$BOOT_FORM" > "$tmp"
        set +e
        "$NEMACS_NELISP" --load "$tmp"
        rc=$?
        set -e
        rm -f "$tmp"
        exit "$rc"
      fi
    elif [[ -n "$NEMACS_RUNTIME_IMAGE" ]]; then
      exec "$NEMACS_NELISP" exec-runtime-image "$NEMACS_RUNTIME_IMAGE" "$BOOT_FORM"
    else
      exec "$NEMACS_NELISP" --eval "$BOOT_FORM"
    fi
    ;;
  *)
    echo "nemacs: unknown --driver=$NEMACS_DRIVER (expected host or nelisp)" >&2
    exit 2
    ;;
esac
