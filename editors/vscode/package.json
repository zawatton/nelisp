{
  "name": "nelisp",
  "displayName": "NeLisp",
  "description": "NeLisp source tooling and project commands",
  "version": "0.1.0",
  "publisher": "nelisp",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": ["workspaceContains:**/nelisp.toml"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "NeLisp starts configured toolchain executables and project commands."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      {
        "id": "nelisp",
        "aliases": [
          "NeLisp"
        ],
        "extensions": [
          ".nl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nelisp",
        "scopeName": "source.nelisp",
        "path": "./syntaxes/nelisp.tmLanguage.json"
      }
    ],
    "commands": [
      {"command": "nelisp.search", "title": "NeLisp: Search Packages"},
      {"command": "nelisp.add", "title": "NeLisp: Add Dependency"},
      {"command": "nelisp.remove", "title": "NeLisp: Remove Dependency"},
      {
        "command": "nelisp.run",
        "title": "NeLisp: Run Project"
      },
      {
        "command": "nelisp.test",
        "title": "NeLisp: Test Project"
      },
      {
        "command": "nelisp.build",
        "title": "NeLisp: Build Project"
      },
      {
        "command": "nelisp.repl",
        "title": "NeLisp: Open Project REPL"
      },
      {
        "command": "nelisp.fetch",
        "title": "NeLisp: Fetch Dependencies"
      },
      {
        "command": "nelisp.update",
        "title": "NeLisp: Update Dependencies"
      },
      {
        "command": "nelisp.restartServer",
        "title": "NeLisp: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "NeLisp",
      "properties": {
        "nelisp.registryUrl": {"type": "string", "default": "", "scope": "resource", "description": "HTTPS registry index URL. Leave empty to use NELISP_REGISTRY; mutually exclusive with packageIndex."},
        "nelisp.packageIndex": {"type": "string", "default": "", "scope": "resource", "description": "Trusted local registry index snapshot, absolute or relative to the workspace folder. Mutually exclusive with registryUrl."},
        "nelisp.offline": {"type": "boolean", "default": false, "scope": "resource", "description": "Package commands use cached artifacts/indexes without network access."},
        "nelisp.serverPath": {
          "type": "string",
          "default": "nelisp-lsp",
          "scope": "window",
          "description": "Language server executable. Restart the server after changing this value."
        },
        "nelisp.executablePath": {
          "type": "string",
          "default": "nelisp",
          "scope": "resource",
          "description": "Project CLI executable used by NeLisp commands."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/run.js",
    "test:package": "node test/run.js --vsix",
    "test:process": "node test/process.js",
    "test:grammar": "node test/grammar.js",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.82.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.9.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zawatton/nelisp.git",
    "directory": "editors/vscode"
  }
}
