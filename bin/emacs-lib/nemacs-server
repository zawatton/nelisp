#!/usr/bin/env bash
# Start a foreground NeLisp daemon. Connect with emacsclient -s DIR/NAME.
# Usage: nemacs-server [NAME] [SOCKET_DIR] [EMACS-OPTION ...]
set -euo pipefail
launcher=$(cd "$(dirname "$0")" && pwd)/nemacs
name=${1:-nemacs}
socket_dir=${2:-${TMPDIR:-/tmp}/nemacs-server}
if (($#)); then shift; fi
if (($#)); then shift; fi
# The listener needs a private directory before the first client connects.
(umask 077; mkdir -p -- "$socket_dir")
export NEMACS_SERVER_SOCKET_DIR="$(cd "$socket_dir" && pwd)"
export NEMACS_NELISP="${NELISP:-${NEMACS_NELISP:-}}"
exec "$launcher" --driver=nelisp --no-banner "--fg-daemon=$name" "$@"
