;;; char-syntax-parity.el --- char-syntax rows, diff host vs NeLisp  -*- lexical-binding: t; -*-
;; Run with emacs-31.1 -Q --batch -l and in the NeLisp image; compare the "R" lines.
;; Known divergence not covered (standard table content): U+3002 is punctuation in GNU.
(defmacro cs-row (name form)
  `(princ (format "R %s %S\n" ,name (with-temp-buffer (condition-case e ,form (wrong-number-of-arguments (list 'err (car e))) (error (list 'err (car e) (cdr e))))))))
(defun cs-all (lo hi) (let (r (c lo)) (while (<= c hi) (push (char-syntax c) r) (setq c (1+ c))) (concat (nreverse r))))
(cs-row "std-ascii" (cs-all 0 127))
(cs-row "std-latin1-w" (cs-all 128 159))
(cs-row "std-samples" (mapcar #'char-syntax (list ?あ ?漢 ?ア ?, ?  #x1f600 #x10ffff #x3fffff #x3fff80)))
(cs-row "oob-1" (char-syntax #x400000))
(cs-row "oob-2" (char-syntax -1))
(cs-row "err-nil" (char-syntax nil))
(cs-row "err-str" (char-syntax "a"))
(cs-row "err-float" (char-syntax 97.0))
(cs-row "err-sym" (char-syntax 'a))
(cs-row "err-marker" (with-temp-buffer (insert "a") (char-syntax (point-marker))))
(cs-row "argc-0" (funcall 'char-syntax))
(cs-row "argc-2" (funcall 'char-syntax ?a nil))
(let ((tb (make-syntax-table)) (i 0) (specs '("." "w" "_" "(b" ")a" "'" "\"" "$" "\\" "/" "<" ">" "@" "!" "|" " " "-")) r)
  (dolist (sp specs)
    (modify-syntax-entry (+ ?A i) sp tb) (setq i (1+ i)))
  (cs-row "copy-classes" (with-syntax-table tb (cs-all ?A (+ ?A 16))))
  (cs-row "copy-std-untouched" (cs-all ?A (+ ?A 16)))
  (modify-syntax-entry ?\( "()1b" tb) (modify-syntax-entry ?\) ")(4n" tb)
  (modify-syntax-entry '(#x3041 . #x3050) "." tb) (modify-syntax-entry ?あ "_" tb) (modify-syntax-entry #x1f600 "(" tb)
  (cs-row "copy-paren-flags" (with-syntax-table tb (mapcar #'char-syntax (list ?\( ?\) ?a))))
  (cs-row "copy-mb" (with-syntax-table tb (mapcar #'char-syntax (list ?あ ?ぃ ?ぱ #x1f600 ?漢))))
  (cs-row "nested-with" (with-syntax-table tb (list (char-syntax ?A) (with-syntax-table (standard-syntax-table) (char-syntax ?A)) (char-syntax ?A))))
  (cs-row "set-table-buf" (with-temp-buffer (set-syntax-table tb) (list (char-syntax ?B) (progn (set-syntax-table (standard-syntax-table)) (char-syntax ?B)))))
  (cs-row "other-buf" (with-temp-buffer (set-syntax-table tb) (list (char-syntax ?B) (with-temp-buffer (char-syntax ?B)) (char-syntax ?B))))
  (cs-row "after-restore" (progn (with-syntax-table tb (char-syntax ?A)) (char-syntax ?A)))
  (cs-row "unwind-error" (progn (ignore-errors (with-syntax-table tb (error "x"))) (char-syntax ?A)))
  ;; inheritance
  (let* ((parent (make-syntax-table)) (child (make-syntax-table parent)))
    (modify-syntax-entry ?Z "." parent) (modify-syntax-entry ?あ "_" parent) (modify-syntax-entry ?\{ "(}" parent)
    (cs-row "inherit-1" (with-syntax-table child (mapcar #'char-syntax (list ?Z ?あ ?\{ ?a ?\s))))
    (modify-syntax-entry ?Z "w" child) (modify-syntax-entry ?あ "w" child)
    (cs-row "inherit-override" (with-syntax-table child (mapcar #'char-syntax (list ?Z ?あ ?\{))))
    (modify-syntax-entry ?Z "@" child)
    (cs-row "inherit-explicit-@" (with-syntax-table child (char-syntax ?Z)))
    (modify-syntax-entry ?Z "_" parent)
    (cs-row "parent-change-seen" (with-syntax-table child (char-syntax ?Z)))
    (cs-row "grandchild" (let ((g (make-syntax-table child))) (with-syntax-table g (mapcar #'char-syntax (list ?Z ?\{ ?q)))))
    (cs-row "no-parent" (with-syntax-table (make-syntax-table) (mapcar #'char-syntax (list ?\{ ?a ?\s))))
    (cs-row "empty-char-table-parent" (let ((tt (make-char-table 'syntax-table nil))) (set-char-table-parent tt (standard-syntax-table)) (with-syntax-table tt (mapcar #'char-syntax (list ?a ?\s ?\( ?あ)))))
    (cs-row "empty-char-table-noparent" (let ((tt (make-char-table 'syntax-table nil))) (with-syntax-table tt (mapcar #'char-syntax (list ?a ?\s ?\( ?あ)))))))
;; text properties are ignored
(cs-row "prop-ignored" (with-temp-buffer (insert "ab") (put-text-property 1 2 'syntax-table (string-to-syntax ".")) (let ((parse-sexp-lookup-properties t)) (list (char-syntax (char-after 1)) (char-syntax ?a) (syntax-class-to-char (syntax-class (syntax-after 1)))))))
(cs-row "prop-char-table" (with-temp-buffer (insert "ab") (let ((tt (make-syntax-table))) (modify-syntax-entry ?a "." tt) (put-text-property 1 2 'syntax-table tt)) (let ((parse-sexp-lookup-properties t)) (char-syntax ?a))))
(cs-row "string-to-syntax-class" (mapcar (lambda (s) (char-syntax (progn (modify-syntax-entry ?é s (syntax-table)) ?é))) '("w")))
(cs-row "modify-std-restore" (let ((old (char-syntax ?é))) (with-temp-buffer (modify-syntax-entry ?é "." (make-syntax-table)) (list old (char-syntax ?é)))))
(cs-row "multibyte-buffer-table" (with-temp-buffer (set-buffer-multibyte t) (list (char-syntax ?あ) (char-syntax ?a))))
(cs-row "emacs-lisp-mode-ish" (let ((tt (make-syntax-table))) (modify-syntax-entry ?\; "<" tt) (modify-syntax-entry ?\n ">" tt) (modify-syntax-entry ?' "'" tt) (with-syntax-table tt (mapcar #'char-syntax '(?\; ?\n ?' ?a)))))
(princ "SP-DONE\n")
