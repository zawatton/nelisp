;;; syntax-parity.el --- char-syntax / forward-word / skip-syntax parity  -*- lexical-binding: t; -*-
;; Prints "R name value" lines; run on host emacs and on NeLisp and diff the R lines.
(defmacro sp (name form)
  `(princ (format "R %s %S\n" ,name (condition-case e (with-temp-buffer ,form) (error (list 'ERR (car e)))))))
(defun sp-text (s &rest body)
  (with-temp-buffer (insert s) (goto-char 1) (apply #'funcall body)))
(sp "cs-letter" (char-syntax ?a))
(sp "cs-digit" (char-syntax ?5))
(sp "cs-space" (char-syntax ?\s))
(sp "cs-nl" (char-syntax ?\n))
(sp "cs-tab" (char-syntax ?\t))
(sp "cs-punct" (mapcar #'char-syntax (string-to-list ".,;:!?@#")))
(sp "cs-sym" (mapcar #'char-syntax (string-to-list "_-+*/<>=&|")))
(sp "cs-paren" (mapcar #'char-syntax (string-to-list "()[]{}")))
(sp "cs-quote" (mapcar #'char-syntax (string-to-list "\"\\'`")))
(sp "cs-del" (list (char-syntax 127) (char-syntax 0)))
(sp "cs-nonascii" (list (char-syntax #xe9) (char-syntax #x3042) (char-syntax #x65e5) (char-syntax #x1f600) (char-syntax #xa0)))
