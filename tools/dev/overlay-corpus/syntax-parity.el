;; per-buffer tables, switching, with-syntax-table
(sp "cs-modify"
    (with-temp-buffer
      (let ((st (make-syntax-table)))
        (modify-syntax-entry ?a "." st) (modify-syntax-entry ?- "w" st)
        (list (char-syntax ?a)
              (progn (set-syntax-table st) (list (char-syntax ?a) (char-syntax ?-) (char-syntax ?b)))
              (progn (modify-syntax-entry ?b "_" st) (char-syntax ?b))
              (with-syntax-table (standard-syntax-table) (list (char-syntax ?a) (char-syntax ?-)))
              (char-syntax ?a)))))
(sp "cs-switch"
    (let ((b1 (generate-new-buffer " b1")) (b2 (generate-new-buffer " b2"))
          (st (make-syntax-table)) r)
      (modify-syntax-entry ?x "." st)
      (with-current-buffer b1 (set-syntax-table st))
      (push (with-current-buffer b1 (char-syntax ?x)) r)
      (push (with-current-buffer b2 (char-syntax ?x)) r)
      (push (char-syntax ?x) r)
      (push (with-current-buffer b1 (char-syntax ?x)) r)
      (with-current-buffer b1 (set-syntax-table (standard-syntax-table)))
      (push (with-current-buffer b1 (char-syntax ?x)) r)
      (with-current-buffer b2 (set-syntax-table st) (push (char-syntax ?x) r))
      (push (with-current-buffer b1 (char-syntax ?x)) r)
      (kill-buffer b1) (kill-buffer b2)
      (nreverse r)))
(sp "cs-nested-with"
    (let ((a (make-syntax-table)) (b (make-syntax-table)))
      (modify-syntax-entry ?q "." a) (modify-syntax-entry ?q "_" b)
      (with-temp-buffer
        (list (char-syntax ?q)
              (with-syntax-table a (list (char-syntax ?q) (with-syntax-table b (char-syntax ?q)) (char-syntax ?q)))
              (char-syntax ?q)))))
(sp "cs-parent-chain"
    (let* ((p (make-syntax-table)) (c (make-syntax-table p)))
      (modify-syntax-entry ?z "." p)
      (with-temp-buffer (set-syntax-table c)
        (list (char-syntax ?z) (progn (modify-syntax-entry ?z "w" c) (char-syntax ?z))
              (char-syntax ?a) (char-syntax #x3042)))))
(sp "cs-nonascii-entry"
    (let ((st (make-syntax-table)))
      (modify-syntax-entry #x3042 "." st) (modify-syntax-entry '(#x4e00 . #x4e10) "_" st)
      (with-temp-buffer (set-syntax-table st)
        (list (char-syntax #x3042) (char-syntax #x4e05) (char-syntax #x4e20)))))
