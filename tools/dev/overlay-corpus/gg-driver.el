;;; gg-driver.el --- GNU-gap harness driver  -*- lexical-binding: t; -*-
;; Each row is a defun taking N and returning a checksum so nothing is optimized away.
(defvar gg-ct (make-char-table 'foo))
(defvar gg-st (make-syntax-table))
(defvar gg-vec (vector 1 2 3))
(defvar gg-text "hello world foo bar\n* heading :tag:\n")

(defun gg-row-empty-loop (n)
  (let ((i 0) (s 0)) (while (< i n) (setq s (+ s 1)) (setq i (1+ i))) s))
(defun gg-row-trivial-builtin (n)
  (with-temp-buffer
    (let ((i 0) (s 0)) (while (< i n) (setq s (+ s (point))) (setq i (1+ i))) s)))
(defun gg-row-char-table-aref (n)
  (let ((i 0) (s 0)) (aset gg-ct 65 3)
       (while (< i n) (setq s (+ s (aref gg-ct 65))) (setq i (1+ i))) s))
(defun gg-row-char-table-aset (n)
  (let ((i 0)) (while (< i n) (aset gg-ct 66 i) (setq i (1+ i))) (aref gg-ct 66)))
(defun gg-row-syntax-aref (n)
  (let ((i 0) (s 0))
    (while (< i n) (setq s (+ s (if (consp (aref gg-st 65)) 1 0))) (setq i (1+ i))) s))
(defun gg-row-char-syntax (n)
  (with-temp-buffer
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (char-syntax ?a))) (setq i (1+ i))) s)))
(defun gg-row-looking-at (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (goto-char 1) (if (looking-at "hello") (setq s (1+ s))) (setq i (1+ i))) s)))
(defun gg-row-re-search-fwd (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (goto-char 1) (setq s (+ s (re-search-forward "heading" nil t))) (setq i (1+ i))) s)))
(defun gg-row-match-data (n)
  (with-temp-buffer (insert gg-text) (goto-char 1) (re-search-forward "heading" nil t)
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (car (match-data)))) (setq i (1+ i))) s)))
(defun gg-row-forward-word (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (goto-char 1) (forward-word 2) (setq s (+ s (point))) (setq i (1+ i))) s)))
(defun gg-row-skip-syntax (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (goto-char 1) (setq s (+ s (skip-syntax-forward "w"))) (setq i (1+ i))) s)))
(defun gg-row-insert-del (n)
  (with-temp-buffer
    (let ((i 0)) (while (< i n) (insert "x") (delete-char -1) (setq i (1+ i))) (buffer-size))))
(defun gg-row-temp-buffer (n)
  (let ((i 0) (s 0))
    (while (< i n) (setq s (+ s (with-temp-buffer (insert "a") (buffer-size)))) (setq i (1+ i))) s))
(defun gg-row-make-hash (n)
  (let ((i 0) (s 0))
    (while (< i n) (setq s (+ s (or (gethash 'a (make-hash-table)) 1))) (setq i (1+ i))) s))
(defun gg-row-vector-aref (n)
  (let ((i 0) (s 0))
    (while (< i n) (setq s (+ s (aref gg-vec 1))) (setq i (1+ i))) s))
(defun gg-row-string-match (n)
  (let ((i 0) (s 0))
    (while (< i n) (setq s (+ s (string-match "a+b" "xxaaab"))) (setq i (1+ i))) s))


(defun gg-row-parse-partial-sexp (n)
  (with-temp-buffer (insert "(a (b c) \"str\" d) e")
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (car (parse-partial-sexp 1 7)))) (setq i (1+ i))) s)))
(defun gg-row-scan-lists (n)
  (with-temp-buffer (insert "(a (b c) \"str\" d) e")
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (scan-lists 1 1 0))) (setq i (1+ i))) s)))
(defun gg-row-forward-sexp (n)
  (with-temp-buffer (insert "(a (b c) \"str\" d) e")
    (let ((i 0) (s 0))
      (while (< i n) (goto-char 1) (forward-sexp 1) (setq s (+ s (point))) (setq i (1+ i))) s)))
(defun gg-row-char-after (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (char-after 3))) (setq i (1+ i))) s)))
(defun gg-row-buffer-substring (n)
  (with-temp-buffer (insert gg-text)
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (length (buffer-substring 1 6)))) (setq i (1+ i))) s)))
(defun gg-row-get-text-property (n)
  (with-temp-buffer (insert gg-text) (put-text-property 1 6 'face 'bold)
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (if (eq (get-text-property 3 'face) 'bold) 1 0))) (setq i (1+ i))) s)))
(defun gg-row-next-single-property-change (n)
  (with-temp-buffer (insert gg-text) (put-text-property 1 6 'face 'bold)
    (let ((i 0) (s 0))
      (while (< i n) (setq s (+ s (next-single-property-change 1 'face))) (setq i (1+ i))) s)))

;; stage A rows (native buffer read)
(defmacro gg--buf-row (name form)
  `(defun ,name (n)
     (with-temp-buffer (insert gg-text) (goto-char 5)
       (let ((i 0) (s 0)) (while (< i n) (setq s (+ s ,form)) (setq i (1+ i))) s))))
(gg--buf-row gg-row-point (point))
(gg--buf-row gg-row-goto-char (goto-char 7))
(gg--buf-row gg-row-following-char (following-char))
(gg--buf-row gg-row-preceding-char (preceding-char))
(gg--buf-row gg-row-bobp (if (bobp) 1 2))
(gg--buf-row gg-row-eobp (if (eobp) 1 2))
(gg--buf-row gg-row-bolp (if (bolp) 1 2))
(gg--buf-row gg-row-eolp (if (eolp) 1 2))
(gg--buf-row gg-row-point-min (point-min))
(gg--buf-row gg-row-point-max (point-max))

;; ---- floor rows: same loop and setup, primitive replaced by (ignore 2) ----
;; row cost - row-floor = the primitive's own cost.  Both sides run these.
(defmacro gg--floor-row (name setup)
  `(defun ,name (n)
     (with-temp-buffer ,@setup
       (let ((i 0) (s 0)) (while (< i n) (ignore 2) (setq s (+ s 1)) (setq i (1+ i))) s))))
(defmacro gg--floor-row-g (name setup goto)
  `(defun ,name (n)
     (with-temp-buffer ,@setup
       (let ((i 0) (s 0)) (while (< i n) (goto-char ,goto) (ignore 2) (setq s (+ s 1)) (setq i (1+ i))) s))))
(gg--floor-row gg-row-char-syntax-floor ())
(gg--floor-row gg-row-char-after-floor ((insert gg-text)))
(gg--floor-row gg-row-buffer-substring-floor ((insert gg-text)))
(gg--floor-row gg-row-get-text-property-floor ((insert gg-text) (put-text-property 1 6 'face 'bold)))
(gg--floor-row gg-row-next-single-property-change-floor ((insert gg-text) (put-text-property 1 6 'face 'bold)))
(gg--floor-row gg-row-match-data-floor ((insert gg-text) (goto-char 1) (re-search-forward "heading" nil t)))
(gg--floor-row gg-row-scan-lists-floor ((insert "(a (b c) \"str\" d) e")))
(gg--floor-row gg-row-parse-partial-sexp-floor ((insert "(a (b c) \"str\" d) e")))
(gg--floor-row-g gg-row-looking-at-floor ((insert gg-text)) 1)
(gg--floor-row-g gg-row-re-search-fwd-floor ((insert gg-text)) 1)
(gg--floor-row-g gg-row-forward-word-floor ((insert gg-text)) 1)
(gg--floor-row-g gg-row-skip-syntax-floor ((insert gg-text)) 1)
(gg--floor-row-g gg-row-forward-sexp-floor ((insert "(a (b c) \"str\" d) e")) 1)
(gg--floor-row gg-row-string-match-floor ())
(gg--floor-row gg-row-insert-del-floor ())
(gg--floor-row gg-row-point-floor ((insert gg-text) (goto-char 5)))
(gg--floor-row-g gg-row-goto-char-floor ((insert gg-text)) 7)

(defconst gg-rows
  '(("empty-loop" 1000000) ("trivial-builtin" 1000000) ("char-table-aref" 1000000) ("char-table-aset" 1000000) ("syntax-aref" 1000000)
    ("char-syntax" 100000) ("looking-at" 20000) ("re-search-fwd" 20000)
    ("match-data" 20000) ("forward-word" 5000) ("skip-syntax" 20000)
    ("insert-del" 5000) ("temp-buffer" 1000) ("make-hash" 100000)
    ("vector-aref" 1000000) ("string-match" 20000)
    ("parse-partial-sexp" 5000) ("scan-lists" 5000) ("forward-sexp" 5000)
    ("char-after" 20000) ("buffer-substring" 20000) ("get-text-property" 20000)
    ("next-single-property-change" 20000)
    ("point" 100000) ("goto-char" 100000) ("following-char" 100000) ("preceding-char" 100000)
    ("char-syntax-floor" 100000) ("char-after-floor" 20000) ("buffer-substring-floor" 20000)
    ("get-text-property-floor" 20000) ("next-single-property-change-floor" 20000) ("match-data-floor" 20000)
    ("scan-lists-floor" 5000) ("parse-partial-sexp-floor" 5000) ("looking-at-floor" 20000) ("re-search-fwd-floor" 20000)
    ("forward-word-floor" 5000) ("skip-syntax-floor" 20000) ("forward-sexp-floor" 5000) ("string-match-floor" 20000)
    ("insert-del-floor" 5000) ("point-floor" 100000) ("goto-char-floor" 100000)
    ("bobp" 100000) ("eobp" 100000) ("bolp" 100000) ("eolp" 100000) ("point-min" 100000) ("point-max" 100000)))

(defun gg-run ()
  (let ((only (getenv "GG_ROWS")))
    (dolist (r gg-rows)
      (let* ((name (car r)) (n (* (cadr r) (string-to-number (or (getenv "GG_SCALE") "1")))) (fn (intern (concat "gg-row-" name))))
        (when (or (null only) (member name (split-string only ",")))
          (funcall fn (max 1 (/ n 10)))     ; warm-up
          (dolist (m (list n (* 4 n)))
            (let* ((t0 (float-time)) (res (funcall fn m)) (el (- (float-time) t0)))
              (princ (format "GG %s %d %.6f %S\n" name m el res)))))))
    (princ "GG-DONE\n")))
