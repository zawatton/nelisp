;;; bignum-cases.el --- bignum differential cases for NeLisp vs GNU Emacs  -*- lexical-binding: t -*-
;; Each case prints "NAME => RESULT".  Ends with "DONE n=N".  Large values are
;; summarized as (length prefix suffix checksum) to keep lines short.

(defvar bn-count 0)
(defun bn-sum (s)
  (let ((h 0) (i 0) (n (length s)))
    (while (< i n) (setq h (% (+ (* h 31) (aref s i)) 1000003)) (setq i (1+ i)))
    h))
(defun bn-show (v)
  (if (integerp v)
      (let ((s (number-to-string v)))
        (if (> (length s) 40)
            (list 'big (length s) (substring s 0 12) (substring s -12) (bn-sum s))
          v))
    v))
(defmacro bn-case (name form)
  `(progn (setq bn-count (1+ bn-count))
          (princ (format "%s => %S\n" ,name
                         (condition-case e (list 'ok (bn-show ,form)) (error (list 'err (car e))))))))

(defun bn-pow10 (n) (let ((r 1) (i 0)) (while (< i n) (setq r (* r 10)) (setq i (1+ i))) r))
(defun bn-pow2 (n) (let ((r 1) (i 0)) (while (< i n) (setq r (* r 2)) (setq i (1+ i))) r))

(let* ((a (+ (bn-pow2 200) 12345)) (b (+ (bn-pow2 70) 99)) (na (- a)) (nb (- b))
       (c (bn-pow10 40)) (d (+ (bn-pow10 25) 7)))
  (bn-case "div-pp" (/ a b))
  (bn-case "div-np" (/ na b))
  (bn-case "div-pn" (/ a nb))
  (bn-case "div-nn" (/ na nb))
  (bn-case "rem-pp" (% a b))
  (bn-case "rem-np" (% na b))
  (bn-case "rem-pn" (% a nb))
  (bn-case "rem-nn" (% na nb))
  (bn-case "mod-pp" (mod a b))
  (bn-case "mod-np" (mod na b))
  (bn-case "mod-pn" (mod a nb))
  (bn-case "mod-nn" (mod na nb))
  (bn-case "floor-np" (floor na b))
  (bn-case "floor-pn" (floor a nb))
  (bn-case "ceiling-pp" (ceiling a b))
  (bn-case "ceiling-np" (ceiling na b))
  (bn-case "truncate-np" (truncate na b))
  (bn-case "round-pp" (round a b))
  (bn-case "round-tie" (round (* 3 (bn-pow2 100)) (* 2 (bn-pow2 100))))
  (bn-case "round-tie2" (round (* 5 (bn-pow2 100)) (* 2 (bn-pow2 100))))
  (bn-case "div-small-divisor" (/ c 7))
  (bn-case "div-u32-divisor" (/ c 4294967295))
  (bn-case "div-big-by-big-exact" (/ (* c d) d))
  (bn-case "rem-big-by-big-exact" (% (* c d) d))
  (bn-case "div-fix-by-big" (/ 5 c))
  (bn-case "rem-fix-by-big" (% -5 c))
  (bn-case "mod-fix-by-big" (mod -5 c))
  (bn-case "div-self" (/ c c))
  (bn-case "div-nary" (/ (* c c c) d 3))
  (bn-case "div-recip" (/ c))
  (bn-case "div-zero" (/ c 0))
  (bn-case "rem-zero" (% c 0))
  (bn-case "mod-zero" (mod c 0))
  (bn-case "floor-zero" (floor c 0))
  (bn-case "div-addback" (/ (1- (bn-pow2 192)) (+ (* 2147483648 (bn-pow2 64)) 1)))
  (bn-case "rem-addback" (% (1- (bn-pow2 192)) (+ (* 2147483648 (bn-pow2 64)) 1))))

;; integer-width (default 65536 bits)
(bn-case "iw-ash-ok" (ash 1 65535))
(bn-case "iw-ash-over" (ash 1 65536))
(bn-case "iw-ash-zero" (ash 0 100000))
(bn-case "iw-expt-ok" (expt 2 65535))
(bn-case "iw-expt-over" (expt 2 65536))
(bn-case "iw-mul-ok" (* (ash 1 32767) (ash 1 32767)))
(bn-case "iw-mul-edge" (* (ash 1 32767) (ash 1 32768)))
(bn-case "iw-mul-over" (* (ash 1 32767) (ash 1 32769)))
(bn-case "iw-add-over" (+ (ash 1 65535) (ash 1 65535)))
(bn-case "iw-neg-edge" (- (ash 1 65535)))
(bn-case "iw-neg-over" (* (- (ash 1 65535)) 2))
(bn-case "iw-square-1e4" (let ((x (bn-pow10 20000))) (* x x)))
(bn-case "iw-read-ok" (read (concat "1" (make-string 19728 ?0))))
(bn-case "iw-read-over" (read (concat "1" (make-string 19729 ?0))))

;; conversion of 1e4-digit numbers
(let* ((s (concat "7" (make-string 9998 ?3) "1")) (n (read s)))
  (bn-case "conv-read-len" (length (number-to-string n)))
  (bn-case "conv-roundtrip" (equal (number-to-string n) s))
  (bn-case "conv-neg-roundtrip" (equal (number-to-string (- n)) (concat "-" s)))
  (bn-case "conv-string-to-number" (equal (string-to-number s) n))
  (bn-case "conv-format-d" (equal (format "%d" n) s))
  (bn-case "conv-format-s" (equal (format "%s" n) s))
  (bn-case "conv-prin1" (equal (prin1-to-string n) s))
  (bn-case "conv-value" n)
  (bn-case "conv-neg-value" (- n))
  (bn-case "conv-div-1e9" (/ n 1000000000))
  (bn-case "conv-chunk-zeros" (number-to-string (bn-pow10 9999)))
  (bn-case "conv-inner-zeros" (equal (number-to-string (+ (bn-pow10 4500) 5)) (concat "1" (make-string 4499 ?0) "5")))
  (bn-case "conv-read-leading-plus" (equal (read (concat "+" s)) n)))
(bn-case "conv-9digit-boundaries" (list (number-to-string (bn-pow10 18)) (number-to-string (1- (bn-pow10 27))) (number-to-string (+ (bn-pow10 27) 1))))
(bn-case "conv-read-trailing-dot" (read "1000000000000000000000000000."))

(princ (format "DONE n=%d\n" bn-count))
