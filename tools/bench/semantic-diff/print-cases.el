;;; print-cases.el --- prin1-to-string under escape/gensym variables  -*- lexical-binding: t -*-
;; Each case prints "NAME => RESULT".  Ends with "DONE n=N".  Covers every
;; combination of print-escape-nonascii, print-escape-multibyte and
;; print-gensym over strings, symbols, nested containers and atoms.

(defvar pc-count 0)
(defmacro pc-case (name form)
  `(progn (setq pc-count (1+ pc-count))
          (princ (format "%s => %S\n" ,name
                         (condition-case e (list 'ok ,form) (error (list 'err (car e))))))))

(defvar pc-unint (make-symbol "foo"))
(defvar pc-empty (make-symbol ""))
(defvar pc-objects
  (list (cons "ascii" "plain")
        (cons "quotes" "a\"b\\c")
        (cons "ja" "日本語")
        (cons "a-umlaut" "Ä")
        (cons "unibyte" (unibyte-string 65 200 255))
        (cons "interned" 'foo)
        (cons "uninterned" pc-unint)
        (cons "uninterned-empty" pc-empty)
        (cons "keyword" :kw)
        (cons "float" 1.5)
        (cons "nil" nil)
        (cons "t" t)
        (cons "quoted" ''x)
        (cons "quoted-str" (list 'quote "日本"))
        (cons "func" '#'car)
        (cons "list-ascii" '("a" b 3 (c "d")))
        (cons "list-mixed" (list "a" 'foo "日本" 1.0))
        (cons "list-unint" (list 'a pc-unint "s"))
        (cons "vec-mixed" (vector "x" pc-unint "Ä" :k nil))
        (cons "vec-nested" (vector (list "日" 'b) (vector pc-empty)))
        (cons "dotted" (cons "a" pc-unint))))

(dolist (na '(nil t))
  (dolist (mb '(nil t))
    (dolist (gs '(nil t))
      (dolist (o pc-objects)
        (let ((print-escape-nonascii na) (print-escape-multibyte mb) (print-gensym gs))
          (pc-case (format "n%d.m%d.g%d.%s" (if na 1 0) (if mb 1 0) (if gs 1 0) (car o))
                   (prin1-to-string (cdr o))))))))


;; --- native printer completion: vector cars, quote/backquote forms, records ---
(defvar pc2-bq (intern "`"))
(defvar pc2-cm (intern ","))
(defvar pc2-ca (intern ",@"))
(defvar pc2-objects
  (list (cons "vec-sym" (vector 'a 1 2))
        (cons "vec-kw" (vector :k "s" 'x))
        (cons "vec-car-in-list" (list (vector 'a 1) 'b))
        (cons "vec-car-kw-in-list" (list (vector :k 1) (vector 'z 'y) "s"))
        (cons "vec-car-single" (list (vector 'a)))
        (cons "vec-nested" (vector (vector 'a (list 'b (vector 'c))) 'd))
        (cons "vec-empty-in-list" (list (vector) (vector 1)))
        (cons "vec-hashname-1" (list (vector 'hash-table)))
        (cons "quote" (list 'quote 'x))
        (cons "quote-nested" (list 'quote (list 'quote 'x)))
        (cons "function" (list 'function 'car))
        (cons "quote-0" (list 'quote))
        (cons "quote-2" (list 'quote 'a 'b))
        (cons "quote-dot" (cons 'quote 'a))
        (cons "function-2" (list 'function 'a 'b))
        (cons "quote-in-list" (list 1 (list 'quote 'a) 3))
        (cons "quote-tail" (cons 1 (list 'quote 'a)))
        (cons "quote-vec" (list 'quote (vector 'a 1)))
        (cons "bq" (list pc2-bq (list 'a (list pc2-cm 'b) (list pc2-ca 'c))))
        (cons "bq-atom" (list pc2-bq 'a))
        (cons "bq-nested" (list pc2-bq (list 'a (list pc2-bq (list 'b (list pc2-cm (list pc2-cm 'c)))))))
        (cons "bq-3" (list pc2-bq 'a 'b))
        (cons "bq-in-list" (list 1 (list pc2-bq 'a)))
        (cons "bq-tail" (cons 1 (list pc2-bq 'a)))
        (cons "bq-comma-quote" (list pc2-bq (list (list pc2-cm (list 'quote 'x)) 'y)))
        (cons "bq-comma-3" (list pc2-bq (list (list pc2-cm 'a 'b))))
        (cons "bq-vec" (list pc2-bq (vector 'a (list pc2-cm 'b))))
        (cons "comma-bare" (list pc2-cm 'a))
        (cons "comma-at-bare" (list pc2-ca 'a))
        (cons "comma-in-list" (list 'x (list pc2-cm 'a)))
        (cons "record" (record 'foo 1 'a "s"))
        (cons "record-empty" (record 'foo))
        (cons "make-record" (make-record 'bar 2 'z))
        (cons "record-in-vec" (vector (record 'foo 1) 2))
        (cons "deep-list" (let ((x nil)) (dotimes (_ 40) (setq x (list x 'a))) x))
        (cons "deep-vec" (let ((x nil)) (dotimes (_ 40) (setq x (vector 'k x))) x))
        (cons "deep-100" (let ((x nil)) (dotimes (_ 100) (setq x (list x))) x))
        (cons "mixed-table"
              (list (list 'row 1 2.5 "s" (vector 'a "b" :c) 'sym)
                    (list (vector 'k 1) (list 'quote 'q) (list 'function 'f))
                    (cons 'dot (vector 'v)) nil t))))
(dolist (o pc2-objects)
  (pc-case (format "n.prin1.%s" (car o)) (prin1-to-string (cdr o)))
  (pc-case (format "n.princ.%s" (car o)) (prin1-to-string (cdr o) t))
  (pc-case (format "n.fmtS.%s" (car o)) (format "%S" (cdr o)))
  (pc-case (format "n.fmts.%s" (car o)) (format "%s" (cdr o))))

(princ (format "DONE n=%d\n" pc-count))
(kill-emacs 0)
