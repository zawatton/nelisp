;;; ---- fset/advice override (compiled callers observe override?) ----
(defun sd-call-logand (a b) (logand a b))
(defun sd-call-gethash (k h) (gethash k h))
(defun sd-call-concat (a b) (concat a b))
(defun sd-call-plus (a b c) (+ a b c))
(defun sd-call-aref (v i) (aref v i))
(condition-case e (progn (byte-compile 'sd-call-logand) (byte-compile 'sd-call-gethash)
                         (byte-compile 'sd-call-concat) (byte-compile 'sd-call-plus)
                         (byte-compile 'sd-call-aref))
  (error (princ (format "SETUP byte-compile failed %S\n" e))))

(defmacro sd-fset-case (name fn call result)
  `(sd-case ,name
     (let* ((orig (symbol-function ',fn)) (before ,call) after)
       (unwind-protect
           (progn (fset ',fn (lambda (&rest _) 'overridden))
                  (setq after ,call))
         (fset ',fn orig))
       (list before after ,call))))

(sd-fset-case "fset-logand" logand (sd-call-logand 12 10) nil)
(sd-fset-case "fset-gethash" gethash (sd-call-gethash 'a (let ((h (make-hash-table))) (puthash 'a 1 h) h)) nil)
(sd-fset-case "fset-concat" concat (sd-call-concat "a" "b") nil)
(sd-fset-case "fset-plus" + (sd-call-plus 1 2 3) nil)
(sd-fset-case "fset-aref" aref (sd-call-aref [1 2] 0) nil)

(defun sd-advice-fn (orig &rest args) (list 'advised (apply orig args)))
(sd-case "advice-logand"
  (if (fboundp 'advice-add)
      (let ((before (sd-call-logand 12 10)) after)
        (advice-add 'logand :around #'sd-advice-fn)
        (unwind-protect (setq after (sd-call-logand 12 10))
          (advice-remove 'logand #'sd-advice-fn))
        (list before after (sd-call-logand 12 10)))
    'no-advice))
(sd-case "advice-gethash"
  (if (fboundp 'advice-add)
      (let ((h (make-hash-table)) after)
        (puthash 'a 1 h)
        (advice-add 'gethash :around #'sd-advice-fn)
        (unwind-protect (setq after (sd-call-gethash 'a h))
          (advice-remove 'gethash #'sd-advice-fn))
        (list after (sd-call-gethash 'a h)))
    'no-advice))
(sd-case "advice-concat"
  (if (fboundp 'advice-add)
      (let (after)
        (advice-add 'concat :around #'sd-advice-fn)
        (unwind-protect (setq after (sd-call-concat "a" "b"))
          (advice-remove 'concat #'sd-advice-fn))
        (list after (sd-call-concat "a" "b")))
    'no-advice))

(princ (format "DONE n=%d\n" sd-count))
