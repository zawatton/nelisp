;;; cases.el --- differential semantic cases for NeLisp vs GNU Emacs  -*- lexical-binding: t -*-
;; Each case prints "NAME => RESULT" (interpreted/closure) and "NAME[c] => RESULT"
;; (byte-compiled defun when byte-compile is available).  Ends with "DONE n=N".

(defvar sd-count 0)
(defvar sd-eqc 0)
(defvar sd-hc 0)

(defun sd-emit (name tag thunk)
  (let ((r (condition-case e (list 'ok (funcall thunk))
             (error (list 'err e)))))
    (setq sd-count (1+ sd-count))
    (let ((print-escape-newlines t) (print-length nil) (print-level nil))
      (princ (format "%s%s => %s\n" name tag
                     (if (eq (car r) 'ok) (prin1-to-string (cadr r))
                       (prin1-to-string (cons 'error (cadr r)))))))))

(defun sd-run (name thunk) (sd-emit name "" thunk))
(defun sd-runc (name sym)
  (let ((ok (condition-case e (progn (byte-compile sym) t) (error nil))))
    (sd-emit name "[c]" (lambda () (funcall sym)))
    ok))

(defmacro sd-case (name form)
  (let ((sym (intern (concat "sd-c-" name))))
    `(progn (sd-run ,name (lambda () ,form))
            (defun ,sym () ,form)
            (sd-runc ,name ',sym))))

(defun sd-teq (a b) (setq sd-eqc (1+ sd-eqc)) (equal a b))
(defun sd-thash (k) (setq sd-hc (1+ sd-hc)) (sxhash-equal k))
(condition-case e (define-hash-table-test 'sd-t #'sd-teq #'sd-thash)
  (error (princ (format "SETUP define-hash-table-test failed %S\n" e))))

