;;; kernel-cases.el --- kernel-level differential cases  -*- lexical-binding: t; -*-
;; Shared by the GNU (byte-compiled kernels) and NeLisp (admitted native kernels) runs.
;; Every case prints one line "NAME => RESULT".  Output is ASCII-only.

(defvar kc-count 0)
(defun kc-san (x)
  (cond ((stringp x) (if (> (length x) 80) (format "<str %d>" (length x)) x))
        ((vectorp x) (format "<vec %d>" (length x)))
        ((consp x) (cons (kc-san (car x)) (kc-san (cdr x))))
        (t x)))
(defun kc-ascii (s)
  (mapconcat (lambda (c) (if (or (< c 32) (> c 126)) (format "\\x%X" c) (string c)))
             (append s nil) ""))
(defun kc-run (name thunk)
  (setq kc-count (1+ kc-count))
  (let ((r (condition-case e (funcall thunk) (error (cons 'error e)))))
    (princ (concat name " => " (kc-ascii (format "%S" (kc-san r))) "\n"))))
(defun kc-digest (v)
  (let ((k 0) (s 0) (n (length v)))
    (while (< k n)
      (let ((e (aref v k)))
        (setq s (% (+ s (* (1+ k) (if (integerp e) e 7))) 1000003)))
      (setq k (1+ k)))
    s))
(defun kc-mkvec (n)
  (let ((v (make-vector n 0)) (j 0))
    (while (< j n) (aset v j (logand (+ (* 17 j) 3) 65535)) (setq j (1+ j)))
    v))
(defun kc-mktable (len mode)
  ;; MODE: ascii, mb (multibyte incl. e-acute and Japanese), uni8 (unibyte 128..255)
  (let ((tb (make-vector 16 nil)) (j 0) k cs)
    (while (< j 16)
      (setq cs nil k 0)
      (while (< k len)
        (setq cs (cons (cond ((eq mode 'ascii) (+ 33 (% (+ j k) 90)))
                             ((eq mode 'mb) (if (= 0 (% (+ j k) 3)) (+ #x65e5 j k) (+ 233 j k)))
                             (t (+ 128 (% (+ (* 3 j) k) 128))))
                       cs)
              k (1+ k)))
      (aset tb j (if (eq mode 'uni8) (apply #'unibyte-string (nreverse cs)) (apply #'string (nreverse cs))))
      (setq j (1+ j)))
    tb))
(defun kc-mkhash ()
  (let ((h (make-hash-table :test 'equal)) (l (make-vector 1024 nil)) (j 0))
    (while (< j 1024)
      (puthash (format "key%04d" j) (logand (+ (* 17 j) 3) 65535) h)
      (aset l j (format "key%04d" (logand (+ (* 73 j) 19) 1023)))
      (setq j (1+ j)))
    (vector h l)))
(defun kc-slice-text (s) (substring s 8 24))
(defun kc-concat-text (a b) (concat a b))
(defun kc-prop (s) (propertize s 'face 'bold))

