;;; S5 string-concat16
(defun kc-cin (la lb ma mb)
  (let ((a (make-vector 16 nil)) (b (make-vector 16 nil)) (j 0))
    (while (< j 16)
      (aset a j (aref (kc-mktable la ma) j))
      (aset b j (aref (kc-mktable lb mb) j))
      (setq j (1+ j)))
    (vector nil a b)))
