;;; workload.el --- R4 region measurement workload (protocol-frozen.json) -*- lexical-binding: t; -*-
;; Env: RM_ROW (gc-pause|word-access), RM_VARIANT, RM_N (word-access trip count).
(let* ((row (getenv "RM_ROW")) (variant (getenv "RM_VARIANT")))
  (cond
   ((equal row "gc-pause")
    (let* ((words 4194304) (keep nil) (times nil) (check 0))
      (cond ((equal variant "vector")
             (setq keep (make-vector words 0))
             (dotimes (i words) (aset keep i (logand i 1023))))
            ((equal variant "region")
             (setq keep (nelisp--region-open (* 8 words)))
             (dotimes (i words) (nelisp--region-i64-set keep i (logand i 1023)))))
      (garbage-collect)
      (dotimes (_ 5)
        (let ((t0 (nelisp--monotonic-ns)))
          (garbage-collect)
          (push (- (nelisp--monotonic-ns) t0) times)))
      (setq check (cond ((equal variant "vector") (aref keep 4194303))
                        ((equal variant "region") (nelisp--region-i64-ref keep 4194303))
                        (t 1023)))
      (setq times (sort times #'<))
      (princ (format "RM row=gc-pause variant=%s median_ns=%d all=%S check=%d\n"
                     variant (nth 2 times) (reverse times) check))
      (when (equal variant "region") (nelisp--region-close keep))))
   ((equal row "word-access")
    (let* ((n (string-to-number (getenv "RM_N"))) (sum 0) (t0 0) (t1 0))
      (if (equal variant "vector")
          (let ((v (make-vector 4096 0)))
            (setq t0 (nelisp--monotonic-ns))
            (dotimes (i n)
              (let ((j (logand i 4095)))
                (aset v j i)
                (setq sum (+ sum (aref v j)))))
            (setq t1 (nelisp--monotonic-ns)))
        (let ((r (nelisp--region-open 32768)))
          (setq t0 (nelisp--monotonic-ns))
          (dotimes (i n)
            (let ((j (logand i 4095)))
              (nelisp--region-i64-set r j i)
              (setq sum (+ sum (nelisp--region-i64-ref r j)))))
          (setq t1 (nelisp--monotonic-ns))
          (nelisp--region-close r)))
      (princ (format "RM row=word-access variant=%s n=%d inner_ns=%d sum=%d\n"
                     variant n (- t1 t0) sum))))))
(kill-emacs 0)
