(load (expand-file-name "hdr.el" (file-name-directory load-file-name)) nil t)
(defvar log nil)
(cl-defstruct gs-a x) (cl-defstruct (gs-b (:include gs-a)) y) (cl-defstruct (gs-c (:include gs-b)) z)
;; basic primary + call-next-method
(cl-defgeneric g1 (x))
(cl-defmethod g1 ((x integer)) (list 'int x (cl-next-method-p)))
(cl-defmethod g1 ((x number)) (list 'num x))
(cl-defmethod g1 ((x t)) (list 't x))
(cl-defmethod g1 ((x string)) (list 'str x))
(cl-defmethod g1 ((x symbol)) (list 'sym x))
(cl-defmethod g1 ((x null)) (list 'null (cl-call-next-method)))
(cl-defmethod g1 ((x list)) (list 'list x))
(cl-defmethod g1 ((x cons)) (list 'cons (cl-call-next-method)))
(cl-defmethod g1 ((x float)) (list 'float (cl-call-next-method)))
(cl-defmethod g1 ((x vector)) (list 'vec (cl-call-next-method)))
(T (g1 1)) (T (g1 1.5)) (T (g1 "s")) (T (g1 'a)) (T (g1 nil)) (T (g1 '(1))) (T (g1 [1])) (T (g1 :k)) (T (g1 t))
(T (g1 (make-gs-a)))
;; overlaps: eql vs integer
(cl-defgeneric g2 (x))
(cl-defmethod g2 ((x (eql 5))) (list 'eql5 (cl-call-next-method)))
(cl-defmethod g2 ((x integer)) (list 'int (cl-call-next-method)))
(cl-defmethod g2 ((x number)) (list 'num))
(T (g2 5)) (T (g2 6)) (T (g2 5.0)) (T (g2 "x"))
;; struct hierarchy
(cl-defgeneric g3 (x))
(cl-defmethod g3 ((x gs-a)) (list 'a (cl-next-method-p)))
(cl-defmethod g3 ((x gs-b)) (list 'b (cl-call-next-method)))
(cl-defmethod g3 ((x gs-c)) (list 'c (cl-call-next-method)))
(cl-defmethod g3 ((x t)) 'any)
(T (g3 (make-gs-a))) (T (g3 (make-gs-b))) (T (g3 (make-gs-c))) (T (g3 3))
;; qualifiers
(cl-defgeneric g4 (x))
(cl-defmethod g4 ((x integer)) (push 'prim log) 'p)
(cl-defmethod g4 :before ((x integer)) (push 'before-int log))
(cl-defmethod g4 :before ((x number)) (push 'before-num log))
(cl-defmethod g4 :after ((x integer)) (push 'after-int log))
(cl-defmethod g4 :after ((x number)) (push 'after-num log))
(cl-defmethod g4 :around ((x integer)) (push 'around-int log) (cl-call-next-method))
(cl-defmethod g4 :around ((x number)) (push 'around-num log) (cl-call-next-method))
(T (progn (setq log nil) (list (g4 1) (reverse log))))
(T (progn (setq log nil) (g4 1.5)))
(T (g4 "x"))
;; head
(cl-defgeneric g5 (x))
(cl-defmethod g5 ((x (head foo))) (list 'foo (cl-call-next-method)))
(cl-defmethod g5 ((x cons)) (list 'cons))
(cl-defmethod g5 ((x list)) (list 'list))
(cl-defmethod g5 ((x (eql nil))) (list 'eqlnil (cl-call-next-method)))
(T (g5 '(foo 1))) (T (g5 '(bar 1))) (T (g5 nil)) (T (g5 1))
;; eql string/symbol
(cl-defgeneric g6 (x))
(cl-defmethod g6 ((x (eql 'a))) 'a)
(cl-defmethod g6 ((x (eql 'b))) 'b)
(cl-defmethod g6 ((x symbol)) 'sym)
(cl-defmethod g6 ((x (eql 3))) 'three)
(cl-defmethod g6 ((x integer)) 'int)
(T (list (g6 'a) (g6 'b) (g6 'c) (g6 3) (g6 4) (g6 nil)))
;; symbol/null/boolean/keyword overlaps
(cl-defgeneric g7 (x))
(cl-defmethod g7 ((x symbol)) (list 'sym (cl-call-next-method)))
(cl-defmethod g7 ((x null)) (list 'null (cl-call-next-method)))
(cl-defmethod g7 ((x list)) (list 'list (cl-call-next-method)))
(cl-defmethod g7 ((x t)) 't)
(cl-defmethod g7 ((x boolean)) (list 'bool (cl-call-next-method)))
(T (g7 nil)) (T (g7 t)) (T (g7 'a)) (T (g7 '(1))) (T (g7 1))
(cl-defgeneric g8 (x))
(cl-defmethod g8 ((x sequence)) (list 'seq))
(cl-defmethod g8 ((x array)) (list 'array (cl-call-next-method)))
(cl-defmethod g8 ((x string)) (list 'string (cl-call-next-method)))
(cl-defmethod g8 ((x atom)) (list 'atom))
(cl-defmethod g8 ((x list)) (list 'list (cl-call-next-method)))
(T (g8 "s")) (T (g8 [1])) (T (g8 '(1))) (T (g8 nil)) (T (g8 3)) (T (g8 (make-bool-vector 1 t)))
(cl-defgeneric g9 (x))
(cl-defmethod g9 ((x number)) (list 'num (cl-call-next-method)))
(cl-defmethod g9 ((x integer)) (list 'int (cl-call-next-method)))
(cl-defmethod g9 ((x fixnum)) (list 'fix (cl-call-next-method)))
(cl-defmethod g9 ((x atom)) (list 'atom))
(T (g9 3)) (T (g9 3.5)) (T (g9 'a))
;; multi-arg
(cl-defgeneric g10 (x y))
(cl-defmethod g10 ((x integer) (y integer)) 'ii)
(cl-defmethod g10 ((x integer) (y number)) (list 'in (cl-call-next-method)))
(cl-defmethod g10 ((x number) (y integer)) (list 'ni (cl-call-next-method)))
(cl-defmethod g10 ((x number) (y number)) 'nn)
(cl-defmethod g10 ((x t) (y t)) 'tt)
(cl-defmethod g10 ((x (eql 1)) y) (list 'one (cl-call-next-method)))
(T (g10 1 2)) (T (g10 2 2)) (T (g10 2 2.5)) (T (g10 2.5 2)) (T (g10 "a" 2)) (T (g10 1 2.5))
(cl-defgeneric g11 (x &optional y))
(cl-defmethod g11 ((x integer) &optional y) (list x y))
(T (g11 1)) (T (g11 1 2))
;; next-method args
(cl-defgeneric g12 (x))
(cl-defmethod g12 ((x integer)) (list 'int (cl-call-next-method (1+ x))))
(cl-defmethod g12 ((x number)) (list 'num x))
(T (g12 1))
;; no applicable
(T (condition-case e (g2 "zz") (cl-no-applicable-method (list 'nam (cadr e)))))
(cl-defgeneric g13 (x))
(cl-defmethod g13 ((x integer)) 1)
(T (condition-case e (g13 'a) (cl-no-applicable-method (list 'nam (car e) (cdr e)))))
(cl-defmethod cl-no-applicable-method ((g (eql g13)) &rest args) (list 'custom args))
(T (g13 'a))
;; redefinition and cache invalidation
(cl-defgeneric g14 (x))
(cl-defmethod g14 ((x integer)) 'one)
(T (g14 1))
(cl-defmethod g14 ((x integer)) 'two)
(T (g14 1))
(T (condition-case nil (g14 "a") (cl-no-applicable-method 'none)))
(cl-defmethod g14 ((x string)) 'str)
(T (g14 "a"))
(cl-defmethod g14 ((x (eql 1))) 'eql1)
(T (g14 1))
(T (g14 2))
;; redefine struct parent via new defstruct after calls
(cl-defgeneric g15 (x))
(cl-defmethod g15 ((x gs-a)) 'a)
(T (g15 (make-gs-a)))
(cl-defstruct gs-d x) (cl-defstruct (gs-e (:include gs-d)) y)
(T (condition-case nil (g15 (make-gs-e)) (cl-no-applicable-method 'none)))
(cl-defmethod g15 ((x gs-d)) 'd)
(T (g15 (make-gs-e)))
;; defgeneric with default body & options
(cl-defgeneric g16 (x) "doc" (list 'default x))
(T (g16 1))
(cl-defmethod g16 ((x integer)) (list 'int (cl-call-next-method)))
(T (g16 1)) (T (g16 'a))
;; cl-call-next-method with no next
(cl-defgeneric g17 (x))
(cl-defmethod g17 ((x integer)) (cl-call-next-method))
(T (condition-case e (g17 1) (cl-no-next-method 'nonext)))
;; :extra
(cl-defgeneric g18 (x))
(cl-defmethod g18 ((x integer)) (list 'base))
(cl-defmethod g18 :extra "e1" ((x integer)) (list (quote ex1) (cl-call-next-method)))
(T (g18 1))
;; &context
(defvar g19-ctx 'a)
(cl-defgeneric g19 (x))
(cl-defmethod g19 (x &context (g19-ctx (eql a))) (list 'ctx-a x))
(cl-defmethod g19 (x &context (g19-ctx (eql b))) (list 'ctx-b x))
(cl-defmethod g19 (x) (list 'noctx x))
(T (g19 1)) (T (let ((g19-ctx 'b)) (g19 1))) (T (let ((g19-ctx 'c)) (g19 1))) (T (g19 2))
;; function values / hash tables / buffers
(cl-defgeneric g20 (x))
(cl-defmethod g20 ((x hash-table)) 'ht)
(cl-defmethod g20 ((x buffer)) 'buf)
(cl-defmethod g20 ((x function)) 'fn)
(cl-defmethod g20 ((x marker)) 'marker)
(T (list (g20 (make-hash-table)) (g20 (current-buffer)) (g20 (lambda (x) x)) (g20 (point-marker))))
(cl-defgeneric g21 (x))
(cl-defmethod g21 ((x symbol)) 'sym)
(cl-defmethod g21 ((x keyword)) 'kw)
(T (list (g21 :a) (g21 'a)))
(cl-defgeneric g22 (x))
(cl-defmethod g22 ((x fixnum)) 'fix)
(cl-defmethod g22 ((x bignum)) 'big)
(cl-defmethod g22 ((x integer)) 'int)
(T (list (g22 5) (g22 (expt 2 70)) (g22 -5) (g22 (- (expt 2 70)))))
(cl-defgeneric g23 (x))
(cl-defmethod g23 ((x natnum)) 'nat)
(cl-defmethod g23 ((x integer)) 'int)
(T (list (g23 5) (g23 -5) (g23 (expt 2 70)) (g23 (- (expt 2 70)))))
