(load (expand-file-name "hdr.el" (file-name-directory load-file-name)) nil t)
(cl-defstruct ds-a (x 10) (y (+ 1 2)) z)
(cl-defstruct (ds-b (:include ds-a)) (w 7))
(cl-defstruct (ds-c (:include ds-b (x 99))) v)
(T (make-ds-a))
(T (make-ds-b))
(T (make-ds-b :x 1 :w 2))
(T (make-ds-c))
(T (list (ds-a-x (make-ds-c)) (ds-a-y (make-ds-c)) (ds-b-w (make-ds-c)) (ds-c-v (make-ds-c))))
(T (ds-a-p (make-ds-c)))
(T (ds-b-p (make-ds-a)))
(T (ds-c-p (make-ds-c)))
(T (let ((o (make-ds-b))) (setf (ds-a-x o) 5) (copy-ds-b o)))
(T (let* ((o (make-ds-a :x 1)) (c (copy-ds-a o))) (list (eq o c) (equal o c))))
;; :type list/vector
(cl-defstruct (dl (:type list)) a (b 2))
(cl-defstruct (dln (:type list) :named) a (b 2))
(cl-defstruct (dv (:type vector)) a (b 2))
(cl-defstruct (dvn (:type vector) :named) a (b 2))
(T (make-dl :a 1))
(T (make-dln :a 1))
(T (make-dv :a 1))
(T (make-dvn :a 1))
(T (dl-b (make-dl :a 1 :b 5)))
(T (dln-b (make-dln :a 1 :b 5)))
(T (dv-b (make-dv :a 1 :b 5)))
(T (dvn-b (make-dvn :a 1 :b 5)))
(T (dln-p (make-dln)))
(T (dvn-p (make-dvn)))
(T (dln-p '(1 2)))
(T (condition-case nil (dl-p '(1)) (void-function 'nopred)))
(T (let ((o (make-dvn :a 1))) (setf (dvn-a o) 9) o))
(T (copy-dln (make-dln :a 1)))
(T (vectorp (make-dv)))
(T (recordp (make-dvn)))
;; constructors
(cl-defstruct (cv (:constructor cv-new) (:constructor cv-boa (a &optional b &key c) ) (:copier cv-dup) (:predicate is-cv)) a b c)
(T (cv-new :a 1 :b 2))
(T (cv-boa 1))
(T (cv-boa 1 2))
(T (cv-dup (cv-boa 1 2)))
(T (is-cv (cv-new)))
(T (fboundp 'make-cv))
(T (fboundp 'copy-cv))
(cl-defstruct (cn (:constructor nil) (:constructor cn-make (a b))) a b)
(T (cn-make 1 2))
(T (fboundp 'make-cn))
(cl-defstruct (cc (:conc-name cc-get-)) a b)
(T (cc-get-a (make-cc :a 4)))
(cl-defstruct (cd (:constructor cd-make (a &aux (b (* a 2))))) a b)
(T (cd-make 5))
(cl-defstruct (cok (:constructor cok-make (&key a (b 3)))) a b)
(T (cok-make :a 1))
(cl-defstruct (cdoc) "docstring" a)
(T (make-cdoc :a 1))
(cl-defstruct (cro) (a 1 :read-only t))
(T (make-cro))
(cl-defstruct (ctyped) (a nil :type integer))
(T (make-ctyped :a 3))
(T (type-of (make-ds-b)))
(T (cl-typep (make-ds-b) 'ds-a))
(T (cl-struct-slot-value 'ds-a 'x (make-ds-a)))
(T (ds-a-x (make-ds-b :x 7)))
(T (let ((o (make-ds-a))) (cl-incf (ds-a-x o)) (ds-a-x o)))
(T (condition-case e (ds-a-x 5) (error (car e))))
(T (condition-case e (make-ds-a :bad 1) (error (car e))))
;; predicate on included: child instance satisfies parent pred; sibling does not
(cl-defstruct (ds-d (:include ds-a)))
(T (ds-b-p (make-ds-d)))
