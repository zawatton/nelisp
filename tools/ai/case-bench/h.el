;;; -*- lexical-binding: t -*-
;; MODE=discover: find an argument tuple each function accepts.
;; MODE=time: ns per direct call from a compiled driver loop.
(defvar h-pool '("3" "\"abc def\"" "'(1 2 3)" "[1 2 3]" "nil" "'foo" "#'identity" "t" "1.5" "'((a . 1) (b . 2))" "(current-buffer)"))
(defvar h-deny (concat "kill\\|delete-file\\|delete-directory\\|rename-file\\|copy-file\\|make-directory\\|write\\|save\\|process\\|shell\\|start-\\|exit\\|abort\\|^read\\|-read-\\|y-or-n\\|yes-or-no\\|sit-for\\|sleep\\|accept\\|recursive\\|top-level\\|^load\\|require\\|provide\\|^eval\\|garbage\\|thread\\|mutex\\|condition-var\\|debug\\|message\\|warn\\|display\\|ding\\|beep\\|redisplay\\|frame\\|window\\|timer\\|run-with\\|signal\\|error\\|throw\\|set-file\\|file-modes\\|symlink\\|make-temp\\|server\\|network\\|url\\|browse\\|princ\\|print\\|terpri\\|send-string\\|setenv\\|fset\\|defalias\\|makunbound\\|^set$\\|set-default\\|advice\\|^def\\|unintern\\|obarray\\|^h-\\|zz-\\|command\\|minibuffer\\|keyboard\\|input\\|event\\|^exec\\|^run-hook\\|add-hook\\|remove-hook\\|backtrace\\|^funcall\\|^apply"))
(defun h-tuples (n)
  (let ((acc (list nil)))
    (dotimes (_ n) (setq acc (apply #'append (mapcar (lambda (tu) (mapcar (lambda (i) (cons i tu)) (number-sequence 0 (1- (length h-pool))))) acc))))
    (setq acc (sort acc (lambda (a b) (< (apply #'+ a) (apply #'+ b)))))
    (let ((r nil) (k 0)) (while (and acc (< k 80)) (push (car acc) r) (setq acc (cdr acc) k (1+ k))) (nreverse r))))
(defun h-args (tu) (mapcar (lambda (i) (nth i h-pool)) tu))
(defun h-lines (file) (with-temp-buffer (insert-file-contents file) (split-string (buffer-string) "\n" t)))
(defun h-discover ()
  (dolist (name (h-lines (getenv "NAMES")))
    (let* ((s (intern name)))
      (cond ((string-match-p h-deny name) (princ (format "SKIP %s deny\n" name)))
            ((not (fboundp s)) (princ (format "SKIP %s unbound\n" name)))
            ((or (special-form-p s) (macrop s)) (princ (format "SKIP %s macro\n" name)))
            (t
             (princ (format "TRY %s\n" name))
             (when (autoloadp (symbol-function s)) (condition-case nil (autoload-do-load (symbol-function s) s) (error nil)))
             (condition-case err
             (let* ((ar (func-arity s)) (mn (car ar)) (mx (if (numberp (cdr ar)) (cdr ar) (+ mn 2))) (done nil) (n mn))
               (while (and (not done) (<= n (min mx 3)))
                 (let ((ts (h-tuples n)))
                   (while (and ts (not done))
                     (let ((forms (h-args (car ts))))
                       (when (condition-case nil
                                 (with-temp-buffer (insert "abc def\nghi jkl\n") (goto-char 2)
                                   (apply s (mapcar (lambda (f) (eval (car (read-from-string f)) t)) forms)) t)
                               (error nil))
                         (setq done forms)))
                     (setq ts (cdr ts))))
                 (setq n (1+ n)))
               (if done (princ (format "OK %s\t%s\n" name (mapconcat #'identity done "\x1f")))
                 (princ (format "NOARGS %s\n" name))))
             (error (princ (format "HERR %s %S\n" name err)))))))))
(defun h-time-one (call)
  (eval (car (read-from-string (format "(defun zz-drv (n) (let ((i 0)) (while (< i n) %s (setq i (1+ i)))))" call))) t)
  (when (and (fboundp 'byte-compile) (not (boundp 'nelisp--fx-table))) (byte-compile 'zz-drv))
  (with-temp-buffer
    (insert "abc def\nghi jkl\n") (goto-char 2)
    (zz-drv 2)
    (let* ((t0 (float-time)) (_ (zz-drv 20)) (dt (- (float-time) t0))
           (n (max 20 (min 400000 (floor (* 20 (/ 0.03 (max dt 1e-7)))))))
           (best nil))
      (dotimes (_ 3)
        (let* ((a (float-time)) (_ (zz-drv n)) (b (float-time)) (_ (zz-drv (* 2 n))) (c (float-time))
               (per (/ (- (- c b) (- b a)) n)))
          (when (or (null best) (< per best)) (setq best per))))
      (cons n best))))
(defun h-time ()
  (let ((base (cdr (h-time-one "nil"))))
    (princ (format "BASE %.1f\n" (* 1e9 base)))
    (dolist (l (h-lines (getenv "OKS")))
      (let* ((p (split-string l "\t")) (name (car p)) (args (split-string (or (cadr p) "") "\x1f" t))
             (call (format "(%s %s)" name (mapconcat #'identity args " ")))
             (r (condition-case e (h-time-one call) (error (list 'err (car e))))))
        (princ (if (eq (car r) 'err) (format "ERR %s %S\n" name (cadr r))
                 (format "T %s %.1f %d\n" name (* 1e9 (- (cdr r) base)) (car r))))))))
(if (equal (getenv "MODE") "discover") (h-discover) (h-time))
