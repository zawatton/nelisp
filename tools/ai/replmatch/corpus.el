;;; -*- lexical-binding: t; -*-
;; replace-match corpus: prints one line per case; compare NeLisp vs GNU output.
(defvar rm--n 0)
(defmacro rm-case (&rest body)
  `(progn (setq rm--n (1+ rm--n))
          (princ (format "%d: %S\n" rm--n (condition-case e (progn ,@body) (error (list 'ERR (car e) (cdr e))))))))
(defun rm-buf (text re newtext &rest args)
  (with-temp-buffer
    (insert text) (goto-char (point-min))
    (let ((hits nil))
      (while (re-search-forward re nil t)
        (apply #'replace-match newtext args)
        (push (point) hits))
      (list (buffer-string) (point) (nreverse hits)))))
(defun rm-str (s re newtext &rest args)
  (let ((i (string-match re s))) (and i (apply #'replace-match newtext (nth 0 args) (nth 1 args) s (nthcdr 2 args)))))
(rm-case (rm-buf "foo boo woo" "[oO]" "O" t t))
(rm-case (rm-buf "foo Foo FOO" "foo" "bar"))
(rm-case (rm-buf "foo Foo FOO fOo" "foo" "bar baz"))
(rm-case (rm-buf "foo Foo FOO" "foo" "bar" t))
(rm-case (rm-buf "foo Foo FOO" "foo" "b\\&r" nil nil))
(rm-case (rm-buf "foo Foo FOO" "foo" "b\\&r" t t))
(rm-case (rm-buf "ab12 cd34" "\\([a-z]+\\)\\([0-9]+\\)" "\\2-\\1" t))
(rm-case (rm-buf "ab12 cd34" "\\([a-z]+\\)\\([0-9]+\\)" "<\\2>" t nil nil 1))
(rm-case (rm-buf "ab12 cd34" "\\([a-z]+\\)\\([0-9]+\\)" "<\\2>" t t nil 1))
(rm-case (rm-buf "ab12 cd34" "\\([a-z]+\\)\\([0-9]+\\)" "X" t nil nil 2))
(rm-case (rm-buf "ab12" "\\([a-z]+\\)\\([0-9]+\\)" "X" t nil nil 3))
(rm-case (rm-buf "ab12" "\\([a-z]+\\)\\(x\\)?" "Y" t nil nil 2))
(rm-case (rm-buf "ab12" "\\([a-z]+\\)\\(x\\)?" "[\\2]" t))
(rm-case (rm-buf "ab12" "\\(a\\)" "\\\\" t))
(rm-case (rm-buf "ab12" "a" "\\?" t))
(rm-case (rm-buf "ab12" "a" "\\" t))
(rm-case (rm-buf "ab12" "a" "\\9" t))
(rm-case (rm-buf "hello World" "\\w+" "xyz"))
(rm-case (rm-buf "HELLO World hello" "\\w+" "xyz"))
(rm-case (rm-buf "Hello hello HELLO" "hello" "wORLD"))
(rm-case (rm-buf "a b" "a" "" t t))
(rm-case (rm-buf "aaa" "a" "bb" t t))
(rm-case (rm-str "foo bar" "o+" "0"))
(rm-case (rm-str "Foo bar" "foo" "x"))
(rm-case (rm-str "FOO bar" "foo" "xy"))
(rm-case (let ((case-fold-search t)) (rm-str "FOO bar" "foo" "xy" t)))
(rm-case (rm-str "foo bar" "\\(o+\\) \\(b\\)" "[\\2\\1]" t))
(rm-case (rm-str "foo bar" "\\(o+\\) \\(b\\)" "[\\&]" t))
(rm-case (rm-str "foo bar" "\\(o+\\) \\(b\\)" "Z" t nil 2))
(rm-case (rm-str "foo bar" "\\(o+\\) \\(b\\)" "Z" t nil 5))
(rm-case (rm-str "foo bar" "o" "\\\\" t))
(rm-case (with-temp-buffer (insert "abc def") (goto-char 1) (re-search-forward "b") (replace-match "XYZ") (list (buffer-string) (point))))
(rm-case (with-temp-buffer (insert "abc def") (goto-char 1) (re-search-forward "\\(b\\)\\(c\\)") (replace-match "-" t t nil 1) (list (buffer-string) (point))))
(rm-case (with-temp-buffer (insert "abc def") (goto-char 1) (search-forward "def") (replace-match "g" t t) (list (buffer-string) (point))))
(rm-case (with-temp-buffer (insert "abc") (goto-char 1) (looking-at "ab") (replace-match "") (list (buffer-string) (point))))
(rm-case (with-temp-buffer (insert "abc") (replace-match "x")))
(rm-case (replace-match 3))
(rm-case (replace-match "x" nil nil 4))
(rm-case (progn (string-match "a" "a") (replace-match "x" t t "a" -1)))
(rm-case (let (m) (with-temp-buffer (insert "abcabc") (setq m (copy-marker 4)) (goto-char 1) (re-search-forward "c") (replace-match "XXXX" t t) (list (buffer-string) (marker-position m)))))
(rm-case (with-temp-buffer (insert "ab\ncd") (goto-char 1) (re-search-forward "^\\(.\\)\\(.\\)$") (replace-match "\\2\\1") (buffer-string)))
(rm-case (with-temp-buffer (insert "foo") (goto-char 1) (re-search-forward "\\(f\\)\\(o\\)\\(o\\)") (list (match-data t) (progn (replace-match "q" t t) (match-data t)))))
