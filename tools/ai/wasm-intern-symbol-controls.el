;;; wasm-intern-symbol-controls.el --- Executed negative controls -*- lexical-binding: t; -*-
(defvar wasm-intern-symbol--library-only t)
(require 'wasm-intern-symbol-probe)
(defun wasm-intern-symbol-control-node (label module manifest expected &optional red)
  (with-temp-buffer
    (let ((rc (apply #'call-process "bash" nil t nil "-c" "ulimit -v 8388608; exec \"$@\"" "node"
                     "timeout" "600" "node" "--disable-wasm-trap-handler"
                     "tools/ai/wasm-intern-symbol-check.mjs" module manifest (when red '("--red")))))
      (write-region (point-min) (point-max) (concat wasm-intern-symbol-directory label ".log") nil 'silent)
      (unless (and (equal rc 1) (string-match-p expected (buffer-string)))
        (error "Control %s rc=%s missing %s: %s" label rc expected (buffer-string)))
      (let ((message (progn (goto-char (point-min))
                           (unless (re-search-forward "^intern-symbol-check:.*$" nil t)
                             (error "Missing control diagnostic")) (match-string 0))))
        (princ (format "control=%s rc=%s message=%s\n" label rc message)))
      rc)))
(defun wasm-intern-symbol-canonical-controls (context manifest)
  "Mutate genuine predicates; require ordinary near misses to expose each edit."
  (dolist (spec '((nil-length nl_name_is_nil (= n 3) (>= n 3) "nilx")
                  (t-length nl_name_is_t (= n 1) (>= n 1) "tx")
                  (nil-byte nl_name_is_nil
                            (= (ptr-read-u8 p 2) 108)
                            (>= (ptr-read-u8 p 2) 108) "nix")))
    (let* ((source (copy-tree (wasm-intern-symbol-source context)))
           (form (cl-find (nth 1 spec) (cdr source) :key #'cadr))
           (anchor (nth 2 spec))
           (matches (wasm-rootstack--forms form (lambda (part) (equal part anchor))))
           (path (format "%s%s-mutation.wasm" wasm-intern-symbol-directory (car spec)))
           (edited (copy-tree manifest)))
      (unless (= (length matches) 1) (error "Canonical mutation anchor %s" (car spec)))
      (setcar (cl-member (nth 1 spec) (cdr source) :key #'cadr)
              (cl-subst (nth 3 spec) anchor form :test #'equal))
      (wasm-intern-symbol-write (concat path ".source.eld") source)
      (wasm-intern-symbol-compile-file (concat path ".source.eld") path t)
      (setf (alist-get 'wasm_sha256 edited) (wasm-rootstack--hash path)
            (alist-get 'compiled_source edited)
            `((path . ,(concat path ".source.eld"))
              (sha256 . ,(wasm-rootstack--hash (concat path ".source.eld")))))
      (wasm-intern-symbol-json (concat path ".json") edited)
      (wasm-intern-symbol-control-node
       (symbol-name (car spec)) path (concat path ".json")
       (regexp-quote (format "symbol %S repeat=false: whole memory mismatch" (nth 4 spec)))))))
(defun wasm-intern-symbol-controls ()
  (let* ((context (wasm-intern-symbol-context))
         (green "target/wasm-intern-symbol/green.wasm")
         (manifest (json-read-file (concat green ".json"))))
    (wasm-intern-symbol-control-node "adapter-removed" "target/wasm-intern-symbol/red.wasm"
                                    "target/wasm-intern-symbol/red.wasm.json"
                                    "expected red: no intern region" t)
    (copy-file "target/wasm-intern-symbol/adapter-removed.log" "target/wasm-intern-symbol/red.log" t)
    (with-temp-file "target/wasm-intern-symbol/red.rc" (insert "1\n"))
    (dolist (pair '((832 . 840) (67108864 . 33554432)))
      (let* ((source (copy-tree (wasm-intern-symbol-source context)))
             (cell (cl-member 'nl_wasm_intern_region_init (cdr source) :key #'cadr))
             (label (if (= (car pair) 832) "adapter-offset" "adapter-constant"))
             (path (concat wasm-intern-symbol-directory label ".eld")))
        (setcar cell (cl-subst (cdr pair) (car pair) (car cell)))
        (wasm-intern-symbol-write path source)
        (let ((diagnostic (condition-case err
                              (progn (wasm-intern-symbol-validate path (plist-get context :contract)
                                      (plist-get context :owners) (plist-get context :closure)
                                      (plist-get context :record)) nil)
                            (error (prin1-to-string err)))))
          (unless (and diagnostic (string-match-p "Intern schema: unexpected definition nl_wasm_intern_region_init" diagnostic))
            (error "Adapter control escaped %s" diagnostic))
          (princ (format "control=%s build-red=%s\n" label diagnostic)))))
    (let* ((source (copy-tree (wasm-intern-symbol-source context)))
           (adapter (cl-find 'nl_wasm_intern_region_init (cdr source) :key #'cadr))
           (path (concat wasm-intern-symbol-directory "third-raw.eld")))
      (setcar (nthcdr 3 adapter) `(seq ,(nth 3 adapter) (alloc-bytes 8 8)))
      (wasm-intern-symbol-write path source)
      (let ((diagnostic (condition-case err
                            (progn (wasm-intern-symbol-compile-file path (concat path ".wasm") t) nil)
                          (error (prin1-to-string err)))))
        (unless (and diagnostic (string-match-p "wasm-genuine-alloc-raw-reservation nl_wasm_intern_region_init 2" diagnostic))
          (error "Third raw site escaped %s" diagnostic))
        (princ (format "control=third-raw compile-red=%s\n" diagnostic))))
    ;; A real compiled hash mutation reaches the runtime checker. All artifact
    ;; digests are refreshed, leaving the native oracle as the independent judge.
    (let* ((source (copy-tree (wasm-intern-symbol-source context)))
           (cell (cl-member 'nl_intern_hash (cdr source) :key #'cadr))
           (path (concat wasm-intern-symbol-directory "consumer-mutation.wasm"))
           (edited (copy-tree manifest)))
      (setcar cell (cl-subst 16777621 16777619 (car cell)))
      (wasm-intern-symbol-write (concat path ".source.eld") source)
      (wasm-intern-symbol-compile-file (concat path ".source.eld") path t)
      (setf (alist-get 'wasm_sha256 edited) (wasm-rootstack--hash path)
            (alist-get 'compiled_source edited)
            `((path . ,(concat path ".source.eld")) (sha256 . ,(wasm-rootstack--hash (concat path ".source.eld")))))
      (wasm-intern-symbol-json (concat path ".json") edited)
      (wasm-intern-symbol-control-node "consumer-body" path (concat path ".json") "whole memory mismatch"))
    ;; Reproduce both accepted audit mutants, without a provenance-only red.
    (dolist (kind '(slotmatch adapter-return))
      (let* ((source (copy-tree (wasm-intern-symbol-source context)))
             (name (if (eq kind 'slotmatch) 'nl_intern_slotmatch 'nl_wasm_intern_region_init))
             (form (cl-find name (cdr source) :key #'cadr))
             (path (format "%s%s-mutation.wasm" wasm-intern-symbol-directory kind))
             (edited (copy-tree manifest)))
        (if (eq kind 'slotmatch)
            (progn
              (unless (eq (car (nth 1 (nth 3 form))) '=) (error "Slotmatch mutation anchor"))
              (setcar (nth 1 (nth 3 form)) '>=))
          (let* ((tail (nth 3 (nth 2 (nth 3 form))))
                 (last (last tail)))
            (unless (eq (car-safe (car last)) 'ptr-write-u64) (error "Return mutation anchor"))
            (setcar last `(seq ,(car last) 0))))
        (wasm-intern-symbol-write (concat path ".source.eld") source)
        (wasm-intern-symbol-compile-file (concat path ".source.eld") path t)
        (setf (alist-get 'wasm_sha256 edited) (wasm-rootstack--hash path)
              (alist-get 'compiled_source edited)
              `((path . ,(concat path ".source.eld"))
                (sha256 . ,(wasm-rootstack--hash (concat path ".source.eld")))))
        (wasm-intern-symbol-json (concat path ".json") edited)
        (wasm-intern-symbol-control-node
         (symbol-name kind) path (concat path ".json")
         (if (eq kind 'slotmatch) "symbol \"x\" repeat=false: whole memory mismatch"
           "adapter successful native init return"))))
    (wasm-intern-symbol-canonical-controls context manifest)
    (dolist (field '(raw_reservers region adapter consumers oracle_cases limit))
      (let* ((edited (copy-tree manifest))
             (path (format "%smanifest-%s.json" wasm-intern-symbol-directory field)))
        (setf (alist-get field edited) (if (eq field 'consumers) [] "edited"))
        (wasm-intern-symbol-json path edited)
        (wasm-intern-symbol-control-node
         (format "manifest-%s" field) green path
         (regexp-quote
          (pcase field
            ('raw_reservers "two raw W0 reservers")
            ('region "region export cross-checks")
            ('oracle_cases "native case cross-check")
            (_ (format "Intern manifest contract mismatch: (%s)" field)))))))
    (princ "GATE-COUNT checked=16 findings=0\n")))
(provide 'wasm-intern-symbol-controls)
