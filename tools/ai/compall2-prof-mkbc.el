;;; compall2-prof-mkbc.el --- GNU side: byte-compile compall2-prof-wrap.el for NeLisp  -*- lexical-binding: t; -*-
;; usage: emacs -Q --batch -l tools/ai/compall2-prof-mkbc.el OUT.el
;; Writes (fset 'compall2-prof--wrapper #[...]) as tools/ai/compall2-prof.el loads it.
(setq byte-compile-warnings nil)
(load (expand-file-name "compall2-prof-wrap.el" (file-name-directory load-file-name)) nil t)
(byte-compile 'compall2-prof--wrapper)
(unless (byte-code-function-p (symbol-function 'compall2-prof--wrapper)) (error "not compiled"))
(with-temp-buffer
  (let ((print-escape-newlines t) (print-escape-control-characters t)
        (print-length nil) (print-level nil) (print-circle nil))
    (insert ";;; -*- lexical-binding: t; -*-\n;; GENERATED by tools/ai/compall2-prof-mkbc.el from compall2-prof-wrap.el\n")
    (insert "(fset 'compall2-prof--wrapper ")
    (prin1 (symbol-function 'compall2-prof--wrapper) (current-buffer))
    (insert ")\n"))
  (write-region (point-min) (point-max) (car command-line-args-left) nil 'silent))
(setq command-line-args-left nil)
