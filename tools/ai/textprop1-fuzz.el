;;; textprop1-fuzz.el --- differential random-operation fuzz for text properties  -*- lexical-binding: t; -*-
;; Deterministic (own LCG) so GNU Emacs and NeLisp run the same operations; compare the outputs.
(defvar tf-seed (let ((s (getenv "TF_SEED"))) (if s (string-to-number s) 1)))
(defun tf-rand (n) (setq tf-seed (% (+ (* tf-seed 48271) 11) 2147483647)) (% (/ tf-seed 7) n))
(defun tf-keys () (nth (tf-rand 3) '(a b c)))
(defun tf-plist ()
  ;; distinct keys: a plist with a repeated key is a degenerate input
  (let ((n (1+ (tf-rand 2))) l)
    (dotimes (_ n)
      (let ((k (tf-keys)))
        (unless (memq k l) (setq l (append l (list k (tf-rand 3)))))))
    l))
(defun tf-str-run (steps)
  (let ((s (copy-sequence "abcdefghijklmnopqrstuvwxyz0123456789")) (log nil))
    (dotimes (i steps)
      (let* ((n (length s)) (a (tf-rand (1+ n))) (b (tf-rand (1+ n))) (op (tf-rand 9)))
        (cond ((= op 0) (put-text-property a b (tf-keys) (tf-rand 3) s))
              ((= op 1) (push (add-text-properties a b (tf-plist) s) log))
              ((= op 2) (push (set-text-properties a b (if (= 0 (tf-rand 3)) nil (tf-plist)) s) log))
              ((= op 3) (push (remove-text-properties a b (list (tf-keys) nil) s) log))
              ((= op 4) (push (remove-list-of-text-properties a b (list (tf-keys) (tf-keys)) s) log))
              ((= op 5) (setq s (substring s (min a b) (max a b))) (when (< (length s) 4) (setq s (concat s s s s))))
              ((= op 6) (setq s (concat (substring s 0 (min a n)) (substring s 0 (min b n)))) (when (< (length s) 4) (setq s (concat s s s s))))
              ((= op 7) (push (list (next-property-change a s) (previous-property-change b s)
                                    (next-single-property-change a (tf-keys) s b) (previous-single-property-change b (tf-keys) s a)
                                    (text-property-any (min a b) (max a b) (tf-keys) (tf-rand 3) s)
                                    (text-property-not-all (min a b) (max a b) (tf-keys) (tf-rand 3) s)
                                    (get-text-property (min a (1- n)) (tf-keys) s)) log))
              (t (setq s (copy-sequence s)))))
      (when (getenv "TF_TRACE") (princ (format "%d %S\n" i s)))
      (when (= 0 (% i 5)) (push (format "%S" s) log)))
    (list (format "%S" s) (nreverse log))))
(defun tf-buf-run (steps)
  (with-temp-buffer
    (insert "abcdefghijklmnopqrstuvwxyz")
    (let ((log nil))
      (dotimes (i steps)
        (let* ((n (buffer-size)) (a (1+ (tf-rand (1+ n)))) (b (1+ (tf-rand (1+ n)))) (op (tf-rand 11)))
          (cond ((= op 0) (put-text-property (min a b) (max a b) (tf-keys) (tf-rand 3)))
                ((= op 1) (push (add-text-properties (min a b) (max a b) (tf-plist)) log))
                ((= op 2) (push (set-text-properties (min a b) (max a b) (if (= 0 (tf-rand 3)) nil (tf-plist))) log))
                ((= op 3) (push (remove-text-properties (min a b) (max a b) (list (tf-keys) nil)) log))
                ((= op 4) (goto-char a) (insert "XY"))
                ((= op 5) (goto-char a) (insert-and-inherit "ZW"))
                ((= op 6) (goto-char a) (insert (propertize "PQ" (tf-keys) (tf-rand 3) 'k 1)))
                ((= op 7) (when (> n 5) (delete-region (min a b) (min (max a b) (+ (min a b) 6)))))
                ((= op 8) (goto-char a) (insert-and-inherit (propertize "RS" (tf-keys) (tf-rand 3))))
                ((= op 9) (push (list (next-property-change a) (previous-property-change b)
                                      (next-single-property-change a (tf-keys) nil b)
                                      (text-property-any (min a b) (max a b) (tf-keys) (tf-rand 3)))
                                log))
                (t (when (< n 80) (goto-char a) (insert-and-inherit "u")))))
        (when (= 0 (% i 4)) (push (format "%S" (buffer-string)) log)))
      (list (format "%S" (buffer-string)) (format "%S" (buffer-substring 3 (min 20 (point-max)))) (nreverse log)))))
(let ((runs (let ((s (getenv "TF_RUNS"))) (if s (string-to-number s) 40))))
  (dotimes (r runs)
    (princ (format "S%d %S\n" r (condition-case e (tf-str-run 40) (error (list 'ERR e)))))
    (princ (format "B%d %S\n" r (condition-case e (tf-buf-run 40) (error (list 'ERR e)))))))
