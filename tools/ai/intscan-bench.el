;; Cost of scanning alloc-bytes blocks that are kept alive only through Lisp
;; integers (tools/ai/evidence/int-pin-scan-experiment-20261103.patch).
;; Run through tools/ai/intscan-bench.sh on the base and the patched binary.
;; Each case prints one line; GC times are the minimum of 3 collections in ms.
(defvar ib-hold nil)
(defun ib-gc-ms ()
  (let ((best nil) (k 0))
    (while (< k 3)
      (let ((t0 (float-time)))
        (garbage-collect)
        (let ((ms (* 1000 (- (float-time) t0))))
          (if (or (null best) (< ms best)) (setq best ms))))
      (setq k (1+ k)))
    best))
(defun ib-churn ()
  (let ((i 0) (keep nil))
    (while (< i 20000)
      (let ((b (alloc-bytes 32 8))) (ptr-write-u64 b 0 99) (setq keep (cons b keep)))
      (setq i (1+ i)))
    (length keep)))
(defun ib-buffers (n size fill)
  ;; N buffers of SIZE bytes held only as integers in `ib-hold'.  FILL is
  ;; zero, text or addr (each word the address of one live 32-byte block).
  (let ((i 0) (shared (alloc-bytes 32 8)))
    (setq ib-hold (cons shared ib-hold))
    (while (< i n)
      (let ((b (alloc-bytes size 8)) (p 0))
        (while (< p size)
          (ptr-write-u64 b p (cond ((eq fill 'text) 7016996765293437281)
                                   ((eq fill 'addr) shared)
                                   (t 0)))
          (setq p (+ p 8)))
        (setq ib-hold (cons b ib-hold)))
      (setq i (1+ i)))))
(defun ib-case (name thunk)
  (setq ib-hold nil)
  (garbage-collect)
  (funcall thunk)
  (princ (format "case=%s gc-ms=%.1f\n" name (ib-gc-ms)))
  (setq ib-hold nil))
(ib-case "empty" (lambda () nil))
(ib-case "10k-x-400B-zero" (lambda () (ib-buffers 10000 400 'zero)))
(ib-case "10k-x-400B-addr" (lambda () (ib-buffers 10000 400 'addr)))
(ib-case "1-x-16MiB-text" (lambda () (ib-buffers 1 (* 16 1048576) 'text)))
(ib-case "64-x-64KiB-text" (lambda () (ib-buffers 64 65536 'text)))
;; Stale retention: an int-held 8000-byte buffer still holds the addresses
;; of 1000 blocks nothing else references (a reused I/O buffer).  Count how
;; many blocks are still intact after GC and churn.
(let ((m 4242) (buf (alloc-bytes 8000 8)) (k 0))
  (setq ib-hold (list buf))
  (while (< k 1000)
    (let ((b (alloc-bytes 32 8))) (ptr-write-u64 b 0 m) (ptr-write-u64 buf (* 8 k) b))
    (setq k (1+ k)))
  (setq buf nil)
  (garbage-collect) (ib-churn)
  (let ((c (car ib-hold)) (k 0) (kept 0))
    (while (< k 1000)
      (if (= (ptr-read-u64 (ptr-read-u64 c (* 8 k)) 0) m) (setq kept (1+ kept)))
      (setq k (1+ k)))
    (princ (format "case=stale-1000 kept=%d/1000\n" kept))))
(princ "done\n")
