(defun os--live () (garbage-collect) (garbage-collect) (nth 4 (nelisp--arena-stats)))
(defvar os--keep nil)
(defmacro os--measure (label n form)
  `(let ((a (os--live)))
     (setq os--keep ,form)
     (let ((b (os--live)))
       (princ (format "%-22s %8.1f bytes/each\n" ,label (/ (float (- b a)) ,n)))
       (setq os--keep nil))))
(nelisp--debug-switch 28)
(os--measure "cons (make-list)" 100000 (make-list 100000 nil))
(os--measure "float" 100000 (let (l) (dotimes (i 100000) (push (+ 0.5 i) l)) l))
(os--measure "  (minus its cons)" 1 0)
(os--measure "vector slot (1e5)" 100000 (make-vector 100000 nil))
(os--measure "string 8 chars" 10000 (let (l) (dotimes (i 10000) (push (format "%08d" i) l)) l))
(os--measure "symbol (make-symbol)" 10000 (let (l) (dotimes (i 10000) (push (make-symbol "s") l)) l))
(nelisp--debug-switch 29)
