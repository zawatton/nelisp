;; Problem A structure: no global plist table; the plist lives in the symbol.
(if (boundp 'nelisp-stdlib--symbol-plists) (princ "FAIL table still bound\n") (princ "OK no global table\n"))
(let ((a (make-symbol "x")) (b (make-symbol "x")) (pl (list 'p 1)))
  (setplist a pl)
  (if (and (eq (symbol-plist a) pl) (null (symbol-plist b)) (eq (get a 'p) 1)) (princ "OK uninterned slot\n") (princ "FAIL uninterned slot\n")))
(progn (put 'rp-slot 'k 1) (put 'rp-slot 'j 2)
  (if (equal (symbol-plist 'rp-slot) '(k 1 j 2)) (princ "OK interned slot\n") (princ "FAIL interned slot\n")))
;; image round-trip: plists written while the cold image was built are in the loaded image
(if (and (memq 'error (get 'file-error 'error-conditions)) (stringp (get 'wrong-type-argument 'error-message))
         (memq 'wrong-type-argument (get 'wrong-type-argument 'error-conditions)))
    (princ "OK image plists\n")
  (princ "FAIL image plists\n"))
;; plists survive collections: 3000 uninterned symbols, interned ones, plists replaced and dropped
(let ((syms nil) (bad 0) (keep (intern "rp-gc-keep")))
  (dotimes (i 3000) (let ((s (make-symbol (format "g%d" i)))) (put s 'a (list i (format "v%d" i))) (put s 'b i) (push s syms)))
  (dotimes (i 200) (put keep (intern (format "rp-gc-k%d" i)) (make-string 20 ?x)))
  (garbage-collect)
  (dotimes (i 3000) (let ((s (nth (- 2999 i) syms))) (unless (and (equal (get s 'a) (list i (format "v%d" i))) (eq (get s 'b) i)) (setq bad (1+ bad)))))
  (setq syms nil)
  (garbage-collect)
  (dotimes (i 200) (unless (equal (get keep (intern (format "rp-gc-k%d" i))) (make-string 20 ?x)) (setq bad (1+ bad))))
  (if (= bad 0) (princ "OK plists survive gc\n") (princ (format "FAIL gc bad=%d\n" bad))))
;; error-conditions and char-table-extra-slots reach the bytecode `get' through the slot
(progn (put 'rp-cond 'error-conditions '(rp-cond error)) (put 'rp-cond 'error-message "rp")
  (if (and (eq (condition-case e (signal 'rp-cond nil) (rp-cond 'caught)) 'caught)
           (eq (condition-case e (funcall (lambda () (condition-case e2 (signal 'rp-cond nil) (error 'caught-error)))) (error 'x)) 'caught-error))
      (princ "OK condition lookup\n") (princ "FAIL condition lookup\n")))
(if (eq (get nil 'rp-nilp) nil) (progn (put nil 'rp-nilp 1) (put t 'rp-tp 2)
    (if (and (eq (get nil 'rp-nilp) 1) (eq (get t 'rp-tp) 2) (equal (symbol-plist nil) '(rp-nilp 1))) (princ "OK nil and t plists\n") (princ "FAIL nil and t plists\n")))
  (princ "FAIL nil plist not empty\n"))
