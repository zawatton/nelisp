;;; gc-port-bignum-probe2.el --- more bignum behaviour probes: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l FILE (GNU) and NELISP --load FILE.  One "NAME => RESULT" line per case.
;; Companion of gc-port-bignum-probe.el: the builtins that take an integer and the signal paths.
;; The Bignum representation steps (Doc 216 S5) must leave every NeLisp line unchanged.
(require 'cl-lib)
(require 'seq)
(defmacro pb (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

(defvar pb--big (ash 1 100))
(defvar pb--neg (- (ash 1 70)))
;; bitwise and shifts, every operand mix
(pb "logand-3" (logand pb--big (1- pb--big) -1))
(pb "logior-3" (logior (ash 1 90) (ash 1 80) 7))
(pb "logxor-3" (logxor pb--big pb--neg 255))
(pb "logand-fix" (logand pb--big 255))
(pb "logand-fix-neg" (logand pb--neg 4095))
(pb "logior-neg" (logior pb--neg (ash 1 100)))
(pb "logxor-self" (logxor pb--neg pb--neg))
(pb "logand-mask" (logand (1- (ash 1 100)) (ash 1 99)))
(pb "logior-fold" (apply #'logior (list (ash 1 70) (ash 1 71) (ash 1 72) 1)))
(pb "logand-fold" (apply #'logand (list (1- (ash 1 70)) (1- (ash 1 71)) (1- (ash 1 72)))))
(pb "logxor-fold" (apply #'logxor (list (ash 1 70) (ash 1 70) (ash 1 71))))
(pb "lognot-neg" (lognot pb--neg))
(pb "lognot-fix" (lognot most-positive-fixnum))
(pb "lsh" (list (lsh 1 70) (lsh pb--big -10)))
(pb "ash-big-count" (ash 1 (ash 1 70)))
(pb "ash-zero" (ash pb--big 0))
(pb "ash-neg-all" (ash pb--neg -200))
(pb "logcount" (list (logcount pb--big) (logcount (1- pb--big)) (logcount pb--neg)))
(pb "logb" (list (logb pb--big) (logb pb--neg)))
(pb "integer-length" (list (cl-integer-length pb--big)))
;; division family with small divisors
(pb "floor-2" (list (floor pb--big 7) (floor pb--neg 7)))
(pb "ceiling-2" (list (ceiling pb--big 7) (ceiling pb--neg 7)))
(pb "truncate-2" (list (truncate pb--big 7) (truncate pb--neg 7)))
(pb "round-2" (list (round pb--big 7) (round pb--neg 7)))
(pb "mod-%" (list (mod pb--big 7) (mod pb--neg 7) (% pb--big 7) (% pb--neg 7)))
(pb "div-1" (list (/ pb--big 1) (/ pb--big -1) (/ pb--neg 2)))
(pb "div-big-divisor" (/ 7 pb--big))
(pb "mod-big-divisor" (mod 7 pb--big))
(pb "div-zero" (/ pb--big 0))
(pb "div-float" (list (/ pb--big 2.0) (/ 2.0 pb--big)))
;; number predicates and conversion
(pb "sign-predicates" (list (cl-plusp pb--big) (cl-minusp pb--neg) (cl-plusp pb--neg) (zerop pb--neg) (cl-oddp pb--neg)))
(pb "number-eq" (list (= pb--big pb--big) (= pb--big pb--neg) (/= pb--big 1) (= pb--big 1.0) (= pb--big (float pb--big))))
(pb "compare-float" (list (< pb--big 1e40) (> pb--big 1e20) (< 1e30 pb--big) (= (ash 1 62) 4.611686018427388e18)))
(pb "max-min-mixed" (list (max 1.0 pb--big) (min 1.0 pb--big) (max pb--big pb--neg) (min pb--big pb--neg)))
(pb "abs-neg-fix" (list (abs most-negative-fixnum) (abs (1- most-negative-fixnum))))
(pb "1+-chain" (let ((x most-positive-fixnum)) (dotimes (_ 5) (setq x (1+ x))) x))
(pb "negate-fix" (list (- most-negative-fixnum) (- (- most-negative-fixnum))))
(pb "sum-fold" (apply #'+ (list pb--big pb--big pb--neg 1)))
(pb "prod-fold" (apply #'* (list pb--big 2 3 pb--neg)))
(pb "diff-fold" (apply #'- (list pb--big 1 2 3)))
(pb "mapcar-1+" (mapcar #'1+ (list pb--big pb--neg 0)))
(pb "reduce" (cl-reduce #'+ (list pb--big pb--neg pb--big)))
(pb "number-seq" (number-sequence pb--big (+ pb--big 2)))
(pb "dotimes-big-acc" (let ((s 0)) (dotimes (i 50) (setq s (+ s (* (1+ i) pb--big)))) s))
(pb "fact-30" (let ((f 1)) (dotimes (i 30) (setq f (* f (1+ i)))) f))
(pb "fib-120" (let ((a 0) (b 1)) (dotimes (_ 120) (setq b (+ a b) a (- b a))) a))
(pb "to-string-roundtrip" (equal pb--big (string-to-number (number-to-string pb--big))))
(pb "format-width" (list (format "%40d" pb--big) (format "%-40d|" pb--big) (format "%+d" pb--big) (format "% d" pb--big)))
(pb "format-hex-flags" (list (format "%#x" pb--big) (format "%#o" pb--big) (format "%X" pb--neg)))
(pb "format-float-of" (list (format "%f" (float pb--big)) (format "%.3e" pb--big) (format "%g" pb--big)))
(pb "type-of" (list (type-of pb--big) (cl-typep pb--big 'integer) (cl-typep pb--big 'fixnum) (cl-typep pb--big 'bignum) (integerp pb--big)))
(pb "string-to-number-edge" (list (string-to-number "2305843009213693951") (string-to-number "2305843009213693952") (string-to-number "-2305843009213693953")))
(pb "read-edge" (read "(2305843009213693951 2305843009213693952 -2305843009213693952 -2305843009213693953)"))
(pb "sxhash" (list (= (sxhash-eql pb--big) (sxhash-eql (ash 1 100))) (= (sxhash-equal pb--big) (sxhash-equal (ash 1 100))) (/= (sxhash-eql pb--big) (sxhash-eql pb--neg))))
;; signals carry the offending value
(pb "err-plus-sym" (+ pb--big 'a))
(pb "err-plus-str" (+ pb--big "s"))
(pb "err-sym-plus" (+ 'a pb--big))
(pb "err-logand-sym" (logand pb--big 'x))
(pb "err-make-vector" (make-vector pb--big 0))
(pb "err-make-string" (make-string pb--big ?a))
(pb "err-nth" (list (nth pb--big '(1 2)) (nthcdr pb--big '(1 2)) (nth pb--neg '(1 2))))
(pb "err-aref" (aref [1 2] pb--big))
(pb "err-elt" (elt '(1 2) pb--big))
(pb "err-substring" (substring "abc" pb--big))
(pb "err-char" (char-to-string pb--big))
(pb "err-string" (string pb--big))
(pb "err-symbol-name" (symbol-name pb--big))
(pb "err-car" (car pb--big))
(pb "err-funcall" (funcall pb--big))
(pb "err-length" (length pb--big))
(pb "err-signal-data" (condition-case e (signal 'wrong-type-argument (list 'integerp pb--big)) (error (eq (cadr (cdr e)) pb--big))))
(pb "error-message" (condition-case e (error "big %d" pb--big) (error (error-message-string e))))
(pb "throw-catch" (catch 'k (throw 'k pb--big)))
(pb "unwind" (let ((r nil)) (unwind-protect (setq r pb--big) (setq r (list r))) r))
(pb "let-dynamic" (progn (defvar pb--dyn2 nil) (list (let ((pb--dyn2 pb--big)) pb--dyn2) pb--dyn2)))
(pb "funcall-arg" (funcall (lambda (x y) (list x (eq x y))) pb--big pb--big))
(pb "apply-opt" (funcall (lambda (&optional a &rest r) (list a r)) pb--big pb--neg pb--big))
(pb "closure-state" (let* ((n pb--big) (f (lambda () (setq n (1+ n))))) (funcall f) (funcall f) n))
(pb "pcase" (pcase pb--big ((pred bignump) 'big) (_ 'other)))
(pb "cl-case" (cl-case 5 (5 pb--big) (t nil)))
(pb "while-acc" (let ((i 0) (acc 1)) (while (< i 70) (setq acc (* acc 2) i (1+ i))) acc))
(pb "string-join" (mapconcat #'number-to-string (list pb--big pb--neg 1) ","))
(pb "concat-num" (concat "n=" (number-to-string pb--big)))
(pb "message-fmt" (format-message "%d and %s" pb--big pb--neg))
(pb "prin1-nested" (prin1-to-string (list (vector pb--big) (cons pb--neg pb--big) "s")))
(pb "equal-vector" (list (equal (vector pb--big) (vector (ash 1 100))) (equal (list pb--big) (list pb--neg))))
(pb "copy-keeps" (let* ((x (ash 1 100)) (l (copy-sequence (list x 1)))) (eq (car l) x)))
(pb "append-keeps" (let* ((x (ash 1 100)) (l (append (list x) (list x)))) (eq (car l) (cadr l))))
(pb "reverse-keeps" (let* ((x (ash 1 100)) (l (reverse (list 1 x)))) (eq (car l) x)))
(pb "mapcar-keeps" (let* ((x (ash 1 100)) (l (mapcar #'identity (list x x)))) (list (eq (car l) x) (eq (cadr l) x))))
(pb "sort-stable" (let* ((x (ash 1 100)) (l (sort (list x 1 x) #'<))) (list (eq (nth 1 l) x) (length l))))
(pb "vconcat-keeps" (let* ((x (ash 1 100)) (v (vconcat (list x) (vector x)))) (eq (aref v 0) (aref v 1))))
(pb "record-slot" (let* ((x (ash 1 100)) (r (record 'foo x 2))) (list (eq (aref r 1) x) (aref r 2))))
(pb "setf-forms" (let* ((x (ash 1 100)) (l (list 1 2)) (v (vector 1 2))) (setf (car l) x (aref v 1) x) (list (eq (car l) x) (eq (aref v 1) x))))
(pb "push-pop" (let* ((x (ash 1 100)) (l nil)) (push x l) (push x l) (eq (pop l) (pop l))))
(pb "hash-keys-values" (let ((h (make-hash-table :test 'eql)) (r nil)) (puthash (ash 1 100) (ash 1 101) h) (maphash (lambda (k v) (push (list k v) r)) h) r))
(pb "hash-eq-computed" (let ((h (make-hash-table :test 'eq))) (puthash (ash 1 100) 'a h) (gethash (ash 1 100) h)))
(pb "assq-computed" (assq (ash 1 100) (list (cons (ash 1 100) 'x))))
(pb "assoc-computed" (assoc (ash 1 100) (list (cons (ash 1 100) 'x))))
(pb "member-computed" (member (ash 1 100) (list 1 (ash 1 100))))
(pb "memql-computed" (memql (ash 1 100) (list 1 (ash 1 100))))
(pb "rassoc-computed" (rassoc (ash 1 100) (list (cons 'a (ash 1 100)))))
(pb "delete-computed" (delete (ash 1 100) (list 1 (ash 1 100) 2)))
(pb "remove-computed" (remove (ash 1 100) (list 1 (ash 1 100) 2)))
(pb "cl-position" (cl-position (ash 1 100) (list 1 (ash 1 100))))
(pb "seq-contains" (seq-contains-p (list 1 (ash 1 100)) (ash 1 100)))
(pb "gc-many" (let ((l nil)) (dotimes (i 3000) (push (+ pb--big i) l)) (garbage-collect) (let ((s 0)) (dolist (x l) (setq s (+ s x))) (list (length l) s))))
(pb "gc-mixed-containers" (let ((v (make-vector 100 nil)) (h (make-hash-table :test 'eql)) (l nil)) (dotimes (i 100) (aset v i (* (1+ i) pb--big)) (puthash i (* (1+ i) pb--neg) h) (push (cons i (* (1+ i) pb--big)) l)) (garbage-collect) (garbage-collect) (list (aref v 99) (gethash 99 h) (cdr (assq 99 l)))))
(pb "gc-closures-state" (let ((fs nil)) (dotimes (i 40) (let ((n (+ pb--big i))) (push (lambda () (setq n (1+ n))) fs))) (garbage-collect) (let ((s 0)) (dolist (f fs) (funcall f) (setq s (+ s (funcall f)))) s)))
(pb "gc-bignum-garbage" (let ((s 0)) (dotimes (i 20000) (setq s (+ s (logand (* (+ pb--big i) 3) 255)))) (garbage-collect) s))
(pb "bytecomp-ops" (funcall (byte-compile (lambda (a b) (list (logand a b) (logior a b) (logxor a b) (ash a -3) (- a) (abs b) (1+ a) (max a b) (= a b)))) pb--big pb--neg))
(pb "bytecomp-loop" (funcall (byte-compile (lambda (n) (let ((acc 1)) (dotimes (i n) (setq acc (* acc 3))) acc))) 50))
(princ "PB2-DONE\n")
