;;; eqhash-perf.el --- isolated primitive own-cost probe -*- lexical-binding: t; -*-
;; Callgrind starts after setup; loop totals include natural and final GC.
;; Gets subtract eq's two-argument call. Puts subtract a fixed three-argument
;; tagged-slot store using the SAME (char-table-key 0 hash-table) arguments.
(defvar eqh-kind (getenv "EQHASH_KIND"))
(defvar eqh-n (string-to-number (getenv "EQHASH_N")))
(defvar eqh-calls (string-to-number (getenv "EQHASH_CALLS")))
(defvar eqh-op (getenv "EQHASH_OP"))
(defvar eqh-control (equal (getenv "EQHASH_CONTROL") "1"))
(defvar eqh-wall (equal (getenv "EQHASH_WALL") "1"))
(defvar eqh-gc-stats (and (getenv "GC_STATS_ADDR")
                         (string-to-number (getenv "GC_STATS_ADDR"))))
(defun eqh-gc-count ()
  (if eqh-gc-stats (ptr-read-u64 eqh-gc-stats 24) gcs-done))
(put 'eqhash-key 'char-table-extra-slots 1)
(defvar eqh-table (make-hash-table :test (intern (getenv "EQHASH_TEST"))
                                :weakness (if (equal (getenv "EQHASH_WEAK") "key") 'key nil)))
(defvar eqh-keep (make-vector (+ eqh-n eqh-calls 1) nil))
(defmacro eqh-object (i)
  (cond ((equal eqh-kind "string") `(format "eqhash-%d" ,i))
        ((equal eqh-kind "cons") `(cons ,i nil))
        ((equal eqh-kind "symbol") '(make-symbol "eqhash-key"))
        ((equal eqh-kind "vector") `(vector ,i))
        ((equal eqh-kind "float") `(+ 0.25 ,i))
        ((equal eqh-kind "bignum") `(+ 2305843009213693952 ,i))
        ((equal eqh-kind "marker") '(make-marker))
        ((equal eqh-kind "chartable") '(make-char-table 'eqhash-key nil))
        (t (error "unknown key kind %s" eqh-kind))))
(dotimes (eqh-i (length eqh-keep))
  (aset eqh-keep eqh-i (eqh-object eqh-i)))
(dotimes (eqh-i eqh-n)
  (puthash (aref eqh-keep eqh-i) 1 eqh-table))
(unless (and (= (hash-table-count eqh-table) eqh-n)
             (null (gethash (aref eqh-keep eqh-n) eqh-table)))
  (error "population count or distinct miss key invalid"))
(defvar eqh-a (aref eqh-keep (if (equal eqh-op "hit") 0 eqh-n)))
(defvar eqh-b (if (equal eqh-op "put") 0 eqh-table))
(defvar eqh-c eqh-table)
(defvar eqh-start nil)
(defvar eqh-gc-before nil)
(defvar eqh-instrument-address nil)
(unless eqh-wall
  (if (fboundp 'syscall-direct)
      (let ((code (with-temp-buffer
                    (set-buffer-multibyte nil)
                    (insert-file-contents-literally (getenv "EQHASH_INSTRUMENT"))
                    (buffer-string))))
        (setq eqh-instrument-address (syscall-direct 9 0 4096 7 34 -1 0))
        (when (< eqh-instrument-address 0) (error "instrumentation mmap failed"))
        (ptr-write-bytes eqh-instrument-address code)
        (fset 'eqhash-profile-start
              (lambda () (ptr-call eqh-instrument-address 0 0 0 0 0 0))))
    (module-load (getenv "EQHASH_INSTRUMENT"))))
(defmacro eqh-call ()
  (if (equal eqh-op "put")
      (if eqh-control '(set-char-table-extra-slot eqh-a eqh-b eqh-c)
        '(puthash eqh-a eqh-b eqh-c))
    (if eqh-control '(eq eqh-a eqh-b) '(gethash eqh-a eqh-b))))
(garbage-collect)
(unless eqh-wall (eqhash-profile-start))
(setq eqh-gc-before (eqh-gc-count))
(when eqh-wall (setq eqh-start (float-time)))
;; Discard both call results: assigning only one side adds a boxed-value cost.
(if (equal eqh-op "put")
    (dotimes (eqh-i eqh-calls)
      (setq eqh-a (aref eqh-keep (+ eqh-n eqh-i)))
      (eqh-call))
  (dotimes (eqh-i eqh-calls) (eqh-call)))
(when eqh-wall
  (princ (format "EQHASH-WALL %.9f %d\n" (- (float-time) eqh-start) eqh-calls)))
;; Identical cleanup removes the floor's argument references before post-GC.
;; A natural collection while those references existed invalidates a control.
(when (equal eqh-op "put")
  (dotimes (eqh-i (length eqh-keep))
    (set-char-table-extra-slot (aref eqh-keep eqh-i) 0 nil)))
(unless (or (not (and eqh-control (equal eqh-op "put")))
            (= eqh-gc-before (eqh-gc-count)))
  (error "control collected while extra slots retained argument references"))
(garbage-collect)
(unless (= (hash-table-count eqh-table)
           (if (and (equal eqh-op "put") (not eqh-control)) (+ eqh-n eqh-calls) eqh-n))
  (error "operation did not execute expected insertions"))
(unless (equal (gethash eqh-a eqh-table)
               (cond ((equal eqh-op "hit") 1)
                     ((and (equal eqh-op "put") (not eqh-control)) 0)
                     (t nil)))
  (error "unexpected final lookup"))
(princ "EQHASH-PERF-COMPLETE\n")
(kill-emacs 0)
