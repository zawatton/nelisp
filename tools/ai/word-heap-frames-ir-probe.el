;;; word-heap-frames-ir-probe.el --- GC-isolated S4.2 intervals -*- lexical-binding: t; -*-
;; Instrumentation adapted from regex-native-probe.el at a1caa92c9.
(declare-function pcf-ir-request nil (which))
(declare-function ptr-call nil (function &rest args))
(declare-function ptr-write-u64 nil (pointer offset value))
(declare-function ptr-write-u8 nil (pointer offset value))
(declare-function syscall-direct nil (number &rest args))
(if (getenv "PCF_CLIENT")
    (module-load (getenv "PCF_CLIENT"))
  ;; Persistent client storage must survive the preparation collections.
  (defvar pcf-ir-code (syscall-direct 9 0 4096 7 34 -1 0))
  (unless (and (integerp pcf-ir-code) (> pcf-ir-code 0))
    (error "Callgrind instrumentation mmap failed"))
  (defvar pcf-ir-args (+ pcf-ir-code 128))
  (defvar pcf-ir-start (+ pcf-ir-code 256))
  (defvar pcf-ir-end (+ pcf-ir-code 272))
  (defvar pcf-ir-boot (+ pcf-ir-code 288))
  (let ((offset 0))
    (dolist (byte '(#x48 #x89 #xf8 #x31 #xd2
                   #x48 #xc1 #xc7 #x03 #x48 #xc1 #xc7 #x0d
                   #x48 #xc1 #xc7 #x3d #x48 #xc1 #xc7 #x33
                   #x48 #x87 #xdb #x48 #x89 #xd0 #xc3))
      (ptr-write-u8 pcf-ir-code offset byte)
      (setq offset (1+ offset))))
  (dotimes (i 6) (ptr-write-u64 pcf-ir-args (* 8 i) 0))
  (dolist (label (list (cons pcf-ir-start '(80 67 70 45 83 84 65 82 84 0))
                      (cons pcf-ir-end '(80 67 70 45 69 78 68 0))
                      (cons pcf-ir-boot '(80 67 70 45 66 79 79 84 0))))
    (let ((offset 0))
      (dolist (byte (cdr label))
        (ptr-write-u8 (car label) offset byte)
        (setq offset (1+ offset)))))
  (defun pcf-ir-request (which)
    (ptr-write-u64 pcf-ir-args 0 #x43540003)
    (ptr-write-u64 pcf-ir-args 8 (cond ((= which 0) pcf-ir-start)
                                        ((= which 1) pcf-ir-end)
                                        (t pcf-ir-boot)))
    (ptr-call pcf-ir-code pcf-ir-args 0 0 0 0 0)
    (when (= which 0)
      (ptr-write-u64 pcf-ir-args 0 #x43540001)
      (ptr-write-u64 pcf-ir-args 8 0)
      (ptr-call pcf-ir-code pcf-ir-args 0 0 0 0 0))))
(load (getenv "PCF_SETUP") nil t)
(pcf-ir-request 2)
(load (getenv "PCF_INTERVALS") nil t)
(princ "PCF-IR-DONE 11\n")
(kill-emacs 0)
