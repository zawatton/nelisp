;;; -*- lexical-binding: t; -*-
;;; Experimental primary timing driver; the measured tail matches the frozen source.
(defvar v8-exp--saved-fx-register-fn
  (and (fboundp 'nelisp--fx-register-fn) (symbol-function 'nelisp--fx-register-fn)))
(unless (functionp v8-exp--saved-fx-register-fn)
  (error "Image FX registration function cell is unavailable"))
(let ((bootstrap (expand-file-name
                  "runtime-bootstrap-on.el"
                  (file-name-directory (or load-file-name buffer-file-name)))))
  (unless (and bootstrap (file-readable-p bootstrap))
    (error "Missing corrected ON runtime bootstrap"))
  (load bootstrap nil t))
(unless (functionp v8-exp--saved-fx-register-fn)
  (error "Saved image FX registration cell was lost"))
(fset 'nelisp--fx-register-fn v8-exp--saved-fx-register-fn)
(unless (eq (symbol-function 'nelisp--fx-register-fn) v8-exp--saved-fx-register-fn)
  (error "Image FX registration cell restore failed"))
(let ((required-ids '((bench-nested-add-helper . 30002)
                      (bench-nested-function-call2 . 30003))))
  (dolist (pair required-ids)
    (let* ((name (car pair))
           (function (and (fboundp name) (symbol-function name)))
           (identity (assq name nelisp-runtime-driver-preparation--installed-identities))
           (native-row (assq name nelisp-nc--table)))
      (unless (and function identity (eq function (cdr identity)) native-row
                   (= (nth 1 native-row) (cdr pair)))
        (error "Installed function/native mapping mismatch: %S" name))
      (nelisp--fx-register name)
      (let ((record (gethash (nthcdr 3 function) nelisp--fx-table)))
        (unless (and (eq function (symbol-function name)) (vectorp record)
                     (= (aref record 1) (- -16 (cdr pair))))
          (error "Native FX registration check failed: %S" name))))))
(defun v8-primary-count (key default)
  (let* ((raw (or (getenv key) (number-to-string default)))
         (value (string-to-number raw)))
    (unless (and (equal raw (number-to-string value)) (<= 0 value 16000000))
      (error "Invalid count %s" key))
    value))
(defun v8-primary-reference (n)
  ;; Periodic arithmetic oracle is outside the measured function and does not
  ;; invoke either admitted application function.
  (let ((i 0) (cycle 0) (tail 0) (rest (% n 256)))
    (while (< i 256)
      (let ((v (+ i (% (+ i 37) 256) 1)))
        (setq cycle (+ cycle v))
        (when (< i rest) (setq tail (+ tail v))))
      (setq i (1+ i)))
    (logand (+ (* (/ n 256) cycle) tail) 16777215)))
(let* ((row (getenv "BENCH_ROW"))
       (engine (getenv "BENCH_ENGINE"))
       (n (v8-primary-count "BENCH_N" 0))
       (high (v8-primary-count "BENCH_HIGH" n))
       (warmups (v8-primary-count "BENCH_WARMUPS" 0))
       (i 0) (resolution 1.0) (previous (float-time)) now delta start elapsed result)
  (unless (and (equal row "nested-function-call2") (equal engine "nelisp")
               (>= high n) (= warmups 2)) (error "Invalid frozen timing settings"))
  (while (< i 1024)
    (setq now (float-time) delta (- now previous))
    (when (and (> delta 0) (< delta resolution)) (setq resolution delta))
    (setq previous now i (1+ i)))
  (unless (< resolution 1.0) (error "Unable to resolve float-time"))
  (setq i 0)
  (while (< i warmups)
    (bench-nested-function-call2 high nil)
    (setq i (1+ i)))
  (setq start (float-time)
        result (bench-nested-function-call2 n nil)
        elapsed (- (float-time) start))
  (when (equal (getenv "BENCH_BROKEN") "1") (setcdr result (1+ (cdr result))))
  (unless (and (consp result) (= (car result) n) (= (cdr result) (v8-primary-reference n)))
    (error "Primary result mismatch"))
  (princ (format "BENCH-ROUTE engine=nelisp route=named-fx-default timer=float-time resolution=%.9f\n" resolution))
  (princ (format "BENCH-CHECK n=%d result=%d:%d elapsed=%.9f\n" n n (cdr result) elapsed)))
(kill-emacs 0)
