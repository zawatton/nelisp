(defun h1 (label x)
  (let* ((t0 (float-time)) (nat (nelisp--native-format "%S" x)) (t1 (float-time)) (s (prin1-to-string x)) (t2 (float-time)))
    (princ (format "%-28s native=%-4s native-ms=%7.2f prin1-ms=%8.2f len=%d\n" label (if nat "ok" "nil") (* 1000 (- t1 t0)) (* 1000 (- t2 t1)) (length s)))))
(let ((plain (let (l) (dotimes (i 3000) (push (list 'foo i "str" :kw) l)) l))
      (vec-num (let (l) (dotimes (i 3000) (push (vector 1 2 i) l)) l))
      (vec-sym (let (l) (dotimes (i 3000) (push (vector 'foo i "s") l)) l))
      (car-vec (let (l) (dotimes (i 3000) (push (list (vector 'foo i) 1) l)) l))
      (quoted (let (l) (dotimes (i 3000) (push (list 'quote (list 'a i)) l)) l)))
  (h1 "lists" plain) (h1 "vectors of numbers" vec-num) (h1 "vectors starting w/ symbol" vec-sym)
  (h1 "list whose car is [sym ..]" car-vec) (h1 "quote forms" quoted))
(kill-emacs 0)
