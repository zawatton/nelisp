;;; -*- lexical-binding: t; -*-
(require 'nadvice)
(defun bench-call-helper (x y) (+ x y 1))
(defun bench-function-call2 (n _input)
  (let ((i 0) (s 0))
    (while (< i n)
      (setq s (logand (+ s (bench-call-helper (logand i 255) (logand (+ i 37) 255))) 16777215) i (1+ i)))
    (cons i s)))
(load (expand-file-name "guard-phases.el" (file-name-directory load-file-name)) nil t)
(require 'bytecomp)
(let ((byte-compile-warnings nil))
  (dolist (f '(bench-call-helper bench-function-call2 guard--counting guard--call guard--ref guard--expected-log guard--rec guard-run-all))
    (fset f (byte-compile (symbol-function f)))))
(prin1 (guard-run-all 64 10 nil)) (terpri)
