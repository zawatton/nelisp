                     (if (and f (functionp f) (eq f (cdr e)) row) (format "native-row-%S" (nth 1 row)) "MISSING"))))
           nelisp-runtime-driver-preparation--installed-identities)))

(setq appready--identity (nelisp-init-ready-fingerprint (appready-components)))
(setq appready--txn (nelisp-init-ready-make))
(nelisp-init-ready-run appready--txn appready--identity (lambda (_t) (mapcar (function car) nelisp-runtime-driver-preparation--installed-identities)))
(unless (eq (nelisp-init-ready-state appready--txn) 'ready) (error "txn not ready"))
(garbage-collect)
(probe-try "final")
(kill-emacs 0)
