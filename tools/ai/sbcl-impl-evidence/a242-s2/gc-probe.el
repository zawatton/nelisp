;;; Doc 242 S2 madvise guard: churn large vectors and GC in a fast-path process,
;;; then check heap-wide invariants (image symbols, lists, vectors, new interns).
(let ((i 0) (fail 0))
  (while (< i 6)
    (let ((v (make-vector 2000000 i)))
      (aset v 1999999 (+ i 100))
      (unless (= (aref v 1999999) (+ i 100)) (setq fail (1+ fail)))
      (setq v nil))
    (garbage-collect)
    (setq i (1+ i)))
  (let ((keep (make-vector 50000 7)) (lst nil) (j 0) (s 0))
    (while (< j 100000) (setq lst (cons j lst)) (setq j (1+ j)))
    (garbage-collect)
    (setq j 0)
    (while (< j 50000) (setq s (+ s (aref keep j))) (setq j (1+ j)))
    (unless (= s 350000) (princ "VECTOR-SUM mismatch\n") (setq fail (1+ fail)))
    (unless (= (length lst) 100000) (princ "LIST-LENGTH mismatch\n") (setq fail (1+ fail)))
    (unless (equal (mapcar #'1+ '(1 2 3)) '(2 3 4)) (princ "MAPCAR mismatch\n") (setq fail (1+ fail))))
  (dolist (n '("car" "cdr" "cons" "list" "mapcar" "format" "intern" "symbol-name" "load"))
    (unless (intern-soft n) (princ (format "MISSING %s\n" n)) (setq fail (1+ fail))))
  (unless (equal (format "%s-%d" "a" 5) "a-5") (princ "FORMAT mismatch\n") (setq fail (1+ fail)))
  (unless (eq (intern "gc-probe-new") (intern "gc-probe-new")) (setq fail (1+ fail)))
  (garbage-collect)
  (unless (= (car (nelisp--arena-stats)) 35184372088832) (princ "ARENA base moved\n") (setq fail (1+ fail)))
  (princ (if (= fail 0) "GC-PROBE-PASS\n" "GC-PROBE-FAIL\n")))
