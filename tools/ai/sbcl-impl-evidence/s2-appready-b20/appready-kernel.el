;;; -*- lexical-binding: t; -*-
;;; Phase B: gate on identity, run ONLY the kernel form (generated by gen.py)
(defun appready--refuse (why)
  (message "APPREADY-REFUSED %s" why)
  (kill-emacs 3))

(unless (and (fboundp 'appready-components) (boundp 'appready--txn) appready--txn)
  (appready--refuse "no application-ready state in this process (image not restored)"))
(condition-case err
    (progn
      (unless (equal (getenv "BENCH_ENGINE") "nelisp") (error "BENCH_ENGINE must be nelisp"))
      (nelisp-runtime-driver-preparation--verify-pins appready--pins)
      (let ((id (nelisp-init-ready-fingerprint (appready-components))))
        (unless (eq (nelisp-init-ready-begin appready--txn id) :reuse)
          (error "begin did not return :reuse"))
        (message "APPREADY-REUSE identity=%s" id))
      (dolist (pair '((bench-call-helper . 30000) (bench-function-call2 . 30001) (bench-integer-sum . 30008)
                      (bench-vector-read . 30009) (bench-vector-write . 30010) (bench-vector-allocate64 . 30011)
                      (bench-string-concat16 . 30012) (bench-string-slice16 . 30013) (bench-hash-get1024 . 30014)))
        (let* ((name (car pair)) (function (and (fboundp name) (symbol-function name)))
               (identity (assq name nelisp-runtime-driver-preparation--installed-identities))
               (native-row (assq name nelisp-nc--table)))
          (unless (and function identity (eq function (cdr identity)) native-row (= (nth 1 native-row) (cdr pair)))
            (error "Installed function/native mapping mismatch: %S" name))
          (let ((record (gethash (nthcdr 3 function) nelisp--fx-table)))
            (unless (and (vectorp record) (= (aref record 1) (- -16 (cdr pair))))
              (error "Native FX record missing/mismatch after restore: %S" name))))))
  (error (appready--refuse (format "%S" err))))

(let* ((row (getenv "BENCH_ROW")) (engine (getenv "BENCH_ENGINE")) (n (bench-env-integer "BENCH_N" 0)) (high (bench-env-integer "BENCH_HIGH" n)) (warmups (bench-env-integer "BENCH_WARMUPS" 0)) (names '(bench-integer-sum bench-vector-read bench-vector-write bench-vector-allocate64 bench-string-concat16 bench-string-slice16 bench-hash-get1024 bench-function-call2 bench-call-helper)) (kernel (intern (concat "bench-" (or row "")))) (input nil) (i 0) (pk0 nil) (pk1 nil) start elapsed result checksum (resolution 1.0) previous current delta) (unless (and (member engine '("gnu" "nelisp")) (memq kernel names) (not (eq kernel 'bench-call-helper)) (>= high n)) (error "Invalid benchmark selection")) (when (equal engine "gnu") (require 'bytecomp) (let ((byte-compile-warnings nil)) (dolist (name names) (fset name (byte-compile (symbol-function name))))) (dolist (name names) (unless (byte-code-function-p (symbol-function name)) (error "Kernel/helper is not bytecode: %s" name)))) (setq input (bench-input row)) (bench-check-input row input) (setq previous (float-time)) (while (< i 1024) (setq current (float-time) delta (- current previous)) (when (and (> delta 0) (< delta resolution)) (setq resolution delta)) (setq previous current i (1+ i))) (unless (< resolution 1.0) (error "Unable to resolve float-time")) (setq i 0) (while (< i warmups) (nelisp-phase-event 'BENCH_WARMUP_BEGIN i) (funcall kernel high (if (or (equal row "vector-write") (equal row "vector-allocate64")) (bench-input row) input)) (nelisp-phase-event 'BENCH_WARMUP_END i) (setq i (1+ i))) (when (or (equal row "vector-write") (equal row "vector-allocate64")) (setq input (bench-input row))) (setq pk0 (nelisp-phase-now) start (float-time) result (funcall kernel n input) elapsed (- (float-time) start) pk1 (nelisp-phase-now)) (nelisp-phase-event-at 'KERNEL_BEGIN pk0) (nelisp-phase-event-at 'KERNEL_END pk1) (when (equal (getenv "BENCH_BROKEN") "1") (cond ((equal row "vector-write") (aset (cdr result) 1023 -1)) ((equal row "vector-allocate64") (if (> n 0) (aset (aref (cdr result) 0) 63 -1) (aset (cdr result) 0 (make-vector 64 0)))) (t (setcdr result (1+ (cdr result)))))) (setq checksum (bench-validate row n result)) (nelisp-phase-event 'RESULT_VALIDATED) (princ (format "BENCH-ROUTE engine=%s route=%s timer=float-time resolution=%.9f
" engine (if (equal engine "gnu") "bytecode" "named-fx-default") resolution)) (princ (format "BENCH-CHECK n=%d result=%d:%d elapsed=%.9f
" n n checksum elapsed)) (nelisp-phase-flush))


(kill-emacs 0)
