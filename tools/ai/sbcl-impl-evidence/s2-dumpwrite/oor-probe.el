;; Plants a foreign (malloc) pointer into a heap vector slot, dumps, prints error data.
(defconst oor--marker 777777)
(defun oor--cstr (text)
  (let ((p (alloc-bytes (+ 1 (length text)) 1)))
    (ptr-write-bytes p text) (ptr-write-u8 p (length text) 0) p))
(defun oor--find-slot (v)
  ;; v is a vector filled with the marker; return address of its slot 0.
  (let* ((st (nelisp--arena-stats)) (base (nth 0 st)) (used (nth 2 st))
         (want (+ (* oor--marker 4) 1)) (a base) (end (+ base used)) (hit nil))
    (while (and (not hit) (< a end))
      (when (and (= (ptr-read-u64 a 0) want) (= (ptr-read-u64 a 8) want)
                 (= (ptr-read-u64 a 16) want) (= (ptr-read-u64 a 24) want))
        (setq hit a))
      (setq a (+ a 8)))
    hit))
(let* ((clean (make-vector 3 1))
       (f0 (format "%s/oor-clean.img" (or (getenv "OORDIR") "/tmp"))))
  (princ (format "clean dump: %S\n" (condition-case e (nelisp--arena-dump-image-stream f0) (error e)))))
(let* ((v (make-vector 4 oor--marker)) (slot0 (oor--find-slot v))
       (foreign (let* ((h (nl-ffi-call "dlopen" 0 1))
                       (m (nl-ffi-call "dlsym" h (oor--cstr "malloc"))))
                  (ptr-call m 4096 0 0 0 0 0)))
       (f1 (format "%s/oor-bad.img" (or (getenv "OORDIR") "/tmp"))))
  (princ (format "slot0=%S foreign=%S\n" slot0 foreign))
  (ptr-write-u64 slot0 16 foreign)   ; slot index 2
  (when (getenv "OOR2") (ptr-write-u64 slot0 0 foreign))
  (princ (format "bad dump: %S\n" (condition-case e (nelisp--arena-dump-image-stream f1) (error e))))
  (ptr-write-u64 slot0 0 3) (ptr-write-u64 slot0 16 3)         ; restore (nil word) before exit
  (princ (format "v=%S\n" v)))
