;;; refvm.el --- Lisp reference of the native matcher VM  -*- lexical-binding: t; -*-
;; Mirrors m5_rx_* in scripts/nelisp-standalone-build.el step for step so the
;; program compiler (nlre--nat-compile) can be checked against GNU Emacs in a
;; host Emacs without a standalone build.
(defconst rxn-fcap 65536)
(defconst rxn-ucap 65536)

(defun rxn-words (prog)
  (let* ((n (/ (length prog) 4)) (w (make-vector n 0)) (i 0))
    (while (< i n)
      (aset w i (+ (aref prog (* 4 i)) (* 256 (aref prog (+ 1 (* 4 i))))
                   (* 65536 (aref prog (+ 2 (* 4 i)))) (* 16777216 (aref prog (+ 3 (* 4 i))))))
      (setq i (1+ i)))
    w))

(defun rxn-one (w prog apc b)
  (let ((op (aref w apc)))
    (cond ((= op 1) (if (= b (aref w (1+ apc))) 1 0))
          ((= op 2) (cond ((or (= b (aref w (+ apc 1))) (= b (aref w (+ apc 2)))) 1)
                          ((>= b 128) (if (or (= (aref w (+ apc 1)) 107) (= (aref w (+ apc 1)) 115)) -1 0))
                          (t 0)))
          ((= op 3) (cond ((= b 10) 0) ((>= b 128) -1) (t 1)))
          (t (if (>= b 128) (if (= (aref w (1+ apc)) 1) -1 0)
               (if (= 1 (aref prog (+ (* 4 (+ apc 2)) b))) 1 0))))))

(defun rxn-alen (op) (cond ((= op 1) 2) ((= op 2) 3) ((= op 3) 1) (t 34)))

(defun rxn-run (w prog tp n lim pc0 pos0 regs)
  "Run from PC0 at POS0; return end byte, -1 no match, -2 decline."
  (let ((pc pc0) (pos pos0) (frames nil) (sp 0) (undo nil) (usp 0)
        (res -3) (failing nil) (fold (/= 0 (logand (aref w 2) 4)))
        (steps 0))
    (setq frames (make-vector rxn-fcap nil) undo (make-vector rxn-ucap nil))
    (while (= res -3)
      (setq steps (1+ steps))
      (if failing
          (if (= sp 0)
              (progn (while (> usp 0)
                       (setq usp (1- usp))
                       (aset regs (car (aref undo usp)) (cdr (aref undo usp))))
                     (setq res -1))
            (let* ((f (aref frames (1- sp))) (w0 (aref f 0)) (uh (aref f 2)))
              (while (> usp uh)
                (setq usp (1- usp))
                (aset regs (car (aref undo usp)) (cdr (aref undo usp))))
              (if (>= w0 1099511627776)
                  (progn (setq pos (aref f 1) pc (- w0 1099511627776))
                         (if (> pos (aref f 3)) (aset f 1 (1- pos)) (setq sp (1- sp))))
                (setq pos (aref f 1) pc w0 sp (1- sp)))
              (setq failing nil)))
        (let ((op (aref w pc)))
          (cond
           ((= op 0) (setq res pos))
           ((<= op 4)
            (if (>= pos lim) (setq failing t)
              (let ((r (rxn-one w prog pc (aref tp pos))))
                (cond ((= r 1) (setq pos (1+ pos) pc (+ pc (rxn-alen op))))
                      ((= r 0) (setq failing t))
                      (t (setq res -2))))))
           ((= op 5) (if (or (= pos 0) (= (aref tp (1- pos)) 10)) (setq pc (1+ pc)) (setq failing t)))
           ((= op 6) (if (or (= pos n) (= (aref tp pos) 10)) (setq pc (1+ pc)) (setq failing t)))
           ((= op 7) (if (= pos 0) (setq pc (1+ pc)) (setq failing t)))
           ((= op 8) (if (= pos n) (setq pc (1+ pc)) (setq failing t)))
           ((or (= op 9) (= op 12))
            (if (>= usp rxn-ucap) (setq res -2)
              (let ((r (aref w (1+ pc))))
                (aset undo usp (cons r (aref regs r)))
                (setq usp (1+ usp))
                (aset regs r pos)
                (setq pc (+ pc 2)))))
           ((= op 10)
            (if (>= sp rxn-fcap) (setq res -2)
              (progn (aset frames sp (vector (aref w (+ pc 2)) pos usp 0))
                     (setq sp (1+ sp) pc (aref w (1+ pc))))))
           ((= op 11) (setq pc (aref w (1+ pc))))
           ((= op 13)
            (if (<= pos (aref regs (aref w (1+ pc)))) (setq pc (aref w (+ pc 2))) (setq pc (+ pc 3))))
           ((= op 14)
            (let* ((g (aref w (1+ pc))) (s (aref regs (* 2 g))) (e (aref regs (1+ (* 2 g)))))
              (if (or (< s 0) (< e 0)) (setq failing t)
                (let ((len (- e s)))
                  (if (< len 0) (setq res -2)
                    (if (> (+ pos len) lim) (setq failing t)
                      (let ((i 0) (st 0))
                        (while (and (= st 0) (< i len))
                          (let ((a (aref tp (+ s i))) (b (aref tp (+ pos i))))
                            (if fold
                                (progn
                                  (if (or (>= a 128) (>= b 128)) (setq st -2)
                                    (progn (when (and (>= a 65) (<= a 90)) (setq a (+ a 32)))
                                           (when (and (>= b 65) (<= b 90)) (setq b (+ b 32)))
                                           (unless (= a b) (setq st 1)))))
                              (unless (= a b) (setq st 1))))
                          (setq i (1+ i)))
                        (cond ((= st -2) (setq res -2))
                              ((= st 1) (setq failing t))
                              (t (setq pos (+ pos len) pc (+ pc 2)))))))))))
           ((= op 15)
            (let* ((mn (aref w (+ pc 1))) (mx (aref w (+ pc 2))) (apc (+ pc 3))
                   (nxt (+ apc (rxn-alen (aref w apc)))) (k 0) (st 0))
              (while (and (= st 0) (< k mx) (< (+ pos k) lim))
                (let ((r (rxn-one w prog apc (aref tp (+ pos k)))))
                  (cond ((= r 1) (setq k (1+ k))) ((= r 0) (setq st 1)) (t (setq st -2)))))
              (cond ((= st -2) (setq res -2))
                    ((< k mn) (setq failing t))
                    (t (when (> k mn)
                         (if (>= sp rxn-fcap) (setq st -2)
                           (progn (aset frames sp (vector (+ nxt 1099511627776) (+ pos (1- k)) usp (+ pos mn)))
                                  (setq sp (1+ sp)))))
                       (if (= st -2) (setq res -2)
                         (setq pos (+ pos k) pc nxt))))))
           (t (setq res -2))))))
    res))

(defun rxn-exec (prog text start limit anchored)
  "Return nil (no match), t (decline), or (START . CAPS) with CAPS a list of (s . e)."
  (let* ((w (rxn-words prog)) (nreg (aref w 0)) (ng (aref w 1)) (flags (aref w 2))
         (uni (not (multibyte-string-p text)))
         (tp (if uni (vconcat text) (vconcat (encode-coding-string text 'utf-8 t))))
         (n (length tp))
         (sb (if uni start (length (encode-coding-string (substring text 0 start) 'utf-8 t))))
         (lb (if uni limit (length (encode-coding-string (substring text 0 limit) 'utf-8 t))))
         (regs (make-vector (max nreg 2) -1))
         (i sb) (found nil) (res -3) (done nil))
    (when (and (/= 0 (logand flags 1)) (> sb 0)) (setq done t))
    (while (and (not done) (<= i lb))
      (let ((skip nil))
        (when (and (/= 0 (logand flags 2)))
          (if (>= i lb) (setq skip t done t)
            (let ((b (aref tp i)))
              (when (and (< b 128) (= 0 (aref prog (+ (* 4 5) b)))) (setq skip t)))))
        (unless skip
          (setq res (rxn-run w prog tp n lb (aref w 3) i regs))
          (cond ((>= res 0) (setq found t done t))
                ((= res -2) (setq done t))))
        (when (/= 0 (logand flags 1)) (setq done t))
        (unless done (setq i (1+ i)))))
    (cond
     ((= res -2) t)
     ((not found) nil)
     (t
      (let* ((cs (if uni i (+ start (let ((c 0) (j sb)) (while (< j i) (unless (= (logand (aref tp j) 192) 128) (setq c (1+ c))) (setq j (1+ j))) c))))
             (delta (- cs i)) (caps nil) (g (1- ng)))
        (while (>= g 0)
          (let ((s (if (= g 0) i (aref regs (* 2 g)))) (e (if (= g 0) res (aref regs (1+ (* 2 g))))))
            (setq caps (cons (if (and (>= s 0) (>= e 0)) (cons (+ s delta) (+ e delta)) nil) caps)))
          (setq g (1- g)))
        (cons cs caps))))))
