;;; test-ref.el --- check nlre--nat-compile + refvm against GNU string-match  -*- lexical-binding: t; -*-
(let ((root (expand-file-name "../../.." (file-name-directory load-file-name))))
  (load (expand-file-name "lisp/nelisp-stdlib-regexp.el" root) nil t)
  (load (expand-file-name "target/rxnative/compile-block-loaded.el" root) nil t)
  (load (expand-file-name "tools/ai/rxnative/refvm.el" root) nil t))
(defvar rt-bad 0) (defvar rt-ok 0) (defvar rt-decl 0)
(defun rt-gnu (re s st fold)
  (let ((case-fold-search fold))
    (condition-case e (let ((r (string-match re s st))) (and r (cons r (let ((md (match-data)) (l nil)) (while md (setq l (cons (and (car md) (cons (car md) (cadr md))) l) md (cddr md))) (nreverse l)))))
      (error (list 'err (car e))))))
(defun rt-nat (re s st fold)
  (let ((prog (nlre--nat-compile re fold)))
    (if (null prog) 'decl
      (let ((r (rxn-exec prog s st (length s) nil)))
        (cond ((eq r t) 'decl) ((null r) nil)
              (t r))))))
(defun rt-norm (g)
  ;; drop trailing nil groups like match-data does
  (if (and (consp g) (not (eq (car g) 'err)))
      (let ((caps (cdr g))) (while (and (cdr caps) (null (car (last caps)))) (setq caps (butlast caps))) (cons (car g) caps))
    g))
(defun rt-one (re s st fold)
  (let ((g (rt-gnu re s st fold)) (n (rt-nat re s st fold)))
    (cond ((eq n 'decl) (setq rt-decl (1+ rt-decl)))
          ((and (consp g) (eq (car g) 'err)) (setq rt-bad (1+ rt-bad)) (princ (format "BAD(err) %S %S: gnu=%S nat=%S\n" re s g n)))
          ((equal (rt-norm g) (rt-norm n)) (setq rt-ok (1+ rt-ok)))
          (t (setq rt-bad (1+ rt-bad)) (princ (format "BAD %S %S st=%S fold=%S: gnu=%S nat=%S\n" re s st fold g n))))))
(provide 'test-ref)
