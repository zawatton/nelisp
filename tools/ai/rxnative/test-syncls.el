;;; test-syncls.el --- SYNCLS opcode: compiler + refvm against GNU  -*- lexical-binding: t; -*-
;; Run: emacs --batch -Q -l tools/ai/rxnative/test-syncls.el   (prints SYNCLS ok=N bad=0 ...)
(load (expand-file-name "host-shim.el" (file-name-directory load-file-name)) nil t)
(defvar sc-ok 0) (defvar sc-bad 0) (defvar sc-decl 0) (defvar sc-run 0)
(defvar sc-neg nil "Mutation control: flip NEG of every compiled SYNCLS.")
(defun sc-caps () (let ((c nlre--last-caps) (l nil) (i 0))
  (while (< i (length c)) (setq l (append l (list (and (aref c i) (car (aref c i))) (and (aref c i) (cdr (aref c i))))) i (1+ i)))
  (while (and l (null (car (last l)))) (setq l (butlast l 2))) l))
(defun sc-fill () (setq nlre--nat-cls-key nil nlre--nat-syn-key nil) (nlre--nat-cls-fill) (nlre--nat-syn-ensure))
(defun sc-nat (re s st fold)
  "Native route through refvm: (RESULT . CAPS), `decl' when the program or exec declines."
  (let* ((nlre--nat-allow-syn t) (nlre--nat-allow-cls t)
         (prog (nlre--nat-compile re fold)))
    (if (or (null prog) (= 0 (logand (aref prog 8) 32))) 'nocls
      (when sc-neg (let ((i 20)) (while (< i (length prog)) (setq i (1+ i))))
            (setq prog (sc-flip prog)))
      (let* ((case-fold-search fold) (r (nlre--nat-run (cons prog 1) s (or st 0) (length s) nil (length s))))
        (cond ((eq r t) 'decl) ((null r) (list nil))
              (t (nlre--nat-publish (aref prog 4) 0) (cons (car (aref nlre--last-caps 0)) (sc-caps))))))))
(defun sc-flip (prog)
  "Copy of PROG with the NEG word of every SYNCLS flipped (mutation control)."
  (let* ((p (copy-sequence prog)) (w (rxn-words p)) (pc (aref w 3)) (n (length w)))
    (while (< pc n)
      (let ((op (aref w pc)))
        (cond ((= op 22) (let ((b (* 4 (+ pc 2)))) (aset p b (- 1 (aref p b)))) (setq pc (+ pc 3)))
              ((= op 1) (setq pc (+ pc 2))) ((= op 2) (setq pc (+ pc 3)))
              ((memq op '(0 3 5 6 7 8 16 17 18 19 20 21)) (setq pc (1+ pc)))
              ((memq op '(9 11 12 14)) (setq pc (+ pc 2))) ((memq op '(10 13)) (setq pc (+ pc 3)))
              (t (setq pc n)))))
    p))
(defun sc-gnu (re s st fold)
  (let ((case-fold-search fold)) (let ((r (string-match re s st))) (cons r (and r (let ((md (match-data)) (l nil)) (while md (setq l (append l (list (car md) (cadr md))) md (cddr md))) (while (and l (null (car (last l)))) (setq l (butlast l 2))) l))))))
(defvar sc-pats '("\\w" "\\W" "\\s-" "\\S-" "\\s_" "\\s." "\\s(" "\\s)" "\\sw" "\\s\"" "\\s " "\\s<" "\\sq"
  "\\w+" "\\W+" "\\s-+" "\\(\\w\\)\\(\\s-\\)" "a\\w*b" "\\w+\\s-+\\w+" "\\(?:\\w\\|\\s_\\)+" "\\sw\\{2,3\\}" "x\\W" "^\\s-*\\w" "\\w$" "\\w+?_" "\\(\\w+\\)\\1"
  "foo\\|\\w\\{3\\}" "\\_<\\w+\\_>" "\\<\\w" "\\w\\>"))
(defvar sc-subs '("" "a" "_" " " "-" "foo bar" "foo_bar baz" "(x) [y]" "a-b.c,d" "  tab\there\n x" "12 345" "\"q\"" "AbC dEf" "あい foo" "foo あ" "é" "x\ny z" "aab" "a_b"))
(defun sc-run-all (label)
  (dolist (re sc-pats)
    (dolist (s sc-subs)
      (dolist (fold '(nil t))
        (dolist (st '(0 1))
          (when (<= st (length s))
            (let ((n (sc-nat re s st fold)))
              (cond ((eq n 'nocls) nil)
                    ((eq n 'decl) (setq sc-decl (1+ sc-decl)))
                    (t (setq sc-run (1+ sc-run))
                       (let ((g (sc-gnu re s st fold)))
                         (if (equal (cons (car g) (cdr g)) (cons (car n) (cdr n))) (setq sc-ok (1+ sc-ok))
                           (setq sc-bad (1+ sc-bad)) (when (< sc-bad 15) (princ (format "BAD[%s] %S %S st=%S fold=%S: gnu=%S nat=%S\n" label re s st fold g n)))))))))))))
  nil)
(sc-fill)
(sc-run-all "std")
;; modified table, with-syntax-table, standard table with _ as word
(let ((st (make-syntax-table)))
  (modify-syntax-entry ?_ "w" st) (modify-syntax-entry ?- "_" st) (modify-syntax-entry ?. "w" st)
  (with-syntax-table st (nlre-clear-syntax-cache) (sc-fill) (sc-run-all "mod")))
(nlre-clear-syntax-cache) (sc-fill)
;; Class map fill check: every ASCII char equals char-syntax's code
(let ((bad 0) (c 0))
  (while (< c 128)
    (unless (eq (aref nlre--syntax-designators (aref nlre--nat-caps (+ 332 c))) (char-syntax c)) (setq bad (1+ bad)))
    (setq c (1+ c)))
  (princ (format "CLSMAP bad=%d (standard table, 128 chars vs char-syntax)\n" bad)))
;; Short caps vector: program must be declined by the exec (refvm) and by the guard
(let* ((nlre--nat-allow-syn t) (nlre--nat-allow-cls t) (prog (nlre--nat-compile "\\w" nil))
       (short (make-vector 332 -1)))
  (princ (format "SHORTCAPS exec=%S (want t)\n" (rxn-exec prog "a" 0 1 nil short))))
;; Unfilled class map (all -1) declines; non-ASCII text declines
(let* ((nlre--nat-allow-syn t) (nlre--nat-allow-cls t) (prog (nlre--nat-compile "\\w" nil)))
  (princ (format "UNFILLED exec=%S (want t)  NONASCII exec=%S (want t)\n" (rxn-exec prog "a" 0 1 nil (make-vector 460 -1)) (rxn-exec prog "あ" 0 1 nil nlre--nat-caps))))
;; without the allow switches class atoms decline at compile time (today's behaviour)
(princ (format "NOALLOW nat-compile \\w=%S (want nil)\n" (and (nlre--nat-compile "\\w" nil) t)))
(princ (format "SYNCLS ok=%d bad=%d decl=%d ran=%d\n" sc-ok sc-bad sc-decl sc-run))
