;;; -*- lexical-binding: t; -*-
(load (expand-file-name "host-shim.el" (file-name-directory load-file-name)) nil t)
(defvar gl-bad 0) (defvar gl-ok 0)
(defun gl-caps ()
  (let ((c nlre--last-caps) (l nil) (i 0))
    (while (< i (length c))
      (setq l (append l (list (and (aref c i) (car (aref c i))) (and (aref c i) (cdr (aref c i))))) i (1+ i)))
    (while (and l (null (car (last l)))) (setq l (butlast l 2)))
    l))
(defun gl-gnu (re s st fold)
  (let ((case-fold-search fold))
    (condition-case nil
        (let ((r (string-match re s st))) (cons r (and r (match-data))))
      (error (list 'err)))))
(defun gl-nl (re s st fold me)
  (let ((case-fold-search fold))
    (condition-case e
        (let ((r (nlre-string-match re s st me))) (cons r (and r (gl-caps))))
      (error (list 'err e)))))
(defun gl-one (re s st fold)
  (let ((g (gl-gnu re s st fold)) (n (gl-nl re s st fold nil)))
    (if (equal g n) (setq gl-ok (1+ gl-ok))
      (setq gl-bad (1+ gl-bad))
      (princ (format "BAD %S %S st=%S fold=%S: gnu=%S nl=%S\n" re s st fold g n)))))
(dolist (re '("a" "b+" "\\(o\\)\\1" "[0-9]+" "x*" "\\(f\\)\\(o\\)*" "o\\'" "^a" "a$" "é" "a\\{2\\}" "\\(a\\|b\\)+c" "." "z"))
  (dolist (s '("foo bar" "aab" "abc\nabc" "" "xx" "12 345" "foooo" "あfoo" "baac"))
    (dolist (fold '(nil t))
      (dolist (st '(nil 0 1))
        (when (or (null st) (<= st (length s)))
          (gl-one re s st fold))))))
(princ (format "GLUE ok=%d bad=%d\n" gl-ok gl-bad))
(defvar gl-calls 0) (defvar gl-handled 0)
(advice-add 'nelisp--rx-exec :around (lambda (f &rest a) (setq gl-calls (1+ gl-calls)) (let ((r (apply f a))) (unless (eq r t) (setq gl-handled (1+ gl-handled))) r)))
(let ((case-fold-search nil)) (nlre-string-match "b+" "aabbb" nil nil) (nlre-string-match "あ" "あ" nil nil) (nlre-string-match "o+" "あfoo" nil nil))
(princ (format "calls=%d handled=%d\n" gl-calls gl-handled))
