;;; test-d2.el --- D2: nlre-string-match with class programs through refvm  -*- lexical-binding: t; -*-
(load (expand-file-name "host-shim.el" (file-name-directory load-file-name)) nil t)
(defvar d2-ok 0) (defvar d2-bad 0) (defvar d2-calls 0) (defvar d2-handled 0)
(advice-add 'nelisp--rx-exec :around (lambda (f &rest a) (setq d2-calls (1+ d2-calls)) (let ((r (apply f a))) (unless (eq r t) (setq d2-handled (1+ d2-handled))) r)))
(defun d2-caps () (let ((c nlre--last-caps) (l nil) (i 0))
  (while (< i (length c)) (setq l (append l (list (and (aref c i) (car (aref c i))) (and (aref c i) (cdr (aref c i))))) i (1+ i)))
  (while (and l (null (car (last l)))) (setq l (butlast l 2))) l))
(defun d2-one (re s st fold)
  (let* ((case-fold-search fold)
         (g (let ((r (string-match re s st))) (cons r (and r (match-data)))))
         (n (let ((r (nlre-string-match re s st nil))) (cons r (and r (d2-caps))))))
    (if (equal g n) (setq d2-ok (1+ d2-ok))
      (setq d2-bad (1+ d2-bad)) (when (< d2-bad 10) (princ (format "BAD %S %S st=%S fold=%S gnu=%S nl=%S\n" re s st fold g n))))))
(defvar d2-pats '("\\w" "\\W" "\\s-" "\\S-" "\\s_" "\\s." "\\s(" "\\sw" "\\w+" "\\s-+\\w" "\\(\\w+\\)\\s-\\(\\w+\\)" "a\\W*b" "\\<\\w+\\>" "x" "[a-z]+"))
(defvar d2-subs '("" "a" "foo bar" "foo_bar baz" "(x) [y]" "あい foo" "foo あ" "a-b.c" "  \t x"))
(defun d2-all ()
  (dolist (re d2-pats) (dolist (s d2-subs) (dolist (f '(nil t)) (dolist (st '(nil 1)) (when (or (null st) (<= st (length s))) (d2-one re s st f)))))))
(setq parse-sexp-lookup-properties nil)
(setq nlre--nat-cls-enable nil) (d2-all)
(princ (format "SWITCH-OFF ok=%d bad=%d exec-calls=%d\n" d2-ok d2-bad d2-calls))
(setq nlre--nat-cls-enable t d2-ok 0 d2-bad 0 d2-calls 0 d2-handled 0) (d2-all)
(princ (format "SWITCH-ON ok=%d bad=%d exec-calls=%d handled=%d\n" d2-ok d2-bad d2-calls d2-handled))
;; Stale-map evidence (R2): raw aset on a syntax table is not seen until the cache is cleared
(let ((st (make-syntax-table)) (case-fold-search nil) a b c)
  (with-syntax-table st
    (setq a (nlre-string-match "\\w" "_"))
    (aset st ?_ (cons 2 nil))
    (setq b (nlre-string-match "\\w" "_" ) c (string-match "\\w" "_"))
    (nlre-clear-syntax-cache)
    (princ (format "R2 raw-aset: before=%S after=%S (GNU %S) after-clear=%S\n" a b c (nlre-string-match "\\w" "_")))))
(setq parse-sexp-lookup-properties t d2-calls 0)
(let ((case-fold-search nil)) (nlre-string-match "\\w" "foo" nil nil))
(princ (format "LOOKUP-PROPS exec-calls=%d (want 0: declined)\n" d2-calls))
