;;; wasm-cas-test.el --- Focused CAS encoder/visitor/local checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'nelisp-aot-compiler)
(require 'nelisp-asm-wasm)
(ert-deftest wasm-cas/encoding ()
  (let ((buf (nelisp-asm-wasm-make-buffer)))
    (nelisp-asm-wasm-op-i64-atomic-rmw-cmpxchg buf)
    (should (equal (nelisp-asm-wasm-buffer-bytes buf) (unibyte-string #xfe #x49 3 0)))))
(ert-deftest wasm-cas/imports-and-conditional-local ()
  (let* ((unit (nelisp-aot-compile-to-link-unit
                '(seq (defun plain () 5)
                      (defun cas () (atomic-compare-exchange (extern-call p) (extern-call e) (extern-call d))))
                :arch 'wasm32 :format 'wasm))
         (functions (plist-get unit :wasm-functions)))
    (should (equal (mapcar (lambda (row) (plist-get row :field)) (plist-get unit :wasm-imports)) '("p" "e" "d")))
    (should (= (1+ (length (plist-get (car functions) :locals)))
               (length (plist-get (cadr functions) :locals))))
    (should (equal (plist-get (car functions) :locals)
                   (butlast (plist-get (cadr functions) :locals))))
    (should (= (car (last (plist-get (cadr functions) :locals))) #x7e))))
(ert-deftest wasm-cas/handlers-in-all-operands ()
  (let ((unit (nelisp-aot-compile-to-link-unit
               '(defun cas () (atomic-compare-exchange (catch 3 (throw 3 1040))
                                                       (catch 4 (throw 4 5)) (catch 5 (throw 5 9))))
               :arch 'wasm32 :format 'wasm)))
    (should (integerp (plist-get unit :wasm-tag-type-index)))))
(provide 'wasm-cas-test)
