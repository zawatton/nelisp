;;; corpus-pcase.el --- pcase differential corpus  -*- lexical-binding: t; -*-
(pcase 5 ((pred integerp) 'int) (_ 'other))
(pcase '(1 2) (`(,a ,b) (+ a b)))
(pcase 3 ((or 1 2 3) 'small) (_ 'big))
(pcase '(add 1 2) (`(add ,x ,y) (+ x y)) (`(sub ,x ,y) (- x y)))
(pcase '(sub 5 2) (`(add ,x ,y) (+ x y)) (`(sub ,x ,y) (- x y)))
(pcase 7 ((and n (guard (> n 5))) (list 'big n)) (_ 'small))
(pcase 2 ((and n (guard (> n 5))) (list 'big n)) (_ 'small))
(pcase '(1 . 2) (`(,a . ,b) (list a b)))
(pcase "12" ((app string-to-number n) (* n 2)))
(pcase [1 2 3] (`[,a ,b ,c] (list c b a)))
(pcase 'foo ('foo 'matched) (_ 'no))
(pcase :k (:k 'kw))
(pcase '(integer) (`(,(and name (or 'integer 'float)) . ,(or `(,min ,max) pcase--dontcare)) name))
(pcase '(float 1 2) (`(,(and name (or 'integer 'float)) . ,(or `(,min ,max) pcase--dontcare)) (list name min max)))
(pcase '(integer 3 4) (`(,(and name (or 'integer 'float)) . ,(or `(,min ,max) pcase--dontcare)) (list name min max)))
(pcase-let ((`(,a ,b) '(1 2))) (+ a b))
(pcase-let* ((`(,a ,b) '(1 2)) (c (+ a b))) c)
(let (r) (pcase-dolist (`(,k . ,v) '((a . 1) (b . 2))) (push (list k v) r)) r)
(let (a b) (pcase-setq `(,a ,b) '(10 20)) (list a b))
(pcase-exhaustive 1 (1 'one))
(condition-case e (pcase-exhaustive 5 (1 'one)) (error (car e)))
(pcase 5 ((pred (< 3)) 'gt3) (_ 'le3))
(pcase '(1 2 3) (`(1 . ,rest) rest))
(pcase 'b ((or 'a 'b) 'ab) (_ 'other))
(pcase 1 ((cl-type integer) 'i) (_ 'other))
(pcase '(1 2) ((and `(,a ,b) (guard (< a b))) 'lt) (_ 'ge))
(funcall (pcase-lambda (`(,a ,b)) (+ a b)) '(1 2))
(pcase 1 ((pred (not stringp)) 'not-string))
(list (cl-typep 5 '(integer 0 10)) (cl-typep 15 '(integer 0 10)) (cl-typep 5.0 '(float 0.0 10.0)) (cl-typep 'a '(member a b)) (cl-typep 3 '(or string integer)))
(pcase '(1 (2 3)) (`(,a (,b ,c)) (list a b c)))
(pcase "str" ((and (pred stringp) s (guard (> (length s) 2))) (upcase s)))
