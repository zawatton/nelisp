;;; corpus-setf.el --- setf/gv differential corpus  -*- lexical-binding: t; -*-
(let ((x (list 1 2 3))) (setf (car x) 9) x)
(let ((x (list 1 2 3))) (setf (nth 1 x) 'b) x)
(let ((v (vector 1 2))) (setf (aref v 0) 5) v)
