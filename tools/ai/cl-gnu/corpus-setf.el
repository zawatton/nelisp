(cl-defstruct clgnu-sp a (b 0))
(let ((s (make-clgnu-sp))) (setf (clgnu-sp-a s) 1) (cl-incf (clgnu-sp-b s) 5) (list (clgnu-sp-a s) (clgnu-sp-b s)))
(defun clgnu-get (x) (car x))
(progn (gv-define-setter clgnu-get (val x) `(setcar ,x ,val)) 'ok)
(let ((c (list 1))) (setf (clgnu-get c) 7) c)
(let ((c (list nil))) (push 1 (clgnu-get c)) c)
(defun clgnu-get2 (c) (car c))
(defun clgnu-set2 (c v) (setcar c v))
(progn (gv-define-simple-setter clgnu-get2 clgnu-set2) 'ok)
(let ((c (list 1))) (setf (clgnu-get2 c) 3) c)
(let ((l (list 1 2))) (push 0 l) l)
(let ((l (list 1 2))) (list (pop l) l))
(let ((x 1)) (cl-incf x) (cl-incf x 5) x)
