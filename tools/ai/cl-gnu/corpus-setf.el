(let ((a (list 1 2 3))) (cl-incf (nth 1 a) 10) a)
(let ((x (list 1 2))) (cl-pushnew 1 x) (cl-pushnew 3 x) x)
(let ((x 1) (y 2)) (cl-rotatef x y) (list x y))
(let ((x 1) (y 2)) (cl-psetf x y y x) (list x y))
