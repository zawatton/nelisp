;;; corpus-defstruct.el --- cl-defstruct differential corpus  -*- lexical-binding: t; -*-
(cl-defstruct clgnu-pt x y)
(let ((p (make-clgnu-pt :x 1 :y 2))) (list (clgnu-pt-x p) (clgnu-pt-y p)))
(list (clgnu-pt-p (make-clgnu-pt)) (clgnu-pt-p 5))
(cl-typep (make-clgnu-pt) 'clgnu-pt)
(type-of (make-clgnu-pt))
(let ((p (make-clgnu-pt :x 1))) (setf (clgnu-pt-x p) 9) (clgnu-pt-x p))
(cl-defstruct (clgnu-pt3 (:include clgnu-pt)) z)
(let ((p (make-clgnu-pt3 :x 1 :y 2 :z 3))) (list (clgnu-pt-x p) (clgnu-pt3-z p) (clgnu-pt-p p) (clgnu-pt3-p p)))
(clgnu-pt3-p (make-clgnu-pt))
(list (cl-typep (make-clgnu-pt3) 'clgnu-pt) (cl-typep (make-clgnu-pt3) 'clgnu-pt3) (cl-typep 5 'clgnu-pt))
(cl-defstruct (clgnu-lst (:type list)) a b)
(make-clgnu-lst :a 1 :b 2)
(cl-defstruct (clgnu-vec (:type vector) :named) a b)
(list (make-clgnu-vec :a 1 :b 2) (clgnu-vec-p (make-clgnu-vec :a 1)) (clgnu-vec-p [1 2 3]))
(cl-defstruct (clgnu-cp (:copier clgnu-dup)) v)
(let* ((a (make-clgnu-cp :v (list 1))) (b (clgnu-dup a))) (list (eq a b) (equal a b) (eq (clgnu-cp-v a) (clgnu-cp-v b))))
(cl-defstruct (clgnu-nc (:copier nil)) v)
(fboundp 'copy-clgnu-nc)
(cl-defstruct (clgnu-ctor (:constructor clgnu-new (a &optional (b 7)))) a b)
(let ((c (clgnu-new 1))) (list (clgnu-ctor-a c) (clgnu-ctor-b c)))
(prin1-to-string (make-clgnu-pt :x 1 :y 2))
(prin1-to-string (make-clgnu-pt3 :x 1 :y 2 :z 3))
(cl-defstruct clgnu-def (a 5) (b (+ 1 2)))
(let ((d (make-clgnu-def))) (list (clgnu-def-a d) (clgnu-def-b d)))
(cl-defstruct (clgnu-pred (:predicate clgnu-is-it)) q)
(clgnu-is-it (make-clgnu-pred))
(cl-defstruct (clgnu-conc (:conc-name cc-)) a)
(cc-a (make-clgnu-conc :a 4))
(cl-defstruct clgnu-doc "Docstring here." a)
(clgnu-doc-a (make-clgnu-doc :a 1))
(progn (require 'cl-print) (cl-prin1-to-string (make-clgnu-pt :x 1 :y 2)))
(cl-struct-slot-value 'clgnu-pt 'y (make-clgnu-pt :y 3))
(mapcar #'car (cl-struct-slot-info 'clgnu-pt))
(condition-case e (clgnu-pt-x 5) (error (car e)))
(cl-defstruct (clgnu-kw (:constructor nil) (:constructor clgnu-kw-create (&key a b))) a b)
(let ((k (clgnu-kw-create :b 2))) (list (clgnu-kw-a k) (clgnu-kw-b k)))
(list (recordp (make-clgnu-pt)) (vectorp (make-clgnu-pt)) (aref (make-clgnu-pt :x 1) 1))
(let ((p (make-clgnu-pt :x 1 :y 2))) (cl-incf (clgnu-pt-x p) 10) (clgnu-pt-x p))
