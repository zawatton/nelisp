;;; corpus-generic.el --- cl-defgeneric/cl-defmethod differential corpus  -*- lexical-binding: t; -*-
(progn (cl-defgeneric clgnu-g (x) "Doc.") 'ok)
(cl-defmethod clgnu-g ((x integer)) (list 'int x))
(cl-defmethod clgnu-g ((x string)) (list 'str x))
(cl-defmethod clgnu-g ((x symbol)) (list 'sym x))
(cl-defmethod clgnu-g (x) (list 'default x))
(list (clgnu-g 1) (clgnu-g "a") (clgnu-g 'b) (clgnu-g 1.5))
(clgnu-g nil)
(cl-defmethod clgnu-g :around ((x integer)) (list 'around (cl-call-next-method)))
(clgnu-g 3)
(defvar clgnu-log nil)
(progn (cl-defgeneric clgnu-h (x)) 'ok)
(cl-defmethod clgnu-h ((x integer)) (push 'primary clgnu-log) x)
(cl-defmethod clgnu-h :before ((x integer)) (push 'before clgnu-log))
(cl-defmethod clgnu-h :after ((x integer)) (push 'after clgnu-log))
(progn (setq clgnu-log nil) (list (clgnu-h 1) (reverse clgnu-log)))
(progn (cl-defgeneric clgnu-k (x)) 'ok)
(cl-defmethod clgnu-k ((x number)) (list 'num x))
(cl-defmethod clgnu-k ((x integer)) (list 'int (cl-call-next-method (1+ x))))
(list (clgnu-k 3) (clgnu-k 2.5))
(cl-defmethod clgnu-np ((x number)) (list 'num (cl-next-method-p)))
(cl-defmethod clgnu-np ((x integer)) (list 'int (cl-next-method-p) (cl-call-next-method)))
(clgnu-np 1)
(cl-defmethod clgnu-opt ((x integer) &optional y) (list x y))
(list (clgnu-opt 1) (clgnu-opt 1 2))
(cl-defmethod clgnu-e ((x (eql 5))) 'five)
(cl-defmethod clgnu-e (_x) 'other)
(list (clgnu-e 5) (clgnu-e 6))
(cl-defmethod clgnu-hd ((x (head a))) 'head-a)
(cl-defmethod clgnu-hd (_x) 'other)
(list (clgnu-hd '(a 1)) (clgnu-hd '(b 1)))
(cl-defstruct clgnu-sa v)
(cl-defstruct (clgnu-sb (:include clgnu-sa)))
(cl-defmethod clgnu-s ((x clgnu-sa)) 'sa)
(cl-defmethod clgnu-s ((x clgnu-sb)) (list 'sb (cl-call-next-method)))
(list (clgnu-s (make-clgnu-sa)) (clgnu-s (make-clgnu-sb)))
(progn (cl-defgeneric clgnu-na (x)) 'ok)
(cl-defmethod clgnu-na ((x string)) x)
(condition-case e (clgnu-na 1) (cl-no-applicable-method 'noapp) (error (car e)))
(progn (cl-defgeneric clgnu-dd (x) (list 'dflt x)) 'ok)
(clgnu-dd 1)
(cl-defmethod clgnu-n ((_x null)) 'null)
(cl-defmethod clgnu-n ((_x list)) 'list)
(list (clgnu-n nil) (clgnu-n '(1)))
(cl-defmethod clgnu-n ((_x null)) 'null2)
(clgnu-n nil)
(cl-defmethod (setf clgnu-sv) (val (x cons)) (setcar x val))
(let ((c (list 1))) (setf (clgnu-sv c) 9) c)
(cl-defmethod clgnu-mc ((x integer) (y string)) (list 'is x y))
(cl-defmethod clgnu-mc ((x integer) (y integer)) (list 'ii x y))
(list (clgnu-mc 1 "a") (clgnu-mc 1 2))
(cl-defmethod clgnu-ar :around ((x string)) (concat "<" (cl-call-next-method) ">"))
(cl-defmethod clgnu-ar ((x string)) x)
(clgnu-ar "z")
