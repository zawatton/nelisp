;;; stress.el --- GC and error stress for the native completion words  -*- lexical-binding: t; -*-
(defun s1-strs (n) (let (l) (dotimes (k n) (push (format "item-%d-xyz-%s" k (make-string (% k 7) ?a)) l)) (nreverse l)))
(let* ((strs (s1-strs 3000)) (ob (obarray-make)) (ht (make-hash-table :test 'equal)) (sum 0) (cnt 0))
  (dolist (s strs) (intern s ob) (puthash s (length s) ht))
  (dotimes (i 300)
    (let ((a (all-completions "item-1" strs (lambda (s) (> (length s) 14))))
          (b (all-completions "item-2" ob (lambda (s) (symbolp s))))
          (c (all-completions "item-3" ht (lambda (k v) (> v 14))))
          (d (try-completion "item-" strs (lambda (s) (zerop (% (length s) 2)))))
          (e (try-completion "item-4" ob))
          (f (try-completion "ITEM-4" ht)))
      (setq sum (+ sum (length a) (length b) (length c) (length d) (if (stringp e) (length e) 0) (if f 1 0)))
      (when (= (% i 50) 0) (garbage-collect))))
  (princ (format "stress1 %d\n" sum)))
;; predicate that conses heavily (forces GC inside the walk)
(let* ((strs (s1-strs 2000)) (r nil))
  (setq r (all-completions "item-" strs (lambda (s) (let ((l nil)) (dotimes (i 50) (push (make-string 100 ?x) l)) (and l (> (length s) 12))))))
  (princ (format "stress2 %d %S\n" (length r) (car (last r)))))
(let* ((strs (s1-strs 2000)))
  (princ (format "stress3 %S\n" (try-completion "item-1" strs (lambda (s) (let ((l nil)) (dotimes (i 50) (push (make-string 100 ?x) l)) t))))))
;; predicate signals
(princ (format "sig1 %S\n" (condition-case e (all-completions "a" '("ab" "ac") (lambda (s) (error "boom %s" s))) (error e))))
(princ (format "sig2 %S\n" (condition-case e (try-completion "a" '("ab" "ac") (lambda (s) (signal 'wrong-type-argument (list s)))) (error e))))
(princ (format "sig3 %S\n" (catch 'k (all-completions "a" '("ab" "ac") (lambda (s) (throw 'k s))))))
(princ (format "sig4 %S\n" (condition-case e (test-completion "ab" '("ab") (lambda (s) (error "tb"))) (error e))))
;; nested completion inside predicate
(princ (format "nest %S\n" (all-completions "a" '("ab" "ac") (lambda (s) (try-completion "x" '("xy"))))))
;; symbols as keys / uninterned symbols / bytecode predicate
(let ((s (make-symbol "foo")))
  (princ (format "sym1 %S\n" (list (all-completions "fo" (list s 'foo)) (try-completion "f" (list s))))))
(princ (format "pred-sym %S\n" (list (all-completions "a" '("ab") 'stringp) (all-completions "a" '(ab) 'symbolp))))
;; obarray lifecycle
(let ((o (obarray-make)))
  (dotimes (i 2000) (intern (format "s%d" i) o))
  (dotimes (i 1000) (unintern (format "s%d" i) o))
  (let ((n 0)) (mapatoms (lambda (s) (setq n (1+ n))) o) (princ (format "ob-life %d %S %S\n" n (intern-soft "s5" o) (symbol-name (intern-soft "s1500" o)))))
  (garbage-collect)
  (princ (format "ob-hit %S %S\n" (eq (intern "s1500" o) (intern "s1500" o)) (obarrayp o))))
(princ (format "initial %S\n" (list (eq (intern "car" obarray) 'car) (intern-soft "car" obarray) (intern-soft "zz-no-xx" obarray) (obarrayp obarray))))
