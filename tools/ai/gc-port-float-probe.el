;;; gc-port-float-probe.el --- float behaviour probes: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l FILE (GNU) and NELISP --load FILE.  One "NAME => RESULT" line per case.
;; The float representation steps (Doc 216 S5) must leave every line unchanged on NeLisp; lines
;; that differ from GNU are recorded pre-existing differences (missing ldexp/copysign/atan/asin/tan/
;; frexp, (abs -0.0), equal-hash of a list with floats, the static linkage's sin/cos).
(defmacro pf (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

;; arithmetic and comparison
(pf "add" (+ 1.5 2.25))
(pf "add-int" (+ 1 2.5 3))
(pf "sub" (- 10.5 0.25))
(pf "neg" (- 2.5))
(pf "mul" (* 1.5 4 0.5))
(pf "div" (/ 7.0 2))
(pf "div-zero" (/ 1.0 0))
(pf "div-zero-int" (condition-case e (/ 1 0) (arith-error 'arith)))
(pf "mod" (mod 7.5 2))
(pf "1+" (1+ 1.5))
(pf "1-" (1- 1.5))
(pf "abs" (abs -3.5))
(pf "max" (max 1.5 2 0.5))
(pf "min" (min 1.5 2 0.5))
(pf "lt" (list (< 1.5 2) (< 2.5 2) (<= 2.0 2) (>= 2.0 2) (> 3 2.5) (= 2.0 2) (= 0.0 -0.0)))
(pf "chain" (list (< 1.0 2.0 3.0) (< 1.0 3.0 2.0) (= 1.5 1.5 1.5)))
(pf "nan" (let ((n (/ 0.0 0.0))) (list (= n n) (/= n n) (< n 1.0) (isnan n))))
(pf "inf" (list (> 1.0e+INF 1e300) (< -1.0e+INF -1e300) (= 1.0e+INF (* 2 1.0e+INF))))
(pf "float-int-order" (list (< 2 2.5) (< 2.5 3) (= 2 2.0) (< 4611686018427387903 4.611686018427388e18)))
(pf "bignum-float-order" (list (< (ash 1 70) 1.0e30) (> (ash 1 70) 1.0e20) (= (ash 1 62) 4.611686018427388e18)))
;; eq / eql / equal / memq family
(pf "eq-same" (let ((x 1.5)) (eq x x)))
(pf "eql" (list (eql 1.5 1.5) (eql 0.0 -0.0) (eql 1.0 1) (eql 0.0e+NaN 0.0e+NaN)))
(pf "equal" (list (equal 1.5 1.5) (equal 0.0 -0.0) (equal '(1.5 2.5) '(1.5 2.5)) (equal [1.5] [1.5])))
(pf "member" (list (member 2.5 '(1.5 2.5 3.5)) (memql 2.5 '(1.5 2.5 3.5)) (assoc 2.5 '((1.5 . a) (2.5 . b))) (rassoc 1.5 '((a . 1.5)))))
(pf "delete" (delete 2.5 (list 1.5 2.5 3.5 2.5)))
(pf "remove-dup" (delete-dups (list 1.5 2.5 1.5 3.5 2.5)))
;; conversion
(pf "float" (list (float 3) (float 2.5) (float -7)))
(pf "truncate" (list (truncate 2.7) (truncate -2.7) (truncate 7 2) (truncate 7.5 2)))
(pf "floor" (list (floor 2.7) (floor -2.7) (floor 7 2) (floor 7.5 2)))
(pf "ceiling" (list (ceiling 2.2) (ceiling -2.2)))
(pf "round" (list (round 2.5) (round 3.5) (round -2.5) (round 2.4999)))
(pf "ffloor" (list (ffloor 2.7) (fceiling 2.2) (fround 2.5) (ftruncate -2.7)))
(pf "ldexp" (ldexp 0.5 4))
(pf "logb" (logb 8.0))
(pf "copysign" (copysign 1.5 -0.0))
(pf "ash-float" (condition-case e (ash 1.5 1) (wrong-type-argument 'wta)))
;; math
(pf "sqrt" (list (sqrt 16.0) (sqrt 2) (sqrt 0.25)))
(pf "exp-log" (list (exp 0.0) (exp 1) (log 1.0) (log 2.718281828459045)))
(pf "trig" (list (sin 0.0) (cos 0.0) (sin 1.0) (cos 1.0)))
(pf "expt" (list (expt 2.0 10) (expt 2 0.5) (expt 2.5 2) (expt 10 -2)))
(pf "log-base" (list (log 8 2) (log 100 10)))
(pf "atan" (atan 1.0 1.0))
(pf "asin" (list (asin 1.0) (acos 1.0)))
(pf "tan" (tan 0.0))
(pf "abs-neg0" (abs -0.0))
(pf "isnan" (list (isnan (/ 0.0 0.0)) (isnan 1.0)))
;; printing and reading
(pf "prin1" (mapcar #'prin1-to-string '(0.0 -0.0 1.0 1.5 0.1 100.0 1e21 1e-7 123456789.123 1.7976931348623157e308 5e-324 3.141592653589793)))
(pf "number-to-string" (mapcar #'number-to-string '(0.5 -1.25 1e10 12345.678 1.0e+INF -1.0e+INF)))
(pf "format-f" (format "%f %.2f %.0f %10.3f %-8.1f|" 1.5 2.345 2.5 3.14159 2.0))
(pf "format-e" (format "%e %.3e %g %g %g" 12345.678 0.000123 100000.0 1e6 0.0001))
(pf "format-s" (format "%s %S %s" 1.5 2.5 (list 0.5 1.5)))
(pf "format-d" (format "%d %d" 2.7 -2.7))
(pf "read" (list (read "1.5") (read "-2.5e3") (read ".5") (read "1.") (read "1e3") (read "0.1e-2")))
(pf "string-to-number" (list (string-to-number "1.5") (string-to-number "2.5e2") (string-to-number "abc") (string-to-number " 3.25xyz") (string-to-number "1e500")))
(pf "float-time-type" (floatp (float-time)))
(pf "floatp" (list (floatp 1.0) (floatp 1) (numberp 1.5) (integerp 1.5) (natnump 1.5) (zerop 0.0) (zerop -0.0)))
(pf "type-of" (list (type-of 1.5) (cl-typep 1.5 'float)))
;; containers
(pf "list-vec" (let ((v (make-vector 3 1.5))) (aset v 1 2.5) (list v (aref v 0) (aref v 1) (append v nil))))
(pf "cons-cell" (let ((c (cons 1.5 2.5))) (setcar c (+ (car c) 1)) (setcdr c (* (cdr c) 2)) c))
(pf "plist" (let ((pl (list 'a 1.5 'b 2.5))) (plist-put pl 'a 9.5) (list (plist-get pl 'a) (plist-get pl 'b))))
(pf "closure-float" (let ((x 1.5)) (funcall (lambda (y) (+ x y)) 2.5)))
(pf "dolist-sum" (let ((s 0.0)) (dolist (x '(0.5 1.5 2.5)) (setq s (+ s x))) s))
(pf "dotimes-float" (let ((s 0.0)) (dotimes (i 100) (setq s (+ s (* i 0.5)))) s))
(pf "apply-float" (list (apply #'+ '(0.5 1.5)) (apply #'max '(0.5 1.5 1.0)) (mapcar #'1+ '(0.5 1.5))))
(pf "sort-float" (sort (list 3.5 1.5 2.5 -0.5 10.0) #'<))
(pf "sort-mixed" (sort (list 3 1.5 2 -0.5 10) #'<))
(pf "seq-float" (list (seq-uniq '(1.5 2.5 1.5)) (seq-position '(1.5 2.5) 2.5) (cl-position 2.5 '(1.5 2.5)) (cl-find 2.5 '(1.5 2.5))))
(pf "setq-global" (progn (defvar pf--g 1.5) (setq pf--g (+ pf--g 1)) pf--g))
(pf "let-dyn" (progn (defvar pf--d 2.5) (let ((pf--d (* pf--d 2))) pf--d)))
;; hash tables
(pf "hash-eql-key" (let ((h (make-hash-table :test 'eql))) (puthash 1.5 'a h) (puthash 2.5 'b h) (puthash 1.5 'c h) (list (gethash 1.5 h) (gethash 2.5 h) (gethash 3.5 h) (hash-table-count h))))
(pf "hash-equal-key" (let ((h (make-hash-table :test 'equal))) (puthash 1.5 'a h) (puthash '(1.5) 'b h) (list (gethash 1.5 h) (gethash '(1.5) h) (hash-table-count h))))
(pf "hash-value" (let ((h (make-hash-table :test 'equal))) (puthash 'k 1.5 h) (puthash 'k (+ (gethash 'k h) 1) h) (gethash 'k h)))
(pf "sxhash" (list (= (sxhash-eql 1.5) (sxhash-eql 1.5)) (= (sxhash-equal 1.5) (sxhash-equal 1.5)) (= (sxhash-equal 1.5) (sxhash-equal 2.5))))
;; GC with floats live
(pf "gc-floats" (let ((l (mapcar (lambda (i) (* i 0.25)) (number-sequence 1 400)))) (garbage-collect) (list (length l) (apply #'+ l) (car l) (car (last l)))))
(pf "gc-vector-floats" (let ((v (make-vector 300 0.0))) (dotimes (i 300) (aset v i (* i 1.5))) (garbage-collect) (list (aref v 0) (aref v 299) (let ((s 0.0)) (dotimes (i 300) (setq s (+ s (aref v i)))) s))))
(pf "gc-hash-floats" (let ((h (make-hash-table :test 'eql))) (dotimes (i 200) (puthash (* i 0.5) (* i 2.5) h)) (garbage-collect) (list (hash-table-count h) (gethash 10.0 h) (gethash 99.5 h))))
(pf "gc-closure-floats" (let ((fs (mapcar (lambda (i) (let ((k (* i 0.5))) (lambda () k))) (number-sequence 1 100)))) (garbage-collect) (apply #'+ (mapcar #'funcall fs))))
(pf "string-float" (concat "x" (number-to-string 1.5) (format "%s" 2.5)))
;; bytecode / compiled
(pf "bytecomp-float" (progn (defun pf--f (x) (+ (* x 1.5) 0.25)) (list (pf--f 2.0) (pf--f 4))))
(pf "recursion-float" (progn (defun pf--p (n a) (if (= n 0) a (pf--p (1- n) (* a 1.01)))) (pf--p 50 1.0)))
(pf "loop-float" (let ((x 0.0)) (while (< x 5.0) (setq x (+ x 0.75))) x))
(pf "random-float" (let ((r (random 1.0))) (and (floatp r) (>= r 0.0) (< r 1.0))))
(princ "PF-DONE\n")
