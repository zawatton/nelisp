;; Is an alloc-bytes block of SIZE bytes, held only as a Lisp integer in a
;; list, kept alive across GC?  Control: the same block held only through an
;; XOR-masked integer must be reclaimed, or that size's row is blind.
;; A block counts as intact when its first and last words still hold the
;; fixnum marker after GC and same-size churn.
(defvar lp-mask 1229782938247303441)
(defvar lp-int nil)
(defvar lp-xor nil)
(defvar lp-n 4)
(defun lp-make (size m)
  (let ((b (alloc-bytes size 8)))
    (ptr-write-u64 b 0 m) (ptr-write-u64 b (- size 8) m) b))
(defun lp-fill (size)
  (let ((k 0))
    (setq lp-int nil lp-xor nil)
    (while (< k lp-n)
      (setq lp-int (cons (lp-make size (+ 1000 k)) lp-int))
      (setq lp-xor (cons (logxor (lp-make size (+ 2000 k)) lp-mask) lp-xor))
      (setq k (1+ k)))
    nil))
(defun lp-churn (size)
  (let ((k 0) (keep nil))
    (while (< k (* 3 lp-n))
      (let ((b (alloc-bytes size 8)))
        (ptr-write-u64 b 0 99) (ptr-write-u64 b (- size 8) 99) (setq keep (cons b keep)))
      (setq k (1+ k)))
    (setq k 0)
    (while (< k 20000)
      (let ((b (alloc-bytes 32 8))) (ptr-write-u64 b 0 99) (setq keep (cons b keep)))
      (setq k (1+ k)))
    (length keep)))
(defun lp-intact (addrs size base)
  (let ((k (1- lp-n)) (ok 0))
    (dolist (a addrs)
      (if (and (= (ptr-read-u64 a 0) (+ base k)) (= (ptr-read-u64 a (- size 8)) (+ base k)))
          (setq ok (1+ ok)))
      (setq k (1- k)))
    ok))
(defvar lp-blind nil)
(defvar lp-lost nil)
(dolist (size (list 400 4096 65536 (* 1024 1024) (* 16 1024 1024) (* 64 1024 1024)))
  (lp-fill size)
  (garbage-collect)
  (lp-churn size)
  (garbage-collect)
  (lp-churn size)
  (let ((ki (lp-intact lp-int size 1000))
        (kx (lp-intact (mapcar (lambda (x) (logxor x lp-mask)) lp-xor) size 2000)))
    (princ (format "size=%d int-held intact=%d/%d xor-control intact=%d/%d\n" size ki lp-n kx lp-n))
    (if (= kx lp-n) (setq lp-blind (cons size lp-blind)))
    (if (< ki lp-n) (setq lp-lost (cons size lp-lost))))
  (setq lp-int nil lp-xor nil)
  (garbage-collect))
(princ (format "control-blind-sizes=%s\n" (if lp-blind (mapconcat #'number-to-string (nreverse lp-blind) ",") "none")))
(princ (format "int-held-lost-sizes=%s\n" (if lp-lost (mapconcat #'number-to-string (nreverse lp-lost) ",") "none")))
