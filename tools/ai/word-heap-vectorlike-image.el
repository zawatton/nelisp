;;; word-heap-vectorlike-image.el --- S4 typed image edges -*- lexical-binding: t; -*-

(defun whvi-assert (value label)
  (unless value (error "S4 image edge %s" label))
  (setq whvi-count (+ whvi-count 1)))

(defun whvi-frame-arguments (first second expected-first expected-second)
  (garbage-collect)
  (and (eq first expected-first) (eq second expected-second)))

(defun whvi-build ()
  ;; EVAL's lexical argument makes the capture contract explicit on both hosts.
  (setq whvi-state
        (eval
         '(let* ((type (make-symbol "whv-image-type"))
                 (shared (cons 'whv-image-shared (list 17 29)))
                 (vec (vector shared nil nil nil (concat "vector-" "value") -17))
                 (rec (make-record type 2 nil))
                 (other (make-record type 1 shared))
                 (parent (make-char-table 'whvi-parent vec))
                 (table (make-char-table 'whvi-table nil))
                 (pair (cons vec rec))
                 (closure (lambda (argument &optional optional &rest rest)
                            (garbage-collect)
                            (list (eq argument pair)
                                  (eq optional shared)
                                  (eq (car rest) rec)
                                  (eq (aref rec 0) type)
                                  (symbol-name type) (length rest)))))
            (aset vec 1 vec)
            (aset vec 2 rec)
            (aset vec 3 table)
            (aset rec 1 vec)
            (aset rec 2 table)
            (set-char-table-parent table parent)
            (set-char-table-extra-slot table 0 (vector rec vec shared))
            (set-char-table-extra-slot table 1 type)
            (aset table 97 shared)
            (aset table 144470 pair)
            (aset table 200 table)
            (vector type shared vec rec parent table pair closure other))
         t)))

(defun whvi-verify ()
  (setq whvi-count 0)
  (let* ((type (aref whvi-state 0)) (shared (aref whvi-state 1))
         (vec (aref whvi-state 2)) (rec (aref whvi-state 3))
         (parent (aref whvi-state 4)) (table (aref whvi-state 5))
         (pair (aref whvi-state 6)) (closure (aref whvi-state 7))
         (other (aref whvi-state 8))
         (extra (char-table-extra-slot table 0)))
    (whvi-assert (recordp rec) 'record)
    (whvi-assert (vectorp vec) 'vector)
    (whvi-assert (char-table-p table) 'char-table)
    (whvi-assert (consp shared) 'cons)
    (whvi-assert (eq (aref rec 0) type) 'record-type)
    (whvi-assert (eq (aref other 0) type) 'shared-record-type)
    (whvi-assert (eq (aref other 1) shared) 'other-record-child)
    (whvi-assert (eq (aref rec 1) vec) 'record-vector)
    (whvi-assert (eq (aref vec 2) rec) 'vector-record)
    (whvi-assert (eq (aref vec 3) table) 'vector-char-table)
    (whvi-assert (eq (aref vec 1) vec) 'vector-cycle)
    (whvi-assert (eq (aref vec 0) shared) 'vector-shared-cons)
    (whvi-assert (eq (char-table-parent table) parent) 'parent)
    (whvi-assert (eq (aref table 97) shared) 'entry)
    (whvi-assert (eq (aref table 98) vec) 'parent-default)
    (whvi-assert (eq (aref table 144470) pair) 'high-character)
    (whvi-assert (eq (aref table 200) table) 'char-table-cycle)
    (whvi-assert (eq (aref extra 0) rec) 'extra-record)
    (whvi-assert (eq (aref extra 1) vec) 'extra-vector)
    (whvi-assert (eq (aref extra 2) shared) 'extra-cons)
    (whvi-assert (eq (char-table-extra-slot table 1) type) 'extra-type)
    (whvi-assert (eq (car pair) vec) 'cons-vector)
    (whvi-assert (eq (cdr pair) rec) 'cons-record)
    (whvi-assert (equal (aref vec 4) "vector-value") 'string)
    (whvi-assert (= (aref vec 5) -17) 'negative-fixnum)
    (whvi-assert (equal (symbol-name type) "whv-image-type") 'uninterned-name)
    (whvi-assert (equal (apply closure (list pair shared rec 31))
                        '(t t t t "whv-image-type" 2)) 'captured-closure-arguments)
    (whvi-assert (apply #'whvi-frame-arguments (list shared rec shared rec))
                  'active-frame-arguments)
    (whvi-assert (equal (cdr shared) '(17 29)) 'cons-tail)
    (whvi-assert (functionp closure) 'closure-kind)
    (whvi-assert (null (char-table-range table nil)) 'local-default)
    (whvi-assert (= (length whvi-state) 9) 'state-shape))
  (unless (= whvi-count 32) (error "S4 image check count %S" whvi-count))
  whvi-count)

(let ((mode (getenv "WHV_IMAGE_MODE")))
  (unless (equal mode "gnu") (nelisp--debug-switch 28))
  (if (equal mode "restore")
      (progn
        (dotimes (_ 2) (garbage-collect))
        (whvi-verify)
        (princ "WORD-HEAP-VECTORLIKE-IMAGE RESTORE checks=32 PASS\n"))
    (put 'whvi-table 'char-table-extra-slots 2)
    (whvi-build)
    (dotimes (_ 2) (garbage-collect))
    (whvi-verify)
    (if (equal mode "gnu")
        (princ "WORD-HEAP-VECTORLIKE-IMAGE GNU checks=32 PASS\n")
      (unless (> (nelisp--arena-dump-image-stream (getenv "WHV_IMAGE")) 0)
        (error "S4 image dump failed"))
      ;; This repeats every edge after the streaming writer restores live fields.
      (dotimes (_ 2) (garbage-collect))
      (whvi-verify)
      (princ "WORD-HEAP-VECTORLIKE-IMAGE DUMP checks=32 PASS\n")))
  (unless (equal mode "gnu") (nelisp--debug-switch 29)))
(kill-emacs 0)
