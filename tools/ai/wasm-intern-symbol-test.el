;;; wasm-intern-symbol-test.el --- Adapter and schema ERT -*- lexical-binding: t; -*-
(require 'ert)
(defvar wasm-intern-symbol--library-only t)
(require 'wasm-intern-symbol-probe)
(defvar wasm-intern-symbol-test--context nil)
(defun wasm-intern-symbol-test-context ()
  (or wasm-intern-symbol-test--context
      (setq wasm-intern-symbol-test--context (wasm-intern-symbol-context))))
(ert-deftest wasm-intern-symbol/derive-genuine ()
  (let* ((context (wasm-intern-symbol-test-context))
         (genuine (plist-get (plist-get context :record) :init))
         (derived (wasm-intern-symbol-derive genuine)))
    (should (equal (mapcar (lambda (key) (plist-get derived key))
                           '(:total :page :table-size :table-offset :cursor-offset))
                   '(67108864 4096 16777216 832 840)))
    (should (= 1 (cl-count 'alloc-bytes (wasm-target-alloc-calls (list (plist-get derived :adapter))))))
    (should (equal (wasm-target-init--raw-offsets (plist-get derived :adapter)) nil))))
(ert-deftest wasm-intern-symbol/derive-rejects-syntax ()
  (let ((genuine (plist-get (plist-get (wasm-intern-symbol-test-context) :record) :init)))
    (dolist (bad (list (cl-subst 222 9 genuine) (cl-subst 8192 4096 genuine)
                      (cl-subst 'ptr-write-u8 'ptr-write-u64 genuine)
                      (cl-subst 268436304 268436296 genuine)))
      (should-error (wasm-intern-symbol-derive bad)))))
(ert-deftest wasm-intern-symbol/schema-complete ()
  (let* ((c (wasm-intern-symbol-test-context))
         (path "target/wasm-intern-symbol/test-schema.eld"))
    (unwind-protect
        (dolist (omitted '(nil t))
          (wasm-intern-symbol-write path (wasm-intern-symbol-source c omitted))
          (should (wasm-intern-symbol-validate path (plist-get c :contract) (plist-get c :owners)
                                               (plist-get c :closure) (plist-get c :record) omitted)))
      (when (file-exists-p path) (delete-file path)))))
(ert-deftest wasm-intern-symbol/schema-rejects-missing-extra-duplicate ()
  (let* ((c (wasm-intern-symbol-test-context))
         (source (wasm-intern-symbol-source c))
         (path "target/wasm-intern-symbol/test-bad-schema.eld"))
    (unwind-protect
        (dolist (bad (list (cl-remove-if (lambda (form) (eq (and (consp form) (cadr form)) 'nl_intern_hash)) source)
                          (append source '((defun unapproved () 0)))
                          (append source (list (cl-find 'nl_intern_hash (cdr source) :key #'cadr)))) )
          (wasm-intern-symbol-write path bad)
          (should-error (wasm-intern-symbol-validate path (plist-get c :contract) (plist-get c :owners)
                                                    (plist-get c :closure) (plist-get c :record))))
      (when (file-exists-p path) (delete-file path)))))
(ert-deftest wasm-intern-symbol/schema-rejects-adapter-offset-and-constant ()
  (let* ((c (wasm-intern-symbol-test-context))
         (path "target/wasm-intern-symbol/test-bad-adapter.eld"))
    (unwind-protect
        (dolist (pair '((832 . 840) (67108864 . 33554432)))
          (let* ((source (copy-tree (wasm-intern-symbol-source c)))
                 (cell (cl-member 'nl_wasm_intern_region_init (cdr source) :key #'cadr)))
            (setcar cell (cl-subst (cdr pair) (car pair) (car cell)))
            (wasm-intern-symbol-write path source)
            (should-error (wasm-intern-symbol-validate path (plist-get c :contract) (plist-get c :owners)
                                                      (plist-get c :closure) (plist-get c :record)))))
      (when (file-exists-p path) (delete-file path)))))
(ert-deftest wasm-intern-symbol/red-keeps-genuine-init ()
  (let* ((c (wasm-intern-symbol-test-context))
         (red (cdr (wasm-intern-symbol-source c t)))
         (green (cdr (wasm-intern-symbol-source c))))
    (should (equal (cl-find 'nl_intern_region_init red :key #'cadr)
                   (wasm-target-init-rewrite (plist-get (plist-get c :record) :init))))
    (should-not (cl-find 'nl_wasm_intern_region_init red :key #'cadr))
    (should-not (cl-find 'nl_intern_region_init green :key #'cadr))
    (should (cl-find 'nl_wasm_intern_region_init green :key #'cadr))))
(ert-deftest wasm-intern-symbol/extent-consumers ()
  (let* ((record (plist-get (wasm-intern-symbol-test-context) :record))
         (init (plist-get record :init))
         (defs (plist-get record :definitions)))
    (should (wasm-intern-symbol-region-contract init defs))
    (should-error (wasm-intern-symbol-region-contract (cl-subst 33554432 67108864 init) defs)
                  :type 'error)
    (should-error (wasm-intern-symbol-region-contract (cl-subst 8388608 16777216 init) defs))
    (dolist (name '(nl_alloc_symbol_pos nl_intern_probe))
      (let* ((bad (copy-tree defs)) (cell (cl-member name bad :key #'cadr)))
        (setcar cell (cl-subst 524287 1048575 (car cell)))
        (should-error (wasm-intern-symbol-region-contract init bad))))
    (should-error (wasm-intern-symbol-region-contract
                   init (cl-subst 33554432 67108864 defs)))
    (let* ((bad (copy-tree defs)) (cell (cl-member 'nl_intern_probe bad :key #'cadr)))
      (setcar cell (cl-subst 8 16 (car cell)))
      (should-error (wasm-intern-symbol-region-contract init bad)))))
(ert-deftest wasm-intern-symbol/native-success-return ()
  (wasm-intern-symbol-test-context)
  (should (= 1 (alist-get 'init_return
                          (json-read-file "target/wasm-intern-symbol/native-results.json")))))
(provide 'wasm-intern-symbol-test)
