;; -*- lexical-binding: t; -*-
;; S0.1 owner split (Doc 225 §1): wall-clock per call of each internal piece.
;; Run: taskset -c 29-31 BIN --load tools/ai/syntax-rt-split.el (base binary only;
;; the internal names it times are the base runtime's).
(defmacro s0-loop (n form)
  `(let ((t0 (float-time)))
     (dotimes (_ ,n) ,form ,form ,form ,form ,form)
     (- (float-time) t0)))
(defvar s0-empty 0)
(defmacro s0-row (label n form)
  `(let (xs)
     (s0-loop 4 ,form)
     (dotimes (_ 3) (push (/ (* 1e6 (s0-loop ,n ,form)) (* 5 ,n)) xs))
     (princ (format "%-58s %10.2f us\n" ,label (- (nth 1 (sort xs #'<)) s0-empty)))))
(setq s0-empty (let (xs) (dotimes (_ 3) (push (/ (* 1e6 (s0-loop 20000 nil)) (* 5 20000)) xs)) (nth 1 (sort xs #'<))))
(princ (format "%-58s %10.2f us\n" "empty form slot" s0-empty))
(defvar s0-tbl (nelisp--syntax-current-table))
(s0-row "trivial subr (characterp 97)" 4000 (characterp 97))
(s0-row "trivial subr (eq s s)" 4000 (eq "alpha" "alpha"))
(princ "-- char-syntax ?a\n")
(s0-row "(char-syntax 97) total" 1000 (char-syntax 97))
(s0-row "  (nelisp--check-integer 97)" 2000 (nelisp--check-integer 97))
(s0-row "  (nelisp--syntax-current-table)" 2000 (nelisp--syntax-current-table))
(s0-row "  (nelisp--syntax-lookup tbl 97) total" 1000 (nelisp--syntax-lookup s0-tbl 97))
(s0-row "    (nelisp--syntax-default-class 97)" 1000 (nelisp--syntax-default-class 97))
(s0-row "      (nelisp--unicode-range-value ... 97)" 1000 (nelisp--unicode-range-value nelisp--unicode-syntax-ranges 97 3 2))
(princ "-- char-syntax ?(\n")
(s0-row "(char-syntax 40) total" 1000 (char-syntax 40))
(s0-row "  (nelisp--syntax-lookup tbl 40)" 1000 (nelisp--syntax-lookup s0-tbl 40))
(dolist (cf '(t nil))
  (let ((case-fold-search cf))
    (princ (format "-- string-match, case-fold-search=%s\n" cf))
    (s0-row "(string-match \"\\\\sw+\" \"alpha\") total" 20 (string-match "\\sw+" "alpha"))
    (s0-row "  (nlre--compiled-pattern \"\\\\sw+\") hit" 400 (nlre--compiled-pattern "\\sw+"))
    (s0-row "  (nlre--syntax-p ?w 97) per char" 100 (nlre--syntax-p ?w 97))
    (s0-row "(string-match \"alpha\" \"alpha\") total" 100 (string-match "alpha" "alpha"))
    (s0-row "(string-match \"[a-z]+\" \"alpha\") total" 40 (string-match "[a-z]+" "alpha"))
    (s0-row "  (nlre-string-match \"alpha\" \"alpha\")" 100 (nlre-string-match "alpha" "alpha"))
    (s0-row "  (nlre--compiled-pattern \"alpha\") hit" 400 (nlre--compiled-pattern "alpha"))
    (s0-row "  (nlre--current-translate-table)" 400 (nlre--current-translate-table))
    (let ((tt (nlre--current-translate-table)))
      (s0-row "  (nlre--translate-char 65 tt) per char" 400 (nlre--translate-char 65 tt))
      (s0-row "  (nlre--table-char 65 tt) per char" 400 (nlre--table-char 65 tt))
      (s0-row "  (aref tt 65) native translate read" 2000 (aref tt 65)))
    (let ((plan (aref (nlre--compiled-pattern "alpha") 2)) (nlre--fold cf) (nlre--translate-table (and cf (nlre--current-translate-table))))
      (s0-row "  (nlre--literal-plan-match plan \"alpha\" 0 5)" 100 (nlre--literal-plan-match plan "alpha" 0 5)))))
