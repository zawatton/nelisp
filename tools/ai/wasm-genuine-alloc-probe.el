;;; wasm-genuine-alloc-probe.el --- Genuine consumer fixture -*- lexical-binding: t; -*-
(require 'wasm-genuine-alloc)
(defvar wasm-target-alloc--library-only t)
(require 'wasm-target-alloc-probe)

(defun wasm-genuine-alloc-provenance (path mode)
  "Revalidate saved input independently, then reproduce PATH in a clean child."
  (let* ((manifest (json-read-file (concat path ".json")))
         (record (wasm-target-alloc-oracle-record))
         (closure (wasm-target-alloc-closure record))
         (consumers (wasm-genuine-alloc-consumers))
         (authority (wasm-target-alloc-authority))
         (input (alist-get 'compiled_source manifest))
         (recompiled (concat path ".recompiled.wasm")))
    (unless (and (equal (alist-get 'genuine_alloc manifest) (if mode t :json-false))
                 (equal (alist-get 'consumers manifest) (wasm-target-alloc-definition-rows consumers))
                 (equal (alist-get 'closure manifest) (wasm-target-alloc-definition-rows closure))
                 (equal (alist-get 'composed_closure manifest)
                        (wasm-target-alloc-definition-rows
                         (wasm-target-alloc-closure record wasm-target-alloc-adapters)))
                 (equal (alist-get 'raw_reservation manifest) "nl_wasm_arena_init:one-alloc-bytes")
                 (equal (alist-get 'raw_reservers manifest) ["nl_wasm_arena_init"]))
      (error "Genuine allocator manifest contract mismatch"))
    (wasm-genuine-alloc-validate (alist-get 'path input) (wasm-target-init-contract)
                               (plist-get authority :owners) closure consumers)
    (unless (and (equal (alist-get 'sha256 input) (wasm-rootstack--hash (alist-get 'path input)))
                 (equal (alist-get 'wasm_sha256 manifest) (wasm-rootstack--hash path)))
      (error "Genuine allocator artifact identity mismatch"))
    (let ((compilation (wasm-genuine-alloc-compile-file (alist-get 'path input) recompiled mode)))
      (unless (and (equal (plist-get compilation :genuine-alloc) mode)
                   (equal (plist-get compilation :raw-reservers) '(nl_wasm_arena_init))
                   (equal (alist-get 'compiler_installation_root manifest) (plist-get compilation :installation-root))
                   (equal (alist-get 'compiler_files manifest)
                          (vconcat (mapcar (lambda (row) (vector (file-relative-name (car row) wasm-rootstack--root) (cdr row)))
                                          (plist-get compilation :files))))
                   (equal (wasm-rootstack--hash path) (wasm-rootstack--hash recompiled)))
        (error "Genuine allocator compiler reproduction mismatch")))
    (princ (format "consumer-provenance=%s mode=%s\n" (wasm-rootstack--hash path) mode))))

(defun wasm-genuine-alloc-build (mode path)
  "Compose the same source in default or genuine MODE, saved at PATH."
  (let* ((record (wasm-target-alloc-oracle-record))
         (closure (wasm-target-alloc-closure record))
         (adapted (wasm-target-alloc-closure record wasm-target-alloc-adapters))
         (consumers (wasm-genuine-alloc-consumers))
         (contract (wasm-target-init-contract))
         (authority (wasm-target-alloc-authority))
         (owners (plist-get authority :owners))
         (source (append (wasm-target-alloc-source contract owners (wasm-target-init-rewrite adapted)) consumers))
         (print-length nil) (print-level nil) (print-circle nil))
    (make-directory (file-name-directory path) t)
    (with-temp-file (concat path ".source.eld") (prin1 source (current-buffer)))
    (wasm-genuine-alloc-validate (concat path ".source.eld") contract owners closure consumers)
    (let ((compilation (wasm-genuine-alloc-compile-file (concat path ".source.eld") path mode)))
      (wasm-target-alloc-manifest path source owners closure adapted record authority compilation))
    (let* ((manifest (json-read-file (concat path ".json")))
           (files '("lisp/nelisp-cc-nlconsbox-alloc.el" "lisp/nelisp-cc-nlvector-alloc.el"
                    "tools/ai/wasm-genuine-alloc.el" "tools/ai/wasm-genuine-alloc-probe.el"
                    "tools/ai/wasm-genuine-alloc-check.mjs")))
      (setf (alist-get 'genuine_alloc manifest) (if mode t :json-false)
            (alist-get 'raw_reservation manifest) "nl_wasm_arena_init:one-alloc-bytes"
            (alist-get 'raw_reservers manifest) ["nl_wasm_arena_init"]
            (alist-get 'consumers manifest) (wasm-target-alloc-definition-rows consumers)
            (alist-get 'symbol_exclusion manifest)
            "nl_alloc_symbol reaches nl_intern_probe/nl_intern_insert and the intern-region at arena+832; outside the one-chunk allocator/arena surface."
            (alist-get 'source_sha256 manifest)
            (vconcat (append (alist-get 'source_sha256 manifest)
                             (mapcar (lambda (file) (vector file (wasm-rootstack--hash file))) files))))
      (with-temp-file (concat path ".json") (insert (json-encode manifest))))
    (wasm-genuine-alloc-provenance path mode)
    (princ (format "consumer-module=%s consumers=%d mode=%s\n" path (length consumers) mode))))
(unless (bound-and-true-p wasm-genuine-alloc--library-only)
  (condition-case err
      (wasm-genuine-alloc-build t "target/wasm-genuine-alloc/green.wasm")
    (error (let ((print-length nil) (print-level nil))
             (princ (format "genuine-alloc-diagnostic=%S\n" err)))
           (kill-emacs 1))))
(provide 'wasm-genuine-alloc-probe)
