;;; corpus-json.el --- json.el differential corpus (S2.5)  -*- lexical-binding: t; -*-
;; Run with tools/ai/cl-gnu/run-corpus.el; expected output is GNU 31.1's.
(progn (require 'json) (featurep 'json))
(json-encode nil)
(json-encode t)
(json-encode :json-false)
(json-encode 0)
(json-encode -42)
(json-encode 1.5)
(json-encode "plain")
(json-encode "quote\" back\\ nl\n tab\t cr\r")
(json-encode "éあ")
(json-encode "\x01\x1f")
(json-encode [1 2 3])
(json-encode [])
(json-encode '(1 2 3))
(json-encode '((a . 1) (b . "two") (c . [3])))
(json-encode '(:a 1 :b 2))
(json-encode '((nested . ((x . 1) (y . nil)))))
(let ((h (make-hash-table :test 'equal)))
  (puthash "k1" 1 h) (puthash "k2" [t :json-false] h)
  (json-encode h))
(json-encode 'sym)
(json-encode :kw)
(let ((json-encoding-pretty-print t)) (split-string (json-encode '((a . 1) (b . [1 2]))) "\n"))
(let ((json-encoding-pretty-print t)) (split-string (json-encode '((a . ((b . 2))))) "\n"))
(json-encode-string "x/y")
(json-encode (list (cons "s" 1)))
(json-read-from-string "null")
(json-read-from-string "true")
(json-read-from-string "false")
(json-read-from-string "123")
(json-read-from-string "-1.25e2")
(json-read-from-string "\"a\\u00e9\\n\\\"b\"")
(json-read-from-string "\"\\ud83d\\ude00\"")
(json-read-from-string "[1, 2, [3, 4]]")
(json-read-from-string "[]")
(json-read-from-string "{}")
(json-read-from-string "{\"a\": 1, \"b\": [true, false, null]}")
(json-read-from-string "{\"a\": {\"b\": {\"c\": \"d\"}}}")
(let ((json-object-type 'plist)) (json-read-from-string "{\"a\": 1, \"b\": 2}"))
(let ((json-object-type 'hash-table))
  (let ((h (json-read-from-string "{\"a\": 1, \"b\": 2}")))
    (list (hash-table-count h) (gethash "a" h) (gethash "b" h))))
(let ((json-array-type 'list)) (json-read-from-string "[1, [2, 3]]"))
(let ((json-key-type 'string)) (json-read-from-string "{\"a\": 1}"))
(let ((json-key-type 'keyword)) (json-read-from-string "{\"a\": 1}"))
(let ((json-false 'no) (json-null 'nothing)) (json-read-from-string "[false, null]"))
(json-read-from-string "  \n {\"sp\" :  [ 1 ,2 ] } ")
(json-read-from-string "{\"a\": 1,}")
(json-read-from-string "[1 2]")
(json-read-from-string "\"unterminated")
(json-read-from-string "")
(json-read-from-string "nul")
(json-encode (json-read-from-string "{\"r\": [1, 2.5, \"x\", {\"y\": null}]}"))
(with-temp-buffer (insert "[1, 2] tail") (goto-char (point-min)) (list (json-read) (point)))
(json-alist-p '((a . 1)))
(json-plist-p '(:a 1))
;;; corpus-json.el ends here
