;;; src.el --- varaccess variable-semantics functions -*- lexical-binding: t; -*-
(defvar va-sp 10)
(defvar va-sp2 'init)
(defvar va-bl 100)
(make-variable-buffer-local 'va-bl)
(defvar va-pl 1)
(defvar va-un)
(defvar va-w 0)
(defun va-id (x) x)
(defun va-read () va-sp)
(defun va-setq (v) (setq va-sp v) va-sp)
(defun va-let (v) (let ((va-sp v)) (list va-sp (va-read))))
(defun va-let2 (a b) (let ((va-sp a) (va-sp2 b)) (list va-sp va-sp2 (va-read))))
(defun va-lets (a) (let* ((va-sp a) (va-sp2 (list va-sp))) (list va-sp va-sp2)))
(defun va-nested (n) (if (= n 0) va-sp (let ((va-sp (+ va-sp 1))) (va-nested (1- n)))))
(defun va-let-err () (condition-case e (let ((va-sp 99)) (error "boom")) (error (list e va-sp))))
(defun va-let-throw () (list (catch 'k (let ((va-sp 77)) (throw 'k va-sp))) va-sp))
(defun va-eqsym (x) (list (eq x 'foo) (eq 'foo x) (eq x nil) (eq x t) (eq x 3) (eq x 'bar)))
(defun va-bl-read () va-bl)
(defun va-bl-set (v) (setq va-bl v))
(defun va-bl-let (v) (let ((va-bl v)) (list va-bl (va-bl-read))))
(defun va-bl-void () (condition-case e va-un (error e)))
(defun va-loop (n) (let ((i 0) (a nil)) (while (< i n) (setq a va-sp) (setq va-sp i) (setq i (1+ i))) (list a va-sp)))
(defun va-bl-loop (n) (let ((i 0) (a nil)) (while (< i n) (setq a va-bl) (setq va-bl i) (setq i (1+ i))) (list a va-bl)))
(defun va-eq-loop (n f) (let ((i 0) (a nil)) (while (< i n) (setq a (eq f 'foo)) (setq i (1+ i))) a))
(defun va-bl-letset (v) (let ((va-bl v)) (setq va-bl (list v)) (list va-bl (va-bl-read))))
(defun va-bl-set-list (v) (setq va-bl (list v v)) va-bl)
(defun va-fwd-set (v) (setq fill-column v))
(defun va-fwd-read () fill-column)
(defun va-wlocal (v) (setq va-wl v))
(defvar va-wl 1)
(make-variable-buffer-local 'va-wl)
(defun va-eqpos (x) (list (eq x 'foo) (eq 'foo x) (eq x x) (eq x (bare-symbol x)) (eq (bare-symbol x) x)))
(defun va-eqpos2 (x y) (list (eq x y) (eq y x)))
(defun va-eqpos-loop (n x) (let ((i 0) (a nil)) (while (< i n) (setq a (eq x 'foo)) (setq i (1+ i))) a))
