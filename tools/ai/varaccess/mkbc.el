;; emacs -Q --batch -l mkbc.el : GNU-compiled byte code of src.el as literal definitions (bc.el).
(require 'bytecomp)
(let ((names '(va-id va-read va-setq va-let va-let2 va-lets va-nested va-let-err va-let-throw va-eqsym va-bl-read va-bl-set
               va-bl-let va-bl-void va-loop va-bl-loop va-eq-loop va-bl-letset va-bl-set-list va-fwd-set va-fwd-read va-wlocal va-eqpos va-eqpos2 va-eqpos-loop)))
  (load (expand-file-name "src.el") nil t)
  (let ((defs (mapcar (lambda (f) (cons f (byte-compile f))) names)))
    (with-temp-file "bc.el"
      (insert ";;; bc.el --- generated by mkbc.el from src.el (GNU 31.1) -*- lexical-binding: t; -*-\n")
      (insert "(defvar va-sp 10)\n(defvar va-sp2 'init)\n(defvar va-bl 100)\n(make-variable-buffer-local 'va-bl)\n(defvar va-pl 1)\n(defvar va-un)\n(defvar va-w 0)\n(defvar va-wl 1)\n(make-variable-buffer-local (quote va-wl))\n")
      (let ((print-escape-newlines t) (print-escape-nonascii t) (print-escape-control-characters t) (print-circle t) (print-length nil) (print-level nil))
        (dolist (p defs) (insert (format "(defalias '%s %s)\n" (car p) (prin1-to-string (cdr p)))))))))
