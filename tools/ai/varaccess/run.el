;;; run.el --- varaccess variable-semantics parity corpus: same output on GNU 31.1 and NeLisp -*- lexical-binding: t; -*-
(let ((d (file-name-directory (or load-file-name buffer-file-name))))
  (load (expand-file-name (if (equal (getenv "VA_FLAV") "bc") "bc.el" "src.el") d) nil t))
(defmacro va-case (name form)
  `(princ (format "%s %S\n" ',name (condition-case err ,form (error (list 'ERROR err))))))
(defun va-rep (f &rest args) (let ((r nil) (i 0)) (while (< i 40) (setq r (apply f args)) (setq i (1+ i))) r))
(va-case read (va-rep 'va-read))
(va-case setq (list (va-rep 'va-setq 5) va-sp))
(va-case let (list (va-rep 'va-let 7) va-sp))
(va-case let2 (list (va-rep 'va-let2 1 2) va-sp va-sp2))
(va-case lets (list (va-rep 'va-lets 3) va-sp va-sp2))
(va-case nested (list (va-rep 'va-nested 5) va-sp))
(va-case let-err (list (va-rep 'va-let-err) va-sp))
(va-case let-throw (list (va-rep 'va-let-throw) va-sp))
(va-case eqsym (list (va-rep 'va-eqsym 'foo) (va-rep 'va-eqsym 'bar) (va-rep 'va-eqsym nil) (va-rep 'va-eqsym t) (va-rep 'va-eqsym 3)
                     (va-rep 'va-eqsym "foo") (va-rep 'va-eqsym (lambda (x) x)) (va-rep 'va-eqsym '(foo)) (va-rep 'va-eqsym [foo])
                     (va-rep 'va-eqsym (make-symbol "foo")) (va-rep 'va-eqsym (symbol-function 'va-id))))
(va-case eq-loop (list (va-eq-loop 50 'foo) (va-eq-loop 50 (lambda (x) x)) (va-eq-loop 50 (symbol-function 'car))))
;; buffer-local semantics
(va-case bl-default (list (va-rep 'va-bl-read) (default-value 'va-bl)))
(with-temp-buffer
  (rename-buffer "va-b1")
  (va-case bl-set (list (va-rep 'va-bl-set 5) va-bl (default-value 'va-bl) (local-variable-p 'va-bl)))
  (va-case bl-read (va-rep 'va-bl-read))
  (va-case bl-let (list (va-rep 'va-bl-let 8) va-bl (default-value 'va-bl)))
  (va-case bl-loop (list (va-bl-loop 20) va-bl (default-value 'va-bl)))
  (let ((other (generate-new-buffer "va-b2")))
    (va-case bl-let-other
      (list (let ((va-bl 11))
              (list va-bl (with-current-buffer other (list va-bl (va-rep 'va-bl-read) (local-variable-p 'va-bl)))))
            va-bl (with-current-buffer other va-bl)))
    (va-case bl-let-default
      (list (let ((v (default-value 'va-bl)))
              (setq-default va-bl 200)
              (prog1 (list (va-rep 'va-bl-read) (with-current-buffer other (va-rep 'va-bl-read)) (default-value 'va-bl))
                (setq-default va-bl v)))))
    (va-case kill-local
      (list (progn (kill-local-variable 'va-bl) (list va-bl (local-variable-p 'va-bl) (va-rep 'va-bl-read)))
            (progn (setq va-bl 33) (list va-bl (local-variable-p 'va-bl)))
            (with-current-buffer other (progn (setq va-bl 44) (list (va-rep 'va-bl-read) (default-value 'va-bl))))
            (list (va-rep 'va-bl-read))))
    (va-case set-buffer-switch
      (let ((r nil))
        (dotimes (i 6)
          (push (list (va-rep 'va-bl-read) (with-current-buffer other (va-rep 'va-bl-read))) r))
        r))
    (va-case kill-buffer-local
      (progn (with-current-buffer other (kill-local-variable 'va-bl))
             (list (with-current-buffer other (va-rep 'va-bl-read)) (va-rep 'va-bl-read))))
    (kill-buffer other)))
(with-temp-buffer
  (va-case bl-letset (list (let ((r nil)) (dotimes (i 5) (setq r (va-bl-letset i))) r) va-bl (local-variable-p 'va-bl)))
  (va-case bl-auto-create (list (local-variable-p 'va-bl) (va-bl-set-list 4) (local-variable-p 'va-bl) (va-bl-read) (default-value 'va-bl)))
  (va-case bl-set-after (list (va-bl-set-list 5) (va-bl-set-list 6) va-bl (default-value 'va-bl)))
  (va-case bl-letset2 (list (va-bl-letset 9) va-bl))
  (va-case fwd (list (va-fwd-read) (progn (setq-local fill-column 33) (va-fwd-read)) (va-rep 'va-fwd-set 71) (va-fwd-read)
                     (default-value 'fill-column)))
  ;; Known pre-existing divergence (v34 too): (setq fill-column 'x) in a buffer with a local binding does not
  ;; signal wrong-type-argument; not part of this corpus.
  (let ((o (generate-new-buffer "va-b3")))
    (va-case fwd-other (list (with-current-buffer o (va-fwd-read)) (va-fwd-read) (progn (kill-local-variable 'fill-column) (va-fwd-read))))
    (kill-buffer o))
  (va-case watcher-local
    (let* ((log nil) (w (lambda (s n o wh) (push (list s n o (and wh t)) log))))
      (add-variable-watcher 'va-wl w)
      (setq-local va-wl 2)
      (va-wlocal 3) (va-wlocal 4)
      (remove-variable-watcher 'va-wl w)
      (va-wlocal 5)
      (list (nreverse log) va-wl))))
(dolist (enabled '(nil t))
  (setq symbols-with-pos-enabled enabled)
  (let ((p (position-symbol 'foo 5)) (q (position-symbol 'bar 7)))
    (va-case eqpos (list enabled (symbol-with-pos-p p) (va-rep 'va-eqpos p) (va-rep 'va-eqpos 'foo) (va-rep 'va-eqpos2 p 'foo)
                         (va-rep 'va-eqpos2 'foo p) (va-rep 'va-eqpos2 p q) (va-rep 'va-eqpos2 p p) (va-rep 'va-eqpos2 p (lambda (x) x))
                         (va-rep 'va-eqpos2 p "foo") (va-rep 'va-eqpos2 p (position-symbol 'foo 9))))
    (va-case eqpos-loop (list enabled (va-eqpos-loop 50 p) (va-eqpos-loop 50 'foo) (va-eqpos-loop 50 q)))
    (va-case eqpos-misc (list enabled (memq p '(a foo)) (memq 'foo (list p)) (assq p '((foo . 1))) (assq 'foo (list (cons p 1)))
                              ;; pre-existing divergence (v34 too), not in corpus: eq hash lookup of a symbol-with-pos
                              (delq p (list 'foo 'bar)) (sort (list p 'a) (lambda (a b) (eq a b)))))))
(setq symbols-with-pos-enabled nil)
(va-case makunbound (progn (setq va-pl 5) (makunbound 'va-pl) (list (boundp 'va-pl) (condition-case e (symbol-value 'va-pl) (error e)))))
(va-case void-ref (va-rep 'va-bl-void))
(va-case void-let (progn (defvar va-w2) (list (let ((va-w2 9)) (symbol-value 'va-w2)) (boundp 'va-w2))))
(va-case setq-default (progn (setq-default va-sp 55) (list (va-rep 'va-read) (default-value 'va-sp))))
(va-case local-var-let-unbound (let ((va-un 3)) (list (va-rep 'va-read) va-un)))
(va-case watcher
  (let ((log nil))
    (add-variable-watcher 'va-sp (lambda (s n o w) (push (list s n o (and w t)) log)))
    (va-setq 61) (va-let 62) (let ((va-sp 63)) nil)
    (nreverse log)))
(va-case watcher-removed (progn (dolist (w (get-variable-watchers 'va-sp)) (remove-variable-watcher 'va-sp w)) (va-setq 64) (list va-sp (get-variable-watchers 'va-sp))))
(va-case sym-set (progn (set 'va-sp 7) (list va-sp (symbol-value 'va-sp) (va-rep 'va-read))))
(va-case const-err (list (condition-case e (eval (quote (setq nil 1))) (error (car e))) (condition-case e (eval (quote (let ((t 1)) 1))) (error (car e)))))
(kill-emacs 0)
