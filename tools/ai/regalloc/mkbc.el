;; -*- lexical-binding: t; -*-
;; mkbc.el --- write GNU-compiled byte code of src.el as literal definitions (bc.el).
;; Run from this directory: emacs -Q --batch -l mkbc.el
(require 'bytecomp)
(let ((lexical-binding t)) (load (expand-file-name "src.el") nil t))
(with-temp-file "bc.el"
  (insert ";;; bc.el --- generated by mkbc.el from src.el (GNU 31.1) -*- lexical-binding: t; -*-\n")
  (let ((print-escape-newlines t) (print-escape-nonascii t) (print-escape-control-characters t) (print-circle t) (print-length nil) (print-level nil))
    (dolist (f '(ra-sum ra-plus ra-lss ra-add1 ra-sub ra-deep ra-switch ra-mix ra-stack ra-memq-loop ra-aref-loop ra-gc))
      (insert (format "(defalias '%s %s)\n" f (prin1-to-string (byte-compile f)))))))
