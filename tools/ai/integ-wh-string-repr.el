;;; integ-wh-string-repr.el --- string representation across conversions and writes  -*- lexical-binding: t; -*-

;; Run with `-l' on NeLisp and on GNU Emacs 31.1; both must print the same bytes.  Every case prints the
;; representation (multibyte-p, length, string-bytes) and the characters of the result.  The canonical header
;; owns a string's representation (size, size_byte); code that wrote a legacy view's tag byte instead of the header
;; (the reader's token copy, the read-file primitive) left a unibyte view over a multibyte header, so these cases
;; cover the producers and mutators: conversions, coding functions, constructors, aset, clear-string, concat.

(defun iwh-sr (tag s)
  (princ (format "SR %-30s mb=%S len=%S bytes=%S %S\n" tag (multibyte-string-p s) (length s) (string-bytes s)
                 (append s nil))))
(defmacro iwh-srs (tag form)
  `(condition-case e (iwh-sr ,tag ,form) (error (princ (format "SR %-30s SIGNAL %S\n" ,tag (car e))))))
(defvar iwh-hi (unibyte-string 200 135 65))
(defvar iwh-slot nil)
(iwh-srs "string-to-unibyte ascii" (string-to-unibyte "abc"))
(iwh-srs "string-to-unibyte raw" (string-to-unibyte (string-to-multibyte iwh-hi)))
(iwh-srs "string-as-unibyte utf8" (string-as-unibyte "\u00e9\u65e5"))
(iwh-srs "string-as-unibyte unibyte" (string-as-unibyte iwh-hi))
(iwh-srs "string-to-multibyte uni" (string-to-multibyte iwh-hi))
(iwh-srs "string-to-multibyte ascii" (string-to-multibyte "abc"))
(iwh-srs "string-as-multibyte utf8" (string-as-multibyte (unibyte-string 195 169 65)))
(iwh-srs "string-as-multibyte raw" (string-as-multibyte (unibyte-string 200 65)))
(iwh-srs "string-make-multibyte" (string-make-multibyte (unibyte-string 233 97)))
(iwh-srs "unibyte-string" (unibyte-string 192 135))
(iwh-srs "unibyte-string ascii" (unibyte-string 97 98))
(iwh-srs "make-string ascii" (make-string 3 ?a))
(iwh-srs "make-string 200" (make-string 3 200))
(iwh-srs "make-string ascii multibyte" (make-string 3 ?a t))
(iwh-srs "make-string wide" (make-string 2 #x65e5))
(iwh-srs "encode utf-8" (encode-coding-string "\u00e9\u65e5" 'utf-8))
(iwh-srs "encode ascii" (encode-coding-string "abc" 'utf-8))
(iwh-srs "decode utf-8" (decode-coding-string (unibyte-string 195 169 230 151 165) 'utf-8))
(iwh-srs "decode ascii" (decode-coding-string "abc" 'utf-8))
(iwh-srs "decode invalid" (decode-coding-string (unibyte-string 200 201 65) 'utf-8))
(iwh-srs "char-to-string 200" (char-to-string 200))
(iwh-srs "char-to-string wide" (char-to-string #x65e5))
(iwh-srs "concat uni+multi" (concat (unibyte-string 200) "\u00e9"))
(iwh-srs "concat uni+ascii" (concat (unibyte-string 200) "a"))
(iwh-srs "concat uni+uni" (concat (unibyte-string 192) (unibyte-string 135)))
(iwh-srs "concat ascii+multi" (concat "a" "\u00e9"))
(iwh-srs "substring uni" (substring iwh-hi 1 3))
(iwh-srs "substring multi" (substring "\u00e9\u65e5a" 1 3))
(iwh-srs "copy-sequence uni" (copy-sequence iwh-hi))
(iwh-srs "copy-sequence multi" (copy-sequence "\u00e9a"))
(iwh-srs "aset uni high" (let ((s (copy-sequence (unibyte-string 97 98)))) (aset s 0 200) s))
(iwh-srs "aset uni wide" (let ((s (copy-sequence (unibyte-string 97 98)))) (aset s 0 #x65e5) s))
(iwh-srs "aset multi" (let ((s (copy-sequence "\u00e9a"))) (aset s 1 #x65e5) s))
(iwh-srs "aset multi ascii" (let ((s (copy-sequence "\u00e9a"))) (aset s 0 ?z) s))
(iwh-srs "clear-string uni" (let ((s (copy-sequence iwh-hi))) (clear-string s) s))
(iwh-srs "clear-string multi" (let ((s (copy-sequence "\u00e9a\u65e5"))) (clear-string s) s))
(iwh-srs "format uni" (format "%s" iwh-hi))
(iwh-srs "format char 200" (format "%c" 200))
(iwh-srs "format multi" (format "%s-%s" "\u00e9" iwh-hi))
(iwh-srs "prin1 uni high" (prin1-to-string iwh-hi))
(iwh-srs "read raw escape" (car (read-from-string "\"\\310\\207A\"")))
(iwh-srs "read hex escape" (car (read-from-string "\"\\xc8\\x87\"")))
(iwh-srs "read utf8" (car (read-from-string "\"\u00e9\u65e5\"")))
(iwh-srs "read mixed u+raw" (car (read-from-string "\"\\u00e9\"")))
(iwh-srs "upcase uni" (upcase (unibyte-string 97 233)))
(iwh-srs "downcase multi" (downcase "\u00c9A"))
(iwh-srs "string-trim" (string-trim (concat " " iwh-hi " ")))
(iwh-srs "split-string uni" (car (split-string (concat iwh-hi ",x") ",")))
(iwh-srs "mapconcat" (mapconcat #'identity (list iwh-hi "\u00e9") "-"))
(iwh-srs "symbol-name hi" (symbol-name (intern (unibyte-string 97 200 135))))
(iwh-srs "number-to-string" (number-to-string 1234))
(iwh-srs "string-pad" (string-pad iwh-hi 5))

;; The same strings stored in containers and read back: a representation flag kept only in a view is lost when the
;; value is cloned into a cons car, a vector slot, a hash value, a symbol value, a closure or an argument list.
(defvar iwh-ma (string-to-multibyte "abc"))
(defvar iwh-mw "\u00e9\u65e5")
(dolist (cell (list (cons "ascii-multibyte" iwh-ma) (cons "unibyte-high" iwh-hi) (cons "multibyte-wide" iwh-mw)))
  (let ((tag (car cell)) (v (cdr cell)))
    (iwh-srs (concat "cons car " tag) (car (list v)))
    (iwh-srs (concat "cons cdr " tag) (cdr (cons 1 v)))
    (iwh-srs (concat "vector " tag) (aref (vector v) 0))
    (iwh-srs (concat "hash value " tag) (let ((h (make-hash-table :test 'equal))) (puthash 'k v h) (gethash 'k h)))
    (iwh-srs (concat "setq global " tag) (progn (setq iwh-slot v) iwh-slot))
    (iwh-srs (concat "closure " tag) (funcall (let ((x v)) (lambda () x))))
    (iwh-srs (concat "apply " tag) (apply #'identity (list v)))
    (iwh-srs (concat "mapcar " tag) (car (mapcar #'identity (list v))))
    (iwh-srs (concat "copy-tree " tag) (car (copy-tree (list v))))
    (iwh-srs (concat "nreverse " tag) (car (nreverse (list 1 v))))
    (iwh-srs (concat "plist " tag) (plist-get (list :a v) :a))
    (iwh-srs (concat "alist " tag) (cdr (assq 'k (list (cons 'k v)))))
    (iwh-srs (concat "put/get " tag) (progn (put 'iwh-sym 'p v) (get 'iwh-sym 'p)))))
;; Left out because they differ from GNU in the same way on batch F (not in the family of this file): the multibyteness of
;; `with-output-to-string' and `buffer-string' results for ASCII text, of `insert' of raw bytes into a multibyte buffer and of
;; non-ASCII into a unibyte one, of `reverse' of an ASCII multibyte string, `base64-encode-string' of a multibyte non-ASCII
;; string (GNU signals), and the functions the bare runtime does not define: truncate-string-to-width, subst-char-in-string,
;; fillarray and store-substring on strings, md5, base64url-encode-string, string-width.
;; Flows that must keep the representation of ASCII-only content (the allocator's byte pattern alone would
;; call it unibyte), in-place mutators, and consumers that branch on multibyte-string-p.
(defun iwh-srv (tag v)
  (princ (if (stringp v)
             (format "SV %-30s mb=%S len=%S bytes=%S %S\n" tag (multibyte-string-p v) (length v) (string-bytes v) (append v nil))
           (format "SV %-30s %S\n" tag v))))
(defmacro iwh-srvs (tag form)
  `(condition-case e (iwh-srv ,tag ,form) (error (princ (format "SV %-30s SIGNAL %S\n" ,tag (car e))))))
(let ((m (string-to-multibyte "abc")) (u (unibyte-string 97 98 99)) (mm (string-to-multibyte "Ab c")))
  (iwh-srvs "concat mb+ascii" (concat m "x"))
  (iwh-srvs "concat ascii+mb" (concat "x" m))
  (iwh-srvs "concat mb alone" (concat m))
  (iwh-srvs "substring mb ascii" (substring m 1))
  (iwh-srvs "substring mb whole" (substring m 0))
  (iwh-srvs "format %s mb" (format "%s" m))
  (iwh-srvs "format mb fmt" (format (string-to-multibyte "x%d") 1))
  (iwh-srvs "format ascii" (format "x%d" 1))
  (iwh-srvs "upcase mb" (upcase m))
  (iwh-srvs "downcase mb" (downcase mm))
  (iwh-srvs "capitalize mb" (capitalize mm))
  (iwh-srvs "upcase-initials mb" (upcase-initials mm))
  (iwh-srvs "copy-sequence mb" (copy-sequence m))
  (iwh-srvs "mapconcat mb" (mapconcat #'identity (list m "z") ""))
  (iwh-srvs "string-join mb" (string-join (list m "z") "-"))
  (iwh-srvs "replace-regexp mb" (replace-regexp-in-string "b" "X" m))
  (iwh-srvs "replace-regexp ascii" (replace-regexp-in-string "b" "X" "abc"))
  (iwh-srvs "string-replace mb" (string-replace "b" "X" m))
  (iwh-srvs "string-trim mb" (string-trim (concat " " m " ")))
  (iwh-srvs "split-string mb" (car (split-string (concat m ",z") ",")))
  (iwh-srvs "prin1 mb" (prin1-to-string m))
  (iwh-srvs "prin1 ascii" (prin1-to-string "abc"))
  (iwh-srvs "intern mb name" (symbol-name (intern m)))
  (iwh-srvs "buffer-string mb" (with-temp-buffer (insert m) (buffer-string)))
  (iwh-srvs "buffer-substring mb" (with-temp-buffer (insert m) (buffer-substring 1 3)))
  (iwh-srvs "buffer-string unibyte buf" (with-temp-buffer (set-buffer-multibyte nil) (insert u) (buffer-string)))
  (iwh-srvs "insert hi into unibyte buf" (with-temp-buffer (set-buffer-multibyte nil) (insert iwh-hi) (buffer-string)))
  (iwh-srvs "reverse hi" (reverse iwh-hi))
  (iwh-srvs "nreverse hi" (nreverse (copy-sequence iwh-hi)))
  (iwh-srvs "apply string" (apply #'string (append m nil)))
  (iwh-srvs "string 200" (string 200 201))
  (iwh-srvs "string wide" (string #x65e5 97))
  (iwh-srvs "vconcat" (vconcat iwh-hi))
  (iwh-srvs "string-to-list hi" (string-to-list iwh-hi))
  (iwh-srvs "regexp-quote mb" (regexp-quote m))
  (iwh-srvs "string-pad mb" (string-pad m 5))
  (iwh-srvs "number-to-string" (number-to-string 12))
  (iwh-srvs "symbol-name" (symbol-name 'abc))
  (iwh-srvs "format-message" (format-message "x%sy" "abc"))
  (iwh-srvs "string-to-multibyte hi" (string-to-multibyte iwh-hi))
  (iwh-srvs "char-to-string ascii" (char-to-string ?a))
  (iwh-srvs "make-string mb flag" (make-string 2 ?b t))
  (iwh-srvs "string-trim-left uni" (string-trim-left (concat "  " iwh-hi)))
  (iwh-srvs "format %c wide" (format "%c" #x65e5))
  (iwh-srvs "format %s hi+wide" (format "%s%s" iwh-hi "日"))
  (iwh-srvs "format %d width mb" (format "%5s" m)))
;; in-place mutators
(iwh-srvs "aset mb ascii flag" (let ((s (copy-sequence (string-to-multibyte "abc")))) (aset s 1 ?z) s))
(iwh-srvs "aset uni to 233" (let ((s (copy-sequence "abc"))) (aset s 1 233) s))
(iwh-srvs "clear-string mb ascii" (let ((s (copy-sequence (string-to-multibyte "abc")))) (clear-string s) s))
;; consumers that branch on the representation
(iwh-srvs "sha1 hi" (secure-hash 'sha1 iwh-hi))
(iwh-srvs "sha256 wide" (secure-hash 'sha256 "日"))
(iwh-srvs "base64 hi" (base64-encode-string iwh-hi))
(iwh-srvs "base64 mb ascii" (base64-encode-string (string-to-multibyte "abc")))
(iwh-srvs "base64 decode" (base64-decode-string "yIdB"))
(iwh-srvs "string= hi vs e-acute" (string= (unibyte-string 233) "é"))
(iwh-srvs "equal hi vs e-acute" (equal (unibyte-string 233) "é"))
(iwh-srvs "equal ascii uni/mb" (equal "abc" (string-to-multibyte "abc")))
(iwh-srvs "string< hi" (string< (unibyte-string 233) "é"))
(iwh-srvs "compare-strings hi" (compare-strings iwh-hi nil nil "È\u0087A" nil nil))
(iwh-srvs "eq intern hi/mb" (eq (intern (unibyte-string 233)) (intern "é")))
(iwh-srvs "string-prefix-p" (string-prefix-p "ab" (string-to-multibyte "abc")))
(iwh-srvs "string-search hi" (string-search (unibyte-string 135) iwh-hi))
(iwh-srvs "string-to-number mb" (string-to-number (string-to-multibyte "12")))
(iwh-srvs "read mb ascii" (read (string-to-multibyte "(1 . \"x\")")))
(iwh-srvs "car read mb string" (multibyte-string-p (cdr (read (string-to-multibyte "(1 . \"x\")")))))
(iwh-srvs "mb-p read literal" (multibyte-string-p (car (read-from-string "\"abc\""))))
(iwh-srvs "mb-p read mb literal" (multibyte-string-p (car (read-from-string (string-to-multibyte "\"abc\"")))))
;; file round trips: write-region of unibyte and multibyte strings, then a literal read
(let ((f (make-temp-file "iwh-sr")))
  (unwind-protect
      (progn
        (let ((coding-system-for-write 'no-conversion)) (write-region iwh-hi nil f nil 'silent))
        (iwh-srvs "wr unibyte -> literal" (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally f) (buffer-string)))
        (write-region "é日" nil f nil 'silent)
        (iwh-srvs "wr multibyte -> literal" (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally f) (buffer-string)))
        (iwh-srvs "wr multibyte -> decode" (with-temp-buffer (insert-file-contents f) (buffer-string)))
        (let ((coding-system-for-write 'no-conversion)) (write-region (string-to-multibyte "abc") nil f nil 'silent))
        (iwh-srvs "wr mb ascii -> literal" (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally f) (buffer-string))))
    (ignore-errors (delete-file f))))
(princ "INTEG-WH-STRING-REPR DONE\n")
