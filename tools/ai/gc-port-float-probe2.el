;;; gc-port-float-probe2.el --- floats in containers and identity operations: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run like gc-port-float-probe.el.  Known differences from GNU: cl-position is defined here and
;; not in a bare GNU batch, equal-hash of a list key, byte-compile is absent.
(defmacro pf (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

;; identity and equality
(pf "eq-same-var" (let ((x 1.5)) (eq x x)))
(pf "eql-lit" (eql 1.5 1.5))
(pf "eql-neg-zero" (eql 0.0 -0.0))
(pf "eql-nan" (let ((n (/ 0.0 0.0))) (eql n n)))
(pf "equal-lit" (equal 1.5 1.5))
(pf "equal-list" (equal (list 1.5 2.5) (list 1.5 2.5)))
(pf "equal-vec" (equal (vector 1.5 "a") (vector 1.5 "a")))
(pf "equal-int-float" (equal 1 1.0))
(pf "eql-int-float" (eql 1 1.0))
(pf "= int float" (= 1 1.0))
;; memq family
(pf "memql" (memql 2.5 (list 1.5 2.5 3.5)))
(pf "member" (member 2.5 (list 1.5 2.5 3.5)))
(pf "assoc" (assoc 2.5 (list (cons 1.5 'a) (cons 2.5 'b))))
(pf "rassoc" (rassoc 2.5 (list (cons 'a 1.5) (cons 'b 2.5))))
(pf "delete" (delete 2.5 (list 1.5 2.5 3.5)))
(pf "remove" (remove 2.5 (list 1.5 2.5 3.5)))
(pf "seq-position" (seq-position (list 1.5 2.5 3.5) 3.5))
(pf "cl-position" (cl-position 2.5 (list 1.5 2.5 3.5)))
(pf "delq-same" (let* ((x 2.5) (l (list 1.5 x 3.5))) (delq x l)))
(pf "memq-same" (let* ((x 2.5) (l (list 1.5 x 3.5))) (memq x l)))
(pf "assq-same" (let* ((x 2.5) (l (list (cons 1.5 'a) (cons x 'b)))) (assq x l)))
;; hash tables
(pf "hash-eql" (let ((h (make-hash-table :test 'eql))) (puthash 1.5 'a h) (gethash 1.5 h)))
(pf "hash-equal" (let ((h (make-hash-table :test 'equal))) (puthash 1.5 'a h) (puthash (list 1.5) 'b h) (list (gethash 1.5 h) (gethash (list 1.5) h))))
(pf "hash-eql-many" (let ((h (make-hash-table :test 'eql)) (n 0)) (dotimes (i 200) (puthash (* i 0.5) i h)) (dotimes (i 200) (when (eql (gethash (* i 0.5) h) i) (setq n (1+ n)))) n))
(pf "hash-eq-same" (let ((h (make-hash-table :test 'eq)) (x 1.5)) (puthash x 'a h) (gethash x h)))
(pf "sxhash-equal-eq" (= (sxhash-equal 1.5) (sxhash-equal 1.5)))
(pf "sxhash-eql-eq" (= (sxhash-eql 1.5) (sxhash-eql 1.5)))
(pf "sxhash-equal-list" (= (sxhash-equal (list 1.5 2.5)) (sxhash-equal (list 1.5 2.5))))
(pf "sxhash-equal-differs" (/= (sxhash-equal 1.5) (sxhash-equal 2.5)))
;; sorting and extrema
(pf "sort-floats" (sort (list 3.5 1.5 2.5 -1.0 0.0) #'<))
(pf "sort-mixed" (sort (list 3 1.5 2 0.5) #'<))
(pf "sort-vec" (sort (vector 3.5 1.5 2.5) #'>))
(pf "max" (max 1 2.5 2))
(pf "min" (min 1.5 2 0.5))
(pf "max-nan" (let ((n (/ 0.0 0.0))) (isnan (max 1.0 n))))
(pf "abs" (abs -2.5))
(pf "zerop" (list (zerop 0.0) (zerop -0.0) (zerop 1.5)))
(pf "natnump-floatp" (list (floatp 1.5) (natnump 1.5) (integerp 1.5) (numberp 1.5)))
;; stores
(pf "vector-store" (let ((v (make-vector 3 0.0))) (aset v 1 2.5) (aset v 2 (+ (aref v 1) 1.0)) (append v nil)))
(pf "cons-store" (let ((c (cons 1.5 2.5))) (setcar c (* (car c) 2)) (setcdr c (+ (cdr c) 0.25)) c))
(pf "plist" (plist-get (list 'a 1.5 'b 2.5) 'b))
(pf "alist-floats" (let ((l nil)) (dotimes (i 5) (push (cons i (* i 1.25)) l)) (mapcar #'cdr (reverse l))))
(pf "closure-capture" (let ((x 1.5)) (funcall (lambda (y) (+ x y)) 2.25)))
(pf "dynamic-float" (progn (defvar pf--dyn 1.5) (let ((pf--dyn 2.5)) (list pf--dyn (symbol-value 'pf--dyn)))))
(pf "setq-loop" (let ((x 0.0)) (dotimes (i 100) (setq x (+ x 0.125))) x))
(pf "apply" (apply #'+ (list 1.5 2.5 3.5)))
(pf "mapcar" (mapcar (lambda (x) (* x 2.0)) (list 1.5 2.5)))
(pf "number-to-string" (mapcar #'number-to-string (list 1.5 -0.0 1e21 1e-7 100.0)))
(pf "format" (format "%s %S %.2f %5.1f %e %g" 1.5 2.5 3.14159 2.25 12345.678 0.0001))
(pf "read" (read "1.5e3"))
(pf "read-list" (read "(1.5 2.5 -0.5)"))
(pf "string-to-number" (list (string-to-number "1.5") (string-to-number "2e3") (string-to-number "abc")))
(pf "prin1-to-string" (prin1-to-string (list 1.5 "a" 2.5)))
(pf "copy-sequence" (copy-sequence (list 1.5 2.5)))
(pf "append-vconcat" (list (append (list 1.5) (list 2.5)) (vconcat (vector 1.5) (list 2.5))))
(pf "float-time-float" (floatp (float-time)))
(pf "nested" (let ((l (list (list 1.5 (vector 2.5 (list 3.5)))))) (car (cdr (aref (cadr (car l)) 1))))
  )
(pf "gc-keeps-floats" (let ((l nil)) (dotimes (i 2000) (push (* i 1.5) l)) (garbage-collect) (garbage-collect) (let ((s 0.0)) (dolist (x l) (setq s (+ s x))) s)))
(pf "gc-vector-floats" (let ((v (make-vector 1000 0.0))) (dotimes (i 1000) (aset v i (* i 0.25))) (garbage-collect) (let ((s 0.0)) (dotimes (i 1000) (setq s (+ s (aref v i)))) s)))
(pf "bytecode-float" (funcall (byte-compile (lambda (a b) (list (+ a b) (< a b) (eq a a) (* a 2)))) 1.5 2.5))
(princ "PF2-DONE\n")
