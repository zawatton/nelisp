;;; -*- lexical-binding: t; -*-
;; Scaling probe: string-match near the end of a long subject.  Prints us/call at N and 4N and the ratio.
(defun sc-time (f reps)
  (funcall f) (funcall f)
  (let ((best nil))
    (dotimes (_ 3)
      (let ((t0 (float-time))) (dotimes (_ reps) (funcall f))
        (let ((d (/ (- (float-time) t0) reps))) (when (or (null best) (< d best)) (setq best d)))))
    (* 1e6 best)))
(defvar sc-fail 0)
(defun sc-row (label mk run limit)
  (let* ((n1 40000) (n2 160000)
         (a (sc-time (let ((s (funcall mk n1))) (lambda () (funcall run s n1))) 10))
         (b (sc-time (let ((s (funcall mk n2))) (lambda () (funcall run s n2))) 10))
         (r (/ b (max a 0.001))))
    (princ (format "%-34s %9.1f %9.1f ratio %6.2f %s\n" label a b r (if (<= r limit) "ok" (progn (setq sc-fail (1+ sc-fail)) "SCALES"))))))
(let ((asc (lambda (n) (concat (make-string n ?a) "beta gamma")))
      (mbs (lambda (n) (concat (make-string n ?あ) "beta gamma"))))
  (dolist (spec '(("beta \\(gamma\\)" "beta \\(gamma\\)") ("literal" "beta gamma") ("set" "[b]eta") ("any" "be.a") ("group" "\\(b\\)eta") ("class+" "[a-z]+") ("alt" "gamma\\|delta") ("bol-group" "^\\(x\\)")))
    (let ((pat (cadr spec)) (nm (car spec)))
      (sc-row (format "asc %s" nm) asc (lambda (s n) (string-match pat s (- n 5))) 1.8)
      (sc-row (format "mb  %s" nm) mbs (lambda (s n) (string-match pat s (- n 5))) 1.8)
      (let ((case-fold-search nil))
      (sc-row (format "mb nofold %s" nm) mbs (lambda (s n) (let ((case-fold-search nil)) (string-match pat s (- n 5)))) 1.8))))
  (sc-row "mb string-match-p" mbs (lambda (s n) (string-match-p "beta" s (- n 5))) 1.8)
  (sc-row "mb match-data after" mbs (lambda (s n) (string-match "beta" s (- n 5)) (match-data)) 1.8)
  (sc-row "mb match-string after" mbs (lambda (s n) (string-match "b\\(e\\)ta" s (- n 5)) (match-string 1 s)) 1.8))
(princ (format "SCALING-FAILURES %d\n" sc-fail))
