;;; parity-corpus.el --- GNU parity corpus for regexp/search entry points  -*- lexical-binding: t; -*-
;; Run under both NeLisp and GNU Emacs; the printed lines must be identical.
;; Windowed buffer searches cut the text at 256, 2048, 16384, ... characters,
;; so the corpus places matches and near-misses around those cut points.
(defvar pc-n 0)
(defun pc-md () (mapcar (lambda (x) (cond ((markerp x) (marker-position x)) ((bufferp x) 'buf) (t x))) (match-data)))
(defmacro pc (label &rest body)
  `(progn (setq pc-n (1+ pc-n))
          (princ (format "%s: %S\n" ,label
                         (condition-case e (progn ,@body)
                           (error (list 'ERR (car e) (cdr e))))))))
(defun pc-buf (text) (let ((b (generate-new-buffer " pc"))) (with-current-buffer b (insert text) (goto-char (point-min))) b))
(defmacro pc-in (text &rest body)
  `(let ((b (pc-buf ,text))) (unwind-protect (with-current-buffer b ,@body) (kill-buffer b))))

;; ---- string-match family ----
(dolist (s '("foo bar baz" "FOO Bar" "あいう foo えお" "" "abc\nabc" "xx"))
  (dolist (re '("bar" "\\(o\\)\\1" "o+" "^abc" "abc$" "\\bba" "a\\|b" "[[:upper:]]+" "\\(f\\)\\(o\\)*" "\\`foo" "z*" "." "o\\'" "\\w+\\>" "\\_<foo"))
    (dolist (cf '(nil t))
      (dolist (st '(nil 0 2 -3))
        (let ((case-fold-search cf))
          (pc (format "sm %S %S cf=%S st=%S" re s cf st)
              (list (condition-case e (string-match re s st) (error (list 'ERR (car e)))) (pc-md))))))))
(pc "sm-p keeps md" (progn (string-match "b\\(a\\)" "foo bar") (list (string-match-p "o+" "foo") (pc-md))))
(pc "sm unibyte high byte" (string-match "\\xe9" (string-to-unibyte "caf\351")))
(pc "sm multibyte vs unibyte pattern" (list (string-match "é" "café") (string-match "caf" (string-to-multibyte "cafe"))))
(pc "sm fold non-ascii" (let ((case-fold-search t)) (list (string-match "É" "café") (string-match "ǆ" "Ǆ"))))
(pc "sm START=len" (list (string-match "" "abc" 3) (string-match "a" "abc" 3) (string-match "$" "abc" 3)))
(pc "sm START out of range" (list (condition-case e (string-match "a" "abc" 4) (error (car e))) (condition-case e (string-match "a" "abc" -4) (error (car e)))))
;; long strings, START near the end, ascii and multibyte
(dolist (len (if (getenv "PC_QUICK") '(300 3000) '(300 5000 20000)))
  (let ((a (concat (make-string len ?a) "beta gamma BETA Gamma"))
        (m (concat (make-string len ?あ) "beta gamma BETA Gamma")))
    (dolist (s (list a m))
      (dolist (re '("beta \\(gamma\\)" "beta gamma" "BETA" "\\(b\\)eta" "[bg]a" "g.mma" "\\(?:Gamma\\|gamma\\)$" "a$" "\\(a\\)\\'" "\\bGamma\\b"))
        (dolist (cf '(nil t))
          (dolist (st (list (- len 5) (- len 1) len (+ len 7) 0))
            (let ((case-fold-search cf))
              (pc (format "long sm len=%d mb=%S %S cf=%S st=%d" len (multibyte-string-p s) re cf st)
                  (list (string-match re s st) (pc-md))))))))))

;; ---- buffer searches ----
(dolist (cf '(nil t))
  (let ((case-fold-search cf))
    (dolist (text '("foo bar\nbaz Foo BAR\nqux" "あいう foo\nえお FOO\n" "aaa" "" "x\n"))
      (dolist (op '((search-forward "foo") (search-forward "FOO" nil t) (search-forward "o" nil t 2) (search-forward "o" 4 t)
                    (search-forward "zzz" nil t) (search-forward "zzz" nil 1) (search-forward "o" nil t -1)
                    (search-backward "o" nil t) (search-backward "FOO" nil t 2) (search-backward "foo" 3 t)
                    (re-search-forward "o+") (re-search-forward "\\(o\\)\\(o\\)" nil t) (re-search-forward "^b" nil t)
                    (re-search-forward "r$" nil t) (re-search-forward "\\bba" nil t) (re-search-forward "x*" nil t 3)
                    (re-search-forward "\\`foo" nil t) (re-search-forward "qux\\'" nil t) (re-search-forward "o\\{2\\}" 6 t)
                    (re-search-backward "o+" nil t) (re-search-backward "^b" nil t) (re-search-backward "\\(f\\)oo" nil t 2)
                    (re-search-backward "x*" nil t) (re-search-backward "\\'" nil t)
                    (looking-at "foo") (looking-at "\\(f\\)o+") (looking-at "") (looking-at "^\\|zz") (looking-at "[a-z]*$")
                    (looking-at "FOO")))
        (dolist (pt '(1 3 5 9 -1))
          (pc (format "buf %S cf=%S pt=%S text=%S" op cf pt text)
              (pc-in text
                (goto-char (if (< pt 0) (point-max) (min pt (point-max))))
                (let ((r (condition-case e (eval op t) (error (list 'ERR (car e) (cdr e))))))
                  (list r (point) (pc-md))))))))))
;; narrowing, bounds that are markers, bound past point-max, wrong-side bounds
(pc "narrowed rsf" (pc-in "aaa foo bbb foo ccc" (narrow-to-region 6 14) (goto-char 6) (list (re-search-forward "foo" nil t) (point) (re-search-forward "\\`" nil t) (re-search-forward "bbb\\'" nil t))))
(pc "narrowed bol" (pc-in "xx\nfoo\nyy" (narrow-to-region 4 8) (goto-char 4) (list (looking-at "^foo$") (re-search-forward "^" nil t 2) (point))))
(pc "marker bound" (pc-in "abcabcabc" (let ((m (copy-marker 7))) (list (search-forward "c" m t 2) (search-forward "c" m t)))))
(pc "bound past max" (pc-in "abc" (list (search-forward "z" 100 t) (point) (search-forward "z" 100 1) (point))))
(pc "bound wrong side" (pc-in "abcabc" (goto-char 4) (list (condition-case e (search-forward "a" 2 t) (error (cadr e))) (condition-case e (re-search-backward "a" 6 t) (error (cadr e))))))
(pc "count 0" (pc-in "abc" (goto-char 2) (list (search-forward "z" nil t 0) (re-search-forward "z" nil t 0) (search-backward "z" nil t 0))))
(pc "failed search keeps md" (pc-in "abc abc" (re-search-forward "b\\(c\\)") (let ((md (pc-md))) (list (re-search-forward "zzz" nil t) (equal md (pc-md)) (point)))))
(pc "search-failed signal data" (pc-in "abc" (list (condition-case e (search-forward "zz") (error e)) (condition-case e (re-search-backward "zz") (error e)))))
(pc "match-string after search" (pc-in "hello world" (re-search-forward "w\\(or\\)ld") (list (match-string 0) (match-string 1) (match-beginning 1) (match-end 1))))
(pc "replace-match loop" (pc-in "a-a-a-a" (let ((n 0)) (while (re-search-forward "a" nil t) (replace-match "bb") (setq n (1+ n))) (list n (buffer-string)))))
(pc "backward rep loop" (pc-in "a-a-a-a" (goto-char (point-max)) (let ((n 0)) (while (re-search-backward "a" nil t) (replace-match "bb") (setq n (1+ n))) (list n (buffer-string)))))
(pc "overlap count" (pc-in "aaaaaa" (list (search-forward "aa" nil t 2) (point) (progn (goto-char 1) (re-search-forward "aa" nil t 3)) (progn (goto-char (point-max)) (search-backward "aa" nil t 2)))))
(pc "unibyte buffer" (pc-in "" (set-buffer-multibyte nil) (insert "caf\351 caf\351") (goto-char 1) (list (search-forward "caf" nil t 2) (re-search-forward "\\xe9" nil t) (looking-at "\\xe9") (point))))
;; large buffers: matches placed around window cut points
(dolist (cut (if (getenv "PC_QUICK") '(255 257 2049) '(100 256 257 2047 2048 2049 16383 16384 16385 20000)))
  (dolist (cf '(nil t))
    (let ((case-fold-search cf)
          (text (concat (make-string cut ?x) "hello world foo\nbar" (make-string 30 ?y) "\nHello")))
      (dolist (op '((search-forward "hello world") (search-forward "HELLO" nil t) (search-forward "o\nb" nil t) (search-forward "foo\n" nil t)
                    (re-search-forward "hello w\\(or\\)ld") (re-search-forward "foo$" nil t) (re-search-forward "^bar" nil t)
                    (re-search-forward "x*hello" nil t) (re-search-forward "x+\\b" nil t) (re-search-forward "\\(x*\\)\\(h\\|y\\)" nil t)
                    (re-search-forward "x*\\(h\\|xxxxx\\)" nil t) (re-search-forward "\\(x*h\\|x\\)" nil t) (re-search-forward "o\\b" nil t)
                    (re-search-forward "[^z]*z" nil t) (re-search-forward "y+\\'" nil t) (re-search-forward "Hello\\'" nil t)
                    (re-search-forward "\\(x\\)\\1" nil t) (re-search-forward "y\\{3,\\}" nil t) (re-search-forward "world\\|foo" nil t 2)
                    (re-search-backward "hello" nil t) (re-search-backward "x+" nil t) (re-search-backward "\\(h\\)ello" nil t 2)
                    (re-search-backward "o\\b" nil t) (re-search-backward "^" nil t 3) (search-backward "x" nil t)
                    (looking-at "x*hello") (looking-at "x*\\(h\\|xxxxx\\)") (looking-at "x+$")))
        (dolist (pt (if (and (> cut 3000) (member (cadr op) '("x+\\b" "[^z]*z" "x*\\(h\\|xxxxx\\)" "\\(x*h\\|x\\)" "\\(x*\\)\\(h\\|y\\)" "x+$"))) nil '(1 2 20 -1)))
          (pc (format "big cut=%d %S cf=%S pt=%S" cut op cf pt)
              (pc-in text
                (goto-char (cond ((< pt 0) (point-max)) (t pt)))
                (when (memq (car op) '(re-search-backward search-backward)) (goto-char (point-max)))
                (let ((r (eval op t))) (list r (point) (pc-md))))))))))
(pc "bounded big" (pc-in (concat (make-string 5000 ?x) "needle" (make-string 5000 ?x))
  (list (search-forward "needle" 5001 t) (search-forward "needle" 5006 t) (search-forward "needle" 5007 t) (point)
        (progn (goto-char 1) (re-search-forward "x*needle$" 5007 t)) (progn (goto-char 1) (re-search-forward "x*needlex" 5007 t)) (progn (goto-char 1) (re-search-forward "needle\\b" 5007 t)))))
(pc "edit then search" (pc-in (make-string 3000 ?a) (goto-char 2990) (insert "needle") (goto-char 1) (list (search-forward "needle" nil t) (progn (delete-region 1 10) (goto-char 1) (re-search-forward "ne+dle" nil t)) (point))))
;; case-fold-search with a custom case table-free ascii needle in mixed text
(pc "fold literal scan" (let ((case-fold-search t)) (pc-in (concat (make-string 3000 ?B) "bAnana BANANA") (list (search-forward "banana" nil t) (search-forward "banana" nil t) (search-forward "banana" nil t)))))
;; skip-chars: sets, ranges, negation, limits, multibyte, windows around 256/2048
(dolist (text (list "abc  def\tghi\n  jkl" "あいう abc えお" (concat (make-string 255 ?a) " " (make-string 3000 ?b) "z")))
  (dolist (spec '("a-c" "^a-c" " \t" "^ " "a-zあ-ん" "\\^a" "a-"))
    (dolist (lim '(nil 3 7 300 100000))
      (dolist (pt '(1 4 -1))
        (pc (format "skipf %S lim=%S pt=%S len=%d" spec lim pt (length text))
            (pc-in text (goto-char (if (< pt 0) (point-max) (min pt (point-max))))
              (list (skip-chars-forward spec lim) (point))))
        (pc (format "skipb %S lim=%S pt=%S len=%d" spec lim pt (length text))
            (pc-in text (goto-char (if (< pt 0) (point-max) (min pt (point-max))))
              (list (skip-chars-backward spec (and lim (min lim (point)))) (point))))))))
(princ (format "CORPUS-COUNT %d\n" pc-n))
