;;; shim.el --- minimal ERT-compatible runner  -*- lexical-binding: t -*-
;; Output per test: NAME<TAB>STATUS<TAB>REASON<TAB>MS   (STATUS PASS FAIL ERROR SKIP XFAIL XPASS)
;; Before each test: NAME<TAB>START   (lets the driver localize crashes/hangs).
(provide 'ert)
(provide 'ert-x)
(defvar shim--tests nil)
(dolist (lib '(cl-lib subr-x find-func pp))
  (condition-case nil (require lib) (t nil)))
(defun shim--read-lines (var)
  (let ((f (getenv var)))
    (and f (file-exists-p f)
         (with-temp-buffer (insert-file-contents f) (split-string (buffer-string) "\n" t)))))
(defvar shim--skip (shim--read-lines "SHIM_SKIP"))
(defvar shim--skipforms (mapcar #'string-to-number (shim--read-lines "SHIM_SKIPFORMS")))
(define-error 'shim-test-failed "shim test failed")
(define-error 'shim-test-skipped "shim test skipped")

(defmacro ert-deftest (name arglist &rest body)
  (let ((expected nil))
    (when (stringp (car body)) (setq body (cdr body)))
    (while (keywordp (car body))
      (when (eq (car body) :expected-result) (setq expected (cadr body)))
      (setq body (cddr body)))
    `(progn
       (shim--register ',name ',expected (lambda ,arglist ,@body)))))
(defun shim--register (name expected fn)
  (put name 'shim-fn fn)
  (setq shim--tests (cons (cons name expected) (delq (assq name shim--tests) shim--tests))))
(defmacro should (form) `(let ((v ,form)) (unless v (shim-fail (list 'should ',form))) v))
(defmacro should-not (form) `(let ((v ,form)) (when v (shim-fail (list 'should-not ',form))) nil))
(defun shim-fail (data) (signal 'shim-test-failed (list data)))
(defun ert-fail (data) (signal 'shim-test-failed (list data)))
(defun ert-skip (data) (signal 'shim-test-skipped (list data)))
(defmacro skip-unless (form) `(unless ,form (ert-skip ',form)))
(defmacro skip-when (form) `(when ,form (ert-skip ',form)))
(defmacro should-error (form &rest keys)
  (let ((type (plist-get keys :type)))
    `(let ((r (condition-case err (cons 'no-error ,form)
                (t (cons 'err err))))
       (ty ,type))
       (when (eq (car r) 'no-error) (shim-fail (list 'should-error ',form 'no-error)))
       (let ((err (cdr r)))
         (when (and ty (not (shim--type-match err ty)))
           (shim-fail (list 'should-error ',form 'wrong-type err)))
         err))))
(defun shim--type-match (err ty)
  (let ((conds (get (car err) 'error-conditions)))
    (if (null conds) (setq conds (list (car err))))
    (if (listp ty)
        (let ((ok nil)) (dolist (x ty) (when (memq x conds) (setq ok t))) ok)
      (memq ty conds))))
(defmacro ert-info (_info &rest body) `(progn ,@body))
(defmacro ert-with-message-capture (var &rest body)
  `(let ((,var "")) ,@body))
(defmacro ert-with-temp-file (var &rest body)
  (let ((keys nil) (name (make-symbol "f")))
    (while (keywordp (car body)) (setq keys (append keys (list (car body) (cadr body))) body (cddr body)))
    `(let* ((,var (make-temp-file ,(or (plist-get keys :prefix) "shim") nil ,(plist-get keys :suffix) ,(plist-get keys :text)))
            (,name ,var))
       (unwind-protect (progn ,@body) (ignore-errors (delete-file ,name))))))
(defmacro ert-with-temp-directory (var &rest body)
  (let ((name (make-symbol "d")))
    `(let* ((,var (make-temp-file "shimd" t)) (,name ,var))
       (unwind-protect (progn ,@body) (ignore-errors (delete-directory ,name t))))))
(defun ert-resource-directory () (expand-file-name "resources" (or (getenv "EMACS_TEST_DIRECTORY") ".")))
(defun ert-resource-file (f) (expand-file-name f (ert-resource-directory)))
(defun ert-run-tests-batch-and-exit (&rest _) (shim-run))

(defun shim--clean (s)
  (let ((s (if (stringp s) s (prin1-to-string s))))
    (setq s (replace-regexp-in-string "[\n\t\r]" " " s))
    (if (> (length s) 220) (substring s 0 220) s)))
(defun shim--now () (condition-case nil (float-time) (error 0.0)))
(defun shim-load (file)
  (let ((forms nil) (i 0) (nfail 0))
    (with-temp-buffer
      (insert-file-contents file)
      (goto-char (point-min))
      (condition-case err
          (let ((go t))
            (while go
              (let ((f (read (current-buffer))))
                (setq forms (cons f forms)))))
        (end-of-file nil)
        (t (princ (concat "#READFAIL\tform " (number-to-string (length forms)) " pos " (number-to-string (point)) "\t" (shim--clean (list err)) "\n")))))
    (dolist (f (nreverse forms))
      (setq i (1+ i))
      (princ (concat "#EVAL\t" (number-to-string i) "\t" (shim--clean (list (if (consp f) (car f) f) (if (consp (cdr f)) (cadr f) nil))) "\n"))
      (condition-case err (if (memq i shim--skipforms) nil (eval f t))
        (t (setq nfail (1+ nfail))
           (princ (concat "#FORMFAIL\t" (number-to-string i) "\t" (shim--clean (list err)) "\t" (shim--clean (list (if (consp f) (car f) f) (if (consp (cdr f)) (cadr f) nil))) "\n")))))
    (princ (concat "#LOADED\t" (number-to-string i) "\t" (number-to-string nfail) "\n"))))
(defun shim-run ()
  (let* ((skip shim--skip)
         (tests (reverse shim--tests)))
    (dolist (tc tests)
      (let* ((name (car tc)) (expected (cdr tc)) (nm (symbol-name name)))
        (unless (member nm skip)
          (princ (concat nm "\tSTART\n"))
          (let* ((t0 (shim--now)) (st nil) (why ""))
            (condition-case err (progn (funcall (get name 'shim-fn)) (setq st "PASS"))
              (shim-test-skipped (setq st "SKIP" why (shim--clean (cdr err))))
              (shim-test-failed (setq st "FAIL" why (shim--clean (cdr err))))
              (t (setq st "ERROR" why (shim--clean err))))
            (when expected
              (cond ((and (equal st "PASS") (eq expected :failed)) (setq st "XPASS"))
                    ((and (member st '("FAIL" "ERROR")) (eq expected :failed)) (setq st "XFAIL"))))
            (princ (concat nm "\t" st "\t" why "\t"
                           (number-to-string (round (* 1000 (- (shim--now) t0)))) "\n"))))))
    (princ "#DONE\n")))
