;;; eqhash-wall.el --- batched wall-clock hash probes -*- lexical-binding: t; -*-
;; Setup is outside the timer. Both sides warm up and include final GC.
;; Get controls are eq; put controls are three-argument char-table stores.
;; The floor stores each key as a value in a separate rooted char-table,
;; so equal keys retain their content. Setup/population is outside timing.
(defvar eqhw-cases (car (read-from-string (getenv "EQHASH_CASES"))))
(defvar eqhw-own (equal (getenv "EQHASH_OWN") "1"))
(defvar eqhw-calls (string-to-number (getenv "EQHASH_CALLS")))
(defvar eqhw-table nil)
(defvar eqhw-keep nil)
(defvar eqhw-a nil)
(defvar eqhw-b nil)
(defvar eqhw-c nil)
(defvar eqhw-n 0)
(defvar eqhw-put-floor nil)
(put 'eqhash-key 'char-table-extra-slots 1)
(defun eqhw-object (kind i)
  (cond ((eq kind 'string) (format "eqhash-%d" i))
        ((eq kind 'cons) (cons i nil))
        ((eq kind 'symbol) (make-symbol "eqhash-key"))
        ((eq kind 'vector) (vector i))
        ((eq kind 'float) (+ 0.25 i))
        ((eq kind 'bignum) (+ 2305843009213693952 i))
        ((eq kind 'marker) (make-marker))
        ((eq kind 'chartable)
         (let ((key (make-char-table 'eqhash-key nil)))
           (set-char-table-extra-slot key 0 i) key))
        (t (error "unknown key type"))))
(defun eqhw-prepare (test weak op)
  (setq eqhw-table (make-hash-table :test test :weakness weak))
  (dotimes (i eqhw-n) (puthash (aref eqhw-keep i) 1 eqhw-table))
  (setq eqhw-a (aref eqhw-keep (if (eq op 'hit) 0 eqhw-n))
        eqhw-b (if (eq op 'put) 0 eqhw-table) eqhw-c eqhw-table)
  (unless (and (= (hash-table-count eqhw-table) eqhw-n)
               (null (gethash (aref eqhw-keep eqhw-n) eqhw-table)))
    (error "population count or miss key invalid")))
(defun eqhw-run (op control calls &optional warmup)
  (cond ((eq op 'put)
         (if control
             (dotimes (i calls)
               (setq eqhw-a (aref eqhw-keep (+ eqhw-n i)))
               (set-char-table-extra-slot eqhw-put-floor eqhw-b eqhw-a))
           (dotimes (i calls)
             (setq eqhw-a (aref eqhw-keep (+ eqhw-n i)))
             (puthash eqhw-a eqhw-b eqhw-c)))
         ;; Identical cleanup releases the floor's final key reference.
         (set-char-table-extra-slot eqhw-put-floor 0 nil))
        (control (dotimes (_ calls) (eq eqhw-a eqhw-b)))
        (t (dotimes (_ calls) (gethash eqhw-a eqhw-b))))
  (unless warmup (garbage-collect)))
(setq eqhw-put-floor (make-char-table 'eqhash-key nil))
(dolist (spec eqhw-cases)
  (let ((kind (nth 0 spec)) (test (nth 1 spec)) (weak (nth 2 spec))
        (n (nth 3 spec)) (op (nth 4 spec)))
    (setq eqhw-n n eqhw-keep (make-vector (+ n (if (eq op 'put) eqhw-calls 0) 1) nil))
    (dotimes (i (length eqhw-keep))
      (aset eqhw-keep i (eqhw-object kind i)))
    (dolist (control (if eqhw-own '(nil t) '(nil)))
      (eqhw-prepare test weak op)
      (eqhw-run op control (min 100 eqhw-calls) t)
      (when (eq op 'put) (eqhw-prepare test weak op))
      (garbage-collect)
      (let* ((started (float-time))
             (_ (eqhw-run op control eqhw-calls))
             (seconds (- (float-time) started)))
        (unless (= (hash-table-count eqhw-table)
                   (if (and (eq op 'put) (not control)) (+ n eqhw-calls) n))
          (error "operation did not execute expected insertions"))
        (unless (equal (gethash eqhw-a eqhw-table)
                       (cond ((eq op 'hit) 1)
                             ((and (eq op 'put) (not control)) 0)
                             (t nil)))
          (error "unexpected final lookup"))
        (princ (format "EQHASH-WALL %s %s %s %d %s %s %.9f %d\n"
                       kind test weak n op (if control 1 0) seconds eqhw-calls))))
    (setq eqhw-table nil eqhw-keep nil eqhw-a nil eqhw-b nil eqhw-c nil)))
(princ "EQHASH-WALL-COMPLETE\n")
(kill-emacs 0)
