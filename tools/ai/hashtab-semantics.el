;;; hashtab-semantics.el --- GNU vector storage parity -*- lexical-binding: t; -*-
(defun hashtab-entries (table)
  (let (entries)
    (maphash (lambda (k v) (setq entries (cons (cons k v) entries))) table)
    (nreverse entries)))
(dolist (test '(eq eql equal))
  (let ((h (make-hash-table :test test :size 0)))
    (dotimes (i 100) (puthash i (* i 2) h))
    (remhash 0 h) (remhash 50 h) (remhash 99 h)
    (puthash nil 'nil-value h) (puthash t 'true-value h) (puthash -1 'minus-one h)
    (let ((copy (copy-hash-table h)))
      (puthash 0 'copy-only copy)
      (princ (format "%S\n" (list test (hash-table-size h) (hash-table-count h)
                                  (gethash nil h) (gethash t h) (gethash -1 h)
                                  (hashtab-entries h) (gethash 0 h 'absent)
                                  (gethash 0 copy) (eq (clrhash copy) copy)
                                  (hash-table-count copy) (hash-table-size copy)))))))
(define-hash-table-test 'hashtab-collision #'equal (lambda (_k) 1))
(let ((h (make-hash-table :test 'hashtab-collision :size 0)))
  (dotimes (i 100) (puthash (number-to-string i) i h))
  (dotimes (i 50) (remhash (number-to-string (* i 2)) h))
  (dotimes (i 50) (puthash (number-to-string (+ i 100)) i h))
  (let ((copy (copy-hash-table h)))
    (princ (format "%S\n" (list 'custom (hash-table-count h) (hashtab-entries h)
                                (gethash "99" copy) (gethash "98" copy 'absent))))))
(let ((h (make-hash-table :test 'eq)))
  (dolist (k '(a b c)) (puthash k k h))
  (dolist (k '(a b c)) (remhash k h))
  (clrhash h) (puthash 'x 1 h) (puthash 'y 2 h)
  (princ (format "%S\n" (list 'empty-clear-order (hashtab-entries h)))))
(defvar hashtab-copy-source nil)
(defvar hashtab-copied nil)
(define-hash-table-test 'hashtab-copy-test
  (lambda (a b)
    (setq hashtab-copied (copy-hash-table hashtab-copy-source))
    (clrhash hashtab-copied)
    (equal a b)) (lambda (_key) 1))
(setq hashtab-copy-source (make-hash-table :test 'hashtab-copy-test))
(puthash "a" 1 hashtab-copy-source)
(princ (format "%S\n" (condition-case e
    (list 'mutable-copy (gethash "b" hashtab-copy-source)
          (hash-table-count hashtab-copied) (hash-table-count hashtab-copy-source))
  (error (list 'copy-error (car e))))))
(princ "HASHTAB-SEMANTICS-COMPLETE\n")
(kill-emacs 0)
