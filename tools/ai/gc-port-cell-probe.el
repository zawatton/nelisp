;;; gc-port-cell-probe.el --- captured-variable (cell) behaviour probes: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l FILE (GNU) and NELISP --load FILE.  One "NAME => RESULT" line per case.
;; The cell representation step (Doc 216 S5, a header-first cell object) must leave every NeLisp
;; line unchanged; lines that differ from GNU are recorded pre-existing differences.
(require 'cl-lib)
(defmacro pc (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

(pc "counter" (let* ((n 0) (f (lambda () (setq n (1+ n))))) (funcall f) (funcall f) (list (funcall f) n)))
(pc "two-closures-share" (let* ((n 0) (inc (lambda () (setq n (1+ n)))) (get (lambda () n))) (funcall inc) (funcall inc) (funcall get)))
(pc "make-counter" (let* ((make (lambda () (let ((c 0)) (lambda () (setq c (1+ c)))))) (a (funcall make)) (b (funcall make))) (funcall a) (funcall a) (funcall b) (list (funcall a) (funcall b))))
(pc "accumulate" (let ((acc nil)) (dolist (x '(1 2 3)) (push (lambda () x) acc)) (mapcar #'funcall acc)))
(pc "dotimes-capture" (let ((fs nil)) (dotimes (i 4) (push (lambda () (* i i)) fs)) (mapcar #'funcall (nreverse fs))))
(pc "mutate-in-mapcar" (let ((sum 0)) (mapc (lambda (x) (setq sum (+ sum x))) '(1 2 3 4)) sum))
(pc "nested" (let ((a 1)) (let ((f (lambda () (let ((b 10)) (lambda () (setq a (+ a b)) (setq b (1+ b)) (list a b))))))  (let ((g (funcall f))) (funcall g) (funcall g)))))
(pc "setq-then-read" (let ((x 1)) (let ((f (lambda () x))) (setq x 99) (funcall f))))
(pc "capture-list" (let ((l (list 1 2 3))) (let ((f (lambda () (setq l (cdr l)) l))) (funcall f) (funcall f))))
(pc "capture-string" (let ((s "abc")) (let ((f (lambda () (setq s (concat s "!")) s))) (funcall f) (funcall f))))
(pc "capture-float" (let ((x 1.5)) (let ((f (lambda () (setq x (* x 2.0)) x))) (funcall f) (funcall f))))
(pc "capture-bignum" (let ((x (ash 1 70))) (let ((f (lambda () (setq x (* x 2)) x))) (funcall f) (funcall f))))
(pc "capture-vector" (let ((v (vector 1 2 3))) (let ((f (lambda () (aset v 0 (1+ (aref v 0))) v))) (funcall f) (funcall f))))
(pc "capture-cons" (let ((c (cons 1 2))) (let ((f (lambda () (setcar c (1+ (car c))) c))) (funcall f) (funcall f))))
(pc "capture-nil-t" (let ((x nil)) (let ((f (lambda () (setq x (not x))))) (list (funcall f) (funcall f) (funcall f)))))
(pc "capture-symbol" (let ((s 'a)) (let ((f (lambda () (setq s (if (eq s 'a) 'b 'a))))) (list (funcall f) (funcall f)))))
(pc "capture-closure" (let* ((n 5) (f (lambda () n)) (g (lambda () (funcall f)))) (setq n 6) (funcall g)))
(pc "recursion" (let ((fact nil)) (setq fact (lambda (n) (if (<= n 1) 1 (* n (funcall fact (1- n)))))) (funcall fact 10)))
(pc "fib-memo" (let ((memo (make-hash-table)) (fib nil)) (setq fib (lambda (n) (or (gethash n memo) (puthash n (if (< n 2) n (+ (funcall fib (- n 1)) (funcall fib (- n 2)))) memo)))) (funcall fib 30)))
(pc "alist-capture" (let ((al nil)) (let ((add (lambda (k v) (push (cons k v) al)))) (funcall add 'a 1) (funcall add 'b 2) al)))
(pc "same-var-many" (let ((n 0)) (let ((fs (mapcar (lambda (_) (lambda () (setq n (1+ n)))) '(1 2 3)))) (dolist (f fs) (funcall f)) (dolist (f fs) (funcall f)) n)))
(pc "shadowing" (let ((x 1)) (let ((f (lambda () x))) (let ((x 2)) (list (funcall f) x)))))
(pc "lambda-in-loop" (let ((r nil) (i 0)) (while (< i 3) (let ((j i)) (push (lambda () (setq j (+ j 10))) r)) (setq i (1+ i))) (mapcar #'funcall (nreverse r))))
(pc "gc-cells" (let ((fs nil)) (dotimes (i 200) (let ((n i)) (push (lambda () (setq n (1+ n))) fs))) (garbage-collect) (garbage-collect) (let ((s 0)) (dolist (f fs) (funcall f) (setq s (+ s (funcall f)))) s)))
(pc "gc-shared-cell" (let* ((n 0) (a (lambda () (setq n (+ n 1)))) (b (lambda () n))) (garbage-collect) (funcall a) (garbage-collect) (funcall a) (funcall b)))
(pc "gc-cell-holds-object" (let ((o (list 1 2 3))) (let ((f (lambda () o))) (setq o (make-list 100 'x)) (garbage-collect) (length (funcall f)))))
(pc "gc-cell-churn" (let ((x nil)) (let ((f (lambda (v) (setq x v)))) (dotimes (i 3000) (funcall f (list i i))) (garbage-collect) x)))
(pc "closure-in-struct" (let ((tbl (make-hash-table))) (dotimes (i 5) (let ((c 0)) (puthash i (lambda () (setq c (+ c i))) tbl))) (let ((s 0)) (maphash (lambda (_ f) (funcall f) (setq s (+ s (funcall f)))) tbl) s)))
(pc "apply-closure" (let ((n 0)) (apply (lambda (&rest xs) (dolist (x xs) (setq n (+ n x))) n) '(1 2 3))))
(pc "funcall-closure-args" (let ((n 0)) (funcall (lambda (a b) (setq n (+ a b)) n) 3 4)))
(pc "optional-rest" (let ((n 0)) (funcall (lambda (&optional a &rest r) (setq n (list a r)) n) 1 2 3)))
(pc "dynamic-and-lexical" (progn (defvar pc--dyn 1) (let ((x 5)) (let ((f (lambda () (list x pc--dyn)))) (let ((pc--dyn 2)) (funcall f))))))
(pc "unwind-protect-capture" (let ((log nil)) (unwind-protect (setq log (cons 'body log)) (setq log (cons 'cleanup log))) log))
(pc "condition-case-capture" (let ((r nil)) (condition-case e (error "x") (error (setq r (list 'caught (cadr e))))) r))
(pc "catch-throw-capture" (let ((r 0)) (catch 'k (let ((f (lambda () (setq r 42) (throw 'k nil)))) (funcall f))) r))
(pc "cl-incf" (let ((n 0)) (let ((f (lambda () (cl-incf n 5)))) (funcall f) (funcall f) n)))
(pc "push-pop-captured" (let ((st nil)) (let ((push* (lambda (x) (push x st))) (pop* (lambda () (pop st)))) (funcall push* 1) (funcall push* 2) (list (funcall pop*) (funcall pop*) (funcall pop*)))))
(pc "seq-in-closure" (let ((total 0)) (seq-do (lambda (x) (setq total (+ total x))) [1 2 3]) total))
(pc "cl-labels" (cl-labels ((ev (n) (if (= n 0) t (od (1- n)))) (od (n) (if (= n 0) nil (ev (1- n))))) (list (ev 10) (od 7))))
(pc "sort-with-closure" (let ((cmp 0)) (sort (list 3 1 2) (lambda (a b) (setq cmp (1+ cmp)) (< a b)))))
(pc "closure-print" (let ((x 1)) (functionp (lambda () x))))
(pc "many-captured" (let ((a 1) (b 2) (c 3) (d 4) (e 5)) (let ((f (lambda () (setq a (+ a b c d e)) a))) (funcall f) (funcall f))))
(princ "PC-DONE\n")
