;;; fmt1-native-check.el --- lane fmt1 native format/print acceptance  -*- lexical-binding: t; -*-
;; Run: nelisp-dynamic --load tools/ai/fmt1-native-check.el --
;; Prints "FMT1 OK n=N" or "FMT1 FAIL ..." and exits non-zero on failure.
;; Part 1: the native engine answers the shapes the prelude layer used to parse
;; per character (expected strings were produced by GNU Emacs 31.1).
;; Part 2: speed guard, generous bounds (the prelude path was 150-2000 us/op).
(defvar fmt1-nested '(1 (2 3 (4 5)) "str" [1 2 3] (a . b) 2.5 sym))
(defvar fmt1-fail nil)
(defvar fmt1-n 0)
(defun fmt1-eq (name got want)
  (setq fmt1-n (1+ fmt1-n))
  (unless (equal got want)
    (push (list name got want) fmt1-fail)))
(fmt1-eq 'mix (format "%d:%s:%5d|%-6s|%x|%c" 5 "ab" 5 "e" 5 ?z) "5:ab:    5|e     |5|z")
(fmt1-eq 'flags (format "%5d|%-5d|%05d|%+d|% d|%+5d|%-+5d|%x|%X|%o" 42 42 42 42 42 42 42 255 255 8)
         "   42|42   |00042|+42| 42|  +42|+42  |ff|FF|10")
(fmt1-eq 'strprec (format "%5s|%-5s|%.2s|%5.2s|%-5.2s|" "abc" "abc" "abc" "abc" "abc") "  abc|abc  |ab|   ab|ab   |")
(fmt1-eq 'S (format "%S|%5S|%-8S|" "abc" "abc" 'sym) "\"abc\"|\"abc\"|sym     |")
(fmt1-eq 'Snested (format "%S" fmt1-nested) "(1 (2 3 (4 5)) \"str\" [1 2 3] (a . b) 2.5 sym)")
(fmt1-eq 'snested (format "%s" fmt1-nested) "(1 (2 3 (4 5)) str [1 2 3] (a . b) 2.5 sym)")
(fmt1-eq 'quote (prin1-to-string '(quote x)) "'x")
(fmt1-eq 'function (prin1-to-string '(function car)) "#'car")
(fmt1-eq 'noescape (prin1-to-string "a\"b" t) "a\"b")
(fmt1-eq 'escape (prin1-to-string "a\"b\\c") "\"a\\\"b\\\\c\"")
(fmt1-eq 'dotted (prin1-to-string '(1 2 . 3)) "(1 2 . 3)")
(fmt1-eq 'neg (format "%5d|%-5d|%05d" -42 -42 -42) "  -42|-42  |-0042")
(fmt1-eq 'prec (format "%.3d|%5.3d|%-6.3d|" 5 5 5) "005|  005|005   |")
(fmt1-eq 'nativefmt (nelisp--native-format "%5d|%-6s|%S" 42 "ab" '(1 "a" b)) "   42|ab    |(1 \"a\" b)")
(fmt1-eq 'declines (nelisp--native-format "%5d" 1.5) nil)
(let ((print-length 2)) (fmt1-eq 'print-length (prin1-to-string '(1 2 3 4)) "(1 2 ...)"))
(let ((print-circle t) (l (list 1 2))) (setcar l l) (fmt1-eq 'circle (prin1-to-string l) "#1=(#1# 2)"))
(let ((l (list 1 2))) (setcdr (cdr l) l) (fmt1-eq 'cycle-terminates (stringp (prin1-to-string l)) t))
(fmt1-eq 'strprop (prin1-to-string (propertize "ab" 'face 'bold)) "\"ab\"")
(defmacro fmt1-time (n form)
  `(let ((s (float-time))) (dotimes (_ ,n) ,form) (/ (* 1e6 (- (float-time) s)) ,n)))
(defun fmt1-timed ()
  (list (fmt1-time 400 (prin1-to-string fmt1-nested))
        (fmt1-time 400 (format "%d:%s:%5d|%-6s|%x|%c" 5 "ab" 5 "e" 5 ?z))
        (fmt1-time 400 (format "<%s|%S|%S>" "hello world foo bar" "hello world foo bar" 7))
        (fmt1-time 400 (format "%S/%s" fmt1-nested fmt1-nested))))
(let ((times (fmt1-timed)))
  (princ (format "FMT1 us/op nested=%.1f mix=%.1f sS=%.1f Snested=%.1f\n"
                 (nth 0 times) (nth 1 times) (nth 2 times) (nth 3 times)))
  (dolist (tm times)
    (when (> tm 100.0) (push (list 'too-slow tm) fmt1-fail))))
(if fmt1-fail
    (progn (princ (format "FMT1 FAIL %S\n" (nreverse fmt1-fail))) (kill-emacs 1))
  (princ (format "FMT1 OK n=%d\n" fmt1-n))
  (kill-emacs 0))
