;;; runtime-provider-read.el --- Read selected provider source forms -*- lexical-binding: t; -*-

;; This process reads source data.  It never loads or evaluates inspected files.
(require 'json)
(require 'cl-lib)

(defvar runtime-provider--nodes 0)
(defun runtime-provider--declaration-only-p (form)
  "Recognize only declarations with no inspected initializer execution."
  (or (stringp form)
      (and (consp form)
           (or (memq (car form) '(defun defmacro defsubst))
               (and (memq (car form) '(defconst defvar))
                    (symbolp (cadr form))
                    (if (eq (car form) 'defconst)
                        (memq (length form) '(3 4))
                      (memq (length form) '(2 3 4)))
                    (or (< (length form) 4) (stringp (nth 3 form)))
                    (or (null (cddr form))
                        (numberp (caddr form)) (stringp (caddr form))
                        (memq (caddr form) '(nil t))
                        (keywordp (caddr form))
                        (and (consp (caddr form))
                             (= (length (caddr form)) 2)
                             (eq (caaddr form) 'quote))))
               (and (eq (car form) 'provide)
                    (= (length form) 2)
                    (consp (cadr form)) (= (length (cadr form)) 2)
                    (eq (caadr form) 'quote) (symbolp (cadadr form)))))))

(defun runtime-provider--writes (form wanted)
  "Return conservatively detected writes to WANTED outside quoted data."
  (when (and (consp form) (not (eq (car form) 'quote)))
    (let (found)
      (when (memq (car form) '(setq setq-default))
        (let ((tail (cdr form)))
          (while tail
            (when (and (symbolp (car tail))
                       (member (symbol-name (car tail)) wanted))
              (push (symbol-name (car tail)) found))
            (setq tail (cddr tail)))))
      (when (and (memq (car form) '(set set-default))
                 (consp (cadr form)) (eq (caadr form) 'quote)
                 (symbolp (cadadr form))
                 (member (symbol-name (cadadr form)) wanted))
        (push (symbol-name (cadadr form)) found))
      (let ((tail form))
        (while (consp tail)
          (when (consp (car tail))
            (setq found (append (runtime-provider--writes (car tail) wanted) found)))
          (setq tail (cdr tail))))
      (delete-dups found))))

(defun runtime-provider--json-form (value &optional depth)
  "Encode VALUE without confusing symbols, strings, lists, and vectors."
  (setq runtime-provider--nodes (1+ runtime-provider--nodes))
  (when (or (> runtime-provider--nodes 500000) (> (or depth 0) 256))
    (error "Selected source form exceeds AST bounds"))
  (cond
   ((symbolp value) `((symbol . ,(symbol-name value))))
   ((or (stringp value) (numberp value)) value)
   ((vectorp value)
    `((vector . ,(vconcat (mapcar (lambda (x)
                                  (runtime-provider--json-form x (1+ (or depth 0))))
                                (append value nil))))))
   ((consp value)
    (let (items (tail value))
      (while (consp tail)
        (push (runtime-provider--json-form (car tail) (1+ (or depth 0))) items)
        (setq tail (cdr tail)))
      (if tail
          `((dotted . ,(vconcat (nreverse items)))
            (tail . ,(runtime-provider--json-form tail (1+ (or depth 0)))))
        (vconcat (nreverse items)))))
   (t (error "Unsupported GNU reader object: %S" (type-of value)))))

(let* ((request (with-temp-buffer
                  (insert-file-contents (getenv "RUNTIME_PROVIDER_REQUEST"))
                  (json-parse-buffer :object-type 'alist :array-type 'list)))
       (root (file-name-as-directory (alist-get 'root request)))
       (read-circle nil)
       (read-symbol-shorthands nil)
       output)
  (dolist (entry (alist-get 'files request))
    (let* ((relative (alist-get 'path entry))
           (path (expand-file-name relative root))
           (wanted (alist-get 'symbols entry))
           records writes effects)
      (unless (and (file-in-directory-p path root)
                   (<= (file-attribute-size (file-attributes path)) (* 4 1024 1024)))
        (error "Source path escapes root or exceeds bound: %s" relative))
      (with-temp-buffer
        (insert-file-contents path)
        (emacs-lisp-mode)
        (goto-char (point-min))
        (while (progn (forward-comment (point-max)) (not (eobp)))
          (let* ((line (line-number-at-pos))
                 (form (read (current-buffer))))
            (unless (runtime-provider--declaration-only-p form)
              (push (format "%s:%s" line (if (consp form) (car form) "atom")) effects))
            (setq writes (append (runtime-provider--writes form wanted) writes))
            (when (and (consp form)
                       (memq (car form) '(defconst defvar defun))
                       (symbolp (cadr form))
                       (member (symbol-name (cadr form)) wanted))
              (setq runtime-provider--nodes 0)
              (push `((name . ,(symbol-name (cadr form)))
                      (kind . ,(symbol-name (car form)))
                      (line . ,line)
                      (form . ,(runtime-provider--json-form form)))
                    records)))))
      (push `((path . ,relative) (forms . ,(vconcat (nreverse records)))
              (writes . ,(vconcat (sort (delete-dups writes) #'string<)))
              (effects . ,(vconcat (nreverse effects)))) output)))
  (princ (json-encode `((reader . "GNU Emacs read; no inspected-source evaluation")
                        (files . ,(vconcat (nreverse output)))))))

;;; runtime-provider-read.el ends here
