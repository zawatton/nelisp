;;; probe-build.el --- N4 cache canonical object fixture -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'nelisp-standalone-build)
(require 'nelisp-aot-compiler)
(let* ((source (getenv "PROBE_SOURCE")) (out (getenv "PROBE_OBJECT"))
       (names '(nl_frame_stack_limit_setup nl_frame_stack_limit nl_n4_mark_env nl_n4_rewrite_env))
       (forms nil))
  (with-temp-buffer
    (insert-file-contents source)
    (dolist (name names)
      (goto-char (point-min))
      (unless (re-search-forward (concat "^[ \t]*(defun " (symbol-name name) "[ \t\n]") nil t)
        (error "Missing canonical function %s" name))
      (goto-char (match-beginning 0))
      (push (read (current-buffer)) forms)))
  (setq forms
        (append (nreverse forms)
                '((defun nl_root_mark (env) 0)
                  (defun nl_root_reserve (env) (extern-call probe_root env))
                  (defun nl_root_release (env mark) 0)
                  (defun nl_alloc_symbol (bytes len out) 0)
                  (defun nl_word_payload (word) word)
                  (defun nl_word_clone (word) (+ word 6))
                  (defun nelisp_mirror_lookup_entry (env name) (extern-call probe_entry env))
                  (defun nl_n4_state (env) (heap-read-u64 env 176))
                  (defun nl_record_slot_word (record index) (heap-read-u64 (- record 6) (+ 16 (* index 8))))
                  (defun bf_dynamic_lookup_w (env name pad) (extern-call probe_unexpected_local env name))
                   (defun nl_thread_registry_find (env) 0)
                  (defun nelisp_frame_stack_find_kind (frames name dyn pad) 0)
                  (defun nl_cell_get_value_w (cell pad) 3)
                  (defun nl_gc_mark_word (word) (extern-call probe_mark word))
                  (defun nl_compact_rw_word_edge (address) address)
                  (defun nl_compact_rw_word (address) (extern-call probe_rewrite address))
                  (defun nl_gc_mark_slot (address) (extern-call probe_slot address))
                  (defun nl_compact_rw_slot (address) (extern-call probe_slot address))
                  (defun nl_n4_record (state index) (+ state (+ 64 (* index 160)))))))
  (nelisp-aot-compile-to-object (cons 'seq forms) out)
  (princ "PROBE compiled canonical-functions=4\n"))
