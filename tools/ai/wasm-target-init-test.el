;;; wasm-target-init-test.el --- Target contract tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'wasm-target-init-controls)

(ert-deftest wasm-target-init/parser ()
  (should (equal (alist-get 'expected (wasm-target-init--parse '(ptr-write-u64 base 0 base))) ["base" "0"]))
  (should (equal (alist-get 'expected (wasm-target-init--parse '(ptr-write-u64 (+ base 8) 0 (+ base 32)))) ["base" "32"]))
  (should (equal (alist-get 'expected (wasm-target-init--parse '(ptr-write-u64 base 0 size))) ["size" "0"]))
  (should (equal (alist-get 'owner (wasm-target-init--parse '(ptr-write-u64 (nl_freelist_small_mask_ptr) 0 0))) "nl_freelist_small_mask"))
  (dolist (form '(nil (ptr-write-u32 base 0 0) (ptr-write-u64 16 0 0)
                     (ptr-write-u64 base 1 0) (ptr-write-u64 (+ base 1) 0 0)
                     (ptr-write-u64 (+ base unknown) 0 0) (ptr-write-u64 base 0 (eval 1))
                     (ptr-write-u64 (data-addr unknown) 0 0) (ptr-write-u64 base 0 1 extra)))
    (should (string-prefix-p "Unresolved init form" (error-message-string (should-error (wasm-target-init--parse form)))))))

(ert-deftest wasm-target-init/inputs ()
  (dolist (inputs '(nil (:target wasm32) (:target linux-x86_64 :arena-size 1048576 :intern-region excluded)
                       (:target wasm32 :arena-size 1048576 :intern-region included)
                       (:target wasm32 :arena-size "1048576" :intern-region excluded)))
    (should-error (wasm-target-init-contract inputs)))
  (let* ((c (wasm-target-init-contract)) (forms (plist-get c :forms)) (ds (plist-get c :data-start)))
    (should (equal (plist-get c :inputs) wasm-target-init-inputs))
    (should (= (length forms) (length (plist-get c :words))))
    (should (> (length forms) 0))
    (should (string-match-p "\\`[[:xdigit:]]\\{64\\}\\'" (plist-get c :generator-sha256)))
    (should (equal (plist-get c :forms-sha256) (wasm-rootstack--definition-hash forms)))
    (should (wasm-target-init--validate (list :target 'wasm32 :arena-size ds :intern-region 'excluded) forms ds))
    (should (string-prefix-p "Undersize arena" (error-message-string
                                              (should-error (wasm-target-init--validate
                                                             (list :target 'wasm32 :arena-size (1- ds) :intern-region 'excluded)
                                                             forms ds)))))
    (should-error (wasm-target-init--validate wasm-target-init-inputs (append forms (list (car forms))) ds))
    (should (equal (cl-subseq (nth 2 (nth 3 (wasm-target-init--init-definition c))) 2 -1) forms))))

(ert-deftest wasm-target-init/rewrite-native-equivalence ()
  (let ((nelisp-standalone--target 'linux-x86_64)
        (source nelisp-cc-rootstack--source))
    (should (equal (wasm-target-init-rewrite source) (nelisp-standalone--chunk-arena-rewrite source)))
    (should (= (length (wasm-target-init--raw-offsets source)) 4))
    (should (= (wasm-target-init--assert-rewritten (wasm-target-init-rewrite source)) 0)))
  (let* ((base (nelisp-standalone-arena-rewrite-base)) (span (nelisp-standalone-arena-rewrite-span))
         (outside (list (1- base) (+ base span) 0 4096 1048576))
         (nelisp-standalone--target 'linux-x86_64))
    (should (equal (wasm-target-init-rewrite outside) outside))
    (should (equal (wasm-target-init-rewrite `(seq ,base ,(1- (+ base span))
                                                  (defun nl_arena_init () ,base)))
                   (nelisp-standalone--chunk-arena-rewrite `(seq ,base ,(1- (+ base span))
                                                                (defun nl_arena_init () ,base)))))))

(ert-deftest wasm-target-init/owners ()
  (let* ((authority (wasm-target-init-authority)) (owners (plist-get authority :owners))
         (contract (wasm-target-init-contract)) (source (wasm-target-init--source contract owners))
         (layout (wasm-rootstack-layout source)))
    (dolist (name '(nl_arena_base nl_freelist_small_mask))
      (let ((row (cl-find name owners :key (lambda (x) (plist-get x :name)))))
        (should (= (plist-get row :size) 8))
        (should (= (- (wasm-rootstack--number (plist-get row :end-expression) wasm-rootstack--layout-inputs)
                      (wasm-rootstack--number (plist-get row :offset-expression) wasm-rootstack--layout-inputs))
                   (plist-get row :size)))
        (should (> (cdr (assoc (symbol-name name) (plist-get layout :symbol-addrs))) 0))))
    (should (equal (plist-get authority :layout-inputs) wasm-rootstack--layout-inputs))
    (should-not (wasm-rootstack--forms source (lambda (f) (eq (car-safe f) 'nl_intern_region_init))))
    (should (equal (cl-find 'nl_rootstack_init (cdr source) :key #'cadr)
                   (cl-find 'nl_rootstack_init (cdr nelisp-cc-rootstack--source) :key #'cadr)))))

(ert-deftest wasm-target-init/owner-cache-isolation ()
  (let ((wasm-rootstack--oracle-cache (make-hash-table :test #'equal))
        (wasm-target-init--owner-oracle-cache (make-hash-table :test #'equal)))
    (let* ((standard (wasm-rootstack-authority))
           (extended (wasm-target-init-authority)))
      (should (= (length (plist-get standard :owners)) 6))
      (should (= (length (plist-get extended :owners)) 8))
      (should (= (hash-table-count wasm-rootstack--oracle-cache) 1))
      (should (= (hash-table-count wasm-target-init--owner-oracle-cache) 1))
      (should (equal (plist-get standard :native-oracle)
                     (plist-get (wasm-rootstack-authority) :native-oracle))))))

(ert-deftest wasm-target-init/executed-controls ()
  (let ((results (wasm-target-init-controls)))
    (should (= (length results) 28))
    (dolist (row results) (should (= (alist-get 'rc row) 1)) (should (> (length (alist-get 'message row)) 0)))))
(ert-deftest wasm-target-init/oracle-load-selection ()
  (let* ((dir (make-temp-file (expand-file-name "target/wasm-target-init/oracle-selection-") t))
         (source (expand-file-name "provider.el" dir)) (compiled (concat source "c")))
    (unwind-protect
        (progn
          (with-temp-file source (insert "source"))
          (let ((record (list (cons source (wasm-rootstack--hash source)))))
            (should (wasm-rootstack--oracle-files-current-p record))
            (with-temp-file compiled (insert "compiled"))
            (set-file-times source (seconds-to-time 100))
            (set-file-times compiled (seconds-to-time 200))
            (should-not (wasm-rootstack--oracle-files-current-p record))
            (should (wasm-rootstack--oracle-files-current-p record (list source)))
            (should-not (wasm-rootstack--oracle-files-current-p
                         (list (cons source (make-string 64 ?0))) (list source)))
            (should (wasm-rootstack--oracle-files-current-p
                     (append record (list (cons compiled (wasm-rootstack--hash compiled))))))
            (set-file-times compiled (seconds-to-time 100))
            (should-not (wasm-rootstack--oracle-files-current-p record))
            (should (wasm-rootstack--oracle-files-current-p
                     (append record (list (cons compiled (wasm-rootstack--hash compiled))))))
            (set-file-times compiled (seconds-to-time 50))
            (should (wasm-rootstack--oracle-files-current-p record)))
          (let ((record (list (cons compiled (wasm-rootstack--hash compiled)))))
            (set-file-times compiled (seconds-to-time 200))
            (should (wasm-rootstack--oracle-files-current-p record))
            (set-file-times source (seconds-to-time 300))
            (should-not (wasm-rootstack--oracle-files-current-p record))
            (set-file-times source (seconds-to-time 200))
            (should (wasm-rootstack--oracle-files-current-p record))
            (delete-file source)
            (should (wasm-rootstack--oracle-files-current-p record))
            (with-temp-file compiled (insert "changed"))
            (should-not (wasm-rootstack--oracle-files-current-p record))))
      (delete-directory dir t))))

(ert-deftest wasm-target-init/integer-precision ()
  (let ((original (symbol-function 'wasm-target-init-contract))
        (large 9007199254740993))
    (should (equal (alist-get 'expected (wasm-target-init--parse
                                       `(ptr-write-u64 (+ base 8) 0 ,large)))
                   ["integer" "9007199254740993"]))
    ;; Synthetic permitted seed, kept distinct from genuine acceptance artifacts.
    (cl-letf (((symbol-function 'wasm-target-init-contract)
               (lambda (&optional inputs)
                 (let* ((c (copy-tree (if inputs (funcall original inputs) (funcall original))))
                        (forms (plist-get c :forms)))
                   (setf (nth 3 (cadr forms)) large)
                   (plist-put c :words (wasm-target-init--validate (plist-get c :inputs) forms (plist-get c :data-start)))
                   (plist-put c :forms-sha256 (wasm-rootstack--definition-hash forms))
                   c))))
      (let* ((path (wasm-target-init-build nil "target/wasm-target-init/precision.wasm" t))
             (result (wasm-target-init--node path))
             (json-object-type 'alist) (json-array-type 'vector)
             (manifest (json-read-file (concat path ".json"))))
        (should (equal (car result) 0))
        (should (equal (aref (alist-get 'expected (aref (alist-get 'contract_words manifest) 1)) 1)
                       "9007199254740993"))
        (princ (format "integer-roundtrip=9007199254740993 exact=true rc=%s\n" (car result)))))))
(ert-deftest wasm-target-init/checker-closed-grammar ()
  (let* ((path (wasm-target-init-build nil "target/wasm-target-init/grammar.wasm" t))
         (json-object-type 'alist) (json-array-type 'vector)
         (manifest (json-read-file (concat path ".json"))))
    (dolist (form '(nil (ptr-write-u32 base 0 0) (ptr-write-u64 base 1 0)
                       (ptr-write-u64 16 0 0) (ptr-write-u64 (+ base 1) 0 0)
                       (ptr-write-u64 base 0 (eval 1)) (ptr-write-u64 base 0 "1")
                       (ptr-write-u64 (data-addr unknown) 0 0)))
      (let ((text (prin1-to-string (list form))))
        (setf (alist-get 'seed_forms manifest) text
              (alist-get 'seed_forms_sha256 manifest) (secure-hash 'sha256 text)))
      (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/grammar.json" manifest))
             (result (wasm-target-init--node path json)))
        (should (equal (car result) 1))
        (should (string-match-p "Unresolved init form" (cdr result)))))
    ;; A mutually consistent synthetic record must match the on-disk authority.
    (setq manifest (json-read-file (concat path ".json")))
    (let ((definition "(defconst nelisp-standalone--arena-data-start-offset 816)"))
      (setf (alist-get 'data_start manifest) "816"
            (alist-get 'oracle_data_start manifest)
            `((value . "816") (definition . ,definition) (sha256 . ,(secure-hash 'sha256 definition)))))
    (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/seed-bound.json" manifest))
           (result (wasm-target-init--node path json)))
      (should (equal (car result) 1))
      (should (string-match-p "data-start authority text disagrees with hashed build source" (cdr result))))))
(ert-deftest wasm-target-init/oracle-tied-mtime-warm-cache ()
  (require 'wasm-rootstack-full-test)
  (let ((wasm-rootstack--oracle-cache (make-hash-table :test #'equal)))
    (wasm-rootstack-full--with-native-copy
     "(require 'audit-redef)"
     (lambda (root)
       (let* ((source (expand-file-name "lisp/audit-redef.el" root))
              (compiled (concat source "c"))
              (message "Native layout oracle disagreement: nl_root_pin_region syntactic=(4253888 . 524288) native=(4253888 . 262144)"))
         (require 'bytecomp)
         (should (byte-compile-file source))
         (with-temp-file source
           (insert "(defconst nelisp-standalone--root-pin-slots 16384)\n(provide 'audit-redef)\n"))
         (set-file-times source (seconds-to-time 200))
         (set-file-times compiled (seconds-to-time 100))
         (let* ((oracle (plist-get (wasm-rootstack-authority) :native-oracle))
                (files (plist-get oracle :files)))
           (should (assoc source files))
           (should-not (assoc compiled files))
           (should (eq oracle (plist-get (wasm-rootstack-authority) :native-oracle)))
           ;; Only the unrecorded bytecode's mtime changes; recorded hashes agree.
           (set-file-times compiled (seconds-to-time 200))
           (should-not (wasm-rootstack--oracle-files-current-p files))
           (should (equal message (error-message-string (should-error (wasm-rootstack-authority))))))
         (clrhash wasm-rootstack--oracle-cache)
         (should (equal message (error-message-string (should-error (wasm-rootstack-authority)))))
         (princ "tied-mtime warm-cache=rejected fresh=rejected\n")))
     "(defconst nelisp-standalone--root-pin-slots 8192)\n(provide 'audit-redef)\n")))

(ert-deftest wasm-target-init/base-u64-wrapping ()
  (let ((original (symbol-function 'wasm-target-init-contract))
        (value '(+ base -9007199254740993)))
    ;; Keep the signed displacement exact; the Wasm i64 store wraps the sum.
    (should (equal (wasm-target-init--value value) ["base" "-9007199254740993"]))
    (cl-letf (((symbol-function 'wasm-target-init-contract)
               (lambda (&optional inputs)
                 (let* ((c (copy-tree (if inputs (funcall original inputs) (funcall original))))
                        (forms (plist-get c :forms)))
                   (setf (nth 3 (cadr forms)) value)
                   (plist-put c :words (wasm-target-init--validate (plist-get c :inputs) forms (plist-get c :data-start)))
                   (plist-put c :forms-sha256 (wasm-rootstack--definition-hash forms))
                   c))))
      (let* ((path (wasm-target-init-build nil "target/wasm-target-init/wrapping.wasm" t))
             (result (wasm-target-init--node path)))
        (should (equal (car result) 0))
        (princ (format "base-u64-wrapping=-9007199254740993 exact=true rc=%s\n" (car result)))))))

(ert-deftest wasm-target-init/checker-owner-authority ()
  (let* ((path (wasm-target-init-build nil "target/wasm-target-init/owner-grammar.wasm" t))
         (json-object-type 'alist) (json-array-type 'vector)
         (original (json-read-file (concat path ".json"))))
    (dolist (mutation '(duplicate extra missing extent address zero unaligned arena-size provenance))
      (let* ((manifest (copy-tree original t))
             (owners (alist-get 'owners manifest)) (row (aref owners 0))
             (expected
              (pcase mutation
                ((or 'duplicate 'extra 'missing) "required owner set")
                ('address "owner export") ('arena-size "arena size agrees with module")
                (_ "manifest size disagrees with module extent"))))
        (pcase mutation
          ('duplicate (setf (alist-get 'owners manifest) (vconcat owners (vector (copy-tree row)))))
          ('extra (setf (alist-get 'name row) "nl_extra"))
          ('missing (setf (alist-get 'owners manifest) (cl-subseq owners 1)))
          ('extent (setf (alist-get 'size row) "16"))
          ('address (setf (alist-get 'address (aref owners 1)) "4096"))
          ('zero (setf (alist-get 'size row) "0"))
          ('unaligned (setf (alist-get 'size row) "7"))
          ('arena-size (setf (alist-get 'arena_size (alist-get 'inputs manifest)) "8"))
          ('provenance
           ;; Node deliberately does not authenticate declaration syntax/offsets.
           ;; These are the Lisp resolver/native oracle/ERT's responsibility.
           (setf (alist-get 'native_offset row) "9"
                 (alist-get 'declaration_offset_expression row) "(unchecked offset)"
                 (alist-get 'declaration_end_expression row) "(unchecked end)")))
        (should-not (alist-get 'offset_expression row))
        (should-not (alist-get 'end_expression row))
        (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/owner-grammar.json" manifest))
               (result (wasm-target-init--node path json)))
          (if (eq mutation 'provenance)
              (should (equal (car result) 0))
            (should (equal (car result) 1))
            (should (string-match-p expected (cdr result)))))))))

(ert-deftest wasm-target-init/oracle-explicit-helper-newer-bytecode ()
  (require 'wasm-rootstack-full-test)
  (require 'bytecomp)
  (let ((lane-root wasm-rootstack--root))
    (wasm-rootstack-full--with-native-copy
     ""
     (lambda (root)
       (make-directory (expand-file-name "tools/ai" root) t)
       (let* ((seed (expand-file-name "tools/ai/wasm-target-init-oracle.el" root))
              (native (expand-file-name "tools/ai/wasm-rootstack-full-native-oracle.el" root))
              (wasm-rootstack--oracle-helper native)
              (wasm-rootstack--oracle-cache (make-hash-table :test #'equal))
              (wasm-target-init--cache nil)
              results)
         (dolist (helper (list seed native))
           (copy-file (expand-file-name (file-relative-name helper root) lane-root) helper))
         (should (wasm-target-init--oracle 1048576))
         (should (wasm-rootstack--native-oracle (expand-file-name "scripts/nelisp-standalone-build.el" root)))
         (dolist (helper (list seed native))
           (let ((byte-compile-warnings nil)) (should (byte-compile-file helper)))
           (set-file-times helper (seconds-to-time 100))
           (set-file-times (concat helper "c") (seconds-to-time 200)))
         ;; Fresh children, not cached successes, must explicitly load .el.
         (setq wasm-target-init--cache nil)
         (clrhash wasm-rootstack--oracle-cache)
         (dolist (kind '(seed native))
           (push (condition-case err
                     (let* ((record (if (eq kind 'seed) (wasm-target-init--oracle 1048576)
                                      (wasm-rootstack--native-oracle
                                       (expand-file-name "scripts/nelisp-standalone-build.el" root))))
                            (helper (if (eq kind 'seed) seed native)))
                       (should (assoc helper (plist-get record :files)))
                       (should-not (assoc (concat helper "c") (plist-get record :files)))
                       (princ (format "explicit-helper=%s fresh=newer-elc accepted=true\n" kind))
                       t)
                   (error (princ (format "explicit-helper=%s error=%s\n" kind (error-message-string err))) nil))
                 results))
         (should (equal results '(t t))))))))

(ert-deftest wasm-target-init/coverage-without-size-crosscheck ()
  ;; Prove coverage is closed even if the manifest size cross-check is removed.
  ;; Only the scratch checker is changed; production has no bypass option.
  (let* ((checker "target/wasm-target-init/check-without-size.mjs")
         (good (wasm-target-init-build nil "target/wasm-target-init/coverage-good.wasm" t))
         (bad (wasm-target-init--fault-build 'bss-stray-write))
         (json-object-type 'alist) (json-array-type 'vector)
         (original (json-read-file (concat bad ".json"))))
    (with-temp-buffer
      (insert-file-contents "tools/ai/wasm-target-init-check.mjs")
      (let ((line "      equal(decimal(recorded.size, 'owner size'), BigInt(owner.size), `manifest size disagrees with module extent ${owner.name}`);"))
        (should (search-forward line nil t))
        (replace-match "      // Size cross-check removed only for this coverage test." t t)
        (should-not (search-forward line nil t)))
      (write-region (point-min) (point-max) checker nil 'silent))
    (cl-labels ((run (module &optional json)
                 (with-temp-buffer
                   (let ((rc (apply #'call-process "bash" nil t nil
                                    "-c" "ulimit -v 8388608; exec \"$@\"" "coverage"
                                    "timeout" "120" "node" "--disable-wasm-trap-handler"
                                    checker module (and json (list json)))))
                     (cons rc (buffer-string))))))
      ;; The weakened checker must still execute a successful baseline.
      (should (equal (car (run good)) 0))
      (dolist (mutation '(normal size two-field))
        (let* ((manifest (copy-tree original t))
               (row (cl-find "nl_thread_parallel_ctx" (alist-get 'owners manifest)
                             :key (lambda (owner) (alist-get 'name owner)) :test #'equal)))
          (unless (eq mutation 'normal) (setf (alist-get 'size row) "56"))
          (when (eq mutation 'two-field)
            (setf (alist-get 'end_expression row) "(+ 57616 4194304 96 176 56)"))
          (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/coverage.json" manifest))
                 (result (run bad json)))
            (should (equal (car result) 1))
            (should (string-match-p (regexp-quote "post-arena BSS nl_thread_parallel_ctx+56") (cdr result)))
            (princ (format "coverage-size-check=skipped mutation=%s rc=1 stray-word=caught\n" mutation))))))))

(ert-deftest wasm-target-init/module-boundaries ()
  (let ((original (symbol-function 'wasm-target-init--source)))
    (dolist (mutation '(unaligned-end reversed-end duplicate-address))
      (cl-letf (((symbol-function 'wasm-target-init--source)
                 (lambda (contract owners &optional skip)
                   (mapcar
                    (lambda (form)
                      (cond
                       ((and (eq (car-safe form) 'defun) (eq (cadr form) 'address-end))
                        (pcase mutation
                          ('unaligned-end '(defun address-end () (+ (data-addr wasm_target_init_end) -1)))
                          ('reversed-end '(defun address-end () (data-addr nl_freelist_small_mask)))
                          (_ form)))
                       ((and (eq mutation 'duplicate-address) (eq (car-safe form) 'defun)
                             (eq (cadr form) 'address-nl_rootstack_region))
                        '(defun address-nl_rootstack_region () (data-addr nl_rootstack_top)))
                       (t form)))
                    (funcall original contract owners skip)))))
        (let* ((path (wasm-target-init-build nil (format "target/wasm-target-init/boundary-%s.wasm" mutation) t))
               (result (wasm-target-init--node path)))
          (should (equal (car result) 1))
          (should (string-match-p (if (eq mutation 'unaligned-end) "BSS end alignment" "owner contiguity/alignment")
                                  (cdr result))))))))

(ert-deftest wasm-target-init/oracle-vendor-newer-source ()
  (require 'wasm-rootstack-full-test)
  (let ((lane-root wasm-rootstack--root))
    (wasm-rootstack-full--with-native-copy
     ""
     (lambda (root)
       ;; Mutate isolated provider copies only, never the lane's src/ files.
       (delete-file (expand-file-name "src" root))
       (make-directory (expand-file-name "src" root))
       (make-symbolic-link (expand-file-name "vendor" lane-root) (expand-file-name "vendor" root))
       (dolist (file (directory-files (expand-file-name "src" lane-root) t "\\`[^.]"))
         (let ((target (expand-file-name (file-name-nondirectory file) (expand-file-name "src" root))))
           (if (member (file-name-nondirectory file) '("nelisp-vendor-source.el" "nelisp-vendor-source.elc"))
               (copy-file file target)
             (make-symbolic-link file target))))
       (make-directory (expand-file-name "tools/ai" root) t)
       (copy-file (expand-file-name "tools/ai/wasm-target-init-oracle.el" lane-root)
                  (expand-file-name "tools/ai/wasm-target-init-oracle.el" root))
       (let* ((source (expand-file-name "src/nelisp-vendor-source.el" root))
              (compiled (concat source "c"))
              (wasm-target-init--cache nil))
         (set-file-times source (seconds-to-time 100))
         (set-file-times compiled (seconds-to-time 200))
         (let ((warm (wasm-target-init--oracle 1048576)))
           (should (assoc compiled (plist-get warm :files)))
           (with-temp-buffer (insert "\n;; Freshness regression.\n") (write-region (point-min) (point-max) source t 'silent))
           (set-file-times source (seconds-to-time 300))
           (let ((selected (wasm-target-init--oracle 1048576)))
             (should-not (eq warm selected))
             (should (assoc source (plist-get selected :files)))
             (setq wasm-target-init--cache nil)
             (let ((fresh (wasm-target-init--oracle 1048576)))
               (should (assoc source (plist-get fresh :files)))
               (should (equal (plist-get selected :forms) (plist-get fresh :forms)))
               (princ "vendor-selection reused=nil warm-elc=t selected-el=t fresh-el=t forms-equal=t\n")))))))))

(ert-deftest wasm-target-init/rewrite-negative-controls ()
  (let ((original (symbol-function 'wasm-target-init-rewrite))
        (body (ert-test-body (ert-get-test 'wasm-target-init/rewrite-native-equivalence)))
        (base (nelisp-standalone-arena-rewrite-base))
        (span (nelisp-standalone-arena-rewrite-span)))
    (funcall body)
    (dolist (mutation '(offset span))
      (cl-letf (((symbol-function 'wasm-target-init-rewrite)
                 (lambda (source)
                   ;; Change only the adapter's accessors, never the native side.
                   (cl-letf (((symbol-function 'nelisp-standalone-arena-rewrite-base)
                              (lambda () (if (eq mutation 'offset) (1+ base) base)))
                             ((symbol-function 'nelisp-standalone-arena-rewrite-span)
                              (lambda () (if (eq mutation 'span) (1- span) span))))
                     (funcall original source)))))
        (should-error (funcall body) :type 'ert-test-failed)
        (princ (format "rewrite-mutation=%s native-equivalence=rejected\n" mutation))))
    (funcall body)))

(ert-deftest wasm-target-init/arena-coverage-independent ()
  ;; Remove only the new authority-text cross-check in a scratch checker.
  ;; The exact four-leaf edit must still fail on actual arena memory contents.
  (let* ((good (wasm-target-init-build nil "target/wasm-target-init/arena-coverage-good.wasm" t))
         (bad (wasm-target-init--fault-build 'stray-write))
         (json-object-type 'alist) (json-array-type 'vector)
         (original (json-read-file (concat bad ".json")))
         (manifest (wasm-target-init--audit4-edit (copy-tree original t)))
         (checker "target/wasm-target-init/arena-coverage-check.mjs"))
    ;; All other leaves, including seed forms and source/module hashes, stay put.
    (let ((restored (copy-tree manifest t)))
      (setf (alist-get 'data_start restored) (alist-get 'data_start original)
            (alist-get 'oracle_data_start restored) (alist-get 'oracle_data_start original))
      (should (equal restored original)))
    (with-temp-buffer
      (insert-file-contents "tools/ai/wasm-target-init-check.mjs")
      (let ((line "    same(readForm(oracle.definition), readForm(sourceDefinition(buildSource, 'defconst', 'nelisp-standalone--arena-data-start-offset')), 'data-start authority text disagrees with hashed build source');"))
        (should (search-forward line nil t))
        (replace-match "    // Authority cross-check removed only for this coverage test." t t)
        (should-not (search-forward line nil t)))
      (write-region (point-min) (point-max) checker nil 'silent))
    (cl-labels ((run (module &optional json)
                 (with-temp-buffer
                   (let ((rc (apply #'call-process "bash" nil t nil
                                    "-c" "ulimit -v 8388608; exec \"$@\"" "arena-coverage"
                                    "timeout" "120" "node" "--disable-wasm-trap-handler"
                                    checker module (and json (list json)))))
                     (cons rc (buffer-string))))))
      (should (equal (car (run good)) 0))
      (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/audit4-coverage.json" manifest))
             (result (run bad json)))
        (should (equal (car result) 1))
        (should (string-match-p (regexp-quote "unseeded arena word +1016") (cdr result)))
        (princ "audit4-four-leaf authority-check=skipped rc=1 unseeded-arena-word=1016 caught=true\n"))
      ;; Retain the earlier highest-seed cross-check independently too.
      (let ((definition "(defconst nelisp-standalone--arena-data-start-offset 816)"))
        (setf (alist-get 'data_start manifest) "816"
              (alist-get 'oracle_data_start manifest)
              `((value . "816") (definition . ,definition) (sha256 . ,(secure-hash 'sha256 definition)))))
      (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/highest-seed.json" manifest))
             (result (run bad json)))
        (should (equal (car result) 1))
        (should (string-match-p "data-start > highest seeded offset" (cdr result)))))))

(ert-deftest wasm-target-init/checker-authority-text ()
  (let* ((path (wasm-target-init-build nil "target/wasm-target-init/authority-text.wasm" t))
         (json-object-type 'alist) (json-array-type 'vector)
         (manifest (json-read-file (concat path ".json"))))
    (should (equal (car (wasm-target-init--node path)) 0))
    ;; Raw source has comments, multiline strings and #x400; the manifest's
    ;; printed representation has none of those formatting choices.
    (with-temp-buffer
      (emacs-lisp-mode)
      (insert-file-contents "scripts/nelisp-standalone-build.el")
      (dolist (spec '(("defconst" "nelisp-standalone--arena-data-start-offset" data)
                      ("defun" "nelisp-standalone--arena-init-metadata-forms-dynamic" generator)))
        (goto-char (point-min))
        (should (re-search-forward (concat "^(" (car spec) " " (cadr spec) "[ (\n]") nil t))
        (goto-char (match-beginning 0))
        (let* ((start (point)) (_ (read (current-buffer)))
               (text (buffer-substring-no-properties start (point))))
          (if (eq (nth 2 spec) 'data)
              (let ((oracle (alist-get 'oracle_data_start manifest)))
                (setf (alist-get 'definition oracle) text
                      (alist-get 'sha256 oracle) (secure-hash 'sha256 text)))
            (setf (alist-get 'generator_definition manifest) text
                  (alist-get 'generator_sha256 manifest) (secure-hash 'sha256 text))))))
    (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/raw-authorities.json" manifest))
           (result (wasm-target-init--node path json)))
      (should (equal (car result) 0))
      (princ "authority-source raw-and-printed=equivalent rc=0\n"))
    ;; Keep Unicode in genuine-definition comments, including apparent syntax
    ;; and Unicode line separators, while retaining the original form exactly.
    (let* ((original (alist-get 'generator_definition manifest))
           (comment (concat "; Unicode comment: 日本語 " (string #xfeff #x2028) " ) \"\n"))
           (text (replace-regexp-in-string "; chunk-0 bump cursor" (concat comment "; chunk-0 bump cursor") original t t)))
      (should-not (equal text original))
      (should (equal (car (read-from-string text)) (car (read-from-string original))))
      (setf (alist-get 'generator_definition manifest) text
            (alist-get 'generator_sha256 manifest) (secure-hash 'sha256 text))
      (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/unicode-comment.json" manifest))
             (result (wasm-target-init--node path json)))
        (should (equal (car result) 0))
        (princ "authority-source unicode-comment=equivalent rc=0\n")))
    ;; The build-script hash is mandatory even if every other identity matches.
    (setf (alist-get 'source_sha256 manifest)
          (vconcat (cl-remove "scripts/nelisp-standalone-build.el" (alist-get 'source_sha256 manifest)
                              :key (lambda (row) (aref row 0)) :test #'equal)))
    (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/missing-build-identity.json" manifest))
           (result (wasm-target-init--node path json)))
      (should (equal (car result) 1))
      (should (string-match-p "hashed build source required" (cdr result))))))

(ert-deftest wasm-target-init/checker-ascii-separators ()
  (let* ((path (wasm-target-init-build nil "target/wasm-target-init/separators.wasm" t))
         (json-object-type 'alist) (json-array-type 'vector)
         (original (json-read-file (concat path ".json"))))
    (should (equal (car (wasm-target-init--node path)) 0))
    (dolist (code '(32 9 10 13 12))
      (let* ((manifest (copy-tree original t))
             (separator (string code))
             (seed (replace-regexp-in-string "ptr-write-u64 base" (concat "ptr-write-u64" separator "base")
                                            (alist-get 'seed_forms manifest) t t))
             (generator (replace-regexp-in-string "(base-sym size)" (concat "(base-sym" separator "size)")
                                                 (alist-get 'generator_definition manifest) t t)))
        ;; Verify FF and every other admitted separator in GNU Emacs, too.
        (should (equal (car (read-from-string seed)) (car (read-from-string (alist-get 'seed_forms original)))))
        (should (equal (car (read-from-string generator))
                       (car (read-from-string (alist-get 'generator_definition original)))))
        (setf (alist-get 'seed_forms manifest) seed
              (alist-get 'seed_forms_sha256 manifest) (secure-hash 'sha256 seed)
              (alist-get 'generator_definition manifest) generator
              (alist-get 'generator_sha256 manifest) (secure-hash 'sha256 generator))
        (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/separators.json" manifest))
               (result (wasm-target-init--node path json)))
          (should (equal (car result) 0))
          (princ (format "ascii-separator=U+%04X emacs-and-node=true rc=0\n" code)))))
    (dolist (code '(#xfeff #x2028))
      (let ((manifest (copy-tree original t)))
        (wasm-target-init--audit5-edit manifest 'seed_forms code)
        (let ((form (car (car (read-from-string (alist-get 'seed_forms manifest))))))
          (should (eq (car form) (intern (concat "ptr-write-u64" (string code) "base"))))
          (should-error (wasm-target-init--parse form)))
        (wasm-target-init--audit5-edit manifest 'generator_definition code)
        (should-not (equal (nth 2 (car (read-from-string (alist-get 'generator_definition manifest))))
                           (nth 2 (car (read-from-string (alist-get 'generator_definition original))))))))
    ;; Reject C0 controls, DEL, Unicode whitespace and symbol constituents in
    ;; both authority/seed syntax. Exercise token interiors and token starts.
    (dolist (code '(0 1 11 31 127 160 8232 8233 65279 26085 128512))
      (dolist (field '(seed_forms generator_definition))
        (let* ((manifest (copy-tree original t))
               (_ (wasm-target-init--audit5-edit manifest field code))
               (json (wasm-target-init--write-manifest "target/wasm-target-init/unsupported-character.json" manifest))
               (result (wasm-target-init--node path json)))
          (should (equal (car result) 1))
          (should (string-match-p (regexp-quote (format "unsupported character U+%04X in Lisp syntax" code)) (cdr result)))))
      (let* ((manifest (copy-tree original t))
             (text (concat (string code) (alist-get 'seed_forms manifest))))
        (setf (alist-get 'seed_forms manifest) text
              (alist-get 'seed_forms_sha256 manifest) (secure-hash 'sha256 text))
        (let* ((json (wasm-target-init--write-manifest "target/wasm-target-init/unsupported-leading.json" manifest))
               (result (wasm-target-init--node path json)))
          (should (equal (car result) 1))
          (should (string-match-p (regexp-quote (format "unsupported character U+%04X in Lisp syntax" code)) (cdr result))))))
    (princ "unsupported-syntax characters=11 positions=3 rejected=33\n")))

