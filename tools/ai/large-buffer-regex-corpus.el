(lbc-case "fold-off" (lbc-sm "ABC" "xabc" nil nil))
(lbc-case "fold-prefix-bol" (lbc-sm "^(DeFun " "x\n(defun foo" nil t))
(lbc-case "fold-prefix-bol-off" (lbc-sm "^(DeFun " "x\n(defun foo" nil nil))
(lbc-case "class-alpha" (lbc-sm "[[:alpha:]]+" "12ab34"))
(lbc-case "class-digit" (lbc-sm "[[:digit:]]+" "ab34cd"))
(lbc-case "class-neg" (lbc-sm "[^a-c]+" "abcxyz"))
(lbc-case "word-class" (lbc-sm "\\w+" "  foo_bar"))
(lbc-case "space-class" (lbc-sm "\\s-+" "a \t b"))
(lbc-case "interval" (lbc-sm "a\\{2,3\\}" "caaaa"))
(lbc-case "shy-group" (lbc-sm "\\(?:ab\\)+c" "xababc"))
(lbc-case "alt" (lbc-sm "foo\\|ba[rz]" "xbaz"))
