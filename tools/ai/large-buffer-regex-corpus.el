(lbc-case "start-arg" (lbc-sm "a" "aXa" 1))
(lbc-case "start-bol" (lbc-sm "^a" "a\na" 1))
(lbc-case "empty-match" (lbc-sm "x*" "abc"))
(lbc-case "jp-literal" (lbc-sm "日本" "これは日本語です"))
(lbc-case "jp-bol" (lbc-sm "^日" "あ\n日本"))
(lbc-case "jp-class" (lbc-sm "[あ-ん]+" "ABCひらがなXYZ"))
(lbc-case "jp-dot" (lbc-sm ".本" "これは日本語"))
