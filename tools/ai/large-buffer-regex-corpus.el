;;; large-buffer-regex-corpus.el --- regexp differential corpus  -*- lexical-binding: nil; -*-
;; Prints one line per case.  Run on the NeLisp standalone binary and on host
;; `emacs --batch -Q -l'; the two outputs must be byte-identical.
;; Each result is (RETURN POINT BEG0 END0 BEG1 END1 BEG2 END2) or (error SYMBOL).

;; With LBC_NLRE=1 on host Emacs the pure-elisp engine (lisp/nelisp-stdlib-regexp.el,
;; loaded by the caller) is exercised instead of the native primitives.
(defvar lbc-n 0)
(defvar lbc-nlre (getenv "LBC_NLRE"))
(defun lbc-string-match (re s start)
  (if lbc-nlre (nlre-string-match re s start) (string-match re s start)))
(defun lbc-rsf (&rest a) (apply (if lbc-nlre 'nlre--re-search-forward 're-search-forward) a))
(defun lbc-la (&rest a) (apply (if lbc-nlre 'nlre--looking-at 'looking-at) a))
(defun lbc-sf (s &optional b n c)
  (if lbc-nlre (nlre--re-search-forward (regexp-quote s) b n c) (search-forward s b n c)))
(defun lbc-mb (i) (if lbc-nlre (nlre-match-beginning i) (match-beginning i)))
(defun lbc-me (i) (if lbc-nlre (nlre-match-end i) (match-end i)))

(defun lbc-md ()
  (let ((r nil) (i 0))
    (while (< i 3)
      (setq r (cons (lbc-me i) (cons (lbc-mb i) r)))
      (setq i (1+ i)))
    (nreverse r)))

(defmacro lbc-case (label &rest body)
  `(let ((res (condition-case e (progn ,@body) (search-failed (list 'search-failed))
                (error (list 'error (car e))))))
     (setq lbc-n (1+ lbc-n))
     (princ (format "%03d %s => %S\n" lbc-n ,label res))))

(defun lbc-sm (re s &optional start fold)
  (let ((case-fold-search fold))
    (with-temp-buffer
      (let ((r (lbc-string-match re s start))) (cons r (lbc-md))))))

(defun lbc-buf (text pt thunk &optional fold)
  (let ((case-fold-search fold))
    (with-temp-buffer
      (insert text)
      (goto-char pt)
      (let ((r (funcall thunk)))
        (cons r (cons (point) (lbc-md)))))))

;; ---- string-match cases ----
(lbc-case "bol" (lbc-sm "^abc" "abc"))
(lbc-case "bol-second-line" (lbc-sm "^abc" "x\nabc"))
(lbc-case "bol-miss" (lbc-sm "^abc" "xabc"))
