(lbc-case "jp-word" (lbc-sm "\\(日\\)\\(本\\)" "xx日本"))
;; ---- buffer cases ----
(lbc-case "rsf-basic" (lbc-buf "abc foo def foo" 1 (lambda () (lbc-rsf "foo" nil t))))
(lbc-case "rsf-count" (lbc-buf "abc foo def foo foo" 1 (lambda () (lbc-rsf "foo" nil t 2))))
(lbc-case "rsf-count-fail" (lbc-buf "abc foo" 1 (lambda () (lbc-rsf "foo" nil t 2))))
(lbc-case "rsf-bound" (lbc-buf "abc foo def foo" 1 (lambda () (lbc-rsf "foo" 6 t))))
(lbc-case "rsf-bound-ok" (lbc-buf "abc foo def foo" 1 (lambda () (lbc-rsf "foo" 8 t))))
(lbc-case "rsf-noerror-nil-signal" (lbc-buf "abc" 1 (lambda () (lbc-rsf "zzz" nil nil))))
(lbc-case "rsf-noerror-move" (lbc-buf "abc foo" 1 (lambda () (lbc-rsf "zzz" 5 'move))))
(lbc-case "rsf-bol-mid-line" (lbc-buf "abc\nabc" 2 (lambda () (lbc-rsf "^abc" nil t))))
(lbc-case "rsf-bol-at-point" (lbc-buf "xabc\nabc" 2 (lambda () (lbc-rsf "^abc" nil t))))
(lbc-case "rsf-bos-at-point" (lbc-buf "xabc" 2 (lambda () (lbc-rsf "\\`abc" nil t))))
(lbc-case "rsf-word-edge-at-point" (lbc-buf "xfoo foo" 2 (lambda () (lbc-rsf "\\<foo" nil t))))
(lbc-case "rsf-eol" (lbc-buf "abc\nabc" 1 (lambda () (lbc-rsf "abc$" nil t 2))))
(lbc-case "rsf-eos" (lbc-buf "abc\nabc" 1 (lambda () (lbc-rsf "abc\\'" nil t))))
(lbc-case "rsf-fold" (lbc-buf "xx FOO" 1 (lambda () (lbc-rsf "foo" nil t)) t))
(lbc-case "rsf-nofold" (lbc-buf "xx FOO" 1 (lambda () (lbc-rsf "foo" nil t)) nil))
(lbc-case "rsf-groups" (lbc-buf "k1=v1 k2=v2" 1 (lambda () (lbc-rsf "\\([a-z0-9]+\\)=\\([a-z0-9]+\\)" nil t 2))))
(lbc-case "rsf-backref" (lbc-buf "ab abab" 1 (lambda () (lbc-rsf "\\(ab\\)\\1" nil t))))
(lbc-case "rsf-jp" (lbc-buf "これは日本語です日本" 1 (lambda () (lbc-rsf "日本" nil t 2))))
(lbc-case "rsf-jp-bol" (lbc-buf "あい\n日本語\n日本" 1 (lambda () (lbc-rsf "^日本" nil t 2))))
(lbc-case "rsf-jp-mid" (lbc-buf "あい日本語" 3 (lambda () (lbc-rsf "[ぁ-んァ-ン一-龥]+" nil t))))
(lbc-case "sf-basic" (lbc-buf "a.c abc a.c" 1 (lambda () (lbc-sf "a.c" nil t 2))))
(lbc-case "sf-fold" (lbc-buf "xx ABC" 1 (lambda () (lbc-sf "abc" nil t)) t))
(lbc-case "la-basic" (lbc-buf "foo bar" 1 (lambda () (lbc-la "foo"))))
(lbc-case "la-miss" (lbc-buf "foo bar" 2 (lambda () (lbc-la "foo"))))
(lbc-case "la-bol-mid" (lbc-buf "xfoo\nfoo" 2 (lambda () (lbc-la "^foo"))))
(lbc-case "la-bol-line" (lbc-buf "xfoo\nfoo" 6 (lambda () (lbc-la "^foo"))))
(lbc-case "la-word" (lbc-buf "xfoo foo" 2 (lambda () (lbc-la "\\<foo"))))
(lbc-case "la-group" (lbc-buf "ab12" 1 (lambda () (lbc-la "\\([a-z]+\\)\\([0-9]+\\)"))))
(lbc-case "la-star" (lbc-buf "aaab" 1 (lambda () (lbc-la "a*"))))
(lbc-case "la-jp" (lbc-buf "あい日本" 3 (lambda () (lbc-la "日本"))))
(lbc-case "la-fold" (lbc-buf "FOO" 1 (lambda () (lbc-la "foo")) t))
;; ---- window-boundary sweep: a match straddling every offset near 4096/8192 ----
(defun lbc-sweep (label re pre post thunk-fn)
  (let ((k pre) (acc nil))
    (while (<= k post)
      (let* ((text (concat (make-string k ?a) "\nfoo bar foobar\n" (make-string 50 ?b)))
             (r (condition-case e
                    (lbc-buf text 1 (lambda () (funcall thunk-fn re)))
                  (error (list 'error (car e))))))
        (setq acc (cons r acc)))
      (setq k (1+ k)))
    (setq acc (nreverse acc))
    (princ (format "%03d sweep %s %d..%d => %S\n" (setq lbc-n (1+ lbc-n)) label pre post acc))))
(lbc-sweep "bol-foo" "^foo" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "dotstar" "o.*r" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "eol-after" "bar$" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "wordedge" "\\<foo\\>" 8180 8200 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "backref" "\\(o\\)\\1" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "literal" "foobar" 8180 8200 (lambda (re) (lbc-sf re nil t)))
(lbc-sweep "eos" "b\\'" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(lbc-sweep "star-class" "o[a-z]+ba" 4086 4106 (lambda (re) (lbc-rsf re nil t)))
(progn (princ (format "TOTAL %d\n" lbc-n)) nil)
