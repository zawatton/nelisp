;;; prim-sort-number-host.el --- Execute numeric DSL against GNU -*- lexical-binding: t -*-

;; A host oracle for the exact same native DSL bodies. Only object access and
;; machine intrinsics are simulated; GNU value< supplies independent answers.
(setq load-prefer-newer t)
(require 'nelisp-cc-number-order)
(require 'cl-lib)
(defvar ps-host-floats (make-hash-table :test 'eql))
(defmacro seq (&rest body) `(progn ,@body))
(defun nl_val_tag (w) (if (vectorp w) (aref w 0) 2))
(defun nl_word_payload (w) (if (vectorp w) (aref w 1) (ash w -2)))
(defun ptr-read-u64 (w offset) (aref w (/ offset 8)))
(defun ptr-read-u32 (limbs offset) (aref limbs (/ offset 4)))
(defun sexp-float-unwrap (w) (aref w 1))
(defun shr (n count) (ash (logand n (1- (ash 1 64))) (- count)))
(defun shl (n count) (ash n count))
(defun bits-to-f64 (bits) (gethash bits ps-host-floats))
(defun i64-to-f64 (n) (float n))
(defun f64-lt (a b) (if (< a b) 1 0))
(defun f64-gt (a b) (if (> a b) 1 0))
(defun f64-le (a b) (if (<= a b) 1 0))
(defun ps-host-order (a b) (cond ((value< a b) -1) ((value< b a) 1) (t 0)))
(defun nl_bignum_cmp_bignum (a b) (ps-host-order (aref a 4) (aref b 4)))
(defun nl_bignum_mag_cmp_i64 (limbs count mag)
  (let ((value 0))
    (dotimes (i count) (setq value (+ value (ash (aref limbs i) (* i 32)))))
    (ps-host-order value mag)))
(defun ps-host-integer (n)
  (if (fixnump n) (1+ (ash n 2))
    (let ((mag (abs n)) (limbs nil))
      (while (> mag 0)
        (push (logand mag #xffffffff) limbs)
        (setq mag (ash mag -32)))
      (setq limbs (nreverse limbs))
      (vector 13 (if (< n 0) 1 0) (vconcat limbs) (length limbs) n))))

(let ((source (copy-tree nelisp-cc-number-order--source)))
  (when (getenv "PRIM_SORT_MUTATE") (setq source (cl-subst 0 4503599627370496 source)))
  (dolist (form (cdr source))
    (when (memq (cadr form) '(nl_number_integer_limb nl_number_integer_float_order
                             nl_number_big_small_order nl_number_order_words))
      (eval form t))))
(condition-case problem
    (let ((rows nil) (checked 0))
      (dolist (n (append '(-2 -1 0 1 2)
                        (apply #'append
                               (mapcar (lambda (e)
                                         (let ((v (ash 1 e)))
                                           (list (1- v) v (1+ v) (- v) (- (1+ v)))))
                                       '(52 60 61 80 1023 1024 4096)))))
        (push (cons n (ps-host-integer n)) rows))
      (dolist (row (with-temp-buffer
                     (insert-file-contents (getenv "PRIM_SORT_FLOAT_ROWS"))
                     (read (current-buffer))))
        (puthash (car row) (cadr row) ps-host-floats)
        (push (cons (cadr row) (vector 3 (car row))) rows))
      (unless (> (length rows) 50) (error "incomplete oracle population"))
      (dolist (a rows)
        (dolist (b rows)
          (let* ((av (car a)) (bv (car b))
                 (got (nl_number_order_words (cdr a) (cdr b)))
                 (unordered (or (and (floatp av) (not (= av av)))
                                (and (floatp bv) (not (= bv bv)))))
                 (expected (if unordered 2 (ps-host-order av bv))))
            (setq checked (1+ checked))
            (unless (= got expected)
              (error "case %d: %S versus %S: %s != %s"
                     checked (car a) (car b) got expected)))))
      (princ (format "NUMERIC-HOST checked=%d findings=0\n" checked)))
  (error (princ (format "NUMERIC-HOST FAIL %s\n" (error-message-string problem)))
         (kill-emacs 1)))
