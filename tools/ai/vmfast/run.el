;;; run.el --- vmfast VM parity corpus runner: same output on GNU 31.1 and NeLisp -*- lexical-binding: t; -*-
(load (expand-file-name "bc.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(defmacro vf-case (name form)
  `(princ (format "%s %S\n" ',name (condition-case err ,form (error (list 'ERROR err))))))
(defvar vf-long (append (make-list 5000 'z) (list 'hit 'end)))
(vf-case bytecode-p (list (byte-code-function-p (symbol-function 'vf-memq)) (byte-code-function-p (symbol-function 'vfd-args))))
(vf-case memq-sym (list (vf-memq 'e '(a b c d e f g h)) (vf-memq 'q '(a b c)) (vf-memq 'a nil)))
(vf-case memq-fix (list (vf-memq 3 '(1 2 3 4)) (vf-memq 9 '(1 2 3)) (vf-memq nil '(a nil b)) (vf-memq t '(nil t))))
(vf-case memq-twins (let ((a (make-symbol "a")) (b (make-symbol "a"))) (list (vf-memq a (list b 'a)) (eq (car (vf-memq a (list b a 'a))) a))))
(vf-case memq-str (let ((s "x")) (list (vf-memq "x" (list "x")) (vf-memq s (list "x" s)))))
(vf-case memq-cons (let ((c (list 1))) (list (vf-memq (list 1) (list (list 1))) (length (vf-memq c (list (list 1) c))))))
(vf-case memq-improper-hit (vf-memq 'b '(a b . c)))
(vf-case memq-improper-miss (vf-memq 'x '(a b . c)))
(vf-case memq-long (list (length (vf-memq 'hit vf-long)) (vf-memq 'nope (make-list 4200 'z))))
(vf-case memq-chars (vf-memq ?b (list ?a ?b ?c)))
(vf-case eq (list (vf-eq 'a 'a) (vf-eq 'a 'b) (vf-eq (make-symbol "a") (make-symbol "a")) (vf-eq 1 1) (vf-eq nil 'nil) (vf-eq "a" "a") (vf-eq :k :k) (vf-eq 'a "a")))
(vf-case nth (list (vf-nth 0 '(a b c)) (vf-nth 2 '(a b c)) (vf-nth 3 '(a b c)) (vf-nth 9 nil) (vf-nth -1 '(x y)) (vf-nth 1 '(0 nil)) (vf-nth 1 (list 1 2.5)) (vf-nth 4500 (make-list 4600 'w))))
(vf-case nth-dotted (list (vf-nth 0 '(a . b)) (condition-case e (vf-nth 1 '(a . b)) (error e))))
(vf-case nth-improper (vf-nth 3 '(a b . c)))
(vf-case length (list (vf-length nil) (vf-length '(a b c)) (vf-length '(1 2)) (vf-length [1 2 3]) (vf-length "abcd") (vf-length (make-list 5000 'q))))
(vf-case length-closure-head (list (vf-length '(closure a)) (vf-length (list 'closure 'x)) (vf-length '(lambda (x) x)) (vf-length '(closures 1 2)) (vf-length (list (make-symbol "closure") 1))))
(vf-case length-improper (vf-length '(a b . c)))
(vf-case length-improper2 (vf-length '(1 . 2)))
(vf-case bind6 (vf-bind6 10))
(vf-case bind20 (vf-bind20 100))
(vf-case bind-after (vf-snap))
(vf-case bind40 (vf-bind40 7))
(vf-case throw40 (list (vf-throw40) vf-log (vf-snap40)))
(vf-case bind-seq (vf-bind-seq 6))
(vf-case throw-deep (vf-throw-deep))
(vf-case signal-deep (vf-signal-deep))
(vf-case handler-in-let (vf-handler-in-let))
(vf-case depth (vf-depth))
(vf-case dispatch (vf-dispatch 1000))
(vf-case dyn (vfd-run))
(vf-case dyn-ampname (list (vfd-ampname 1) (vfd-ampname 1 2) (condition-case e (vfd-ampname) (error (car e)))))
(vf-case dyn-wrong-args (condition-case e (funcall 'vfd-args 1) (error (car e))))
(vf-case final (vf-snap))
(princ "VMFAST-PARITY DONE\n")
(kill-emacs 0)
