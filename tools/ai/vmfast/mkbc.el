;; mkbc.el --- write GNU-compiled bytecode of src-lex.el and src-dyn.el as literal definitions (bc.el).
;; Run from this directory: emacs -Q --batch -l mkbc.el
(require 'bytecomp)
(defun vf-mk-compile (file names lexical)
  (let ((lexical-binding lexical))
    (load (expand-file-name file) nil t)
    (mapcar (lambda (f) (cons f (byte-compile f))) names)))
(let ((lex (vf-mk-compile "src-lex.el" '(vf-snap vf-memq vf-length vf-eq vf-nth vf-bind6 vf-bind20 vf-bind-seq vf-throw-deep
                                          vf-signal-deep vf-handler-in-let vf-rec vf-rec-inf vf-depth vf-dispatch vf-bind40 vf-throw40 vf-snap40) t))
      (dyn (vf-mk-compile "src-dyn.el" '(vfd-args vfd-amp vfd-ampname vfd-many vfd-inner vfd-outer vfd-run) nil)))
  (with-temp-file "bc.el"
    (insert ";;; bc.el --- generated by mkbc.el from src-lex.el and src-dyn.el (GNU 31.1) -*- lexical-binding: t; -*-\n")
    (dotimes (i 20) (insert (format "(defvar vf-s%d 's%d)\n" (1+ i) (1+ i))))
    (insert "(defvar vf-log nil)\n")
    (dotimes (i 40) (insert (format "(defvar vf-t%d 't%d)\n" (1+ i) (1+ i))))
    (let ((print-escape-newlines t) (print-escape-nonascii t) (print-escape-control-characters t) (print-circle t) (print-length nil) (print-level nil))
      (dolist (p (append lex dyn))
        (insert (format "(defalias '%s %s)\n" (car p) (prin1-to-string (cdr p))))))))
