;;; gc-port-bignum-probe.el --- bignum behaviour probes: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l FILE (GNU) and NELISP --load FILE.  One "NAME => RESULT" line per case.
;; The Bignum representation steps (Doc 216 S5) must leave every NeLisp line unchanged; lines
;; that differ from GNU are recorded pre-existing differences (division by a bignum, bignum
;; `ash' of a bignum count, ...).
(defmacro pb (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

(defvar pb--big (ash 1 100))
(defvar pb--neg (- (ash 1 70)))
;; arithmetic
(pb "add" (+ pb--big 1))
(pb "add-neg" (+ pb--big pb--neg))
(pb "add-fix" (+ most-positive-fixnum 1))
(pb "sub-fix" (- most-negative-fixnum 1))
(pb "sub-to-fix" (- (+ most-positive-fixnum 5) 10))
(pb "mul" (* pb--big pb--big))
(pb "mul-neg" (* pb--big pb--neg))
(pb "mul-zero" (* pb--big 0))
(pb "div-small" (/ pb--big 7))
(pb "rem-small" (% pb--big 7))
(pb "div-neg" (/ pb--neg 3))
(pb "mod-fix" (mod (ash 1 70) 1000))
(pb "1+" (1+ most-positive-fixnum))
(pb "1-" (1- most-negative-fixnum))
(pb "abs" (abs pb--neg))
(pb "negate" (- pb--big))
(pb "ash-left" (ash 12345 90))
(pb "ash-right" (ash pb--big -60))
(pb "ash-neg-right" (ash pb--neg -3))
(pb "logand" (logand pb--big (1- pb--big)))
(pb "logior" (logior pb--big 1))
(pb "logxor" (logxor pb--big pb--big))
(pb "lognot" (lognot pb--big))
(pb "logand-neg" (logand pb--neg 255))
(pb "expt" (expt 3 70))
(pb "expt-big" (expt 2 100))
(pb "isqrt-ish" (/ (* pb--big pb--big) pb--big))
;; comparison and identity
(pb "lt" (list (< pb--neg pb--big) (> pb--big 5) (<= pb--big pb--big) (>= pb--neg 0) (= pb--big pb--big)))
(pb "lt-chain" (< 1 pb--big (ash 1 101)))
(pb "max-min" (list (max 1 pb--big 5) (min 1 pb--neg 5)))
(pb "eq-same" (let ((x pb--big)) (eq x x)))
(pb "eq-global" (eq pb--big pb--big))
(pb "eq-computed" (eq (ash 1 100) (ash 1 100)))
(pb "eql-computed" (eql (ash 1 100) (ash 1 100)))
(pb "equal-computed" (equal (ash 1 100) (ash 1 100)))
(pb "equal-list" (equal (list (ash 1 100) 2) (list (ash 1 100) 2)))
(pb "eql-fix-big" (list (eql 1 pb--big) (eql pb--big 1.0)))
(pb "zerop-evenp" (list (zerop pb--big) (cl-evenp pb--big) (cl-oddp (1+ pb--big)) (natnump pb--big) (natnump pb--neg)))
(pb "predicates" (list (bignump pb--big) (fixnump pb--big) (integerp pb--big) (numberp pb--big) (floatp pb--big) (atom pb--big)
                       (type-of pb--big) (bignump most-positive-fixnum) (bignump (1+ most-positive-fixnum))))
;; containers keep identity
(pb "list-keeps" (let ((x (ash 1 100))) (let ((l (list x x))) (list (eq (car l) x) (eq (car l) (cadr l))))))
(pb "cons-keeps" (let* ((x (ash 1 100)) (c (cons x x))) (list (eq (car c) x) (eq (cdr c) x))))
(pb "setcar-keeps" (let* ((x (ash 1 100)) (c (cons 1 2))) (setcar c x) (setcdr c x) (list (eq (car c) x) (eq (cdr c) x))))
(pb "aset-keeps" (let* ((x (ash 1 100)) (v (make-vector 3 nil))) (aset v 0 x) (aset v 2 x) (list (eq (aref v 0) x) (eq (aref v 0) (aref v 2)))))
(pb "vector-literal" (let* ((x (ash 1 100)) (v (vector x 1 x))) (list (eq (aref v 0) x) (aref v 2))))
(pb "closure-keeps" (let* ((x (ash 1 100)) (f (lambda () x))) (eq (funcall f) x)))
(pb "dynamic-keeps" (progn (defvar pb--dyn nil) (let ((pb--dyn (ash 1 100))) (list pb--dyn (eq pb--dyn pb--dyn)))))
(pb "plist-keeps" (let* ((x (ash 1 100)) (pl (list 'a x 'b 2))) (eq (plist-get pl 'a) x)))
(pb "alist-keeps" (let* ((x (ash 1 100)) (al (list (cons 'k x)))) (eq (cdr (assq 'k al)) x)))
(pb "memq-big" (let* ((x (ash 1 100)) (l (list 1 x 3))) (list (memq x l) (memql x l) (member x l) (memql (ash 1 100) l))))
(pb "delq-big" (let* ((x (ash 1 100)) (l (list 1 x 3))) (delq x l)))
(pb "assoc-big" (assoc (ash 1 100) (list (cons (ash 1 100) 'found))))
(pb "assq-same" (let* ((x (ash 1 100)) (al (list (cons x 'found)))) (assq x al)))
;; hash tables and sorting
(pb "hash-eql" (let ((h (make-hash-table :test 'eql))) (puthash (ash 1 100) 'a h) (puthash (ash 1 101) 'b h) (list (gethash (ash 1 100) h) (gethash (ash 1 101) h) (gethash (ash 1 102) h) (hash-table-count h))))
(pb "hash-equal" (let ((h (make-hash-table :test 'equal))) (puthash (ash 1 100) 'a h) (list (gethash (ash 1 100) h) (gethash (list (ash 1 100)) h))))
(pb "hash-eq-same" (let ((h (make-hash-table :test 'eq)) (x (ash 1 100))) (puthash x 'a h) (gethash x h)))
(pb "hash-value" (let ((h (make-hash-table))) (puthash 'k (ash 1 100) h) (gethash 'k h)))
(pb "sxhash-same" (= (sxhash-equal (ash 1 100)) (sxhash-equal (ash 1 100))))
(pb "sort" (sort (list pb--big 5 pb--neg (ash 1 80) 0) #'<))
(pb "sort-vec" (sort (vector (ash 1 90) (ash 1 70) (ash 1 80)) #'>))
;; text
(pb "number-to-string" (list (number-to-string pb--big) (number-to-string pb--neg) (number-to-string most-positive-fixnum) (number-to-string (1+ most-positive-fixnum))))
(pb "prin1" (list (prin1-to-string pb--big) (prin1-to-string (list pb--big pb--neg))))
(pb "format-s" (format "%s %S" pb--big pb--neg))
(pb "format-d" (list (format "%d" pb--big) (format "%x" pb--big) (format "%o" pb--neg)))
(pb "read" (list (read "123456789012345678901234567890") (read "-98765432109876543210") (read "(1 2305843009213693952 3)")))
(pb "string-to-number" (list (string-to-number "123456789012345678901234567890") (string-to-number "-4611686018427387904")))
(pb "read-from-string" (car (read-from-string "1267650600228229401496703205376")))
;; floats and rounding
(pb "float" (list (float pb--big) (float pb--neg) (+ pb--big 0.5) (* 2 pb--neg 1.0)))
(pb "truncate-id" (list (truncate pb--big) (floor pb--neg) (ceiling pb--big) (round pb--big)))
(pb "truncate-float" (truncate 1e30))
(pb "float-compare" (list (< 1e30 pb--big) (> 1e31 pb--big) (= (float pb--big) pb--big)))
;; garbage collection keeps them
(pb "gc-list" (let ((l nil)) (dotimes (i 500) (push (* (+ i 1) (ash 1 70)) l)) (garbage-collect) (garbage-collect) (let ((s 0)) (dolist (x l) (setq s (+ s x))) s)))
(pb "gc-vector" (let ((v (make-vector 300 0))) (dotimes (i 300) (aset v i (+ (ash 1 80) i))) (garbage-collect) (let ((s 0)) (dotimes (i 300) (setq s (+ s (aref v i)))) s)))
(pb "gc-hash" (let ((h (make-hash-table :test 'eql))) (dotimes (i 200) (puthash (+ (ash 1 70) i) i h)) (garbage-collect) (let ((n 0)) (dotimes (i 200) (when (eql (gethash (+ (ash 1 70) i) h) i) (setq n (1+ n)))) n)))
(pb "gc-closure" (let ((fs nil)) (dotimes (i 50) (let ((x (+ (ash 1 75) i))) (push (lambda () x) fs))) (garbage-collect) (let ((s 0)) (dolist (f fs) (setq s (+ s (funcall f)))) s)))
(pb "gc-churn" (let ((acc 1)) (dotimes (i 200) (setq acc (* acc 3)) (when (> (abs acc) (ash 1 200)) (setq acc (/ acc (ash 1 190))))) (garbage-collect) acc))
(pb "gc-string-keys" (let ((al nil)) (dotimes (i 100) (push (cons (format "k%d" i) (* (ash 1 65) i)) al)) (garbage-collect) (cdr (assoc "k77" al))))
(pb "bytecomp" (funcall (lambda (a b) (list (+ a b) (* a 2) (< a b))) (ash 1 100) (ash 1 101)))
(princ "PB-DONE\n")
