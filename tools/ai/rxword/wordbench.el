;;; wordbench.el --- plain vs word-boundary re-search-forward per call  -*- lexical-binding: t; -*-
;; usage: nelisp --load wordbench.el   (prints "WB label us_per_call ratio_to_plain")
(defvar wb-seed 12345)
(defun wb-rand (m) (setq wb-seed (% (* wb-seed 48271) 2147483647)) (% wb-seed m))
(defvar wb-words (vector "alpha" "beta" "gamma" "delta" "epsilon" "zeta" "eta" "theta" "iota" "kappa" "lambda" "mu" "nu" "xi" "omicron" "pi"))
(defvar wb-text (let (l) (dotimes (_ 20000) (push (aref wb-words (wb-rand 16)) l)) (mapconcat #'identity l " ")))
(defun wb-count (re)
  (with-temp-buffer
    (insert wb-text) (goto-char 1)
    (let ((c 0)) (while (re-search-forward re nil t) (setq c (1+ c))) c)))
(defun wb-time (label re reps)
  (wb-count re)
  (let* ((s (float-time)) (c 0))
    (dotimes (_ reps) (setq c (wb-count re)))
    (let ((us (/ (* 1e6 (- (float-time) s)) reps c)))
      (princ (format "WB %s count=%d %.2f\n" label c us))
      us)))
(let* ((reps (string-to-number (or (getenv "WB_REPS") "3")))
       (plain (wb-time "plain" "beta" reps)))
  (dolist (p '(("wordbeg-end" . "\\<beta\\>") ("wordbound" . "\\bbeta\\b") ("symbeg-end" . "\\_<beta\\_>")
               ("notbound" . "\\Bet\\B")))
    (let ((us (wb-time (car p) (cdr p) reps)))
      (princ (format "WBRATIO %s %.2f\n" (car p) (/ us plain))))))
