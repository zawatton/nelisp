;;; -*- lexical-binding: t; -*-
;; Shared prelude for survey3 drivers (both engines).  Setup cost is outside the timed window.
(require 'cl-lib)
(require 'seq)
(require 'subr-x)
(require 'rx)
(defvar sv3-root (file-name-directory (or load-file-name buffer-file-name)))
(defvar sv3-seed 12345)
(defun sv3-rand (m) (setq sv3-seed (% (* sv3-seed 48271) 2147483647)) (% sv3-seed m))
(defvar sv3-ints (number-sequence 1 10000))
(defvar sv3-rnd (let (l) (dotimes (_ 10000) (push (sv3-rand 100000) l)) l))
(defvar sv3-rnd-v (vconcat sv3-rnd))
(defvar sv3-rnd2k (let (l) (dotimes (_ 2000) (push (sv3-rand 1000) l)) l))
(defvar sv3-rnd-strs (let (l) (dotimes (_ 2000) (push (format "k%d" (sv3-rand 100000)) l)) l))
(defvar sv3-pairs (let (l) (dotimes (i 5000) (push (cons (sv3-rand 100000) i) l)) l))
(defun sv3-mknest (k) (let (l) (dotimes (i k) (push (list i (format "s%d" i) (cons i (* i 0.5)) (vector i 'sym (list i i))) l)) (nreverse l)))
(defvar sv3-nest (sv3-mknest 2000))
(defvar sv3-nest-str (prin1-to-string sv3-nest))
(defvar sv3-words (vector "alpha" "beta" "gamma" "delta" "epsilon" "zeta" "eta" "theta" "iota" "kappa" "lambda" "mu" "nu" "xi" "omicron" "pi"))
(defvar sv3-text (let (l) (dotimes (_ 20000) (push (aref sv3-words (sv3-rand 16)) l)) (mapconcat #'identity l " ")))
(defvar sv3-csv (mapconcat #'number-to-string (number-sequence 1 20000) ","))
(defvar sv3-u (apply #'concat (make-list 100 "日本語abc日本")))
(defvar sv3-a (apply #'concat (make-list 100 "abcdefghij")))
(defvar sv3-u8 (encode-coding-string sv3-u 'utf-8))
(defvar sv3-bin (let ((s (make-string 3000 0))) (dotimes (i 3000) (aset s i (% (* i 7) 256))) (string-to-unibyte s)))
(defvar sv3-jtext (concat "[" (mapconcat (lambda (i) (format "{\"id\":%d,\"name\":\"n%d\",\"tags\":[\"a\",\"b\"],\"v\":%d.5,\"ok\":true,\"z\":null}" i i i)) (number-sequence 1 1000) ",") "]"))
(defvar sv3-jnums (concat "[" (mapconcat #'number-to-string (number-sequence 1 5000) ",") "]"))
(defvar sv3-f1m (concat sv3-root "data/f1m.txt"))
(defvar sv3-f10m (concat sv3-root "data/f10m.txt"))
(defvar sv3-f1mja (concat sv3-root "data/f1m-ja.txt"))
(defvar sv3-d200 (concat sv3-root "data/dir200/"))
(defvar sv3-wf (concat sv3-root "tmp/w.dat"))
(defvar sv3-forms-text (let (l) (dotimes (i 3000) (push (format "(foo %d \"bar\" (baz . %d))\n" i i) l)) (apply #'concat l)))
