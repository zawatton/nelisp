;;; active-binding-query-native.el --- Synthetic ABI native query -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(require 'nelisp-standalone-build)
(require 'nelisp-cc-fnv1a)
(require 'nelisp-cc-frame-stack-find)
(require 'nelisp-cc-nlstr-direct-ops)
(defconst aqn-root (file-name-directory (directory-file-name
                    (file-name-directory (directory-file-name (file-name-directory load-file-name))))))
(load (expand-file-name "test/perf/codegen-runtime/compile.el" aqn-root) nil t)
(load (expand-file-name "test/nelisp-active-binding-query-test.el" aqn-root) nil t)
(defun aqn-sha (p) (with-temp-buffer (set-buffer-multibyte nil)
                    (insert-file-contents-literally p) (secure-hash 'sha256 (current-buffer))))
(defun aqn-main ()
  "Emit genuine query closure; synthetic data is not live ownership evidence."
  (let* ((builder (expand-file-name "scripts/nelisp-standalone-build.el" aqn-root))
         (out (expand-file-name (or (getenv "AQN_OUT") "target/binding-state/native-query/run1") aqn-root))
         (mutant (equal (getenv "AQN_MUTANT") "wrong-buffer"))
         (nelisp-standalone--target 'linux-x86_64)
         (nelisp-aot-compiler--vector-value-convention 'compact-word)
         (base #x3d000000) (cursor (+ base 65536)) (checks nil) (count 0)
         (catalog nil) (providers nil) (source nil) (before nil))
    (unless (equal (aqn-sha builder) "e170b352dbdd45ceacd1b55ba8250b58613170da71ed286bacbc47e11834045c")
      (error "Production source seal mismatch"))
    (when (file-exists-p out) (error "Fresh output required"))
    (make-directory out t)
    ;; Only authentic evaluated provider sequences; conflicting owners fail closed.
    (mapatoms (lambda (s)
                (when (and (boundp s) (string-prefix-p "nelisp-" (symbol-name s)))
                  (let ((v (symbol-value s)))
                    (when (and (consp v) (or (eq (car v) 'seq)
                                             (eq (car-safe (car v)) 'defun)))
                      (dolist (d (if (eq (car v) 'seq) (cdr v) v))
                        (when (eq (car-safe d) 'defun) (push d catalog))))))))
    (let ((old (abq--old)))
      (setcar (cdr old) 'aqn_old_query) (push old catalog))
    (when mutant
      (setq catalog
            (mapcar (lambda (d)
                      (if (eq (cadr d) 'nl_sb_saved_default_match)
                          (cl-subst 1 '(= (bf_eq2 (nl_vector_slot_word item 2) buffer) 1)
                                    d :test #'equal) d)) catalog)))
    (cl-labels
        ((emit (x) (push x checks))
         (alloc (n) (prog1 cursor (setq cursor (+ cursor (* 8 (/ (+ n 7) 8))))))
         (put (p o v) (emit `(ptr-write-u64 ,p ,o ,v)))
         (view (tag payload) (let ((p (alloc 32))) (put p 0 tag) (put p 8 payload) p))
         (vec (items record)
           (let* ((p (alloc (+ (if record 16 8) (* 8 (length items)))))
                  (v (view (if record 12 8) p)))
             (put p 0 (* (length items) 256))
             (cl-loop for x in items for i from 0 do (put p (+ (if record 16 8) (* i 8)) x)) v))
         (consw (a d) (let ((p (alloc 16))) (put p 0 a) (put p 8 d) (view 7 p)))
         (word (x)
           (cond ((null x) 3) ((vectorp x) (vec (mapcar #'word (append x nil)) nil))
                 ((consp x) (consw (word (car x)) (word (cdr x))))
                 ((memq x '(101 102 999))
                  (or (cdr (assq x providers))
                      (let ((p (view 16 (alloc 32)))) (push (cons x p) providers) p)))
                 ((= x 201) 805) ((= x 202) 809) (t x)))
         (check (predicate)
           (cl-incf count)
           (emit `(if ,predicate 0 (syscall-direct 60 2 0 0 0 0 0)))))
      (dolist (case abq--cases)
        (pcase-let ((`(,id ,frames ,links ,name ,buffer ,old ,new) case))
          (let* ((env (alloc 256)) (fp (+ env 32)) (state (alloc 32)) (link 0)
                 (backing (vec (mapcar (lambda (names) (vec (list 3 (word names)) t)) frames) nil))
                 (payload (alloc 32)) (namew (word name)) (bufferw (word buffer)))
            (put fp 0 12) (put fp 8 payload) (put payload 16 backing)
            (put payload 24 (+ 1 (* 4 (length frames))))
            (dolist (events (reverse links))
              (let ((p (alloc 64)) (cell (alloc 8)))
                (put p 8 link) (put p 16 cell) (put cell 0 (word events)) (setq link p)))
            (put env 176 (if links state 0)) (put state 16 link)
            (check `(= (aqn_old_query ,fp ,namew ,bufferw) ,old))
            (check `(= (nl_sb_default_bound_here ,fp ,namew ,bufferw) ,new))
            (push (list id old new) before))))
      ;; Every initialized byte word is checked after both queries, not only heads.
      (let ((writes (cl-remove-if-not (lambda (x) (eq (car-safe x) 'ptr-write-u64)) checks)))
        (dolist (w writes) (check `(= (ptr-read-u64 ,(nth 1 w) ,(nth 2 w)) ,(nth 3 w)))))
      (setq source `(seq (defun aqn_run ()
                           (seq (syscall-direct 9 ,base 16777216 3 50 -1 0)
                                ,@(nreverse checks) 0))
                         (defun _start () (syscall-direct 60 (aqn_run) 0 0 0 0 0))))
      (let* ((arena (nelisp-standalone--arena-base-slot-unit))
             (unit (codegen-runtime--closed-unit source catalog (list arena))))
        (dolist (s (plist-get unit :symbols))
          (when (string-match-p "alloc\\|spill\\|aux_unwinds\\|link_events\\|eval_inner" (plist-get s :name))
            (error "Forbidden query dependency: %s" (plist-get s :name))))
        (with-temp-file (expand-file-name "unit.el" out) (prin1 unit (current-buffer)))
        (with-temp-file (expand-file-name "fixture.el" out) (prin1 source (current-buffer)))
        (with-temp-file (expand-file-name "catalog.el" out) (prin1 catalog (current-buffer)))
        (nelisp-link-units (expand-file-name "query.elf" out) (list unit arena) "_start")
        (with-temp-file (expand-file-name "receipt.json" out)
          (insert (json-encode `((scope . "Synthetic ABI native reads only")
                                 (builder_sha256 . ,(aqn-sha builder))
                                 (cases . ,(length before)) (checks . ,count)
                                 (mutant . ,mutant) (elf_sha256 . ,(aqn-sha (expand-file-name "query.elf" out)))))))))
    (unless (equal (aqn-sha builder) "e170b352dbdd45ceacd1b55ba8250b58613170da71ed286bacbc47e11834045c")
      (error "Production source changed"))))
(aqn-main)
