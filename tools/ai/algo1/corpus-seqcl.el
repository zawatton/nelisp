;; -*- lexical-binding: t; -*-
;; Parity corpus: seq-uniq, memql, cl-adjoin, cl-union and relatives.  One line per case,
;; "N: RESULT"; run under NeLisp and GNU Emacs and compare.
(require 'cl-lib)
(require 'seq)
(defvar algo1-n 0)
(defmacro algo1-case (form)
  `(progn (setq algo1-n (1+ algo1-n))
          (princ (format "%d: %S\n" algo1-n (condition-case e ,form (error (list 'ERR (car e) (cdr e))))))))
(defun algo1-rng (n m) (let ((s 12345) l) (dotimes (_ n) (setq s (% (* s 48271) 2147483647)) (push (% s m) l)) l))
(let ((big (algo1-rng 300 40)) (bigs (mapcar #'number-to-string (algo1-rng 150 30)))
      (p1 (expt 2 70)) (p2 (expt 2 70)))
  (algo1-case (seq-uniq '(1 2 2 3 1 4)))
  (algo1-case (seq-uniq nil))
  (algo1-case (seq-uniq big))
  (algo1-case (seq-uniq bigs))
  (algo1-case (seq-uniq (append big (list 1.0 1 1.0 "a" "a" 'a 'a))))
  (algo1-case (seq-uniq (make-list 150 nil)))
  (algo1-case (seq-uniq '(nil nil 1 1) #'equal))
  (algo1-case (seq-uniq '(nil nil 1 1) #'eq))
  (algo1-case (seq-uniq '(1 2 3 4 5 6) (lambda (a b) (= (% a 3) (% b 3)))))
  (algo1-case (let (calls) (seq-uniq '(1 2 3 2) (lambda (a b) (push (list a b) calls) (= a b))) (nreverse calls)))
  (algo1-case (seq-uniq '("a" "A" "b" "B") (lambda (a b) (string= (downcase a) (downcase b)))))
  (algo1-case (seq-uniq [1 2 2 3 1]))
  (algo1-case (seq-uniq "abcabc"))
  (algo1-case (seq-uniq [1 2 3 4 5 6] (lambda (a b) (= (% a 3) (% b 3)))))
  (algo1-case (let (calls) (seq-uniq [1 2 3 2] (lambda (a b) (push (list a b) calls) (= a b))) (nreverse calls)))
  (algo1-case (seq-uniq [nil nil 1] #'equal))
  (algo1-case (seq-uniq (list p1 p2 p1) #'eql))
  (algo1-case (seq-uniq (append (list p1 p2) big)))
  (algo1-case (seq-uniq '(1 2 . 3)))
  (algo1-case (seq-uniq 5))
  (algo1-case (seq-uniq '(a b a) #'eq))
  (algo1-case (let ((l (list 1 2 3))) (setcdr (cddr l) l) (seq-uniq l)))
  ;; memql
  (algo1-case (memql 1 '(2 1 3)))
  (algo1-case (memql 1.0 '(1 1.0 2)))
  (algo1-case (memql 0.0 '(-0.0 0.0)))
  (algo1-case (memql -0.0 '(0.0 -0.0)))
  (algo1-case (memql 0.0e+NaN (list 1 0.0e+NaN)))
  (algo1-case (memql p1 (list 1 p2 3)))
  (algo1-case (memql "a" '("a")))
  (algo1-case (let ((s "a")) (memql s (list "b" s))))
  (algo1-case (memql 'a '(b a)))
  (algo1-case (memql nil '(1 nil 2)))
  (algo1-case (memql 1 nil))
  (algo1-case (memql 1 '(2 . 3)))
  (algo1-case (memql 1 5))
  (algo1-case (memql ?a '(97 98)))
  ;; cl-adjoin
  (algo1-case (cl-adjoin 1 '(2 3)))
  (algo1-case (cl-adjoin 2 '(2 3)))
  (algo1-case (cl-adjoin 1.0 '(1 2)))
  (algo1-case (cl-adjoin 1.0 '(1.0 2)))
  (algo1-case (cl-adjoin "a" '("a" "b")))
  (algo1-case (cl-adjoin "a" '("a" "b") :test #'equal))
  (algo1-case (cl-adjoin "a" '("a" "b") :test 'equal))
  (algo1-case (cl-adjoin 'a '(a b) :test 'eq))
  (algo1-case (cl-adjoin "a" '("A" "b") :test #'string-equal-ignore-case))
  (algo1-case (cl-adjoin '(1) '((1) (2)) :key #'car))
  (algo1-case (cl-adjoin '(3) '((1) (2)) :key #'car))
  (algo1-case (cl-adjoin 3 '(1 2) :test-not #'=))
  (algo1-case (cl-adjoin 'x '(a b)))
  (algo1-case (cl-adjoin 'x nil))
  ;; cl-union & friends
  (algo1-case (cl-union '(1 2 3) '(3 4 5)))
  (algo1-case (cl-union '(3 4 5) '(1 2 3)))
  (algo1-case (cl-union '(1 2 3 4) '(3 4)))
  (algo1-case (cl-union nil '(1 2)))
  (algo1-case (cl-union '(1 2) nil))
  (algo1-case (cl-union '(a b c) '(c d a)))
  (algo1-case (cl-union '("a" "b") '("b" "c")))
  (algo1-case (cl-union '("a" "b") '("b" "c") :test #'equal))
  (algo1-case (cl-union '(1.0 2) '(1 2.0)))
  (algo1-case (cl-union '(1.0 2) '(1.0 2.0)))
  (algo1-case (cl-union (list p1 1) (list p2 2)))
  (algo1-case (cl-union '((1 . a) (2 . b)) '((2 . c) (3 . d)) :key #'car))
  (algo1-case (cl-union big (reverse big)))
  (algo1-case (length (cl-union (seq-take big 200) (seq-take (reverse big) 250))))
  (algo1-case (cl-union (seq-take big 200) (seq-take (reverse big) 250)))
  (algo1-case (cl-intersection '(1 2 3 4) '(3 4 5)))
  (algo1-case (cl-set-difference '(1 2 3 4) '(3 4 5)))
  (algo1-case (cl-set-exclusive-or '(1 2 3) '(3 4)))
  (algo1-case (cl-subsetp '(1 2) '(1 2 3)))
  (algo1-case (cl-member 2.0 '(1 2.0 3)))
  (algo1-case (cl-member 2 '(1 2.0 3)))
  (algo1-case (cl-member "a" '("a") :test #'equal))
  (algo1-case (cl-remove-duplicates '(1 2 1 3 2 4)))
  (algo1-case (cl-remove-duplicates '(1 2 1 3 2 4) :from-end t))
  (algo1-case (cl-remove-duplicates '("a" "b" "a") :test #'equal))
  (algo1-case (cl-remove-duplicates '((1 . a) (1 . b) (2 . c)) :key #'car))
  (algo1-case (cl-remove-duplicates [1 2 1 3]))
  (algo1-case (cl-remove-duplicates "abca"))
  (algo1-case (cl-remove-duplicates (seq-take big 120)))
  (algo1-case (cl-remove-duplicates (seq-take big 120) :from-end t))
  (algo1-case (cl-remove-if #'cl-evenp '(1 2 3 4 5 6)))
  (algo1-case (cl-remove-if #'cl-evenp [1 2 3 4 5 6]))
  (algo1-case (cl-remove-if #'cl-evenp '(1 2 3 4 5 6) :count 1))
  (algo1-case (cl-remove-if #'cl-evenp '(1 2 3 4 5 6) :count 1 :from-end t))
  (algo1-case (cl-remove-if #'cl-evenp '(1 2 3 4 5 6) :start 2 :end 5))
  (algo1-case (cl-remove-if #'cl-oddp '((1) (2) (3)) :key #'car))
  (algo1-case (cl-remove-if-not #'cl-evenp '(1 2 3 4)))
  (algo1-case (cl-delete-if #'cl-evenp (list 1 2 3 4)))
  (algo1-case (cl-remove 2 '(1 2 3 2)))
  (algo1-case (cl-position 3 '(1 2 3 4)))
  (algo1-case (cl-position-if #'cl-evenp '(1 3 4 5)))
  (algo1-case (cl-count-if #'cl-evenp '(1 2 3 4)))
  (algo1-case (cl-count 2 '(1 2 2 3)))
  (algo1-case (cl-find 3 '(1 2 3)))
  (algo1-case (cl-find-if #'cl-evenp '(1 3 4)))
  (algo1-case (cl-mapcar #'+ '(1 2 3) '(10 20 30)))
  (algo1-case (cl-remove-if #'cl-evenp 5))
  (algo1-case (delete-dups (list 1 2 1 3 "a" "a")))
  (algo1-case (seq-filter #'cl-evenp '(1 2 3 4)))
  (algo1-case (seq-filter #'cl-evenp [1 2 3 4])))
