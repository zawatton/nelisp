;; -*- lexical-binding: t; -*-
;; Parity corpus: prin1-to-string / format %S %s / prin1 / print of strings (ASCII, multibyte,
;; unibyte, raw bytes, escapes) alone and nested.  The multibyte flag of an ASCII-only result
;; differs from GNU everywhere (existing gap, not part of this corpus) and is not printed.
(defvar algo1-n 0)
(defun algo1-esc (s) (mapconcat (lambda (c) (if (or (< c 32) (> c 126)) (format "<%d>" c) (string c))) s ""))
(defmacro algo1-case (form)
  `(progn (setq algo1-n (1+ algo1-n))
          (let ((r (condition-case e ,form (error (list 'ERR (car e) (cdr e))))))
            (princ (format "%d: %s\n" algo1-n (if (stringp r) (algo1-esc r) r))))))
(let* ((strs (list "" "a" "plain text" "q\"uote" "back\\slash" "nl\nx" "tab\tx" "cr\rx" "ctl\x01\x1f\x7f" "\x7f"
                   "é" "café" "日本語" "emoji 😀" "mix é\n\t\"\\ 日" (string-to-multibyte "ascii mb") (string-to-multibyte "")
                   (string #x80) (string #xff) (string #x3fffff) (string #x3fff80 ?a) (concat "a" (string #x3fff90) "b")
                   (string-to-unibyte "abc") (unibyte-string 200 201 65) (unibyte-string 0 255)
                   (decode-coding-string "\303\251" 'utf-8) (encode-coding-string "é" 'utf-8) (make-string 300 ?é) (make-string 300 ?x)
                   (propertize "prop" 'face 'bold) (propertize "é prop" 'face 'bold)
                   (concat (make-string 70 ?a) "é" (make-string 70 ?b)) " nbsp" "​zwsp" "﻿bom" "\U0001F600")))
  (dolist (s strs)
    (algo1-case (prin1-to-string s))
    (algo1-case (prin1-to-string s t))
    (algo1-case (format "%S" s))
    (algo1-case (format "%s" s))
    (algo1-case (format "[%S|%s]" s s))
    (algo1-case (format "%-12S|%12s|%.3S" s s s))
    (algo1-case (prin1-to-string (list s s)))
    (algo1-case (prin1-to-string (vector s 1 'a)))
    (algo1-case (prin1-to-string (list 'a (cons s s) (list s))))
    (algo1-case (with-output-to-string (prin1 s)))
    (algo1-case (with-output-to-string (princ s)))
    (algo1-case (with-temp-buffer (prin1 s (current-buffer)) (buffer-string)))
    (algo1-case (let ((print-escape-newlines t)) (prin1-to-string s)))
    (algo1-case (let ((print-escape-nonascii t)) (prin1-to-string s)))
    (algo1-case (let ((print-escape-multibyte t)) (prin1-to-string s)))
    (algo1-case (let ((print-length 1)) (prin1-to-string (list s s))))
    (algo1-case (read-from-string (prin1-to-string s)))
    (algo1-case (equal s (car (read-from-string (prin1-to-string s)))))))
(algo1-case (prin1-to-string '("é" . "ü")))
(algo1-case (prin1-to-string (make-list 5 "日本")))
(algo1-case (prin1-to-string (list 1 2.5 "é" 'sym "x" [1 "é"])))
(algo1-case (prin1-to-string (intern "sy日")))
(algo1-case (format "%s-%s" "é" "x"))
(algo1-case (format "%S-%S" "é" "x"))
(algo1-case (multibyte-string-p (format "%S" "é")))
(algo1-case (multibyte-string-p (format "%S" "e")))
(algo1-case (string-bytes (format "%S" "é")))
(algo1-case (length (format "%S" "日本語")))
