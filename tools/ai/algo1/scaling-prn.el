;; -*- lexical-binding: t; -*-
;; Scaling: prin1-to-string / prin1 / read-from-string at n and 4n; linear means ratio ~4.
;; Prints "NAME t1 t4 ratio PASS|FAIL" (limit 8; depth rows use limit 8 as well).
(defvar algo1-fail nil)
(defun algo1-time (thunk reps)
  (let ((t0 (float-time))) (dotimes (_ reps) (funcall thunk)) (/ (- (float-time) t0) reps)))
(defun algo1-ratio (name mk fn reps &optional limit0)
  (let* ((a (funcall mk 500)) (b (funcall mk 2000))
         (t1 (algo1-time (lambda () (funcall fn a)) reps))
         (t4 (algo1-time (lambda () (funcall fn b)) reps))
         (r (/ t4 (max t1 1e-9))) (ok (< r (or limit0 8))))
    (unless ok (setq algo1-fail t))
    (princ (format "%s n=500 %.6fs n=2000 %.6fs ratio %.2f us/elt %.1f %s\n" name t1 t4 r (/ (* 1e6 t4) 2000) (if ok "PASS" "FAIL")))))
(defun algo1-nest (n) (let (l) (dotimes (i n) (push (list i (format "s%d" i) (cons i (* i 0.5)) (vector i 'sym (list i i))) l)) (nreverse l)))
(defun algo1-deep (n) (let ((x nil)) (dotimes (_ n) (setq x (list x))) x))
(defun algo1-deepv (n) (let ((x nil)) (dotimes (_ n) (setq x (vector x 1))) x))
(algo1-ratio "prin1-nest" #'algo1-nest #'prin1-to-string 3)
(algo1-ratio "prin1-ints" (lambda (n) (number-sequence 1 n)) #'prin1-to-string 3)
(algo1-ratio "prin1-floats" (lambda (n) (mapcar (lambda (i) (* i 0.37)) (number-sequence 1 n))) #'prin1-to-string 3)
(algo1-ratio "prin1-strings" (lambda (n) (mapcar (lambda (i) (format "str %d\n\"q\"" i)) (number-sequence 1 n))) #'prin1-to-string 3)
(algo1-ratio "prin1-symbols" (lambda (n) (mapcar (lambda (i) (intern (format "sym-%d" i))) (number-sequence 1 n))) #'prin1-to-string 3)
(algo1-ratio "prin1-deep-list" (lambda (n) (algo1-deep (/ n 4))) #'prin1-to-string 3)
(algo1-ratio "prin1-deep-vector" (lambda (n) (algo1-deepv (/ n 4))) #'prin1-to-string 3)
(algo1-ratio "prin1-one-long-string" (lambda (n) (make-string (* n 20) ?a)) #'prin1-to-string 3)
(algo1-ratio "prin1-to-buffer" #'algo1-nest (lambda (x) (with-temp-buffer (prin1 x (current-buffer)) (buffer-size))) 3)
(algo1-ratio "read-nest" (lambda (n) (prin1-to-string (algo1-nest n))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-ints" (lambda (n) (prin1-to-string (number-sequence 1 n))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-floats" (lambda (n) (prin1-to-string (mapcar (lambda (i) (* i 0.37)) (number-sequence 1 n)))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-strings" (lambda (n) (prin1-to-string (mapcar (lambda (i) (format "str %d\n\"q\"" i)) (number-sequence 1 n)))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-symbols" (lambda (n) (prin1-to-string (mapcar (lambda (i) (intern (format "sym-%d" i))) (number-sequence 1 n)))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-deep" (lambda (n) (prin1-to-string (algo1-deep (/ n 4)))) (lambda (s) (car (read-from-string s))) 3)
(algo1-ratio "read-many-forms" (lambda (n) (mapconcat (lambda (i) (format "(foo %d \"bar\" (baz . %d))\n" i i)) (number-sequence 1 n) "")) (lambda (s) (let ((p 0) (c 0)) (while (condition-case nil (let ((r (read-from-string s p))) (setq p (cdr r) c (1+ c))) (end-of-file nil)))) ) 2)
(kill-emacs (if algo1-fail 1 0))
