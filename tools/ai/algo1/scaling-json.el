;; -*- lexical-binding: t; -*-
;; Scaling: json-parse-string / json-serialize at N and 4N elements; linear means ratio ~4.
;; Prints "NAME t1 t4 ratio PASS|FAIL" (limit 8) and exits nonzero on a failure.
(defvar algo1-fail nil)
(defun algo1-time (thunk reps)
  (let ((t0 (float-time))) (dotimes (_ reps) (funcall thunk)) (/ (- (float-time) t0) reps)))
(defun algo1-ratio (name mk fn reps &optional limit0)
  (let* ((a (funcall mk 500)) (b (funcall mk 2000))
         (t1 (algo1-time (lambda () (funcall fn a)) reps))
         (t4 (algo1-time (lambda () (funcall fn b)) reps))
         (r (/ t4 (max t1 1e-9))) (ok (< r (or limit0 8))))
    (unless ok (setq algo1-fail t))
    (princ (format "%s n=500 %.6fs n=2000 %.6fs ratio %.2f ns/elt %.0f %s\n" name t1 t4 r (/ (* 1e9 t4) 2000) (if ok "PASS" "FAIL")))))
(defun algo1-nums (n) (concat "[" (mapconcat #'number-to-string (number-sequence 1 n) ",") "]"))
(defun algo1-objs (n) (concat "[" (mapconcat (lambda (i) (format "{\"id\":%d,\"name\":\"n%d\",\"tags\":[\"a\",\"b\"],\"v\":%d.5,\"ok\":true,\"z\":null}" i i i)) (number-sequence 1 n) ",") "]"))
(defun algo1-esc (n) (concat "[" (mapconcat (lambda (i) (format "\"line %d\\n\\t\\\"q\\\" \\u00e9\"" i)) (number-sequence 1 n) ",") "]"))
(defun algo1-mkalist (n) (let (l) (dotimes (i n) (push (list (cons 'id i) (cons 'name (format "n%d" i)) (cons 'tags (vector "a" "b")) (cons 'v (+ i 0.5)) (cons 'ok t)) l)) (vconcat l)))
(defun algo1-mkhash (n) (vconcat (mapcar (lambda (i) (let ((h (make-hash-table :test 'equal))) (puthash "id" i h) (puthash "name" (format "n%d" i) h) (puthash "v" (+ i 0.5) h) h)) (number-sequence 1 n))))
(defun algo1-mkstr (n) (vconcat (mapcar (lambda (i) (format "line %d\n\t\"q\" é" i)) (number-sequence 1 n))))
(defun algo1-bigstr (n) (json-serialize (make-string (* n 10) ?a)))
(algo1-ratio "parse-nums" #'algo1-nums #'json-parse-string 3)
(algo1-ratio "parse-objs-hash" #'algo1-objs #'json-parse-string 3)
(algo1-ratio "parse-objs-alist" #'algo1-objs (lambda (s) (json-parse-string s :object-type 'alist :array-type 'list)) 3)
(algo1-ratio "parse-escaped-strings" #'algo1-esc #'json-parse-string 3)
(algo1-ratio "serialize-alist" #'algo1-mkalist #'json-serialize 3)
(algo1-ratio "serialize-hash" #'algo1-mkhash #'json-serialize 3)
(algo1-ratio "serialize-strings" #'algo1-mkstr #'json-serialize 3)
(algo1-ratio "serialize-one-long-string" (lambda (n) (make-string (* n 10) ?a)) #'json-serialize 3)
(kill-emacs (if algo1-fail 1 0))
