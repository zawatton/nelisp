;;; gc-port-marker-probe.el --- marker behaviour probes: GNU 31.1 vs NeLisp  -*- lexical-binding: t; -*-
;; Run: emacs -Q --batch -l FILE (GNU) and NELISP --load FILE.  One "NAME => RESULT" line per case.
;; The marker representation step (Doc 216 S5, a two-field detached marker) must leave every NeLisp
;; line unchanged; lines that differ from GNU are recorded pre-existing differences.
(defmacro pm (name form)
  `(princ (format "%s => %S\n" ,name (condition-case err ,form (error (list 'ERR (car err) (cdr err)))))))

(pm "make-marker" (let ((m (make-marker))) (list (markerp m) (marker-position m) (marker-buffer m) (marker-insertion-type m))))
(pm "predicates" (let ((m (make-marker))) (list (markerp m) (markerp 1) (markerp nil) (integer-or-marker-p m) (number-or-marker-p m) (integerp m) (numberp m) (atom m) (type-of m))))
(pm "set-marker" (with-temp-buffer (insert "hello world") (let ((m (make-marker))) (set-marker m 3) (list (marker-position m) (eq (marker-buffer m) (current-buffer))))))
(pm "set-marker-clamp" (with-temp-buffer (insert "abc") (let ((m (make-marker))) (list (marker-position (set-marker m 100)) (marker-position (set-marker m -5)) (marker-position (set-marker m 0))))))
(pm "set-marker-nil" (with-temp-buffer (insert "abc") (let ((m (copy-marker 2))) (set-marker m nil) (list (marker-position m) (marker-buffer m)))))
(pm "copy-marker" (with-temp-buffer (insert "abcdef") (let* ((m (copy-marker 4)) (c (copy-marker m))) (list (marker-position m) (marker-position c) (eq m c) (equal m c)))))
(pm "copy-marker-type" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3 t)) (n (copy-marker 3))) (list (marker-insertion-type m) (marker-insertion-type n)))))
(pm "point-marker" (with-temp-buffer (insert "abcdef") (goto-char 3) (let ((m (point-marker))) (list (marker-position m) (marker-insertion-type m)))))
(pm "point-min-max-marker" (with-temp-buffer (insert "abcdef") (list (marker-position (point-min-marker)) (marker-position (point-max-marker)))))
(pm "mark-marker" (with-temp-buffer (insert "abc") (list (markerp (mark-marker)) (marker-position (mark-marker)))))
(pm "insertion-type-set" (with-temp-buffer (let ((m (make-marker))) (set-marker-insertion-type m t) (let ((a (marker-insertion-type m))) (set-marker-insertion-type m nil) (list a (marker-insertion-type m))))))
(pm "insert-before-marker-type-nil" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3))) (goto-char 3) (insert "XX") (marker-position m))))
(pm "insert-at-marker-type-t" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3 t))) (goto-char 3) (insert "XX") (marker-position m))))
(pm "insert-before" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 4))) (goto-char 2) (insert "ZZZ") (marker-position m))))
(pm "insert-after" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 2))) (goto-char 5) (insert "ZZZ") (marker-position m))))
(pm "insert-before-marker-fn" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3))) (goto-char 3) (insert-before-markers "YY") (marker-position m))))
(pm "delete-before" (with-temp-buffer (insert "abcdefgh") (let ((m (copy-marker 6))) (delete-region 2 4) (marker-position m))))
(pm "delete-around" (with-temp-buffer (insert "abcdefgh") (let ((m (copy-marker 4))) (delete-region 2 6) (marker-position m))))
(pm "delete-after" (with-temp-buffer (insert "abcdefgh") (let ((m (copy-marker 2))) (delete-region 4 7) (marker-position m))))
(pm "goto-char-marker" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 2))) (goto-char m) (point))))
(pm "arith" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3))) (list (+ m 1) (1+ m) (- m 1) (* m 2) (+ m m) (max m 1) (min m 10)))))
(pm "compare" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3)) (n (copy-marker 5))) (list (= m 3) (< m n) (> m n) (<= m 3) (/= m n) (= m n) (eql m 3) (eq m m) (equal m (copy-marker 3))))))
(pm "marker-as-index" (with-temp-buffer (insert "abcdef") (let ((m (copy-marker 3))) (list (char-after m) (buffer-substring m (point-max)) (substring "abcdef" (1- m))))))
(pm "format" (with-temp-buffer (insert "abc") (let ((m (copy-marker 2))) (list (format "%d" m) (format "%s" (marker-position m))))))
(pm "prin1" (with-temp-buffer (insert "abc") (let ((m (copy-marker 2)) (e (make-marker))) (list (string-match-p "\\`#<marker at 2 in " (prin1-to-string m)) (prin1-to-string e)))))
(pm "marker-in-list" (with-temp-buffer (insert "abc") (let* ((m (copy-marker 2)) (l (list m 1 m))) (list (eq (car l) m) (eq (nth 2 l) m) (marker-position (nth 2 l))))))
(pm "marker-in-vector" (with-temp-buffer (insert "abc") (let* ((m (copy-marker 2)) (v (vector m m))) (list (eq (aref v 0) m) (marker-position (aref v 1))))))
(pm "marker-in-closure" (with-temp-buffer (insert "abc") (let* ((m (copy-marker 2)) (f (lambda () (marker-position m)))) (goto-char 1) (insert "Z") (funcall f))))
(pm "marker-in-hash" (with-temp-buffer (insert "abc") (let ((h (make-hash-table :test 'eq)) (m (copy-marker 2))) (puthash m 'v h) (gethash m h))))
(pm "many-markers" (with-temp-buffer (insert (make-string 100 ?x)) (let ((ms nil)) (dotimes (i 50) (push (copy-marker (1+ (* 2 i))) ms)) (goto-char 1) (insert "ABC") (let ((s 0)) (dolist (m ms) (setq s (+ s (marker-position m)))) s))))
(pm "markers-two-buffers" (let ((m nil)) (with-temp-buffer (insert "abc") (setq m (copy-marker 2))) (list (marker-position m) (marker-buffer m))))
(pm "set-marker-other-buffer" (let ((b1 (generate-new-buffer " a")) (b2 (generate-new-buffer " b"))) (with-current-buffer b1 (insert "abcdef")) (with-current-buffer b2 (insert "xy")) (let ((m (set-marker (make-marker) 3 b1))) (let ((r (list (marker-position m) (eq (marker-buffer m) b1)))) (set-marker m 2 b2) (kill-buffer b1) (kill-buffer b2) (append r (list (marker-position m)))))))
(pm "kill-buffer-detaches" (let ((m (make-marker))) (with-temp-buffer (insert "abc") (set-marker m 2)) (list (marker-position m) (marker-buffer m))))
(pm "move-marker" (with-temp-buffer (insert "abcdef") (let ((m (make-marker))) (move-marker m 4) (marker-position m))))
(pm "buffer-has-markers" (with-temp-buffer (insert "abc") (copy-marker 2) (garbage-collect) (list (marker-position (copy-marker 3)))))
(pm "gc-keeps-markers" (with-temp-buffer (insert (make-string 200 ?x)) (let ((ms nil)) (dotimes (i 100) (push (copy-marker (1+ i)) ms)) (garbage-collect) (garbage-collect) (let ((s 0)) (dolist (m ms) (setq s (+ s (marker-position m)))) s))))
(pm "gc-markers-updated" (with-temp-buffer (insert (make-string 50 ?x)) (let ((ms nil)) (dotimes (i 20) (push (copy-marker (1+ i) (= (% i 2) 0)) ms)) (garbage-collect) (goto-char 1) (insert "QQ") (garbage-collect) (mapcar #'marker-position (reverse ms)))))
(pm "marker-error-position" (marker-position 5))
(pm "marker-error-set" (set-marker 5 1))
(pm "marker-error-type" (marker-insertion-type "s"))
(pm "set-marker-bad-pos" (with-temp-buffer (set-marker (make-marker) "a")))
(pm "marker-from-marker" (with-temp-buffer (insert "abc") (let ((m (copy-marker 2))) (marker-position (set-marker (make-marker) m)))))
(pm "narrowing" (with-temp-buffer (insert "abcdefgh") (let ((m (copy-marker 7))) (narrow-to-region 2 5) (list (marker-position m) (point-min) (point-max)))))
(pm "equal-markers" (with-temp-buffer (insert "abc") (list (equal (copy-marker 2) (copy-marker 2)) (equal (copy-marker 2) (copy-marker 3)) (equal (make-marker) (make-marker)))))
(pm "bytecomp" (funcall (lambda (b) (with-current-buffer b (let ((m (copy-marker 2 t))) (goto-char 2) (insert "q") (list (marker-position m) (marker-insertion-type m))))) (let ((b (generate-new-buffer " t"))) (with-current-buffer b (insert "abc")) b)))
(princ "PM-DONE\n")
