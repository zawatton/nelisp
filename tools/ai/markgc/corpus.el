;;; -*- lexical-binding: t; -*-
;; Marker semantics corpus: one line per case; compare NeLisp vs GNU output.
(defvar mk--n 0)
(defmacro mk-case (&rest body)
  `(progn (setq mk--n (1+ mk--n))
          (princ (format "%d: %S\n" mk--n (condition-case e (progn ,@body) (error (list 'ERR (car e) (cdr e))))))))
(defmacro mk-buf (&rest body)
  `(with-temp-buffer (insert "0123456789") ,@body))
(mk-case (mk-buf (let ((m (copy-marker 5))) (goto-char 5) (insert "ab") (list (marker-position m) (marker-insertion-type m)))))
(mk-case (mk-buf (let ((m (copy-marker 5 t))) (goto-char 5) (insert "ab") (list (marker-position m) (marker-insertion-type m)))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (goto-char 5) (insert-before-markers "ab") (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (goto-char 2) (insert "ab") (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (goto-char 8) (insert "ab") (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (delete-region 3 8) (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 9))) (delete-region 3 8) (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 2))) (delete-region 3 8) (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (set-marker m nil) (list (marker-position m) (marker-buffer m)))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (set-marker m nil) (goto-char 1) (insert "zz") (marker-position m))))
(mk-case (mk-buf (let ((m (make-marker))) (set-marker m 4) (goto-char 1) (insert "zz") (list (marker-position m) (eq (marker-buffer m) (current-buffer))))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (set-marker m 100) (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5)) (m2 (make-marker))) (set-marker m2 m) (goto-char 1) (insert "q") (list (marker-position m) (marker-position m2)))))
(mk-case (mk-buf (let ((m (point-marker))) (goto-char 3) (insert "x") (list (marker-position m) (point)))))
(mk-case (mk-buf (let ((a (point-min-marker)) (b (point-max-marker))) (goto-char 3) (insert "x") (list (marker-position a) (marker-position b)))))
(mk-case (mk-buf (goto-char 4) (save-excursion (goto-char 2) (insert "ab") (goto-char 9)) (point)))
(mk-case (mk-buf (goto-char 4) (save-excursion (delete-region 1 6)) (point)))
(mk-case (mk-buf (let ((m (copy-marker 6))) (erase-buffer) (insert "abc") (marker-position m))))
(mk-case (let ((b (generate-new-buffer "mk")) m) (with-current-buffer b (insert "abc") (setq m (copy-marker 2))) (kill-buffer b) (list (marker-position m) (marker-buffer m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (garbage-collect) (goto-char 1) (insert "ab") (garbage-collect) (insert "c") (marker-position m))))
(mk-case (mk-buf (let ((l (list (copy-marker 5) (copy-marker 7 t)))) (garbage-collect) (goto-char 5) (insert "ab") (garbage-collect) (mapcar #'marker-position l))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let ((d (match-data))) (garbage-collect) (goto-char 1) (insert "ab") (mapcar #'marker-position d))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (bufferp (car (last (match-data t))))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let ((d (match-data))) (set-match-data d t) (list d (match-beginning 0)))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let* ((d (match-data)) (m (car d))) (set-match-data d t) (list (marker-buffer m) (marker-position m) (match-end 2)))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let ((d (match-data))) (set-match-data d) (goto-char 1) (insert "ab") (list (match-beginning 0) (match-end 0)))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (save-match-data (re-search-forward "7")) (list (match-beginning 0) (match-end 0))))
(mk-case (mk-buf (let ((m (copy-marker 5)) (n 0)) (dotimes (_ 3000) (copy-marker 5) (point-marker)) (garbage-collect) (goto-char 1) (insert "ab") (marker-position m))))
(mk-case (mk-buf (let ((m (copy-marker 5))) (goto-char 5) (insert "x") (set-marker-insertion-type m t) (insert "y") (list (marker-position m) (marker-insertion-type m)))))
(mk-case (mk-buf (let ((m (copy-marker 5)) (h (make-hash-table :test 'eq))) (puthash m 1 h) (garbage-collect) (goto-char 1) (insert "ab") (list (marker-position m) (hash-table-count h)))))

(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let* ((d (match-data)) (m0 (car d)) (r (match-data nil d t))) (list (eq r d) (mapcar #'markerp r) (marker-buffer m0) (mapcar (lambda (x) (and x (marker-position x))) r)))))
(mk-case (mk-buf (goto-char 1) (re-search-forward "\\(3\\)\\(4\\)") (let* ((d (match-data)) (r (match-data nil d))) (list (eq r d) (mapcar #'marker-position r)))))
