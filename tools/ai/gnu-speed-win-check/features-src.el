;;; features.el --- New v7 runtime paths, printed for comparison with GNU -*- lexical-binding: t; -*-
;; Each line is checked against GNU Emacs output; the forms are byte-compiled
;; so the bytecode fast paths (directcall, hash hits, switch, mapc/maphash
;; callbacks) are the ones exercised.
(defun feat-out (label value) (princ (format "%s %S\n" label value)))
(defun feat-hash ()
  (let ((h (make-hash-table :test 'eq)) (s (make-hash-table :test 'equal)) (acc 0))
    (dotimes (i 200) (puthash i (* i i) h))
    (dotimes (i 50) (puthash (format "k%d" i) i s))
    (dotimes (i 200) (setq acc (+ acc (gethash i h 0))))
    (puthash 7 'seven h) (remhash 8 h)
    (list acc (gethash 7 h) (gethash 8 h 'gone) (gethash "k42" s) (hash-table-count h))))
(defun feat-maphash ()
  (let ((h (make-hash-table :test 'eq)) (sum 0) (keys nil))
    (dotimes (i 16) (puthash i (* 3 i) h))
    (maphash (lambda (k v) (setq sum (+ sum k v))) h)
    (maphash (lambda (k _v) (push k keys)) h)
    (list sum (length keys))))
(defun feat-mapc ()
  (let ((n 0) (l (number-sequence 1 64)))
    (mapc (lambda (x) (setq n (+ n x))) l)
    (list n (mapcar #'1+ '(1 2 3)) (mapcar #'car '((a . 1) (b . 2))))))
(defun feat-switch (x)
  (pcase x (`a 1) (`b 2) (`c 3) (`d 4) (`e 5) (_ 0)))
(defun feat-cond-switch (n)
  (cond ((eq n 10) 'ten) ((eq n 20) 'twenty) ((eq n 30) 'thirty) ((eq n 40) 'forty) (t 'other)))
(defun feat-calls ()
  (let ((acc 0) (v (vector 3 5 7 11)) (l (list 7 8 9)))
    (dotimes (i 1000)
      (setq acc (+ acc (logand i 3) (car l) (length v) (nth 1 l)))
      (aset v 0 i))
    (list acc (aref v 0))))
(defun feat-closure ()
  (let ((f (lambda (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s i)) (setq i (1+ i))) s))))
    (list (funcall f 10) (funcall f 1000) (funcall f 100000))))
(defvar feat-dv 0)
(defun feat-dyn ()
  (let ((r 0))
    (dotimes (i 100)
      (setq feat-dv (1+ feat-dv))
      (let ((feat-dv 3)) (setq r (+ r feat-dv))))
    (list r feat-dv)))
