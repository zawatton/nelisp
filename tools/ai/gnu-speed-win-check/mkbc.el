;; Write GNU-compiled definitions of features-src.el as literal bytecode.
(load (expand-file-name "features-src.el") nil t)
(with-temp-file "features-bc.el"
  (insert ";;; features-bc.el --- generated by mkbc.el from features-src.el (GNU 31.1) -*- lexical-binding: t; -*-\n")
  (insert "(defvar feat-dv 0)\n")
  (let ((print-escape-newlines t) (print-escape-nonascii t) (print-circle t) (print-length nil) (print-level nil))
    (dolist (f '(feat-out feat-hash feat-maphash feat-mapc feat-switch feat-cond-switch feat-calls feat-closure feat-dyn))
      (insert (format "(defalias '%s %s)\n" f (prin1-to-string (byte-compile f)))))))
