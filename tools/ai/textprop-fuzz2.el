;;; textprop-fuzz2.el --- larger-tree differential fuzz for the textprop lane  -*- lexical-binding: t; -*-
;; Run on GNU Emacs and on NeLisp and diff:  TF_SEED=3 TF_RUNS=6 emacs -Q --batch -l tools/ai/textprop-fuzz2.el
;; Trees of up to a few hundred intervals with runs of equal values, buffers (with narrowing) and
;; strings, every change-search function with random LIMIT arguments, the range mutators, and the
;; interval dump after each step.
(defvar tg-seed (let ((s (getenv "TF_SEED"))) (if s (string-to-number s) 1)))
(defun tg-rand (n) (setq tg-seed (% (+ (* tg-seed 48271) 11) 2147483647)) (% (/ tg-seed 7) (max n 1)))
(defun tg-key () (nth (tg-rand 3) '(a b c)))
(defun tg-val () (nth (tg-rand 3) '(x y z)))
(defun tg-plist () (let ((k (tg-key)) (k2 (tg-key))) (if (= 0 (tg-rand 2)) (list k (tg-val)) (if (eq k k2) (list k (tg-val)) (list k (tg-val) k2 (tg-val))))))
(defun tg-dump (obj)
  (let ((p (if (stringp obj) 0 (point-min))) (end (if (stringp obj) (length obj) (point-max))) (out nil))
    (while (< p end)
      (let ((n (or (next-property-change p obj) end)))
        (push (list p n (text-properties-at p obj)) out) (setq p n)))
    (nreverse out)))
(defun tg-queries (obj n lo)
  (let (r)
    (dotimes (_ 8)
      (let* ((a (+ lo (tg-rand (1+ n)))) (b (+ lo (tg-rand (1+ n)))) (k (tg-key)))
        (push (list a b
                    (next-property-change a obj) (next-property-change a obj b)
                    (previous-property-change a obj) (previous-property-change a obj b)
                    (next-single-property-change a k obj) (next-single-property-change a k obj b)
                    (previous-single-property-change a k obj) (previous-single-property-change a k obj b)
                    (get-text-property (min a (+ lo n -1)) k obj)
                    (text-property-any (min a b) (max a b) k (tg-val) obj)
                    (text-property-not-all (min a b) (max a b) k (tg-val) obj))
              r)))
    (nreverse r)))
(defun tg-mutate (obj n lo)
  (let* ((a (+ lo (tg-rand (1+ n)))) (b (+ lo (tg-rand (1+ n)))) (op (tg-rand 6)))
    (cond ((= op 0) (list 'put (put-text-property a b (tg-key) (tg-val) obj)))
          ((= op 1) (list 'add (add-text-properties a b (tg-plist) obj)))
          ((= op 2) (list 'set (set-text-properties a b (if (= 0 (tg-rand 3)) nil (tg-plist)) obj)))
          ((= op 3) (list 'rem (remove-text-properties a b (list (tg-key) nil) obj)))
          ((= op 4) (list 'reml (remove-list-of-text-properties a b (list (tg-key) (tg-key)) obj)))
          (t (list 'put2 (put-text-property (min a b) (min (+ (min a b) 1 (tg-rand 4)) (+ lo n)) (tg-key) (tg-val) obj))))))
(defun tg-run (kind)
  (let* ((n (+ 150 (tg-rand 250))) (text (make-string n ?a)) (log nil) obj lo)
    (if (eq kind 'str)
        (setq obj text lo 0)
      (setq obj (current-buffer) lo 1)
      (erase-buffer) (insert text))
    (dotimes (i (+ 40 (tg-rand 80)))
      (push (tg-mutate obj n lo) log))
    (princ (format "%s mut %S\n" kind (reverse log)))
    (princ (format "%s dump %S\n" kind (tg-dump obj)))
    (dotimes (_ 6) (princ (format "%s q %S\n" kind (tg-queries obj n lo))))
    (when (eq kind 'buf)
      (narrow-to-region (+ 10 (tg-rand 20)) (- (point-max) 10 (tg-rand 20)))
      (princ (format "buf narrowed dump %S\n" (tg-dump obj)))
      (let ((m (- (point-max) (point-min))))
        (dotimes (_ 3) (princ (format "buf nq %S\n" (tg-queries obj m (point-min))))))
      (widen))
    (when (eq kind 'buf)
      (goto-char (+ 20 (tg-rand 50))) (insert (propertize "ZZ" 'a 'x)) (delete-region 30 (+ 31 (tg-rand 20)))
      (princ (format "buf edit dump %S\n" (tg-dump obj))))))
(let ((runs (let ((s (getenv "TF_RUNS"))) (if s (string-to-number s) 4))))
  (dotimes (_ runs)
    (condition-case e (tg-run 'str) (error (princ (format "ERR %S\n" e))))
    (with-temp-buffer (condition-case e (tg-run 'buf) (error (princ (format "ERR %S\n" e)))))))
(kill-emacs 0)
