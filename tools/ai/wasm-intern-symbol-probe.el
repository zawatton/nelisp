;;; wasm-intern-symbol-probe.el --- Build interning fixtures -*- lexical-binding: t; -*-
(require 'wasm-intern-symbol)
(defvar wasm-target-alloc--library-only t)
(require 'wasm-target-alloc-probe)
(defun wasm-intern-symbol-json (path value)
  (with-temp-file path (insert (json-encode value))))
(defun wasm-intern-symbol-write (path value)
  (with-temp-file path
    (let ((print-length nil) (print-level nil) (print-circle nil)) (prin1 value (current-buffer)))))
(defun wasm-intern-symbol-context ()
  "Read authorities under clean oracle launch discipline."
  (wasm-intern-symbol-isolated
    (let* ((record (wasm-intern-symbol-record))
           (_extent (wasm-intern-symbol-region-contract (plist-get record :init)
                                                       (plist-get record :definitions)))
           (allocator (wasm-target-alloc-oracle-record))
           (closure (wasm-target-alloc-closure allocator))
           (adapted (wasm-target-alloc-closure allocator wasm-target-alloc-adapters))
           (contract (wasm-target-init-contract))
           (authority (wasm-target-alloc-authority)))
      (list :record record :allocator allocator :closure closure :adapted adapted
            :contract contract :authority authority :owners (plist-get authority :owners)))))
(defun wasm-intern-symbol-source (context &optional omitted)
  (let* ((record (plist-get context :record))
         (derived (wasm-intern-symbol-derive (plist-get record :init))))
    (append (wasm-target-alloc-source (plist-get context :contract) (plist-get context :owners)
                                    (wasm-target-init-rewrite (plist-get context :adapted)))
            (wasm-target-init-rewrite (plist-get record :definitions))
            (list (if omitted (wasm-target-init-rewrite (plist-get record :init))
                        (plist-get derived :adapter)))
            (wasm-intern-symbol-extras derived))))
(defun wasm-intern-symbol-manifest (path context compilation omitted)
  "Derive every manifest field from authorities, actual files and compiler record."
  (let* ((record (plist-get context :record))
         (derived (wasm-intern-symbol-derive (plist-get record :init)))
         (files (delete-dups (append
                   (mapcar #'car (plist-get record :files))
                   (mapcar #'car (plist-get (plist-get context :allocator) :files))
                   (mapcar #'car (plist-get (plist-get (plist-get context :contract) :record) :files))
                   (mapcar #'car (plist-get (plist-get (plist-get context :authority) :native-oracle) :files))
                   (directory-files "tools/ai" t "\\`wasm-intern-symbol.*\\(?:el\\|mjs\\|sh\\|py\\)\\'")))))
    `((schema_version . 1) (genuine_alloc . t)
      (omitted . ,(if omitted t :json-false))
      (raw_reservers . ["nl_wasm_arena_init" "nl_wasm_intern_region_init"])
      (raw_reservation . "Two W0 adapters; one raw alloc-bytes site each when present; mmap page alignment 4096.")
      (wasm_sha256 . ,(wasm-rootstack--hash path))
      (compiled_source . ((path . ,(concat path ".source.eld")) (sha256 . ,(wasm-rootstack--hash (concat path ".source.eld")))))
      (region . ((size . ,(number-to-string (plist-get derived :total)))
                 (table_size . ,(number-to-string (plist-get derived :table-size)))
                 (page . ,(number-to-string (plist-get derived :page)))
                 (table_offset . ,(number-to-string (plist-get derived :table-offset)))
                 (cursor_offset . ,(number-to-string (plist-get derived :cursor-offset)))))
      (genuine_init . ,(prin1-to-string (plist-get record :init)))
      (adapter . ,(prin1-to-string (plist-get derived :adapter)))
      (consumers . ,(wasm-target-alloc-definition-rows (plist-get record :definitions)))
      (closure . ,(wasm-target-alloc-definition-rows (plist-get context :closure)))
      (composed_closure . ,(wasm-target-alloc-definition-rows (plist-get context :adapted)))
      (contract_words . ,(vconcat (plist-get (plist-get context :contract) :words)))
      (native . ,(vconcat (mapcar (lambda (row) (vector (car row) (cdr row))) (plist-get record :native-files))))
      (oracle_cases . ,(alist-get 'cases (json-read-file "target/wasm-intern-symbol/native-results.json")))
      (oracle_collision . ,(alist-get 'collision (json-read-file "target/wasm-intern-symbol/native-results.json")))
      (oracle_prefix_cases . ,(alist-get 'prefix_cases (json-read-file "target/wasm-intern-symbol/native-results.json")))
      (oracle_init_return . ,(alist-get 'init_return (json-read-file "target/wasm-intern-symbol/native-results.json")))
      (compiler_installation_root . ,(plist-get compilation :installation-root))
      (compiler_files . ,(vconcat (mapcar (lambda (row) (vector (file-relative-name (car row) wasm-rootstack--root) (cdr row)))
                                        (plist-get compilation :files))))
      (source_sha256 . ,(vconcat (mapcar (lambda (file) (vector (file-relative-name file wasm-rootstack--root)
                                                                 (wasm-rootstack--hash file))) files)))
      (limit . "Noncollecting interning only; no GC, reclamation, builtin dispatch, image loading or W0 execution claim. Native mmap failure becomes 0 in genuine init; raw Wasm memory.grow failure traps (not modelled)."))))
(defun wasm-intern-symbol-verify (path manifest-path)
  "Independently validate the saved schema, recompile and compare every manifest field."
  (let* ((context (wasm-intern-symbol-context))
         (manifest (json-read-file manifest-path))
         (omitted (eq (alist-get 'omitted manifest) t))
         (recompiled (concat path ".recompiled.wasm")))
    (wasm-intern-symbol-validate (concat path ".source.eld") (plist-get context :contract)
                                (plist-get context :owners) (plist-get context :closure)
                                (plist-get context :record) omitted)
    (let* ((compilation (wasm-intern-symbol-compile-file (concat path ".source.eld") recompiled t))
           (expected (wasm-intern-symbol-manifest path context compilation omitted)))
      (unless (equal (wasm-rootstack--hash path) (wasm-rootstack--hash recompiled))
        (error "Intern compiler reproduction mismatch"))
      (let ((reproduced (json-read-from-string (json-encode expected))))
        (unless (equal manifest reproduced)
          (error "Intern manifest contract mismatch: %S"
                 (cl-loop for (key . value) in reproduced
                          unless (equal value (alist-get key manifest)) collect key)))))
    (princ "intern-provenance=closed-schema clean-child reproduced manifest-exact\n")))
(defun wasm-intern-symbol-build ()
  (make-directory wasm-intern-symbol-directory t)
  (let ((context (wasm-intern-symbol-context)))
    (dolist (omitted '(t nil))
      (let* ((path (concat wasm-intern-symbol-directory (if omitted "red.wasm" "green.wasm")))
             (source (wasm-intern-symbol-source context omitted)))
        (wasm-intern-symbol-write (concat path ".source.eld") source)
        (wasm-intern-symbol-validate (concat path ".source.eld") (plist-get context :contract)
                                    (plist-get context :owners) (plist-get context :closure)
                                    (plist-get context :record) omitted)
        (let ((compilation (wasm-intern-symbol-compile-file (concat path ".source.eld") path t)))
          (wasm-intern-symbol-json (concat path ".json") (wasm-intern-symbol-manifest path context compilation omitted)))
        (when omitted (princ "genuine-intern-init=expected-compiles diagnostic=nil mmap=ENOSYS (module evidence in red.log)\n"))
        (princ (format "intern-module=%s consumers=18 raw-reservers=2 both=W0-adapters\n" path))))))
(unless (bound-and-true-p wasm-intern-symbol--library-only)
  (condition-case err (wasm-intern-symbol-build)
    (error (princ (format "intern-build-error=%S\n" err)) (kill-emacs 1))))
(provide 'wasm-intern-symbol-probe)
