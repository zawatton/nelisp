;; E1: container size sweep (address at offset 8) and offset sweeps.
(defvar m 81985529216486895)
(defun e1-row (csize off)
  (let ((n 40) (cells nil) (k 0) (f 0))
    (while (< k n)
      (let ((c (alloc-bytes csize 8)) (b (alloc-bytes 32 8)))
        (ptr-write-u64 b 0 m) (ptr-write-u64 c off b) (setq cells (cons c cells)))
      (setq k (1+ k)))
    (garbage-collect)
    (let ((i 0) (keep nil)) (while (< i 20000) (let ((b (alloc-bytes 32 8))) (ptr-write-u64 b 0 99) (setq keep (cons b keep))) (setq i (1+ i))))
    (dolist (c cells) (unless (= (ptr-read-u64 (ptr-read-u64 c off) 0) m) (setq f (1+ f))))
    (princ (format "container=%d off=%d reclaimed=%d/%d\n" csize off f n))))
(dolist (cs '(16 24 32 48 64 128 256 400)) (e1-row cs 8))
(dolist (off '(0 16 24)) (e1-row 32 off))
(dolist (off '(0 16 200 392)) (e1-row 400 off))
