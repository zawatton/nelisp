;;; run.el --- vmfast2 VM parity corpus runner: same output on GNU 31.1 and NeLisp -*- lexical-binding: t; -*-
(load (expand-file-name "bc.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(defmacro v2-case (name form)
  `(princ (format "%s %S\n" ',name (condition-case err ,form (error (list 'ERROR err))))))
(defvar v2-l10 (number-sequence 1 10))
(defvar v2-h (let ((h (make-hash-table))) (dotimes (i 8) (puthash i (* 10 i) h)) h))
(defun v2-o (s) (symbol-function s))
;; Malformed byte code: GNU's own checks (invalid opcode with its offset, wrong argument count).
(defvar v2-bad0 (make-byte-code 257 (unibyte-string 0 135) [] 2))
(defvar v2-bad52 (make-byte-code 257 (unibyte-string 192 84 52 135) [1] 3))
(defvar v2-bad-mid (make-byte-code 257 (unibyte-string 137 84 136 192 172 135) [5] 3))
(defvar v2-ret (make-byte-code 257 (unibyte-string 135) [] 1))
(defvar v2-ret2 (make-byte-code 514 (unibyte-string 1 1 92 135) [] 4))
(defvar v2-zero (make-byte-code 0 (unibyte-string 192 135) [z] 1))
(v2-case bcp (mapcar (lambda (s) (byte-code-function-p (v2-o s))) '(v2-id v2-loop v2-uwp v2d-cb)))
(v2-case mapc-id (list (mapc #'v2-id v2-l10) (mapc (v2-o 'v2-id) [1 2 3]) (mapc #'v2-id "ab") (mapc #'v2-id nil)))
(v2-case mapcar-sq (list (mapcar #'v2-sq v2-l10) (mapcar (v2-o 'v2-sq) [4 5]) (mapcar #'v2-sq (string 3 4))))
(v2-case mapcar-loop (mapcar #'v2-loop '(0 1 5 100 1000)))
(v2-case mapcar-calls (mapcar #'v2-calls '(1 2 3 -4)))
(v2-case mapcar-cons (mapcar #'v2-cons '(1 a "s")))
(v2-case mapcar-err (v2-mapcar-err))
(v2-case mapcar-err-type (condition-case e (mapcar #'v2-sq '(1 a 3)) (error e)))
(v2-case throw-walk (v2-throw-walk))
(v2-case uwp-walk (v2-uwp-walk))
(v2-case cc-walk (mapcar #'v2-cc '(1 2 3 4)))
(v2-case bind-walk (list (mapcar #'v2-bind '(a b c)) v2-dyn))
(v2-case opt-walk (list (mapcar #'v2-opt '(1 2)) (mapcar (v2-o 'v2-opt) [x])))
(v2-case rest-walk (mapcar #'v2-rest '(1 2)))
(v2-case catch-walk (mapcar #'v2-catch '(1 2 3 4)))
(v2-case recur (list (v2-recur 0) (v2-recur 3) (v2-recur 6)))
(v2-case deep (list (v2-deep 10) (v2-deep 150)))
(v2-case closure (list (v2-closure 10) (v2-closure -1)))
(v2-case nested-throw (v2-nested-throw))
(v2-case self-mod (v2-self-mod (list 1 2 3 4 5)))
(v2-case maphash-two (v2-sum-hash v2-h))
(v2-case maphash-obj (let ((s nil)) (maphash (lambda (k v) (push (v2-two k v) s)) v2-h) (sort s #'<)))
(v2-case maphash-sym (let ((n 0)) (maphash (lambda (k v) (setq n (+ n (funcall (v2-o 'v2-two) k v)))) v2-h) n))
(v2-case maphash-err (v2-hash-err v2-h))
(v2-case dyn-cb (list (mapcar #'v2d-cb '(1 2)) (v2d-bind 'inner) (mapcar (lambda (x) (v2d-bind x)) '(p q))))
(v2-case wrong-args-2 (condition-case e (mapcar #'v2-two '(1 2)) (error e)))
(v2-case wrong-args-0 (condition-case e (mapc v2-zero '(1 2)) (error e)))
(v2-case bad0 (condition-case e (mapc v2-bad0 '(1 2)) (error e)))
(v2-case bad52 (condition-case e (mapcar v2-bad52 '(1 2)) (error e)))
(v2-case bad-mid (condition-case e (mapcar v2-bad-mid '(1 2)) (error e)))
(v2-case bad-direct (list (condition-case e (funcall v2-bad0 1) (error e)) (condition-case e (funcall v2-bad-mid 1) (error e))))
(v2-case ret-only (list (mapcar v2-ret '(1 2 3)) (let ((s 0)) (maphash (lambda (k v) (setq s (+ s (funcall v2-ret2 k v)))) v2-h) s)))
(v2-case ret2-hash (let ((r nil)) (maphash (lambda (k v) (push (funcall v2-ret2 k v) r)) v2-h) (sort r #'<)))
(v2-case ret2-direct-hash (let ((r 0)) (maphash v2-ret2 v2-h) r))
(v2-case funcall-loop (list (v2-funcall-loop #'v2-sq 100) (v2-funcall-loop (v2-o 'v2-loop) 50) (v2-funcall-loop v2-ret 7)))
(v2-case gc-walk (let ((r (mapcar #'v2-gc (number-sequence 1 400)))) (list (length r) (nth 49 r) (nth 399 r) (apply #'+ (mapcar #'car r)))))
(v2-case mapconcat (mapconcat #'symbol-name (mapcar (lambda (x) (intern (format "s%d" x))) '(1 2)) "-"))
(v2-case after v2-dyn)
(princ "VMFAST2-PARITY DONE\n")
(kill-emacs 0)
