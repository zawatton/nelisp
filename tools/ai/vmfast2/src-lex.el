;;; src-lex.el --- vmfast2 parity corpus, lexical part (compiled by mkbc.el with GNU 31.1) -*- lexical-binding: t; -*-
;; Byte-code callbacks of mapc / mapcar / mapconcat / maphash (the walkers' lean frame), byte-code
;; calls from byte code, non-local exits through callback frames and deep nesting of walks.
(defvar v2-log nil)
(defvar v2-dyn 'outer)
(defun v2-id (x) x)
(defun v2-sq (x) (* x x))
(defun v2-loop (x) (let ((s 0)) (dotimes (i x) (setq s (+ s i))) s))
(defun v2-calls (x) (v2-sq (v2-id x)))
(defun v2-cons (x) (list x (cons x x) (make-string 2 ?a)))
(defun v2-err (x) (if (= x 3) (error "boom %d" x) x))
(defun v2-throw (x) (if (= x 4) (throw 'v2-tag (list 'thrown x)) x))
(defun v2-uwp (x) (unwind-protect (if (= x 2) (error "uwp %d" x) (* 2 x)) (push x v2-log)))
(defun v2-cc (x) (condition-case e (if (= (% x 2) 0) (signal 'arith-error (list x)) x) (arith-error (list 'caught (cdr e)))))
(defun v2-readdyn () v2-dyn)
(defun v2-bind (x) (let ((v2-dyn x)) (v2-readdyn)))
(defun v2-opt (x &optional y) (list x y))
(defun v2-rest (x &rest r) (list x r))
(defun v2-two (k v) (+ k v))
(defun v2-catch (x) (catch 'inner (if (> x 2) (throw 'inner (- x)) x)))
(defun v2-recur (n) (if (<= n 0) 0 (1+ (apply #'+ (mapcar #'v2-recur (list (1- n) (1- n)))))))
(defun v2-deep (n) (if (= n 0) 'bottom (car (mapcar (lambda (_) (v2-deep (1- n))) '(1)))))
(defun v2-closure (k) (let ((acc nil)) (mapc (lambda (x) (push (+ x k) acc)) '(1 2 3)) acc))
(defun v2-mapcar-err () (condition-case e (mapcar #'v2-err '(1 2 3 4)) (error e)))
(defun v2-throw-walk () (catch 'v2-tag (mapc #'v2-throw '(1 2 3 4 5)) 'no-throw))
(defun v2-uwp-walk () (setq v2-log nil) (list (condition-case e (mapcar #'v2-uwp '(1 2 3)) (error e)) v2-log))
(defun v2-nested-throw () (catch 'out (mapc (lambda (x) (mapc (lambda (y) (when (= (* x y) 6) (throw 'out (list x y)))) '(1 2 3))) '(1 2 3)) nil))
(defun v2-gc (x) (when (= (% x 50) 0) (garbage-collect)) (list x (make-vector 3 x) (number-to-string x)))
(defun v2-funcall-loop (f n) (let ((r nil)) (dotimes (i n) (setq r (funcall f i))) r))
(defun v2-self-mod (lst) (let ((n 0)) (mapc (lambda (x) (setq n (+ n x)) (when (= x 2) (setcdr (cdr lst) nil))) lst) n))
(defun v2-sum-hash (h) (let ((s 0)) (maphash (lambda (k v) (setq s (+ s k v))) h) s))
(defun v2-hash-err (h) (condition-case e (maphash (lambda (k _v) (when (= k 3) (car k))) h) (error e)))
