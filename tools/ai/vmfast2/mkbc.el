;; mkbc.el --- write GNU-compiled byte code of src-lex.el and src-dyn.el as literal definitions (bc.el).
;; Run from this directory: emacs -Q --batch -l mkbc.el
(require 'bytecomp)
(defun v2-mk-compile (file names lexical)
  (let ((lexical-binding lexical))
    (load (expand-file-name file) nil t)
    (mapcar (lambda (f) (cons f (byte-compile f))) names)))
(let ((lex (v2-mk-compile "src-lex.el" '(v2-id v2-sq v2-loop v2-calls v2-cons v2-err v2-throw v2-uwp v2-cc v2-readdyn v2-bind
                                       v2-opt v2-rest v2-two v2-catch v2-recur v2-deep v2-closure v2-mapcar-err v2-throw-walk
                                       v2-uwp-walk v2-nested-throw v2-gc v2-funcall-loop v2-self-mod v2-sum-hash v2-hash-err) t))
      (dyn (v2-mk-compile "src-dyn.el" '(v2d-cb v2d-bind) nil)))
  (with-temp-file "bc.el"
    (insert ";;; bc.el --- generated by mkbc.el from src-lex.el and src-dyn.el (GNU 31.1) -*- lexical-binding: t; -*-\n")
    (insert "(defvar v2-log nil)\n(defvar v2-dyn 'outer)\n")
    (let ((print-escape-newlines t) (print-escape-nonascii t) (print-escape-control-characters t) (print-circle t) (print-length nil) (print-level nil))
      (dolist (p (append lex dyn))
        (insert (format "(defalias '%s %s)\n" (car p) (prin1-to-string (cdr p))))))))
