;;; word-heap-thread-dynamic.el --- Thread binding parity -*- lexical-binding: t; -*-

(defvar whtr-special 13)
(defvar whtr-unbound)
(declare-function ptr-write-u64 nil (address offset value))
(declare-function nelisp-thread-atomic-read nil (address))
(declare-function nelisp-thread-atomic-add nil (address value))
(declare-function nelisp-thread-join nil (address expected))
(declare-function nelisp-thread-gc-inhibit nil (requested))
(declare-function nelisp-thread-shared-alloc nil (bytes))
(declare-function nelisp-spin-until nil (address expected))
(declare-function thread-spawn nil (form))

(defun whtr-write (shared index value)
  (if (fboundp 'thread-spawn)
      (ptr-write-u64 shared (* index 8) value)
    (aset shared index value)))
(defun whtr-read (shared index)
  (if (fboundp 'thread-spawn)
      (nelisp-thread-atomic-read (+ shared (* index 8)))
    (aref shared index)))
(defun whtr-publish (shared index)
  (if (fboundp 'thread-spawn)
      (nelisp-thread-atomic-add (+ shared (* index 8)) 1)
    (aset shared index 1)))
(defun whtr-wait (shared index)
  (if (fboundp 'thread-spawn)
      (nelisp-spin-until (+ shared (* index 8)) 1)
    (while (= (aref shared index) 0) (thread-yield))))
(defun whtr-start (shared mode)
  (if (fboundp 'thread-spawn)
      (unless (= (thread-spawn (list 'whtr-dynamic-worker shared mode)) 1)
        (error "dynamic spawn"))
    (make-thread (lambda () (whtr-dynamic-worker shared mode)))))
(defun whtr-join (shared worker)
  (if (fboundp 'thread-spawn)
      (unless (= (nelisp-thread-join (+ shared 240) 1) 1) (error "dynamic join"))
    (thread-join worker)))
(defun whtr-recur (n)
  (if (= n 0) 0 (+ 1 (whtr-recur (1- n)))))

(defun whtr-dynamic-worker (shared mode)
  (if (= mode 1)
      (progn
        (whtr-write shared 0 whtr-special)
        (whtr-write shared 1 (default-value 'whtr-special))
        (setq whtr-special 17)
        (whtr-write shared 2 whtr-special)
        (let ((whtr-special 23))
          (whtr-write shared 3 whtr-special)
          (whtr-write shared 4 (default-value 'whtr-special))
          (set-default 'whtr-special 24)
          (whtr-write shared 5 whtr-special)
          (whtr-publish shared 31)
          (whtr-wait shared 32))
        (whtr-write shared 6 whtr-special)
        (setq whtr-special 42)
        (whtr-write shared 7 whtr-special))
    (if (= mode 2)
        (progn
          (whtr-write shared 0 whtr-special)
          (whtr-publish shared 31)
          (whtr-wait shared 32)
          (whtr-write shared 1 whtr-special)
          (setq whtr-special 42)
          (whtr-write shared 2 whtr-special))
      (progn
        (whtr-write shared 0 (if (boundp 'whtr-unbound) 1 0))
        (let ((whtr-unbound 23))
          (whtr-write shared 1 whtr-unbound)
          (whtr-publish shared 31)
          (whtr-wait shared 32))
        (whtr-write shared 2 (if (boundp 'whtr-unbound) 1 0))
        (setq whtr-unbound 42)
        (whtr-write shared 3 whtr-unbound))))
  (whtr-publish shared 30))

(defvar whtr-events nil)
(defun whtr-watcher (_symbol value operation _where)
  (when (eq operation 'unlet) (setq whtr-events (append whtr-events (list value)))))

(defun whtr-bytecode-parent (shared)
  (let ((whtr-special 71) (worker nil) (values nil))
    ;; At spawn, a younger interpreted binding91 and the preexisting VM lean
    ;; binding71 are both live. Returning from eval partially unwinds91.
    (setq worker (eval (list 'let '((whtr-special 91))
                             (list 'whtr-start shared 2)) t))
    (whtr-wait shared 31)
    (setq values (list whtr-special (default-value 'whtr-special)))
    (let ((whtr-special 72))
      (setq values (append values (list whtr-special))))
    (setq values (append values (list whtr-special)))
    (whtr-publish shared 32)
    (whtr-join shared worker)
    (append values (list whtr-special))))

(unless (getenv "WH_THREAD_DEFINITIONS_ONLY")
  (when (getenv "WH_THREAD_BYTECODE") (load (getenv "WH_THREAD_BYTECODE") nil t))
  (let* ((mode (string-to-number (or (getenv "WH_THREAD_DYNAMIC_CASE") "1")))
         (last-mode mode) (rows nil))
    (while (<= mode last-mode)
      (setq whtr-special 13 whtr-events nil)
      (when (boundp 'whtr-unbound) (makunbound 'whtr-unbound))
      (let ((shared (if (fboundp 'thread-spawn)
                        (nelisp-thread-shared-alloc 264)
                      (make-vector 33 0)))
            (worker nil) (parent nil) (values nil) (index 0))
        (when (fboundp 'thread-spawn)
          (unless (= (nelisp-thread-gc-inhibit 1) 1) (error "dynamic begin")))
        (cond
         ((= mode 1)
          (let ((whtr-special 71))
            (let ((whtr-special 91))
              (setq worker (eval (list 'whtr-start shared mode) t))
              (whtr-wait shared 31)
              (let ((whtr-special 92))
                (setq parent (list whtr-special (default-value 'whtr-special))))
              (setq parent (append parent (list whtr-special (default-value 'whtr-special))))
              (setq parent (append parent
                            (list (let ((max-lisp-eval-depth 100))
                                    (condition-case data (whtr-recur 500) (error data))))))
              (whtr-publish shared 32)
              (whtr-join shared worker)
              (setq parent (append parent (list whtr-special))))
            (setq parent (append parent (list whtr-special)))))
         ((= mode 2)
          (let ((whtr-special 91))
            (setq worker (whtr-start shared mode))
            (whtr-wait shared 31)
            (setq parent (list whtr-special)))
          (setq parent (append parent (list whtr-special)))
          (let ((whtr-special 77))
            (whtr-publish shared 32)
            (whtr-join shared worker)
            (setq parent (append parent (list whtr-special)))))
         ((= mode 3)
          (let ((whtr-unbound 91))
            (setq worker (whtr-start shared mode))
            (whtr-wait shared 31)
            (setq parent (list whtr-unbound))
            (whtr-publish shared 32)
            (whtr-join shared worker)
            (setq parent (append parent (list whtr-unbound)))))
         ((= mode 4)
          (add-variable-watcher 'whtr-special #'whtr-watcher)
          (let* ((whtr-special 71) (whtr-special 91))
            (setq worker (whtr-start shared 2))
            (whtr-wait shared 31)
            (setq parent (list whtr-special)))
          (remove-variable-watcher 'whtr-special #'whtr-watcher)
          (setq parent (append parent whtr-events))
          (whtr-publish shared 32)
          (whtr-join shared worker))
         (t (setq parent (whtr-bytecode-parent shared))))
        (when (fboundp 'thread-spawn)
          (unless (= (nelisp-thread-gc-inhibit 0) 1) (error "dynamic end")))
        (setq parent (append parent (list (consp (car (garbage-collect))))))
        (while (< index (if (= mode 1) 8 (if (= mode 3) 4 3)))
          (setq values (append values (list (whtr-read shared index))))
          (setq index (1+ index)))
        (setq rows (append rows (list (list mode values parent
                                          (if (= mode 3) whtr-unbound whtr-special))))))
      (setq mode (1+ mode)))
    (princ (format "WH-THREAD-DYNAMIC %S\n" rows))
    (princ "WH-THREAD-DYNAMIC-DONE 1\n")
    (kill-emacs 0)))
