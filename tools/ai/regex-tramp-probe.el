;;; regex-tramp-probe.el --- paired N/0 complete-call probe -*- lexical-binding: nil; -*-
;; Run with regex-tramp.py. Preparation/warmup is identical in both runs;
;; the complete process includes collection after the measured calls.
(when (getenv "RT_MODULE")
  (load (getenv "RT_MODULE"))
  (nlre--compiled-cache-clear))
(load (getenv "RT_CORPUS"))
(let* ((row (nth (string-to-number (getenv "RT_INDEX")) rt-corpus))
       (pattern (nth 1 row))
       (subjects (nth 2 row))
       (count (string-to-number (getenv "RT_COUNT")))
       answers result)
  (dolist (text subjects)
    (let ((hit (string-match pattern text)))
      (setq answers (cons (list hit (and hit (match-data t))) answers))))
  (princ (format "RT-RESULT %S %S\n" (car row) (nreverse answers)))
  (garbage-collect)
  (let ((start (float-time)))
    (dotimes (_ count)
      (dolist (text subjects) (setq result (string-match pattern text))))
    (princ (format "RT-METRIC %d %.6f\n" (* count (length subjects))
                   (* 1000 (- (float-time) start)))))
  (garbage-collect)
  (princ "RT-DONE\n"))
