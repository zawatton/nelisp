;;; hashtab-layout.el --- Census of native hash storage -*- lexical-binding: t; -*-
(defvar hashtab-layout-table (make-hash-table :test 'eq :size 1024))
(dotimes (i 1024) (puthash i (* i 2) hashtab-layout-table))
(let* ((m (car hashtab-layout-table)) (n (hash-table-size hashtab-layout-table)))
  (unless (>= (length m) 15) (error "cons-entry hash storage"))
  (unless (and (= n 1024) (= (hash-table-count hashtab-layout-table) 1024)
               (= (length (aref m 11)) (* n 2))
               (= (length (aref m 12)) n) (= (length (aref m 14)) n)
               (vectorp (cdr hashtab-layout-table)))
    (error "native storage dimensions"))
  (dotimes (i n)
    (unless (and (integerp (aref (aref m 12) i))
                 (integerp (aref (aref m 14) i))
                 (= (aref (aref m 11) (* i 2)) i)
                 (= (aref (aref m 11) (1+ (* i 2))) (* i 2)))
      (error "entry cons or corrupt slot %d" i)))
  ;; The only cons in this structural census is the table handle itself.
  ;; Endpoint wrappers belong to the runtime's value representation.
  (princ "HASHTAB-LAYOUT entries=1024 storage-conses=1 vectors=4\n")
  (remhash 37 hashtab-layout-table)
  (unless (and (= (aref m 13) 37) (= (aref (aref m 12) 37) -1))
    (error "native free chain"))
  (puthash 2000 99 hashtab-layout-table)
  (unless (and (= (aref (aref m 11) 74) 2000) (= (aref (aref m 11) 75) 99))
    (error "free slot was not reused"))
  (puthash 2001 100 hashtab-layout-table)
  (unless (and (= (hash-table-size hashtab-layout-table) 2048)
               (= (gethash 2000 hashtab-layout-table) 99)
               (= (gethash 2001 hashtab-layout-table) 100))
    (error "native growth"))
  (garbage-collect)
  (unless (= (gethash 2001 hashtab-layout-table) 100) (error "storage lost after GC")))
(princ "HASHTAB-LAYOUT-COMPLETE\n")
(kill-emacs 0)
