;;; run.el --- fxlet dynamic-binding parity corpus: same output on GNU 31.1 and NeLisp -*- lexical-binding: t; -*-
(let ((d (file-name-directory (or load-file-name buffer-file-name))))
  (load (expand-file-name (if (equal (getenv "FL_FLAV") "bc") "bc.el" "src.el") d) nil t))
(define-error 'my-err "My error")
(defmacro fl-case (name form)
  `(princ (format "%s %S\n" ',name (condition-case err ,form (error (list 'ERROR err))))))
(defun fl-rep (f &rest args) (let ((r nil) (i 0)) (while (< i 40) (setq r (apply f args)) (setq i (1+ i))) r))
(fl-case let1 (list (fl-rep 'fx-let1 7) fx-a))
(fl-case let3 (list (fl-rep 'fx-let3 3) fx-a fx-b fx-c))
(fl-case letstar3 (list (fl-rep 'fx-letstar3 4) fx-a fx-b fx-c))
(fl-case nested (list (fl-rep 'fx-nested 6) fx-a fx-b))
(fl-case inner-let (list (fl-rep 'fx-inner-let 5) fx-a))
(fl-case let-in-loop (fl-rep 'fx-let-in-loop 5))
(fl-case let-signal (list (fl-rep 'fx-let-signal) fx-a))
(fl-case let-signal-inner (list (fl-rep 'fx-let-signal-inner) fx-a fx-b))
(fl-case let-throw (list (fl-rep 'fx-let-throw) fx-a))
(fl-case let-throw-inner (list (fl-rep 'fx-let-throw-inner) fx-a fx-b))
(fl-case catch-deep (list (fl-rep 'fx-catch-deep 30) fx-a fx-b))
(fl-case uwp-body (list (fl-rep 'fx-uwp-body) fx-a))
(fl-case uwp-throw (list (fl-rep 'fx-uwp-throw) fx-a))
(fl-case uwp-signal (list (fl-rep 'fx-uwp-signal) fx-a fx-b))
(fl-case uwp-let-in-cleanup (fl-rep 'fx-uwp-let-in-cleanup))
(fl-case uwp-cleanup-throws (list (fl-rep 'fx-uwp-cleanup-throws) fx-a))
(fl-case letstar-err (list (fl-rep 'fx-letstar-err) fx-a fx-b fx-c))
(fl-case many (list (fl-rep 'fx-many 0) fx-a fx-b fx-c))
(fl-case many-throw (list (fl-rep 'fx-many-throw 0) fx-a fx-b fx-c))
(fl-case recur (list (fl-rep 'fx-recur 200) fx-a))
(fl-case funcall-closure (list (fl-rep 'fx-funcall-closure 8) fx-a fx-b))
(fl-case setq-in-let (list (fl-rep 'fx-setq-in-let 3) fx-a fx-b))
(setq fx-b 'init)
(fl-case set-default-in-let (list (fl-rep 'fx-set-default-in-let 2) fx-a (default-value 'fx-a)))
(setq fx-a 10)
;; Known pre-existing divergence (v35 too), not in the corpus: default-toplevel-value / set-default-toplevel-value are void.
(fl-case defvar-in-let (list (fx-defvar-in-let) fx-dv))
(fl-case alias-in-let (list (fl-rep 'fx-alias-in-let) fx-al))
(fl-case makunbound (list (fl-rep 'fx-makunbound) fx-pl (boundp 'fx-pl)))
(fl-case let-void (list (fl-rep 'fx-let-void) (boundp 'fx-void)))
(fl-case let-const (fl-rep 'fx-let-const))
(fl-case let-const-direct (list (condition-case e (eval '(let ((t 1)) 1) t) (error (car e)))))
(with-temp-buffer
  (rename-buffer "fl-b1")
  (fl-case bl-let-default (list (fl-rep 'fx-bl-let 5) fx-bl (default-value 'fx-bl) (local-variable-p 'fx-bl)))
  (setq fx-bl 'local1)
  (fl-case bl-let-local (list (fl-rep 'fx-bl-let 6) fx-bl (default-value 'fx-bl) (local-variable-p 'fx-bl)))
  (fl-case mixed (list (fl-rep 'fx-mixed 3) fx-a fx-bl fx-b))
  (fl-case mixed-err (list (fl-rep 'fx-mixed-err 4) fx-a fx-bl fx-b))
  (let ((other (generate-new-buffer "fl-b2")))
    (fl-case bl-let-other (list (fl-rep 'fx-bl-let-other 11 other) fx-bl (with-current-buffer other (list fx-bl (local-variable-p 'fx-bl)))))
    (with-current-buffer other (setq fx-bl 'local2))
    (fl-case bl-let-other-local (list (fl-rep 'fx-bl-let-other 12 other) fx-bl (with-current-buffer other fx-bl)))
    (fl-case bl-let-switch
      (let ((me (current-buffer)) (r nil))
        (dotimes (_ 40) (set-buffer me) (setq r (fx-bl-let-switch 13 other)))
        (list r (current-buffer) fx-bl (with-current-buffer me fx-bl) (default-value 'fx-bl))))
    (set-buffer (get-buffer "fl-b1"))
    (kill-buffer other)))
(fl-case watcher
  (let ((log nil))
    (add-variable-watcher 'fx-w (lambda (s n o w) (push (list s n o (and w t)) log)))
    (fx-let-watched 1) (fx-let-watched 2)
    (prog1 (list (nreverse log) fx-w)
      (dolist (w (get-variable-watchers 'fx-w)) (remove-variable-watcher 'fx-w w)))))
(fl-case watcher-off (list (fl-rep 'fx-let-watched 5) fx-w (get-variable-watchers 'fx-w)))
(kill-emacs 0)
