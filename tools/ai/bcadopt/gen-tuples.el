;;; -*- lexical-binding: t -*-
;; Stage A (stock GNU Emacs, nothing from NeLisp loaded): sample call tuples per
;; candidate and record the GNU result when GNU defines the same name.
(require 'cl-lib)
(defconst bc-pool
  '(nil t 0 1 2 -1 5 97 2.5 "abc" "" "Hello World" "a,b;c" " pad " 'foo 'bar :key
    '(1 2 3) '(a b c d) '(3 1 2) '((a . 1) (b . 2)) '(1 . 2) [1 2 3] 'car '1+ "12" 'nil "x" '(nil) ?\s))
(defvar bc-seed 1)
(defun bc-rand (n) (setq bc-seed (% (+ (* bc-seed 1103515245) 12345) 2147483648)) (% (/ bc-seed 65536) n))
(defun bc-arity (args)
  (let ((req 0) (opt 0) (rest nil) (mode 'req))
    (dolist (a args)
      (cond ((eq a '&optional) (setq mode 'opt)) ((eq a '&rest) (setq mode 'rest))
            ((eq mode 'req) (cl-incf req)) ((eq mode 'opt) (cl-incf opt)) (t (setq rest t))))
    (list req opt rest)))
(defun bc-wrap (call)
  `(with-temp-buffer (insert "Hello world\nline two\n") (goto-char 3)
     (condition-case e ,call (error (list :err (car e))))))
(defun bc-eval (form)
  (let ((r (condition-case e (eval form nil) (error (list :driver-err (car e))))))
    (let ((print-escape-newlines t)) (format "%S" r))))
(defun bc-gen (name args want gnu)
  (let* ((ar (bc-arity args)) (seen (make-hash-table :test 'equal)) (out nil) (nerr 0) (nok 0)
         (tries 0) (limit (if gnu 700 60)))
    (setq bc-seed (apply #'+ (append (symbol-name name) nil)))
    (while (and (< tries limit) (< (+ nerr nok) want))
      (cl-incf tries)
      (let* ((n (+ (car ar) (bc-rand (+ 1 (cadr ar) (if (nth 2 ar) 2 0)))))
             (vals (cl-loop repeat n collect (nth (bc-rand (length bc-pool)) bc-pool)))
             (call (cons name (mapcar (lambda (v) (if (and (consp v) (eq (car v) 'quote)) v (if (or (consp v)) (list 'quote v) v))) vals)))
             (form (bc-wrap call)) (key (let ((print-escape-newlines t) (print-length nil) (print-level nil)) (prin1-to-string form))))
        (unless (gethash key seen)
          (puthash key t seen)
          (if (not gnu)
              (push (list key "-") out)
            (let* ((r1 (bc-eval form)) (r2 (bc-eval form)))
              (when (and (equal r1 r2) (< (length r1) 300) (not (string-match-p "#<\\|NaN\\|driver-err\\|wrong-number-of-arguments" r1)))
                (let ((errp (string-match-p "^(:err" r1)))
                  (cond ((and errp (< nerr 2) (not (gethash (concat "E" r1) seen)))
                         (puthash (concat "E" r1) t seen) (cl-incf nerr) (push (list key r1) out))
                        ((and (not errp) (< nok (- want 2)) (not (gethash (concat "R" r1) seen)))
                         (puthash (concat "R" r1) t seen) (cl-incf nok) (push (list key r1) out))))))))))
    (nreverse out)))
(let ((lines nil) (inhibit-message t))
  (with-temp-buffer
    (insert-file-contents (getenv "BCCANDS"))
    (goto-char (point-min))
    (while (not (eobp))
      (let* ((f (split-string (buffer-substring (line-beginning-position) (line-end-position)) "\t"))
             (name (intern (nth 0 f))) (args (car (read-from-string (nth 1 f))))
             (gnu (and (fboundp name) (not (string-prefix-p "nelisp" (nth 0 f)))
                       (not (special-form-p name)) (not (macrop name))))
             (rows (bc-gen name args 8 gnu)))
        (dolist (r rows)
          (push (format "%s\t%s\t%s\t%s\n" name (if gnu "gnu" "int") (car r) (cadr r)) lines)))
      (forward-line 1)))
  (with-temp-file (getenv "BCOUT") (dolist (l (nreverse lines)) (insert l))))
