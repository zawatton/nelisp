;;; crash1/sort.el --- sort corpus, run on NeLisp and GNU  -*- lexical-binding: t -*-
;; One line per case.  Large cases print a checksum over the whole result so
;; that order, stability and element identity are all observable.  The sizes
;; reach 560000 = 4 x the old crash threshold of 131072 elements.
(defmacro crash1--case (id form)
  `(message "%s %S" ,id (condition-case e ,form (error (list 'ERR (car e) (cdr e))))))
(defun crash1--lcg (n range)
  "N pseudo-random integers in [0,RANGE) from a fixed LCG (same on both sides)."
  (let ((x 12345) (acc nil))
    (dotimes (_ n)
      (setq x (% (+ (* x 1103515245) 12345) 2147483648))
      (push (% (/ x 16) range) acc))
    acc))
(defun crash1--fold (seq)
  "Order-sensitive checksum of SEQ whose elements are integers or (KEY . INDEX)."
  (let ((h 7) (n 0))
    (mapc (lambda (e) (setq h (% (+ (* h 31) (if (consp e) (+ (* 1000 (car e)) (cdr e)) e)) 1000003) n (1+ n))) seq)
    (list n h)))
(defun crash1--pairs (n range)
  (let ((i -1)) (mapcar (lambda (k) (setq i (1+ i)) (cons k i)) (crash1--lcg n range))))
(defun crash1--sorted-p (seq pred)
  (let ((prev nil) (ok t) (first t))
    (mapc (lambda (e) (when (and (not first) (funcall pred e prev)) (setq ok nil)) (setq prev e first nil)) seq)
    ok))
(defun crash1--car< (a b) (< (car a) (car b)))
;; ---- small semantic cases
(crash1--case "s1" (sort (list 3 1 2) #'<))
(crash1--case "s2" (sort (vector 3 1 2) #'>))
(crash1--case "s3" (sort (list 3 1 2)))
(crash1--case "s4" (sort (list "b" "a" "c") #'string<))
(crash1--case "s5" (let ((l (list 3 1 2))) (list (eq l (sort l #'<)) (sort (copy-sequence '(3 1 2)) :lessp #'<))))
(crash1--case "s6" (let ((l (list 3 1 2))) (list (eq l (sort l :lessp #'< :in-place t)) l)))
(crash1--case "s7" (let ((l (list 3 1 2))) (list (eq l (sort l :lessp #'<)) l)))
(crash1--case "s8" (let ((v (vector 3 1 2))) (list (eq v (sort v :lessp #'<)) v)))
(crash1--case "s9" (let ((v (vector 3 1 2))) (list (eq v (sort v :lessp #'< :in-place t)) v)))
(crash1--case "s10" (sort '((1 . a) (0 . b) (1 . c) (0 . d)) :key #'car))
(crash1--case "s11" (sort '((1 . a) (0 . b) (1 . c) (0 . d)) :key #'car :reverse t))
(crash1--case "s12" (sort [(1 . a) (0 . b) (1 . c) (0 . d)] :key #'car :reverse t))
(crash1--case "s13" (sort nil #'<))
(crash1--case "s14" (sort [] #'<))
(crash1--case "s15" (sort (list 1) (lambda (a b) (error "never"))))
(crash1--case "s16" (sort (list 2 1) (lambda (a b) (error "boom"))))
(crash1--case "s17" (sort (list 1 2 3) :key (lambda (x) (- x))))
(crash1--case "s18" (let ((c (list 1 2))) (setcdr (cdr c) c) (sort c #'<)))
(crash1--case "s19" (sort (cons 1 2) #'<))
(crash1--case "s20" (sort 5 #'<))
(crash1--case "s21" (sort (list 3 1 2) :lessp #'< :bogus 1))
;; ---- large cases around and beyond the old cliff (n = 131072)
(dolist (n '(100000 131071 131072 140000 200000 560000))
  (let ((l (crash1--lcg n 1000000)))
    (crash1--case (format "L-%d-<" n) (let ((r (sort (copy-sequence l) #'<))) (list (crash1--sorted-p r #'<) (crash1--fold r))))
    (crash1--case (format "V-%d->" n) (let ((r (sort (vconcat l) #'>))) (list (crash1--sorted-p r #'>) (crash1--fold r))))))
(dolist (n '(131072 200000 560000))
  (let ((pairs (crash1--pairs n 50)))     ; heavy ties: stability matters
    (crash1--case (format "Lstable-%d" n) (crash1--fold (sort (copy-sequence pairs) :lessp #'crash1--car<)))
    (crash1--case (format "Vstable-%d" n) (crash1--fold (sort (vconcat pairs) :lessp #'crash1--car<)))
    (crash1--case (format "Lkey-%d" n) (crash1--fold (sort (copy-sequence pairs) :key #'car)))
    (crash1--case (format "Lkeyrev-%d" n) (crash1--fold (sort (copy-sequence pairs) :key #'car :reverse t)))
    (crash1--case (format "Vkeyrev-%d" n) (crash1--fold (sort (vconcat pairs) :key #'car :reverse t)))
    (crash1--case (format "Linplace-%d" n) (let* ((l (copy-sequence pairs)) (r (sort l :lessp #'crash1--car< :in-place t))) (list (eq l r) (crash1--fold l))))
    (crash1--case (format "Vinplace-%d" n) (let* ((v (vconcat pairs)) (r (sort v :lessp #'crash1--car< :in-place t))) (list (eq v r) (crash1--fold v))))
    (crash1--case (format "Lnotinplace-%d" n) (let* ((l (copy-sequence pairs)) (r (sort l :lessp #'crash1--car<))) (list (eq l r) (crash1--fold r))))))
