;;; crash1/small.el --- ordinary insert-file-contents behaviour, GNU vs NeLisp  -*- lexical-binding: t -*-
(let ((f (make-temp-file "crash1-small")))
  (dolist (s (list "" "a" "abc\n" (make-string 4095 ?x) (make-string 4096 ?x) (make-string 4097 ?y)
                   (concat (make-string 5000 ?z) "日本語\n") (make-string 70000 ?w)))
    (with-temp-file f (set-buffer-multibyte nil) (insert (encode-coding-string s 'utf-8)))
    (message "%d %S" (length s)
             (with-temp-buffer (list (cadr (insert-file-contents f)) (buffer-size) (secure-hash 'md5 (buffer-string)))))
    (message "%d lit %S" (length s)
             (with-temp-buffer (set-buffer-multibyte nil) (list (cadr (insert-file-contents-literally f)) (buffer-size))))
    (message "%d part %S" (length s)
             (with-temp-buffer (insert-file-contents f nil 1 3) (buffer-string))))
  (delete-file f)
  (message "%S" (condition-case e (with-temp-buffer (insert-file-contents f)) (file-missing (car e))))
  (message "%S" (condition-case e (with-temp-buffer (insert-file-contents "/")) (file-error (car e)))))
