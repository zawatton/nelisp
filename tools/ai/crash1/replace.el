;;; crash1/replace.el --- string-replace corpus, run on NeLisp and GNU  -*- lexical-binding: t -*-
;; Prints one line per case: the case id, then the printed result or the error.
(defmacro crash1--case (id form)
  `(message "%s %S" (quote ,id) (condition-case e ,form (error (list 'ERR (car e) (cdr e))))))
(crash1--case 1 (string-replace "b" "bb" "abcabc"))
(crash1--case 2 (string-replace "ab" "" "ababab"))
(crash1--case 3 (string-replace "x" "y" "abc"))
(crash1--case 4 (eq (string-replace "x" "y" "abc") nil))
(crash1--case 5 (string-replace "a" "b" ""))
(crash1--case 6 (string-replace "aa" "b" "aaaaa"))
(crash1--case 7 (string-replace "" "b" "abc"))
(crash1--case 8 (string-replace 'a "b" "abc"))
(crash1--case 9 (string-replace "a" "b" 'abc))
(crash1--case 10 (string-replace "a" 5 "abc"))
(crash1--case 11 (string-replace "é" "e" "éaé日本"))
(crash1--case 12 (string-replace "日" "月日" "日本日"))
(crash1--case 13 (let ((in "abcabc")) (eq in (string-replace "z" "y" in))))
(crash1--case 14 (string-replace "abc" "X" "abc"))
(crash1--case 15 (string-replace "a" (propertize "B" 'face 'bold) "aXa"))
(crash1--case 16 (string-replace "cc" "d" "ccccc"))
(crash1--case 17 (length (string-replace "b" "bb" (make-string 120000 ?a))))
(crash1--case 18 (length (string-replace "a" "bb" (make-string 120000 ?a))))
(crash1--case 19 (length (string-replace "a" "bb" (make-string 480000 ?a))))
(crash1--case 20 (let ((s (concat (make-string 130000 ?a) "b" (make-string 130000 ?a)))) (length (string-replace "b" "bbb" s))))
(crash1--case 21 (secure-hash 'md5 (string-replace "ab" "xyz" (apply #'concat (make-list 100000 "abc")))))
(crash1--case 22 (string-replace "needle" "N" (concat (make-string 400000 ?h) "needle" (make-string 3 ?t) "needle")))
(crash1--case 23 (string-to-multibyte (string-replace "a" "b" "aaa")))
(crash1--case 24 (multibyte-string-p (string-replace "a" "日" "aaa")))
(crash1--case 25 (multibyte-string-p (string-replace "a" "b" "aaa")))
