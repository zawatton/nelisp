(tc "eip-1" (list (equal-including-properties (propertize "ab" 'a 1) (propertize "ab" 'a 1)) (equal-including-properties (propertize "ab" 'a 1) (propertize "ab" 'a 2)) (equal-including-properties (propertize "ab" 'a 1) "ab") (equal-including-properties "ab" "ab")))
