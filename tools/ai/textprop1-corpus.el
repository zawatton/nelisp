;; ---- change walkers ----
(defun tc-s2 ()
  (let ((s (tc-str "abcdefghijklmnop")))
    (put-text-property 2 5 'a 1 s) (put-text-property 5 8 'a 2 s) (put-text-property 8 11 'b 1 s)
    (put-text-property 11 13 'a 1 s) (put-text-property 13 15 'a 1 s) s))
(tc "npc-0" (let ((s (tc-s2))) (list (next-property-change 0 s) (next-property-change 2 s) (next-property-change 5 s) (next-property-change 11 s) (next-property-change 13 s) (next-property-change 15 s) (next-property-change 16 s))))
(tc "npc-limit" (let ((s (tc-s2))) (list (next-property-change 0 s 1) (next-property-change 0 s 2) (next-property-change 0 s 3) (next-property-change 0 s 99) (next-property-change 13 s 99) (next-property-change 15 s 4))))
(tc "npc-t" (let ((s (tc-s2))) (list (next-property-change 0 s t) (next-property-change 2 s t) (next-property-change 11 s t) (next-property-change 13 s t) (next-property-change 15 s t))))
(tc "nspc" (let ((s (tc-s2))) (list (next-single-property-change 0 'a s) (next-single-property-change 2 'a s) (next-single-property-change 5 'a s) (next-single-property-change 8 'a s) (next-single-property-change 11 'a s) (next-single-property-change 13 'a s) (next-single-property-change 2 'b s) (next-single-property-change 8 'b s))))
(tc "nspc-limit" (let ((s (tc-s2))) (list (next-single-property-change 0 'a s 1) (next-single-property-change 0 'a s 2) (next-single-property-change 2 'a s 5) (next-single-property-change 2 'a s 4) (next-single-property-change 13 'a s 99) (next-single-property-change 13 'a s 14))))
(tc "nspc-t-limit" (let ((s (tc-s2))) (next-single-property-change 0 'a s t)))
(tc "ppc" (let ((s (tc-s2))) (list (previous-property-change 16 s) (previous-property-change 15 s) (previous-property-change 13 s) (previous-property-change 11 s) (previous-property-change 8 s) (previous-property-change 5 s) (previous-property-change 2 s) (previous-property-change 0 s))))
(tc "ppc-limit" (let ((s (tc-s2))) (list (previous-property-change 16 s 10) (previous-property-change 16 s 15) (previous-property-change 16 s 14) (previous-property-change 16 s 0) (previous-property-change 5 s 4) (previous-property-change 5 s 1))))
(tc "pspc" (let ((s (tc-s2))) (list (previous-single-property-change 16 'a s) (previous-single-property-change 15 'a s) (previous-single-property-change 13 'a s) (previous-single-property-change 11 'a s) (previous-single-property-change 8 'a s) (previous-single-property-change 5 'a s) (previous-single-property-change 2 'a s) (previous-single-property-change 0 'a s) (previous-single-property-change 11 'b s) (previous-single-property-change 8 'b s))))
(tc "pspc-limit" (let ((s (tc-s2))) (list (previous-single-property-change 16 'a s 14) (previous-single-property-change 16 'a s 12) (previous-single-property-change 16 'a s 0) (previous-single-property-change 8 'a s 6) (previous-single-property-change 8 'a s 1))))
(tc "npc-plain" (list (next-property-change 0 (tc-str)) (next-property-change 0 (tc-str) 4) (previous-property-change 10 (tc-str)) (previous-property-change 10 (tc-str) 3) (next-single-property-change 0 'a (tc-str)) (next-single-property-change 0 'a (tc-str) 7)))
(tc "npc-oob" (next-property-change 99 (tc-s2)))
(tc "npc-empty" (list (next-property-change 0 "") (next-property-change 0 "" 3) (next-single-property-change 0 'a "" 3)))
(tc "npc-badlimit" (next-property-change 0 (tc-s2) 'x))
(tc "nscpc" (let ((s (tc-s2))) (list (next-single-char-property-change 0 'a s) (next-single-char-property-change 2 'a s) (next-single-char-property-change 13 'a s) (next-single-char-property-change 13 'a s 14) (next-single-char-property-change 0 'zz s) (next-single-char-property-change 0 'zz s 5))))
(tc "pscpc" (let ((s (tc-s2))) (list (previous-single-char-property-change 16 'a s) (previous-single-char-property-change 13 'a s) (previous-single-char-property-change 5 'a s 3) (previous-single-char-property-change 5 'zz s))))
(tc "any" (let ((s (tc-s2))) (list (text-property-any 0 16 'a 1 s) (text-property-any 3 16 'a 2 s) (text-property-any 0 16 'a 9 s) (text-property-any 0 16 'b 1 s) (text-property-any 0 2 'a nil s) (text-property-any 0 16 'a nil s) (text-property-any 4 4 'a 1 s) (text-property-any 15 2 'a 1 s))))
