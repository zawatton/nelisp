;;; textprop1-corpus.el --- GNU parity corpus for text properties  -*- lexical-binding: t; -*-
;; Run the same file on GNU Emacs and on NeLisp and diff the two outputs:
;;   emacs -Q --batch -l tools/ai/textprop1-corpus.el > gnu.out
;;   nelisp --load tools/ai/textprop1-corpus.el -- > nl.out
;; Every case prints "NAME => RESULT" (RESULT is the %S rendering or ERR + the error).
(defun tc-run (name fn)
  (princ (format "%s => %s\n" name
                 (condition-case e (format "%S" (funcall fn))
                   (error (format "ERR %S" e))))))
(defmacro tc (name &rest body) `(tc-run ,name (lambda () ,@body)))
(defun tc-str (&optional s) (copy-sequence (or s "abcdefghij")))
(defmacro tc-buf (&rest body)
  `(with-temp-buffer (insert "abcdefghij") ,@body))

;; ---- put/add/set/remove on strings ----
(tc "put-1" (let ((s (tc-str))) (put-text-property 2 5 'face 'bold s) s))
(tc "put-ret" (let ((s (tc-str))) (put-text-property 2 5 'face 'bold s)))
(tc "put-2-adjacent-same" (let ((s (tc-str))) (put-text-property 0 2 'a 1 s) (put-text-property 2 4 'a 1 s) s))
(tc "put-nochange-inside" (let ((s (tc-str))) (put-text-property 0 8 'a 1 s) (put-text-property 2 4 'a 1 s) s))
(tc "put-split-3" (let ((s (tc-str))) (put-text-property 0 8 'a 1 s) (put-text-property 2 4 'a 2 s) s))
(tc "put-restore" (let ((s (tc-str))) (put-text-property 0 8 'a 1 s) (put-text-property 2 4 'a 2 s) (put-text-property 2 4 'a 1 s) s))
(tc "add-ret-changed" (let ((s (tc-str))) (list (add-text-properties 1 4 '(a 1 b 2) s) s)))
(tc "add-ret-unchanged" (let ((s (tc-str))) (add-text-properties 1 4 '(a 1) s) (list (add-text-properties 2 3 '(a 1) s) s)))
(tc "add-ret-partial" (let ((s (tc-str))) (add-text-properties 1 3 '(a 1) s) (list (add-text-properties 0 6 '(a 1) s) s)))
(tc "add-order" (let ((s (tc-str))) (add-text-properties 0 6 '(a 1 b 2 c 3) s) (add-text-properties 2 4 '(d 4 a 9) s) s))
(tc "add-empty-range" (let ((s (tc-str))) (list (add-text-properties 3 3 '(a 1) s) s)))
(tc "add-reversed-range" (let ((s (tc-str))) (add-text-properties 5 2 '(a 1) s) s))
(tc "add-oob" (let ((s (tc-str))) (add-text-properties 0 99 '(a 1) s)))
(tc "add-oob-empty" (let ((s (tc-str))) (add-text-properties 99 99 '(a 1) s)))
(tc "add-odd" (let ((s (tc-str))) (add-text-properties 0 3 '(a) s)))
(tc "add-nil-props" (let ((s (tc-str))) (list (add-text-properties 0 3 nil s) s)))
(tc "add-atom-props" (let ((s (tc-str))) (add-text-properties 0 3 'foo s) s))
(tc "add-nil-value" (let ((s (tc-str))) (add-text-properties 0 3 '(a nil) s) s))
(tc "set-1" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1) s) (list (set-text-properties 2 6 '(z 1) s) s)))
(tc "set-merge-interior" (let ((s (tc-str))) (put-text-property 0 3 'a 1 s) (put-text-property 3 6 'b 1 s) (put-text-property 6 9 'c 1 s) (set-text-properties 1 8 '(z 1) s) s))
(tc "set-nil-part" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1) s) (list (set-text-properties 2 4 nil s) s)))
(tc "set-nil-whole" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1) s) (list (set-text-properties 0 10 nil s) s)))
(tc "set-nil-whole-none" (let ((s (tc-str))) (set-text-properties 0 10 nil s)))
(tc "set-nil-part-none" (let ((s (tc-str))) (list (set-text-properties 2 4 nil s) s)))
(tc "set-props-copy" (let* ((s (tc-str)) (pl (list 'a 1))) (set-text-properties 0 3 pl s) (setcar (cdr pl) 5) s))
(tc "remove-1" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1 b 2) s) (list (remove-text-properties 2 4 '(a nil) s) s)))
(tc "remove-none" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1 b 2) s) (list (remove-text-properties 2 4 '(c nil) s) s)))
(tc "remove-all-keys" (let ((s (tc-str))) (add-text-properties 0 8 '(a 1 b 2) s) (list (remove-text-properties 0 10 '(a nil b nil) s) s)))
