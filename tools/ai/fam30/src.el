;;; -*- lexical-binding: t; -*-
;; fam30 parity corpus source: compiled by mkbc.el into bc.el (GNU byte code), also run interpreted.
(defun f30-sr-plain (n)
  (with-temp-buffer (dotimes (j 20) (insert "0123456789"))
    (let ((a 0)) (dotimes (i n) (save-restriction (narrow-to-region (+ 1 (% i 50)) (+ 60 (% i 50)))
                                  (setq a (+ a (- (point-max) (point-min)) (buffer-size)))))
         (list a (point-min) (point-max)))))
(defun f30-sr-nested ()
  (with-temp-buffer (insert "abcdefghijklmnopqrstuvwxyz")
    (narrow-to-region 5 20)
    (let (r)
      (save-restriction (widen) (push (list (point-min) (point-max)) r)
        (save-restriction (narrow-to-region 2 4) (push (list (point-min) (point-max)) r))
        (push (list (point-min) (point-max)) r))
      (push (list (point-min) (point-max)) r) (nreverse r))))
(defun f30-sr-throw ()
  (with-temp-buffer (insert "abcdefghij")
    (list (catch 'x (save-restriction (narrow-to-region 3 6) (throw 'x (list (point-min) (point-max)))))
          (point-min) (point-max))))
(defun f30-sr-error ()
  (with-temp-buffer (insert "abcdefghij")
    (list (condition-case e (save-restriction (narrow-to-region 3 6) (error "boom %d" 1)) (error (cadr e)))
          (point-min) (point-max))))
(defun f30-sr-edit ()
  (with-temp-buffer (insert "abcdefghij") (narrow-to-region 3 6)
    (save-restriction (widen) (goto-char 1) (insert "XX") (goto-char (point-max)) (insert "YY"))
    (list (point-min) (point-max) (buffer-string))))
(defun f30-sr-edit2 ()
  (with-temp-buffer (insert "abcdefghij")
    (save-restriction (narrow-to-region 3 6) (goto-char (point-min)) (insert "QQ") (goto-char (point-max)) (insert "RR"))
    (list (point-min) (point-max) (buffer-string))))
(defun f30-sr-switch ()
  (let ((b1 (generate-new-buffer " f30a")) (b2 (generate-new-buffer " f30b")) r)
    (with-current-buffer b1 (insert "0123456789"))
    (with-current-buffer b2 (insert "abcdefghij"))
    (set-buffer b1)
    (save-restriction (narrow-to-region 2 5) (set-buffer b2) (narrow-to-region 4 7))
    (push (list (eq (current-buffer) b2) (with-current-buffer b1 (list (point-min) (point-max)))
                (with-current-buffer b2 (list (point-min) (point-max)))) r)
    (kill-buffer b1) (kill-buffer b2) r))
(defun f30-sr-kill ()
  (let ((b (generate-new-buffer " f30k")))
    (with-current-buffer b (insert "abcdef"))
    (set-buffer b)
    (prog1 (list (save-restriction (narrow-to-region 2 4) (kill-buffer b) 'killed) (buffer-live-p b))
      (set-buffer (get-buffer-create "*scratch*")))))
(defun f30-sr-value ()
  (with-temp-buffer (insert "abc") (list (save-restriction 1 2 3) (save-restriction))))
(defun f30-sr-unnarrowed-widen ()
  (with-temp-buffer (insert "abcdefghij")
    (save-restriction (narrow-to-region 2 4))
    (list (point-min) (point-max))))
(defun f30-sr-loop-narrow (n)
  (with-temp-buffer (insert "abcdefghijklmnopqrstuvwxyz")
    (let ((s 0)) (dotimes (i n) (save-restriction (narrow-to-region 1 (+ 2 (% i 20))) (setq s (+ s (buffer-size) (- (point-max) (point-min))))))
         s)))
(defun f30-al-bc ()
  (let ((sal '(("a" . 1) ("bb" . 2) ("cc" . 3) (nil . 9) (4 . 40) (4.0 . 41) (sym . 5))))
    (list (alist-get "bb" sal nil nil #'equal) (alist-get "bb" sal) (alist-get "bb" sal 'd nil 'equal)
          (alist-get "zz" sal 'dflt nil #'equal) (alist-get 4 sal nil nil #'eql) (alist-get 4.0 sal nil nil #'eql)
          (alist-get 4 sal nil nil #'eq) (alist-get 'sym sal) (alist-get 'sym sal nil nil 'eq)
          (alist-get "cc" '(("a" . 1) ("cc" . 3)) nil nil #'string-equal)
          (alist-get "CC" '(("a" . 1) ("cc" . 3)) nil nil (lambda (a b) (string= (downcase a) (downcase b))))
          (alist-get nil sal) (alist-get 'x nil 'dd) (alist-get 4 sal nil t #'equal)
          (alist-get 'sym sal nil nil nil) (alist-get "bb" sal nil nil 'equal))))
(defun f30-al-err ()
  (list (condition-case e (alist-get 'a 5) (error (car e))) (condition-case e (alist-get 'a '(1 2)) (error (car e)))
        (condition-case e (alist-get "a" '(("a" . 1) . 7) nil nil #'equal) (error (car e)))
        (condition-case e (alist-get 'a '((a . 1)) nil nil 'no-such-fn) (error (car e)))
        (condition-case e (alist-get 'z '((a . 1)) nil nil 'equal) (error e))))
