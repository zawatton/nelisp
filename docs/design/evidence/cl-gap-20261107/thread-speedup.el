;;; -*- lexical-binding: t; -*-
(require 'nelisp-bt)
(defun p-spin (n) (let ((i 0) (s 0)) (while (< i n) (setq s (logand (+ s (* i 3)) 65535) i (1+ i))) s))
(defun p-cons (n) (let ((i 0) (l nil) (c 0)) (while (< i n) (setq l (cons i (if (= (% i 64) 0) nil l)) i (1+ i))) i))
(defun p-t (f total k)
  (let* ((t0 (float-time)) (ths (let (a) (dotimes (_ k) (push (nl-bt-make-thread (lambda () (funcall f (/ total k)))) a)) a)))
    (mapc #'nl-bt-join-thread ths) (- (float-time) t0)))
(defun p-row (name f total)
  (let* ((a (p-t f total 1)) (b (p-t f total 4)) (c (p-t f total 1)) (d (p-t f total 4)))
    (princ (format "%s total=%d 1T=%.3f/%.3f 4T=%.3f/%.3f speedup=%.2f/%.2f\n" name total a c b d (/ a b) (/ c d)))))
(p-row "spin" #'p-spin 400000)
(p-row "cons" #'p-cons 200000)
(let* ((lock (nl-bt-make-lock)) (c 0) (ts (let (a) (dotimes (_ 4) (push (nl-bt-make-thread (lambda () (dotimes (_ 5000) (nl-bt-with-lock-held lock (setq c (1+ c)))))) a)) a)))
  (mapc #'nl-bt-join-thread ts) (princ (format "locked counter=%d expected=20000\n" c)))
