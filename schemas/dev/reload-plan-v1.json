{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nelisp/dev/reload-plan-v1",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "session_id",
    "expected_generation",
    "target",
    "unit",
    "atomicity",
    "state",
    "expires_at",
    "limitations",
    "build_options_hash",
    "artifact_hash",
    "source_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "const": "native-linux-x86_64"
    },
    "unit": {
      "enum": ["allocator-gc", "native-unit"]
    },
    "atomicity": {
      "enum": ["runtime-unit", "native-unit"]
    },
    "state": {
      "const": "validated"
    },
    "expires_at": {
      "type": "number"
    },
    "source_files": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_set_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "binary_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "abi_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_options_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_id": {
      "type": ["string", "null"]
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name", "arity"],
        "properties": {
          "name": {
            "type": "string"
          },
          "arity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["unit"],
        "properties": {
          "unit": {
            "const": "allocator-gc"
          }
        }
      },
      "then": {
        "required": [
          "source_files",
          "source_set_hash",
          "binary_hash",
          "abi_hash"
        ],
        "not": {
          "anyOf": [
            {"required": ["unit_id"]},
            {"required": ["exports"]}
          ]
        },
        "properties": {
          "atomicity": {
            "const": "runtime-unit"
          }
        }
      }
    },
    {
      "if": {
        "required": ["unit"],
        "properties": {
          "unit": {
            "const": "native-unit"
          }
        }
      },
      "then": {
        "required": [
          "unit_id",
          "exports",
          "source_set_hash",
          "binary_hash"
        ],
        "properties": {
          "atomicity": {
            "const": "native-unit"
          }
        }
      }
    }
  ]
}
