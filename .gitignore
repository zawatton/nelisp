# Elisp byte-compiled / native
*.elc
*.eln

# Backups / autosaves
*~
\#*\#
.\#*
*.bak

# Emacs directory-local vars overrides
.dir-locals-2.el

# Build / test output
/build/
/dist/
/.cask/
/cask-*/
/target/
target/

# Coverage
/coverage/
*.lcov

# Checked-allocator collection data (Doc 168 Phase 6 gate; developer-local
# like .anvil-worklog -- appended by `make alloc-check-collect`)
/.alloc-check/

# macOS / editors
.DS_Store
.idea/
.vscode/

# Project-local scratch (opt-in commit)
/scratch/
/tmp/

# Secrets / env
.env
.env.local

# Local agent worktrees (Claude Code agent / per-task git worktrees).
# Developer-local workspaces; not part of the published tree.
/.claude/
/.worktrees/

# AI-specific drift-prevention rules — lives in personal memory, not the
# OSS-bound repo (= ad-hoc local file is fine, but never tracked).
/CLAUDE.md
dist/
/.nl-violations/

# Temp files the artifact commands drop in the working directory.  Several
# `nelisp-artifact--make-temp-path' call sites pass a constant name rather than
# a path, so `file-name-directory' is nil and the name expands against
# `default-directory': run `nelisp compile-elisp-artifacts' inside a checkout
# and the object, probe and helper temps land beside the sources.  They are
# deleted on the way out, so these lines are for the runs that do not get
# there -- one such file reached a commit that way in 3213b82c7 and sat in the
# tree until 2026-08-21.
.nelisp-host-helper.log.*
.nelisp-native-helper.*.*
.nelisp-native-helper-arg.txt.*
.nelisp-win-env.txt.*
.neln-obj.o.*
.neln-probe.o.*
