;;; gen-prims.el --- generate nl-typecheck-prims-data.el -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

;;; Commentary:

;; Host Emacs only.  Usage (from the repo root):
;;   emacs --batch -Q -L lisp -L src -L scripts -l packages/nl-typecheck/tools/gen-prims.el
;; Sources: GNU `comp-primitive-type-specifiers' (comp-common) and the
;; NeLisp standalone reader dispatch table plus the prelude's fixed
;; arity contract (scripts/nelisp-standalone-build.el).  Output is sorted
;; and deterministic.

;;; Code:

(require 'comp-common)
(require 'nelisp-standalone-build)

(let* ((out (expand-file-name "packages/nl-typecheck/src/nl-typecheck-prims-data.el"
                              nelisp-standalone--repo-root))
       (table (sort (copy-sequence comp-primitive-type-specifiers)
                    (lambda (a b) (string< (symbol-name (car a))
                                           (symbol-name (car b))))))
       (builtins
        (sort (delete-dups
               (delq nil (mapcar (lambda (e)
                                   (let ((k (car e)))
                                     (and (consp k) (stringp (cadr k)) (cadr k))))
                                 (nelisp-standalone--applyfn-reader-table))))
              #'string<))
       (fixed (sort (copy-sequence (nelisp-standalone--builtin-fixed-arities))
                    (lambda (a b) (string< (car a) (car b))))))
  (with-temp-file out
    (insert ";;; nl-typecheck-prims-data.el --- GENERATED primitive signatures -*- lexical-binding: t; -*-\n\n"
            ";; SPDX-License-Identifier: GPL-3.0-or-later\n\n"
            ";;; Commentary:\n\n"
            ";; GENERATED by packages/nl-typecheck/tools/gen-prims.el; do not edit.\n"
            ";; Table source: GNU comp-primitive-type-specifiers (comp-common.el).\n"
            ";; NeLisp builtin source: nelisp-standalone--applyfn-reader-table\n"
            ";; (native reader dispatch arms); fixed arities from the prelude.\n\n"
            ";;; Code:\n\n"
            "(defconst nl-typecheck-prims-table\n  '(")
    (let ((first t))
      (dolist (e table)
        (insert (if first "" "\n    ") (prin1-to-string e))
        (setq first nil)))
    (insert ")\n  \"List of (SYMBOL (function (ARGS...) RESULT).\")\n\n")
    (insert "(defconst nl-typecheck-prims-nelisp-builtins\n  '(")
    (let ((first t))
      (dolist (n builtins)
        (insert (if first "" "\n    ") (prin1-to-string n))
        (setq first nil)))
    (insert ")\n  \"Sorted names of NeLisp native reader builtins.\")\n\n")
    (insert "(defconst nl-typecheck-prims-nelisp-fixed-arities\n  '(")
    (let ((first t))
      (dolist (n fixed)
        (insert (if first "" "\n    ") (prin1-to-string n))
        (setq first nil)))
    (insert ")\n  \"Alist NAME -> fixed argument count from the NeLisp prelude.\")\n\n"
            "(provide 'nl-typecheck-prims-data)\n"
            ";;; nl-typecheck-prims-data.el ends here\n"))
  (message "gen-prims: %d specs, %d builtins, %d fixed arities -> %s"
           (length table) (length builtins) (length fixed) out))
