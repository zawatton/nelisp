;;; emacs-cc-charset-2.el --- GNU charset.c port: define-charset-internal -*- lexical-binding: t; -*-

;;; Code:

(defun emacs-cc-charset--define (args)
  "Port of Fdefine_charset_internal; ARGS is the list of 17 arguments."
  (unless (= (length args) 17)
    (signal 'wrong-number-of-arguments (list 'define-charset-internal (length args))))
  (let* ((name (nth 0 args)) (val nil) (i 0) (dimension 0) (nchars 1)
         (cs (make-vector 24 nil)) (sp (make-vector 16 0))
         (attrs (make-vector 10 nil)) id new-def)
    (unless (symbolp name) (signal 'wrong-type-argument (list 'symbolp name)))
    (aset attrs 1 name)
    (setq val (nth 2 args))
    (let ((loop t))
      (while loop
        (let* ((minb (emacs-cc-charset--check-int-range (aref val (* i 2)) 0 255))
               (maxb (emacs-cc-charset--check-int-range (aref val (1+ (* i 2))) minb 255)))
          (aset sp (* i 4) minb) (aset sp (+ (* i 4) 1) maxb)
          (aset sp (+ (* i 4) 2) (1+ (- maxb minb)))
          (when (> maxb 0) (setq dimension (1+ i)))
          (if (= i 3) (setq loop nil)
            (setq nchars (* nchars (aref sp (+ (* i 4) 2))))
            (aset sp (+ (* i 4) 3) nchars)
            (setq i (1+ i))))))
    (emacs-cc-charset--cs-set cs code-space sp)
    (setq val (nth 1 args))
    (emacs-cc-charset--cs-set cs dimension
                              (if val (emacs-cc-charset--check-int-range val 1 4) dimension))
    (setq dimension (emacs-cc-charset--cs cs dimension))
    (emacs-cc-charset--cs-set
     cs linear
     (or (= dimension 1)
         (and (= (aref sp 2) 256)
              (or (= dimension 2)
                  (and (= (aref sp 6) 256)
                       (or (= dimension 3) (= (aref sp 10) 256)))))))
    (unless (emacs-cc-charset--cs cs linear)
      (let ((mask (make-vector 256 0)) (k 0))
        (while (< k 4)
          (let ((j (aref sp (* k 4))))
            (while (<= j (aref sp (+ (* k 4) 1)))
              (aset mask j (logior (aref mask j) (ash 1 k)))
              (setq j (1+ j))))
          (setq k (1+ k)))
        (emacs-cc-charset--cs-set cs mask mask)))
    (emacs-cc-charset--cs-set cs chars-96 (if (= (aref sp 2) 96) 1 0))
    (emacs-cc-charset--cs-set cs min-code (logior (aref sp 0) (ash (aref sp 4) 8)
                                                  (ash (aref sp 8) 16) (ash (aref sp 12) 24)))
    (emacs-cc-charset--cs-set cs max-code (logior (aref sp 1) (ash (aref sp 5) 8)
                                                  (ash (aref sp 9) 16) (ash (aref sp 13) 24)))
    (emacs-cc-charset--cs-set cs index-offset 0)
    (setq val (nth 3 args))
    (when val
      (let ((code (emacs-cc-charset--cons-to-unsigned val)))
        (when (or (< code (emacs-cc-charset--cs cs min-code)) (> code (emacs-cc-charset--cs cs max-code)))
          (signal 'args-out-of-range (list (emacs-cc-charset--cs cs min-code) (emacs-cc-charset--cs cs max-code) val)))
        (emacs-cc-charset--cs-set cs index-offset (emacs-cc-charset--c2i cs code))
        (emacs-cc-charset--cs-set cs min-code code)))
    (setq val (nth 4 args))
    (when val
      (let ((code (emacs-cc-charset--cons-to-unsigned val)))
        (when (or (< code (emacs-cc-charset--cs cs min-code)) (> code (emacs-cc-charset--cs cs max-code)))
          (signal 'args-out-of-range (list (emacs-cc-charset--cs cs min-code) (emacs-cc-charset--cs cs max-code) val)))
        (emacs-cc-charset--cs-set cs max-code code)))
    (emacs-cc-charset--cs-set cs compact (< (emacs-cc-charset--cs cs max-code) #x10000))
    (setq val (nth 10 args))
    (if (null val)
        (if (> (emacs-cc-charset--cs cs min-code) 0)
            (emacs-cc-charset--cs-set cs invalid 0)
          (if (< (emacs-cc-charset--cs cs max-code) #xFFFFFFFF)
              (emacs-cc-charset--cs-set cs invalid (1+ (emacs-cc-charset--cs cs max-code)))
            (error "Attribute :invalid-code must be specified")))
      (emacs-cc-charset--cs-set cs invalid (emacs-cc-charset--cons-to-unsigned val)))
    (setq val (nth 5 args))
    (if (null val) (emacs-cc-charset--cs-set cs iso-final -1)
      (unless (integerp val) (signal 'wrong-type-argument (list 'fixnump val)))
      (when (or (< val ?0) (> val 127)) (error "Invalid iso-final-char: %d" val))
      (emacs-cc-charset--cs-set cs iso-final val))
    (setq val (nth 6 args))
    (emacs-cc-charset--cs-set cs iso-rev (if val (emacs-cc-charset--check-int-range val -1 63) -1))
    (setq val (nth 7 args))
    (if (null val) (emacs-cc-charset--cs-set cs mule-id -1)
      (emacs-cc-charset--check-fixnat val)
      (when (or (and (> val 0) (<= val 128)) (>= val 256))
        (error "Invalid emacs-mule-id: %d" val))
      (emacs-cc-charset--cs-set cs mule-id val))
    (emacs-cc-charset--cs-set cs ascii-compat (and (nth 8 args) t))
    (emacs-cc-charset--cs-set cs suppl (and (nth 9 args) t))
    (emacs-cc-charset--cs-set cs unified nil)
    (emacs-cc-charset--cs-set cs fast-map (make-vector 190 0))
    (emacs-cc-charset--cs-set cs min-char 0)
    (emacs-cc-charset--cs-set cs max-char 0)
    (emacs-cc-charset--cs-set cs ready t)
    (cond
     ((nth 11 args)
      (setq val (nth 11 args))
      (emacs-cc-charset--check-character val)
      (emacs-cc-charset--cs-set cs method 'offset)
      (emacs-cc-charset--cs-set cs offset val)
      (let ((idx (emacs-cc-charset--c2i cs (emacs-cc-charset--cs cs max-code))) (fm (emacs-cc-charset--cs cs fast-map)))
        (when (< (- emacs-cc-charset--max-char val) idx)
          (error "Unsupported max char: %d + %d > MAX_CHAR (%d)" idx (emacs-cc-charset--cs cs max-code) emacs-cc-charset--max-char))
        (emacs-cc-charset--cs-set cs max-char (+ idx val))
        (setq idx (emacs-cc-charset--c2i cs (emacs-cc-charset--cs cs min-code)))
        (emacs-cc-charset--cs-set cs min-char (+ idx val))
        (setq idx (ash (ash (emacs-cc-charset--cs cs min-char) -7) 7))
        (while (and (< idx #x10000) (<= idx (emacs-cc-charset--cs cs max-char)))
          (emacs-cc-charset--fm-set fm idx) (setq idx (+ idx 128)))
        (setq idx (ash (ash idx -12) 12))
        (while (<= idx (emacs-cc-charset--cs cs max-char))
          (emacs-cc-charset--fm-set fm idx) (setq idx (+ idx #x1000)))
        (when (and (= val 0) (>= (emacs-cc-charset--cs cs max-char) 128))
          (emacs-cc-charset--cs-set cs ascii-compat t))))
     ((nth 12 args)
      (aset attrs 3 (nth 12 args))
      (emacs-cc-charset--cs-set cs method 'map)
      (emacs-cc-charset--cs-set cs ready nil))
     ((nth 13 args)
      (setq val (nth 13 args))
      (let* ((parent (car val)) (pcs (emacs-cc-charset--check-cs parent))
             (pmin (nth 1 val)) (pmax (nth 2 val)) (poff (nth 3 val)))
        (emacs-cc-charset--check-fixnat pmin) (emacs-cc-charset--check-fixnat pmax)
        (unless (integerp poff) (signal 'wrong-type-argument (list 'fixnump poff)))
        (aset attrs 6 (vector (emacs-cc-charset--cs pcs id) pmin pmax poff))
        (emacs-cc-charset--cs-set cs method 'subset)
        (emacs-cc-charset--cs-set cs ready nil)))
     ((nth 14 args)
      (setq val (copy-sequence (nth 14 args)))
      (aset attrs 7 val)
      (emacs-cc-charset--cs-set cs method 'superset)
      (emacs-cc-charset--cs-set cs ready nil)
      (let ((tail val))
        (while tail
          (let* ((elt (car tail)) this-id offset)
            (if (consp elt)
                (setq this-id (emacs-cc-charset--check-id (car elt))
                      offset (emacs-cc-charset--check-int-range (cdr elt) -2147483648 2147483647))
              (setq this-id (emacs-cc-charset--check-id elt) offset 0))
            (setcar tail (cons this-id offset)))
          (setq tail (cdr tail)))))
     (t (error "None of :code-offset, :map, :parents are specified")))
    (setq val (nth 15 args))
    (when (and val (not (stringp val)))
      (unless (vectorp val) (signal 'wrong-type-argument (list 'vectorp val))))
    (aset attrs 8 val)
    (unless (listp (nth 16 args)) (signal 'wrong-type-argument (list 'listp (nth 16 args))))
    (aset attrs 2 (nth 16 args))
    (let ((old (gethash name emacs-cc-charset--hash)))
      (if old
          (setq new-def nil id (aref old 0))
        (when (= emacs-cc-charset--used (length emacs-cc-charset--table))
          (setq emacs-cc-charset--table
                (vconcat emacs-cc-charset--table (make-vector (length emacs-cc-charset--table) nil))))
        (setq id emacs-cc-charset--used
              emacs-cc-charset--used (1+ id) new-def t)))
    (puthash name attrs emacs-cc-charset--hash)
    (aset attrs 0 id)
    (emacs-cc-charset--cs-set cs id id)
    (emacs-cc-charset--cs-set cs attrs attrs)
    (aset emacs-cc-charset--table id cs)
    (when (eq (emacs-cc-charset--cs cs method) 'map)
      (emacs-cc-charset--ensure-ranges cs))
    (let ((final (emacs-cc-charset--cs cs iso-final)))
      (when (>= final 0)
        (aset emacs-cc-charset--iso
              (emacs-cc-charset--iso-index dimension (emacs-cc-charset--cs cs chars-96) final) id)
        (when new-def
          (setq emacs-cc-charset--iso-2022-list (nconc emacs-cc-charset--iso-2022-list (list id))))
        (cond ((= id (aref emacs-cc-charset--iso (emacs-cc-charset--iso-index 1 0 ?J)))
               (setq emacs-cc-charset--id-jisx0201-roman id))
              ((= id (aref emacs-cc-charset--iso (emacs-cc-charset--iso-index 2 0 ?@)))
               (setq emacs-cc-charset--id-jisx0208-1978 id))
              ((= id (aref emacs-cc-charset--iso (emacs-cc-charset--iso-index 2 0 ?B)))
               (setq emacs-cc-charset--id-jisx0208 id))
              ((= id (aref emacs-cc-charset--iso (emacs-cc-charset--iso-index 2 0 ?C)))
               (setq emacs-cc-charset--id-ksc5601 id)))))
    (let ((mid (emacs-cc-charset--cs cs mule-id)))
      (when (>= mid 0)
        (aset emacs-cc-charset--mule mid id)
        (when new-def
          (setq emacs-cc-charset--mule-list (nconc emacs-cc-charset--mule-list (list id))))))
    (when new-def
      (setq charset-list (cons name charset-list))
      (if (emacs-cc-charset--cs cs suppl)
          (setq emacs-cc-charset--ordered (nconc emacs-cc-charset--ordered (list id)))
        (let ((tail emacs-cc-charset--ordered))
          (while (and (consp tail)
                      (not (emacs-cc-charset--cs (aref emacs-cc-charset--table (car tail)) suppl)))
            (setq tail (cdr tail)))
          (cond
           ((eq tail emacs-cc-charset--ordered)
            (setq emacs-cc-charset--ordered (cons id emacs-cc-charset--ordered)))
           ((null tail)
            (setq emacs-cc-charset--ordered (nconc emacs-cc-charset--ordered (list id))))
           (t (let ((v (cons (car tail) (cdr tail))))
                (setcdr tail v)
                (setcar tail id))))))
      (setq emacs-cc-charset--tick (1+ emacs-cc-charset--tick)))
    nil))

(defun define-charset-internal (&rest args)
  "For internal use only."
  (emacs-cc-charset--define args))

(defun emacs-cc-charset--define-builtin (name dimension code-space min-code max-code
                                              iso-final iso-revision mule-id
                                              ascii-compat suppl offset)
  "Port of the C-level define_charset_internal helper."
  (let* ((cs (apply #'vector code-space))
         (final (if (< iso-final 0) nil iso-final))
         (mid (if (< mule-id 0) nil mule-id)))
    (emacs-cc-charset--define
     (list name dimension cs min-code max-code final iso-revision mid
           (and ascii-compat t) (and suppl t) nil offset nil nil nil nil
           (list :name name :dimension dimension :code-space cs
                 :iso-final-char final :emacs-mule-id mid
                 :ascii-compatible-p (and ascii-compat t) :code-offset offset)))
    (emacs-cc-charset--check-id name)))

;;; decode_char / encode_char and their macros.

(defun emacs-cc-charset--maybe-unify (c val)
  (cond ((integerp val) val)
        ((null val) c)
        (t (let ((cs (emacs-cc-charset--check-cs val)))
             (emacs-cc-charset--load cs 1)
             (if (not inhibit-load-charset-map)
                 (let ((v (emacs-cc-charset--unify-table-ref c))) (if v v c))
               (let ((u (gethash (- c (emacs-cc-charset--cs cs offset))
                                 (aref emacs-cc-charset--work 2))))
                 (if (and u (> u 0)) u c)))))))

(defun emacs-cc-charset--decode-fn (cs code)
  "decode_char: return a character or -1."
  (let ((method (emacs-cc-charset--cs cs method)) c)
    (if (or (< code (emacs-cc-charset--cs cs min-code)) (> code (emacs-cc-charset--cs cs max-code)))
        -1
      (cond
       ((eq method 'subset)
        (let* ((sub (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) subset))
               (pcs (emacs-cc-charset--from-id (aref sub 0)))
               (pcode (- code (aref sub 3))))
          (if (or (< pcode (aref sub 1)) (> pcode (aref sub 2))) -1
            (emacs-cc-charset--decode pcs pcode))))
       ((eq method 'superset)
        (let ((parents (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) superset)))
          (setq c -1)
          (while (and parents (< c 0))
            (setq c (emacs-cc-charset--decode
                     (emacs-cc-charset--from-id (car (car parents)))
                     (- code (cdr (car parents)))))
            (setq parents (cdr parents)))
          c))
       (t
        (let ((idx (emacs-cc-charset--c2i cs code)))
          (if (< idx 0) -1
            (if (eq method 'map)
                (let ((decoder (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) decoder)))
                  (unless (vectorp decoder)
                    (emacs-cc-charset--load cs 1)
                    (setq decoder (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) decoder)))
                  (if (vectorp decoder) (aref decoder idx)
                    (or (gethash idx (aref emacs-cc-charset--work 2)) -1)))
              (setq c (+ idx (emacs-cc-charset--cs cs offset)))
              (when (and (emacs-cc-charset--cs cs unified)
                         (< emacs-cc-charset--max-unicode c) (<= c emacs-cc-charset--max-5-byte))
                (setq c (emacs-cc-charset--maybe-unify c (emacs-cc-charset--unify-table-ref c))))
              c))))))))

(defun emacs-cc-charset--decode (cs code)
  "DECODE_CHAR macro."
  (cond
   ((and (< code 128) (emacs-cc-charset--cs cs ascii-compat)) code)
   ((or (< code (emacs-cc-charset--cs cs min-code)) (> code (emacs-cc-charset--cs cs max-code))) -1)
   ((emacs-cc-charset--cs cs unified) (emacs-cc-charset--decode-fn cs code))
   ((eq (emacs-cc-charset--cs cs method) 'offset)
    (if (emacs-cc-charset--cs cs linear)
        (+ (- code (emacs-cc-charset--cs cs min-code)) (emacs-cc-charset--cs cs offset))
      (emacs-cc-charset--decode-fn cs code)))
   (t (emacs-cc-charset--decode-fn cs code))))

(defun emacs-cc-charset--encode-fn (cs c)
  "encode_char: return a code point or the invalid code."
  (let ((method (emacs-cc-charset--cs cs method)))
    (when (emacs-cc-charset--cs cs unified)
      (let ((deun (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) deunifier)) (idx -1))
        (unless (char-table-p deun)
          (emacs-cc-charset--load cs 2)
          (setq deun (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) deunifier)))
        (if (char-table-p deun)
            (let ((d (aref deun c))) (when (integerp d) (setq idx d)))
          (setq idx (emacs-cc-charset--work-encoder c)))
        (when (>= idx 0) (setq c (+ (emacs-cc-charset--cs cs offset) idx)))))
    (cond
     ((eq method 'subset)
      (let* ((sub (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) subset))
             (pcs (emacs-cc-charset--from-id (aref sub 0)))
             (code (emacs-cc-charset--encode pcs c)))
        (if (or (= code (emacs-cc-charset--cs pcs invalid)) (< code (aref sub 1)) (> code (aref sub 2)))
            (emacs-cc-charset--cs cs invalid)
          (+ code (aref sub 3)))))
     ((eq method 'superset)
      (let ((parents (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) superset)) (r nil))
        (while (and parents (not r))
          (let* ((pcs (emacs-cc-charset--from-id (car (car parents))))
                 (cd (emacs-cc-charset--encode pcs c)))
            (when (/= cd (emacs-cc-charset--cs pcs invalid))
              (setq r (+ cd (cdr (car parents))))))
          (setq parents (cdr parents)))
        (or r (emacs-cc-charset--cs cs invalid))))
     (t
      (emacs-cc-charset--ensure-ranges cs)
      (if (or (not (emacs-cc-charset--fm-ref (emacs-cc-charset--cs cs fast-map) c))
              (< c (emacs-cc-charset--cs cs min-char)) (> c (emacs-cc-charset--cs cs max-char)))
          (emacs-cc-charset--cs cs invalid)
        (if (eq method 'map)
            (let ((encoder (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) encoder)))
              (unless (char-table-p encoder)
                (emacs-cc-charset--load cs 2)
                (setq encoder (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) encoder)))
              (if (char-table-p encoder)
                  (let ((val (aref encoder c)))
                    (if (null val) (emacs-cc-charset--cs cs invalid)
                      (if (emacs-cc-charset--cs cs compact) val
                        (emacs-cc-charset--i2c cs val))))
                (emacs-cc-charset--i2c cs (emacs-cc-charset--work-encoder-raw c))))
          (emacs-cc-charset--i2c cs (- c (emacs-cc-charset--cs cs offset)))))))))

(defun emacs-cc-charset--work-encoder-raw (c)
  (let ((w emacs-cc-charset--work))
    (if (= c (aref w 4)) 0 (or (gethash c (aref w 3)) 0))))

(defun emacs-cc-charset--work-encoder (c)
  (let ((w emacs-cc-charset--work))
    (cond ((= c (aref w 4)) 0) (t (or (gethash c (aref w 3)) -1)))))

(defun emacs-cc-charset--encode (cs c)
  "ENCODE_CHAR macro."
  (let ((method (emacs-cc-charset--cs cs method)))
    (cond
     ((and (< c 128) (emacs-cc-charset--cs cs ascii-compat)) c)
     ((or (emacs-cc-charset--cs cs unified) (eq method 'subset) (eq method 'superset))
      (emacs-cc-charset--encode-fn cs c))
     (t
      (emacs-cc-charset--ensure-ranges cs)
      (cond
       ((or (< c (emacs-cc-charset--cs cs min-char)) (> c (emacs-cc-charset--cs cs max-char)))
        (emacs-cc-charset--cs cs invalid))
       ((eq method 'offset)
        (if (emacs-cc-charset--cs cs linear)
            (+ (- c (emacs-cc-charset--cs cs offset)) (emacs-cc-charset--cs cs min-code))
          (emacs-cc-charset--encode-fn cs c)))
       ((eq method 'map)
        (let ((enc (emacs-cc-charset--at (emacs-cc-charset--cs cs attrs) encoder)))
          (if (and (emacs-cc-charset--cs cs compact) (char-table-p enc))
              (let ((v (aref enc c))) (if v v (emacs-cc-charset--cs cs invalid)))
            (emacs-cc-charset--encode-fn cs c))))
       (t (emacs-cc-charset--encode-fn cs c)))))))

(provide 'emacs-cc-charset-2)
