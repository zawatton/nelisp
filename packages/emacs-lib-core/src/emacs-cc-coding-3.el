;;; emacs-cc-coding-3.el --- Coding C-core replacements -*- lexical-binding: t; -*-

(defun emacs-cc-coding-3--unencodable-p (character coding-system)
  "Return non-nil if CHARACTER cannot round-trip through CODING-SYSTEM."
  (let ((name (if (symbolp coding-system) (symbol-name coding-system) "")))
    (cond
     ((or (equal name "ascii") (equal name "us-ascii")) (> character 127))
     ((or (equal name "latin-1") (equal name "iso-latin-1")) (> character 255))
     ((or (equal name "utf-8") (equal name "utf-8-unix")
          (equal name "utf-8-dos") (equal name "utf-8-mac")
          (equal name "no-conversion")) nil)
     (t
      (let* ((text (char-to-string character))
             (encoded (encode-coding-string text coding-system t))
             (decoded (decode-coding-string encoded coding-system t)))
        (not (equal text decoded)))))))

(unless (fboundp 'unencodable-char-position)
  (defun unencodable-char-position (start end coding-system &optional count string)
    "Return position of first un-encodable character in a region.
START and END specify the region and CODING-SYSTEM specifies the
encoding to check.  Return nil if CODING-SYSTEM does encode the region.

If optional 4th argument COUNT is non-nil, it specifies at most how
many un-encodable characters to search.  In this case, the value is a
list of positions.

If optional 5th argument STRING is non-nil, it is a string to search
for un-encodable characters.  In that case, START and END are indexes
to the string and treated as in `substring'."
    (unless (or (null string) (stringp string))
      (signal 'wrong-type-argument (list 'stringp string)))
    (when (and string
               (null start) (setq start 0)) nil)
    (when (and string
               (null end) (setq end (length string))) nil)
    (when (and (not string) (null start) (setq start (point-min))) nil)
    (when (and (not string) (null end) (setq end (point-max))) nil)
    (when (and string
               (or (not (integerp start)) (not (integerp end))
                   (< start 0) (< end start) (> end (length string))))
      (signal 'args-out-of-range (list string start end)))
    (when (and (not string)
               (or (not (integerp start)) (not (integerp end))
                   (< start (point-min)) (> end (point-max)) (> start end)))
      (signal 'args-out-of-range (list (current-buffer) start end)))
    (unless (or (memq coding-system '(ascii us-ascii latin-1 iso-latin-1
                                           utf-8 utf-8-unix utf-8-dos
                                           utf-8-mac no-conversion))
                (and (fboundp 'coding-system-p)
                     (coding-system-p coding-system)))
      (signal 'coding-system-error (list coding-system)))
    (let ((index start) (found nil) (remaining count))
      (while (and (< index end) (not (and count (<= remaining 0))))
        (let ((character (if string (aref string index)
                           (char-after index))))
          (when (and character
                     (emacs-cc-coding-3--unencodable-p character coding-system))
            (if count
                (setq found (cons index found)
                      remaining (1- remaining))
              (setq found index
                    index end))))
        (setq index (1+ index)))
      (if count (nreverse found) found))))

;;;; --- Japanese coding systems ----------------------------------------
;; GNU defines shift_jis, cp932, euc-jp and iso-2022-jp in japanese.el on top
;; of coding.c and the JIS charsets.  The runtime has no coding.c, so the
;; string conversion functions delegate to the repository's table-driven
;; codecs in nelisp-coding.el (JIS X 0208/0212 and CP932 tables generated by
;; tools/coding-table-gen.el).  iso-2022-jp is the 7-bit form of the EUC-JP
;; JIS X 0208 plane and is built on that codec.

(defconst emacs-cc-coding-3--japanese-aliases
  '((shift_jis . sjis) (japanese-shift-jis . sjis) (sjis . sjis)
    (cp932 . cp932) (japanese-cp932 . cp932)
    (euc-jp . euc) (japanese-iso-8bit . euc) (euc-japan . euc)
    (euc-japan-1990 . euc)
    (iso-2022-jp . jis7) (junet . jis7))
  "Japanese coding system names (GNU 31.1 aliases) and their codec family.")

(defvar emacs-cc-coding-3--spec-cache (make-hash-table :test 'eq)
  "Results of `emacs-cc-coding-3--japanese-spec' by coding-system symbol.")
(defvar emacs-cc-coding-3--spec-cache-aliases nil
  "The `emacs-cc-coding-3--japanese-aliases' value the cache was filled from.")

(defun emacs-cc-coding-3--japanese-spec (coding)
  "Return (FAMILY . EOL) when CODING names a Japanese coding system, else nil.
EOL is `unix', `dos', `mac' or nil when the name has no EOL suffix."
  ;; gnu562: answered from a per-symbol cache (the parse is a string-match,
  ;; about 8 us on every encode/decode); the parse runs inside
  ;; `save-match-data', since GNU's coding functions leave the match data
  ;; alone.  The cache follows `emacs-cc-coding-3--japanese-aliases'.
  (when (and coding (symbolp coding))
    (unless (eq emacs-cc-coding-3--spec-cache-aliases
                emacs-cc-coding-3--japanese-aliases)
      (clrhash emacs-cc-coding-3--spec-cache)
      (setq emacs-cc-coding-3--spec-cache-aliases
            emacs-cc-coding-3--japanese-aliases))
    (let ((hit (gethash coding emacs-cc-coding-3--spec-cache 'miss)))
      (if (not (eq hit 'miss))
          hit
        (puthash
         coding
         (save-match-data
           (let* ((name (symbol-name coding)) (eol nil))
             (when (string-match "-\\(unix\\|dos\\|mac\\)\\'" name)
               (setq eol (intern (match-string 1 name))
                     name (substring name 0 (match-beginning 0))))
             (let ((family (cdr (assq (intern name)
                                      emacs-cc-coding-3--japanese-aliases))))
               (and family (cons family eol)))))
         emacs-cc-coding-3--spec-cache)))))

(defun emacs-cc-coding-3--bytes (string)
  "Return the byte list of STRING for decoding."
  (append (if (multibyte-string-p string)
              (encode-coding-string string 'utf-8)
            string)
          nil))

(defun emacs-cc-coding-3--unibyte (bytes)
  "Return a unibyte string made of the list BYTES."
  (apply #'unibyte-string bytes))

(defun emacs-cc-coding-3--eol-decode (text eol)
  "Convert end-of-line sequences of TEXT according to EOL when decoding."
  (cond
   ((eq eol 'dos) (replace-regexp-in-string "\r\n" "\n" text t t))
   ((eq eol 'mac) (replace-regexp-in-string "\r" "\n" text t t))
   ((and (null eol) (string-match-p "\r\n" text)
         (not (string-match-p "[^\r]\n\\|\\`\n" text)))
    (replace-regexp-in-string "\r\n" "\n" text t t))
   (t text)))

(defun emacs-cc-coding-3--eol-encode (text eol)
  "Convert LF in TEXT according to EOL when encoding."
  (cond ((eq eol 'dos) (replace-regexp-in-string "\n" "\r\n" text t t))
        ((eq eol 'mac) (replace-regexp-in-string "\n" "\r" text t t))
        (t text)))

(defconst emacs-cc-coding-3--sjis-extension-leads '(#x87 #xED #xEE #xFA #xFB #xFC)
  "Shift-JIS lead bytes that exist only in the CP932 extension rows.")

(defun emacs-cc-coding-3--sjis-char (char family)
  "Return the bytes of CHAR in the Shift-JIS FAMILY (`sjis' or `cp932'), or nil."
  (let ((bytes (plist-get (nelisp-coding-shift-jis-encode (string char) 'replace)
                          :bytes))
        (invalid (plist-get (nelisp-coding-shift-jis-encode (string char) 'replace)
                            :invalid-positions)))
    (and bytes (null invalid)
         (not (and (eq family 'sjis) (cdr bytes)
                   (memq (car bytes) emacs-cc-coding-3--sjis-extension-leads)))
         bytes)))

(defun emacs-cc-coding-3--euc-char (char)
  "Return the EUC-JP bytes of CHAR, or nil when it is unencodable."
  (let ((r (nelisp-coding-euc-jp-encode (string char) 'replace)))
    (and (null (plist-get r :invalid-positions)) (plist-get r :bytes))))

(defun emacs-cc-coding-3--jis7-encode (text)
  "Encode TEXT as ISO-2022-JP; return a byte list."
  (let ((out nil) (mode 'ascii))
    (dolist (char (string-to-list text))
      (let ((bytes (and (>= char 128) (emacs-cc-coding-3--euc-char char))))
        (cond
         ((< char 128)
          (unless (eq mode 'ascii) (setq out (append (reverse '(27 40 66)) out) mode 'ascii))
          (push char out))
         ((and bytes (= (length bytes) 2) (>= (car bytes) #xA1) (>= (cadr bytes) #xA1))
          (unless (eq mode 'jis) (setq out (append (reverse '(27 36 66)) out) mode 'jis))
          (push (logand (car bytes) #x7F) out)
          (push (logand (cadr bytes) #x7F) out))
         (t
          (unless (eq mode 'ascii) (setq out (append (reverse '(27 40 66)) out) mode 'ascii))
          (push 32 out)))))
    (unless (eq mode 'ascii) (setq out (append (reverse '(27 40 66)) out)))
    (nreverse out)))

(defun emacs-cc-coding-3--jis7-decode (bytes)
  "Decode the ISO-2022-JP byte list BYTES to a string."
  (let ((mode 'ascii) (chunks nil) (ascii nil) (euc nil))
    (let ((flush-ascii (lambda ()
                         (when ascii
                           (push (apply #'string (nreverse ascii)) chunks)
                           (setq ascii nil))))
          (flush-euc (lambda ()
                       (when euc
                         (push (plist-get (nelisp-coding-euc-jp-decode (nreverse euc))
                                          :string)
                               chunks)
                         (setq euc nil)))))
      (while bytes
        (let ((b (pop bytes)))
          (cond
           ((and (= b 27) (equal (list (car bytes) (cadr bytes)) '(40 66)))
            (funcall flush-euc) (setq mode 'ascii bytes (cddr bytes)))
           ((and (= b 27) (equal (list (car bytes) (cadr bytes)) '(40 74)))
            (funcall flush-euc) (setq mode 'ascii bytes (cddr bytes)))
           ((and (= b 27) (equal (list (car bytes) (cadr bytes)) '(36 66)))
            (funcall flush-ascii) (setq mode 'jis bytes (cddr bytes)))
           ((and (= b 27) (equal (list (car bytes) (cadr bytes)) '(36 64)))
            (funcall flush-ascii) (setq mode 'jis bytes (cddr bytes)))
           ((and (eq mode 'jis) (<= #x21 b #x7E) bytes (<= #x21 (car bytes) #x7E))
            (push (logior b #x80) euc)
            (push (logior (pop bytes) #x80) euc))
           ((or (< b 128) (null (eq mode 'jis)))
            (funcall flush-euc) (push (if (< b 128) b #xFFFD) ascii))
           (t (funcall flush-euc) (push b ascii)))))
      (funcall flush-euc) (funcall flush-ascii))
    (apply #'concat (nreverse chunks))))

(defun emacs-cc-coding-3--japanese-decode (string spec)
  "Decode STRING with the Japanese coding SPEC (FAMILY . EOL)."
  (require 'nelisp-coding)
  (let* ((bytes (emacs-cc-coding-3--bytes string))
         (family (car spec))
         (text (cond
                ((eq family 'jis7) (emacs-cc-coding-3--jis7-decode bytes))
                ((eq family 'euc)
                 (plist-get (nelisp-coding-euc-jp-decode bytes) :string))
                (t (plist-get (nelisp-coding-shift-jis-decode bytes) :string)))))
    (emacs-cc-coding-3--eol-decode text (cdr spec))))

(defun emacs-cc-coding-3--japanese-encode (string spec)
  "Encode STRING with the Japanese coding SPEC (FAMILY . EOL)."
  (require 'nelisp-coding)
  (let* ((family (car spec))
         (text (emacs-cc-coding-3--eol-encode string (cdr spec)))
         (bytes nil))
    (if (eq family 'jis7)
        (setq bytes (emacs-cc-coding-3--jis7-encode text))
      (dolist (char (string-to-list text))
        (let ((b (cond ((< char 128) (list char))
                       ((eq family 'euc) (emacs-cc-coding-3--euc-char char))
                       (t (emacs-cc-coding-3--sjis-char char family)))))
          (setq bytes (append (reverse (or b (list 32))) bytes))))
      (setq bytes (nreverse bytes)))
    (emacs-cc-coding-3--unibyte bytes)))

(defun emacs-cc-coding-3--advice-decode (original string coding &rest rest)
  "Around advice for `decode-coding-string' handling Japanese systems."
  (let ((spec (and (stringp string) (emacs-cc-coding-3--japanese-spec coding))))
    (if spec
        (emacs-cc-coding-3--japanese-decode string spec)
      (apply original string coding rest))))

(defun emacs-cc-coding-3--advice-encode (original string coding &rest rest)
  "Around advice for `encode-coding-string' handling Japanese systems."
  (let ((spec (and (stringp string) (emacs-cc-coding-3--japanese-spec coding))))
    (if spec
        (emacs-cc-coding-3--japanese-encode string spec)
      (apply original string coding rest))))

;; gnu562: installed as named wrappers over the previous definitions, not as
;; :around advice; advice dispatch cost about 10 us per call on top of the
;; inner (latin-1) advice (encode-coding-string 10 -> 31 us with it).
(when (and (fboundp 'nelisp--repr) (fboundp 'advice-add))
  (unless (fboundp 'emacs-cc-coding-3--decode-next)
    (defalias 'emacs-cc-coding-3--decode-next
      (symbol-function 'decode-coding-string))
    (defalias 'emacs-cc-coding-3--encode-next
      (symbol-function 'encode-coding-string)))
  (defun emacs-cc-coding-3--decode-coding-string (string coding &rest rest)
    "`decode-coding-string' with the Japanese systems of this file."
    (let ((spec (and (stringp string) (emacs-cc-coding-3--japanese-spec coding))))
      (if spec
          (emacs-cc-coding-3--japanese-decode string spec)
        (apply #'emacs-cc-coding-3--decode-next string coding rest))))
  (defun emacs-cc-coding-3--encode-coding-string (string coding &rest rest)
    "`encode-coding-string' with the Japanese systems of this file."
    (let ((spec (and (stringp string) (emacs-cc-coding-3--japanese-spec coding))))
      (if spec
          (emacs-cc-coding-3--japanese-encode string spec)
        (apply #'emacs-cc-coding-3--encode-next string coding rest))))
  (defalias 'decode-coding-string #'emacs-cc-coding-3--decode-coding-string)
  (defalias 'encode-coding-string #'emacs-cc-coding-3--encode-coding-string))

(provide 'emacs-cc-coding-3)
