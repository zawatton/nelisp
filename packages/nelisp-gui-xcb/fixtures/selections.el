;;; selections.el --- Selection APIs and ordinary kill/yank fixture -*- lexical-binding: t; -*-
;; Test commands use public shared APIs; X peers drive the real protocol.
(defvar nelisp-gui-selections--out nil)
(defvar nelisp-gui-selections--type 'CLIPBOARD)
(defun nelisp-gui-selections--path (name)
  (expand-file-name name nelisp-gui-selections--out))
(defun nelisp-gui-selections--write (name text)
  (with-temp-file (nelisp-gui-selections--path name) (insert text)))
(defun nelisp-gui-selections--payload ()
  (with-temp-buffer
    (insert-file-contents (nelisp-gui-selections--path "payload.txt"))
    (buffer-string)))
(defun nelisp-gui-selections-primary ()
  (interactive)
  (setq nelisp-gui-selections--type 'PRIMARY select-enable-primary t select-enable-clipboard nil)
  (princ "GUI-SELECTION-FIXTURE|type=PRIMARY|\n"))
(defun nelisp-gui-selections-clipboard ()
  (interactive)
  (setq nelisp-gui-selections--type 'CLIPBOARD select-enable-primary nil select-enable-clipboard t)
  (princ "GUI-SELECTION-FIXTURE|type=CLIPBOARD|\n"))
(defun nelisp-gui-selections-copy ()
  (interactive)
  ;; Existing command semantics stay in emacs-edit-builtins, including hooks.
  (kill-ring-save 1 (1+ (length "Selection 日本 café λ\n")))
  (princ "GUI-SELECTION-FIXTURE|copy=kill-ring-save|\n"))
(defun nelisp-gui-selections-publish ()
  (interactive)
  (setq nelisp-gui-selection-max-bytes 4194304)
  (gui-set-selection nelisp-gui-selections--type (nelisp-gui-selections--payload))
  (princ "GUI-SELECTION-FIXTURE|publish=1|\n"))
(defun nelisp-gui-selections-lower-owner-cap ()
  (interactive)
  (gui-set-selection nelisp-gui-selections--type (make-string 4194304 ?x))
  ;; A user can lower the transport cap after an existing value was accepted.
  ;; A real peer must then be refused before any INCR allocation.
  (setq nelisp-gui-selection-max-bytes 1048576)
  (princ "GUI-SELECTION-FIXTURE|lowered-owner-cap=1|\n"))
(defun nelisp-gui-selections-fetch ()
  (interactive)
  (let* ((started (float-time))
         (text (gui-get-selection nelisp-gui-selections--type 'UTF8_STRING))
         (seconds (- (float-time) started)))
    (setq header-line-format (if text "Selection converted"
                               "Selection unavailable: timeout/cap/type"))
    (nelisp-gui-selections--write "received.txt" (or text "UNAVAILABLE"))
    (princ (format "GUI-SELECTION-FIXTURE|fetch=%S|bytes=%d|transfer-seconds=%.6f|\n"
                   (and text t) (if text (string-bytes text) 0) seconds))))
(defun nelisp-gui-selections-yank ()
  (interactive)
  (erase-buffer)
  (yank)
  (nelisp-gui-selections--write "yanked.txt" (buffer-string))
  (princ "GUI-SELECTION-FIXTURE|yank=yank|\n"))
(defun nelisp-gui-selections-status ()
  (interactive)
  (nelisp-gui-selections--write "status.txt"
    (format "%S %S" (gui-selection-owner-p nelisp-gui-selections--type)
                     (gui-selection-exists-p nelisp-gui-selections--type)))
  (princ "GUI-SELECTION-FIXTURE|status=1|\n"))
(defun nelisp-gui-selections-clear ()
  (interactive)
  (gui-set-selection nelisp-gui-selections--type nil)
  (princ "GUI-SELECTION-FIXTURE|disown=1|\n"))
(defun nelisp-gui-selections-fixture ()
  (setq nelisp-gui-selections--out (getenv "NELISP_GUI_SELECTION_FIXTURE"))
  (let ((buffer (generate-new-buffer "*selections*")))
    (set-buffer buffer)
    (set-window-buffer (selected-window) buffer)
    (insert "Selection 日本 café λ\n")
    (goto-char 1)
    (setq mode-line-format " Selection transport / shared kill and yank "
          header-line-format nil))
  ;; The image carries an unused pure bootstrap scratch. Retire it through
  ;; the public buffer API so existing native yank routing selects this sole
  ;; editing substrate; mixed native/pure routing is owned by lane C1.
  (when (nelisp-ec-buffer-p (nelisp-ec-current-buffer))
    (nelisp-ec-kill-buffer (nelisp-ec-current-buffer)))
  (emacs-redisplay-defface 'default '(:foreground "#e8e8e8" :background "#182028"))
  (emacs-redisplay-defface 'header-line '(:foreground "#ff9090" :background "#522830"))
  (emacs-redisplay-defface 'mode-line '(:foreground "#ffffff" :background "#344454"))
  (setq emacs-redisplay-face-realize-default-foreground '(rgb 232 232 232)
        emacs-redisplay-face-realize-default-background '(rgb 24 32 40))
  (emacs-frame-set-frame-size (emacs-frame-selected-frame) 40 6)
  (emacs-window-layout-frame 40 6 0)
  ;; Public APIs install a local map; no changes to the shared keymap module.
  (let ((map (make-sparse-keymap)))
    (dolist (entry '((f1 . nelisp-gui-selections-primary) (f2 . nelisp-gui-selections-clipboard)
                     (f3 . nelisp-gui-selections-copy) (f4 . nelisp-gui-selections-publish)
                     (f5 . nelisp-gui-selections-fetch) (f6 . nelisp-gui-selections-yank)
                     (f7 . nelisp-gui-selections-status) (f8 . nelisp-gui-selections-clear)
                     (f9 . nelisp-gui-selections-lower-owner-cap)))
      (define-key map (vector (car entry)) (cdr entry)))
    (use-local-map map)))
(provide 'nelisp-gui-selections-fixture)
