;;; render.el --- Fixed S3.2 buffer/face fixture; uses shared library APIs -*- lexical-binding: t; -*-
(defconst nelisp-gui-render-text
  "NeLisp ASCII render\nJapanese 日本語 あいうえお\nWeight regular MMMM\nWeight bold    MMMM\nColor crimson cyan\n\nPoint: _cursor\n")

(defun nelisp-gui-render-fixture ()
  "Prepare editor data only. The normal production renderer paints it."
  (let* ((buffer (nelisp-ec-generate-new-buffer "*render*"))
         (mini-buffer (nelisp-ec-generate-new-buffer " *Minibuf-0*"))
         (root (emacs-window-selected-window))
         (mini (emacs-window-split-window root 1 'below))
         (frame (emacs-frame-selected-frame)))
    (nelisp-ec-set-buffer buffer)
    (setq buffer-read-only nil)
    (emacs-buffer-set-buffer-local-value 'buffer-read-only buffer nil)
    (nelisp-ec-insert nelisp-gui-render-text)
    (emacs-window-set-window-buffer root buffer)
    (emacs-buffer-set-buffer-local-value 'header-line-format buffer " Shared frame / Cairo + Pango ")
    (emacs-buffer-set-buffer-local-value 'mode-line-format buffer " NeLisp %b  Fundamental ")
    (emacs-buffer-set-buffer-local-value 'mode-line-format mini-buffer nil)
    (emacs-redisplay-defface 'default '(:foreground "#e8e8e8" :background "#182028"))
    (emacs-redisplay-defface 'bold '(:weight bold :foreground "#e8e8e8" :background "#182028"))
    (emacs-redisplay-defface 'render-color '(:foreground "#ff6060" :background "#102838"))
    (emacs-redisplay-defface 'mode-line '(:foreground "#ffffff" :background "#344454"))
    (emacs-redisplay-defface 'header-line '(:foreground "#80c0ff" :background "#263747"))
    (setq emacs-redisplay-face-realize-default-foreground '(rgb 232 232 232)
          emacs-redisplay-face-realize-default-background '(rgb 24 32 40))
    (let* ((bold-start (1+ (string-match "Weight bold" nelisp-gui-render-text)))
           (color-start (1+ (string-match "Color" nelisp-gui-render-text)))
           (point 2))
      (emacs-buffer-set-text-properties bold-start (+ bold-start 18) '(face bold) buffer)
      (emacs-buffer-set-text-properties color-start (+ color-start 18) '(face render-color) buffer)
      (nelisp-ec-goto-char point))
    (emacs-window-set-window-point root (nelisp-ec-point))
    (nelisp-ec-set-buffer mini-buffer)
    (setq buffer-read-only nil)
    (emacs-buffer-set-buffer-local-value 'buffer-read-only mini-buffer nil)
    (nelisp-ec-insert "Minibuffer ready")
    (emacs-window-set-window-buffer mini mini-buffer)
    (emacs-window-set-window-parameter mini 'minibuffer t)
    (nelisp-ec-set-buffer buffer)
    (emacs-window-select-window root)
    (emacs-frame-set-frame-size frame 80 24)))

(provide 'nelisp-gui-render-fixture)
