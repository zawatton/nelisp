;;; mouse-menu.el --- Shared command/keymap/window mouse corpus -*- lexical-binding: t; -*-
(defun nelisp-gui-mouse-menu-fixture ()
  (nelisp-gui-render-fixture)
  (nelisp-ec-erase-buffer)
  (nelisp-ec-insert "Click ABC 日本語\nDrag select text\n")
  (dotimes (i 20) (nelisp-ec-insert (format "Line %02d scroll fixture\n" i)))
  (nelisp-ec-goto-char 2)
  (emacs-buffer-set-buffer-local-value 'header-line-format (nelisp-ec-current-buffer) nil)
  (let ((local (emacs-keymap-make-sparse-keymap))
        (bar (emacs-keymap-make-sparse-keymap))
        (edit (emacs-keymap-make-sparse-keymap))
        (context (emacs-keymap-make-sparse-keymap))
        (frame (emacs-frame-selected-frame)))
    (emacs-keymap-define-key edit [right] '(menu-item "Move right" forward-char))
    (emacs-keymap-define-key edit [left] '(menu-item "Move left" backward-char))
    (emacs-keymap-define-key bar [edit] (cons "Edit" edit))
    (emacs-keymap-define-key local [menu-bar] bar)
    (emacs-keymap-define-key context [right] '(menu-item "Move right" forward-char))
    (emacs-keymap-define-key local [context-menu] context)
    (emacs-keymap-use-local-map local)
    (setf (emacs-frame-menu-bar-lines frame) 1)
    (emacs-frame-set-frame-size frame 80 10)
    (emacs-window-layout-frame 80 9 1)))
(provide 'nelisp-gui-mouse-menu-fixture)
