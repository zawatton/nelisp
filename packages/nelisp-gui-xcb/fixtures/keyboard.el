;;; keyboard.el --- Shared-loop transport probe independent of vendor loading -*- lexical-binding: t; -*-
(defun nelisp-gui-keyboard-fixture ()
  (nelisp-gui-render-fixture)
  (nelisp-ec-erase-buffer)
  (nelisp-ec-insert "Keyboard transport\n")
  (nelisp-ec-goto-char 1)
  (emacs-buffer-set-buffer-local-value 'header-line-format (nelisp-ec-current-buffer) nil)
  (emacs-buffer-set-buffer-local-value 'mode-line-format (nelisp-ec-current-buffer) nil)
  (emacs-frame-set-frame-size (emacs-frame-selected-frame) 40 6)
  (emacs-window-layout-frame 40 6 0)
  (let ((map (emacs-keymap-make-sparse-keymap)))
    (dolist (key (list [f6] [S-left]
                    (vector (event-convert-list '(control ?a)))
                    (vector (event-convert-list '(meta ?a)))
                    (vector (event-convert-list '(super ?a)))
                    (vector (event-convert-list '(control shift ?a)))
                    [64] [91]))
      (emacs-keymap-define-key map key 'nelisp-gui-fixture-capture-event))
    (emacs-keymap-use-local-map map)))
(provide 'nelisp-gui-keyboard-fixture)
