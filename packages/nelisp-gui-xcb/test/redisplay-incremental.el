(require 'nelisp-gui-frontend)

(ert-deftest g4-adapters/nested-insertion-retains-outer-event ()
  (let ((nelisp-gui-frontend--self-insert-event ?z) seen)
    (cl-letf (((symbol-function 'nelisp-gui-frontend--pure-buffer-p) (lambda () t))
              ((symbol-function 'nelisp-gui-frontend--point) (lambda () 1))
              ((symbol-function 'emacs-edit-self-insert-direct)
               (lambda (event)
                 (when (= event ?a) (nelisp-gui-frontend--run-self-insert ?b nil))
                 (push event seen))))
      (nelisp-gui-frontend--run-self-insert ?a nil)
      (should (equal seen '(97 98)))
      (should (= nelisp-gui-frontend--self-insert-event ?z)))))

(defun gui-incremental--reference-row-hash (row-vec)
  "Return a stable hash for ROW-VEC (vector of glyphs).
The hash mixes char + the *realized* face alist (Phase 3.B.1) so a
text-property face change that resolves to a different SGR triggers
diff redraw even if the raw spec stayed identical (= e.g. registry
mutation under the same face name)."
  (let ((h 0)
        (i 0)
        (len (length row-vec)))
    (while (< i len)
      (let* ((g (aref row-vec i))
             (c (if g (emacs-redisplay-glyph-char g) 0))
             (f (if g (or (emacs-redisplay-glyph-realized-face g)
                          (emacs-redisplay-glyph-face g))
                  nil)))
        ;; Mix char + sxhash of face into a 32-bit mask.
        (setq h (logand #xFFFFFFFF
                        (+ (* h 31)
                           (logxor c (sxhash-equal f))))))
      (setq i (1+ i)))
    h))


(ert-deftest gui-incremental/empty-padding-keeps-the-original-row-hash ()
  (let ((emacs-redisplay--nil-padding-cache nil))
    (dolist (width '(1 12 80 132))
      (dotimes (used (1+ width))
        (let ((vec (make-vector width nil)))
          (dotimes (i used)
            (aset vec i (emacs-redisplay--make-glyph
                         :char (+ 32 (% i 90)) :width 1
                         :face (and (= (% i 3) 0) 'mode-line)
                         :realized-face (and (= (% i 5) 0) '((:bold . t))))))
          (should (= (gui-incremental--reference-row-hash vec)
                     (emacs-redisplay--row-hash vec used))))))))

(ert-deftest gui-incremental/service-retains-real-timers-and-skips-empty-lists ()
  (let ((timer-list nil) (timer-idle-list nil)
        (nelisp-gui-frontend--paint-needed nil) calls)
    (cl-letf (((symbol-function 'emacs-process-dispatch-pending) (lambda () nil))
              ((symbol-function 'emacs-timer-run-pending)
               (lambda () (push 'regular calls) 1))
              ((symbol-function 'emacs-timer-idle-seconds) (lambda () 0))
              ((symbol-function 'emacs-timer-run-idle)
