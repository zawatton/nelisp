(ert-deftest gui-incremental/pango-scratch-owners-reuse-grow-and-close ()
  (let ((r (vector 0 0 0 0 nil 80 25 nil nil nil nil (make-vector 4 nil) nil nil))
        (next 100) allocated released text-addresses
        (bytes (make-hash-table :test 'equal)))
    (cl-letf (((symbol-function 'nl-ffi-memory-allocate)
               (lambda (size)
                 (setq next (+ next 100)) (push next allocated)
                 (vector 'nl-ffi-memory-owner next size size)))
              ((symbol-function 'nl-ffi-memory-address) (lambda (owner) (aref owner 1)))
              ((symbol-function 'nl-ffi-memory-release)
               (lambda (owner) (push (aref owner 1) released)))
              ((symbol-function 'ptr-write-u8)
               (lambda (p offset value) (puthash (cons p offset) value bytes)))
              ((symbol-function 'nl-ffi-libffi-u32)
               (lambda (_p offset) (if (= offset 0) 7 11)))
              ((symbol-function 'nelisp-gui-xcb-call)
               (lambda (name _signature &rest args)
                 (when (equal name "pango_layout_set_text")
                   (push (nth 1 args) text-addresses)) 0)))
      (nelisp-gui-pango--text 42 "a" r)
      (nelisp-gui-pango--text 42 "日本" r)
      (should (equal text-addresses '(200 200)))
      (should (= 0 (gethash '(200 . 6) bytes)))
      (nelisp-gui-pango--text 42 (make-string 300 ?x) r)
      (should (equal released '(200)))
      (should (= 300 (car text-addresses)))
      (should (= 0 (gethash '(300 . 300) bytes)))
      (should (equal (nelisp-gui-pango--size 42 r) '(7 . 11)))
      (should (equal (nelisp-gui-pango--size 42 r) '(7 . 11)))
      (should (= 3 (length allocated)))
      (nelisp-gui-pango-close r)
      (should (equal (sort released #'<) '(200 300 400)))
      (should-not (aref r 12)) (should-not (aref r 13)))))

(ert-deftest gui-incremental/os-wait-honors-outgoing-selection-deadline ()
  (let ((nelisp-gui-selection--sends nil))
    (cl-letf (((symbol-function 'emacs-process-wait-source-p) (lambda () nil))
              ((symbol-function 'emacs-timer-next-delay) (lambda (maximum) maximum)))
      (should (= (nelisp-gui-frontend--wait-ms) 1000.0))
      (let ((now (float-time)))
        (setq nelisp-gui-selection--sends
              (list (vector nil nil nil nil nil nil (+ now 2.0) (+ now 15.0))
                    (vector nil nil nil nil nil nil (+ now 0.5) (+ now 15.0)))))
      (let ((delay (nelisp-gui-frontend--wait-ms)))
        (should (<= delay 500.0))
        (should (> delay 400.0)))
      (should (= (nelisp-gui-selection-next-delay 0.05) 0.05))
      (aset (car nelisp-gui-selection--sends) 6 (- (float-time) 1.0))
      (should (= (nelisp-gui-frontend--wait-ms) 0.0)))))

(ert-deftest g4-scalar-cache/unsupported-signatures-remain-with-provider ()
  (dolist (signature '([:uint32 :pointer :pointer :pointer :pointer :pointer :pointer :pointer]
                       [:uint32 :pointer :pointer :pointer :pointer :double]
                       [:double :pointer] [:float :pointer] [:uint32 :float]
                       [(:struct :uint32) :pointer] [:uint32 :void]))
    (let ((nelisp-gui-xcb--calls (make-hash-table :test 'eq))
          (provider 0) (prepared 0) (direct 0)
          (args (make-list (1- (length signature)) 1)))
      (cl-letf (((symbol-function 'nl-ffi-libffi-scalar)
                 (lambda (&rest _) (setq provider (1+ provider)) 7))
                ((symbol-function 'nl-ffi-libffi-prepare)
                 (lambda (&rest _) (setq prepared (1+ prepared)) [0 42]))
                ((symbol-function 'ptr-call)
                 (lambda (&rest _) (setq direct (1+ direct)) 7))
                ((symbol-function 'ptr-call-typed)
                 (lambda (&rest _) (setq direct (1+ direct)) 7)))
        (should (= 7 (apply #'nelisp-gui-xcb-call "cache_test" signature args)))
        (should (= 7 (apply #'nelisp-gui-xcb-call "cache_test" signature args)))
        (should (= provider 2))
        (should (= prepared 0))
        (should (= direct 0))
        (should (= (hash-table-count nelisp-gui-xcb--calls) 0))))))

(ert-deftest g4-scalar-cache/supported-signature-caches-and-validates ()
  (let ((nelisp-gui-xcb--calls (make-hash-table :test 'eq))
        (provider 0) (prepared 0) (direct 0))
    (cl-letf (((symbol-function 'nl-ffi-libffi-scalar)
               (lambda (&rest _) (setq provider (1+ provider)) 7))
              ((symbol-function 'nl-ffi-libffi-prepare)
               (lambda (&rest _) (setq prepared (1+ prepared)) [0 42]))
              ((symbol-function 'ptr-call-typed)
               (lambda (address mask &rest args)
                 (should (= address 42)) (should (= mask 2))
                 (should (equal args '(1 2.0 3 4 5 6)))
                 (setq direct (1+ direct)) 7)))
      (dotimes (_ 2)
        (should (= 7 (nelisp-gui-xcb-call "cache_test"
                                        [:uint32 :pointer :double :uint8 :sint32 :uint64 :pointer]
                                        1 2 3 4 5 6))))
      (should (= provider 1)) (should (= prepared 1)) (should (= direct 1))
      (should-error (nelisp-gui-xcb-call "cache_test"
                                       [:uint32 :pointer :double :uint8 :sint32 :uint64 :pointer]
                                       1 2 3) :type 'nl-ffi-wrong-arity)
      (should-error (nelisp-gui-xcb-call "cache_test"
                                       [:uint32 :pointer :double :uint8 :sint32 :uint64 :pointer]
                                       "bad" 2 3 4 5 6) :type 'wrong-type-argument))))

