(ert-deftest gui-incremental/dynamic-mode-line-evaluates-once-per-pass ()
  (gui-incremental--world
   (let* ((b (generate-new-buffer " *incremental-eval*"))
          (w (emacs-window-selected-window)) (h (emacs-redisplay-init))
          (emacs-redisplay-paint-mode-line-p t) (calls 0))
     (unwind-protect
         (progn
           (with-current-buffer b
             (insert "first\n")
             (setq mode-line-format '((:eval (gui-incremental--eval-mode-line)))))
           (emacs-window-set-window-buffer w b)
           (cl-letf (((symbol-function 'gui-incremental--eval-mode-line)
                      (lambda () (setq calls (1+ calls))
                        (format "end=%d" emacs-redisplay--mode-line-end))))
             (emacs-redisplay-redisplay-window h w)
             (should (= calls 1))
             (with-current-buffer b (goto-char (point-max)) (insert "x"))
             (emacs-redisplay-redisplay-window h w)
             (should (= calls 2))
             ;; An unchanged buffer still evaluates arbitrary :eval forms.
             (emacs-redisplay-redisplay-window h w)
             (should (= calls 3))
             (let* ((m (emacs-redisplay-glyph-matrix h w))
                    (row (aref (emacs-redisplay-glyph-matrix-rows m)
                               (1- (emacs-redisplay-glyph-matrix-height m)))))
               (should (string-prefix-p "end=8" (emacs-redisplay-glyph-row-text row))))))
       (kill-buffer b)))))

