#!/usr/bin/env bash
# nelisp-m365-mcp --- launch the Microsoft 365 Personal MCP server on NeLisp.
#
# The standalone runtime cannot read its own argv or environment
# (`command-line-args', `getenv' and `process-environment' are all nil on
# the Linux build), and `load-path' is empty, so configuration cannot be
# passed in the usual ways.  This script resolves every path here and
# bakes them into a generated bootstrap file that the runtime loads.
#
# Configuration, in precedence order:
#   1. environment variables set for this script
#   2. the config file, default $XDG_CONFIG_HOME/nelisp-m365/config.sh
#
#   M365_CLIENT_ID     required; Entra application (client) id
#   M365_TOKEN_CACHE   token cache path
#   M365_SCOPES        space-separated delegated scopes
#   M365_TENANT        identity tenant segment, default "consumers"
#   M365_DOWNLOAD_DIR  where attachments and file downloads are written
#   M365_LOG_FILE      diagnostics path; unset discards them
#   NELISP             nelisp binary, default <repo>/target/nelisp

set -euo pipefail

BIN_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PKG_DIR=$(cd "$BIN_DIR/.." && pwd)
ROOT_DIR=$(cd "$PKG_DIR/../.." && pwd)

CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
CONFIG_FILE=${M365_CONFIG_FILE:-$CONFIG_HOME/nelisp-m365/config.sh}
if [ -f "$CONFIG_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
fi

STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
M365_CLIENT_ID=${M365_CLIENT_ID:-}
M365_TENANT=${M365_TENANT:-consumers}
M365_TOKEN_CACHE=${M365_TOKEN_CACHE:-$STATE_HOME/nelisp-m365/token.json}
M365_SCOPES=${M365_SCOPES:-"offline_access User.Read Mail.Read Calendars.Read Files.Read Contacts.Read Tasks.Read Notes.Read"}
M365_DOWNLOAD_DIR=${M365_DOWNLOAD_DIR:-$STATE_HOME/nelisp-m365/downloads}
M365_LOG_FILE=${M365_LOG_FILE:-}
NELISP=${NELISP:-$ROOT_DIR/target/nelisp}

if [ ! -x "$NELISP" ] && [ ! -f "$NELISP" ]; then
  echo "nelisp-m365-mcp: nelisp binary not found at $NELISP" >&2
  exit 1
fi

# Escape a value for embedding in an Emacs Lisp string literal.
elisp_string() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Turn a space-separated scope list into an Emacs Lisp list form.
elisp_scope_list() {
  local out="(list"
  local scope
  for scope in $1; do
    out="$out $(elisp_string "$scope")"
  done
  printf '%s)' "$out"
}

BOOT=$(mktemp "${TMPDIR:-/tmp}/nelisp-m365-boot-XXXXXX.el")
chmod 600 "$BOOT"
trap 'rm -f "$BOOT"' EXIT

{
  printf ';; Generated by nelisp-m365-mcp; do not edit.\n'
  # `require' silently succeeds for a missing feature on this runtime, so
  # every dependency is loaded by absolute path instead.
  printf '(load %s nil t)\n' "$(elisp_string "$ROOT_DIR/packages/nelisp-json/src/nelisp-json.el")"
  for module in compat curl auth graph tools mcp; do
    printf '(load %s nil t)\n' "$(elisp_string "$PKG_DIR/src/nelisp-m365-$module.el")"
  done
  printf '(setq nelisp-m365-client-id %s)\n' \
    "$([ -n "$M365_CLIENT_ID" ] && elisp_string "$M365_CLIENT_ID" || printf 'nil')"
  printf '(setq nelisp-m365-tenant %s)\n' "$(elisp_string "$M365_TENANT")"
  printf '(setq nelisp-m365-token-cache-file %s)\n' "$(elisp_string "$M365_TOKEN_CACHE")"
  printf '(setq nelisp-m365-scopes %s)\n' "$(elisp_scope_list "$M365_SCOPES")"
  printf '(setq nelisp-m365-download-dir %s)\n' \
    "$(elisp_string "$M365_DOWNLOAD_DIR")"
  printf '(setq nelisp-m365-mcp-log-file %s)\n' \
    "$([ -n "$M365_LOG_FILE" ] && elisp_string "$M365_LOG_FILE" || printf 'nil')"
  printf '(nelisp-m365-mcp-serve)\n'
} > "$BOOT"

"$NELISP" --load "$BOOT"
