;;; generate-emacs-minibuffer-gnu.el --- extract GNU completion-table forms  -*- lexical-binding: t; -*-

;; Run: emacs --batch -l scripts/generate-emacs-minibuffer-gnu.el
;; Copies the `completion-table-dynamic' family of GNU Emacs 31.1 minibuffer.el
;; verbatim from the pinned staged copy into
;; packages/emacs-lib-core/src/emacs-minibuffer-gnu.el.  GNU's elisp-mode.el
;; calls `completion-table-dynamic' while loading, and the standalone does not
;; load minibuffer.el itself.

(defconst gen-mb--names '(completion-table-dynamic completion-table-with-cache))

(let* ((root (file-name-directory
              (directory-file-name
               (file-name-directory (or load-file-name buffer-file-name)))))
       (src (expand-file-name "vendor/staged-emacs-lisp/minibuffer.el" root))
       (out (expand-file-name "packages/emacs-lib-core/src/emacs-minibuffer-gnu.el" root))
       forms)
  (with-temp-buffer
    (insert-file-contents src)
    (emacs-lisp-mode)
    (dolist (name gen-mb--names)
      (goto-char (point-min))
      (unless (re-search-forward
               (format "^(defun %s\\(?:[ \n]\\|$\\)" (regexp-quote (symbol-name name))) nil t)
        (error "missing %s" name))
      (goto-char (match-beginning 0))
      (let ((beg (point)))
        (forward-sexp 1)
        (push (cons name (buffer-substring beg (point))) forms))))
  (with-temp-file out
    (insert ";;; emacs-minibuffer-gnu.el --- GNU minibuffer.el completion tables  -*- lexical-binding: t; -*-\n\n"
            ";; GENERATED by scripts/generate-emacs-minibuffer-gnu.el from the pinned\n"
            ";; vendor/staged-emacs-lisp/minibuffer.el (GNU Emacs 31.1).  The forms below\n"
            ";; are copied verbatim; do not edit by hand.\n\n")
    (dolist (f (nreverse forms))
      (insert (format "(unless (fboundp '%s)\n%s)\n\n" (car f) (cdr f))))
    (insert "(provide 'emacs-minibuffer-gnu)\n\n;;; emacs-minibuffer-gnu.el ends here\n")))
