;;; generate-emacs-mule-gnu.el --- extract GNU mule.el file-coding forms  -*- lexical-binding: t; -*-

;; Run: emacs --batch -l scripts/generate-emacs-mule-gnu.el
;; Copies the named GNU Emacs 31.1 mule.el definitions verbatim from the
;; pinned vendor/staged-emacs-lisp/mule.el into
;; packages/emacs-lib-core/src/emacs-mule-gnu.el.  The standalone does not
;; load mule.el (GNU preloads it); these are the file-coding pieces
;; `insert-file-contents' handlers such as jka-compr reach.

;;; Code:

(defconst gen-mule--names
  '(coding-system-equal coding-system-type
    decode-coding-inserted-region
    auto-coding-alist auto-coding-regexp-alist auto-coding-regexp-alist-lookup
    auto-coding-file-name auto-coding-functions auto-coding-alist-lookup
    find-auto-coding set-auto-coding
    sgml-xml-auto-coding-function sgml-html-meta-auto-coding-function
    buffer-file-coding-system-explicit)
  "GNU mule.el names this file copies.")

(defconst gen-mule--tail-forms
  '("(setq set-auto-coding-function #'set-auto-coding)")
  "Verbatim top-level GNU mule.el forms appended after the definitions.")

(let* ((root (file-name-directory
              (directory-file-name
               (file-name-directory (or load-file-name buffer-file-name)))))
       (src (expand-file-name "vendor/staged-emacs-lisp/mule.el" root))
       (out (expand-file-name "packages/emacs-lib-core/src/emacs-mule-gnu.el" root))
       chunks)
  (with-temp-buffer
    (insert-file-contents src)
    (emacs-lisp-mode)
    (dolist (name gen-mule--names)
      (goto-char (point-min))
      (if (not (re-search-forward
                (format "^(\\(?:defvar-local\\|defvar\\|defcustom\\|defconst\\|defun\\) %s\\(?:[ \n]\\|$\\)"
                        (regexp-quote (symbol-name name)))
                nil t))
          (error "Missing GNU mule.el definition: %s" name)
        (goto-char (match-beginning 0))
        (let ((beg (point)))
          (forward-sexp 1)
          (push (cons beg (buffer-substring beg (point))) chunks)
          ;; Keep the `put' forms that follow the definition directly.
          (while (looking-at "\n+(put '[^ ]+ '[^ ]+ [^\n]*)")
            (let ((pb (progn (skip-chars-forward "\n") (point))))
              (forward-sexp 1)
              (push (cons pb (buffer-substring pb (point))) chunks))))))
    (dolist (form gen-mule--tail-forms)
      (goto-char (point-min))
      (unless (search-forward (concat "\n" form "\n") nil t)
        (error "Missing GNU mule.el form: %s" form))
      (push (cons (point) form) chunks)))
  (setq chunks (sort chunks (lambda (a b) (< (car a) (car b)))))
  (with-temp-file out
    (insert ";;; emacs-mule-gnu.el --- GNU mule.el file-coding definitions  -*- lexical-binding: t; -*-\n\n"
            ";; GENERATED by scripts/generate-emacs-mule-gnu.el from the pinned\n"
            ";; vendor/staged-emacs-lisp/mule.el (GNU Emacs 31.1).  The forms below\n"
            ";; are copied verbatim; do not edit by hand.\n\n")
    (dolist (c chunks) (insert (cdr c) "\n\n"))
    (insert "(provide 'emacs-mule-gnu)\n\n;;; emacs-mule-gnu.el ends here\n")))

;;; generate-emacs-mule-gnu.el ends here
