;;; nelisp-native-rooted-unit-metadata.el --- Read complete unit boundaries -*- lexical-binding: t; -*-
(require 'json)
(let* ((directory (getenv "NELISP_ROOT_UNIT_DIRECTORY"))
       (output (getenv "NELISP_ROOT_UNIT_METADATA_OUTPUT"))
       (selection (getenv "NELISP_ROOT_UNIT_SELECTION"))
       (files (if selection
                  (progn
                    (unless (<= (file-attribute-size (file-attributes selection)) 32768)
                      (error "Active unit selection bound"))
                    (mapcar (lambda (name)
                              (unless (equal name (file-name-nondirectory name))
                                (error "Active unit path rejected"))
                              (expand-file-name name directory))
                            (append (json-read-file selection) nil)))
                (directory-files directory t "\\.unit\\'")))
       (total 0) (records nil) (excluded nil))
  (unless (and output (<= (length files) 128)) (error "Unit count/output rejected"))
  (dolist (path files)
    (let ((size (file-attribute-size (file-attributes path))))
      (if (> size (* 16 1024 1024))
          (push (list :file (file-name-nondirectory path) :size size
                      :status "UNREAD_OVERSIZED_OWNER_REFUSED_IF_REACHABLE") excluded)
        (setq total (+ total size))
        (unless (and (<= 0 size) (<= total (* 32 1024 1024)))
          (error "Unit source input bound"))
        (let* ((unit (with-temp-buffer (insert-file-contents path) (read (current-buffer))))
           (symbols (plist-get unit :symbols)))
      (unless (<= (length symbols) 20000) (error "Unit symbol node bound"))
      (push (list :path (file-name-nondirectory path) :name (plist-get unit :name)
                  :unit-sha256 (with-temp-buffer
                                 (insert-file-contents-literally path)
                                 (secure-hash 'sha256 (current-buffer)))
                  :symbols (vconcat symbols) :relocations (vconcat (plist-get unit :relocs)))
            records)))))
  (with-temp-file output (insert (json-encode (vconcat (nreverse records)))) (insert "\n"))
  (with-temp-file (concat output ".excluded.json")
    (insert (json-encode (vconcat (nreverse excluded)))) (insert "\n")))
