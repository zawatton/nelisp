;;; generate-emacs-bindings-gnu.el --- extract GNU bindings.el key forms  -*- lexical-binding: t; -*-

;; Run: emacs --batch -l scripts/generate-emacs-bindings-gnu.el
;; Copies GNU Emacs 31.1 bindings.el's top-level forms verbatim from the
;; pinned vendor/staged-emacs-lisp/bindings.el into
;; packages/emacs-lib-core/src/emacs-bindings-gnu.el, except the mode-line
;; definitions: the standalone redisplay renders its own mode-line
;; constructs, and swapping those for GNU's is a separate change.

;;; Code:

(defconst gen-bind--excluded-name-regexp
  (concat "\\`\\(?:mode-line\\|minor-mode-alist\\|mode-name\\|"
          "propertized-buffer-identification\\|bindings--\\|"
          "global-mode-string\\|mode-line-\\)")
  "Definitions whose names match are left out (mode-line constructs).")

(defun gen-bind--form-name (form)
  "Return the symbol FORM defines or annotates, or nil."
  (let ((head (car-safe form)))
    (cond
     ((memq head '(defvar defcustom defvar-local defconst defun defmacro
                   defvar-keymap make-variable-buffer-local
                   make-obsolete-variable defalias
                   define-obsolete-function-alias put setq))
      (let ((name (nth 1 form)))
        (cond ((symbolp name) name)
              ((eq (car-safe name) 'quote) (cadr name)))))
     (t nil))))

(let* ((root (file-name-directory
              (directory-file-name
               (file-name-directory (or load-file-name buffer-file-name)))))
       (src (expand-file-name "vendor/staged-emacs-lisp/bindings.el" root))
       (out (expand-file-name "packages/emacs-lib-core/src/emacs-bindings-gnu.el" root))
       chunks)
  (with-temp-buffer
    (insert-file-contents src)
    (emacs-lisp-mode)
    (goto-char (point-min))
    (condition-case nil
        (while t
          (forward-comment (point-max))
          (let* ((beg (point))
                 (form (read (current-buffer)))
                 (name (gen-bind--form-name form)))
            (unless (or (and name (string-match-p gen-bind--excluded-name-regexp
                                                  (symbol-name name)))
                        ;; The `let' that builds the standard mode-line-format.
                        (and (eq (car-safe form) 'let)
                             (assq 'standard-mode-line-format (cadr form)))
                        (eq (car-safe form) 'garbage-collect))
              (push (buffer-substring beg (point)) chunks))))
      (end-of-file nil)))
  (with-temp-file out
    (insert ";;; emacs-bindings-gnu.el --- GNU bindings.el key bindings  -*- lexical-binding: t; -*-\n\n"
            ";; GENERATED by scripts/generate-emacs-bindings-gnu.el from the pinned\n"
            ";; vendor/staged-emacs-lisp/bindings.el (GNU Emacs 31.1).  The forms below\n"
            ";; are copied verbatim, without the mode-line definitions; do not edit by\n"
            ";; hand.\n\n")
    (dolist (c (nreverse chunks)) (insert c "\n\n"))
    (insert "(provide (quote emacs-bindings-gnu))\n\n;;; emacs-bindings-gnu.el ends here\n")))

;;; generate-emacs-bindings-gnu.el ends here
