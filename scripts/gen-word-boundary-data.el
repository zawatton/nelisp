;;; gen-word-boundary-data.el --- generate emacs-word-boundary-data.el  -*- lexical-binding: t; -*-

;; Run with GNU Emacs 31.1 (the specification), never with NeLisp:
;;   emacs-31.1 -Q --batch -l scripts/gen-word-boundary-data.el \
;;     > packages/emacs-lib-core/src/emacs-word-boundary-data.el
;; The output is derived from GNU's own `char-script-table' and category
;; tables (international/charscript.el and characters.el), restricted to what
;; `word_boundary_p' (syntax.c) consults: the script of a character and its
;; membership in the categories ^ (94), C, H and K, the only categories named
;; by the default `word-combining-categories' and `word-separating-categories'.

;;; Code:

(let ((starts nil) (codes nil) (scripts nil) (prev -1) (ch 0))
  (while (<= ch #x10ffff)
    (let* ((cs (char-category-set ch))
           (script (aref char-script-table ch))
           (sid (if script
                    (or (cdr (assq script scripts))
                        (let ((n (1+ (length scripts))))
                          (push (cons script n) scripts) n))
                  0))
           (code (logior (ash sid 4)
                         (if (aref cs ?^) 1 0) (if (aref cs ?C) 2 0)
                         (if (aref cs ?H) 4 0) (if (aref cs ?K) 8 0))))
      (unless (= code prev)
        (push ch starts) (push code codes) (setq prev code)))
    (setq ch (1+ ch)))
  (princ ";;; emacs-word-boundary-data.el --- GNU script/category data for word boundaries  -*- lexical-binding: t; -*-\n\n")
  (princ ";; GENERATED by scripts/gen-word-boundary-data.el from GNU Emacs ")
  (princ emacs-version)
  (princ ".  Do not edit by hand.\n")
  (princ ";; Each entry of the two parallel vectors is a run of characters starting at\n")
  (princ ";; the START and lasting until the next START.  CODE = script-id * 16 + bits\n")
  (princ ";; (1 category ^, 2 category C, 4 category H, 8 category K); script-id 0 is\n")
  (princ ";; `no script'.\n\n;;; Code:\n\n")
  (princ (format "(defconst emacs-word-boundary-data-starts\n  %s)\n\n"
                 (let ((print-length nil)) (prin1-to-string (vconcat (nreverse starts))))))
  (princ (format "(defconst emacs-word-boundary-data-codes\n  %s)\n\n"
                 (let ((print-length nil)) (prin1-to-string (vconcat (nreverse codes))))))
  (princ "(provide 'emacs-word-boundary-data)\n\n;;; emacs-word-boundary-data.el ends here\n"))
