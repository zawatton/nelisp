;;; generate-emacs-window-gnu.el --- extract GNU window-group forms  -*- lexical-binding: t; -*-

;; Run: emacs --batch -l scripts/generate-emacs-window-gnu.el
;; Copies the window-group family of GNU Emacs 31.1 window.el verbatim from
;; the pinned staged copy into packages/emacs-lib-core/src/emacs-window-gnu.el.
;; GNU's isearch.el calls `window-group-start' and friends on every search
;; step; the standalone does not load window.el itself.

(defconst gen-win--names
  '(window-group-start window-group-end set-window-group-start
    recenter-window-group pos-visible-in-window-group-p
    selected-window-group move-to-window-group-line))

(let* ((root (file-name-directory
              (directory-file-name
               (file-name-directory (or load-file-name buffer-file-name)))))
       (src (expand-file-name "vendor/staged-emacs-lisp/window.el" root))
       (out (expand-file-name "packages/emacs-lib-core/src/emacs-window-gnu.el" root))
       forms)
  (with-temp-buffer
    (insert-file-contents src)
    (emacs-lisp-mode)
    (dolist (name gen-win--names)
      (let ((var (intern (format "%s-function" name))))
        ;; The hook variable, its `permanent-local' property, and the defun
        ;; are adjacent top-level forms in window.el; copy all three.
        (goto-char (point-min))
        (unless (re-search-forward
                 (format "^(defvar-local %s nil)\n" (regexp-quote (symbol-name var)))
                 nil t)
          (error "missing %s" var))
        (let ((beg (match-beginning 0)))
          (goto-char (match-end 0))
          (forward-sexp 1)                ; (put ... 'permanent-local t)
          (forward-sexp 1)                ; (defun NAME ...)
          (push (cons name (buffer-substring beg (point))) forms)))))
  (with-temp-file out
    (insert ";;; emacs-window-gnu.el --- GNU window.el window-group functions  -*- lexical-binding: t; -*-\n\n"
            ";; GENERATED by scripts/generate-emacs-window-gnu.el from the pinned\n"
            ";; vendor/staged-emacs-lisp/window.el (GNU Emacs 31.1).  The forms below\n"
            ";; are copied verbatim; do not edit by hand.\n\n")
    (dolist (f (nreverse forms))
      (insert (format "(unless (fboundp '%s)\n%s)\n\n" (car f) (cdr f))))
    (insert "(provide 'emacs-window-gnu)\n\n;;; emacs-window-gnu.el ends here\n")))
