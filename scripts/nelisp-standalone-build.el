	       (defun nl_os_syscall_nr_fork () -1)
	       (defun nl_os_syscall_nr_wait4 () -1)
	       (defun nl_os_syscall_nr_kill () -1)
	       (defun nl_os_syscall_nr_pipe () -1)
	       (defun nl_os_syscall_nr_read () -1)
	       (defun nl_os_syscall_nr_write () -1)
