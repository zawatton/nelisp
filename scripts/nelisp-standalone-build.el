          (seq (mut-str-push-byte ms 91)
               (m5_json_vector ms vptr 0 (vector-len vptr) 1)
               (mut-str-push-byte ms 93)))
         (t (m5_json_null ms)))))
    (defun m5_prin1_string_byte (ms b)
