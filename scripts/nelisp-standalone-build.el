    (defun m5_prin1_plain_cons (ms vptr)
      (seq (mut-str-push-byte ms 40) (m5_prin1_list_tail ms vptr 1)))
    (defun m5_prin1_cons (ms vptr)
      (let* ((h (nl_cons_car_ptr vptr)))
        (if (= (bf_marker_vec_is h 7089075026832613736 25964 10) 1)
