    (defun m5_push_exp (ms e upcase)       ; "e±NN" / "E±NN"
      (seq (mut-str-push-byte ms (if (= upcase 1) 69 101))
           (if (< e 0) (mut-str-push-byte ms 45) (mut-str-push-byte ms 43))
           (let* ((ea (if (< e 0) (- 0 e) e)))
