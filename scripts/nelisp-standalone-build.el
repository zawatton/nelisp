   (list (cons 'bss (+ 57616 4194304 96 176 64 56 40 1040
                       (if (eq nelisp-standalone--target 'windows-x86_64) 8 0))))
   (append
    (list (nelisp-link-symbol "nl_arena_base" 0
                             :section 'bss :bind 'global :type 'object)
