                     (m5_prin1 ms (nl_cons_cdr_ptr pair))
                     (m5_prin1_ht_chain ms (nl_cons_cdr_ptr node) 0))
              (m5_prin1_ht_chain ms (nl_cons_cdr_ptr node) first)))
