                (ptr-write-u8 dst pos 32)
                (setq p (nl_win_quote_arg
                         dst p (nl_bi_strptr car_sx) (nl_bi_strlen car_sx)))
                (nl_win_cmdline_write_args dst p (nl_cons_cdr_ptr lst))))
