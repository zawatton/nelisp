                (if (> needed cursize) (nl_cold_grow_chunk0 needed) 0)
                (let* ((base (ptr-read-u64 (data-addr nl_arena_base) 0))
                       (ds (+ base 1024))
                       (ib (ptr-read-u64 (+ base 832) 0))
                       (tbl (+ ds slen)))
