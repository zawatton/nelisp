    (defun m5_fmt_hexfloat (ms fb conv prec buf scratch)
      (let* ((upc (if (= conv 65) 1 0))
             (magbits (logand fb (- (shl 1 63) 1)))
             (ef (logand (sar magbits 52) 2047))
             (frac (logand magbits (- (shl 1 52) 1))))
