             (if (= first 1) 0 (mut-str-push-byte ms 44))
             (m5_json_str_quoted ms key 1)
             (mut-str-push-byte ms 58)
             (m5_json ms val)
             (m5_json_object_plist ms (nl_cons_cdr_ptr rest) 0)))
        0))
    (defun m5_json_object_alist (ms node first)
      (if (= (ptr-read-u64 node 0) 7)
