    ;; (trip-count bad-cur bad-bt bad-want poison-count poison-enable
    ;;  context-depth mid-form-fired-count bind-legacy-force root-depth
    ;;  bucket-hits linear-hits bump-allocs reclaimed-chunks reclaimed-bytes
