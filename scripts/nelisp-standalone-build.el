             (m5_prin1 ms argl) (mut-str-push-byte ms 32)
             (m5_prin1 ms body) (mut-str-push-byte ms 32)
             (m5_prin1 ms env) (mut-str-push-byte ms 93) 1)))
    (defun m5_prin1_ht_chain (ms node first)
