        (seq
         (while (< i len)
           (seq
            (if (= (logand (ptr-read-u64 (+ data (* i 8)) 0) 1) 1) 0
              (let ((vw (nl_compact_rw_edge (+ data (* i 8)))))
                (if (= (nl_compact_rw_block vw) 0) 0
                  (nl_compact_rw_slot vw))))
            (setq i (+ i 1))))
         0)))
