        (if (symbolp type)
  	  ;; If TYPE is a symbol, the ELT must be (TYPE).
  	  (if (and (consp elt)
  		   (eq (car elt) type)
  		   (null (cdr elt)))
  	      (setq some-match t))
  	;; If TYPE is a list, ELT must match it or some initial segment of it.
