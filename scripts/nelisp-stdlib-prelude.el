       ((< xf 0) (/ 0.0 0.0))
       ((= xf 0.0) 0.0)
       (t (let ((k 0) (m xf))
            (while (>= m 4.0) (setq m (/ m 4.0)) (setq k (1+ k)))
            (while (< m 1.0) (setq m (* m 4.0)) (setq k (1- k)))
