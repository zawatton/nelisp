                  (setq scanning nil)
                (setq p (+ p direction))
                (when word (setq found t class next-class)))))
          (if found (setq remaining (1- remaining))
            (setq scanning nil)
            (nelisp-goto-char p b)
            (setq remaining (- remaining)))))
