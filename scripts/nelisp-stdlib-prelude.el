          (setq elt (if (eq (car elt) 'keymap)
                        (nelisp--copy-keymap-1 elt (1+ depth))
                      (cons (car elt)
                            (nelisp--copy-keymap-item (cdr elt) (1+ depth)))))))
        (setcdr tail (list elt))
        (setq tail (cdr tail)))
      (setq keymap (cdr keymap)))
    (setcdr tail keymap)
