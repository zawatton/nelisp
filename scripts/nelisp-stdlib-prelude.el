              (nelisp--signal-invalid "Invalid hash table size" v)))
           ((eq k :weakness)
            (unless (memq v '(nil key value key-or-value key-and-value t))
              (nelisp--signal-invalid "Invalid hash table weakness" v)))))
        (setq ks (cdr rest)))))
