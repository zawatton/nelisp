                                                        (expand-file-name name directory)
                                                      name)
                                                    out)))
                              (setq out (cons (if full
                                                  (expand-file-name name directory)
                                                name)
                                              out))))
                          (setq names (cdr names)))
                        (setq out (nreverse out))
                        (if count (seq-take out count) out))
