;;; generate-emacs-keys-gnu.el --- extract GNU global key bindings  -*- lexical-binding: t; -*-

;; Run: emacs --batch -l scripts/generate-emacs-keys-gnu.el
;; Copies, verbatim, the top-level `define-key' / `keymap-set' forms that GNU Emacs 31.1
;; window.el, frame.el, mule-cmds.el and loaddefs.el (all preloaded in GNU)
;; apply to the global keymap tree, into
;; packages/emacs-lib-core/src/emacs-keys-gnu.el.  The standalone loads its
;; own window/frame implementation instead of those files, so only their
;; key bindings are taken.  A form is copied when its keymap is one of the
;; global prefix maps and its definition is a command name or a literal,
;; so no variable owned by the rest of the file is needed.

;;; Code:

(defconst gen-keys--maps
  '(global-map ctl-x-map ctl-x-4-map ctl-x-5-map esc-map ctl-x-r-map
    tab-prefix-map goto-map search-map help-map)
  "Keymaps whose bindings are copied.")

(defconst gen-keys--sources
  '("vendor/staged-emacs-lisp/window.el" "vendor/staged-emacs-lisp/frame.el"
    "vendor/staged-emacs-lisp/mule-cmds.el" "vendor/emacs-lisp/loaddefs.el")
  "Pinned GNU sources, in GNU loadup order.")

(defun gen-keys--copy-p (form)
  "Non-nil when FORM binds a key in a global prefix map to a plain DEF."
  (and (memq (car-safe form) '(define-key keymap-set))
       (memq (nth 1 form) gen-keys--maps)
       (let ((def (nth 3 form)))
         (or (null def) (stringp def) (vectorp def)
             (memq (car-safe def) '(quote function))))))

(let* ((root (file-name-directory
              (directory-file-name
               (file-name-directory (or load-file-name buffer-file-name)))))
       (out (expand-file-name "packages/emacs-lib-core/src/emacs-keys-gnu.el" root))
       chunks)
  (dolist (rel gen-keys--sources)
    (with-temp-buffer
      (insert-file-contents (expand-file-name rel root))
      (emacs-lisp-mode)
      (goto-char (point-min))
      (push (format ";; %s\n" rel) chunks)
      (condition-case nil
          (while t
            (forward-comment (point-max))
            (let* ((beg (point)) (form (read (current-buffer))))
              (when (gen-keys--copy-p form)
                (push (concat (string-trim (buffer-substring beg (point))) "\n") chunks))))
        (end-of-file nil))))
  (with-temp-file out
    (insert ";;; emacs-keys-gnu.el --- GNU global key bindings  -*- lexical-binding: t; -*-\n\n"
            ";; GENERATED by scripts/generate-emacs-keys-gnu.el from the pinned GNU\n"
            ";; Emacs 31.1 window.el, frame.el, mule-cmds.el and loaddefs.el.  The\n"
            ";; forms below are copied verbatim; do not edit by hand.\n\n")
    (dolist (c (nreverse chunks)) (insert c))
    (insert "\n(provide 'emacs-keys-gnu)\n\n;;; emacs-keys-gnu.el ends here\n")))

;;; generate-emacs-keys-gnu.el ends here
