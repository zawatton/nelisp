;;; generate-emacs-c-vars-gnu.el --- emit GNU's C-level variables with their defaults  -*- lexical-binding: t; -*-
;; Usage (repository root):
;;   emacs-31.1 -Q --batch -l scripts/generate-emacs-c-vars-gnu.el
;; Writes packages/emacs-lib-core/src/emacs-c-vars-gnu.el: one guarded defvar per
;; variable GNU Emacs 31.1 defines in C (DEFVAR_*; `symbol-file' is nil), with the
;; value GNU -Q --batch starts with.  DEFVAR_PER_BUFFER variables (automatically
;; buffer-local in GNU) are made buffer-local.  Skipped, and listed at the end of the
;; output: values that do not read back `equal' (markers, buffers, frames, ...) and
;; values that depend on the build host (paths, environment, host name, times).
;; The guard keeps any definition the NeLisp substrate already has.
(require 'cl-lib)
(let* ((out (expand-file-name "packages/emacs-lib-core/src/emacs-c-vars-gnu.el"))
       (host-dependent
        '(data-directory doc-directory exec-directory installation-directory
          invocation-directory invocation-name source-directory system-name
          exec-path process-environment initial-environment load-path
          emacs-build-time emacs-build-system emacs-build-number
          command-line-args command-line-args-left command-line-default-directory
          shell-file-name user-full-name user-login-name user-real-login-name
          temporary-file-directory path-separator emacs-copyright
          system-configuration system-configuration-options
          system-configuration-features operating-system-release
          report-emacs-bug-address emacs-pid default-directory
          native-comp-eln-load-path comp-native-version-dir
          before-init-time after-init-time gc-elapsed gcs-done
          cons-cells-consed floats-consed vector-cells-consed symbols-consed
          string-chars-consed intervals-consed strings-consed
          pure-bytes-used last-command-event last-input-event
          internal--daemon-sockname x-display-name window-system
          initial-window-system terminal-frame
          after-load-alist load-history features current-load-list))
       (ok nil) (skipped nil))
  (mapatoms
   (lambda (s)
     (when (and (boundp s) (not (keywordp s)) (not (memq s '(nil t)))
                (null (symbol-file s 'defvar))
                (special-variable-p s))
       (let ((v (default-value s)))
         (cond
          ((memq s host-dependent) (push (cons s "host-dependent") skipped))
          ((let ((p (condition-case nil (prin1-to-string v) (error nil))))
             (or (null p)
                 (string-match-p "\\`#<" p)
                 (not (equal (condition-case nil (car (read-from-string p)) (error 'compall--unreadable)) v))
                 (string-match-p "/home/\\|/usr/\\|/tmp/" p)))
           (push (cons s "unreadable or path value") skipped))
          ((string-match-p "-\\(hook\\|hooks\\|functions\\)\\'" (symbol-name s))
           ;; C defaults of hooks are nil; GNU's Lisp adds the functions later.
           (push (list s nil (local-variable-if-set-p s)) ok))
          ((string-match-p "#\\[\\|#s(\\|#f(\\|(closure " (prin1-to-string v))
           (push (cons s "function or record value") skipped))
          (t (push (list s v (local-variable-if-set-p s)) ok)))))))
  (setq ok (sort ok (lambda (a b) (string< (car a) (car b)))))
  (setq skipped (sort skipped (lambda (a b) (string< (car a) (car b)))))
  (with-temp-file out
    (insert ";;; emacs-c-vars-gnu.el --- GNU 31.1 C-level variables and their defaults  -*- lexical-binding: t; -*-\n"
            ";; GENERATED by scripts/generate-emacs-c-vars-gnu.el from GNU Emacs 31.1 -Q --batch.\n"
            ";; Do not edit by hand.  Each variable GNU defines in C gets its GNU starting value\n"
            ";; unless the NeLisp substrate already binds it.\n\n")
    (let ((print-length nil) (print-level nil) (print-escape-newlines t))
      (dolist (e ok)
        (insert (format "(unless (boundp '%S) (defvar %S %s))\n" (nth 0 e) (nth 0 e)
                        (let ((v (nth 1 e)))
                          (if (or (symbolp v) (consp v)) (concat "'" (prin1-to-string v)) (prin1-to-string v)))))
        (when (nth 2 e)
          (insert (format "(make-variable-buffer-local '%S)\n" (nth 0 e))))))
    (insert "\n;; Skipped:\n")
    (dolist (e skipped) (insert (format ";;   %S: %s\n" (car e) (cdr e))))
    (insert "\n(provide 'emacs-c-vars-gnu)\n;;; emacs-c-vars-gnu.el ends here\n"))
  (message "emacs-c-vars-gnu: %d variables, %d skipped" (length ok) (length skipped)))
