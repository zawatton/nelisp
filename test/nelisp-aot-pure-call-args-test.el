;;; nelisp-aot-pure-call-args-test.el --- Pure RAW argument trees -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-pure-call-test--signed (n)
  (let ((v (logand n (1- (ash 1 64)))))
    (if (>= v (ash 1 63)) (- v (ash 1 64)) v)))
(defun nelisp-aot-pure-call-test--run (source)
  (let ((path (make-temp-file "pure-call-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp source path)
               (call-process path nil nil nil))
      (delete-file path))))
(defun nelisp-aot-pure-call-test--ref (slot)
  (nelisp-aot-compiler--make-ir 'ref :slot slot :class 'gp))
(defun nelisp-aot-pure-call-test--imm (n)
  (nelisp-aot-compiler--make-ir 'imm :value n))
(defun nelisp-aot-pure-call-test--op (op a b)
  (nelisp-aot-compiler--make-ir 'arith :op op :a a :b b))
(defun nelisp-aot-pure-call-test--node (args)
  (nelisp-aot-compiler--make-ir 'call :name 'callee :args args))
(ert-deftest nelisp-aot-pure-call-args/preflight ()
  (let* ((nelisp-aot-compiler--arch 'x86_64)
         (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (a (nelisp-aot-pure-call-test--ref 0))
         (b (nelisp-aot-pure-call-test--ref 1))
         (sum (nelisp-aot-pure-call-test--op '+ a b))
         (call (nelisp-aot-pure-call-test--node (list a sum))))
    (should (nelisp-aot-compiler--x86-pure-call-args-p call))
    (should-not (nelisp-aot-compiler--x86-pure-call-args-p
                 (nelisp-aot-pure-call-test--node (list a b))))
    (dolist (arg (list (nelisp-aot-compiler--make-ir 'ptr-read-u64 :ptr a :offset b)
                       (nelisp-aot-pure-call-test--op '/ a b)
                       (nelisp-aot-compiler--make-ir 'shift :op 'shl :a a :b b)
                       (nelisp-aot-compiler--make-ir 'call :name 'effect :args nil)
                       (nelisp-aot-compiler--make-ir 'setq :slot 0 :value a)
                       (nelisp-aot-compiler--make-ir 'imm-f64 :value 1.5)
                       (nelisp-aot-pure-call-test--op
                        '+ (nelisp-aot-pure-call-test--op
                            '* a (nelisp-aot-pure-call-test--imm 4))
                        (nelisp-aot-pure-call-test--imm 1))))
      (should-not (nelisp-aot-compiler--x86-pure-call-args-p
                   (nelisp-aot-pure-call-test--node (list sum arg)))))
    (dolist (property '(:varargs-p :fn-value :internal-boundary-disp))
      (should-not (nelisp-aot-compiler--x86-pure-call-args-p
                   (nelisp-aot-compiler--ir-with call property t))))
    (should-not (nelisp-aot-compiler--x86-pure-call-args-p
                 (nelisp-aot-compiler--ir-with call :ret-class 'f64)))
    (should-not (nelisp-aot-compiler--x86-pure-call-args-p
                 (nelisp-aot-pure-call-test--node (make-list 7 sum))))
    (dolist (mode '(checked lisp win64 argreg))
      (let ((nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (nelisp-aot-compiler--runtime-entry-params (and (eq mode 'lisp) '(x)))
            (nelisp-aot-compiler--abi (if (eq mode 'win64) 'win64 'sysv))
            (nelisp-aot-compiler--promoted-slots (and (eq mode 'argreg) '((1 . rdi)))))
        (should-not (nelisp-aot-compiler--x86-pure-call-args-p call))))))
(defconst nelisp-aot-pure-call-test--expressions
  '((+ (* a 8) 31) 1099511627793 (+ (+ a b) (+ c d))
    (logxor b d) (shl c 3) (- (+ (* d 2) a) 7)))
(ert-deftest nelisp-aot-pure-call-args/gnu-native-full-width ()
  (skip-unless (eq system-type 'gnu/linux))
  (let ((cases 0))
    (dolist (values '((3 5 7 11) (-3 -5 -7 -11)
                      (1099511627783 -17179869193 4294967295 -7)
                      (9223372036854775807 -9223372036854775808 0 -1)))
      (dolist (n '(1 2 4 6))
        (let* ((args (cl-subseq nelisp-aot-pure-call-test--expressions 0 n))
               (vars (cl-loop for i below n collect (intern (format "x%d" i))))
               (bindings (cl-mapcar #'list '(a b c d) values))
               (golden (nelisp-aot-pure-call-test--signed
                        (cl-loop for arg in args for i from 0
                                 sum (* (eval (cl-subst 'ash 'shl `(let ,bindings ,arg)) t) (+ 3 (* i 2))))))
               (sum (cons '+ (cl-loop for v in vars for i from 0
                                     collect `(* ,v ,(+ 3 (* i 2)))))))
          (should (= 0 (nelisp-aot-pure-call-test--run
                        `(seq (defun callee ,vars ,sum)
                              (defun f (a b c d) (callee ,@args))
                              (exit (if (= (f ,@values) ,golden) 0 1))))))
          (setq cases (1+ cases)))))
    (message "Pure GP argument GNU/native full64 cases: %d" cases)))
(ert-deftest nelisp-aot-pure-call-args/effects-and-heap-read-fallback ()
  (should (= 0 (nelisp-aot-pure-call-test--run
                 '(seq (defun callee (a b c) (+ (* a 100) (* b 10) c))
                       (defun f (x)
                         (callee (seq (setq x (+ x 1)) x)
                                 (seq (setq x (+ x 1)) x) x))
                       (exit (if (= (f 1) 233) 0 1))))))
  (should (= 0 (nelisp-aot-pure-call-test--run
                 '(seq (defun callee (a b) (- a b))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u64 p 0 9)
                           (callee (ptr-read-u64 p 0)
                                   (seq (ptr-write-u64 p 0 5) (ptr-read-u64 p 0)))))
                       (exit (if (= (run) 4) 0 1)))))))
(defvar nelisp-aot-pure-call-test--current nil)
(ert-deftest nelisp-aot-pure-call-args/source-no-marshalling ()
  "A real three-argument source call must lose its complex-prefix spills."
  (let ((emit (symbol-function 'nelisp-aot-compiler--emit-call))
        (push (symbol-function 'nelisp-aot-compiler--emit-temp-push))
        (pop (symbol-function 'nelisp-aot-compiler--emit-temp-pop))
        (pushes 0) (pops 0))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-call)
               (lambda (node buf)
                 (let ((nelisp-aot-pure-call-test--current
                        (eq (nelisp-aot-compiler--ir-get node :name) 'callee)))
                   (funcall emit node buf))))
              ((symbol-function 'nelisp-aot-compiler--emit-temp-push)
               (lambda (&rest args)
                 (when nelisp-aot-pure-call-test--current (setq pushes (1+ pushes)))
                 (apply push args)))
              ((symbol-function 'nelisp-aot-compiler--emit-temp-pop)
               (lambda (&rest args)
                 (when nelisp-aot-pure-call-test--current (setq pops (1+ pops)))
                 (apply pop args))))
      (should (= 0 (nelisp-aot-pure-call-test--run
                     '(seq (defun callee (a b c) (+ a b c))
                           (defun f (a b c) (callee a (+ b 1) (* c 8)))
                           (exit (if (= (f 3 5 7) 65) 0 1)))))))
    (message "Pure GP call source marshalling: push%d pop%d" pushes pops)
    (should (= pushes 0))
    (should (= pops 0))))
(ert-deftest nelisp-aot-pure-call-args/checked-overflow-fallback ()
  (let ((nelisp-aot-compiler--checked-arith t))
    (should (= 47 (nelisp-aot-pure-call-test--run
                   '(seq (defun callee (x) x)
                         (defun f (n) (callee (+ (* n 8) 31)))
                         (exit (f 2))))))
    (should (= 97 (nelisp-aot-pure-call-test--run
                   '(seq (defun callee (x) x)
                         (defun f (n) (callee (+ (* n 8) 31)))
                         (exit (f 288230376151711743))))))))
(defvar nelisp-aot-pure-call-test--depths nil)
(defun nelisp-aot-pure-call-test--record-depth (fn node)
  (let ((accepted (funcall fn node)))
    (when accepted (push nelisp-aot-compiler--rsp-temp-depth
                         nelisp-aot-pure-call-test--depths))
    accepted))
(ert-deftest nelisp-aot-pure-call-args/native-c-abi ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let* ((dir (make-temp-file "pure-call-abi-" t))
         (c (expand-file-name "callee.c" dir))
         (obj (expand-file-name "callee.o" dir))
         (probe (expand-file-name "probe.o" dir))
         (bin (expand-file-name "probe" dir))
         (nelisp-aot-pure-call-test--depths nil) (cases 0))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall probe\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (dolist (n '(1 2 4 6))
              (insert (format "uint64_t ext%d(%s) {\n" n
                              (mapconcat (lambda (i) (format "uint64_t a%d" i))
                                         (number-sequence 0 (1- n)) ",")))
              (insert "if ((uintptr_t)__builtin_frame_address(0) & 15) __builtin_trap();\nreturn ")
              (insert (mapconcat (lambda (i) (format "a%d * UINT64_C(%d)" i (+ 3 (* i 2))))
                                 (number-sequence 0 (1- n)) " + "))
              (insert ";\n}\n")))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer"
                                    "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--x86-pure-call-args-p :around
                      #'nelisp-aot-pure-call-test--record-depth)
          (dolist (n '(1 2 4 6))
            (dolist (nested '(nil t))
              (let* ((vars (cl-loop for i below 20 collect (intern (format "v%d" i))))
                     (values (cl-loop for i below 20
                                      collect (* (if (= (logand i 1) 0) 1 -1)
                                                 (+ (ash 1 48) (* i 4294967301)))))
                     (args (cl-subseq
                            '((+ (* v19 8) 31) 1099511627793
                              (+ (+ v16 v17) (+ v18 v19)) (logxor v15 v19)
                              (shl v14 3) (+ marker (* v13 8))) 0 n))
                     (bindings (append (cl-mapcar #'list vars values)
                                       (list (list 'marker (if nested 1 0)))))
                     (golden (nelisp-aot-pure-call-test--signed
                              (+ (cl-loop for arg in args for i from 0
                                          sum (* (eval (cl-subst 'ash 'shl `(let ,bindings ,arg)) t)
                                                 (+ 3 (* i 2))))
                                 (if nested (* (car values) (cadr values)) 0))))
                     (call `(extern-call ,(intern (format "ext%d" n)) ,@args))
                     (expr (if nested
                               `(+ (seq (setq marker 1) (* ,(car vars) ,(cadr vars))) ,call)
                             call)))
                (nelisp-aot-compile-to-object
                 `(seq (defun seed (x) x)
                       (defun probe ()
                         (let* ,(append (cl-mapcar (lambda (v n) (list v `(seed ,n))) vars values)
                                        '((marker (seed 0))))
                           (if (= ,expr ,golden) 0 1)))) probe)
                (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie"
                                          obj probe "-o" bin)))
                (should (= 0 (call-process bin nil nil nil)))
                (setq cases (1+ cases)))))
          (should (equal '(0 1) (sort (delete-dups nelisp-aot-pure-call-test--depths) #'<)))
          (message "Pure GP argument C ABI cases: %d; incoming temp depths:0/1" cases))
      (advice-remove 'nelisp-aot-compiler--x86-pure-call-args-p
                     #'nelisp-aot-pure-call-test--record-depth)
      (delete-directory dir t))))
(provide 'nelisp-aot-pure-call-args-test)
