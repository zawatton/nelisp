;;; standalone-abi-apply-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0))
  (dolist (value (list nil t 0 -7 1.25 "apply" '(a . b) [nil t] (make-symbol "apply-value")))
    (let ((fn (lambda (x) (garbage-collect) x)))
      (unless (eq (funcall fn value) value) (error "funcall WORD changed"))
      (unless (eq (apply fn (list value)) value) (error "apply tail WORD changed"))
      (unless (eq (eval (list 'quote value)) value) (error "eval result WORD changed"))
      (setq checked (+ checked 3)))
    (let ((fn (lambda (&rest xs) (garbage-collect) xs)) (tail (list value)))
      (unless (equal (apply fn 17 23 tail) (list 17 23 value)) (error "apply prefix splice changed"))
      (unless (eq (car tail) value) (error "apply mutated the caller tail"))
      (setq checked (+ checked 2)))
    (let ((old (symbol-function '+)))
      (unwind-protect
          (progn
            (fset '+ (lambda (_a _b) (garbage-collect) value))
            (unless (eq (eval '(+ 17 23)) value) (error "eval redefined operator changed")))
        (fset '+ old)))
    (setq checked (+ checked 1)))
  (dolist (pair '(((+ 17 23) . 40) ((- 23 17) . 6) ((* 17 2) . 34) ((/ 34 2) . 17)))
    (unless (= (eval (car pair)) (cdr pair)) (error "eval literal arithmetic changed"))
    (setq checked (+ checked 1)))
  (let ((env (list (cons 'abi-apply-x 23))))
    (unless (= (eval '(+ abi-apply-x 7) env) 30) (error "eval lexical environment changed"))
    (eval '(setq abi-apply-x 29) env)
    (unless (= (cdar env) 29) (error "eval lexical shared cell changed"))
    (setq checked (+ checked 2)))
  (unless (= (apply #'+ nil) 0) (error "empty apply changed"))
  (setq checked (+ checked 1))
  (dolist (form '((eval) (eval 1 nil nil)))
    (unless (eq (condition-case e (eval form) (error (car e))) 'wrong-number-of-arguments)
      (error "eval arity condition changed"))
    (setq checked (+ checked 1)))
  (dolist (call (list (lambda () (funcall (lambda () (signal 'arith-error '(funcall)))))
                     (lambda () (apply (lambda () (signal 'arith-error '(apply))) nil))
                     (lambda () (eval '(signal 'arith-error '(eval))))))
    (unless (eq (condition-case e (funcall call) (error (car e))) 'arith-error)
      (error "apply/eval original signal changed"))
    (setq checked (+ checked 1)))
  (princ (format "ABI-APPLY-WORD checked=%d PASS\n" checked)))
