      (should-not (plist-get meta :lowerable))
      (should (eq (not (null (plist-get meta :obsolete)))
                  (and (nth 3 case) t))))))

(ert-deftest nelisp-bytecode-ir-counted-and-switch-opcodes-are-structural-only ()
  (dolist (op '(175 176 177))
    (let* ((code (unibyte-string op 4 135))
           (result (nelisp-bytecode-ir-decode-result code []))
           (row (aref (plist-get result :instructions) 0))
           (meta (aref row 4)))
      (should (eq (plist-get result :status) 'unsupported))
      (should (= (aref row 2) 2))
      (should (= (aref row 3) 4))
      (should (= (plist-get meta :stack-delta) -3))
      (should (= (plist-get meta :count) 4))
      (should (= (plist-get meta :operand-width) 1))
      (should-not (plist-get meta :lowerable))))
  (let* ((discard (nelisp-bytecode-ir-decode-result
                   (unibyte-string 182 #x83 135) []))
         (discard-row (aref (plist-get discard :instructions) 0))
         (switch (nelisp-bytecode-ir-validate (unibyte-string 183 135) [] 2))
         (switch-row (aref (plist-get switch :instructions) 0)))
    (should (= (aref discard-row 2) 2))
    (should (= (plist-get (aref discard-row 4) :stack-delta) -3))
    (should (plist-get (aref discard-row 4) :preserve-top))
    (should (eq (plist-get (aref switch-row 4) :control-flow) 'table-driven))
    (should (= (plist-get (aref switch-row 4) :stack-delta) -2))
    (should-not (plist-get (aref switch-row 4) :lowerable))
    (should (eq (plist-get switch :status) 'unsupported))
    (should (eq (plist-get (plist-get switch :stack-analysis) :status) 'unknown))
    (should (equal (plist-get (plist-get switch :stack-analysis) :reason)
                   "handler or table-driven transfer has dynamic control flow"))
    (should-not (nelisp-bytecode-ir-cfg-valid-p
                 (append (plist-get switch :instructions) nil) 2)))
  (dolist (code (list (unibyte-string 175) (unibyte-string 176)
                      (unibyte-string 177) (unibyte-string 182)))
    (should (eq (plist-get (nelisp-bytecode-ir-decode-result code []) :status)
                'malformed)))
  (dolist (code (list (unibyte-string 130 4 0 175 2 135)
                      (unibyte-string 130 4 0 176 2 135)
                      (unibyte-string 130 4 0 177 2 135)
                      (unibyte-string 130 4 0 182 2 135)))
    (should (string-match-p
             "not an instruction boundary"
             (plist-get (nelisp-bytecode-ir-validate code [] 2) :reason)))))

(ert-deftest nelisp-bytecode-ir-host-compiled-fixtures-cover-listn-concatn-insertn-point ()
  (dolist (fixture '(((lambda () (point)) 96)
                     ((lambda (a b c d e f) (list a b c d e f)) 175)
                     ((lambda (a b c d e f) (concat a b c d e f)) 176)
                     ((lambda (a b c d e f) (insert a b c d e f)) 177)))
    (let* ((function (byte-compile (car fixture)))
           (result (nelisp-bytecode-ir-decode-result
                    (aref function 1) (aref function 2)))
           (opcode (cadr fixture))
           (row (cl-find-if (lambda (insn) (= (aref insn 1) opcode))
                            (plist-get result :instructions))))
      (should (byte-code-function-p function))
      (should row)
      (should-not (plist-get (aref row 4) :lowerable)))))

(ert-deftest nelisp-bytecode-ir-host-assq-and-stack-set-bytecode-match-widths ()
  (let* ((assq-function (byte-compile '(lambda (key alist) (assq key alist))))
         (assq-result (nelisp-bytecode-ir-decode-result
                       (aref assq-function 1) (aref assq-function 2)))
         (assq-row (cl-find-if (lambda (row) (= (aref row 1) 158))
                               (plist-get assq-result :instructions)))
         (stack-set-function
          (byte-compile '(lambda (x)
                           (let ((a x) (b x) (c x)) (setq a c) a))))
         (code (aref stack-set-function 1))
         (result (nelisp-bytecode-ir-decode-result code
                                                   (aref stack-set-function 2)))
         (row (cl-find-if (lambda (item) (= (aref item 1) 178))
                          (plist-get result :instructions))))
    (should assq-row)
    (should (eq (plist-get (aref assq-row 4) :kind) 'assq))
    (should-not (plist-get (aref assq-row 4) :lowerable))
    (should row)
    (should (= (aref row 2) (+ (aref row 0) 2)))
    (should (= (aref row 3) (aref code (1+ (aref row 0)))))
    (should (= (plist-get (aref row 4) :stack-offset) (aref row 3)))
    (should (= (plist-get (aref row 4) :operand-width) 1))
    (should (= (plist-get (aref row 4) :stack-delta) -1))
    (should-not (plist-get (aref row 4) :lowerable))))

(ert-deftest nelisp-bytecode-ir-stack-set-width-endian-and-truncation ()
  (let* ((code (unibyte-string 178 9 179 2 1 135))
         (result (nelisp-bytecode-ir-decode-result code []))
         (rows (plist-get result :instructions)))
    (should (eq (plist-get result :status) 'unsupported))
    (should (equal (list (aref (aref rows 0) 2) (aref (aref rows 0) 3))
                   '(2 9)))
    (should (equal (list (aref (aref rows 1) 2) (aref (aref rows 1) 3))
                   '(5 258)))
    (should (eq (plist-get (aref (aref rows 0) 4) :kind) 'stack-set))
    (should (= (plist-get (aref (aref rows 0) 4) :width) 2))
    (should (= (plist-get (aref (aref rows 0) 4) :stack-offset) 9))
    (should-not (plist-get (aref (aref rows 0) 4) :lowerable))
    (should (= (plist-get (aref (aref rows 1) 4) :operand-width) 2))
    (should (eq (plist-get (aref (aref rows 1) 4) :kind) 'stack-set))
    (should (= (plist-get (aref (aref rows 1) 4) :width) 3))
    (should (= (plist-get (aref (aref rows 1) 4) :stack-offset) 258))
    (should (= (plist-get (aref (aref rows 1) 4) :stack-delta) -1))
    (should-not (plist-get (aref (aref rows 1) 4) :lowerable)))
  (dolist (code (list (unibyte-string 178) (unibyte-string 179 1)))
    (let ((result (nelisp-bytecode-ir-decode-result code [])))
      (should (eq (plist-get result :status) 'malformed))
      (should (string-match-p "truncated" (plist-get result :reason))))))

