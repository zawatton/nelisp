(ert-deftest nelisp-bytecode-ir-rejects-branch-into-operand ()
  (let* ((code (unibyte-string 131 2 0 192 135))
         (rows (nelisp-bytecode-ir-decode-instructions code [x])))
    (should rows)
    (should (string-match-p "not an instruction boundary"
                            (nelisp-bytecode-ir-validate-targets rows (length code))))
    (should (eq (plist-get (nelisp-bytecode-ir-validate code [x] 0) :status)
                'malformed))
    (should-not (nelisp-bytecode-ir-cfg-valid-p rows (length code)))))

(ert-deftest nelisp-bytecode-ir-rejects-branch-into-compact-fetch-operand ()
  (let* ((code (unibyte-string 130 4 0 14 135 135))
         (result (nelisp-bytecode-ir-decode-result code []))
         (instructions (plist-get result :instructions)))
    (should (eq (plist-get result :status) 'unsupported))
    (should (= (aref (aref instructions 1) 2) 5))
    (should (string-match-p "not an instruction boundary"
                            (nelisp-bytecode-ir-validate-targets
                             instructions (length code))))))

(ert-deftest nelisp-bytecode-ir-rejects-reserved-opcodes-and-stack-underflow ()
  (should (eq (plist-get (nelisp-bytecode-ir-decode-result
                          (unibyte-string 184) []) :status) 'malformed))
  (let* ((decoded (nelisp-bytecode-ir-decode-result (unibyte-string 83 135) []))
         (stack (nelisp-bytecode-ir-analyze-stack
                 (plist-get decoded :instructions) 0)))
    (should (eq (plist-get stack :status) 'invalid))
    (should (string-match-p "underflow" (plist-get stack :reason)))))

(ert-deftest nelisp-bytecode-ir-gnu31-and-decoder-reject-opcode-zero-as-malformed ()
  (skip-unless (string-match-p "\\`31\\.1\\(?:\\'\\|[.-]\\)" emacs-version))
  (let* ((code (unibyte-string 0))
         (gnu-error (should-error (byte-code code [] 1) :type 'error))
         (decoded (nelisp-bytecode-ir-decode-result code [])))
    (should (string-match-p "Invalid byte opcode: op=0"
                            (error-message-string gnu-error)))
    (should (eq (plist-get decoded :status) 'malformed))
    (should (equal (plist-get decoded :reason) "reserved opcode 0"))
    (should (= (length (plist-get decoded :instructions)) 0))))

(ert-deftest nelisp-bytecode-ir-proves-single-backedge-loop-stack-depth ()
  (let* ((function
          (byte-compile
           '(lambda (n) (let ((i 0)) (while (< i n) (setq i (1+ i))) i))))
         (code (aref function 1))
         (decoded (nelisp-bytecode-ir-validate code (aref function 2) 1))
         (loop (nelisp-bytecode-ir-single-backedge-loop
                (plist-get decoded :instructions) (length code) 1)))
    (should (eq (plist-get (plist-get decoded :stack-analysis) :status)
                'complete))
    (should (= (plist-get loop :header) 1))
    (should (= (plist-get loop :backedge) 8))
    (should (= (plist-get loop :stack-depth) 2))
    (should (plist-get loop :continue-on-true))))

