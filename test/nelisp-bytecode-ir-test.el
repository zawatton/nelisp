(ert-deftest nelisp-bytecode-ir-bytecomp-opcodes-147-through-168-have-fixed-metadata ()
  ;; Names and stack effects mirror GNU Emacs 31.1 bytecomp.el byte-defop.
  (dolist (case '((147 set-marker -2) (148 match-beginning 0)
                  (149 match-end 0) (150 upcase 0) (151 downcase 0)
                  (152 string= -1) (153 string< -1) (154 equal -1)
                  (155 nthcdr -1) (156 elt -1) (157 member -1)
                  (158 assq -1) (159 nreverse 0) (160 setcar -1)
                  (161 setcdr -1) (162 car-safe 0) (163 cdr-safe 0)
                  (164 nconc -1) (165 quo -1) (166 rem -1)
                  (167 numberp 0) (168 integerp 0)))
    (let* ((opcode (nth 0 case)) (kind (nth 1 case)) (delta (nth 2 case))
           (result (nelisp-bytecode-ir-decode-result
                    (unibyte-string opcode 135) []))
           (row (aref (plist-get result :instructions) 0))
           (metadata (aref row 4)))
      (should (eq (plist-get result :status)
                  (if (= opcode 168) 'valid 'unsupported)))
      (should (= (aref row 2) 1))
      (should (eq (plist-get metadata :kind) kind))
      (should (= (plist-get metadata :stack-delta) delta))
      (should (= (plist-get metadata :width) 1))
      (should (eq (plist-get metadata :lowerable) (= opcode 168))))))

