(ert-deftest nelisp-bytecode-ir-stack-ref-6-and-7-have-upstream-widths ()
  (let* ((code (string-as-unibyte (unibyte-string 6 4 7 1 1 135)))
         (result (nelisp-bytecode-ir-decode-result code []))
         (rows (plist-get result :instructions)))
    (should (eq (plist-get result :status) 'unsupported))
    (should (= (length rows) 3))
    (should (equal (append (aref rows 0) nil) '(0 6 2 4 (:kind stack-ref :stack-delta 1 :lowerable nil :stack-offset 4))))
    (should (equal (append (aref rows 1) nil) '(2 7 5 257 (:kind stack-ref :stack-delta 1 :lowerable nil :stack-offset 257))))
    (should (equal (append (aref rows 2) nil) '(5 135 6 nil (:kind return :stack-delta -1 :lowerable t))))))

(ert-deftest nelisp-bytecode-ir-compact-families-decode-fetch-fetch2-operands ()
  (dolist (case '((14 4 2 6 1 unsupported) (15 257 3 7 1 unsupported)
                  (22 4 2 6 -1 unsupported) (23 257 3 7 -1 unsupported)
                  (30 4 2 6 -1 unsupported) (31 257 3 7 -1 unsupported)
                  (38 4 2 6 -4 unsupported) (39 257 3 7 -257 unsupported)
                  (46 4 2 6 0 unsupported) (47 257 3 7 0 unsupported)))
    (let* ((opcode (nth 0 case)) (operand (nth 1 case))
           (width (nth 2 case)) (immediate (nth 3 case))
           (delta (nth 4 case)) (expected-status (nth 5 case))
           (bytes (if (= immediate 6)
                      (list opcode operand 135)
                    (list opcode (logand operand 255)
                          (ash operand -8) 135)))
           (result (nelisp-bytecode-ir-decode-result
                    (apply #'unibyte-string bytes)
                    (if (memq opcode '(30 31))
                        (make-vector (1+ operand) 'frame-ir-variable)
                      [])))
           (insn (aref (plist-get result :instructions) 0)))
      (should (eq (plist-get result :status) expected-status))
      (should (= (aref insn 2) width))
      (should (= (aref insn 3) operand))
      (should (= (plist-get (aref insn 4) :compact-index) immediate))
      (should (= (plist-get (aref insn 4) :stack-delta) delta))))
  (should (eq (plist-get (nelisp-bytecode-ir-decode-result
                          (unibyte-string 14) []) :status) 'malformed))
  (should (eq (plist-get (nelisp-bytecode-ir-decode-result
                          (unibyte-string 15 1) []) :status) 'malformed)))

