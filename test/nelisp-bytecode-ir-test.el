(ert-deftest nelisp-bytecode-ir-compiled-arithmetic-has-known-stack-depth ()
  (let* ((parts (nelisp-bytecode-ir-test--compiled-parts '(lambda (x) (+ x 1))))
         (result (nelisp-bytecode-ir-decode-result (car parts) (cadr parts)))
         (instructions (plist-get result :instructions))
         (stack (nelisp-bytecode-ir-analyze-stack instructions 1)))
    (should (eq (plist-get result :status) 'valid))
    (should (equal (mapcar (lambda (row) (list (aref row 0) (aref row 1)
                                                (aref row 2)))
                           (append instructions nil))
                   '((0 84 1) (1 135 2))))
    (should (eq (plist-get stack :status) 'complete))
    (should (= (plist-get stack :max-depth) 1))))

(ert-deftest nelisp-bytecode-ir-compiled-branch-validates-targets-and-depths ()
  (let* ((parts (nelisp-bytecode-ir-test--compiled-parts '(lambda (x) (if x 1 2))))
         (result (nelisp-bytecode-ir-decode-result (car parts) (cadr parts)))
         (instructions (plist-get result :instructions))
         (stack (nelisp-bytecode-ir-analyze-stack instructions 1)))
    (should (eq (plist-get result :status) 'valid))
    (should-not (nelisp-bytecode-ir-validate-targets instructions (length (car parts))))
    (should (eq (plist-get stack :status) 'complete))
    (should (= (plist-get stack :max-depth) 2))
    (should (nelisp-bytecode-ir-cfg-valid-p (append instructions nil)
                                             (length (car parts))))))

(ert-deftest nelisp-bytecode-ir-compiled-catch-is-structural-but-not-lowerable ()
