                  (101 point-min 1) (102 char-after 0) (103 following-char 1)
                  (104 preceding-char 1) (105 current-column 1) (106 indent-to 0)
                  (107 scan-buffer 0 obsolete) (108 eolp 1) (109 eobp 1)
                  (110 bolp 1) (111 bobp 1) (112 current-buffer 1)
                  (113 set-buffer 0) (114 save-current-buffer 0)
                  (115 set-mark 0 obsolete) (116 interactive-p 1 obsolete)
                  (117 forward-char 0) (118 forward-word 0)
                  (119 skip-chars-forward -1) (120 skip-chars-backward -1)
                  (121 forward-line 0) (122 char-syntax 0)
                  (123 buffer-substring -1) (124 delete-region -1)
                  (125 narrow-to-region -1) (126 widen 1) (127 end-of-line 0)
                  (136 discard -1)
                  (138 save-excursion 0) (139 save-window-excursion 0 obsolete)
