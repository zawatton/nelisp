(require 'ert)
(require 'bytecomp)
(require 'nelisp-bytecode-ir)

(defun nelisp-bytecode-ir-test--compiled-parts (form)
  (let ((function (byte-compile form)))
    (list (aref function 1) (aref function 2))))

(ert-deftest nelisp-bytecode-ir/decodes-cons-effect-without-general-lowering-credit ()
  (let* ((result (nelisp-bytecode-ir-validate
                  (unibyte-string 1 1 66 135) [] 2))
         (rows (plist-get result :instructions))
         (cons-row (aref rows 2)))
    (should (eq (plist-get result :status) 'unsupported))
    (should (equal (aref cons-row 1) 66))
    (should (equal (plist-get (aref cons-row 4) :stack-delta) -1))
    (should (eq (plist-get (plist-get result :stack-analysis) :status)
                'complete))))

(ert-deftest nelisp-bytecode-ir-emacs31-object-predicates-have-fixed-neutral-width ()
  (dolist (case '((symbolp 57) (consp 58) (stringp 59) (listp 60)))
    (let* ((operator (car case)) (opcode (cadr case))
           (function (byte-compile (list 'lambda '(x) (list operator 'x))))
           (code (aref function 1)) (constants (aref function 2))
           (result (nelisp-bytecode-ir-validate code constants 1))
           (rows (plist-get result :instructions)))
      (should (equal (string-to-list code) (list opcode 135)))
      (should (eq (plist-get result :status) 'valid))
      (should (= (length rows) 2))
      (should (equal (append (aref rows 0) nil)
                     (list 0 opcode 1 nil
                           '(:kind predicate :stack-delta 0 :lowerable t
                             :width 1))))
      (should (= (aref (aref rows 1) 0) 1))
      (should (= (aref (aref rows 1) 1) 135))
      (should (eq (plist-get (plist-get result :stack-analysis) :status)
                  'complete)))))

(ert-deftest nelisp-bytecode-ir-bytecomp-object-opcode-table-is-width-one ()
  ;; Names and stack effects mirror GNU Emacs 31.1 bytecomp.el byte-defop.
  (dolist (case '((56 nth -1) (61 eq -1) (62 memq -1) (63 not 0)
                  (64 car 0) (65 cdr 0) (66 cons -1) (67 list1 0)
                  (68 list2 -1) (69 list3 -2) (70 list4 -3) (71 length 0)
                  (72 aref -1) (73 aset -2) (74 symbol-value 0)
                  (75 symbol-function 0) (76 set -1) (77 fset -1)
                  (78 get -1) (79 substring -2) (80 concat2 -1)
                  (81 concat3 -2) (82 concat4 -3)))
    (let* ((opcode (nth 0 case)) (kind (nth 1 case)) (delta (nth 2 case))
           (result (nelisp-bytecode-ir-decode-result
                    (unibyte-string opcode 135) []))
           (rows (plist-get result :instructions))
           (metadata (aref (aref rows 0) 4)))
      (should (eq (plist-get result :status)
                  (if (memq kind '(eq car cdr)) 'valid 'unsupported)))
      (should (= (aref (aref rows 0) 2) 1))
      (should (eq (plist-get metadata :kind) kind))
      (should (= (plist-get metadata :stack-delta) delta))
      (should (eq (plist-get metadata :width) 1))
      (should (eq (plist-get metadata :lowerable)
                  (and (memq kind '(eq car cdr)) t))))))

(ert-deftest nelisp-bytecode-ir-symbol-value-set-get-have-structural-stack-contracts ()
  ;; Hand-authored streams avoid source compilation and never execute opcodes.
  (dolist (case '((74 [symbol] 1 0 symbol-value)
                  (76 [symbol value] 2 -1 set)
                  (78 [symbol property] 2 -1 get)))
    (let* ((opcode (nth 0 case)) (constants (nth 1 case))
           (minimum (nth 2 case)) (delta (nth 3 case)) (kind (nth 4 case))
           (code (cond ((= opcode 74) (unibyte-string 192 74 135))
                       ((= opcode 76) (unibyte-string 192 193 76 135))
                       (t (unibyte-string 192 193 78 135))))
           (result (nelisp-bytecode-ir-validate code constants 0))
           (row (aref (plist-get result :instructions)
                      (if (= opcode 74) 1 2)))
           (metadata (aref row 4)))
      (should (eq (plist-get result :status) 'unsupported))
      (should (eq (plist-get (plist-get result :stack-analysis) :status)
                  'complete))
      (should (= (aref row 1) opcode))
      (should (= (plist-get metadata :minimum-inputs) minimum))
      (should (= (plist-get metadata :stack-delta) delta))
      (should (eq (plist-get metadata :kind) kind))
      (should (eq (plist-get metadata :runtime-op) kind))
      (should (eq (plist-get metadata :may-signal) t))
      (should-not (plist-get metadata :lowerable))))
  (should (eq (plist-get (nelisp-bytecode-ir-decode-result
                          (unibyte-string 192 74 135) []) :status)
              'malformed)))

(ert-deftest nelisp-bytecode-ir-symbol-value-set-get-reject-stack-underflow-at-opcode ()
  (dolist (case '((74 0) (76 1) (78 1)))
    (let* ((opcode (car case)) (depth (cadr case))
           (result (nelisp-bytecode-ir-validate
                    (unibyte-string opcode 135) [] depth))
           (stack (plist-get result :stack-analysis)))
      (should (eq (plist-get result :status) 'malformed))
      (should (eq (plist-get stack :status) 'invalid))
      (should (string-match-p "minimum input" (plist-get stack :reason)))
      (should (string-match-p "at 0" (plist-get stack :reason))))))

(ert-deftest nelisp-bytecode-ir-host-car-cons-and-eq-use-mapped-object-opcodes ()
  (dolist (case '(((lambda (x) (car x)) 64 car 0 1)
                  ((lambda (x y) (cons x y)) 66 cons -1 2)
                  ((lambda (x y) (eq x y)) 61 eq -1 2)))
    (let* ((function (byte-compile (car case)))
           (opcode (nth 1 case)) (kind (nth 2 case)) (delta (nth 3 case))
           (arity (nth 4 case))
           (result (nelisp-bytecode-ir-validate
                    (aref function 1) (aref function 2) arity))
           (rows (plist-get result :instructions))
           (row (cl-find-if (lambda (item) (= (aref item 1) opcode)) rows))
           (metadata (and row (aref row 4))))
      (should (byte-code-function-p function))
      (should row)
      (should (eq (plist-get metadata :kind) kind))
      (should (= (plist-get metadata :stack-delta) delta))
      (should (eq (plist-get metadata :lowerable)
                  (and (memq kind '(eq car cdr)) t)))
      (should (eq (plist-get (plist-get result :stack-analysis) :status)
                  'complete)))))

(ert-deftest nelisp-bytecode-ir-host-eq-is-the-generic-object-opcode-61 ()
  (let* ((function (byte-compile '(lambda (x y) (eq x y))))
         (code (aref function 1))
         (result (nelisp-bytecode-ir-validate code (aref function 2) 2))
         (rows (plist-get result :instructions))
         (row (cl-find-if (lambda (instruction) (= (aref instruction 1) 61))
                          rows)))
    (should (equal (string-to-list code) '(1 1 61 135)))
    (should (eq (plist-get result :status) 'valid))
    (should row)
    (should (eq (plist-get (aref row 4) :kind) 'eq))
    (should (= (plist-get (aref row 4) :stack-delta) -1))
    (should (plist-get (aref row 4) :lowerable))
    (should (= (plist-get (plist-get result :stack-analysis) :max-depth) 4))))

