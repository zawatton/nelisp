;;; -*- lexical-binding: t; -*-
;; Parity rows for `substring' and `copy-sequence' (named wrappers in emacs-buffer.el).
;; GNU 31.1 is the spec; see test/par-substr.gnu.
(defmacro row (name form) `(princ (format "%-28s %S\n" ,name (condition-case e ,form (error (list 'ERR e))))))
(row "sub plain" (substring "abcdef" 1 3))
(row "sub no end" (substring "abcdef" 2))
(row "sub no start" (substring "abcdef"))
(row "sub nil nil" (substring "abcdef" nil nil))
(row "sub neg start" (substring "abcdef" -3))
(row "sub neg end" (substring "abcdef" 1 -1))
(row "sub neg both" (substring "abcdef" -4 -2))
(row "sub empty" (substring "abcdef" 3 3))
(row "sub whole" (substring "abc" 0 3))
(row "sub start>end" (substring "abcdef" 4 2))
(row "sub end>len" (substring "abc" 0 9))
(row "sub start>len" (substring "abc" 9))
(row "sub neg oob" (substring "abc" -9))
(row "sub neg end oob" (substring "abc" 0 -9))
(row "sub nonint start" (substring "abc" 'a))
(row "sub nonint end" (substring "abc" 0 "x"))
(row "sub float" (substring "abc" 1.0))
(row "sub nil seq" (substring nil 0))
(row "sub symbol" (substring 'abc 0))
(row "sub int" (substring 5 0))
(row "sub too many args" (funcall #'substring "abc" 0 1 2))
(row "sub no args" (condition-case e (funcall #'substring) (wrong-number-of-arguments (list 'ERR (car e)))))
(row "sub vector" (substring [1 2 3 4] 1 3))
(row "sub vector neg" (substring [1 2 3 4] -2))
(row "sub vector oob" (substring [1 2 3] 5))
(row "sub vector no end" (substring [1 2 3]))
(row "sub list" (substring '(1 2 3) 1))
(row "sub multibyte" (substring "あいうえお" 1 3))
(row "sub multibyte neg" (substring "あいうえお" -2))
(row "sub multibyte len" (length (substring "aあb" 1)))
(row "sub multibyte p" (multibyte-string-p (substring "aあb" 1 2)))
(row "sub unibyte p" (multibyte-string-p (substring "abc" 1)))
(row "sub fresh" (let ((s "abc")) (eq s (substring s 0))))
(row "sub fresh whole" (let ((s (copy-sequence "abc"))) (list (eq s (substring s 0 3)) (equal s (substring s)))))
(row "sub prop mid" (substring (propertize "abcdef" 'face 'bold) 1 3))
(row "sub prop neg" (substring (propertize "abcdef" 'face 'bold) -2))
(row "sub prop partial" (substring (concat "ab" (propertize "cd" 'k 1) "ef") 1 5))
(row "sub prop two" (substring (concat (propertize "ab" 'a 1) (propertize "cd" 'b 2)) 1 3))
(row "sub prop none in range" (substring (concat "ab" (propertize "cd" 'k 1)) 0 2))
(row "sub prop multibyte" (substring (propertize "あいうえお" 'face 'x) 1 4))
(row "sub prop no end" (substring (propertize "abcdef" 'face 'bold) 2))
(row "sub prop pos" (let ((r (substring (concat "ab" (propertize "cd" 'k 1) "ef") 1))) (list (get-text-property 0 'k r) (get-text-property 1 'k r) (get-text-property 3 'k r) (get-text-property 0 'k (substring r 1 3)))))
(row "sub prop vector" (substring (vector 1 2 3) 0 2))
(row "cs plain" (copy-sequence "abc"))
(row "cs fresh" (let ((s "abc")) (list (eq s (copy-sequence s)) (equal s (copy-sequence s)))))
(row "cs empty" (copy-sequence ""))
(row "cs multibyte" (copy-sequence "あいう"))
(row "cs multibyte p" (multibyte-string-p (copy-sequence "あいう")))
(row "cs list" (let ((l (list 1 2 3))) (list (copy-sequence l) (eq l (copy-sequence l)))))
(row "cs list shares elts" (let* ((e (list 1)) (l (list e)) (c (copy-sequence l))) (eq (car c) e)))
(row "cs nil" (copy-sequence nil))
(row "cs vector" (let ((v (vector 1 2 3))) (list (copy-sequence v) (eq v (copy-sequence v)))))
(row "cs vector indep" (let* ((v (vector 1 2)) (c (copy-sequence v))) (aset c 0 9) v))
(row "cs bool-vector" (copy-sequence (make-bool-vector 3 t)))
(row "cs dotted" (copy-sequence '(1 2 . 3)))
(row "cs symbol" (copy-sequence 'a))
(row "cs int" (copy-sequence 5))
(row "cs no args" (condition-case e (funcall #'copy-sequence) (wrong-number-of-arguments (list 'ERR (car e)))))
(row "cs too many" (funcall #'copy-sequence "a" "b"))
(row "cs prop" (copy-sequence (propertize "abc" 'face 'bold)))
(row "cs prop partial" (copy-sequence (concat "a" (propertize "bc" 'k 1) "d")))
(row "cs prop independent" (let* ((s (propertize "abc" 'k 1)) (c (copy-sequence s))) (put-text-property 0 1 'k 2 c) (list (get-text-property 0 'k s) (get-text-property 0 'k c))))
(row "cs prop multibyte" (copy-sequence (propertize "あい" 'face 'x)))
(row "funcall substring" (funcall #'substring "abcdef" 1 2))
(row "apply substring" (apply #'substring '("abcdef" 1 2)))
(row "mapcar substring" (mapcar (lambda (i) (substring "abc" i (1+ i))) '(0 1 2)))
(row "scw plain" (string-clean-whitespace "  a   b  "))
(row "scw tabs nl" (string-clean-whitespace "\t a \n\n b\t"))
(row "scw empty" (string-clean-whitespace ""))
(row "scw only ws" (string-clean-whitespace "   "))
(row "scw single" (string-clean-whitespace "a"))
(row "scw prop" (string-clean-whitespace (concat " " (propertize "a  b" 'k 1) " ")))
(row "scw multibyte" (string-clean-whitespace "  あ   い  "))
(row "scw trim" (list (string-trim "  a b  ") (string-trim-left "  a") (string-trim-right "a  ")))
