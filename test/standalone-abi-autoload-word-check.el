;;; standalone-abi-autoload-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((saved (symbol-function 'autoload-do-load)) (checked 0)
      (values (list nil t 0 -7 1.25 "autoload" '(a . b) [nil t]
                    (make-symbol "autoload"))))
  (unwind-protect
      (progn
        (dolist (value values)
          (let ((cell (list 'autoload "abi-no-file" nil nil nil)) (calls 0))
            (fset 'abi-word-autoload-target cell)
            (fset 'autoload-do-load
                  (lambda (actual name &optional _macro)
                    (unless (and (eq actual cell) (eq name 'abi-word-autoload-target))
                      (error "autoload cell input lost"))
                    (setq calls (+ calls 1))
                    (garbage-collect)
                    (fset name (lambda () value))
                    ;; All valid WORDs, including nil/zero, mean successful load.
                    value))
            (unless (eq (funcall 'abi-word-autoload-target) value)
              (error "autoload replacement WORD changed"))
            (unless (and (eq (funcall 'abi-word-autoload-target) value) (= calls 1))
              (error "autoload replacement was loaded twice"))
            (setq checked (+ checked 3))))
        (fset 'abi-word-autoload-target '(autoload "abi-no-file" nil nil nil))
        (fset 'autoload-do-load (lambda (_cell _name &optional _macro)
                                 (signal 'arith-error '(autoload-callback))))
        (unless (eq (condition-case e (funcall 'abi-word-autoload-target) (error (car e)))
                    'arith-error)
          (error "autoload callback error was replaced"))
        (setq checked (+ checked 1))
        (fmakunbound 'autoload-do-load)
        (unless (eq (condition-case e (funcall 'abi-word-autoload-target) (error (car e)))
                    'void-function)
          (error "missing loader condition changed"))
        (setq checked (+ checked 1))
        (fset 'autoload-do-load nil)
        (unless (eq (condition-case e (funcall 'abi-word-autoload-target) (error (car e)))
                    'void-function)
          (error "nil loader condition changed"))
        (setq checked (+ checked 1)))
    (fset 'autoload-do-load saved)
    (fmakunbound 'abi-word-autoload-target))
  (princ (format "ABI-AUTOLOAD-WORD checked=%d PASS\n" checked)))
