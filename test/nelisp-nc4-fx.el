;;; nelisp-nc4-fx.el --- handler functions for the nc4 corpus  -*- lexical-binding: t; -*-
;; nativecomp N3 (nc4): lexical functions using catch / throw /
;; condition-case / unwind-protect and the save-* forms, compiled by the fx
;; compiler to the VM's handler frames and harvested as native corpus rows
;; (ids 2100 and up).  test/nelisp-nc4-corpus.el runs them.  Runs on GNU too.

(defvar nc4-dv 'outer "A special variable bound inside handler regions.")
(define-error 'nc4-err "nc4 error" 'arith-error)

(defun nc4-catch-basic (x)
  (catch 'tg (when (> x 0) (throw 'tg (* x 2))) 'none))
(defun nc4-thrower (tag x) (throw tag (list 'got x)))
(defun nc4-catch-dyn (tag x)
  (catch tag (nc4-thrower tag x) 'fell))
(defun nc4-catch-nested (x)
  (catch 'outer (list (catch 'inner (if (= x 1) (throw 'outer 'o) (throw 'inner 'i))) 'after)))
(defun nc4-throw-nowhere (x) (throw 'nc4-nowhere x))
(defun nc4-catch-stack (x)
  (list 1 2 (catch 'z (list 3 (if x (throw 'z 4) 5))) 6))
(defun nc4-cc-basic (x)
  (condition-case err (car x)
    (wrong-type-argument (list 'wta (cdr err)))
    (error (list 'err err))))
(defun nc4-cc-order (sig)
  (condition-case e (signal sig '(d))
    (arith-error (list 'arith (car e)))
    (error (list 'error (car e)))
    (t (list 'any (car e)))))
(defun nc4-cc-nil-var (x)
  (condition-case nil (/ 10 x) (arith-error 'div0)))
(defun nc4-cc-success (x)
  (condition-case v (+ x 1)
    (:success (list 'ok v))
    (error (list 'bad (car v)))))
(defun nc4-cc-list-spec (f)
  (condition-case e (funcall f)
    ((void-function wrong-type-argument) (list 'l (car e)))
    (quit 'quit)))
(defun nc4-cc-quit (x)
  (list (condition-case nil (signal 'quit nil) (error 'err) (quit 'q))
        (condition-case nil (condition-case nil (signal 'quit x) (error 'inner)) (quit 'outer))))
(defun nc4-cc-resignal (x)
  (condition-case e
      (condition-case e2 (error "a %d" x)
        (error (signal (car e2) (cons 'again (cdr e2)))))
    (error (cdr e))))
(defun nc4-cc-stack (x)
  (+ 1 (condition-case nil (+ 2 (car x)) (error 10)) 100))
(defun nc4-cc-data (x)
  (condition-case e (signal 'nc4-err (list x 2 3)) (nc4-err e)))
(defun nc4-cc-closure (x)
  (condition-case e (error "boom %s" x) (error (funcall (lambda () (cadr e))))))
(defun nc4-uwp-order (x)
  (let ((l nil))
    (catch 'x
      (unwind-protect
          (unwind-protect (progn (push 1 l) (when x (throw 'x nil)) (push 'n l))
            (push 2 l))
        (push 3 l)))
    (nreverse l)))
(defun nc4-uwp-normal (x)
  (let ((n 0)) (list (unwind-protect (+ x 1) (setq n 5)) n)))
(defun nc4-uwp-cleanup-error (x)
  (condition-case e (unwind-protect (error "body %s" x) (error "cleanup %s" x))
    (error (cadr e))))
(defun nc4-uwp-cleanup-throw (x)
  (catch 'c (condition-case nil (unwind-protect (error "body") (throw 'c (list 'cleanup x)))
              (error 'body-caught))))
(defun nc4-uwp-keeps-throw (x)
  (let ((seen nil))
    (list (catch 'k (unwind-protect (throw 'k x) (setq seen (list 'cleanup-ran x))))
          seen)))
(defun nc4-dyn-cc (x)
  (list (condition-case nil (let ((nc4-dv 'inner)) (error "x %s" x)) (error nc4-dv))
        nc4-dv))
(defun nc4-dyn-uwp (x)
  (let ((seen nil))
    (list (catch 'd (unwind-protect (let ((nc4-dv x)) (throw 'd nc4-dv)) (setq seen nc4-dv)))
          seen nc4-dv)))
(defun nc4-deep (n tag)
  (if (= n 0) (throw tag 'bottom) (list (nc4-deep (1- n) tag))))
(defun nc4-deep-catch (n)
  (catch 'deep (nc4-deep n 'deep)))
(defun nc4-deep-cc (n)
  (condition-case e (nc4-deep n 'nc4-unknown-tag) (no-catch (list 'no-catch (cdr e)))))
(defun nc4-loop-catch (n)
  (let ((i 0) (s 0))
    (while (< i n)
      (setq s (+ s (catch 'k (if (= (% i 3) 0) (throw 'k 1) 2))))
      (setq i (1+ i)))
    s))
(defun nc4-loop-cc (n)
  (let ((i 0) (errs 0))
    (while (< i n)
      (condition-case nil (when (= (% i 2) 0) (car i)) (wrong-type-argument (setq errs (1+ errs))))
      (setq i (1+ i)))
    errs))
(defun nc4-loop-uwp (n)
  (let ((i 0) (c 0))
    (while (< i n)
      (catch 'u (unwind-protect (when (= (% i 4) 0) (throw 'u nil)) (setq c (1+ c))))
      (setq i (1+ i)))
    c))
(defun nc4-gc-in-handler (x)
  (condition-case e (progn (garbage-collect) (error "g %s" x))
    (error (garbage-collect) (cadr e))))
(defun nc4-save-excursion (x)
  (with-temp-buffer
    (insert "hello world")
    (goto-char 3)
    (list (save-excursion (goto-char x) (point)) (point)
          (catch 'q (save-excursion (goto-char 1) (throw 'q (point))))
          (point))))
(defun nc4-save-restriction (x)
  (with-temp-buffer
    (insert "abcdefghij")
    (list (save-restriction (narrow-to-region 3 x) (list (point-min) (point-max)))
          (point-min) (point-max)
          (condition-case nil (save-restriction (narrow-to-region 2 4) (error "n")) (error (list (point-min) (point-max)))))))
(defun nc4-save-current-buffer (x)
  (let ((a (generate-new-buffer "nc4-a")) (b (generate-new-buffer "nc4-b")) r)
    (unwind-protect
        (progn
          (set-buffer a)
          (setq r (list (save-current-buffer (set-buffer b) (insert x) (buffer-name))
                        (buffer-name)
                        (catch 'sb (save-current-buffer (set-buffer b) (throw 'sb (buffer-string))))
                        (buffer-name))))
      (kill-buffer a) (kill-buffer b))
    r))
(defun nc4-save-match-data (s)
  (string-match "b+" s)
  (list (save-match-data (string-match "z" "xyz") (match-beginning 0))
        (match-beginning 0) (match-end 0)))
(defun nc4-catch-value-types (x)
  (list (catch 1 (throw 1 'fix)) (catch x (throw x 'sym))
        (let ((s "str")) (catch s (throw s 'string-eq)))))
(defun nc4-handler-args (x y)
  ;; Handlers inside argument evaluation of a call: the stack below them stays.
  (list x (condition-case nil (/ x y) (arith-error 'inf)) (catch 'w (throw 'w (+ x y))) y))

(defvar nc4-names
  '(nc4-catch-basic nc4-thrower nc4-catch-dyn nc4-catch-nested nc4-throw-nowhere nc4-catch-stack
    nc4-cc-basic nc4-cc-order nc4-cc-nil-var nc4-cc-success nc4-cc-list-spec nc4-cc-quit
    nc4-cc-resignal nc4-cc-stack nc4-cc-data nc4-cc-closure nc4-uwp-order nc4-uwp-normal
    nc4-uwp-cleanup-error nc4-uwp-cleanup-throw nc4-uwp-keeps-throw nc4-dyn-cc nc4-dyn-uwp
    nc4-deep nc4-deep-catch nc4-deep-cc nc4-loop-catch nc4-loop-cc nc4-loop-uwp nc4-gc-in-handler
    nc4-save-excursion nc4-save-restriction nc4-save-current-buffer nc4-save-match-data
    nc4-catch-value-types nc4-handler-args))
