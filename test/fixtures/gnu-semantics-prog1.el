;;; prog1-fixture.el --- GNU prog1 evaluation and arity -*- lexical-binding: t; -*-
;; GNU Emacs 31.1 src/eval.c:458-468 retains FIRST, then prog_ignore BODY.
(defvar vsp-count 0)
(defun vsp-side-effects ()
  (prog1 (setq vsp-count (1+ vsp-count))
    (setq vsp-count (1+ vsp-count))
    (setq vsp-count (1+ vsp-count))))
(defun vsp-nil-first () (prog1 nil (setq vsp-count (1+ vsp-count))))
(defun vsp-nested () (prog1 (prog1 42 2) (prog1 3 4)))
(dotimes (_ 6) (vsp-side-effects))
(prin1 (list 'side-effects (vsp-side-effects) vsp-count)) (terpri)
(prin1 (list 'nil-first (vsp-nil-first) vsp-count)) (terpri)
(prin1 (list 'nested (vsp-nested))) (terpri)
(when (boundp 'nelisp--fx-table)
  (dolist (name '(vsp-side-effects vsp-nil-first vsp-nested))
    (unless (vectorp (gethash (nthcdr 3 (symbol-function name)) nelisp--fx-table))
      (error "prog1 function was not compiled: %S" name))))
(princ "PROG1-VM-PASS\n")
(kill-emacs 0)
