;;; buffer-function-cell.el --- GNU-compiled buffer switches -*- lexical-binding: t; -*-
(defvar fbb-local nil)
(defun fbb-with (b _c)
  (with-current-buffer b (setq fbb-local 3) (buffer-name (current-buffer))))
(defun fbb-normal (b _c)
  (save-current-buffer (set-buffer b) (buffer-name (current-buffer))))
(defun fbb-throw (b _c)
  (catch 'fbb (save-current-buffer (set-buffer b) (throw 'fbb 17))))
(defun fbb-signal (b _c)
  (condition-case e
      (save-current-buffer (set-buffer b) (signal 'error '("fbb")))
    (error e)))
(defun fbb-nested (b c)
  (with-current-buffer b
    (with-current-buffer c (setq fbb-local 9))
    (buffer-name (current-buffer))))
(defun fbb-killed (b _c)
  (save-current-buffer
    (let ((saved (current-buffer)))
      (set-buffer b) (kill-buffer saved) (buffer-name (current-buffer)))))
(defun fbb-excursion (b _c)
  (save-excursion (set-buffer b) (buffer-name (current-buffer))))
(defun fbb-restriction (b _c)
  (save-restriction (set-buffer b) (buffer-name (current-buffer))))
(defun fbb-loop (b count)
  (let ((i 0))
    (while (< i count)
      (with-current-buffer b (setq fbb-local i))
      (setq i (1+ i)))
    fbb-local))
