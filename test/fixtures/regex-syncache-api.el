;;; regex-syncache-api.el --- public invalidation contract -*- lexical-binding: nil; -*-
(unless (fboundp 'nlre-clear-syntax-cache)
  (error "SYNCACHE-API: public clear function is absent"))
(unless (boundp 'nlre--syntax-cache-generation)
  (error "SYNCACHE-API: cache generation is absent"))
(let ((case-fold-search nil)
      (search-spaces-regexp nil)
      (old-table (syntax-table))
      (table (copy-syntax-table))
      (syntax-pattern "\\`\\sw\\'")
      (plain-pattern "\\`[a-z_]*\\'"))
  (unwind-protect
      (progn
        (set-syntax-table table)
        (nlre--compiled-cache-clear)
        (let* ((syntax (nlre--compiled-pattern syntax-pattern))
               (plain (nlre--compiled-pattern plain-pattern))
               (generation nlre--syntax-cache-generation))
          (let ((wrapper (symbol-function 'modify-syntax-entry)))
            (unless (and (eq syntax (nlre--compiled-pattern syntax-pattern))
                         (eq syntax (nlre--compiled-pattern syntax-pattern))
                         (= generation nlre--syntax-cache-generation)
                         (eq wrapper (symbol-function 'modify-syntax-entry)))
              (error "SYNCACHE-API: warm head/bucket hits changed the installed hook")))
          (nlre-clear-syntax-cache)
          (unless (> nlre--syntax-cache-generation generation)
            (error "SYNCACHE-API: clear did not advance generation"))
          (unless (eq plain (nlre--compiled-pattern plain-pattern))
            (error "SYNCACHE-API: clear discarded a non-syntax entry"))
          (when (eq syntax (nlre--compiled-pattern syntax-pattern))
            (error "SYNCACHE-API: bucket accepted an old generation"))
          (let ((new (nlre--compiled-pattern syntax-pattern)))
            (nlre-clear-syntax-cache)
            (nlre-clear-syntax-cache)
            (when (eq new (nlre--compiled-pattern syntax-pattern))
              (error "SYNCACHE-API: head accepted an old generation"))
            (unless (eq plain (nlre--compiled-pattern plain-pattern))
              (error "SYNCACHE-API: repeated clear lost non-syntax reuse")))
          (let ((generation nlre--syntax-cache-generation))
            (modify-syntax-entry ?@ "w" table)
            (unless (> nlre--syntax-cache-generation generation)
              (error "SYNCACHE-API: modify-syntax-entry missed clear hook")))
          (let ((generation nlre--syntax-cache-generation)
                failed)
            (condition-case nil
                (modify-syntax-entry ?@ 7 table)
              (error (setq failed t)))
            (unless (and failed (= generation nlre--syntax-cache-generation))
              (error "SYNCACHE-API: failed mutation changed generation")))
          (let ((old (nlre--compiled-pattern syntax-pattern))
                (generation nlre--syntax-cache-generation)
                (unrelated (copy-syntax-table)))
            (modify-syntax-entry ?@ "." unrelated)
            (unless (> nlre--syntax-cache-generation generation)
              (error "SYNCACHE-API: unrelated mutation did not invalidate globally"))
            (when (eq old (nlre--compiled-pattern syntax-pattern))
              (error "SYNCACHE-API: unrelated mutation retained a syntax entry")))
          (let ((nlre--syntax-table-reader
                 (lambda () (error "SYNCACHE-API: non-syntax hit read the table"))))
            (unless (eq plain (nlre--compiled-pattern plain-pattern))
              (error "SYNCACHE-API: non-syntax table independence failed")))
          ;; A later library definition can replace the bootstrap mutator.
          ;; Use the captured original callable, so this control cannot pass
          ;; merely by delegating to the old invalidating wrapper.
          (let ((saved (symbol-function 'modify-syntax-entry))
                (saved-wrapper nlre--syntax-cache-wrapper)
                (saved-original nlre--syntax-cache-original-function))
            (unwind-protect
                (progn
                  (let ((old (nlre--compiled-pattern syntax-pattern)))
                    (unless nlre--syntax-cache-original-function
                      (error "SYNCACHE-API: original mutator was not retained"))
                    (fset 'modify-syntax-entry nlre--syntax-cache-original-function)
                    (modify-syntax-entry ?@ "." table)
                    (when (eq old (nlre--compiled-pattern syntax-pattern))
                      (error "SYNCACHE-API: replaced mutator left a stale entry")))
                  (let ((generation nlre--syntax-cache-generation))
                    (modify-syntax-entry ?@ "w" table)
                    (unless (> nlre--syntax-cache-generation generation)
                      (error "SYNCACHE-API: replaced mutator lost its clear hook"))))
              (fset 'modify-syntax-entry saved)
              (setq nlre--syntax-cache-wrapper saved-wrapper
                    nlre--syntax-cache-original-function saved-original)))))
    (set-syntax-table old-table)))
(princ "REGEXP-SYNCACHE api PASS\n")
nil
