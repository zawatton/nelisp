;;; -*- lexical-binding: t; -*-
(require 'cl-lib)
(defvar gs-gv-events nil)
(defun gs-gv-late-accessor (object) (aref object 0))
(defun gs-gv-write (object)
  (setf (gs-gv-late-accessor (progn (push 'place gs-gv-events) object))
        (progn (push 'value gs-gv-events) 7)))
(fset (intern "(setf gs-gv-late-accessor)")
      (lambda (value object) (aset object 0 value)))
(let ((object (vector 0)))
  (setq gs-gv-events nil)
  (prin1 (list 'late-setter (gs-gv-write object)
               (reverse gs-gv-events) (aref object 0))) (terpri))
(cl-defstruct gs-gv-record field)
(let ((record (make-gs-gv-record :field 1)))
  (setf (gs-gv-record-field record) 9)
  (prin1 (list 'struct-setter (gs-gv-record-field record))) (terpri))

(kill-emacs 0)
