;;; -*- lexical-binding: t; -*-
;; Reader DSL: push preallocated nodes onto a singly linked trace list.
;; Each node has VALUE at +0 and NEXT at +8; HEAD stores the first node.
(defun aot-order-mark (head node value)
  (ptr-write-u64 node 8 (ptr-read-u64 head 0))
  (ptr-write-u64 head 0 node)
  value)
(defun aot-order-add (head left right) (+ (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-sub (head left right) (- (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-mul (head left right) (* (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-div (head left right) (/ (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-mod (head left right) (mod (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-or (head left right) (logior (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-and (head left right) (logand (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-xor (head left right) (logxor (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-less (head left right) (if (< (aot-order-mark head left 7) (aot-order-mark head right 5)) 1 0))
(defun aot-order-shift (head left right) (shl (aot-order-mark head left 7) (aot-order-mark head right 5)))
(defun aot-order-three (head left right third)
  (+ (aot-order-mark head left 7)
     (aot-order-mark head right 5)
     (aot-order-mark head third 3)))
(defun aot-order-pair (a b) (- a b))
(defun aot-order-call (head left right)
  (aot-order-pair (aot-order-mark head left 7) (aot-order-mark head right 5)))
;; One exported entry avoids authenticating and mapping the same object per case.
(defun aot-order-run (mode head left right third)
  (cond ((= mode 0) (aot-order-add head left right))
        ((= mode 1) (aot-order-sub head left right))
        ((= mode 2) (aot-order-mul head left right))
        ((= mode 3) (aot-order-div head left right))
        ((= mode 4) (aot-order-mod head left right))
        ((= mode 5) (aot-order-or head left right))
        ((= mode 6) (aot-order-and head left right))
        ((= mode 7) (aot-order-xor head left right))
        ((= mode 8) (aot-order-less head left right))
        ((= mode 9) (aot-order-shift head left right))
        ((= mode 10) (aot-order-three head left right third))
        (t (aot-order-call head left right))))
