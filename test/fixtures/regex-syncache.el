;;; regex-syncache.el --- portable GNU 31.1 syntax-cache oracle -*- lexical-binding: nil; -*-
;; Run unchanged with GNU and standalone.  The fixture never clears a cache:
;; modify-syntax-entry must perform the invalidation itself.
(defvar regex-syncache-matcher 'string-match)
(defvar regex-syncache-data-reader 'match-data)
(defvar regex-syncache-output nil)
(defun regex-syncache-result (name pattern text)
  (let ((hit (funcall regex-syncache-matcher pattern text)))
    (princ (format "%S\n" (list name hit (and hit (funcall regex-syncache-data-reader t))))
           regex-syncache-output)))

(let ((case-fold-search nil)
      (search-spaces-regexp nil)
      (old-table (syntax-table))
      (word (copy-syntax-table))
      (punct (copy-syntax-table)))
  (unwind-protect
      (progn
        (modify-syntax-entry ?@ "w" word)
        (modify-syntax-entry ?@ "." punct)
        (set-syntax-table word)
        (regex-syncache-result 'word-before "\\`\\sw\\'" "@")
        (regex-syncache-result 'boundary-before "\\b@\\b" "@")
        (modify-syntax-entry ?@ "." word)
        (regex-syncache-result 'word-after "\\`\\sw\\'" "@")
        (regex-syncache-result 'boundary-after "\\b@\\b" "@")
        (modify-syntax-entry ?@ "_" word)
        (regex-syncache-result 'symbol-after "\\`\\s_\\'" "@")
        (set-syntax-table punct)
        (regex-syncache-result 'switch-punct "\\`\\s_\\'" "@")
        (set-syntax-table word)
        (regex-syncache-result 'switch-back "\\`\\s_\\'" "@")
        (let* ((parent (make-syntax-table))
               (child (make-syntax-table parent)))
          (modify-syntax-entry ?@ "w" parent)
          (set-syntax-table child)
          (regex-syncache-result 'parent-before "\\`\\w\\'" "@")
          (modify-syntax-entry ?@ "." parent)
          (regex-syncache-result 'parent-after "\\`\\w\\'" "@")
          (regex-syncache-result 'nonword-after "\\`\\W\\'" "@"))
        (regex-syncache-result 'plain-before "\\`[a-z_]*\\'" "unsigned_long")
        (modify-syntax-entry ?x ".")
        (regex-syncache-result 'plain-after "\\`[a-z_]*\\'" "unsigned_long"))
    (set-syntax-table old-table)))
nil
