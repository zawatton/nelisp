;;; s9-handler-probes.el --- condition-case probes for Doc 210 S9  -*- lexical-binding: t -*-
(defvar s9-probe-dyn 0)
(defun s9-probe-error (f)
  (condition-case nil (funcall f) (error 'caught)))
(defun s9-probe-quit (f)
  (condition-case nil (funcall f) (quit 'quit-caught)))
(defun s9-probe-t (f)
  (condition-case nil (funcall f) (t 'all-caught)))
(defun s9-probe-debug (f)
  (condition-case nil (funcall f) ((debug error) 'debug-caught)))
(defun s9-probe-arith (f)
  (condition-case nil (funcall f) (arith-error 'arith-caught)))
(defun s9-probe-let (f)
  (condition-case nil (let ((s9-probe-dyn 1)) (funcall f)) (error 'caught)))
(defun s9-probe-nested (f)
  (condition-case nil
      (condition-case nil (let ((s9-probe-dyn 1)) (funcall f)) (arith-error 'inner))
    (error 'outer)))
(defun s9-probe-debug-let (f)
  (condition-case nil (let ((s9-probe-dyn 1)) (funcall f)) ((debug error) 'debug-caught)))
