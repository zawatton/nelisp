(progn (load (getenv "NELISP_NATIVE_LOAD_FILE")) (load (getenv "NELISP_ABI_FILE")) (load (getenv "NELISP_REPL_GC_FILE")) (let* ((result (nelisp-repl-gc-collect)) (after (plist-get result :after)) (raw (plist-get after :raw)) (state (plist-get raw :runtime-reload-state)) (retention (plist-get after :retention)) (attempts (plist-get retention :conservative-completed-attempts)) (scanned (plist-get retention :conservative-scanned-bytes)) (pinned (plist-get retention :conservative-pinned-blocks)) (flags (plist-get retention :conservative-pin-present))) (unless (and (eq (plist-get state :status) :available) (eq (plist-get (plist-get after :arena) :status) :available) (integerp attempts) (> attempts 0) (integerp scanned) (>= scanned 0) (integerp pinned) (>= pinned 0) (eq (plist-get retention :last-collection-status) :available) (numberp (plist-get result :elapsed-usec)) (>= (plist-get result :elapsed-usec) 0)) (error "GC telemetry assertion failed: %S" result)) (princ (format "REPL_GC_SMOKE=PASS ATTEMPTS=%S SCANNED=%S PINNED=%S FLAGS=%S STATUS=%S\n" attempts scanned pinned flags (plist-get retention :last-collection-status)))) (exit 0))
