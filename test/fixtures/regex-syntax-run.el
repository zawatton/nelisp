;;; regex-syntax-run.el --- portable GNU 31.1 syntax-run oracle -*- lexical-binding: nil; -*-
(defvar regex-syntax-run-matcher 'string-match)
(defvar regex-syntax-run-data-reader 'match-data)
(defvar regex-syntax-run-output nil)

(defun regex-syntax-run-result (name pattern text &optional start)
  (condition-case err
      (let ((hit (funcall regex-syntax-run-matcher pattern text start)))
        (princ (format "%S\n" (list name hit
                                   (and hit (funcall regex-syntax-run-data-reader t))))
               regex-syntax-run-output))
    (error (princ (format "%S\n" (list name :error err)) regex-syntax-run-output))))

(defun regex-syntax-run-numbered-result (name group)
  "Print a compact capture summary at GNU's one-byte register boundary."
  (let* ((pattern (format "\\`\\(?%d:\\sw\\|\\s_\\)*\\'" group))
         (hit (funcall regex-syntax-run-matcher pattern "ab"))
         (data (and hit (funcall regex-syntax-run-data-reader t))))
    (princ (format "%S\n"
                   (list name hit (and hit (list (length data) (nth 0 data) (nth 1 data)
                                                (nth (* group 2) data)
                                                (nth (1+ (* group 2)) data)))))
           regex-syntax-run-output)))

(let ((case-fold-search nil)
      (search-spaces-regexp nil)
      (old-table (syntax-table))
      (table (copy-syntax-table (standard-syntax-table)))
      (star "\\`\\(\\sw\\|\\s_\\)*\\'")
      (plus "\\`\\(\\sw\\|\\s_\\)+\\'"))
  (unwind-protect
      (progn
        (set-syntax-table table)
        (regex-syntax-run-result 'empty-star star "")
        (regex-syntax-run-result 'empty-plus plus "")
        (regex-syntax-run-result 'last-capture star "unsigned_long")
        (regex-syntax-run-result 'plus-capture plus "unsigned_long")
        (regex-syntax-run-result 'invalid-character star "a b")
        (regex-syntax-run-result 'positive-start star "word" 1)
        (regex-syntax-run-result 'end-start star "word" 4)
        (regex-syntax-run-result 'shy "\\`\\(?:\\sw\\|\\s_\\)*\\'" "a_b")
        (regex-syntax-run-result 'single-class "\\`\\sw+\\'" "word")
        (regex-syntax-run-result 'explicit-group "\\`\\(?3:\\sw\\|\\s_\\)*\\'" "a_b")
        (regex-syntax-run-numbered-result 'group-255 255)
        (regex-syntax-run-numbered-result 'group-256 256)
        (regex-syntax-run-result 'high-group-then-implicit
                                 "\\`\\(?256:a\\)\\(b\\)\\'" "ab")
        (regex-syntax-run-result 'high-group-contains-low-group
                                 "\\`\\(?256:\\(?3:a\\)b\\)\\'" "ab")
        (regex-syntax-run-result 'space-class "\\`\\(\\s-\\|\\s_\\)*\\'" "_ \t")
        (regex-syntax-run-result 'paren-classes "\\`\\(\\s(\\|\\s)\\)*\\'" "([])")
        (regex-syntax-run-result 'multibyte star "日本_é")
        (regex-syntax-run-result 'unibyte star (unibyte-string ?a ?_ 233))
        (let ((case-fold-search t))
          (regex-syntax-run-result 'fold-uppercase plus "A_B")
          (regex-syntax-run-result 'fold-multibyte star "日本_É")
          (regex-syntax-run-result 'fold-invalid star "A B"))
        (regex-syntax-run-result 'nested-capture-fallback
                                 "\\`\\(\\(\\sw\\)\\|\\s_\\)*\\'" "ab_")
        (regex-syntax-run-result 'continuation-fallback
                                 "\\`\\(\\sw\\|\\s_\\)*\\sw\\'" "a_b")
        (regex-syntax-run-result 'multiwidth-fallback
                                 "\\`\\(\\sw\\|__\\)*\\'" "a__")
        (regex-syntax-run-result 'lazy-fallback "\\`\\(\\sw\\|\\s_\\)*?\\'" "a_b")
        (regex-syntax-run-result 'unanchored-fallback "\\(\\sw\\|\\s_\\)*" "a_b" 1)
        (regex-syntax-run-result 'invalid-pattern (concat "\\`\\sw*" "\\") "a")
        (regex-syntax-run-result 'invalid-group-zero "\\`\\(?0:\\sw\\|\\s_\\)*\\'" "ab")
        (regex-syntax-run-result 'invalid-group-leading-zero "\\`\\(?01:\\sw\\|\\s_\\)*\\'" "ab")
        (regex-syntax-run-result 'invalid-group-overflow "\\`\\(?2147483648:\\sw\\|\\s_\\)*\\'" "ab")
        (modify-syntax-entry ?@ "w" table)
        (regex-syntax-run-result 'mutation-before star "@")
        (modify-syntax-entry ?@ "." table)
        (regex-syntax-run-result 'mutation-after star "@")
        (let ((other (copy-syntax-table table)))
          (modify-syntax-entry ?@ "_" other)
          (set-syntax-table other)
          (regex-syntax-run-result 'switch-symbol star "@")
          (set-syntax-table table)
          (regex-syntax-run-result 'switch-back star "@"))
        (let* ((parent (make-syntax-table))
               (child (make-syntax-table parent)))
          (modify-syntax-entry ?@ "w" parent)
          (set-syntax-table child)
          (regex-syntax-run-result 'parent-before star "@")
          (modify-syntax-entry ?@ "." parent)
          (regex-syntax-run-result 'parent-after star "@"))
        (set-syntax-table table)
        (modify-syntax-entry ?@ "w" table)
        (regex-syntax-run-result 'direct-before star "@")
        ;; GNU tables allow raw aset.  Bootstrap tables instead expose the
        ;; same direct, non-invalidating edit through their entries hash.
        (if (and (fboundp 'char-table-p) (char-table-p table))
            (aset table ?@ (string-to-syntax "."))
          (puthash ?@ ?. (aref table 1)))
        (regex-syntax-run-result 'direct-after star "@")
        (if (and (fboundp 'char-table-p) (char-table-p table))
            (aset table ?@ (string-to-syntax "_"))
          (puthash ?@ ?_ (aref table 1)))
        (regex-syntax-run-result 'direct-symbol-after star "@"))
    (set-syntax-table old-table)))

