;;; standalone-abi-definer-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0) (index 0))
  (dolist (value (list nil t 0 -7 1.25 "definer" '(a . b) [nil t]
                       (make-symbol "definer-value")))
    (let ((var (intern (format "abi-definer-var-%d" index)))
          (constant (intern (format "abi-definer-const-%d" index)))
          (alias (intern (format "abi-definer-alias-%d" index)))
          (fn (intern (format "abi-definer-fn-%d" index)))
          (df (intern (format "abi-definer-defun-%d" index)))
          (macro (intern (format "abi-definer-macro-%d" index))))
      (unless (eq (eval (list 'defvar var (list 'quote value))) var)
        (error "defvar result WORD changed"))
      (unless (eq (symbol-value var) value) (error "defvar initial value changed"))
      (unless (eq (eval (list 'defvar var '(error "defvar initializer repeated"))) var)
        (error "bound defvar result changed"))
      (setq checked (+ checked 3))
      (unless (eq (eval (list 'defconst constant (list 'quote value))) constant)
        (error "defconst result WORD changed"))
      (unless (eq (symbol-value constant) value) (error "defconst value changed"))
      (setq checked (+ checked 2))
      (unless (eq (eval (list 'defalias (list 'quote fn)
                              (list 'function (list 'lambda nil (list 'quote value))))) fn)
        (error "defalias result WORD changed"))
      (unless (eq (funcall fn) value) (error "defalias callable changed"))
      (setq checked (+ checked 2))
      (unless (eq (eval (list 'defun df nil "doc" (list 'quote value))) df)
        (error "defun result WORD changed"))
      (unless (eq (funcall df) value) (error "defun callable changed"))
      (setq checked (+ checked 2))
      (unless (eq (eval (list 'defmacro macro nil (list 'quote (list 'quote value)))) macro)
        (error "defmacro result WORD changed"))
      (unless (eq (eval (list macro)) value) (error "defmacro expansion changed"))
      (setq checked (+ checked 2))
      (unless (eq (eval (list 'defvaralias (list 'quote alias) (list 'quote var))) var)
        (error "defvaralias result WORD changed"))
      (unless (eq (symbol-value alias) value) (error "defvaralias initial value changed"))
      (set alias (cons value nil))
      (unless (eq (symbol-value alias) (symbol-value var))
        (error "defvaralias shared writes changed"))
      (setq checked (+ checked 3))
      (fmakunbound fn) (fmakunbound df) (fmakunbound macro))
    (setq index (+ index 1)))
  (dolist (form '((defconst abi-definer-error-const (signal 'arith-error '(defconst)))
                  (defvar abi-definer-error-var (signal 'arith-error '(defvar)))
                  (defalias (signal 'arith-error '(defalias)) #'ignore)
                  (defvaralias (signal 'arith-error '(alias)) 'abi-definer-error-base)
                  (defvaralias 'abi-definer-error-alias (signal 'arith-error '(base)))))
    (unless (eq (condition-case e (eval form) (error (car e))) 'arith-error)
      (error "definer original condition changed: %S" form))
    (setq checked (+ checked 1)))
  (princ (format "ABI-DEFINER-WORD checked=%d PASS\n" checked)))
