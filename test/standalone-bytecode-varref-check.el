;;; standalone-bytecode-varref-check.el --- Live value/alias/redirect reads -*- lexical-binding: t; -*-

(defvar cfv-main 17)
(defvar cfv-local 7)
(defvar cfv-events nil)
(defun cfv-read-program (name)
  (make-byte-code 0 (unibyte-string 8 135) (vector name) 1))
(let ((checked 0) (reader (cfv-read-program 'cfv-main)))
  (dolist (value (list nil t 0 -7 2305843009213693952 1.25 "value" '(a . b) [nil 17]))
    (setq cfv-main value)
    (unless (equal (funcall reader) value) (error "Plain read lost %S" value))
    (setq checked (1+ checked)))
  (setq cfv-main 17)
  (unless (= (let ((cfv-main 29)) (funcall reader)) 29)
    (error "Dynamic value was not read live"))
  (setq checked (1+ checked))
  (defvaralias 'cfv-alias 'cfv-main)
  (let ((alias-reader (cfv-read-program 'cfv-alias)))
    (unless (= (funcall alias-reader) 17) (error "Alias target lost"))
    (setq cfv-main 31)
    (unless (= (funcall alias-reader) 31) (error "Alias value was cached"))
    (setq checked (+ checked 2)))
  (make-variable-buffer-local 'cfv-local)
  (set-default 'cfv-local 7)
  (let ((local-reader (cfv-read-program 'cfv-local)))
    (with-temp-buffer
      (setq cfv-local 43)
      (unless (= (funcall local-reader) 43) (error "Local redirect lost")))
    (with-temp-buffer
      ;; Compare the same live resolver after switching buffers; this
      ;; lane preserves the generic buffer-local semantics.
      (unless (equal (funcall local-reader) (symbol-value 'cfv-local))
        (error "Buffer switch diverged from the generic resolver")))
    (setq checked (+ checked 2)))
  (let ((name (intern "cfv-日本")) (one (make-symbol "cfv-same")) (two (make-symbol "cfv-same")))
    (set name 47) (set one 'one) (set two 'two)
    (unless (and (= (funcall (cfv-read-program name)) 47)
                 (eq (funcall (cfv-read-program one)) 'one)
                 (eq (funcall (cfv-read-program two)) 'two))
      (error "Unicode or uninterned identity changed"))
    (setq checked (+ checked 3)))
  (makunbound 'cfv-missing)
  (unless (equal (condition-case e (funcall (cfv-read-program 'cfv-missing)) (void-variable e))
                 '(void-variable cfv-missing))
    (error "Unbound variable data changed"))
  (setq checked (1+ checked))
  (princ (format "BYTECODE-VARREF checked=%d PASS\n" checked)))
nil
