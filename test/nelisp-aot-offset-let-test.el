(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)

(defun nelisp-aot-offset-let-test--body (form)
  (cond ((atom form) form)
        ((eq (car form) 'exit) `(syscall-direct 60 ,(nelisp-aot-offset-let-test--body (cadr form)) 0 0 0 0 0))
        (t (mapcar #'nelisp-aot-offset-let-test--body form))))
(defun nelisp-aot-offset-let-test--run (program)
  (let* ((forms (cdr program))
         (defs (cl-remove-if-not (lambda (x) (eq (car-safe x) 'defun)) forms))
         (body (cl-remove-if (lambda (x) (eq (car-safe x) 'defun)) forms))
         (program `(seq ,@defs (defun offset-main () ,(nelisp-aot-offset-let-test--body `(seq ,@body))) (exit (offset-main))))
         (p (make-temp-file "offset-let-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp program p) (call-process p nil nil nil))
      (delete-file p))))
(defun nelisp-aot-offset-let-test--wrap (x)
  (let ((u (logand x (1- (ash 1 64))))) (if (>= u (ash 1 63)) (- u (ash 1 64)) u)))

(ert-deftest nelisp-aot-offset-let/emitted-load-does-not-store-its-offset ()
  (let ((owner nil) (stores 0)
        (orig-def (symbol-function 'nelisp-aot-compiler--emit-defun))
        (orig-store (symbol-function 'nelisp-aot-compiler--emit-frame-slot-store-from-value)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-defun)
               (lambda (ir buf) (let ((prior owner)) (unwind-protect (progn (setq owner (nelisp-aot-compiler--ir-get ir :name)) (funcall orig-def ir buf)) (setq owner prior)))))
              ((symbol-function 'nelisp-aot-compiler--emit-frame-slot-store-from-value)
               (lambda (&rest args) (when (eq owner 'f) (cl-incf stores)) (apply orig-store args))))
      (let ((p (make-temp-file "offset-shape-")))
        (unwind-protect
            (nelisp-aot-compile-sexp
             '(seq (defun opaque (x) (+ x 17))
                   (defun f (p i) (seq (opaque 0) (let ((index (+ i 1))) (ptr-read-u8 p index))))
                   (exit (f 0 0))) p)
          (delete-file p))))
    (should (= stores 0))))

(ert-deftest nelisp-aot-offset-let/gnu-native-widths-and-wrapping ()
  (skip-unless (and (eq system-type 'gnu/linux) (string-match-p "x86_64" system-configuration)))
  (let ((cases 0))
    (dolist (bits '(8 16 32 64))
      (dolist (entry '(((+ i 1) -8 -1 0 7 31)
                       ((* (+ i 1) 2) -8 -1 0 7 31)
                       ((shl (- i 1) 3) -9223372036854775808 -8 -1 0 7 9223372036854775807)
                       ((- (+ i 1) i) -9223372036854775808 9223372036854775807 -1 0 13)))
        (let ((expr (car entry)) (checks nil))
          (dolist (i (cdr entry))
            (let* ((offset (nelisp-aot-offset-let-test--wrap
                            (cl-letf (((symbol-function 'shl) #'ash)) (eval `(let ((i ,i)) ,expr) t))))
                   (sum 0))
              (dotimes (k (/ bits 8))
                (setq sum (logior sum (ash (logand (+ (* (+ 128 offset k) 37) 11) 255) (* k 8)))))
              (push `(if (= (f (+ memory 128) ,i) ,(nelisp-aot-offset-let-test--wrap sum)) 0 (exit 41)) checks)
              (cl-incf cases)))
          (should
           (= 0 (nelisp-aot-offset-let-test--run
                 `(seq (defun opaque (x) (+ x 17))
                       (defun f (p i) (seq (opaque 0) (let ((index ,expr)) (,(intern (format "ptr-read-u%d" bits)) p index))))
                       (let ((memory (syscall-direct 9 0 4096 3 34 -1 0)) (j 0))
                         (while (< j 512) (ptr-write-u8 memory j (logand (+ (* j 37) 11) 255)) (setq j (+ j 1)))
                         ,@(nreverse checks) (exit 0)))))))))
    (message "Offset let GNU/native complete-word cases: %d" cases)))

(ert-deftest nelisp-aot-offset-let/word-header-stays-after-cons-and-vector-tests ()
  (skip-unless (and (eq system-type 'gnu/linux) (string-match-p "x86_64" system-configuration)))
  (should (= 0 (nelisp-aot-offset-let-test--run
                '(seq (defun opaque (x) (+ x 17))
                      (defun header (word i)
                        (opaque 0)
                        (if (= (logand word 7) 2) 7
                          (if (= (logand word 7) 6)
                              (let ((offset (+ i 1))) (ptr-read-u8 word offset)) 0)))
                      (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                        (ptr-write-u8 p 0 196)
                        (exit (if (= (header 2 -7) 7)
                                  (if (= (logand (header (+ p 6) -7) 63) 4) 0 43) 42))))))))

(ert-deftest nelisp-aot-offset-let/admission-and-effect-fallback ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (ptr (nelisp-aot-compiler--make-ir 'ref :slot 0 :class 'gp))
         (i (nelisp-aot-compiler--make-ir 'ref :slot 1 :class 'gp))
         (value (nelisp-aot-compiler--make-ir 'arith :op '+ :a i :b (nelisp-aot-compiler--make-ir 'imm :value 1)))
         (body (nelisp-aot-compiler--make-ir 'ptr-read-u64 :ptr ptr :offset (nelisp-aot-compiler--make-ir 'ref :slot 2 :class 'gp)))
         (node (nelisp-aot-compiler--make-ir 'let-rt :slot 2 :value-ir value :body body)))
    (should (nelisp-aot-compiler--x86-forward-load-offset node))
    (let ((nelisp-aot-compiler--checked-arith t)) (should-not (nelisp-aot-compiler--x86-forward-load-offset node)))
    (let ((nelisp-aot-compiler--x86-index-forward-frame-sensitive-p t)) (should-not (nelisp-aot-compiler--x86-forward-load-offset node)))
    (should-not (nelisp-aot-compiler--x86-forward-load-offset
                 (nelisp-aot-compiler--ir-with node :root-p t)))
    (should-not (nelisp-aot-compiler--x86-forward-load-offset
                 (nelisp-aot-compiler--ir-with node :value-ir
                  (nelisp-aot-compiler--ir-with value :a
                   (nelisp-aot-compiler--ir-with i :root-p t)))))
    (dolist (reg '(rax r10 r11 rdi rsi))
      (let ((nelisp-aot-compiler--promoted-slots (list (cons 0 reg))))
        (should-not (nelisp-aot-compiler--x86-forward-load-offset node))))
    (should-not (nelisp-aot-compiler--x86-forward-load-offset
                 (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-compiler--make-ir 'call :name 'opaque :args nil))))
    (should-not (nelisp-aot-compiler--x86-forward-load-offset
                 (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-compiler--ir-with value :a (nelisp-aot-compiler--make-ir 'ref :slot 2 :class 'gp))))))
  (skip-unless (and (eq system-type 'gnu/linux) (string-match-p "x86_64" system-configuration)))
  (should (= 0 (nelisp-aot-offset-let-test--run
                '(seq (defun opaque (x) (+ x 17))
                      (defun f (p i) (opaque 0)
                        (let ((seen 0))
                          (let ((index (seq (setq seen (+ seen 1)) (+ i 1))))
                            (+ (ptr-read-u8 p index) (* seen 16)))))
                      (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                        (ptr-write-u8 p 1 29) (exit (if (= (f p 0) 45) 0 44))))))))
(ert-deftest nelisp-aot-offset-let/frame-inspection-keeps-offset-in-frame ()
  (let ((owner nil) (flags nil) (stores 0)
        (orig-def (symbol-function 'nelisp-aot-compiler--emit-defun))
        (orig-store (symbol-function 'nelisp-aot-compiler--emit-frame-slot-store-from-value))
        (orig-forward (symbol-function 'nelisp-aot-compiler--x86-forward-load-offset)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-defun)
               (lambda (ir buf) (let ((prior owner)) (unwind-protect (progn (setq owner (nelisp-aot-compiler--ir-get ir :name)) (funcall orig-def ir buf)) (setq owner prior)))))
              ((symbol-function 'nelisp-aot-compiler--emit-frame-slot-store-from-value)
               (lambda (&rest args) (when (eq owner 'f) (cl-incf stores)) (apply orig-store args)))
              ((symbol-function 'nelisp-aot-compiler--x86-forward-load-offset)
               (lambda (node)
                 (when (eq owner 'f) (push nelisp-aot-compiler--x86-index-forward-frame-sensitive-p flags))
                 (funcall orig-forward node))))
      (let ((p (make-temp-file "offset-frame-")))
        (unwind-protect
            (nelisp-aot-compile-sexp
             '(seq (defun opaque (x) (+ x 17))
                   (defun f (p i) (seq (opaque 0) (aot-current-sp)
                                      (let ((index (+ i 1))) (ptr-read-u8 p index))))
                   (exit (f 0 0))) p)
          (delete-file p))))
    (should (> stores 0))
    (should flags)
    (should (cl-every #'identity flags))))

(provide 'nelisp-aot-offset-let-test)
