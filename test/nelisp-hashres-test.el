;;; nelisp-hashres-test.el --- hash-table helper fast paths (lane hashres) -*- lexical-binding: t; -*-
;; The production DSL defuns are read from HR_SOURCE (default: the build script),
;; evaluated on the host over a simulated word heap, and checked for results and
;; for the number of out-of-line helper calls (the instruction proxy).
(require 'ert)
(require 'cl-lib)

(defconst hr--root (file-name-directory (directory-file-name
                                         (file-name-directory load-file-name))))
(defvar hr--mem nil)
(defvar hr--next #x100000)
(defvar hr--calls nil)
(defvar hr--reindex nil)

(defun hr--definition (name &optional source)
  (with-temp-buffer
    (insert-file-contents (or source (getenv "HR_SOURCE")
                              (expand-file-name "scripts/nelisp-standalone-build.el" hr--root)))
    (let ((pattern (concat "(defun " (symbol-name name) " ")) form)
      (goto-char (point-min))
      (unless (search-forward pattern nil t) (error "Missing %s" name))
      (goto-char (match-beginning 0))
      (setq form (read (current-buffer)))
      form)))
(defun hr--truth (x) (and x (not (equal x 0))))
(defun hr--host (form)
  (cond ((atom form) form)
        ((memq (car form) '(if while))
         (cons (car form) (cons `(hr--truth ,(hr--host (cadr form)))
                                (mapcar #'hr--host (cddr form)))))
        ((consp (car form)) (mapcar #'hr--host form))
        (t (cons (pcase (car form) ('seq 'progn) ('shr 'hr--shr) ('sar 'hr--sar)
                        ('shl 'ash) (_ (car form)))
                 (mapcar #'hr--host (cdr form))))))
(defun hr--shr (x n) (ash (logand x #xffffffffffffffff) (- n)))
(defun hr--sar (x n) (ash x (- n)))

;; ---- simulated memory ----
(defun hr--alloc (n)
  (prog1 hr--next (setq hr--next (+ hr--next (* 16 (ceiling (max n 8) 16))))))
(defun hr--w (a v) (puthash a v hr--mem))
(defun hr--r64 (a &optional off)
  (let ((x (+ a (or off 0)))) (or (gethash x hr--mem) 0)))
(defun hr--r8 (a &optional off)
  (let* ((x (+ a (or off 0))) (b (logand x (lognot 7))) (w (or (gethash b hr--mem) 0)))
    (logand (ash w (- (* 8 (- x b)))) 255)))
(defun hr--r16 (a &optional off) (logand (hr--r64 a off) 65535))
(defun hr--wr64 (a off v) (hr--w (+ a off) v) 0)
(defun hr--fix (n) (+ (* n 4) 1))
(defun hr--vec (n)
  (let ((a (hr--alloc (+ 8 (* 8 n)))))
    (hr--w a (logior 8 (ash n 8)))
    (dotimes (i n) (hr--w (+ a 8 (* 8 i)) 3))
    (+ a 6)))
(defun hr--vset (v i w) (hr--w (+ (- v 6) 8 (* 8 i)) w))
(defun hr--vget (v i) (hr--r64 (- v 6) (+ 8 (* 8 i))))
(defun hr--cons (car cdr)
  (let ((a (hr--alloc 16))) (hr--w a car) (hr--w (+ a 8) cdr) (+ a 2)))
(defun hr--str (s)
  (let* ((n (length s)) (d (hr--alloc (+ n 8))) (a (hr--alloc 32)))
    (dotimes (i n)
      (let* ((x (+ d i)) (b (logand x (lognot 7))))
        (hr--w b (logior (or (gethash b hr--mem) 0) (ash (aref s i) (* 8 (- x b)))))))
    (hr--w a 5) (hr--w (+ a 8) n) (hr--w (+ a 24) d)
    (+ a 4)))
(defun hr--sym (name)
  (let ((a (hr--alloc 48)))
    (hr--w a 4) (hr--w (+ a 8) (hr--str name)) (hr--w (+ a 40) 0)
    (+ a 6)))

(defun hr--rawstr (s)
  "Data buffer holding S; returns its address."
  (let ((d (hr--alloc (+ (length s) 8))))
    (dotimes (i (length s))
      (let* ((x (+ d i)) (b (logand x (lognot 7))))
        (hr--w b (logior (or (gethash b hr--mem) 0) (ash (aref s i) (* 8 (- x b)))))))
    d))
(defun hr--symview (name)
  "A legacy 32-byte symbol view (tag byte 4, data at +16, length at +24)."
  (let ((a (hr--alloc 32)))
    (hr--w a 4) (hr--w (+ a 16) (hr--rawstr name)) (hr--w (+ a 24) (length name))
    a))
(defun hr--symobj-view-name (name)
  "A symbol object whose name cell is a legacy view."
  (let ((a (hr--alloc 48)))
    (hr--w a 4) (hr--w (+ a 8) (hr--symview name)) (hr--w (+ a 40) 0)
    (+ a 6)))
(defun hr--str-flagged (s)
  "A GNU string whose byte count lives in the header word (+8 = -1)."
  (let* ((w (hr--str s)) (a (- w 4)))
    (hr--w (+ a 8) -1) (hr--w a (length s))
    w))
(defvar hr--marker-kind 'view "How build writes the marker: view, object or object-view-name.")
(defconst hr--epoch 777)
(defconst hr--helpers
  '(nl_word_data nl_word_length nl_word_tag64 nl_val_tag nl_word_payload
    nl_cons_car_word nl_cons_cdr_word nl_vector_slot_word nl_ht_marker_word
    nl_ht_int nl_ht_meta_slot nl_ht_data_slot))
(defconst hr--defs
  '(nl_val_tag nl_word_payload nl_word_data nl_word_length nl_word_tag64
    nl_cons_car_word nl_cons_cdr_word nl_vector_slot_word nl_ht_marker_word
    nl_ht_marker_word_set nl_ht_int nl_ht_set_int nl_ht_meta_slot nl_ht_data_slot
    nl_ht_hash_index nl_ht_hash nl_ht_identity_key_hash nl_so_p bf_hash_table_p_raw
    nl_ht_test_mode nl_ht_identity_sync nl_ht_custom_function_w nl_ht_entry_value
    nl_ht_find_index nl_ht_find_in wf_bytecode_switch_find bf_identity_hash))

(defun hr--setup ()
  (setq hr--mem (make-hash-table :test 'eql) hr--next #x100000
        hr--calls nil hr--reindex nil)
  (hr--w 268436376 hr--epoch)
  (fset 'ptr-read-u64 #'hr--r64) (fset 'heap-read-u64 #'hr--r64)
  (fset 'ptr-read-u8 #'hr--r8) (fset 'heap-read-u8 #'hr--r8)
  (fset 'ptr-read-u16 #'hr--r16) (fset 'ptr-write-u64 #'hr--wr64)
  (fset 'vector-len (lambda (v) (ash (hr--r64 (- v 6) 0) -8)))
  (fset 'vector-ref-ptr (lambda (v i) (hr--vget v i)))
  (fset 'sexp-tag (lambda (x) (nl_val_tag x)))
  (fset 'heap-sexp-tag-word (lambda (x) (nl_val_tag x)))
  (fset 'heap-sexp-payload (lambda (x) (nl_word_payload x)))
  (fset 'heap-sexp-data (lambda (x) (nl_word_data x)))
  (fset 'heap-sexp-length (lambda (x) (nl_word_length x)))
  (fset 'nl_string_nbytes
        (lambda (s) (let ((n (hr--r64 s 8)))
                      (if (< n 0) (logand (hr--r64 s 0) most-positive-fixnum) n))))
  (fset 'nl_ht_reindex (lambda (tb rc) (push (list tb rc) hr--reindex) 0))
  (fset 'bf_eq2 (lambda (a b) (push 'bf_eq2 hr--calls) (if (= a b) 1 0)))
  (fset 'nl_ht_key_match (lambda (a b _m) (if (= a b) 1 0)))
  (fset 'nl_ht_symbol_hash (lambda (p) (ash p -4)))
  (dolist (n hr--defs) (eval (hr--host (hr--definition n)) t))
  (dolist (n hr--helpers)
    (let ((orig (symbol-function n)) (name n))
      (fset n (lambda (&rest a) (push name hr--calls) (apply orig a))))))

(defun hr--mark-sym ()
  (pcase hr--marker-kind
    ('view (hr--symview "hash-table"))
    ('object (hr--sym "hash-table"))
    ('object-view-name (hr--symobj-view-name "hash-table"))
    ('object-flagged (let ((a (hr--alloc 48)))
                       (hr--w a 4) (hr--w (+ a 8) (hr--str-flagged "hash-table")) (hr--w (+ a 40) 0)
                       (+ a 6)))))
(defun hr--build (test cache &optional keys)
  "A table of TEST (\"eq\" \"eql\" \"equal\") with slot 5 = CACHE (nil = 0).
KEYS are fixnum values inserted in order.  Returns (TABLE META INDEX)."
  (let* ((meta (hr--vec 15)) (cap 6) (isz 8)
         (pairs (hr--vec (* cap 2))) (hashes (hr--vec cap)) (next (hr--vec cap))
         (index (hr--vec isz)) (table (hr--cons meta index)) (count 0))
    (hr--vset meta 0 (hr--mark-sym)) (hr--vset meta 1 (hr--fix 0))
    (hr--vset meta 2 (hr--symview test)) (hr--vset meta 3 (hr--fix cap))
    (hr--vset meta 5 (hr--fix (or cache 0)))
    (hr--vset meta 6 (hr--fix hr--epoch)) (hr--vset meta 7 (hr--fix (- meta 6)))
    (hr--vset meta 8 3)
    (hr--vset meta 11 pairs) (hr--vset meta 12 hashes) (hr--vset meta 14 next)
    (dotimes (i isz) (hr--vset index i (hr--fix -1)))
    (dotimes (i cap)
      (hr--vset hashes i (hr--fix -1))
      (hr--vset next i (hr--fix (if (< (1+ i) cap) (1+ i) -1))))
    (hr--vset meta 13 (hr--fix 0))
    (dolist (k keys)
      (let* ((i count) (w (hr--fix k)) (h (bf_identity_hash w))
             (b (nl_ht_hash_index h isz)))
        (hr--vset pairs (* 2 i) w) (hr--vset pairs (1+ (* 2 i)) (hr--fix (* 10 k)))
        (hr--vset hashes i (hr--fix h))
        (hr--vset next i (hr--vget index b))
        (hr--vset index b (hr--fix i))
        (setq count (1+ count))))
    (hr--vset meta 13 (hr--fix (if (< count cap) count -1)))
    (hr--vset meta 1 (hr--fix count))
    (list table meta index)))

(defun hr--n () (cl-count-if (lambda (x) (memq x hr--helpers)) hr--calls))
(defmacro hr--measure (&rest body)
  `(progn (setq hr--calls nil) (prog1 (progn ,@body) nil)))

(ert-deftest hr-table-p ()
  (hr--setup)
  (dolist (kind '(view object object-view-name object-flagged))
    (let* ((hr--marker-kind kind) (tb (car (hr--build "eq" -102))))
      (setq hr--calls nil)
      (should (= (bf_hash_table_p_raw tb) 1))
      ;; every shape, including the flagged-length one, takes the fast path
      (should (= (hr--n) 0))
      ;; the same table through a legacy cons view (tag byte 7, payload at +8)
      (let ((v (hr--alloc 32)))
        (hr--w v 7) (hr--w (+ v 8) (- tb 2))
        (setq hr--calls nil)
        (should (= (bf_hash_table_p_raw v) 1))
        (should (= (hr--n) 0)))))
  (let* ((tb (car (hr--build "eq" -102)))
         (bad-name (let ((m (hr--vec 15)))
                     (hr--vset m 0 (hr--sym "hash-tablx")) (hr--cons m (hr--vec 1))))
         (bad-view (let ((m (hr--vec 15)))
                     (hr--vset m 0 (hr--symview "hash-tablx")) (hr--cons m (hr--vec 1))))
         (long-name (let ((m (hr--vec 15)))
                      (hr--vset m 0 (hr--symview "hash-tablexx")) (hr--cons m (hr--vec 1))))
         (short (let ((m (hr--vec 1))) (hr--cons m 3)))
         (nonvec (hr--cons (hr--fix 5) 3)))
    (setq hr--calls nil)
    (should (= (bf_hash_table_p_raw tb) 1))
    (should (= (hr--n) 0))
    (should (= (bf_hash_table_p_raw (hr--fix 3)) 0))
    (should (= (bf_hash_table_p_raw 3) 0))
    (should (= (bf_hash_table_p_raw bad-name) 0))
    (should (= (bf_hash_table_p_raw bad-view) 0))
    (should (= (bf_hash_table_p_raw long-name) 0))
    (should (= (bf_hash_table_p_raw short) 0))
    (should (= (bf_hash_table_p_raw nonvec) 0))
    (should (= (bf_hash_table_p_raw (hr--vec 4)) 0))))

(ert-deftest hr-test-mode ()
  (hr--setup)
  (dolist (c '(("equal" -101 0) ("eq" -102 1) ("eql" -103 2)))
    (let ((tb (car (hr--build (nth 0 c) (nth 1 c)))))
      (setq hr--calls nil)
      (should (= (nl_ht_test_mode tb) (nth 2 c)))
      (should (= (hr--n) 0))
      (should (null hr--reindex))))
  ;; uncached (slot 5 = 0): decoded from the symbol name, cache published, one reindex
  (dolist (c '(("equal" 0 -101) ("eq" 1 -102) ("eql" 2 -103) ("custom" 0 -101)))
    (setq hr--reindex nil)
    (let* ((b (hr--build (nth 0 c) nil)) (tb (car b)) (meta (cadr b)))
      (should (= (nl_ht_test_mode tb) (nth 1 c)))
      (should (= (hr--vget meta 5) (hr--fix (nth 2 c))))
      (should (= (length hr--reindex) 1))
      (should (= (nl_ht_test_mode tb) (nth 1 c)))
      (should (= (length hr--reindex) 1)))))

(ert-deftest hr-identity-sync ()
  (hr--setup)
  (let* ((b (hr--build "eq" -102)) (tb (car b)) (meta (cadr b)))
    (setq hr--calls nil)
    (should (= (nl_ht_identity_sync tb) 0))
    (should (= (hr--n) 0))
    (should (null hr--reindex))
    (hr--vset meta 6 (hr--fix 1))
    (nl_ht_identity_sync tb)
    (should (equal hr--reindex (list (list tb 1))))
    (setq hr--reindex nil)
    (hr--vset meta 6 (hr--fix hr--epoch)) (hr--vset meta 7 (hr--fix 12345))
    (nl_ht_identity_sync tb)
    (should (equal hr--reindex (list (list tb 1))))))

(ert-deftest hr-custom-and-entry ()
  (hr--setup)
  (let* ((b (hr--build "eq" -102 '(5 6 7))) (tb (car b)) (meta (cadr b)))
    (setq hr--calls nil)
    (should (= (nl_ht_custom_function_w tb 3) 3))
    (should (= (nl_ht_entry_value tb 1) (hr--fix 50)))
    (should (= (nl_ht_entry_value tb 3) (hr--fix 70)))
    (should (= (hr--n) 0))
    (let ((d (hr--vec 6)))
      (hr--vset d 2 (hr--fix 99)) (hr--vset d 4 (hr--fix 44))
      (hr--vset meta 8 d)
      (should (= (nl_ht_custom_function_w tb 2) (hr--fix 99)))
      (should (= (nl_ht_custom_function_w tb 4) (hr--fix 44))))))

(defun hr--colliding-keys ()
  "Six fixnum keys of which at least two share a bucket of an 8-bucket index."
  (let (pair)
    (cl-loop for a from 1 to 60 until pair do
             (cl-loop for b from (1+ a) to 60 until pair do
                      (when (= (nl_ht_hash_index (bf_identity_hash (hr--fix a)) 8)
                               (nl_ht_hash_index (bf_identity_hash (hr--fix b)) 8))
                        (setq pair (list a b)))))
    (append pair (list 100 200 300 400))))

(ert-deftest hr-find ()
  (hr--setup)
  (let* ((keys (hr--colliding-keys)) (b (hr--build "eq" -102 keys)) (tb (car b)))
    ;; the table must contain a collision chain, so the lazy hashes/next path runs
    (let ((buckets (mapcar (lambda (k) (nl_ht_hash_index (bf_identity_hash (hr--fix k)) 8)) keys)))
      (should (< (length (delete-dups (copy-sequence buckets))) (length buckets))))
    (dolist (k keys)
      (setq hr--calls nil)
      (let ((i (nl_ht_find_index tb (hr--fix k) (bf_identity_hash (hr--fix k)) 1)))
        (should (= i (cl-position k keys)))
        (should (= (hr--n) 0)))
      (should (= (nl_ht_find_in tb (hr--fix k)) (1+ (cl-position k keys)))))
    (should (= (nl_ht_find_in tb (hr--fix 99)) 0))
    (should (= (nl_ht_find_index tb (hr--fix 99) (bf_identity_hash (hr--fix 99)) 1) -1))
    ))

(ert-deftest hr-switch-find ()
  (hr--setup)
  (let* ((keys (list 5 6 7 8)) (b (hr--build "eq" -102 keys)) (tb (car b)))
    (dolist (k keys)
      (setq hr--calls nil)
      (should (= (wf_bytecode_switch_find tb (hr--fix k) 1) (1+ (cl-position k keys))))
      (should (<= (hr--n) 0)))
    (should (= (wf_bytecode_switch_find tb (hr--fix 42) 1) 0))
    ;; a symbol object key, hashed by the stubbed symbol hash
    (let* ((s (hr--sym "foo")) (meta (cadr b)) (pairs (hr--vget meta 11)))
      (should (= (wf_bytecode_switch_find tb s 1) 0))
      (ignore pairs))))

(ert-deftest hr-identity-hash ()
  (hr--setup)
  (setq hr--calls nil)
  (should (= (bf_identity_hash (hr--fix 12)) 12))
  (should (= (bf_identity_hash (hr--fix -3)) (logand -3 1073741823)))
  (should (= (bf_identity_hash 3) 0))
  (should (= (bf_identity_hash 7) 1))
  (should (= (hr--n) 0))
  (let ((s (hr--sym "foo")))
    (should (= (bf_identity_hash s) (logand (ash s -4) 1073741823)))))

(provide 'nelisp-hashres-test)
