;;; nelisp-typed-save-restore-local-test.el --- Restricted current-state pop -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tsl--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tsl--form (name file)
  (with-temp-buffer
    (insert-file-contents (expand-file-name file tsl--root)) (goto-char (point-min))
    (unless (search-forward (concat "(defun " (symbol-name name) " ") nil t) (error "Missing genuine helper %s" name))
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tsl--extern (x)
  (if (atom x) x (if (eq (car x) 'extern-call) (mapcar #'tsl--extern (cdr x)) (mapcar #'tsl--extern x))))
(defun tsl--run (options &optional baseline mutant)
  (let* ((mem (make-hash-table :test #'eql)) (before nil) (saved nil) trace observations
         (count (or (plist-get options :count) 5)) (n (ash count -2))
         (slot (+ 2000 104 (* (max 0 (min 23 (1- n))) 16)))
         (pending (plist-get options :pending)) (pending-seen nil))
    (cl-labels ((rd (p o) (let ((v (gethash (+ p o) mem 'absent)))
                           (if (eq v 'absent) (error "Invalid memory read %s" (+ p o)) v)))
                (tag (w) (cond ((= w 3) 0) ((= w 7) 1) ((= (logand w 7) 6) (logand (rd (- w 6) 0) 63))
                               ((= (logand w 7) 2) 7) (t 2)))
                (payload (w) (logand w -8))
                (slotword (w k) (rd (payload w) (+ 8 (* k 8))))
                (observe ()
                  (should (= (rd 2000 96) count)) (should (= (rd slot 0) 13))
                  (should (= (rd slot 8) 8006)) (should (= (rd 2000 72) 43))
                  (should (= (nl_sb_aux_default_bound_here 1000 4006 11) 1))
                  (push 'published observations))
                (wr (p o v)
                  (when (= (+ p o) 6016) (observe) (push (list 'default-store v) trace))
                  (unless (= (+ p o) 6016) (push (list 'write (+ p o) v) trace))
                  (puthash (+ p o) v mem) 1))
      (dotimes (i 61) (puthash (+ 2000 (* i 8)) 3 mem))
      (dotimes (i 24) (puthash (+ 2104 (* i 16)) 1 mem))
      (dolist (kv `((1096 . 3) (1112 . ,(or (plist-get options :watcher) 0))
                    (1168 . ,(or (plist-get options :worker) 0)) (1176 . 9000)
                    (9016 . 10000) (10008 . 0) (10016 . 2008)
                    (12000 . ,(or (plist-get options :threads) 0))
                    (13048 . ,(or (plist-get options :pin) 0)) (268435544 . 0)
                    (4000 . ,(or (plist-get options :header) 516)) (4016 . 6006)
                    (6000 . ,(or (plist-get options :localized-header) 520)) (6008 . 3) (6016 . 17)
                    (8000 . ,(or (plist-get options :payload-header) 776))
                    (8008 . ,(or (plist-get options :name) 4006))
                    (8016 . ,(or (plist-get options :value) 9)) (8024 . 11)
                    (14000 . 264) (14008 . 3) (18000 . 0) (18008 . 0) (18024 . 0)
                    (16000 . 8006) (16008 . 3))) (puthash (car kv) (cdr kv) mem))
      (puthash 2096 count mem) (puthash 2072 43 mem)
      (puthash slot (or (plist-get options :marker) 13) mem) (puthash (+ slot 8) 8006 mem)
      (setq before (copy-hash-table mem))
      (cl-letf (((symbol-function 'ptr-read-u64) #'rd) ((symbol-function 'heap-read-u64) #'rd)
                ((symbol-function 'ptr-write-u64) #'wr) ((symbol-function 'nl_val_tag) #'tag) ((symbol-function 'sexp-tag) #'tag)
                ;; No suspended-continuation views exist in this model: every binding is visible.
                ((symbol-function 'nl_n4_binding_visible) (lambda (&rest _) 1))
                ((symbol-function 'nl_word_payload) #'payload) ((symbol-function 'nl_vector_slot_word) #'slotword)
                ((symbol-function 'vector-ref-ptr) #'slotword)
                ((symbol-function 'vector-len) (lambda (w) (ash (rd (payload w) 0) -8)))
                ((symbol-function 'nl_cons_car_word) (lambda (w) (rd (payload w) 0)))
                ((symbol-function 'nl_cons_cdr_word) (lambda (w) (rd (payload w) 8)))
                ((symbol-function 'nelisp_symbol_key_equal) (lambda (a b) (if (= a b) 1 0)))
                ((symbol-function 'bf_eq2) (lambda (a b) (if (= a b) 1 0)))
                ((symbol-function 'nelisp_mirror_lookup_entry) (lambda (_env name) name))
                ((symbol-function 'atomic-fetch-add) (lambda (p n) (observe) (push 'dirty trace) (puthash p (+ (rd p 0) n) mem) 0))
                ((symbol-function 'alloc-bytes) (lambda (&rest _) (error "No allocation admitted")))
                ((symbol-function 'nl_root_frame) (lambda (&rest _) (error "No root scratch admitted")))
                ((symbol-function 'nl_root_words) (lambda (&rest _) (error "No root scratch admitted")))
                ((symbol-function 'nl_root_reserve) (lambda (&rest _) (error "No root scratch admitted"))))
        (unwind-protect
            (progn
              (dolist (entry '((nl_sb_pop_saved_local . "scripts/nelisp-standalone-build.el")
                               (nl_sb_restore_one . "scripts/nelisp-standalone-build.el")
                               (nl_sb_restore_list . "scripts/nelisp-standalone-build.el")
                               (nl_sb_set . "scripts/nelisp-standalone-build.el")
                               (nl_ent_set . "scripts/nelisp-standalone-build.el")
                               (nl_ent_set_slow . "scripts/nelisp-standalone-build.el")
                               (nl_so_p . "scripts/nelisp-standalone-build.el") (wf_dirty . "scripts/nelisp-standalone-build.el")
                               (nl_sb_aux_default_bound_here . "scripts/nelisp-standalone-build.el")
                               (nl_sb_saved_default_match . "scripts/nelisp-standalone-build.el")
                               (nl_vector_set_slot . "lisp/nelisp-cc-nlvector-set-slot.el")
                               (nl_val_clone_into . "lisp/nelisp-cc-val-load.el")
                               (nl_vl_prog2 . "lisp/nelisp-cc-val-load.el")))
                (push (cons (car entry) (and (fboundp (car entry)) (symbol-function (car entry)))) saved)
                (let ((f (tsl--form (car entry) (cdr entry))))
                  (when (eq (car entry) 'nl_sb_pop_saved_local)
                    (setq f (cl-subst 12000 '(data-addr nl_thread_registry) f :test #'equal)
                          f (cl-subst 13000 '(data-addr nl_root_pin_control) f :test #'equal))
                    (pcase mutant
                      ('slot (setq f (cl-subst '(nl_vector_slot_word item 2) '(nl_vector_slot_word item 1) f :test #'equal)))
                      ('guard (setq f (cl-subst 1 '(= (logand (heap-read-u64 env 112) 1048576) 0) f :test #'equal)))
                      ('retire (let ((seq (sst--find f (lambda (x) (and (eq (car-safe x) 'seq)
                                                                (sst--find x (lambda (y) (eq (car-safe y) 'nl_ent_set))))))))
                                 (setcdr seq (append (nthcdr 3 seq) (cl-subseq (cdr seq) 0 2)))))))
                  (fset (car entry) (eval (cons 'lambda (cddr (sst--host-form (tsl--extern f)))) t))))
              (let ((raw (symbol-function 'nl_ent_set)))
                (cl-letf (((symbol-function 'nl_ent_set)
                           (lambda (&rest args) (let ((answer (apply raw args)))
                                                 (if pending (progn (setq pending-seen t) 0) answer)))))
                  (let ((rc (if baseline (nl_sb_restore_list 1000 16002) (nl_sb_pop_saved_local 1000 2000))))
                    (when (= rc 1)
                      (should (= (hash-table-count before) (hash-table-count mem)))
                      (maphash (lambda (k v) (should (= v (gethash k mem)))) before))
                    (when (= rc 0)
                      (let ((allowed (if baseline '(6016) (list 6016 268435544 2096 slot (+ slot 8)))))
                        (maphash (lambda (k v) (unless (memq k allowed) (should (= v (gethash k mem))))) before)))
                    (should (= (rd 2000 72) 43))
                    (list rc (rd 6016 0) (rd 2000 96) (rd slot 0) (rd slot 8)
                          pending-seen (nreverse trace) (nreverse observations))))))
          (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s)))))))))
(defconst tsl--declines
  '((:watcher 1048576) (:header 260) (:header 772) (:header 4) (:header 1540)
    (:worker 1) (:worker 99) (:threads 1) (:pin 2) (:name 12000) (:value 12000)
    (:count 1) (:count 101) (:count -3) (:count 3) (:marker 1) (:payload-header 520)
    (:payload-header 4) (:localized-header 264) (:localized-header 4)))
(ert-deftest tsl-current-state-declines-are-byte-unchanged ()
  (dolist (options tsl--declines) (should (= (car (tsl--run options)) 1))))
(ert-deftest tsl-genuine-localized-store-before-retire ()
  (dolist (options '(nil (:header 528) (:count 97) (:value 18004) (:value 14006)))
    (let ((r (tsl--run options)))
      (should (= (car r) 0)) (should (= (nth 1 r) (or (plist-get options :value) 9)))
      (should (= (nth 2 r) (- (or (plist-get options :count) 5) 4)))
      (should (= (nth 3 r) 3)) (should (= (nth 4 r) 3)) (should (nth 7 r))))
  (dolist (pending '(nil t))
    (let ((old (tsl--run (list :pending pending) t)) (new (tsl--run (list :pending pending))))
      (should (= (car old) 0)) (should (= (car new) 0))
      (should (= (nth 1 old) (nth 1 new))) (should (eq (nth 5 old) (nth 5 new))))))
(ert-deftest tsl-actual-retire-slot-guard-mutants-reject ()
  (dolist (spec '((nil retire 0) (nil slot 0) ((:watcher 1048576) guard 1)))
    (pcase-let ((`(,options ,mutant ,expected) spec))
      (should (= (car (tsl--run options)) expected))
      (should-error (let ((r (tsl--run options nil mutant)))
                      (should (= (car r) expected)) (when (= expected 0) (should (= (nth 1 r) 9))))
                    :type 'ert-test-failed))))
(provide 'nelisp-typed-save-restore-local-test)
