;;; standalone-prim-globals-check.el --- Global cell semantics -*- lexical-binding: t -*-
(defvar pgc-global 17)
(defvar pgc-plain 5)
(defvar pgc-events nil)
(defvar pgc-count 0)
(defun pgc-check (name actual expected)
  (unless (equal actual expected)
    (error "globals %S: %S, expected %S" name actual expected))
  (setq pgc-count (1+ pgc-count)))
(defun pgc-watch (symbol value operation where)
  (push (list symbol value operation (and where (buffer-name where))) pgc-events))
(pgc-check 'nil-data (condition-case e (setq nil nil) (error e)) '(setting-constant nil))
(pgc-check 't-data (condition-case e (setq t t) (error e)) '(setting-constant t))
(pgc-check 'keyword-set (set :pgc-key :pgc-key) :pgc-key)
(pgc-check 'keyword-setq (setq :pgc-key :pgc-key) :pgc-key)
(pgc-check 'keyword-refusal (condition-case e (setq :pgc-key 9) (error e))
           '(setting-constant :pgc-key))
(pgc-check 'binding (let ((pgc-global 23)) (set 'pgc-global 24) pgc-global) 24)
(pgc-check 'restoration pgc-global 17)
(let ((buffer (generate-new-buffer "pgc-local")))
  (unwind-protect
      (with-current-buffer buffer
        (make-local-variable 'pgc-global)
        (pgc-check 'local-write (set 'pgc-global 31) 31)
        (pgc-check 'local-read pgc-global 31)
        (pgc-check 'default (default-value 'pgc-global) 17))
    (kill-buffer buffer)))
(add-variable-watcher 'pgc-global #'pgc-watch)
(unwind-protect
    (progn
      (let ((pgc-global 43)) (setq pgc-global 44))
      (makunbound 'pgc-global)
      (pgc-check 'notifications (reverse pgc-events)
                 '((pgc-global 43 let nil) (pgc-global 44 set nil)
                   (pgc-global 17 set nil) (pgc-global nil makunbound nil)))
      (pgc-check 'void-data (condition-case e pgc-global (error e))
                 '(void-variable pgc-global)))
  (remove-variable-watcher 'pgc-global #'pgc-watch))
(setq pgc-events nil)
(add-variable-watcher 'pgc-plain #'pgc-watch)
(unwind-protect
    (progn
      (let ((pgc-plain 6)) pgc-plain)
      (pgc-check 'plain-unlet (reverse pgc-events)
                 '((pgc-plain 6 let nil) (pgc-plain 5 unlet nil))))
  (remove-variable-watcher 'pgc-plain #'pgc-watch))
(defun pgc-symbol-value () (symbol-value 'pgc-global))
(when (fboundp 'nelisp--fx-register) (nelisp--fx-register 'pgc-symbol-value))
(let ((original (symbol-function 'symbol-value)) (value nil))
  (unwind-protect
      (progn (fset 'symbol-value (lambda (_symbol) 99))
             (setq value (pgc-symbol-value)))
    (fset 'symbol-value original))
  (pgc-check 'redefinition value 99))
(princ (format "PRIM-GLOBALS %d PASS\n" pgc-count))
(kill-emacs 0)
