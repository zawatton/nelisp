;;; nelisp-interp4-corpus.el --- if, quote, let and let* in the source interpreter -*- lexical-binding: t; -*-

;; interp4: every case enters EVAL with an unevaluated form.  The same file runs unchanged on
;; GNU Emacs and on NeLisp; the outputs must be byte-equal.  It covers the shapes of `if' and
;; `quote' (arity and dotted-list errors before evaluation), `let' bindings made as GNU's
;; Flet makes them (closures that capture, then see or set the variable; duplicates; shadowing;
;; many variables; special and locally declared variables; dynamic-binding mode), and `let*'.
(defvar i4c-sp 10)
(defvar i4c-log nil)
(defun i4c-note (x) (push x i4c-log) x)
(defun i4c-sp-value () i4c-sp)

(defconst i4c-cases
  '(;; if
    (if-true (if t 1 2))
    (if-false (if nil 1 2))
    (if-else-progn (if nil 1 2 3 4))
    (if-no-else (if nil 1))
    (if-then-only-true (if 5 'yes))
    (if-test-evaluated-once (progn (setq i4c-log nil) (list (if (i4c-note 3) (i4c-note 'a) (i4c-note 'b)) i4c-log)))
    (if-else-not-evaluated (progn (setq i4c-log nil) (list (if t (i4c-note 'a) (i4c-note 'b)) i4c-log)))
    (if-then-not-evaluated (progn (setq i4c-log nil) (list (if nil (i4c-note 'a) (i4c-note 'b)) i4c-log)))
    (if-nested (if (if nil t nil) 1 (if t 2 3)))
    (if-value-var (let ((a nil) (b 7)) (if a b (+ b 1))))
    (if-empty (if))
    (if-one-arg (if t))
    (if-dotted (if t 1 . 5))
    (if-dotted-short (if t . 5))
    (if-dotted-test (if . t))
    (if-error-in-test (condition-case e (if (car 5) 1 2) (error e)))
    (if-error-not-reached (condition-case e (if nil (car 5) 2) (error e)))
    (if-backtrace-error (condition-case e (if (car 5) 1 2) (error e)))
    (if-string-test (if "" 'str 'no))
    (if-zero (if 0 'zero 'no))
    (if-in-while (let ((i 0) (s 0)) (while (< i 10) (setq s (+ s (if (= (% i 2) 0) i 0))) (setq i (1+ i))) s))
    ;; quote
    (quote-sym (quote a))
    (quote-list (quote (1 2 3)))
    (quote-nil (quote nil))
    (quote-vector (quote [1 2]))
    (quote-string (quote "s"))
    (quote-cons-identity (let ((x '(1 2))) (eq x (car (list x)))))
    (quote-shared (let ((f (lambda () '(1 2)))) (eq (funcall f) (funcall f))))
    (quote-empty (quote))
    (quote-two (quote 1 2))
    (quote-dotted (quote . 5))
    (quote-dotted-cdr (quote 1 . 2))
    (quote-quote (quote (quote a)))
    (quote-function-quote (quote (function f)))
    (sharp-quote-in-list (list 'a #'car))
    ;; let: bindings as GNU's Flet makes them
    (let-hy-basic (let ((a 1) (b 2)) (+ a b)))
    (let-hy-setq (let ((a 1)) (setq a (+ a 1)) (setq a (* a 10)) a))
    (let-hy-setq-twice-value (let ((a 1)) (list (setq a 2) (setq a 3) a)))
    (let-hy-closure-after-setq (let ((a 1)) (setq a 5) (let ((f (lambda () a))) (setq a 6) (funcall f))))
    (let-hy-closure-then-setq (let ((a 1) (f nil)) (setq f (lambda () a)) (setq a 9) (funcall f)))
    (let-hy-closure-sets-visible (let ((a 1)) (let ((f (lambda () (setq a (+ a 1))))) (funcall f) (funcall f) a)))
    (let-hy-two-closures-share (let ((a 0)) (let ((inc (lambda () (setq a (1+ a)))) (get (lambda () a))) (funcall inc) (funcall inc) (funcall get))))
    (let-hy-closure-outlives (funcall (let ((a 41)) (lambda () (1+ a)))))
    (let-hy-closure-multi (let ((a 1) (b 2) (c 3)) (funcall (lambda () (list a b c)))))
    (let-hy-closure-in-loop (let ((fs nil)) (dotimes (i 3) (let ((j (* i i))) (push (lambda () j) fs))) (mapcar #'funcall fs)))
    (let-hy-dup (let ((a 1) (a 2)) a))
    (let-hy-dup-closure (let ((a 1) (a 2)) (funcall (lambda () a))))
    (let-hy-dup-setq (let ((a 1) (a 2)) (setq a 3) a))
    (let-hy-shadow (let ((a 1)) (let ((a 2)) (setq a 3)) a))
    (let-hy-shadow-closure (let ((a 1)) (let ((f (lambda () a))) (let ((a 2)) (list (funcall f) a)))))
    (let-hy-seven (let ((a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7)) (list a b c d e f g)))
    (let-hy-eight (let ((a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7) (h 8)) (list a b c d e f g h)))
    (let-hy-ten-setq (let ((a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7) (h 8) (i 9) (j 10)) (setq a j) (setq j b) (list a b c d e f g h i j)))
    (let-hy-nine-closure (let ((a 1) (b 2) (c 3) (d 4) (e 5) (f 6) (g 7) (h 8) (i 9)) (funcall (lambda () (+ a b c d e f g h i)))))
    (let-hy-value-string (let ((s "abc")) (eq s s)))
    (let-hy-value-same-object (let* ((x (list 1)) (r (let ((y x)) (eq x y)))) r))
    (let-hy-value-float (let ((x 1.5)) (setq x (+ x 1)) x))
    (let-hy-value-closure-object (let ((f (lambda (x) (* x 2)))) (funcall f 4)))
    (let-hy-nested-3 (let ((a 1)) (let ((b (+ a 1))) (let ((c (+ b 1))) (list a b c)))))
    (let-hy-in-function (funcall (lambda (p) (let ((a (+ p 1)) (b (+ p 2))) (list p a b))) 10))
    (let-hy-param-shadow (funcall (lambda (p) (let ((p (* p 2))) p)) 10))
    (let-hy-nil-binding (let (a b) (setq a 1) (list a b)))
    (let-hy-in-condition-case (condition-case nil (let ((a 1)) (car a)) (error 'caught)))
    (let-hy-unwind (let ((a 1)) (catch 'k (let ((a 2)) (throw 'k a))) a))
    (let-hy-gc (let ((a (make-list 100 1)) (b 5)) (garbage-collect) (setq b (length a)) (list b (length a))))
    (let-hy-big-body (let ((a 0)) (dotimes (i 100) (let ((b i)) (setq a (+ a b)))) a))
    (let-hy-special-bound (let ((i4c-sp 99)) (i4c-sp-value)))
    (let-hy-special-restored (progn (let ((i4c-sp 99)) i4c-sp) i4c-sp))
    (let-hy-special-and-lexical (let ((a 1) (i4c-sp 2)) (list a (i4c-sp-value))))
    (let-hy-local-defvar (let ((x 1)) (defvar x) (let ((x 2)) (list x (boundp 'x)))))
    (let-hy-keyword-binding (let ((:k :k)) :k))
    (let-hy-constant (let ((nil 1)) nil))
    ;; let*: one binding at a time
    (letstar-basic (let* ((a 1) (b (+ a 1)) (c (+ b 1))) (list a b c)))
    (letstar-shadow (let* ((a 1) (a (+ a 1)) (a (* a 10))) a))
    (letstar-shadow-closure (let* ((a 1) (f (lambda () a)) (a 2)) (list (funcall f) a)))
    (letstar-closure-later-var (let* ((a 1) (f (lambda () a)) (b 2)) (list (funcall f) b)))
    (letstar-closure-setq (let* ((a 1) (f (lambda () (setq a (1+ a))))) (funcall f) (funcall f) a))
    (letstar-setq-between (let* ((a 1) (b (progn (setq a 5) a))) (list a b)))
    (letstar-closure-then-shadow-set (let* ((a 1) (f (lambda () a)) (a 2)) (setq a 3) (list (funcall f) a)))
    (letstar-nil (let* (a (b 2)) (list a b)))
    (letstar-empty (let* () 5))
    (letstar-seven (let* ((a 1) (b a) (c b) (d c) (e d) (f e) (g f)) (list a b c d e f g)))
    (letstar-ten (let* ((a 1) (b (+ a 1)) (c (+ b 1)) (d (+ c 1)) (e (+ d 1)) (f (+ e 1)) (g (+ f 1)) (h (+ g 1)) (i (+ h 1)) (j (+ i 1))) (list a j)))
    (letstar-special (let* ((i4c-sp 5) (b (i4c-sp-value))) (list i4c-sp b)))
    (letstar-special-after-lexical (let* ((a 1) (i4c-sp (+ a 1))) (i4c-sp-value)))
    (letstar-local-defvar (let* ((y 1) (z (progn (defvar y) 2))) (let ((y 3)) (list y (boundp 'y)))))
    (letstar-error-value (condition-case e (let* ((a 1) (b (car a))) b) (error e)))
    (letstar-error-pops (progn (condition-case nil (let* ((i4c-zz 1) (b (car i4c-zz))) b) (error nil)) (boundp 'i4c-zz)))
    (letstar-constant (let* ((a 1) (nil 2)) a))
    (letstar-not-symbol (let* ((a 1) (1 2)) a))
    (letstar-dotted (let* ((a 1) . 5) a))
    (letstar-in-function (funcall (lambda (p) (let* ((a (+ p 1)) (b (* a 2))) (list p a b))) 3))
    (letstar-loop (let ((s 0)) (dotimes (i 20) (let* ((a i) (b (* a 2))) (setq s (+ s b)))) s))
    (letstar-loop-closures (let ((fs nil)) (dotimes (i 3) (let* ((a i) (b (* a 10))) (push (lambda () (+ a b)) fs))) (mapcar #'funcall (nreverse fs))))
    (letstar-gc (let* ((a (make-list 50 1)) (b (progn (garbage-collect) (length a)))) (list b)))
    ;; setq / lookup through hybrid frames in function frames
    (fn-let-lookup-outer (funcall (lambda (o) (let ((a 1)) (let ((b 2)) (list o a b)))) 7))
    (fn-let-setq-outer (funcall (lambda (o) (let ((a 1)) (let ((b 2)) (setq o (+ o a b)) o))) 7))
    (fn-let-closure-env (funcall (lambda (o) (let ((a 1)) (funcall (lambda () (setq o (+ o a)))) o)) 7))))

(defun i4c-run (case-)
  (let ((tag (car case-)) (form (cadr case-)))
    (condition-case e
        (princ (format "%S\n" (list tag (let ((r (eval form t))) (list 'ok r)))))
      (error (princ (format "%S\n" (list tag (list 'err e)))))
      (wrong-type-argument (princ (format "%S\n" (list tag (list 'err e))))))))

(dolist (c i4c-cases) (i4c-run c))

;; The same forms with the frames of an enclosing function around them.
(defun i4c-in-function (form)
  (funcall (lambda (outer1 outer2)
             (let ((mid 3))
               (ignore outer1 outer2 mid)
               (eval form t)))
           1 2))
(dolist (c i4c-cases)
  (let ((tag (car c)) (form (cadr c)))
    (condition-case e
        (princ (format "%S\n" (list (list 'fn tag) (list 'ok (i4c-in-function form)))))
      (error (princ (format "%S\n" (list (list 'fn tag) (list 'err e))))))))

;; The dynamic-binding mode of EVAL: `let' and `let*' bind dynamically.
(dolist (c '((dyn-let (let ((a 1)) (funcall (lambda () (boundp 'a)))))
             (dyn-letstar (let* ((a 1) (b a)) (list (boundp 'a) (boundp 'b))))
             (dyn-if (if (let ((a nil)) (boundp 'a)) 1 2))))
  (princ (format "%S\n" (list (car c) (condition-case e (list 'ok (eval (cadr c) nil)) (error (list 'err e)))))))

;; Redefinition of `if' and `quote' as functions is refused by GNU; a macro named like the
;; builtins the forms call is not tried here.  The builtins the forms evaluate may be redefined.
(dolist (name '(1+ car))
  (let ((saved (symbol-function name)) result)
    (unwind-protect
        (progn (fset name (lambda (&rest xs) (cons 'redefined (cons name xs))))
               (setq result (eval `(let ((a 1)) (if a (,name a) 0)) t)))
      (fset name saved))
    (princ (format "%S\n" (list (list 'redefined name) result)))))

(princ "I4-CORPUS COMPLETE\n")
(kill-emacs 0)
;;; nelisp-interp4-corpus.el ends here
