;;; standalone-abi-owned-word-check.el --- Owned and borrowed WORD results -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checks 0))
  (dolist (value (list nil t 0 -7 1.25 "owned" '(a . b) [nil t -7]
                       (make-symbol "owned") (make-bool-vector 3 t)))
    (let ((result (append '(a b) value)))
      (unless (and (eq (car result) 'a) (eq (car (cdr result)) 'b)
                   (eq (nthcdr 2 result) value))
        (error "append final WORD changed")))
    (unless (eq (append value) value) (error "single append value changed"))
    (let ((cell (cons nil nil)))
      (unless (and (eq (setcar cell value) value) (eq (car cell) value))
        (error "setcar WORD changed"))
      (unless (and (eq (setcdr cell value) value) (eq (cdr cell) value))
        (error "setcdr WORD changed")))
    (unless (eq (car (list value)) value) (error "list WORD changed"))
    (unless (eq (nelisp--cell-value value) value) (error "non-cell WORD changed"))
    (setq checks (+ checks 6)))
  (dolist (value '(nil t :abi-owned-keyword))
    (unless (eq (bare-symbol value) value) (error "bare symbol WORD changed"))
    (unless (eq (symbol-value value) value) (error "symbol value WORD changed"))
    (unless (eq (intern-soft value) value) (error "intern-soft symbol WORD changed"))
    (setq checks (+ checks 3)))
  (dolist (form '((append) (append nil nil) (append '(nil t) '(0 -7) nil)
                  (append '(a . 0) nil) (append '(a . -7) t)
                  (append [nil t] '(0 -7))
                  (logand 18446744073709551616 -1 255)
                  (logior 18446744073709551616 0 17)
                  (logxor -18446744073709551617 0 7)
                  (logand -18446744073709551617 18446744073709551616)
                  (+ 0 -7 1.25) (max 0 -7 1.25)))
    (princ (format "OWNED-RESULT %S\n"
                   (condition-case e (eval form t) (error (car e)))))
    (setq checks (+ checks 1)))
  (dolist (case '(("plain" () "plain") ("%s" ("sole") "sole")
                  ("a:%s/%d" (nil -7) "a:nil/-7")
                  ("%s/%s/%s" (nil t 0) "nil/t/0")
                  ("%%:%d" (0) "%:0")))
    (unless (equal (apply #'format (car case) (nth 1 case)) (nth 2 case))
      (error "format WORD changed: %S" case))
    (setq checks (+ checks 1)))
  (dolist (value (list nil t 0 -7 "captured" '(a . b) [nil t]))
    (let* ((x value) (closure (lambda () x)) (env (aref closure 2)))
      (unless (eq (cdr (assq 'x env)) value) (error "closure env WORD changed"))
      (garbage-collect)
      (unless (eq (funcall closure) value) (error "closure value lost after GC")))
    (setq checks (+ checks 2)))
  (dolist (value '(nil t 0 -7 abi-owned-type))
    (let* ((form (list 'function
                       (list 'lambda nil (list :documentation (list 'quote value)) 17)))
           (closure (eval form t)))
      (unless (eq (aref closure 4) value) (error "closure doc WORD changed: %S" value))
      (setq checks (+ checks 1))))
  (let* ((plain (lambda (x) x)) (empty (lambda ())))
    (unless (equal (aref plain 0) '(x)) (error "closure arguments changed"))
    (unless (equal (aref plain 1) '(x)) (error "closure body changed"))
    (unless (equal (aref empty 1) '(nil)) (error "empty closure body changed"))
    (setq checks (+ checks 3)))
  (let ((child (make-char-table nil)) (parent (make-char-table nil)))
    (unless (null (char-table-parent child)) (error "nil parent became a table"))
    (set-char-table-parent child parent)
    (unless (eq (char-table-parent child) parent) (error "parent WORD identity changed"))
    (setq checks (+ checks 2)))
  (princ (format "ABI-OWNED-WORD checks=%d PASS\n" checks)))
