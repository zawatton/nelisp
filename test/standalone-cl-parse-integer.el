;;; standalone-cl-parse-integer.el --- cl-parse-integer parity -*- lexical-binding: t; -*-
(defvar cpi--fail nil)
(defmacro cpi--check (form expected)
  `(let ((got (condition-case e ,form (error (list 'ERR (car e))))))
     (unless (equal got ,expected)
       (setq cpi--fail t)
       (princ (format "MISMATCH %S => %S (want %S)\n" ',form got ,expected)))))
(cpi--check (cl-parse-integer "42") 42)
(cpi--check (cl-parse-integer " -17 ") -17)
(cpi--check (cl-parse-integer "+8") 8)
(cpi--check (cl-parse-integer "ff" :radix 16) 255)
(cpi--check (cl-parse-integer "x12y" :start 1 :end 3) 12)
(cpi--check (cl-parse-integer "12ab" :junk-allowed t) 12)
(cpi--check (cl-parse-integer "ab" :junk-allowed t) nil)
(cpi--check (cl-parse-integer "12ab") '(ERR error))
(cpi--check (cl-parse-integer "") '(ERR error))
(when cpi--fail (kill-emacs 1))
(princ "OK\n")
