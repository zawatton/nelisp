;;; standalone-prim-sort-check.el --- GNU sort differential cases -*- lexical-binding: t -*-

;; Print values and complete condition data for the external GNU comparator.
;; The standalone-checks runner additionally requires the assertions below.
(defvar ps-cases
  '((sort nil)
    (sort [1])
    (sort nil 12)
    (sort '(1) 12)
    (sort '(2 1) 12)
    (sort '(2 1) 'ps-missing)
    (sort '(2 1) (lambda (_a _b) (signal 'arith-error '(ps-predicate))))
    (sort '(4 2 3 1) #'<)
    (sort [4 2 3 1] #'<)
    (sort '(4 2 3 1) :lessp #'<)
    (sort [4 2 3 1] :lessp #'<)
    (sort '(4 2 3 1) :reverse t)
    (sort '(4 2 3 1) :key (lambda (x) (- x)))
    (sort '(4 2 3 1) :key nil :lessp nil :reverse nil :in-place nil)
    (sort '((2 a) (1 b) (2 c) (1 d)) :key #'car)
    (sort '[(2 a) (1 b) (2 c) (1 d)] :key #'car :reverse t)
    (sort '((2 a) (1 b) (2 c) (1 d)) (lambda (a b) (< (car a) (car b))))
    (sort '(1 2) :key 12)
    (sort nil :key 12)
    (sort '(1) :key 12)
    (sort '(1 2) :lessp 12)
    (sort '(1 2) :reverse)
    (sort '(1 2) :unknown t)
    (sort '(1 2) :lessp #'< :lessp #'>)
    (sort '(1 2) :key nil :key 12)
    (sort "ab")
    (sort 12)
    (sort '(1 . 2))
    (sort '(1 2.0 0))
    (sort '(a "b"))
    (sort '(nil t a))
    (sort '(1 "b"))
    (sort '("b" "a" "aa") #'string-lessp)
    (sort '("b" "a" "aa") #'string<)
    (sort '([1 2] [1 1] [0]))
    (sort '((1 2) (1 1) (0)))
    (value< 1 2.0)
    (value< "a" 'b)
    (value< nil t)
    (value< [1] '(1))
    (value< 1 "a")
    (value< (make-hash-table) (make-hash-table))
    (let* ((x (list 3 1 2)) (tail (cdr x)) (y (sort x #'<)))
      (list x y (eq x y) (eq tail (cdr y))))
    (let* ((x (list 3 1 2)) (y (sort x :lessp #'<)))
      (list x y (eq x y) (eq (cdr x) (cdr y))))
    (let* ((x (list 3 1 2)) (y (sort x :lessp #'< :in-place t)))
      (list x y (eq x y)))
    (let* ((x (vector 3 1 2)) (y (sort x #'<))) (list x y (eq x y)))
    (let* ((x (vector 3 1 2)) (y (sort x))) (list x y (eq x y)))
    (let* ((x (vector 3 1 2)) (y (sort x :in-place t))) (list x y (eq x y)))
    (let* ((x (list 1)) (y (sort x))) (list x y (eq x y)))
    (let* ((x (vector 1)) (y (sort x))) (list x y (eq x y)))
    (sort [] :lessp 12 :key 12)
    (sort [1] :lessp 12 :key 12 :in-place t)
    (sort '(3 1 2) :key (lambda (_x) (signal 'arith-error '(ps-key))))
    (let ((count 0))
      (list (sort '(3 1 2) :key (lambda (x) (setq count (1+ count)) x)) count))
    (sort '("b" a nil t) #'string-lessp)
    (sort '("b" a nil t) #'string<)
    (sort '("é" "a" "あ" "α") #'string-lessp)
    (sort '("a" "ab" "a" "") :lessp #'string-lessp :reverse t)
    (let ((definition (symbol-function 'string-lessp)))
      (unwind-protect
          (progn (fset 'string-lessp (lambda (_a _b) nil))
                 (sort '("b" "a" "c") #'string-lessp))
        (fset 'string-lessp definition)))
    (let ((definition (symbol-function 'string<)))
      (unwind-protect
          (progn (fset 'string< (lambda (_a _b) nil))
                 (sort '("b" "a" "c") #'string<))
        (fset 'string< definition)))
    (let ((x (list 1 2)))
      (setcdr (cdr x) x)
      (condition-case problem (sort x)
        (circular-list (list (car problem) (eq (cadr problem) x)))))
    (sort '(("b" 1) ("a" 2) ("a" 3)) :key #'car :lessp #'string-lessp)
    (sort '[("b" 1) ("a" 2) ("a" 3)] :key #'car :lessp #'string< :reverse t)
    (equal (sort (mapcar (lambda (i) (% (* i 7919) 1000)) (number-sequence 1 1000)) #'<)
           (number-sequence 0 999))
    (progn
      (defun ps-cached-call (x) (ps-cached-target x))
      (fset 'ps-cached-target (lambda (x) (+ x 1)))
      (let ((first (ps-cached-call 10)))
        (fset 'ps-cached-target (lambda (x) (- x 1)))
        (let ((second (ps-cached-call 10)))
          (fmakunbound 'ps-cached-target)
          (list first second
                (condition-case problem (ps-cached-call 10) (error problem))))))
    (progn
      (fset 'ps-cached-target (lambda (x) (+ x 3)))
      (fset 'ps-cached-alias 'ps-cached-target)
      (defun ps-cached-alias-call (x) (ps-cached-alias x))
      (let ((first (ps-cached-alias-call 10)))
        (fset 'ps-cached-target (lambda (x) (- x 3)))
        (list first (ps-cached-alias-call 10))))
    (sort '(1 2) :key nil :reverse)
    (sort '(1 2) #'< nil)
    (sort 12 :unknown t)
    (sort '(1 . 2) :unknown t)
    (sort '(1 "a") :reverse t)
    (sort '(3 2 1) (lambda (a b) (signal 'arith-error (list a b))))
    (let ((calls nil))
      (list (sort '(3 1 2) :key (lambda (x) (setq calls (cons x calls)) x) :reverse t)
            calls))
    (progn
      (defun ps-physical-call (a b)
        (list (< a b) (= a b) (> a b) (+ a b) (- a b) (1+ a) (1- b)))
      (list (ps-physical-call 1 2)
            (ps-physical-call most-positive-fixnum 1)
            (ps-physical-call most-negative-fixnum -1)
            (ps-physical-call 1 2.5)
            (ps-physical-call (ash 1 80) 1)))
    (condition-case problem (ps-physical-call "x" 1) (error problem))
    (let* ((x (vector)) (y (sort x))) (list x y (eq x y)))))
(let ((index 0))
  (dolist (form ps-cases)
    (princ (format "PS-CASE %d " index))
    (prin1 (condition-case problem (eval form t) (error problem)))
    (terpri)
    (setq index (1+ index))))
(let ((values '(1 2.0 nil t a "b" [1] (1))) (index 0))
  (dolist (a values)
    (dolist (b values)
      (dolist (c values)
        (princ (format "PS-MIXED %d " index))
        (prin1 (condition-case problem (sort (list a b c)) (error problem)))
        (terpri)
        (setq index (1+ index))))))
(unless (equal (sort (list 3 1 2) #'<) '(1 2 3))
  (error "sort basic assertion"))
(unless (equal (sort (list '(2 a) '(1 b) '(2 c) '(1 d)) :key #'car)
               '((1 b) (1 d) (2 a) (2 c)))
  (error "sort stability assertion"))
(princ "PRIM-SORT COMPLETE\n")
(kill-emacs 0)
