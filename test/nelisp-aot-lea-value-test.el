(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)

(defun nelisp-aot-lea-test--ref (slot &optional class)
  (nelisp-aot-compiler--make-ir 'ref :slot slot :class (or class 'gp)))
(defun nelisp-aot-lea-test--imm (n)
  (nelisp-aot-compiler--make-ir 'imm :value n))
(defun nelisp-aot-lea-test--op (op a b)
  (nelisp-aot-compiler--make-ir 'arith :op op :a a :b b))

(ert-deftest nelisp-aot-lea-value/profitability-and-preflight ()
  (let* ((nelisp-aot-compiler--arch 'x86_64)
         (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--x86-affine-addresses t)
         (nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (a (nelisp-aot-lea-test--ref 0)) (b (nelisp-aot-lea-test--ref 1))
         (pair (nelisp-aot-lea-test--op '+ a b))
         (offset (nelisp-aot-lea-test--op '+ a (nelisp-aot-lea-test--imm 32)))
         (scaled (nelisp-aot-lea-test--op
                  '+ (nelisp-aot-lea-test--op '* a (nelisp-aot-lea-test--imm 8))
                  (nelisp-aot-lea-test--imm 31))))
    (should-not (nelisp-aot-compiler--x86-affine-value-plan pair))
    (should-not (nelisp-aot-compiler--x86-affine-value-plan offset))
    (should (nelisp-aot-compiler--x86-affine-value-plan scaled))
    (let ((nelisp-aot-compiler--promoted-slots '((0 . r12))))
      (should-not (nelisp-aot-compiler--x86-affine-value-plan offset))
      (should-not (nelisp-aot-compiler--x86-affine-value-plan pair)))
    (let ((nelisp-aot-compiler--promoted-slots '((0 . r12) (1 . r13))))
      (should-not (nelisp-aot-compiler--x86-affine-value-plan pair)))
    (let* ((one (nelisp-aot-lea-test--imm 1))
           (four (nelisp-aot-lea-test--imm 4))
           (mul (nelisp-aot-lea-test--op '+ (nelisp-aot-lea-test--op '* a four) one))
           (shift (nelisp-aot-lea-test--op
                   '+ (nelisp-aot-compiler--make-ir 'shift :op 'shl :a a
                       :b (nelisp-aot-lea-test--imm 2)) one))
           (zero (nelisp-aot-lea-test--imm 0)))
      ;; These guards preserve the existing WORD-construction byte contract;
      ;; LEA would compute the same bits.  Both spellings share a plan.
      (should (equal (nelisp-aot-compiler--x86-affine-address-plan mul zero)
                     (nelisp-aot-compiler--x86-affine-address-plan shift zero)))
      (should-not (nelisp-aot-compiler--x86-affine-value-plan mul))
      (should-not (nelisp-aot-compiler--x86-affine-value-plan shift)))
    (dolist (bad (list (nelisp-aot-lea-test--op '+ pair (nelisp-aot-lea-test--ref 2))
                       (nelisp-aot-lea-test--op '+ a (nelisp-aot-compiler--make-ir 'call :name 'effect))
                       (nelisp-aot-lea-test--op '* (nelisp-aot-lea-test--ref 0 'f64)
                                                  (nelisp-aot-lea-test--imm 8))
                       (nelisp-aot-compiler--make-ir 'shift :op 'shl :a a :b b)))
      (let ((buf (nelisp-asm-x86_64-make-buffer)))
        (should-not (nelisp-aot-compiler--emit-affine-value-x86 bad buf))
        (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))))
    (dolist (mode '(leaf checked lisp scratch scratch-si win64))
      (let ((nelisp-aot-compiler--abi (if (eq mode 'win64) 'win64 'sysv))
            (nelisp-aot-compiler--x86-call-containing-defun-p (not (eq mode 'leaf)))
            (nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (nelisp-aot-compiler--runtime-entry-params (and (eq mode 'lisp) '(x)))
            (nelisp-aot-compiler--promoted-slots
             (pcase mode ('scratch '((9 . rdi))) ('scratch-si '((9 . rsi))))))
        (should-not (nelisp-aot-compiler--x86-affine-value-plan scaled))))))

(defun nelisp-aot-lea-test--signed (n)
  (let ((u (logand n (1- (ash 1 64)))))
    (if (>= u (ash 1 63)) (- u (ash 1 64)) u)))
(defun nelisp-aot-lea-test--run (program)
  (let ((path (make-temp-file "lea-value-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp program path)
               (call-process path nil nil nil))
      (delete-file path))))

(ert-deftest nelisp-aot-lea-value/gnu-native-full-width-and-order ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((count 0))
    (dolist (expr '((+ (* a 8) 31) (+ (+ a (* b 8)) 32)
                    (+ (* (+ a 7) 4) b) (+ a (* a 8))
                    (- (+ a (* b 2)) 17) (+ (* a 9) 127)))
      (dolist (args '((0 1) (-3 7) (1099511627783 -17179869193)
                      (9223372036854775807 -9223372036854775808)))
        (let ((golden (nelisp-aot-lea-test--signed
                       (eval `(let ((a ,(car args)) (b ,(cadr args))) ,expr) t))))
          (should (= 0 (nelisp-aot-lea-test--run
                        `(seq (defun opaque (x) x)
                              (defun f (a b) (opaque 0) ,expr)
                              (exit (if (= (f ,@args) ,golden) 0 1))))))
          (setq count (1+ count)))))
    (should (= 52 (nelisp-aot-lea-test--run
                   '(seq (defun opaque (x) x)
                         (defun f (a)
                           (opaque 0)
                           (+ (seq (setq a (+ a 1)) (* a 8))
                              (seq (setq a (+ a 1)) (* a 4))))
                         (exit (f 3))))))
    (message "LEA value GNU/native full-width cases: %d; effectful fallback:1" count)))

(ert-deftest nelisp-aot-lea-value/memory-tree-register-clobbers ()
  "LEA scratch preserves sibling RAX/R10/R11 values in a register tree."
  (dolist (args '((3 7) (-3 -7) (1099511627783 -17179869193)
                  (9223372036854775807 -9223372036854775808)))
    (let* ((a (car args)) (b (cadr args)) (word -81985529216486896)
           (golden (nelisp-aot-lea-test--signed
                    (+ (+ word (+ (* a 8) 31))
                       (+ (+ (* b 8) 7) (+ (* a 2) 9))))))
      (should (= 0 (nelisp-aot-lea-test--run
                    `(seq (defun opaque (x) x)
                          (defun f (p a b)
                            (opaque 0)
                            (+ (+ (ptr-read-u64 p 0) (+ (* a 8) 31))
                               (+ (+ (* b 8) 7) (+ (* a 2) 9))))
                          (defun run ()
                            (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                              (ptr-write-u64 p 0 ,word)
                              (if (= (f p ,a ,b) ,golden) 0 1)))
                          (exit (run)))))))))

(defvar nelisp-aot-lea-test--owner nil)
(ert-deftest nelisp-aot-lea-value/source-multiply-add-selection ()
  "The source-level missed opportunity must use LEA and remove IMUL."
  (let ((emit (symbol-function 'nelisp-aot-compiler--emit-defun))
        (op (symbol-function 'nelisp-aot-compiler--x86-op))
        (imul (symbol-function 'nelisp-aot-compiler--x86-imul))
        (lea-count 0) (imul-count 0))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-defun)
               (lambda (node buf)
                 (let ((nelisp-aot-lea-test--owner
                        (nelisp-aot-compiler--ir-get node :name)))
                   (funcall emit node buf))))
              ((symbol-function 'nelisp-aot-compiler--x86-op)
               (lambda (buf w opcode reg rm &rest rest)
                 (when (and (eq nelisp-aot-lea-test--owner 'f)
                            (equal opcode (unibyte-string #x8D)))
                   (setq lea-count (1+ lea-count)))
                 (apply op buf w opcode reg rm rest)))
              ((symbol-function 'nelisp-aot-compiler--x86-imul)
               (lambda (&rest args)
                 (when (eq nelisp-aot-lea-test--owner 'f)
                   (setq imul-count (1+ imul-count)))
                 (apply imul args))))
      (should (= 47 (nelisp-aot-lea-test--run
                     '(seq (defun opaque (x) x)
                           (defun f (n) (opaque 0) (+ (* n 8) 31))
                           (exit (f 2)))))))
    (message "Source affine value emission: LEA %d, IMUL %d" lea-count imul-count)
    (should (> lea-count 0))
    (should (= imul-count 0))))

(ert-deftest nelisp-aot-lea-value/checked-overflow-fallback ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((nelisp-aot-compiler--checked-arith t))
    (should (= 47 (nelisp-aot-lea-test--run
                   '(seq (defun opaque (x) x)
                         (defun f (n) (opaque 0) (+ (* n 8) 31))
                         (exit (f 2))))))
    (should (= 97 (nelisp-aot-lea-test--run
                   '(seq (defun opaque (x) x)
                         (defun f (n) (opaque 0) (+ (* n 8) 31))
                         (exit (f 288230376151711743))))))))

(provide 'nelisp-aot-lea-value-test)
