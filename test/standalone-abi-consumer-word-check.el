;;; standalone-abi-consumer-word-check.el --- Consumer WORD regression cases -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later

(let ((checked 0) (table (make-hash-table :test 'equal)))
  (dolist (value (list nil t 0 -7 "value" '(a . b) [nil t 0] (make-symbol "value")))
    (unless (eq (puthash "key" value table) value) (error "puthash return changed"))
    (unless (eq (gethash "key" table 'missing) value) (error "hash value changed"))
    (setq checked (+ checked 2)))
  (dotimes (i 100) (puthash i (- i 50) table))
  (dotimes (i 100)
    (unless (= (gethash i table) (- i 50)) (error "hash growth lost key %d" i)))
  (setq checked (1+ checked))
  (dolist (form '((nthcdr 0 0) (nthcdr 0 nil) (nthcdr 0 t) (nthcdr 0 -7)
                  (nthcdr 1 '(a . 0)) (nthcdr 2 '(a b . -7))
                  (nthcdr 10 '(a b)) (nthcdr -1 'identity)
                  (last 0) (last nil) (last t) (last -7)
                  (last '(a b c) 2) (last '(a b c) 0)
                  (butlast '(nil t 0 -7) 0) (butlast '(nil t 0 -7) 2)
                  (butlast nil 0) (butlast '(a b) 10)
                  (plist-member '(a 0 b nil c t) 'b)
                  (plist-member '(a 0 b nil) 'missing)
                  (mapcar '1+ [0 1 -2]) (mapcar '1+ "ab")
                  (assoc 'b '((a . nil) (b . 0)))
                  (plist-get '(a 0 b nil c t) 'c)
                  (= 0 0 -0) (< -9 -7 0) (<= 0 0 1)
                  (> 3 2 1) (>= 3 3 2) (/= 1 2) (/= 1 1)
                  (= 1 'bad)))
    (princ (format "ABI-CONSUMER %S\n"
                   (condition-case e (eval form) (error (car e)))))
    (setq checked (1+ checked)))
  (dolist (function '(string-as-unibyte string-to-unibyte
                      string-as-multibyte string-to-multibyte))
    (let ((value (funcall function "ASCII")))
      (unless (equal value "ASCII") (error "string conversion changed: %S" function))
      (garbage-collect)
      (unless (equal value "ASCII") (error "converted string lost after GC"))
      (setq checked (1+ checked))))
  (let ((parent (make-char-table nil nil)) (child (make-char-table nil 0)))
    (unless (eq (set-char-table-parent child parent) parent) (error "parent return changed"))
    (unless (null (set-char-table-parent child nil)) (error "nil parent return changed"))
    (setq checked (+ checked 2)))
  (princ (format "ABI-CONSUMER checked=%d PASS\n" checked)))
