;;; nelisp-native-application-protocol-test.el --- Pure data differential -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-native-application-protocol)
;; Host-only oracle imports remain in the tests, never in the producer.
(require 'nelisp-native-application-build)

(defconst nnap-protocol-cases
  '(("empty" . "") ("ascii-trivia" . " \t\n\f")
    ("comment-eof" . "; comment") ("comment-line" . "; comment\n1")
    ("comment-cr" . "; comment\r1") ("comment-unicode" . "; comment\u20281")
    ("comments-between" . "(a) ; comment\n [1 \"x\"]")
    ("crlf" . "(a)\r\n(b)") ("cr-eof" . "(a)\r")
    ("vertical-tab" . "\v1") ("form-feed" . "\f1")
    ("nbsp" . "\u00a01\u00a0") ("u2000" . "\u20001\u2000")
    ("u200b" . "\u200b1\u200b") ("u3000" . "\u30001\u3000")
    ("u0085" . "\u00851") ("u1680" . "\u16801") ("bom" . "\ufeff1")
    ("non-ascii" . "(猫 \"雪\" ?猫)")
    ("escaped" . "(a\\ b \"quote\\\" slash\\\\ newline\\n\" ?\\n)")
    ("quoted" . "'(a . b) `[,x ,@y]")
    ("no-evaluation" . "(progn (setq nnap-protocol-sentinel t) 1)")
    ("eval-dispatch" . "#.(setq nnap-protocol-sentinel t)")
    ("vector-dot" . "[(a . b) :key nil t -17 3.25]")
    ("quote-eof" . "'") ("list-eof" . "(a")
    ("vector-eof" . "[1") ("string-eof" . "\"abc")
    ("trailing-token" . "(a) )") ("dispatch" . "#z")
    ("circle" . "#1=(a . #1#)") ("shared" . "(#1=(a) #1#)")
    ("shorthand" . "(short-name)")
    ("lexical" . ";;; -*- lexical-binding: t; -*-\n(defun a (x) (+ x 1))")
    ("duplicate-header" . ";;; -*- lexical-binding: t; -*-\n; lexical-binding: nil\n1")
    ("header-nil" . ";;; -*- lexical-binding: nil; -*-\n1")
    ("header-extra" . ";;; -*- lexical-binding: t; other: t; -*-\n1")))

(defun nnap-protocol-outcome (reader text)
  (condition-case failure
      (let ((forms (funcall reader (encode-coding-string text 'utf-8-unix))))
        (list :ok (nelisp-native-application-protocol-print forms)
              :hash (nelisp-native-application-protocol-digest forms)))
    (error (list :error (car failure)))))

(ert-deftest nnap-protocol-differential-fixed-corpus ()
  (let ((read-circle t) (read-symbol-shorthands '(("short-" . "expanded-"))))
    (dolist (entry nnap-protocol-cases)
      (should (equal (nnap-protocol-outcome #'nelisp-cc-fxir-admission--forms (cdr entry))
                     (nnap-protocol-outcome #'nelisp-native-application-protocol-forms (cdr entry))))
      (should (equal (and (nelisp-native-application-build--lexical-header-p (cdr entry)) t)
                     (and (nelisp-native-application-protocol-lexical-header-p (cdr entry)) t))))))

(ert-deftest nnap-protocol-real-source-canonical-parity ()
  (skip-unless (and (getenv "LOADER_E")
                    (file-exists-p (expand-file-name "../final-inputs/package/source-package.el"
                                                     (getenv "LOADER_E")))))
  (let ((root (getenv "LOADER_E")))
    (dolist (relative '("../final-inputs/package/source-package.el"
                        "../final-inputs/host-source-inputs/application-manifest.sexp"
                        "../final-inputs/host-source-inputs/names.txt"))
      (let* ((path (expand-file-name relative root))
             (bytes (nelisp-native-application-protocol-bytes path))
             (old (nelisp-cc-fxir-admission--forms bytes))
             (new (nelisp-native-application-protocol-forms bytes)))
        (should (equal (nelisp-cc-fxir-admission--print old)
                       (nelisp-native-application-protocol-print new)))
        (should (equal (nelisp-cc-fxir-admission--digest old)
                       (nelisp-native-application-protocol-digest new)))))))

(ert-deftest nnap-protocol-byte-bounds-alias-growth ()
  (let* ((dir (make-temp-file "nnap-protocol-" t))
         (file (expand-file-name "source" dir))
         (link (expand-file-name "alias" dir))
         (original (symbol-function 'insert-file-contents-literally))
         (reads 0))
    (unwind-protect
        (progn
          (with-temp-file file (insert "abc"))
          (should (equal (nelisp-native-application-protocol-bytes file 3) "abc"))
          (make-symbolic-link file link)
          (should-error (nelisp-native-application-protocol-bytes link))
          (cl-letf (((symbol-function 'insert-file-contents-literally)
                     (lambda (&rest args) (setq reads (1+ reads)) (apply original args))))
            (should-error (nelisp-native-application-protocol-bytes file 2)))
          (should (= reads 0))
          (cl-letf (((symbol-function 'insert-file-contents-literally)
                     (lambda (&rest args)
                       (prog1 (apply original args)
                         (let ((buffer-file-name nil))
                           (write-region "grow" nil file t 'silent))))))
            (should-error (nelisp-native-application-protocol-bytes file 3))))
      (delete-directory dir t))))

(provide 'nelisp-native-application-protocol-test)
