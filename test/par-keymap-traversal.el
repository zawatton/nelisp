;;; par-keymap-traversal.el --- Public keymap traversal -*- lexical-binding: t; -*-

(let ((map (make-keymap))
      (parent (make-sparse-keymap))
      direct all)
  (define-key map [(260 . 263)] 'range-one)
  (define-key map [(270 . 273)] 'range-two)
  (define-key map [265] nil)
  (define-key parent [266] 'parent)
  (set-keymap-parent map parent)
  (prin1 (eq (map-keymap-internal
              (lambda (event binding) (push (cons event binding) direct))
              map)
             parent))
  (terpri)
  (map-keymap (lambda (event binding) (push (cons event binding) all)) map)
  (prin1 (list (nreverse direct) (nreverse all)))
  (terpri)
  (substitute-key-definition 'range-one 'replaced map)
  (prin1 (list (lookup-key map [260]) (lookup-key map [263])
               (lookup-key map [270]) (lookup-key map [266])))
  (terpri))

(let ((map (make-sparse-keymap)) sorted)
  (define-key map [1] 'old)
  (define-key map [3] '(menu-item "Action" old))
  (define-key map [2 4] 'old)
  (substitute-key-definition 'old 'new map)
  (map-keymap (lambda (event _) (push event sorted)) map t)
  (prin1 (list (nreverse sorted) (lookup-key map [1])
               (lookup-key map [3]) (lookup-key map [2 4])))
  (terpri))

(prin1 (list (key-description [134217737])
             (key-description [(260 . 263)])
             (key-description [(control ?a)])
             (key-description [C-a])
             (key-description [9] [27 27])
             (let ((meta-prefix-char 29))
               (key-description [?x] [29]))))
(terpri)

(let ((map (make-sparse-keymap))
      (esc (make-sparse-keymap))
      (prefix (make-sparse-keymap))
      (menu (make-sparse-keymap)))
  (define-key map [27] esc)
  (define-key esc [?x] prefix)
  (define-key prefix [?x] esc)
  (define-key map [a] (list 'menu-item "Menu" menu))
  (define-key map [b] prefix)
  (prin1 (list (mapcar #'car (accessible-keymaps map))
               (mapcar #'car (accessible-keymaps map [27]))
               (mapcar #'car (accessible-keymaps map [a]))
               (accessible-keymaps map [missing])))
  (terpri))

(let* ((parent (make-sparse-keymap))
       (map (cons 'keymap parent)))
  (define-key parent [a] 'original)
  (prin1 (list (eq (keymap-parent map) parent)
               (lookup-key map [a])
               (progn (define-key map [a] 'override) (lookup-key parent [a]))
               (lookup-key map [a])
               (progn (set-keymap-parent map nil) (keymap-parent map))
               (lookup-key map [a])))
  (terpri))

(let ((meta-prefix-char 29)
      (map (make-sparse-keymap)))
  (define-key map [134217848] 'metized)
  (prin1 (list (lookup-key map [29 ?x])
               (lookup-key map [134217848])
               (lookup-key map (unibyte-string 248))))
  (terpri))

(let* ((parent (make-sparse-keymap))
       (marked (make-sparse-keymap))
       (spliced (cons 'keymap parent))
       (dotted '(keymap . par-keymap-parent-symbol)))
  (define-key parent [prefix child] 'from-parent)
  (set-keymap-parent marked parent)
  (fset 'par-keymap-parent-symbol parent)
  (unwind-protect
      (prin1 (mapcar (lambda (map) (lookup-key map [prefix child]))
                     (list marked spliced dotted)))
    (fmakunbound 'par-keymap-parent-symbol))
  (terpri))

(let ((child (make-sparse-keymap)) direct all)
  (define-key child [child-event] 'child-command)
  (fset 'par-keymap-composed-symbol child)
  (unwind-protect
      (let ((map (make-composed-keymap 'par-keymap-composed-symbol)))
        (define-key map [own-event] 'own-command)
        (map-keymap-internal (lambda (key _) (push key direct)) map)
        (map-keymap (lambda (key _) (push key all)) map)
        (prin1 (list (nreverse direct) (nreverse all))))
    (fmakunbound 'par-keymap-composed-symbol))
  (terpri))

(let* ((map (copy-keymap global-map))
       (initial (lookup-key map [400]))
       (prefix (make-sparse-keymap)))
  (define-key prefix [probe] 'original)
  (define-key map [400] prefix)
  (let ((copy (copy-keymap map)))
    (define-key copy [400 probe] 'copy-only)
    (prin1 (list initial (lookup-key global-map [400])
                 (char-table-subtype (cadr copy))
                 (lookup-key map [400 probe])
                 (lookup-key copy [400 probe]))))
  (terpri))

(let* ((dense (vector nil 'old 'old))
       (map (list 'keymap dense))
       (parent (make-sparse-keymap))
       (sparse (make-sparse-keymap)))
  (define-key parent [0] 'parent)
  (set-keymap-parent map parent)
  (define-key sparse [2] 'old)
  (define-key sparse [(2 . 2)] 'single)
  (define-key map [(1 . 2)] 'local)
  (define-key map [(2 . 4)] 'range)
  (let ((copy (copy-keymap map)))
    (define-key copy [1] 'copy-only)
    (prin1 (list sparse dense (lookup-key map [0]) (lookup-key map [4])
                 (lookup-key copy [1]) (lookup-key map [1]))))
  (terpri))

(let ((map (make-sparse-keymap)))
  (define-key map ["C-c C-a"] 'described)
  (define-key map [2] 'numeric)
  (prin1 (list (lookup-key map [3 1]) (lookup-key map ["C-c C-a"])
               (lookup-key map ["C-b"])))
  (terpri))
