;;; nelisp-fxlet-adoption-test.el --- Actual generated adoption arms -*- lexical-binding: t; -*-
(require 'nelisp-fxlet-unwind-test)

(defun fxlet-adopt--arm (test)
  (cl-labels ((walk (node)
                (when (consp node)
                  (if (equal (car-safe (cdr node)) test) (nth 2 node)
                    (or (walk (car node)) (walk (cdr node)))))))
    (or (walk (cl-find 'm5_fx_run_body nelisp-standalone--applyfn-m5-helpers :key #'cadr))
        (error "Missing actual fx arm %S" test))))

(defun fxlet-adopt--opcode ()
  (eval `(lambda (state)
           (let ((env 0) (aux (aref state 0)) (nb (aref state 1))
                 (sp 1) (status 0) (pc 0) (base 0) (stk 5000) (a 0) (r 0))
             (cl-macrolet ((seq (&rest forms) (cons 'progn forms)))
               ,(fxlet-adopt--arm '(= op 20)))
             (vector aux nb sp status pc))) t))

(defmacro fxlet-adopt--fixture (&rest body)
  `(let ((memory (make-hash-table :test #'eql)) (depth 10)
         (allocations 0) (attempts 0) (events 0) (binds 0)
         (reserve-fails nil) (bind-fails nil) (restricted nil) (callback nil)
         (adoption-depth nil) (opcode (fxlet-adopt--opcode)))
     (puthash 8 2006 memory)
     (puthash 2000 260 memory)
     (puthash 5000 99 memory)
     (cl-letf (((symbol-function 'heap-read-u64) (lambda (p off) (gethash (+ p off) memory 3)))
               ((symbol-function 'ptr-read-u64)
                (lambda (p off) (when (= p 0) (error "Null AUX dereference"))
                  (gethash (+ p off) memory 3)))
               ((symbol-function 'm5_fx_lean_candidate)
                (fxlet-test--generated 'm5_fx_lean_candidate t))
               ((symbol-function 'nl_n4_state) (lambda (_) 7000))
               ((symbol-function 'wf_bytecode_aux_new)
                (lambda (&rest _) (cl-incf allocations) (setq adoption-depth depth)
                  (if reserve-fails 0 1000)))
               ((symbol-function 'wf_bytecode_w_lean_bind)
                (lambda (_env name value aux)
                  (cl-incf attempts)
                  (should (= value (gethash 5000 memory)))
                  (should (= aux 1000))
                  (if (and (= (gethash (- name 6) memory) 4) (not restricted)) 0 1)))
               ((symbol-function 'wf_bytecode_varbind)
                (lambda (_env _name value)
                  (cl-incf binds)
                  (should (= value (gethash 5000 memory)))
                  (when callback (funcall callback))
                  (if bind-fails 7 (cl-incf depth) 0)))
               ((symbol-function 'm5_fx_general_event) (lambda (env _) (should (= env 0)) (cl-incf events) 0))
               ((symbol-function 'm5_fx_unbind) (fxlet-test--generated 'm5_fx_unbind))
               ((symbol-function 'wf_bytecode_w_int) (lambda (v) (ash v -2)))
               ((symbol-function 'wf_bytecode_unbind)
                (lambda (_frames n) (cl-decf depth n) 0)))
       ,@body)))

(ert-deftest fxlet-adoption-declined-only-bypasses-lean-and-events ()
  (fxlet-adopt--fixture
   (let ((state (vector 0 0)))
     (dotimes (_ 25) (setq state (funcall opcode state)))
     (should (= (aref state 0) 0))
     (should (= (aref state 1) 25))
     (should (= depth 35))
     (should (= allocations 0))
     (should (= attempts 0))
     (should (= events 0))
     (should (= (funcall (fxlet-test--generated 'm5_fx_unbind) 0 0 25 25) 0))
     (should (= depth 10)))))

(ert-deftest fxlet-adoption-general-prefix-waits-for-zero-bindings ()
  (fxlet-adopt--fixture
   (let ((state (funcall opcode [0 0])))
     (puthash 2000 4 memory)
     (setq state (funcall opcode state))
     (should (= allocations 0))
     (should (= attempts 0))
     (should (= depth 12))
     (funcall (fxlet-test--generated 'm5_fx_unbind) 0 0 1 2)
     (setq state (vector 0 1))
     (setq state (funcall opcode state))
     (should (= allocations 0))
     (funcall (fxlet-test--generated 'm5_fx_unbind) 0 0 2 2)
     (should (= depth 10))
     (setq state (funcall opcode [0 0]))
     (should (= (aref state 0) 1000))
     (should (= (aref state 1) 1))
     (should (= adoption-depth 10))
     (should (= attempts 1)))))

(ert-deftest fxlet-adoption-reserve-and-bind-failure-do-not-commit ()
  (fxlet-adopt--fixture
   (setq bind-fails t)
   (should (equal (funcall opcode [0 0]) [0 0 1 7 0]))
   (setq bind-fails nil)
   (puthash 2000 4 memory)
   (setq reserve-fails t)
   (should (equal (funcall opcode [0 0]) [0 0 1 -4 0]))
   (should (= depth 10))
   (should (= attempts 0))
   (should (= events 0))))

(ert-deftest fxlet-adoption-sticky-and-authoritative-mutable-restrictions ()
  (fxlet-adopt--fixture
   (puthash 2000 4 memory)
   ;; A necessary guard is allowed to adopt before the full binder declines
   ;; current watcher/thread/value restrictions. It never authorizes a store.
   (setq restricted t)
   (let ((state (funcall opcode [0 0])))
     (should (= allocations 1))
     (should (= attempts 1))
     (should (= events 1))
     (should (= depth 11))
     (puthash 2000 260 memory)
     (setq state (funcall opcode (vector (aref state 0) 0)))
     (should (= allocations 1))
     (should (= attempts 2))
     (should (= events 2)))))

(ert-deftest fxlet-adoption-current-header-and-rooted-callback-value ()
  (fxlet-adopt--fixture
   (setq callback (lambda ()
                     ;; A callback may collect/reenter; the operand is still
                     ;; present and no adoption state has been published.
                     (should (= (gethash 5000 memory) 99))
                     (should (= allocations 0))))
   (should (equal (funcall opcode [0 0]) [0 1 0 0 2]))
   (puthash 2000 4 memory)
   (should (= (aref (funcall opcode [0 0]) 0) 1000))))

(ert-deftest fxlet-adoption-shared-owner-normal-handler-final-general-unwind ()
  (fxlet-adopt--fixture
   ;; Execute actual generated opcode21, handler-landing restoration and final
   ;; unwind expressions. Each reaches the same AUX=0 owner without a read.
   (let ((normal (eval `(lambda ()
                         (let ((env 0) (aux 0) (nb 3) (n 0) (base 0) (pc 0))
                           (cl-macrolet ((seq (&rest f) (cons 'progn f)))
                             ,(fxlet-adopt--arm '(= op 21)))
                           nb)) t))
         (handler (eval `(lambda ()
                          (let ((env 0) (aux 0) (nb 3) (snb 1))
                            (cl-macrolet ((seq (&rest f) (cons 'progn f)))
                              ,(fxlet-adopt--arm '(> nb snb)))
                            nb)) t))
         (final (eval `(lambda ()
                        (let ((env 0) (aux 0) (nb 3))
                          ,(fxlet-adopt--arm '(> nb 0)))) t)))
     (setq depth 13)
     (puthash 8 5 memory)
     (should (= (funcall normal) 2))
     (should (= depth 12))
     (setq depth 13)
     (should (= (funcall handler) 1))
     (should (= depth 11))
     (setq depth 13)
     (should (= (funcall final) 0))
     (should (= depth 10)))))

(ert-deftest fxlet-adoption-guard-current-name-state-and-no-invalid-read ()
  (fxlet-adopt--fixture
   (let ((guard (fxlet-test--generated 'm5_fx_lean_candidate)))
     (should (= (funcall guard 3) 0))
     (dolist (header '(260 516 1028))
       (puthash 2000 header memory)
       (should (= (funcall guard 2006) 0)))
     (puthash 2000 4 memory)
     (should (= (funcall guard 2006) 1))
     (should (= allocations 0))
     (should (= attempts 0)))))

(ert-deftest fxlet-adoption-reentrant-activation-does-not-adopt-outer-prefix ()
  (fxlet-adopt--fixture
   (setq callback
         (lambda ()
           (should (= (gethash 5000 memory) 99))
           (garbage-collect)
           (puthash 2000 4 memory)
           (should (equal (funcall opcode [0 0]) [1000 1 0 0 2]))
           (puthash 2000 260 memory)))
   (let ((outer (funcall opcode [0 0])))
     (should (equal outer [0 1 0 0 2]))
     (should (= depth 11))
     (should (= adoption-depth 10))
     (m5_fx_unbind 0 0 1 1)
     (should (= depth 10)))))

(provide 'nelisp-fxlet-adoption-test)
