;;; nelisp-standalone-cold-release-test.el --- dead unit release -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(defvar nelisp-cold-release-test--output "output"
  "Output path the stage doubles hand to the builder.
The builder writes `OUT.version.json' (201a731b6) and hashes OUT, so the
test points it at a real file in a scratch directory.")

(defun nelisp-cold-release-test--run (owner)
  "Run OWNER with host-only stage doubles and a weak unit graph witness."
  (let ((witness (make-hash-table :test #'eq :weakness 'key)) events retained)
    (cl-letf (((symbol-function 'nelisp-standalone--validate-reader-registrations) #'ignore)
              ((symbol-function 'nelisp-standalone--reader-units)
               (lambda () (let ((unit (list :sentinel 'unit)))
                            (puthash unit t witness) (list unit))))
              ((symbol-function 'nelisp-standalone--output-path) (lambda (_) nelisp-cold-release-test--output))
              ((symbol-function 'nelisp-standalone-arena-rewrite-target) (lambda () 'linux-x86_64))
              ((symbol-function 'nelisp-link-units)
               (lambda (out units &rest _)
                 (push (list 'link out (length units) (caar units)) events)))
              ((symbol-function 'set-file-modes) (lambda (out mode) (push (list 'mode out mode) events)))
              ((symbol-function 'nelisp-standalone--reader-src) (lambda () 'source))
              ((symbol-function 'nelisp-standalone--stamp-build-digest)
               (lambda (out) (push (list 'stamp out) events) "digest"))
              ((symbol-function 'nelisp-standalone--build-cold-image)
               (lambda (out)
                 (setq retained (hash-table-count witness))
                 (push (list 'cold out) events)))
              ((symbol-function 'nelisp-standalone--build-substrate-image)
               (lambda (out) (push (list 'boot-image out) events)))
              ((symbol-function 'nelisp-standalone-build-artifact-runtime-cache)
               (lambda () (push '(artifact) events))))
      (list (funcall owner) (nreverse events) retained))))

(ert-deftest nelisp-cold-release/dead-units-and-unchanged-stages ()
  (let* ((file (or (getenv "NELISP_COLD_RELEASE_BUILDER")
                   (expand-file-name "../scripts/nelisp-standalone-build.el"
                                     (file-name-directory (or load-file-name buffer-file-name
                                                             (locate-library "nelisp-standalone-cold-release-test")))))))
    (load file nil t t)
    (let (definition (removed 0))
      (with-temp-buffer
        (insert-file-contents file)
        (goto-char (point-min))
        (condition-case nil
            (while (not definition)
              (let ((form (read (current-buffer))))
                (when (and (eq (car-safe form) 'defun)
                           (eq (cadr form) 'nelisp-standalone-build-reader))
                  (setq definition form))))
          (end-of-file (ert-fail "Missing builder definition"))))
      (cl-labels ((baseline (form)
                    (if (consp form)
                        (let (result)
                          (dolist (item form (nreverse result))
                            (if (member item '((setq units nil) (garbage-collect)))
                                (setq removed (1+ removed))
                              (push (baseline item) result))))
                      form)))
        (let* ((old (eval (cons 'lambda (cons (nth 2 definition)
                                            (baseline (nthcdr 3 definition)))) t))
               (process-environment (copy-sequence process-environment))
               (scratch (make-temp-file "nelisp-cold-release-" t))
               (nelisp-cold-release-test--output
                (expand-file-name "output" scratch))
               (old-result nil) (new-result nil))
          (with-temp-file nelisp-cold-release-test--output (insert "stub"))
          (setenv "NELISP_READER_DYNAMIC" nil)
          (setenv "NELISP_STANDALONE_BUILD_TRACE" nil)
          (should (= removed 2))
          (setq old-result (nelisp-cold-release-test--run old)
                new-result (nelisp-cold-release-test--run #'nelisp-standalone-build-reader))
          (should (equal (butlast old-result) (butlast new-result)))
          (should (= (nth 2 old-result) 1))
          (should (= (nth 2 new-result) 0))
          (delete-directory scratch t))))))

(provide 'nelisp-standalone-cold-release-test)
