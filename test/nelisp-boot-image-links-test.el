;;; nelisp-boot-image-links-test.el --- Companion inode boundary -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-standalone-build)

(defun nelisp-boot-links-test--host (form)
  "Translate emitted production DSL, retaining its numeric-zero branches."
  (if (atom form) form
    (pcase (car form)
      ('if `(if (let ((value ,(nelisp-boot-links-test--host (nth 1 form))))
                   (if (numberp value) (/= value 0) value))
                ,(nelisp-boot-links-test--host (nth 2 form))
              ,(nelisp-boot-links-test--host (nth 3 form))))
      ('seq `(progn ,@(mapcar #'nelisp-boot-links-test--host (cdr form))))
      ('extern-call `(nelisp-boot-links-test--extern ',(cadr form)
                       ,@(mapcar #'nelisp-boot-links-test--host (cddr form))))
      (_ (mapcar #'nelisp-boot-links-test--host form)))))

(defun nelisp-boot-links-test--function (forms name)
  (let ((definition (cl-find name forms :key #'cadr)))
    (unless definition (error "Missing production helper %s" name))
    (eval `(lambda ,(nth 2 definition)
             ,@(mapcar #'nelisp-boot-links-test--host (nthcdr 3 definition))) t)))

(defun nelisp-boot-links-test--linux (target changes)
  "Run actual emitted discovery/pinning/release with controlled OS results."
  (let* ((nelisp-standalone--target target)
         (forms (nelisp-boot-image-native-forms))
         (pin (nelisp-boot-links-test--function forms 'nl_boot_image_pin))
         (open (nelisp-boot-links-test--function forms 'nl_boot_image_open))
         (release (nelisp-boot-links-test--function forms 'nl_boot_image_release))
         (arm (eq target 'linux-aarch64))
         (settings (append changes '(:links 2 :mode 33188 :exe-uid 1000 :image-uid 1000
                                    :exe-open 10 :image-open 11 :exe-stat 0 :image-stat 0)))
         (memory (make-hash-table :test #'equal)) closed freed calls token)
    (cl-labels ((read-memory (ptr offset)
                  (cond ((and (= ptr 5384) (= offset (if arm 16 24))) (plist-get settings :mode))
                        ((and (= ptr 5384) (= offset (if arm 20 16))) (plist-get settings :links))
                        ((and (= ptr 5384) (= offset (if arm 24 28))) (plist-get settings :image-uid))
                        ((and (= ptr 5128) (= offset (if arm 24 28))) (plist-get settings :exe-uid))
                        ((gethash (cons ptr offset) memory))
                        (t (error "Unexpected memory read %s+%s" ptr offset)))))
      (cl-letf (((symbol-function 'nl_os_open_read) (lambda (_) (plist-get settings :exe-open)))
                ((symbol-function 'nl_boot_image_open) open)
                ((symbol-function 'syscall-direct)
                 (lambda (opcode &rest args)
                   (push (cons opcode args) calls)
                   (if (= opcode (if arm 80 5))
                       (plist-get settings (if (= (car args) 10) :exe-stat :image-stat))
                     (should (= opcode (if arm 56 2)))
                     (should (= (nth (if arm 2 1) args) 655360))
                     (plist-get settings :image-open))))
                ((symbol-function 'heap-read-u32) #'read-memory)
                ((symbol-function 'heap-read-u64) #'read-memory)
                ((symbol-function 'ptr-write-u64)
                 (lambda (ptr offset value) (puthash (cons ptr offset) value memory)))
                ((symbol-function 'ptr-write-u8) (lambda (&rest _) 0))
                ((symbol-function 'nl_boot_image_decimal) (lambda (&rest _) 2))
                ((symbol-function 'nl_os_close_handle) (lambda (fd) (push fd closed) 0))
                ((symbol-function 'nl_os_free_chunk) (lambda (ptr bytes) (push (list ptr bytes) freed) 0)))
        (setq token (funcall pin 1000 2000))
        (when (/= token 0)
          (should (= token 5672))
          (should (equal closed '(10)))
          (should-not freed)
          (should (= (gethash '(1000 . 4640) memory) 11))
          (funcall release token))))
    (list :token token :closed (reverse closed) :freed freed :calls calls)))

(ert-deftest nelisp-boot-links-linux-positive-and-zero ()
  (dolist (target '(linux-x86_64 linux-aarch64))
    (dolist (links '(0 1 2 7))
      (let ((result (nelisp-boot-links-test--linux target (list :links links))))
        (should (eq (= links 0) (= (plist-get result :token) 0)))
        (should (equal (plist-get result :closed) '(10 11)))
        (should (equal (plist-get result :freed) '((1000 8192))))))))

(ert-deftest nelisp-boot-links-linux-rejection-controls ()
  (dolist (target '(linux-x86_64 linux-aarch64))
    (dolist (changes '((:image-uid 1001) (:mode 33204) (:mode 33190)
                       (:mode 16877) (:mode 41471) (:image-open -1)
                       (:exe-open -1) (:exe-stat -1) (:image-stat -1)))
      ;; A symlink fails O_NOFOLLOW at open; a symlink mode is also rejected.
      (let ((result (nelisp-boot-links-test--linux target changes)))
        (should (= (plist-get result :token) 0))
        (should (equal (plist-get result :freed) '((1000 8192))))))))

(defun nelisp-boot-links-test--windows (changes)
  (let* ((forms (nelisp-boot-image--windows-native-forms))
         (valid (nelisp-boot-links-test--function forms 'nl_boot_image_windows_valid))
         (companion (nelisp-boot-links-test--function forms 'nl_boot_image_companion))
         (release (nelisp-boot-links-test--function forms 'nl_boot_image_release))
         (settings (append changes '(:links 2 :attributes 0 :type 1 :metadata 1
                                    :exe-security 1 :image-security 1 :exe-owner 1 :image-owner 1
                                    :exe-sid 3000 :image-sid 3000 :equal-sid 1
                                    :exe-open 10 :image-open 11)))
         (memory (make-hash-table :test #'equal)) closed freed calls opens token)
    (cl-letf (((symbol-function 'nelisp-boot-links-test--extern)
               (lambda (api &rest args)
                 (push (cons api args) calls)
                 (pcase api
                   ('GetModuleFileNameW 10)
                   ('CreateFileW
                    (setq opens (1+ (or opens 0)))
                    (plist-get settings (if (= opens 1) :exe-open :image-open)))
                   ('GetFileType (plist-get settings :type))
                   ('GetFileInformationByHandle (plist-get settings :metadata))
                   ('GetKernelObjectSecurity
                    (plist-get settings (if (= (car args) 10) :exe-security :image-security)))
                   ('GetSecurityDescriptorOwner
                    (plist-get settings (if (= (car args) 66600) :exe-owner :image-owner)))
                   ('EqualSid (plist-get settings :equal-sid))
                   (_ (error "Unexpected Win32 call %s" api)))))
              ((symbol-function 'heap-read-u32)
               (lambda (ptr offset)
                 (should (= ptr 66536))
                 (pcase offset (0 (plist-get settings :attributes))
                   (40 (plist-get settings :links)) (_ (error "Unexpected stat offset")))))
              ((symbol-function 'heap-read-u64)
               (lambda (ptr offset)
                 (cond ((= ptr 68656) (plist-get settings :exe-sid))
                       ((= ptr 68664) (plist-get settings :image-sid))
                       ((gethash (cons ptr offset) memory))
                       (t (error "Unexpected pointer read %s+%s" ptr offset)))))
              ((symbol-function 'ptr-write-u16) (lambda (&rest _) 0))
              ((symbol-function 'ptr-write-u64)
               (lambda (ptr offset value) (puthash (cons ptr offset) value memory)))
              ((symbol-function 'nl_boot_image_windows_valid) valid)
              ((symbol-function 'nl_os_alloc_chunk) (lambda (_) 1000))
              ((symbol-function 'nl_os_close_handle) (lambda (fd) (push fd closed) 0))
              ((symbol-function 'nl_os_free_chunk) (lambda (ptr bytes) (push (list ptr bytes) freed) 0)))
      (setq token (funcall companion))
      (when (/= token 0)
        (should (= token -1000))
        (should (equal closed '(10)))
        (should-not freed)
        (should (= (gethash '(1000 . 67680) memory) 11))
        (funcall release token)))
    (list :token token :closed (reverse closed) :freed freed :calls (reverse calls))))

(ert-deftest nelisp-boot-links-windows-positive-and-zero ()
  (dolist (links '(0 1 2 7))
    (let ((result (nelisp-boot-links-test--windows (list :links links))))
      (should (eq (= links 0) (= (plist-get result :token) 0)))
      (should (equal (plist-get result :closed) '(10 11)))
      (should (equal (plist-get result :freed) '((1000 73728)))))))

(ert-deftest nelisp-boot-links-windows-rejection-controls ()
  (dolist (changes '((:metadata 0) (:exe-security 0) (:image-security 0)
                     (:exe-owner 0) (:image-owner 0) (:exe-sid 0) (:image-sid 0)
                     (:equal-sid 0) (:type 2) (:attributes 16) (:attributes 1024)
                     (:exe-open -1) (:image-open -1)))
    (let ((result (nelisp-boot-links-test--windows changes)))
      (should (= (plist-get result :token) 0))
      (should (equal (plist-get result :freed) '((1000 73728)))))))

(ert-deftest nelisp-boot-links-windows-retains-sharing-and-reparse-flags ()
  (let* ((result (nelisp-boot-links-test--windows nil))
         (opens (cl-remove-if-not (lambda (call) (eq (car call) 'CreateFileW))
                                  (plist-get result :calls))))
    (should (= (length opens) 2))
    (dolist (call opens)
      (should (= (nth 2 call) 2147614720))
      (should (= (nth 3 call) 1))) ; FILE_SHARE_READ only.
    (should (= (nth 6 (car opens)) 128))
    (should (= (nth 6 (cadr opens)) 2097280))))

(provide 'nelisp-boot-image-links-test)
