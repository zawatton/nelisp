("batch" (site before after) nil nil "~/.emacs.d/" nil t)
("user" (site early package before init custom default after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t)
("q" (site before after) nil nil "~/.emacs.d/" nil t)
("Q" nil nil nil "~/.emacs.d/" nil t)
("alt" (site early package before init custom default after) "$HOME/alternate/init.el" "$HOME/alternate/early-init.el" "$HOME/alternate/" "$HOME/alternate/custom.el" t)
("alt-q" (site before after) nil nil "$HOME/alternate/" nil t)
("alt-Q" nil nil nil "$HOME/alternate/" nil t)
("no-site" nil nil nil "~/.emacs.d/" nil t)
("no-site-user" (early package init custom default) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t)
("inhibit-default" (site early package before init custom after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t)
("dot-emacs" (site early package before dot-emacs default after) "$HOME/.emacs" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" nil t)
("xdg" (site early package before init custom default after) "$HOME/xdg/emacs/init.el" "$HOME/xdg/emacs/early-init.el" "$HOME/xdg/emacs/" "$HOME/xdg/emacs/custom.el" t)
