("batch" (site before after) nil nil "~/.emacs.d/" nil t nil nil)
("user" (site early package before init read-early custom default after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("q" (site before after) nil nil "~/.emacs.d/" nil t nil nil)
("Q" nil nil nil "~/.emacs.d/" nil t nil nil)
("alt" (site early package before init read-early custom default after) "$HOME/alternate/init.el" "$HOME/alternate/early-init.el" "$HOME/alternate/" "$HOME/alternate/custom.el" t nil nil)
("alt-q" (site before after) nil nil "$HOME/alternate/" nil t nil nil)
("alt-Q" nil nil nil "$HOME/alternate/" nil t nil nil)
("no-site" nil nil nil "~/.emacs.d/" nil t nil nil)
("no-site-user" (early package init read-early custom default) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("inhibit-default" (site early package before init read-early custom after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("dot-emacs" (site early package before dot-emacs default after) "$HOME/.emacs" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" nil t nil nil)
("dot-emacs-el" (site early package before dot-emacs default after) "$HOME/.emacs.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" nil t nil nil)
("xdg" (site early package before init read-early custom default after) "$HOME/xdg/emacs/init.el" "$HOME/xdg/emacs/early-init.el" "$HOME/xdg/emacs/" "$HOME/xdg/emacs/custom.el" t nil nil)
("no-package" (site early before init read-early custom default after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("init-error" (site early package before init read-early after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" nil t t t)
(debug-init error (error "Startup fixture error") "$HOME/.emacs.d/init.el" t)
("hooks" (site early package before init read-early custom default after startup window) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("actions" (site early package before init read-early custom default after eval-before-load load funcall eval-after-funcall) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
("file" (site before after (file "visit.txt" 2 1)) nil nil "~/.emacs.d/" nil t nil nil)
(script t "one" "--")
("user-option" (site early package before init read-early custom default after) "$HOME/.emacs.d/init.el" "$HOME/.emacs.d/early-init.el" "~/.emacs.d/" "$HOME/.emacs.d/custom.el" t nil nil)
