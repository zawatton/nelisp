;;; w2bt-backtrace-corpus-src.el --- backtrace record corpus source -*- lexical-binding: t; -*-
;; Generated into literal bytecode by test/w2bt-backtrace-corpus-gen.sh (GNU Emacs
;; byte-compiles every defun here); the result runs unchanged on GNU Emacs and the
;; standalone reader.  Non-leaf bytecode-to-bytecode calls take the lean record.
(defvar bt-sv 0)
(defvar bt-count 0)
(defun bt-frames ()
  "Frames named bt-*, innermost first, as (EVALUATED FN ARGS)."
  (let (l)
    (mapbacktrace
     (lambda (ev fn args _fl)
       (when (and (symbolp fn) (string-prefix-p "bt-" (symbol-name fn))
                  (not (eq fn 'bt-show)))
         (push (list ev fn args) l))))
    (nreverse l)))
(defun bt-depth () (let ((n 0)) (mapbacktrace (lambda (&rest _) (setq n (1+ n)))) n))
(defun bt-leaf3 (a b c) (bt-frames))
(defun bt-mid2 (a b) (bt-leaf3 a b (+ a b)))
(defun bt-top1 (a) (bt-mid2 a (* a 2)))
(defun bt-frame-at (n) (let ((f (backtrace-frame n))) (list (car f) (nth 1 f) (nth 2 f))))
(defun bt-fr1 (x) (bt-frame-at 1))
(defun bt-fr2 (x y) (bt-fr1 (list x y)))
(defun bt-loc-inner (z) (backtrace--locals 1 'bt-loc-inner))
(defun bt-loc-outer (a) (let ((bt-sv (+ a 10))) (bt-loc-inner (+ a 1))))
(defun bt-loc-twice (a) (let ((bt-sv 1)) (let ((bt-sv 2)) (bt-loc-inner a))))
(defvar bt-exit-log nil)
(defun bt-exit-target (x) (backtrace-debug 1 t) (* x 3))
(defun bt-exit-run (x)
  (setq bt-exit-log nil)
  (let* ((debugger (lambda (&rest a) (push (list (car a) (nth 1 a)) bt-exit-log) 'ignored))
         (r (bt-exit-target x)))
    (list r (reverse bt-exit-log))))
(defun bt-rec (n) (setq bt-count n) (1+ (bt-rec (1+ n))))
(defun bt-overflow ()
  (let ((before (bt-depth)) (max-lisp-eval-depth 300))
    (let ((e (condition-case e (bt-rec 0) (error (car e)))))
      (list e (= before (bt-depth)) (> bt-count 20) (< bt-count 400)))))
(defun bt-thrower (n) (if (= n 0) (throw 'bt-tag 'thrown) (+ 1 (bt-thrower (1- n)))))
(defun bt-signaler (n) (if (= n 0) (signal 'wrong-type-argument '(bt)) (+ 1 (bt-signaler (1- n)))))
(defun bt-restore ()
  (let* ((d0 (bt-depth))
         (r1 (catch 'bt-tag (bt-thrower 12)))
         (d1 (bt-depth))
         (r2 (condition-case e (bt-signaler 9) (wrong-type-argument (car e))))
         (d2 (bt-depth))
         (r3 (condition-case nil (bt-signaler 5) (arith-error 'no) (error 'yes)))
         (d3 (bt-depth)))
    (list r1 r2 r3 (= d0 d1) (= d0 d2) (= d0 d3))))
(defun bt-wrongargs (f) (condition-case e (funcall f 1 2 3) (error (car e))))
(defun bt-two (a b) (list a b))
(defun bt-fn-op () (let ((f (lambda (x) (bt-frames)))) (funcall f 9)))
(defun bt-apply-op (&rest xs) (apply #'bt-leaf3 xs))
(defun bt-gc-mid (a) (garbage-collect) (bt-frames))
(defun bt-gc-top (a) (list (bt-gc-mid (list a)) (> (bt-depth) 0)))
