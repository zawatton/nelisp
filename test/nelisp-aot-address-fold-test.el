;;; nelisp-aot-address-fold-test.el --- Whole x86 addresses -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-address-test--enabled t)
(defun nelisp-address-test--ref (slot)
  (nelisp-aot-compiler--make-ir 'ref :slot slot :var (intern (format "a%d" slot)) :class 'gp))
(defun nelisp-address-test--imm (v) (nelisp-aot-compiler--make-ir 'imm :value v :class 'gp))
(defun nelisp-address-test--arith (op a b)
  (nelisp-aot-compiler--make-ir 'arith :op op :a a :b b :class 'gp))
(defun nelisp-address-test--as (s)
  (let* ((d (make-temp-file "au-as-" t)) (a (expand-file-name "p.s" d))
         (o (expand-file-name "p.o" d)) (b (expand-file-name "p.bin" d)))
    (unwind-protect
        (progn (with-temp-file a (insert ".intel_syntax noprefix\n.text\n" s "\n"))
               (should (= 0 (call-process "as" nil nil nil "--64" a "-o" o)))
               (should (= 0 (call-process "objcopy" nil nil nil "-O" "binary" "-j" ".text" o b)))
               (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally b) (buffer-string)))
      (delete-directory d t))))
(ert-deftest nelisp-address-fold/GNUas-incoming-inputs-and-held-value ()
  (let ((nelisp-aot-compiler--x86-affine-addresses t)
        (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
        (nelisp-aot-compiler--os 'linux) (nelisp-aot-compiler--checked-arith nil))
    (dolist (case '((((0 . rdi) (1 . rsi)) "mov rax,QWORD PTR [rdi+rsi*8+20]")
                    (((1 . rdi)) "mov rsi,QWORD PTR [rbp-8]\nmov rax,QWORD PTR [rsi+rdi*8+20]")
                    (((0 . rsi)) "mov rdi,QWORD PTR [rbp-16]\nmov rax,QWORD PTR [rsi+rdi*8+20]")
                    (((0 . rdx) (1 . rcx)) "mov rax,QWORD PTR [rdx+rcx*8+20]")))
      (let* ((nelisp-aot-compiler--promoted-slots (car case))
             (ptr (nelisp-address-test--arith '+ (nelisp-address-test--ref 0)
                    (nelisp-address-test--arith '* (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))))
             (plan (nelisp-aot-compiler--x86-affine-address-plan ptr (nelisp-address-test--imm 20)))
             (buf (nelisp-asm-x86_64-make-buffer)))
        (should plan)
        (nelisp-aot-compiler--x86-load-mem buf 64 'rax (nelisp-aot-compiler--emit-affine-address-x86 plan buf))
        (should (equal (nelisp-asm-x86_64-buffer-bytes buf) (nelisp-address-test--as (cadr case))))))
    (dolist (case '((((0 . rsi) (1 . rdx) (2 . rdi)) "mov QWORD PTR [rsi+rdx*8],rdi")
                    (((1 . rcx) (2 . rdi)) "mov rsi,QWORD PTR [rbp-8]\nmov QWORD PTR [rsi+rcx*8],rdi")
                    (((1 . rcx) (2 . rsi)) "mov rdi,QWORD PTR [rbp-8]\nmov QWORD PTR [rdi+rcx*8],rsi")))
      (let* ((nelisp-aot-compiler--promoted-slots (car case))
             (ptr (nelisp-address-test--arith '+ (nelisp-address-test--ref 0)
                    (nelisp-address-test--arith '* (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))))
             (node (nelisp-aot-compiler--make-ir 'ptr-write-u64 :ptr ptr :offset (nelisp-address-test--imm 0)
                                               :val (nelisp-address-test--ref 2)))
             (buf (nelisp-asm-x86_64-make-buffer)))
        (should (nelisp-aot-compiler--emit-ptr-write-x86 node buf))
        (should (equal (nelisp-asm-x86_64-buffer-bytes buf) (nelisp-address-test--as (cadr case))))))))
(ert-deftest nelisp-address-fold/fallback-before-emission ()
  (let* ((nelisp-aot-compiler--x86-affine-addresses t)
         (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--os 'linux) (nelisp-aot-compiler--checked-arith nil)
         (ptr (nelisp-address-test--arith '+ (nelisp-address-test--ref 0)
                (nelisp-address-test--arith '* (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))))
         (zero (nelisp-address-test--imm 0))
         (plan (nelisp-aot-compiler--x86-affine-address-plan ptr zero))
         (buf (nelisp-asm-x86_64-make-buffer)))
    (should plan)
    (let ((nelisp-aot-compiler--x86-address-held-registers '(rdi)))
      (should-not (nelisp-aot-compiler--emit-affine-address-x86 plan buf)))
    (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))
    (let* ((nelisp-aot-compiler--promoted-slots '((0 . rdx) (1 . rcx)))
           (node (nelisp-aot-compiler--make-ir 'ptr-write-u64 :ptr ptr :offset zero
                                              :val (nelisp-address-test--ref 2))))
      (should-not (nelisp-aot-compiler--emit-ptr-write-x86 node buf))
      (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf))))
    (let ((nelisp-aot-compiler--checked-arith t))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan ptr zero)))
    (let ((nelisp-aot-compiler--runtime-entry-params '(sentinel)))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan ptr zero)))
    (should-not (nelisp-aot-compiler--x86-affine-address-plan ptr (nelisp-address-test--imm 2147483648)))
    (should-not (nelisp-aot-compiler--x86-affine-address-plan
                 (nelisp-aot-compiler--make-ir 'ptr-read-u64 :ptr (nelisp-address-test--ref 0) :offset zero) zero))
    (let* ((a (nelisp-aot-compiler--make-ir 'data-addr :name 'aa))
           (b (nelisp-aot-compiler--make-ir 'data-addr :name 'bb)))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan (nelisp-address-test--arith '+ a b) zero))
      (should (equal (nelisp-aot-compiler--x86-affine-address-plan a (nelisp-address-test--imm -20))
                     '((:rip "aa" 0) nil 1 -20)))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan
                   (nelisp-address-test--arith '* a (nelisp-address-test--imm 0)) zero))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan
                   (nelisp-address-test--arith '+ (nelisp-address-test--arith '- a a)
                                              (nelisp-address-test--ref 0)) zero))
      (should-not (nelisp-aot-compiler--x86-affine-address-plan
                   (nelisp-aot-compiler--ir-with ptr :class 'f64) zero))
      (let ((nelisp-aot-compiler--abi 'win64))
        (should-not (nelisp-aot-compiler--x86-affine-address-plan a zero))))))
(defun nelisp-address-test--source ()
  (let ((defs nil))
    (dolist (w '(8 16 32 64))
      (dolist (scale '(1 2 4 8))
        (let ((rd (intern (format "ptr-read-u%d" w))) (wr (intern (format "ptr-write-u%d" w))))
          (cl-loop for shape in `(((+ p (* i ,scale)) 17)
                                  ((+ 17 (+ (* i ,scale) p)) 0)
                                  ((+ p (* (+ i 2) ,scale)) ,(- 17 (* 2 scale)))
                                  ((+ p (* i ,scale)) 18446744073709551601))
                   for j from 0 do
                   (push `(defun ,(intern (format "au_%d_%d_%d" w scale j)) (p i v)
                            (seq (,wr ,(car shape) ,(cadr shape) v) (,rd ,(car shape)  ,(cadr shape)))) defs))))
      (let ((rd (intern (format "ptr-read-u%d" w))) (wr (intern (format "ptr-write-u%d" w))))
        (push `(defun ,(intern (format "aug_%d" w)) (i v)
                 (seq (,wr (+ 16 (+ (data-addr au_global) (* i 8))) 0 v)
                      (,rd (+ (data-addr au_global) 8) (+ (* i 8) 8)))) defs)))
    `(seq (data-blob au_global ,(make-list 256 0) data)
          ,@(nreverse defs)
          (defun au_vrdi (v p i) (seq (ptr-write-u64 (+ p (* i 8)) 0 v) (ptr-read-u64 p (* i 8))))
          (defun au_vrsi (p v i) (seq (ptr-write-u64 (+ p (* i 8)) 0 v) (ptr-read-u64 p (* i 8))))
          (defun au_word (w p i)
            (if (= (sexp-tag w) 7) 37 (if (= (sexp-tag w) 4) (ptr-read-u8 (+ p (* i 8)) 0) 0)))
          (defun au_effect (p)
            (ptr-write-u64 (seq (ptr-write-u64 p 0 1) p)
                           (seq (ptr-write-u64 p 8 (ptr-read-u64 p 0)) 16)
                           (seq (ptr-write-u64 p 24 (ptr-read-u64 p 8)) 91)))
          (defun au_dispmax (p v) (seq (ptr-write-u64 (+ p 2147483647) 0 v) (ptr-read-u64 p 2147483647)))
          (defun au_dispmin (p v) (seq (ptr-write-u64 (+ p -2147483648) 0 v) (ptr-read-u64 p -2147483648)))
          (defun au_dup (x v) (seq (ptr-write-u64 (+ x (* x 8)) 0 v) (ptr-read-u64 x (* x 8)))))))
(defun nelisp-address-test--driver ()
  (let ((text "#include <stdint.h>\n#include <string.h>\n#include <sys/mman.h>\n#include <unistd.h>\n"))
    (dolist (w '(8 16 32 64))
      (dolist (s '(1 2 4 8))
        (dotimes (j 4) (setq text (concat text (format "extern uint64_t au_%d_%d_%d(uint64_t,int64_t,uint64_t);\n" w s j))))))
    (dolist (w '(8 16 32 64)) (setq text (concat text (format "extern uint64_t aug_%d(int64_t,uint64_t);\n" w))))
    (setq text (concat text "extern uint64_t au_dispmax(uint64_t,uint64_t),au_dispmin(uint64_t,uint64_t);\nextern uint64_t au_vrdi(uint64_t,uint64_t,int64_t),au_vrsi(uint64_t,uint64_t,int64_t),au_word(uint64_t,uint64_t,int64_t),au_effect(uint64_t),au_dup(uint64_t,uint64_t);\nint main(void){ uint64_t values[]={0,1,UINT64_MAX,UINT64_C(0x8000000000000000),UINT64_C(0x123456789abcdef0)}; uint8_t *b=mmap(0,8192,3,0x22,-1,0); if(b==(void*)-1)return 90; uint64_t p=(uintptr_t)(b+4096-19); int64_t ii[]={-3,0,1,7};\n"))
    (dolist (w '(8 16 32 64))
      (let ((mask (if (= w 64) "UINT64_MAX" (format "UINT64_C(%d)" (1- (ash 1 w))))))
        (dolist (s '(1 2 4 8))
          (dotimes (j 4)
            (setq text (concat text (format "for(int i=0;i<4;i++)for(int v=0;v<5;v++){uint64_t z=au_%d_%d_%d(p,ii[i],values[v]);if(z!=(values[v]&%s))return 1;}\n" w s j mask)))))
        (setq text (concat text (format "for(int i=0;i<4;i++)for(int v=0;v<5;v++)if(aug_%d(ii[i],values[v])!=(values[v]&%s))return 2;\n" w mask)))))
    (dolist (w '(8 16 32 64))
      (let ((mask (if (= w 64) "UINT64_MAX" (format "UINT64_C(%d)" (1- (ash 1 w))))))
        (dolist (scale '(2 4 8))
          (dotimes (j 4)
            (setq text (concat text (format "for(int v=0;v<5;v++)if(au_%d_%d_%d(p,(int64_t)(UINT64_MAX/%d+2),values[v])!=(values[v]&%s))return 7;\n" w scale j scale mask)))))))
    (concat text "for(int v=0;v<5;v++){ if(au_vrdi(values[v],p,1)!=values[v]||au_vrsi(p,values[v],1)!=values[v])return 3;}\n"
            "for(int v=0;v<5;v++)if(au_dispmax(p-2147483647,values[v])!=values[v]||au_dispmin(p+UINT64_C(2147483648),values[v])!=values[v])return 8;\n"
            "_Alignas(8) uint8_t h[16]={4};b[64]=23;if(au_word(2,1,0)!=37||au_word((uintptr_t)h+6,(uintptr_t)b,8)!=23)return 4;\n"
            "memset(b,0,64);au_effect((uintptr_t)b);uint64_t a[4];memcpy(a,b,32);if(a[0]!=1||a[1]!=1||a[2]!=91||a[3]!=1)return 5;\n"
            "uintptr_t q=(uintptr_t)(b+256);q+=(9-q%9)%9;if(au_dup(q/9,UINT64_MAX)!=UINT64_MAX)return 6;return 0;}\n")))
(ert-deftest nelisp-address-fold/native-all-widths-order-WORD-wrap-and-page-crossing ()
  (let* ((d (make-temp-file "au-native-" t)) (obj (expand-file-name "p.o" d))
         (c (expand-file-name "p.c" d)) (exe (expand-file-name "p" d))
         (nelisp-aot-compiler--x86-affine-addresses nelisp-address-test--enabled)
         (selected 0) (emit (symbol-function 'nelisp-aot-compiler--emit-affine-address-x86)))
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-affine-address-x86)
                     (lambda (plan buf) (when (eq (caar plan) :rip) (cl-incf selected)) (funcall emit plan buf))))
            (nelisp-aot-compile-to-object (nelisp-address-test--source) obj))
          (with-temp-file c (insert (nelisp-address-test--driver)))
          (should (= 0 (call-process "cc" nil nil nil "-O2" c obj "-o" exe)))
          (should (= 0 (call-process exe nil nil nil)))
          (message "AU native:1600 width/value checks + global/live-V/WORD/order/refdup PASS; symbolic selections=%d" selected)
          ;; The disabled control runs exactly these semantics BEFORE this
          ;; positive selection gauge, which it must then reject.
          (should (> selected 0)))
      (delete-directory d t))))
(ert-deftest nelisp-address-fold/unresolved-symbol-not-cancelled ()
  "A zero/cancelled symbolic address still has its original link diagnostic."
  (let* ((d (make-temp-file "au-unresolved-" t)) (obj (expand-file-name "p.o" d))
         (c (expand-file-name "p.c" d)) (exe (expand-file-name "p" d)))
    (unwind-protect
        (progn
          (with-temp-file c (insert "extern long probe(long); int main(void){return probe(0);}"))
          (dolist (enabled '(nil t))
            (let ((nelisp-aot-compiler--x86-affine-addresses enabled))
              (dolist (expr '((+ p (- (data-addr au_missing) (data-addr au_missing)))
                             (+ p (* 0 (data-addr au_missing)))))
                (nelisp-aot-compile-to-object `(defun probe (p) (ptr-read-u64 ,expr 0)) obj)
                (with-temp-buffer
                  (should-not (= 0 (call-process "cc" nil t nil c obj "-o" exe))))))))
      (delete-directory d t))))
(provide 'nelisp-aot-address-fold-test)
