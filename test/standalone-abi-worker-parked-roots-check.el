;;; standalone-abi-worker-parked-roots-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let* ((shared (nelisp-thread-shared-alloc 64))
       (result0 shared) (result1 (+ shared 8))
       (arrived (+ shared 16)) (release (+ shared 24)) (done (+ shared 32))
       (form0 `(car (prog1 (cons 17 nil)
                      (nelisp-thread-atomic-add ,arrived 1)
                      (nelisp-thread-join ,release 1))))
       (form1 `(car (prog2 nil (cons 23 nil)
                      (nelisp-thread-atomic-add ,arrived 1)
                      (nelisp-thread-join ,release 1))))
       (active nil) (released nil) (spawned 0))
  (unless (> shared 0) (error "parked holder allocation failed"))
  (unwind-protect
      (progn
        (unless (= (nelisp-thread-gc-inhibit 1) 1) (error "parked holder section failed"))
        (setq active t)
        (unless (> (nelisp-thread-spawn 2 0 form0 result0 done) 0)
          (error "parked prog1 worker did not spawn"))
        (setq spawned 1)
        (unless (> (nelisp-thread-spawn 2 0 form1 result1 done) 0)
          (error "parked prog2 worker did not spawn"))
        (setq spawned 2)
        (unless (= (nelisp-thread-join arrived 2) 2) (error "holder workers did not arrive"))
        (let* ((before (nelisp--debug-switch 0))
               (missed (nth 19 before)) (collects (nth 20 before)))
          (unless (= (nth 16 before) 2) (error "two holder workers were not registered"))
          (garbage-collect)
          (let ((after (nelisp--debug-switch 0)))
            (unless (and (= (nth 18 after) 2) (= (nth 19 after) missed)
                         (= (nth 20 after) (+ collects 1)))
              (error "holder test did not perform an actual parked collection"))))
        (nelisp-thread-atomic-add release 1)
        (setq released t)
        (unless (= (nelisp-thread-join done 2) 2) (error "holder workers did not finish"))
        (unless (= (nelisp-thread-atomic-read result0) 17)
          (error "parked prog1 value lost"))
        (unless (= (nelisp-thread-atomic-read result1) 23)
          (error "parked prog2 value lost"))
        (unless (= (nelisp-thread-gc-inhibit 0) 1) (error "holder section grew the arena"))
        (setq active nil))
    (when active
      (unless released (nelisp-thread-atomic-add release 1))
      (when (> spawned 0) (nelisp-thread-join done spawned))
      (nelisp-thread-gc-inhibit 0))))
(princ "ABI-WORKER-PARKED-ROOTS checked=3 PASS\n")
