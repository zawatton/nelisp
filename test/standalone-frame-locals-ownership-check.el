;;; standalone-frame-locals-ownership-check.el --- Locals event ownership -*- lexical-binding: t; -*-
;; Run unchanged on GNU Emacs 31.1 and the standalone reader.
(defvar flo-special 0)
(defun flo-read () (backtrace--locals 1 'flo-read))
(defun flo-tail (arg) (flo-read))
(defun flo-list (arg) (list arg (flo-read)))
(defun flo-progn (arg) (progn arg (flo-read)))
(defun flo-empty (arg) (let () (flo-read)))
(defun flo-lex (arg) (let ((local 3)) (flo-read)))
(defun flo-dyn (arg) (let ((flo-special 1)) (flo-read)))
(defun flo-mixed (arg) (let ((local 3) (flo-special 1)) (flo-read)))
(defun flo-dup-dyn (arg) (let ((flo-special 1) (flo-special 2)) (flo-read)))
(defun flo-mixed-star (arg) (let* ((local 3) (flo-special 1)) (flo-read)))
(defun flo-nested-empty (arg) (let ((local 3)) (let () (flo-read))))
(defun flo-nested-dyn (arg) (let ((local 3)) (let ((flo-special 1)) (flo-read))))
(defun flo-mixed-two (arg) (let ((local 3) (second 4) (flo-special 1)) (flo-read)))
(defun flo-let-list (arg) (let ((local 3)) (list arg (flo-read))))
(defun flo-bt (arg) (list arg (backtrace-frame 0 'flo-bt) (flo-read)))
(defun flo-bts (arg) (list arg (car (backtrace-frames 'flo-bts)) (flo-read)))
(defun flo-no-args () (flo-read))
(defun flo-shadow (arg) (let ((arg 23)) (flo-read)))
(let ((checks 0) (failures 0))
  (dolist
      (row
       (list
        (list 'tail (flo-tail 17) '((arg . 17)))
        (list 'list-caller (flo-list 17) '(17 nil))
        (list 'progn-caller (flo-progn 17) nil)
        (list 'empty-let (flo-empty 17) nil)
        (list 'lexical-let (flo-lex 17) '((arg . 17) (local . 3)))
        (list 'dynamic-let (flo-dyn 17) '((flo-special . 1)))
        (list 'mixed-let (flo-mixed 17) '((flo-special . 1) (arg . 17) (local . 3)))
        (list 'repeated-dynamic (flo-dup-dyn 17) '((flo-special . 1) (flo-special . 2)))
        (list 'mixed-let-star (flo-mixed-star 17) '((arg . 17) (local . 3) (flo-special . 1)))
        (list 'nested-empty-let (flo-nested-empty 17) nil)
        (list 'nested-dynamic-let (flo-nested-dyn 17) '((flo-special . 1)))
        (list 'mixed-two-lexical (flo-mixed-two 17)
              '((flo-special . 1) (arg . 17) (local . 3) (second . 4)))
        (list 'let-list-caller (flo-let-list 17) '(17 nil))
        (list 'backtrace-list-caller (flo-bt 17) '(17 (t flo-bt 17) nil))
        (list 'backtrace-frames-list-caller (flo-bts 17) '(17 (t flo-bts (17) nil) nil))
        (list 'no-arguments (flo-no-args) nil)
        (list 'lexical-shadow (flo-shadow 17) '((arg . 17) (arg . 23)))))
    (setq checks (1+ checks))
    (unless (equal (nth 1 row) (nth 2 row))
      (setq failures (1+ failures))
      (princ (format "FRAME-LOCALS-OWNERSHIP %S actual=%S expected=%S\n"
                     (car row) (nth 1 row) (nth 2 row)))))
  (princ (format "FRAME-LOCALS-OWNERSHIP checks=%d failures=%d %s\n"
                 checks failures (if (= failures 0) "PASS" "FAIL")))
  (princ "FRAME-LOCALS-OWNERSHIP-DONE 1\n")
  (kill-emacs (if (= failures 0) 0 1)))
