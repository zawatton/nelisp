;;; n4-backtrace-reference.el --- Activation API GNU references -*- lexical-binding: t; -*-
;; Run unchanged on GNU 31.1 and the N4b standalone (with the normal bundle).
(defmacro n4-row (name form)
  `(progn (princ ,name) (princ "|")
          (prin1 (condition-case err ,form (error err))) (terpri)))
(defun n4-frame (x &optional y) (backtrace-frame 0 'n4-frame))
(defun n4-frame-alias (x) (backtrace-frame 0 'n4-frame-alias))
(defun n4-special () (let ((x 3)) (backtrace-frame 0 'let)))
(defun n4-locals (x) (backtrace--locals 1 'backtrace--locals))
(defun n4-eval-helper (expression) (backtrace-eval expression 0 'n4-eval-helper))
(defun n4-live () (let ((n4-x 7)) (list (n4-eval-helper '(setq n4-x 8)) n4-x)))
(defun n4-live-error ()
  (let ((n4-x 7))
    (list (condition-case nil (n4-eval-helper '(progn (setq n4-x 8) (error "expected")))
            (error 'caught)) n4-x)))
(defun n4-live-throw ()
  (let ((n4-x 7))
    (list (catch 'n4-tag (n4-eval-helper '(progn (setq n4-x 8) (throw 'n4-tag 9)))) n4-x)))
(defvar n4-dynamic 1)
(defun n4-dynamic-helper () (backtrace-eval '(setq n4-dynamic 8) 0 'n4-dynamic-helper))
(defun n4-dynamic-live () (let ((n4-dynamic 7)) (list (n4-dynamic-helper) n4-dynamic)))
(n4-row "frame-direct" (n4-frame 7 8))
(n4-row "frame-funcall" (funcall 'n4-frame 7 8))
(n4-row "frame-apply" (apply 'n4-frame '(7 8)))
(n4-row "frame-special" (n4-special))
(n4-row "frame-callback" (backtrace-frame--internal (lambda (e f _a flags) (list e f flags)) 0 nil))
(n4-row "frame-missing" (backtrace-frame--internal #'list 99999 nil))
(n4-row "frame-negative" (backtrace-frame--internal #'list -1 nil))
(n4-row "frame-offset" (n4-frame-alias 7))
(n4-row "frame-base-missing" (backtrace-frame 0 'n4-absent))
(n4-row "locals-parameter" (n4-locals 7))
(n4-row "locals-zero" (backtrace--locals 0))
(n4-row "locals-negative" (backtrace--locals -1))
(n4-row "locals-missing" (backtrace--locals 99999))
(n4-row "eval-literal" (backtrace-eval '(+ 2 3) 0))
(n4-row "eval-missing" (backtrace-eval 'ignored 99999))
(n4-row "eval-live" (n4-live))
(n4-row "eval-signal" (n4-live-error))
(n4-row "eval-throw" (n4-live-throw))
(n4-row "eval-dynamic" (n4-dynamic-live))
(n4-row "debug-return" (backtrace-debug 99999 t))
(n4-row "debug-negative" (backtrace-debug -1 nil))
(n4-row "map-self" (let (seen) (mapbacktrace (lambda (_e f _a _flags) (when (eq f 'mapbacktrace) (setq seen t)))) seen))
(n4-row "map-missing-base" (mapbacktrace (lambda (&rest _args) (error "unexpected")) 'n4-absent))
(n4-row "thread-nonempty" (consp (backtrace--frames-from-thread (current-thread))))
(n4-row "thread-type" (backtrace--frames-from-thread nil))
;; Debugger return value becomes the flagged activation's return value.
(defun n4-debug-target () (backtrace-debug 0 t 'n4-debug-target) 7)
(n4-row "debug-on-exit" (let ((debugger (lambda (reason value) (list reason value)))) (n4-debug-target)))
(n4-row "unwind-stack" (progn (condition-case nil (error "expected") (error nil)) (consp (backtrace-frames))))
(defun n4-map-flags ()
  (let (seen)
    (mapbacktrace
     (lambda (_e function _args flags)
       (when (eq function 'mapbacktrace) (backtrace-debug 0 t 'n4-map-flags))
       (when (eq function 'n4-map-flags) (setq seen (plist-get flags :debug-on-exit)))))
    (backtrace-debug 0 nil 'n4-map-flags)
    seen))
(n4-row "map-live-flags" (n4-map-flags))
(defun n4-args-copy (x)
  (let* ((frame (backtrace-frame 0 'n4-args-copy))
         (_ignored (setcar (cddr frame) 99)))
    (list x (backtrace-frame 0 'n4-args-copy))))
(n4-row "evaluated-args-spine" (n4-args-copy 7))
(n4-row "base-offset" (backtrace-frame--internal
                       (lambda (_e f _a _flags) f) 0 '(1 . backtrace-frame--internal)))
(defalias 'n4-alias #'n4-frame)
(n4-row "indirect-base" (n4-alias 7 8))
(defun n4-rest (&rest args) (backtrace-frame 0 'n4-rest))
(n4-row "rest-args" (n4-rest 1 2 3))
(n4-row "backtrace-print" (string-match-p "backtrace()" (with-output-to-string (backtrace))))
(defvar n4-repeat 1)
(defun n4-repeat-helper () (backtrace--locals 1 'n4-repeat-helper))
(defun n4-repeat-outer () (let ((n4-repeat 2) (n4-repeat 3)) (n4-repeat-helper)))
(n4-row "locals-repeated-dynamic" (n4-repeat-outer))
(n4-row "locals-captured-unused"
        (let ((unused 8))
          (funcall (lambda (y) (backtrace--locals 1 'backtrace--locals)) 7)))
(n4-row "frame-bignum" (backtrace-frame--internal #'list 1180591620717411303424 nil))
(n4-row "base-offset-nil" (backtrace-frame--internal #'list 0 '(0)))
(n4-row "base-offset-one-nil" (backtrace-frame--internal #'list 0 '(1)))
(defun n4-shadow-inner ()
  (let ((n4-repeat 'inner)) (backtrace--locals 1 'n4-shadow-inner)))
(defun n4-shadow-outer ()
  (let ((n4-repeat 'outer)) (n4-shadow-inner)))
(n4-row "locals-outer-shallow-shadow" (n4-shadow-outer))
;; The inner helper selects the binding owner without adding its own locals.
(defun n4-shallow-values-helper () (backtrace--locals 1 'n4-shallow-values-helper))
(defun n4-shallow-values-owner ()
  (let ((n4-repeat nil) (n4-repeat t) (n4-repeat "value"))
    (n4-shallow-values-helper)))
(n4-row "locals-shallow-value-classes" (n4-shallow-values-owner))
;; Activation records as eval_sub and funcall_lambda leave them (eval.c:2585-2700, 3315-3475): a
;; frame being evaluated shows the unevaluated forms, a finished one its values; the frames above a
;; marker function are compared, a function object printing as `anon'.
(defvar n4r-seen nil)
(defvar n4r-hook nil)
(defun n4r-norm (frames)
  (mapcar (lambda (fr) (list (nth 0 fr) (let ((f (nth 1 fr))) (if (symbolp f) f 'anon)) (nth 2 fr))) frames))
(defun n4r-above (marker frames)
  (let (out)
    (while (and frames (not (eq (nth 1 (car frames)) marker)))
      (push (car frames) out) (setq frames (cdr frames)))
    (nreverse out)))
(defun n4r-mark (thunk) (funcall thunk))
(defun n4r-outer (a b) (list a b))
(defun n4r-cap (x) (setq n4r-seen (n4r-norm (n4r-above 'n4r-mark (backtrace-frames 'n4r-cap)))) x)
(n4-row "record-in-flight" (n4r-mark (lambda () (n4r-outer (n4r-cap 1) 2) n4r-seen)))
(n4-row "record-in-flight-builtin" (n4r-mark (lambda () (+ 1 (n4r-cap 5)) n4r-seen)))
(n4-row "record-in-flight-special" (n4r-mark (lambda () (progn (n4r-cap 5)) n4r-seen)))
(n4-row "record-in-flight-let" (n4r-mark (lambda () (let ((a (n4r-cap 5))) a) n4r-seen)))
(n4-row "record-in-flight-nested"
        (n4r-mark (lambda () (n4r-outer 1 (n4r-outer (n4r-cap 3) 4)) n4r-seen)))
(n4-row "record-in-flight-three-args"
        (n4r-mark (lambda () (list (n4r-cap 1) 2 (n4r-cap 3)) n4r-seen)))
(defun n4r-body (x) (n4r-cap x) n4r-seen)
(n4-row "record-closure-body" (n4r-mark (lambda () (n4r-body 9))))
(defun n4r-funcall-body (x) (let ((f #'n4r-cap)) (funcall f x)) n4r-seen)
(n4-row "record-funcall-body" (n4r-mark (lambda () (n4r-funcall-body 9))))
(defun n4r-two (a b) (n4r-cap (+ a b)) n4r-seen)
(n4-row "record-two-parameters" (n4r-mark (lambda () (n4r-two 3 4))))
;; The same frames across a compiled function (GNU's own bytecode: Bcall records the callee).
(defun n4r-bc-a (x) (n4r-cap (1+ x)))
(defun n4r-bc-b (x) (n4r-bc-a (* x 2)))
(defalias 'n4r-bc-a #[257 "\300\1T!\207" [n4r-cap] 3 "\n\n(fn X)"])
(defalias 'n4r-bc-b #[257 "\300\1\301_!\207" [n4r-bc-a 2] 4 "\n\n(fn X)"])
(n4-row "record-bytecode-nested" (n4r-mark (lambda () (n4r-bc-b 7) n4r-seen)))
(n4-row "record-bytecode-from-interpreted"
        (n4r-mark (lambda () (list (n4r-bc-b 1) n4r-seen))))
;; The debugger's frame list when debug-on-exit calls it (backtrace-debug flags the activation).
(defun n4r-dbg-exit (reason value)
  (setq n4r-seen (list reason value (n4r-norm (n4r-above 'n4r-mark (backtrace-frames 'n4r-dbg-exit)))))
  value)
(defun n4r-target (x y) (backtrace-debug 0 t 'n4r-target) (+ x y))
(defun n4r-target-outer (z) (list (n4r-target z 2)))
(n4-row "debugger-frame-list"
        (let ((debugger 'n4r-dbg-exit)) (setq n4r-seen nil)
             (list (n4r-mark (lambda () (n4r-target-outer 5))) n4r-seen)))
(defun n4r-target-b (x) (backtrace-debug 0 t 'n4r-target-b) (car x))
(n4-row "debugger-not-called-on-signal"
        (let ((debugger 'n4r-dbg-exit)) (setq n4r-seen nil)
             (list (condition-case nil (n4r-mark (lambda () (n4r-target-b 5))) (error 'err)) n4r-seen)))
(defun n4r-target-c (x) (backtrace-debug 0 t 'n4r-target-c) (funcall (lambda (y) (+ y 1)) x))
(n4-row "debugger-frame-list-nested-closure"
        (let ((debugger 'n4r-dbg-exit)) (setq n4r-seen nil)
             (list (n4r-mark (lambda () (n4r-target-c 5))) n4r-seen)))
(defun n4r-target-d (x) (backtrace-debug 0 t 'n4r-target-d) (backtrace-debug 0 nil 'n4r-target-d) x)
(n4-row "debug-on-exit-cleared"
        (let ((debugger 'n4r-dbg-exit)) (setq n4r-seen nil)
             (list (n4r-mark (lambda () (n4r-target-d 5))) n4r-seen)))
;; debug-on-exit of a builtin activation flagged while its arguments are evaluated, and of a
;; closure activation flagged in its own body.
(defun n4r-flag (level) (backtrace-debug level t) 7)
(n4-row "debug-on-exit-builtin-flagged-in-argument"
        (let ((debugger (lambda (reason value) (setq n4r-hook (list reason value)) value)))
          (setq n4r-hook nil)
          (list (n4r-mark (lambda () (+ 1 (n4r-flag 1)))) n4r-hook)))
(defun n4r-self-flag (x) (backtrace-debug 0 t 'n4r-self-flag) (* x 2))
(n4-row "debug-on-exit-closure-flagged-in-body"
        (let ((debugger (lambda (reason value) (setq n4r-hook (list reason value)) value)))
          (setq n4r-hook nil)
          (list (n4r-mark (lambda () (n4r-self-flag 4))) n4r-hook)))
(defun n4r-dbg-exit2 (reason value)
  (setq n4r-hook (list reason value (n4r-norm (n4r-above 'n4r-mark (backtrace-frames 'n4r-dbg-exit2)))))
  value)
(defun n4r-flag-arg (x) (backtrace-debug 2 t) x)
(n4-row "debug-on-exit-ancestor-flagged-in-argument"
        (let ((debugger 'n4r-dbg-exit2))
          (setq n4r-hook nil)
          (list (n4r-mark (lambda () (list 1 (n4r-flag-arg 5)))) n4r-hook)))
(princ "N4-BACKTRACE-REFERENCE-DONE\n")
nil
