;;; -*- lexical-binding: t; -*-
;; Syntax-class atoms \w \W \s- \S- \s_ \s. \s( \sw in string-match, string-match-p, looking-at,
;; re-search-forward/backward; case-fold on/off; ASCII and Japanese text; modify-syntax-entry and
;; with-syntax-table.  Spec = GNU 31.1 (par-rx-syncls.gnu).  Run again with the native class route
;; enabled (nlre--nat-cls-enable t) on the final build.  No raw aset (the generation-keyed class map
;; does not see it; see F414).
(set-syntax-table (standard-syntax-table))
(defmacro row (n f) `(princ (format "%-30s %S\n" ,n (condition-case e ,f (error (list 'ERR (car e)))))))
(defvar sx-pats '("\\w" "\\W" "\\s-" "\\S-" "\\s_" "\\s." "\\s(" "\\sw" "\\w+" "\\s-+\\w" "\\(\\w+\\)\\s-\\(\\w+\\)"))
(defvar sx-texts '("foo bar" "_a-b.c" "(x) [y]" "あい foo" "foo あい_" "  \t x" "AbC"))
(defun sx-sm (fold)
  (let ((case-fold-search fold))
    (mapcar (lambda (re) (mapcar (lambda (s) (let ((r (string-match re s))) (list r (and r (match-end 0))))) sx-texts)) sx-pats)))
(defun sx-smp (fold)
  (let ((case-fold-search fold))
    (mapcar (lambda (re) (mapcar (lambda (s) (string-match-p re s 1)) sx-texts)) sx-pats)))
(defun sx-la (fold)
  (let ((case-fold-search fold) (tbl (syntax-table)))
    (mapcar (lambda (re)
              (mapcar (lambda (s)
                        (with-temp-buffer (set-syntax-table tbl) (insert s)
                          (mapcar (lambda (p) (goto-char p) (let ((r (looking-at re))) (list r (and r (match-end 0)))))
                                  (list 1 2 (point-max)))))
                      sx-texts))
            sx-pats)))
(defun sx-rs (fold)
  (let ((case-fold-search fold) (tbl (syntax-table)))
    (mapcar (lambda (re)
              (mapcar (lambda (s)
                        (with-temp-buffer (set-syntax-table tbl) (insert s)
                          (goto-char 1)
                          (let (f b)
                            (while (re-search-forward re nil t) (push (list (match-beginning 0) (point)) f))
                            (goto-char (point-max))
                            (while (re-search-backward re nil t) (push (match-beginning 0) b))
                            (list (nreverse f) b))))
                      sx-texts))
            sx-pats)))
(dolist (fold '(nil t))
  (let ((tag (if fold "fold" "nofold")))
    (row (format "string-match %s" tag) (sx-sm fold))
    (row (format "string-match-p %s" tag) (sx-smp fold))
    (row (format "looking-at %s" tag) (sx-la fold))
    (row (format "re-search %s" tag) (sx-rs fold))))
(defun sx-all ()
  (list (sx-sm nil) (sx-smp t) (sx-la nil) (sx-la t) (sx-rs nil)))
(row "modify ?_ w" (let ((st (make-syntax-table))) (with-syntax-table st (let ((a (sx-all))) (modify-syntax-entry ?_ "w" st) (list a (sx-all))))))
(row "modify - _, . w" (let ((st (make-syntax-table))) (modify-syntax-entry ?- "_" st) (modify-syntax-entry ?. "w" st) (with-syntax-table st (sx-all))))
(row "modify back" (let ((st (make-syntax-table))) (with-syntax-table st (modify-syntax-entry ?_ "w" st) (let ((a (sx-sm nil))) (modify-syntax-entry ?_ "_" st) (list a (sx-sm nil))))))
(row "two tables in a buffer" (with-temp-buffer (insert "a_b-c") (let ((s1 (make-syntax-table)) (s2 (make-syntax-table))) (modify-syntax-entry ?_ "w" s2)
  (list (progn (set-syntax-table s1) (goto-char 2) (list (looking-at "\\w") (looking-at "\\s_") (string-match "\\w" "_")))
        (progn (set-syntax-table s2) (list (looking-at "\\w") (looking-at "\\s_") (string-match "\\w" "_")))
        (progn (set-syntax-table s1) (list (looking-at "\\w") (looking-at "\\s_") (string-match "\\w" "_")))))))
(row "match-data" (let ((case-fold-search nil)) (string-match "\\(\\w+\\)\\s-\\(\\W\\)" "foo (x)") (match-data)))
(row "narrowed" (with-temp-buffer (insert "ab cd ef") (narrow-to-region 4 6) (goto-char 4) (list (looking-at "\\w+") (match-end 0) (re-search-forward "\\s-" nil t))))
(row "parse-sexp-lookup-properties" (with-temp-buffer (setq-local parse-sexp-lookup-properties t) (insert "a b") (goto-char 1) (list (looking-at "\\w") (string-match "\\s-" "a b"))))
(row "unknown class" (list (string-match "\\sq" "abq") (string-match "\\Sq" "q")))
