;;; standalone-where-is.el --- Actual sparse reverse lookup -*- lexical-binding: t; -*-
(require 'nelisp-stdlib-where-is)
(let ((before (symbol-function 'where-is-internal)))
  (when (eq (nelisp-stdlib-where-is-install) 'preserved)
    (unless (eq before (symbol-function 'where-is-internal))
      (error "GNU reverse lookup changed"))))
(let ((map (make-sparse-keymap)) (sub (make-sparse-keymap)))
  (define-key map [97] 'nelisp-where-command)
  (define-key sub [120] 'nelisp-where-command)
  (define-key map [menu-bar file] (cons "File" sub))
  (unless (equal (where-is-internal 'nelisp-where-command (list map))
                 '([97] [menu-bar file 120]))
    (error "Sparse/menu breadth-first reverse lookup differs"))
  (unless (equal (where-is-internal 'nelisp-where-command (list map) 'non-ascii) [97])
    (error "First binding reverse lookup differs")))
(let ((map (make-sparse-keymap)) (parent (make-sparse-keymap)))
  (define-key parent [97] 'nelisp-where-command)
  (set-keymap-parent map parent)
  (unless (equal (where-is-internal 'nelisp-where-command (list map)) '([97]))
    (error "Inherited binding missing"))
  (define-key map [97] 'shadow)
  (unless (null (where-is-internal 'nelisp-where-command (list map)))
    (error "Shadowed inherited binding returned")))
(let ((map (make-sparse-keymap)))
  (define-key map [97] 'nelisp-original-command)
  (define-key map [remap nelisp-original-command] 'nelisp-remapped-command)
  (unless (and (equal (where-is-internal 'nelisp-remapped-command (list map)) '([97]))
               (equal (where-is-internal 'nelisp-original-command (list map)) '([97]))
               (equal (where-is-internal 'nelisp-remapped-command (list map) nil nil t)
                      '([remap nelisp-original-command])))
    (error "Command remapping reverse lookup differs")))
(let* ((map (make-sparse-keymap))
       (item '(menu-item "Item" nelisp-where-command)))
  (define-key map [entry] item)
  (unless (null (where-is-internal 'nelisp-where-command (list map) nil t))
    (error "NOINDIRECT unexpectedly extracted menu command")))
(princ "SPARSE-WHERE-IS-PASS\n")
