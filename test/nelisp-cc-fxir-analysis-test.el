;;; nelisp-cc-fxir-analysis-test.el --- M0 source diagnostics -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-cc-fxir-analysis nil t)
(defvar nelisp-cc-fxir-native-windows)
(let ((nelisp-cc-fxir-native-windows t)) (require 'nelisp-cc-fxir-native))

(defun nfa--row (ir &optional callees)
  (list 'fixture 17 2 callees (list :fn ir) '(2 2 -1)))

(defun nfa--reason (row reason &optional code)
  (let ((report (nelisp-cc-fxir-analysis-row row code)))
    (should (memq reason (plist-get report :refusals)))
    report))

(ert-deftest nfa-focused-api-present ()
  (should (fboundp 'nelisp-cc-fxir-analysis-row))
  (should (plist-get (nelisp-cc-fxir-analysis-row (nfa--row '(:slot 0))) :valid)))

(ert-deftest nfa-nested-preorder-structural-sites ()
  (let* ((row (nfa--row '(:call 1 2 (:call 4 0) (:call 7 0)) '(outer left right)))
         (a (nelisp-cc-fxir-analysis-row row))
         (b (nelisp-cc-fxir-analysis-row (copy-tree row))))
    (should (equal a b))
    (should (equal (mapcar (lambda (s) (plist-get s :id)) (plist-get a :sites))
                   '((17 (1)) (17 (1 3)) (17 (1 4)))))
    (should (equal (mapcar (lambda (s) (plist-get s :callee)) (plist-get a :sites))
                   '(outer left right)))
    (should (eq (plist-get a :callee-proof) :positional-only))
    (should (cl-every (lambda (s) (eq (plist-get s :identity-proof) :absent))
                      (plist-get a :sites)))))

(ert-deftest nfa-validated-code-mapping-and-mutants ()
  (let* ((row (nfa--row '(:call 1 1 (:call 4 0)) '(outer inner)))
         (code [16 [outer nil nil nil nil] 1 16 [inner nil nil nil nil] 0]))
    (should (plist-get (nelisp-cc-fxir-analysis-row row code) :valid))
    ;; The old lowering accepts the same syntax with a wrong positional name.
    (let ((wrong (copy-tree row)))
      (setcar (nth 3 wrong) 'wrong)
      (should (eq (car (nelisp-cc-fxir-native--defun wrong)) 'defun))
      (should-not (plist-get (nfa--reason wrong :callee-code-mismatch code) :valid)))
    (dolist (mutant '([16 [outer nil] 1 16 [inner nil nil nil nil] 0]
                      [16 [outer nil nil nil nil] 2 16 [inner nil nil nil nil] 0]))
      (should-not (plist-get (nfa--reason row :callee-code-mismatch mutant) :valid)))
    (let ((wrong-op (copy-sequence code)))
      (aset wrong-op 0 1)
      (nfa--reason row :code-operand-mismatch wrong-op))))

(ert-deftest nfa-missing-and-extra-metadata ()
  (nfa--reason (nfa--row '(:call 1 0)) :missing-callee)
  (let ((row (nfa--row '(:slot 0) '(unused))))
    (should (eq (car (nelisp-cc-fxir-native--defun row)) 'defun))
    (should-not (plist-get (nfa--reason row :extra-callee) :valid))))

(ert-deftest nfa-arity-and-cache-indices ()
  (nfa--reason (nfa--row '(:call 1 2 (:slot 0)) '(f)) :call-arity-mismatch)
  (nfa--reason (nfa--row '(:call -1 0) '(f)) :invalid-index)
  (nfa--reason (nfa--row '(:call 100 0) '(f)) :code-operand-mismatch [16]))

(ert-deftest nfa-canonical-constant-owner-and-no-code-values ()
  (let* ((row (nfa--row '(:seq (:const 1) (:const 3))))
         (report (nelisp-cc-fxir-analysis-row row [1 nil 1 t])))
    (should (plist-get report :constant-proof))
    (should (equal (mapcar (lambda (c) (plist-get c :owner)) (plist-get report :constants)) '(17 17)))
    (should (equal (mapcar (lambda (c) (plist-get c :kind)) (plist-get report :constants)) '(:nil :true)))
    (should (equal (mapcar (lambda (c) (plist-get c :index)) (plist-get report :constants)) '(1 3)))))

(ert-deftest nfa-unproved-and-heap-constants ()
  (dolist (value '(7 2305843009213693952 "opaque-pointer-sentinel" (x) [x]))
    (let ((report (nfa--reason (nfa--row '(:const 1)) :unproved-constant (vector 1 value))))
      (should-not (plist-get report :constant-proof))
      (should-not (string-match-p "opaque-pointer-sentinel" (prin1-to-string report)))))
  (nfa--reason (nfa--row '(:const 1)) :unproved-constant)
  (nfa--reason (nfa--row '(:const 1)) :non-immediate-constant [1 [heap]]))

(ert-deftest nfa-shape-and-binding-rejection ()
  (dolist (ir '((:slot 0 extra) (:if (:nil)) (:const . 1)))
    (should-not (plist-get (nelisp-cc-fxir-analysis-row (nfa--row ir)) :valid)))
  (nfa--reason (nfa--row '(:slot 9)) :invalid-slot)
  (dolist (ir '((:slot 0) (:setslot 0 (:nil))))
    (let ((row (nfa--row ir)))
      (setcar (nthcdr 2 row) 0)
      (setcar (nthcdr 5 row) '(0 0 -1))
      (nfa--reason row :invalid-slot)))
  (dolist (ir '((:inline 999 1) (:inline 7 1 (:slot 0) (:slot 1))))
    (nfa--reason (nfa--row ir) :inline-opcode-or-arity))
  (dolist (arity '((3 3 -1) (1 3 -1) (1 -1 -1) (1 -1 2)))
    (let ((row (nfa--row '(:nil))))
      (setcar (nthcdr 5 row) arity)
      (nfa--reason row :invalid-arity)))
  (nfa--reason (nfa--row '(:let ((:store 0 (:nil))) (:slot 0) 1)) :binding-count-mismatch)
  (nfa--reason (nfa--row '(:let ((:unknown 0 (:nil))) (:slot 0) 0)) :invalid-binding)
  (nfa--reason (nfa--row '(:value 10000)) :unknown-node))

(ert-deftest nfa-effects-and-m0-admission-refusal ()
  (let* ((row (nfa--row '(:let ((:varbind 1 (:varref 3)))
                              (:while (:slot 0) (:inline 4 5 (:slot 0) (:slot 1))) 1)))
         (report (nelisp-cc-fxir-analysis-row row)))
    (should (plist-get report :valid))
    (dolist (reason '(:m0-no-transform :dynamic-binding :loop :unproved-operation :mutable-global-or-alias))
      (should (memq reason (plist-get report :refusals))))
    (dolist (effect '(:mutable-cell-read :dynamic-binding :poll-or-gc :unproved-primitive :signal-or-reentry))
      (should (memq effect (plist-get report :effects))))))

(ert-deftest nfa-handler-and-let-mapping-order ()
  (let* ((row (nfa--row '(:let ((:store 0 (:call 1 0)))
                              (:condition-case 1 (:call 4 0) (:call 7 0)
                                               (10 (:catch (:call 11 0) (:throw (:call 14 0) (:call 17 0))))) 0)
                       '(init body success tag throwtag value)))
         (report (nelisp-cc-fxir-analysis-row row)))
    (should (plist-get report :valid))
    (should (equal (mapcar (lambda (s) (plist-get s :callee)) (plist-get report :sites))
                   (nth 3 row)))
    (should (equal (plist-get (car (plist-get report :sites)) :id) '(17 (1 1 0 2))))))

(ert-deftest nfa-disabled-and-enabled-codegen-identical ()
  (let ((row (nfa--row '(:call 1 1 (:slot 0)) '(identity)))
        (count 0) disabled enabled)
    (should-not nelisp-cc-fxir-native-diagnostics)
    (let ((nelisp-cc-fxir-native-diagnostics nil)
          (nelisp-cc-fxir-native-diagnostic-function (lambda (_) (ert-fail "Disabled callback ran"))))
      (setq disabled (nelisp-cc-fxir-native--defun row)))
    (let ((nelisp-cc-fxir-native-diagnostics t)
          (nelisp-cc-fxir-native-diagnostic-function
           (lambda (report) (should (plist-get report :valid)) (setq count (1+ count)))))
      (setq enabled (nelisp-cc-fxir-native--defun row)))
    (should (= count 1)) (should (equal disabled enabled))))

(ert-deftest nfa-digest-provenance-and-syntax-sensitivity ()
  (let ((a (nelisp-cc-fxir-analysis-row (nfa--row '(:slot 0))))
        (b (nelisp-cc-fxir-analysis-row (nfa--row '(:slot 1)))))
    (should (= (length (plist-get a :syntax-sha256)) 64))
    (should-not (equal (plist-get a :syntax-sha256) (plist-get b :syntax-sha256)))
    (should (eq (plist-get a :digest-provenance) :harvested-row-syntax))))

(ert-deftest nfa-depth-budget-and-circular-shape ()
  (let ((ir '(:slot 0)))
    (dotimes (_ 50) (setq ir (list :seq ir)))
    (nfa--reason (nfa--row ir) :analysis-budget))
  (let ((ir (list :seq)))
    (setcdr ir ir)
    (nfa--reason (nfa--row ir) :invalid-node-shape)))

(ert-deftest nfa-harvested-row-metadata-full-walk ()
  (let ((rows (nelisp-cc-fxir-native--rows)) (valid 0) (invalid 0))
    (should rows)
    (dolist (row rows)
      (let ((report (nelisp-cc-fxir-analysis-row row)))
        (if (plist-get report :valid) (setq valid (1+ valid))
          (setq invalid (1+ invalid))
          (ert-fail (list (car row) (plist-get report :refusals))))
        (should (equal (mapcar (lambda (s) (plist-get s :callee)) (plist-get report :sites)) (nth 3 row)))))
    (message "M0-HARVEST-COUNT valid=%d invalid=%d" valid invalid)))

(provide 'nelisp-cc-fxir-analysis-test)
