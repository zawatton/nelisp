;;; standalone-abi-evaluator-entry-word-check.el --- Evaluator entry parity -*- lexical-binding: t; -*-

(defmacro abi-entry-zero () 0)
(let ((checked 0)
      (values (list nil t 0 -7 2305843009213693951 -2305843009213693952
                    2305843009213693952 1.25 "entry" '(a . b) [nil t -7] :entry)))
  (dolist (value values)
    ;; Exercise both the constant-return shortcut and the general WORD VM.
    (dolist (code (list (unibyte-string 192 135) (unibyte-string 192 136 193 135)))
      (let ((result (byte-code code (vector value value) 2)))
        (unless (equal result value) (error "byte-code entry result changed: %S" value))
        (setq checked (1+ checked))))
    (dolist (form (list (list 'quote value) (list 'identity (list 'quote value))))
      (unless (equal (eval form t) value) (error "evaluator entry result changed: %S" value))
      (setq checked (1+ checked))))
  (dolist (value '(nil t 0 -7 1.25 "literal" [nil t -7] :entry))
    (unless (equal (eval value t) value) (error "self-evaluating form changed: %S" value))
    (setq checked (1+ checked)))
  (dolist (case '(((if t 17 23) 17) ((if nil 17 -7) -7)
                  ((when t 17) 17) ((unless nil -7) -7)
                  ((and t 17) 17) ((or nil -7) -7)
                  ((cond (t 17)) 17) ((prog1 17 nil) 17)
                  ((prog2 nil -7 nil) -7) ((while nil 17) nil)
                  ((unwind-protect 17 nil) 17)
                  ((condition-case nil -7 (error 23)) -7)
                  ((let (value) (setq value 17) value) 17)
                  ((condition-case e (eval '(nil) t) (error (list (car e) (cadr e))))
                   (void-function nil))
                  ((condition-case e (eval '(t) t) (error (list (car e) (cadr e))))
                   (void-function t))
                  ((condition-case e (eval '(1) t) (error (list (car e) (cadr e))))
                   (invalid-function 1))
                  ((abi-entry-zero) 0)))
    ;; Reuse the same AST: immediate macro expansions must also survive a
    ;; second evaluation of a previously cached call.
    (dotimes (_ 2)
      (unless (equal (eval (car case) t) (nth 1 case))
        (error "literal evaluator caller changed: %S" (car case)))
      (setq checked (1+ checked))))
  (let (caught)
    (condition-case nil (byte-code 17 [] 1)
      (error (setq caught t)))
    (unless caught (error "byte-code type error lost"))
    (setq checked (1+ checked)))
  (princ (format "ABI-EVALUATOR-ENTRY checked=%d PASS\n" checked)))
nil
