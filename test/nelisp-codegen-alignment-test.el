;;; nelisp-codegen-alignment-test.el --- code placement contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'nelisp-aot-compiler)
(require 'nelisp-static-linker)
(ert-deftest nelisp-codegen-alignment/function-and-loop ()
  (let* ((nelisp-aot-compiler--arch 'x86_64)
         (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--label-counter 0)
         (ir (nelisp-aot-compiler--parse
              '(seq (defun ca_first (x) (+ x 1))
                    (defun ca_loop (n)
                      (let ((i 0)) (while (< i n) (setq i (+ i 1))) i))) nil))
         (buf (nelisp-asm-x86_64-make-buffer)))
    (dolist (d (nelisp-aot-compiler--collect-defuns ir))
      (nelisp-aot-compiler--emit-defun d buf))
    (nelisp-asm-x86_64-resolve-fixups buf)
    (let ((checked 0))
      (dolist (label (nelisp-asm-x86_64-buffer-labels buf))
        (when (or (memq (car label) '(ca_first ca_loop))
                  (string-match-p "while-.*-start$" (symbol-name (car label))))
          (should (= 0 (mod (cdr label) 16)))
          (setq checked (1+ checked))))
      (should (= checked 3)))))
(ert-deftest nelisp-codegen-alignment/link-unit-boundaries ()
  (let* ((units (list (nelisp-link-unit-make "a" '((text . "abc")) nil nil)
                      (nelisp-link-unit-make "b" '((text . "def")) nil nil)))
         (combined (nelisp-link-combine-sections units 'x86_64))
         (text (cdr (assq 'text combined))))
    (should (= 16 (cdr (assoc "b" (plist-get text :offsets)))))
    (should (equal "def" (substring (plist-get text :bytes) 16)))))
(ert-deftest nelisp-codegen-alignment/pe-import-entries ()
  (let* ((imports '(("KERNEL32.dll" "ExitProcess" "GetTickCount")))
         (info '(:iat-rva-alist (("ExitProcess" . 8192)
                                 ("GetTickCount" . 8200))))
         (unit (nelisp-link--pe-import-thunk-unit
                imports #x140001000 16 info 'x86_64))
         (text (cdr (assq 'text (plist-get unit :sections))))
         (symbols (plist-get unit :symbols)))
    (should (= 32 (length text)))
    (should (equal '(0 16) (mapcar (lambda (s) (plist-get s :value)) symbols)))
    (should (equal (substring text 16 18) (unibyte-string #xff #x25)))))
(ert-deftest nelisp-codegen-alignment/elf-text-origin-and-rodata ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((file (make-temp-file "nelisp-aligned-text-")))
    (unwind-protect
        (progn
          (nelisp-aot-compile-sexp '(seq (write "aligned\n") (exit 0)) file)
          (with-temp-buffer
            (should (= 0 (call-process "nm" nil t nil file)))
            (goto-char (point-min))
            (should (re-search-forward "^\\([[:xdigit:]]+\\) T _start$" nil t))
            (should (= 0 (mod (string-to-number (match-string 1) 16) 16))))
          (with-temp-buffer
            (should (= 0 (call-process file nil t)))
            (should (equal "aligned\n" (buffer-string)))))
      (delete-file file))))
(provide 'nelisp-codegen-alignment-test)
