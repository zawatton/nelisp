;;; standalone-active-symbol-entry-driver.el --- Active mirror regression -*- lexical-binding: t; -*-

(defvar nelisp-active-entry-probe-v 10)
(setq nelisp-active-entry-probe-v 11)
(fset 'nelisp-active-entry-probe-f (lambda (x) (+ x 5)))
(put 'nelisp-active-entry-probe-f 'probe-property 'kept)
(unless (and (= (funcall 'nelisp-active-entry-probe-f 7) 12)
             (eq (get 'nelisp-active-entry-probe-f 'probe-property) 'kept))
  (error "function/plist initial check failed"))
(let ((fn (symbol-function 'nelisp-active-entry-probe-f))
      (plist (symbol-plist 'nelisp-active-entry-probe-f))
      (during nil))
  (let ((nelisp-active-entry-probe-v 22))
    (setq during (symbol-value 'nelisp-active-entry-probe-v))
    (unless (= during 22) (error "dynamic let read failed")))
  (unless (and (= (symbol-value 'nelisp-active-entry-probe-v) 11)
               (eq fn (symbol-function 'nelisp-active-entry-probe-f))
               (eq plist (symbol-plist 'nelisp-active-entry-probe-f)))
    (error "dynamic restore or function/plist independence failed")))
(setq nelisp-active-entry-probe-v 31)
(garbage-collect)
(unless (and (= (symbol-value 'nelisp-active-entry-probe-v) 31)
             (= (funcall 'nelisp-active-entry-probe-f 8) 13)
             (eq (get 'nelisp-active-entry-probe-f 'probe-property) 'kept))
  (error "post-GC value/function/plist check failed"))
(makunbound 'nelisp-active-entry-probe-v)
(unless (and (not (boundp 'nelisp-active-entry-probe-v))
             (condition-case nil (progn (symbol-value 'nelisp-active-entry-probe-v) nil)
               (void-variable t)))
  (error "makunbound check failed"))
(princ "ACTIVE-SYMBOL-ENTRY-PASS\n")
nil

