;;; nelisp-aot-compare-tree-test.el --- Comparison register trees -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'nelisp-aot-pure-tree-test)

(defun nelisp-aot-compare-tree-test--run (program)
  (let ((defs (cl-remove-if-not (lambda (f) (eq (car-safe f) 'defun)) (cdr program)))
        (forms (cl-remove-if (lambda (f) (eq (car-safe f) 'defun)) (cdr program))))
    (cl-labels ((status (x)
                  (cond ((not (consp x)) x)
                        ((eq (car x) 'exit) (cadr x))
                        (t (mapcar #'status x)))))
      (nelisp-aot-pure-tree-test--run
       `(seq ,@defs (defun compare-main () (seq ,@(mapcar #'status forms)))
             (exit (compare-main)))))))

(ert-deftest nelisp-aot-compare-tree/nonleaf-operands-avoid-stack ()
  (let* ((nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (nelisp-aot-compiler--rsp-temp-depth 0)
         (a (nelisp-aot-pure-tree-test--pair))
         (b (nelisp-aot-pure-tree-test--pair))
         (buf (nelisp-asm-x86_64-make-buffer)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-temp-push)
               (lambda (&rest _) (ert-fail "comparison pushed an operand")))
              ((symbol-function 'nelisp-aot-compiler--emit-temp-pop)
               (lambda (&rest _) (ert-fail "comparison popped an operand"))))
      (should-not (nelisp-aot-compiler--emit-compare-x86 a b buf '<)))
    (should (> (length (nelisp-asm-x86_64-buffer-bytes buf)) 0))
    (should (= 0 nelisp-aot-compiler--rsp-temp-depth))))

(ert-deftest nelisp-aot-compare-tree/preflight-and-protected-fallback ()
  (let* ((nelisp-aot-compiler--x86-call-containing-defun-p t)
         (pair (nelisp-aot-pure-tree-test--pair))
         (selected 0)
         (original (symbol-function 'nelisp-aot-compiler--emit-memory-tree-binop-x86)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-memory-tree-binop-x86)
               (lambda (op a b buf)
                 (let ((result (funcall original op a b buf)))
                   (when result (setq selected (1+ selected)))
                   result))))
      (dolist (mode '(leaf checked live))
        (let ((nelisp-aot-compiler--x86-call-containing-defun-p (not (eq mode 'leaf)))
              (nelisp-aot-compiler--checked-arith (eq mode 'checked))
              (nelisp-aot-compiler--promoted-slots (and (eq mode 'live) '((0 . rdi))))
              (nelisp-aot-compiler--rsp-temp-depth 0)
              (buf (nelisp-asm-x86_64-make-buffer)))
          (nelisp-aot-compiler--emit-compare-x86 pair pair buf '=)))
      (should (= 0 selected)))
    (dolist (bad (list (nelisp-aot-pure-tree-test--ir 'call :name 'opaque)
                      (nelisp-aot-pure-tree-test--ir 'setq-local :slot 0 :value-ir pair)
                      (nelisp-aot-pure-tree-test--ir 'shift :op 'shl :a pair
                        :b (nelisp-aot-pure-tree-test--ref 1))))
      (should-not (nelisp-aot-compiler--x86-memory-tree-info bad)))))

(ert-deftest nelisp-aot-compare-tree/gnu-fullword-value-branch-and-WORD ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((cases 0))
    (dolist (op '(< > <= >= = /=))
      (dolist (args '((0 1 2 3) (-1 2 -3 4)
                      (4294967299 8589934597 1099511627783 -17179869193)
                      (9223372036854775807 1 -9223372036854775808 -1)))
        (pcase-let* ((`(,a ,b ,c ,d) args)
                     (left (nelisp-aot-pure-tree-test--wrap (+ a b)))
                     (right (nelisp-aot-pure-tree-test--wrap (logxor c d)))
                     (truth (funcall op left right))
                     (golden (if truth 137 71))
                     (compare `(,op (+ (ptr-read-u64 p 0) b)
                                    (logxor (ptr-read-u64 p 8) d))))
          ;; GNU computes wrapped signed64 operands independently of the
          ;; compiler. Native tests both boolean-value and branch consumers.
          (should (= 0 (nelisp-aot-compare-tree-test--run
                        `(seq (defun opaque (x) (+ x 17))
                              (defun f (p b d)
                                (seq (opaque 0)
                                     (+ (* 100 ,compare) (if ,compare 37 71))))
                              (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                                (seq (ptr-write-u64 p 0 ,a)
                                     (ptr-write-u64 p 8 ,c)
                                     (exit (if (= (f p ,b ,d) ,golden) 0 1))))))))
          (setq cases (1+ cases)))))
    ;; Effects between the operands must use the ordinary ordered path.
    (should (= 0 (nelisp-aot-compare-tree-test--run
                  '(seq (defun opaque (x) (+ x 17))
                        (defun f (a b)
                          (seq (opaque 0)
                               (< (seq (setq a (+ a 1)) (+ a b))
                                  (seq (setq b (+ b 9)) (+ a b)))))
                        (exit (if (f 2 4) 0 1))))))
    ;; A direct cons WORD2 has no readable header. A vectorlike WORD6
    ;; reads [word-6] only inside its guarded branch, masking the kind.
    (should (= 0 (nelisp-aot-compare-tree-test--run
                  '(seq (defun opaque (x) (+ x 17))
                        (defun tag-check (w x)
                          (seq (opaque 0)
                               (if (= (logand w 7) 2) 7
                                 (if (= (logand w 7) 6)
                                     (if (= (+ (logand (ptr-read-u8 w -6) 63) x)
                                            (logxor x 23)) 23 99)
                                   0))))
                        (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                          (seq (ptr-write-u8 p 0 87)
                               (exit (if (and (= (tag-check 2 0) 7)
                                              (= (tag-check (+ p 6) 0) 23)) 0 1))))))))
    (message "Comparison trees: %d GNU fullword cases plus ordered effects and WORD guards" cases)))

(provide 'nelisp-aot-compare-tree-test)
;;; nelisp-aot-compare-tree-test.el ends here
