;;; nelisp-interp2-corpus.el --- Interpreted subr calls and lexical variables -*- lexical-binding: t; -*-

;; interp2: every case enters EVAL with an unevaluated form.  The same file runs
;; unchanged on GNU Emacs and on NeLisp; the outputs must be byte-equal.  It covers
;; the subrs the interpreter now calls from their function cell's Subr object (every
;; name below), their arity errors before any evaluation, declined shapes, evaluation
;; order, redefinition and advice of the cell, lexical reads from the newest frame and
;; from outer frames, closures capturing lexicals, setq of lexical and special
;; variables, macros, special forms and the backtrace of an interpreted builtin call.
(defvar wi2-g 100)
(defvar wi2-s 7)
(defvar wi2-table (make-hash-table :test 'eq))
(puthash 'k 'v wi2-table)

(defconst wi2-cases
  '(;; the subrs, plain
    (plus (+ 1 2)) (plus-0 (+)) (plus-1 (+ 5)) (plus-float (+ 1 2.5)) (plus-huge (+ 2305843009213693951 1))
    (minus (- 9 4)) (minus-1 (- 4)) (minus-0 (-)) (minus-float (- 5 0.5))
    (times (* 6 7)) (times-0 (*)) (times-1 (* 8)) (times-3 (* 2 3 4))
    (rem (% 13 4)) (rem-neg (% -13 4)) (rem-zero (% 1 0)) (rem-float (% 13.0 4))
    (inc (1+ 4)) (dec (1- 4)) (inc-float (1+ 1.5)) (inc-huge (1+ 2305843009213693951))
    (eqn (= 3 3)) (eqn-3 (= 3 3 3)) (eqn-float (= 3 3.0)) (eqn-type (= 1 'a)) (eqn-1 (= 1))
    (lt (< 1 2)) (lt-3 (< 1 2 3)) (lt-3b (< 1 3 2)) (lt-float (< 1 1.5)) (lt-type (< 'a 1))
    (gt (> 2 1)) (le (<= 2 2)) (ge (>= 1 2)) (ge-3 (>= 3 2 1)) (gt-1 (> 1))
    (car (car '(a b))) (car-nil (car nil)) (car-type (car 'a)) (car-dotted (car '(a . b)))
    (cdr (cdr '(a b))) (cdr-nil (cdr nil)) (cdr-type (cdr 7))
    (cons (cons 1 2)) (cons-list (cons 1 '(2))) (cons-arity (cons 1))
    (list (list 1 2 3)) (list-0 (list)) (list-7 (list 1 2 3 4 5 6 7)) (list-8 (list 1 2 3 4 5 6 7 8))
    (eq (eq 'a 'a)) (eq-int (eq 5 5)) (eq-str (eq "a" "a")) (eq-arity (eq 1))
    (null (null nil)) (null-2 (null 1)) (not (not nil)) (not-arity (not))
    (consp (consp '(1))) (consp-nil (consp nil)) (consp-arity (consp 1 2))
    (setcar (let ((c (list 1 2))) (list (setcar c 9) c)))
    (setcdr (let ((c (list 1 2))) (list (setcdr c 9) c)))
    (setcar-type (setcar 'a 1))
    (nth (nth 1 '(a b c))) (nth-high (nth 9 '(a))) (nth-neg (nth -1 '(a b))) (nth-type (nth 'x '(a)))
    (nthcdr (nthcdr 2 '(a b c d))) (nthcdr-0 (nthcdr 0 '(a))) (nthcdr-type (nthcdr 'x '(a)))
    (length (length '(1 2 3))) (length-str (length "abc")) (length-vec (length [1 2])) (length-type (length 5))
    (concat (concat "ab" "cd")) (concat-0 (concat)) (concat-list (concat '(?a ?b) "c"))
    (substring (substring "hello" 1 3)) (substring-neg (substring "hello" -2)) (substring-range (substring "hi" 3))
    (make-string (make-string 3 ?x)) (make-string-type (make-string 'a ?x))
    (make-vector (make-vector 3 'a)) (make-vector-neg (make-vector -1 0))
    (vector (vector 1 2 3)) (vector-0 (vector))
    (aref (aref [a b c] 2)) (aref-str (aref "abc" 1)) (aref-high (aref [a] 5)) (aref-arity (aref [a]))
    (aset (let ((v (make-vector 3 0))) (list (aset v 1 'x) v))) (aset-high (aset (make-vector 1 0) 4 1))
    (logand (logand 12 10)) (logand-0 (logand)) (logand-3 (logand 15 7 3)) (logand-type (logand 1.5 1))
    (string< (string< "a" "b")) (string<-sym (string< 'a 'b)) (string<-type (string< 1 "a"))
    (gethash (gethash 'k wi2-table)) (gethash-default (gethash 'z wi2-table 'dflt))
    (gethash-type (gethash 'k 5))
    (puthash (progn (puthash 'k2 'v2 wi2-table) (gethash 'k2 wi2-table)))
    (remhash (progn (puthash 'k3 1 wi2-table) (remhash 'k3 wi2-table) (gethash 'k3 wi2-table 'gone)))
    (hash-table-count (progn (clrhash wi2-table) (puthash 1 1 wi2-table) (hash-table-count wi2-table)))
    (funcall (funcall #'+ 1 2)) (funcall-sym (funcall '+ 1 2)) (funcall-0 (funcall #'list))
    (apply (apply #'+ 1 2 '(3 4))) (apply-1 (apply #'list '(1 2))) (apply-dotted (apply #'+ '(1 . 2)))
    (identity (identity 5))
    ;; arity before evaluation, evaluation order, one evaluation of declined shapes
    (arity-before-eval (let ((i 0)) (list (condition-case e (car (setq i 1) 2) (error e)) i)))
    (arity-before-eval-n (let ((i 0)) (list (condition-case e (cons (setq i 1)) (error e)) i)))
    (eval-order (let ((i 0)) (list (list (setq i (+ i 1)) (setq i (+ i 10)) (setq i (* i 2))) i)))
    (eval-order-lt (let ((i 0)) (list (< (setq i 3) (setq i (+ i 1))) i)))
    (decline-once (let ((i 0)) (list (+ (progn (setq i (+ i 1)) 1.5) (progn (setq i (+ i 1)) 2)) i)))
    (improper-args (condition-case e (eval '(car . x) t) (error e)))
    (improper-args-2 (condition-case e (eval '(+ 1 . 2) t) (error e)))
    ;; lexical variables: newest frame, outer frames, shadowing, absent, special
    (lex-newest (let ((a 1) (b 2) (c 3)) (list a b c)))
    (lex-outer (let ((a 1)) (let ((b 2)) (let ((c 3)) (list a b c)))))
    (lex-shadow (let ((a 1)) (let ((a 2)) (let ((b a)) (list a b)))))
    (lex-shadow-outer (let ((a 1) (b 2)) (let ((c 3)) (list (let ((a 9)) a) a b c))))
    (lex-star (let* ((a 1) (b (+ a 1)) (c (+ a b))) (list a b c)))
    (lex-special-read (let ((a 1)) (list a wi2-g)))
    (lex-unbound (condition-case e (let ((a 1)) (list a wi2-undefined-var)) (error e)))
    (lex-unbound-outer (condition-case e (let ((a 1)) (let ((b 2)) (list a b wi2-undefined-var))) (error e)))
    (lex-keyword (let ((a 1)) (list a :kw)))
    (lex-deep (let ((a 1)) (let ((b 2)) (let ((c 3)) (let ((d 4)) (let ((e 5)) (list a b c d e)))))))
    (lex-loop (let ((i 0) (n 5) (sum 0)) (while (< i n) (setq sum (+ sum i)) (setq i (1+ i))) (list i sum)))
    (lex-loop-outer (let ((n 5)) (let ((i 0) (sum 0)) (while (< i n) (setq sum (+ sum n)) (setq i (1+ i))) (list i sum))))
    (lex-loop-three (let ((n 4) (m 2)) (let ((k 1)) (let ((i 0) (sum 0)) (while (< i n) (setq sum (+ sum m k)) (setq i (1+ i))) (list i sum)))))
    ;; setq of lexical and special variables
    (setq-lex (let ((a 1)) (setq a 5) a))
    (setq-lex-outer (let ((a 1)) (let ((b 2)) (setq a (+ a b)) (list a b))))
    (setq-two (let ((a 1) (b 2)) (setq a 10 b 20) (list a b)))
    (setq-special (progn (setq wi2-g 101) wi2-g))
    (setq-special-let (let ((wi2-s 8)) (setq wi2-s 9) wi2-s))
    (setq-special-after (list wi2-s (let ((wi2-s 3)) (setq wi2-s 4)) wi2-s))
    (setq-mixed (let ((a 1)) (setq a 2 wi2-g 102) (list a wi2-g)))
    (setq-keyword (condition-case e (setq :kw 1) (error e)))
    (setq-const (condition-case e (setq nil 1) (error e)))
    (setq-odd (condition-case e (eval '(setq a) t) (error e)))
    (setq-unbound (progn (setq wi2-new-global 5) wi2-new-global))
    ;; closures capturing lexicals
    (closure-capture (let ((a 1)) (let ((f (lambda (x) (+ a x)))) (list (funcall f 2) (funcall f 3)))))
    (closure-counter (let ((n 0)) (let ((inc (lambda () (setq n (1+ n))))) (funcall inc) (funcall inc) n)))
    (closure-shared (let ((n 0)) (let ((a (lambda () (setq n (+ n 1)))) (b (lambda () n))) (funcall a) (funcall a) (funcall b))))
    (closure-shadow (let ((a 1)) (let ((f (lambda (a) (+ a 10)))) (list (funcall f 5) a))))
    (closure-outer-two (let ((a 1)) (let ((b 2)) (funcall (lambda () (list a b))))))
    (closure-in-loop (let ((fs nil)) (dotimes (i 3) (push (lambda () i) fs)) (mapcar #'funcall fs)))
    (lambda-call ((lambda (a b) (+ a b)) 1 2))
    (lambda-rest ((lambda (a &rest r) (list a r)) 1 2 3))
    (lambda-optional ((lambda (a &optional b) (list a b)) 1))
    ;; macros and special forms
    (macro-when (when t 1 2)) (macro-unless (unless nil 1 2))
    (macro-push (let ((l nil)) (push 1 l) (push 2 l) l))
    (macro-pop (let ((l (list 1 2))) (list (pop l) l)))
    (macro-dolist (let ((s 0)) (dolist (x '(1 2 3)) (setq s (+ s x))) s))
    (macro-dotimes (let ((s 0)) (dotimes (i 4) (setq s (+ s i))) s))
    (macro-and-or (list (and 1 2) (and) (or nil 3) (or)))
    (macro-cond (cond ((= 1 2) 'a) ((= 2 2) 'b) (t 'c)))
    (macro-if (if (< 1 2) 'y 'n)) (macro-prog1 (prog1 1 2)) (macro-progn (progn 1 2 3))
    (macro-condition-case (condition-case e (car 1) (wrong-type-argument (list 'caught (car e)))))
    (macro-unwind (let ((x 0)) (list (catch 'out (unwind-protect (throw 'out 'thrown) (setq x 1))) x)))
    (macro-let-over-lambda (let ((n 0)) (list (funcall (lambda () (setq n 5))) n)))
    (special-quote (quote (a . b))) (special-function (function car))
    (special-while (let ((i 0)) (while (< i 3) (setq i (1+ i))) i))
    ;; redefinition and advice of a Subr-object cell
    ;; alias of a builtin through its definition (a list, not the Subr object)
    (alias (progn (fset 'wi2-plus-alias (symbol-function '+)) (wi2-plus-alias 1 2)))
    (alias-sym (progn (defalias 'wi2-car-alias 'car) (wi2-car-alias '(a b))))
    (alias-lt (progn (fset 'wi2-lt-alias (symbol-function '<)) (list (wi2-lt-alias 1 2) (wi2-lt-alias 2 1))))
    (symbol-function-stable (list (eq (symbol-function '+) (symbol-function '+)) (consp (symbol-function 'car)) (subrp (symbol-function '<))))
    (fboundp (list (fboundp '<) (fboundp 'aref) (functionp '+) (functionp '<)))))

(defun wi2-print-case (name form)
  (let ((value (condition-case e (eval form t) (error e))))
    (princ (format "%S\n" (list name value)))))

(dolist (case wi2-cases) (wi2-print-case (car case) (cadr case)))

;; dynamic binding mode
(dolist (case '((dyn-read (let ((a 1) (b 2)) (list a b)))
                (dyn-nested (let ((a 1)) (let ((b 2)) (list a b))))
                (dyn-setq (let ((a 1)) (setq a 2) a))
                (dyn-closure-call (let ((a 1)) (funcall (lambda () a))))
                (dyn-loop (let ((i 0) (n 3) (s 0)) (while (< i n) (setq s (+ s i)) (setq i (1+ i))) (list i s)))))
  (princ (format "%S\n" (list (car case) (condition-case e (eval (cadr case) nil) (error e))))))

;; Redefinition and advice of the function cell: the interpreter reads the cell on every call.
(dolist (name '(+ - * % 1+ 1- = < > <= >= car cdr cons eq null not nth nthcdr length aref aset logand
                  consp setcar setcdr vector make-vector string< concat))
  (let ((saved (symbol-function name)) result)
    (unwind-protect
        (progn
          (fset name (lambda (&rest xs) (list 'redefined xs)))
          (setq result (eval (list name 10 20) t)))
      (fset name saved))
    (princ (format "%S\n" (list (list 'redefined name) result)
                   ))
    (princ (format "%S\n" (list (list 'restored name)
                                (condition-case e (eval (list name 1) t) (error e)))))))

(defun wi2-advice (original &rest args)
  (if (eq (car args) 'wi2-token) 'advised (apply original args)))
(dolist (name '(+ < cons aref length logand 1+))
  (let ((saved (symbol-function name)) result)
    (unwind-protect
        (progn (advice-add name :around #'wi2-advice)
               (setq result (eval (list name '(quote wi2-token)) t)))
      (advice-remove name #'wi2-advice)
      (fset name saved))
    (princ (format "%S\n" (list (list 'advised name) result)))))

;; Backtrace of an interpreted builtin call: the frames between the probe and the harness.
(defun wi2-frames ()
  (let ((frames nil) (i 0) f)
    (while (and (setq f (backtrace-frame i)) (< i 40))
      (when (and (symbolp (nth 1 f)) (not (memq (nth 1 f) '(eval funcall))))
        (push (list (nth 0 f) (nth 1 f) (and (nth 2 f) (consp (nth 2 f)) (nth 2 f))) frames))
      (setq i (1+ i)))
    (let ((out nil) (on nil))
      (dolist (fr (nreverse frames))
        (when (eq (nth 1 fr) 'wi2-probe) (setq on t))
        (when (eq (nth 1 fr) 'wi2-harness) (setq on nil))
        (when on (push fr out)))
      (nreverse out))))
(defun wi2-probe () (wi2-frames))
(defun wi2-harness (thunk) (funcall thunk))
(defun wi2-show (tag form)
  (princ (format "%S\n" (list tag (condition-case e (wi2-harness (lambda () (eval form t))) (error (list 'ERR e)))))))
(wi2-show 'bt-arg-of-plus '(+ 1 (length (wi2-probe))))
(wi2-show 'bt-arg-of-aref '(aref [a b] (car (list 1 (wi2-probe)))))
(wi2-show 'bt-arg-of-list '(list 1 (< 1 (length (wi2-probe)))))
(wi2-show 'bt-nested '(let ((a 1)) (cons a (wi2-probe))))
(wi2-show 'bt-nested-closure '(funcall (lambda (v) (list v (wi2-probe))) 3))
(wi2-show 'bt-error-plus '(+ 1 (car 'x)))
(wi2-show 'bt-error-arity '(car 1 2))
(wi2-show 'bt-error-lt '(let ((x 'a)) (< x 1)))
(wi2-show 'bt-error-aref '(aref [a] 5))
(wi2-show 'bt-error-closure '(funcall (lambda (v) (+ v (car v))) 3))

;; Debugger-visible frames: the form and arguments of the builtin that signals.
(wi2-show 'bt-signal-frames
          '(let ((r nil))
             (condition-case nil
                 (let ((debug-on-error nil))
                   (handler-bind ((error (lambda (_e) (setq r (mapcar (lambda (fr) (list (nth 1 fr) (nth 2 fr))) (let ((l nil) (i 0) f) (while (and (setq f (backtrace-frame i)) (< i 12)) (push f l) (setq i (1+ i))) (nreverse l)))))))
                     (+ 1 (car 'x))))
               (error nil))
             (let ((o nil)) (dolist (fr r) (when (memq (car fr) '(+ car)) (push fr o))) (nreverse o))))

(princ "WI2-CORPUS COMPLETE\n")
nil
