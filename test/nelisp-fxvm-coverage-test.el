;;; nelisp-fxvm-coverage-test.el --- Execute production FX forms -*- lexical-binding: t -*-

(require 'ert)
(require 'cl-lib)
(require 'nelisp-cc-fx-call-primitives)
(require 'nelisp-fx-ordinary-vector-test)

(defconst fxvm--root nelisp-fx-vector--root)
(defvar fxvm--memory nil)

(defun fxvm--read (base offset) (gethash (+ base offset) fxvm--memory 0))
(defun fxvm--write (base offset value) (puthash (+ base offset) value fxvm--memory) 0)

(defun fxvm--lower (x)
  "Run the numeric-boolean compiler DSL in host Emacs, with explicit memory."
  (cond
   ((atom x) x)
   ((memq (car x) '(= /= < <= > >=))
    `(if (,(car x) ,@(mapcar #'fxvm--lower (cdr x))) 1 0))
   ((eq (car x) 'if)
    `(if (/= ,(fxvm--lower (cadr x)) 0)
         ,(fxvm--lower (nth 2 x)) ,(fxvm--lower (nth 3 x))))
   ((memq (car x) '(and or))
    `(if (,(car x) ,@(mapcar (lambda (a) `(/= ,(fxvm--lower a) 0)) (cdr x))) 1 0))
   ((eq (car x) 'cond)
    `(cond ,@(mapcar (lambda (c) (cons (if (eq (car c) t) t `(/= ,(fxvm--lower (car c)) 0))
                                     (mapcar #'fxvm--lower (cdr c)))) (cdr x))))
   ((eq (car x) 'while) `(while (/= ,(fxvm--lower (cadr x)) 0) ,@(mapcar #'fxvm--lower (cddr x))))
   ((eq (car x) 'seq) (cons 'progn (mapcar #'fxvm--lower (cdr x))))
   ((eq (car x) 'let*) `(let* ,(mapcar (lambda (b) (list (car b) (fxvm--lower (cadr b)))) (cadr x))
                        ,@(mapcar #'fxvm--lower (cddr x))))
   ((eq (car x) 'sexp-name-eq) `(if (equal ,(cadr x) ,(nth 2 x)) 1 0))
   ((memq (car x) '(heap-read-u64 ptr-read-u64)) (cons 'fxvm--read (mapcar #'fxvm--lower (cdr x))))
   ((eq (car x) 'heap-read-u8) `(logand (fxvm--read ,@(mapcar #'fxvm--lower (cdr x))) 255))
   ((eq (car x) 'ptr-write-u64) (cons 'fxvm--write (mapcar #'fxvm--lower (cdr x))))
   ((eq (car x) 'shl) `(ash ,(fxvm--lower (cadr x)) ,(fxvm--lower (nth 2 x))))
   ((eq (car x) 'sar) `(ash ,(fxvm--lower (cadr x)) (- ,(fxvm--lower (nth 2 x)))))
   (t (mapcar #'fxvm--lower x))))

(defun fxvm--function (name &optional source)
  (let ((d (nelisp-fx-vector--def (or source nelisp-cc-fx-call-primitives--source) name)))
    (eval `(lambda ,(nth 2 d) ,@(mapcar #'fxvm--lower (nthcdr 3 d))) t)))

(ert-deftest fxvm-fixnum-id ()
  (let ((id (fxvm--function 'm5_fx_primitive_id)))
    (dolist (name '("%" "logand"))
      (dotimes (argc 5)
        (should (= (funcall id name argc)
                   (if (= argc 2) (if (equal name "%") -17 -18) 0)))))))

(ert-deftest fxvm-fixnum-values-and-declines ()
  (let ((fxvm--memory (make-hash-table :test 'eql))
        (run (fxvm--function 'm5_fx_primitive_run)))
    (cl-letf (((symbol-function 'nl_word_tag64) (lambda (w) (if (= (logand w 3) 1) 2 6))))
      (dolist (x (list most-negative-fixnum -17 -1 0 1 17 most-positive-fixnum))
        (dolist (y '(-17 -1 1 17))
          (fxvm--write 10000 0 (+ (* x 4) 1))
          (fxvm--write 10000 8 (+ (* y 4) 1))
          (dolist (entry '((-17 . %) (-18 . logand)))
            (should (= (funcall run (car entry) 10000 2 2 20000 0 0) 0))
            (should (= (fxvm--read 20000 0) (+ (* 4 (funcall (cdr entry) x y)) 1))))))
      ;; Nonfixnum words, zero divisor and nonbinary arities must decline
      ;; without writing RESW. The real interpreter tests cover delivery.
      (dolist (id '(-17 -18))
        (dolist (args '((100000 5) (5 100000) (3 5) (7 5)))
          (fxvm--write 10000 0 (car args)) (fxvm--write 10000 8 (cadr args))
          (fxvm--write 20000 0 999)
          (should (= (funcall run id 10000 2 2 20000 0 0) -3))
          (should (= (fxvm--read 20000 0) 999)))
        (dotimes (argc 5)
          (unless (= argc 2)
            (fxvm--write 20000 0 999)
            (should (= (funcall run id 10000 argc argc 20000 0 0) -3))
            (should (= (fxvm--read 20000 0) 999)))))
      (fxvm--write 10000 0 21) (fxvm--write 10000 8 1)
      (fxvm--write 20000 0 999)
      (should (= (funcall run -17 10000 2 2 20000 0 0) -3))
      (should (= (fxvm--read 20000 0) 999)))))

(ert-deftest fxvm-fresh-vector-argument ()
  (let* ((defs (cons 'seq (nelisp-fx-vector--extract
                         (expand-file-name "scripts/nelisp-standalone-build.el" fxvm--root)
                         '(m5_fx_run_body nl_word_canon))))
         (run (fxvm--function 'm5_fx_run_body defs))
         (canon (fxvm--function 'nl_word_canon defs))
         (fxvm--memory (make-hash-table :test 'eql)))
    ;; Investigation reproducer: local-ref 0, return, stack size 1. Both
    ;; entry paths retain the legacy view. Entry canonicalization was
    ;; withdrawn after its dedicated runtime failed weak-string-unrooted.
    (fxvm--write 10000 0 (+ (* 4 256) 8))
    (cl-loop for w in '(9 1 1 5) for i from 0 do (fxvm--write 10008 (* i 8) w))
    (fxvm--write 20000 0 8) (fxvm--write 20000 8 30000)
    (fxvm--write 30000 0 (+ (* 4 256) 8))
    (fxvm--write 40000 0 20000)
    (fxvm--write 60000 0 20000) (fxvm--write 60000 8 3)
    (cl-letf (((symbol-function 'nl_root_mark) (lambda (_) 0))
              ((symbol-function 'nl_root_frame) (lambda (_ n) (dotimes (i n) (fxvm--write 50000 (* i 8) 3)) 50000))
              ((symbol-function 'nl_root_release) (lambda (&rest _) 0))
              ((symbol-function 'nl_word_payload) (lambda (w) (- w (logand w 7))))
              ((symbol-function 'nl_vector_length) (lambda (w) (ash (fxvm--read (- w 6) 0) -8)))
              ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2)))
              ((symbol-function 'm5_fx_slot_word) (lambda (p _) (fxvm--read p 0)))
              ((symbol-function 'nl_word_canon) canon))
      (dolist (argw '(40000 0))
        (should (= (funcall run 10006 1 0 0 60002 1 argw 70000) -1))
        (should (= (fxvm--read 70000 0) 20000))))))

(provide 'nelisp-fxvm-coverage-test)

(defun fxvm-emit ()
  "Compile the actual kernels without a full runtime build.
The native driver traps every unresolved dependency. Root-frame allocation
is a private-memory stand-in; this does not qualify the live collector."
  (require 'nelisp-standalone-build)
  (let* ((started (float-time))
         (out (expand-file-name "target/fxvm/native/" fxvm--root))
         (names '(nl_val_tag nl_word_tag64 nl_word_payload nl_word_data nl_word_length nl_word_canon
                  nl_vector_slot_word nl_record_slot_word nl_vector_length nl_cons_car_word nl_cons_cdr_word
                  wf_dirty wf_bytecode_w_int m5_fx_slot_word m5_fx_word_cons_p))
         (kernels (nelisp-fx-vector--extract (expand-file-name "scripts/nelisp-standalone-build.el" fxvm--root) names))
         reports)
    (make-directory out t)
    (dolist (variant '(seed candidate))
      (let* ((root (if (eq variant 'seed) (expand-file-name "target/fxvm/seed/" fxvm--root) fxvm--root))
             (fx (with-temp-buffer
                   (insert-file-contents (expand-file-name "lisp/nelisp-cc-fx-call-primitives.el" root))
                   (cadr (nth 2 (read (current-buffer))))))
             (body (nelisp-fx-vector--extract (expand-file-name "scripts/nelisp-standalone-build.el" root) '(m5_fx_run_body)))
             (source `(seq ,@kernels ,@body
                           ,@(cl-remove-if-not (lambda (d) (memq (cadr d) '(m5_fx_primitive_id m5_fx_primitive_run))) (cdr fx))
                           (defun nl_root_mark (env) 0)
                           (defun nl_root_frame (env n) (heap-read-u64 env 200))
                           (defun nl_root_release (env mark) 0)))
             (nelisp-standalone--inline-import-sources nil)
             (unit (nelisp-standalone--compile-to-unit "fxvm-probe.o" source 'sysv))
             (bytes (cdr (assq 'text (plist-get unit :sections))))
             (file (format "%s.bin" variant)))
        (with-temp-buffer
          (set-buffer-multibyte nil)
          (insert (apply #'unibyte-string (append bytes nil)))
          (let ((coding-system-for-write 'no-conversion))
            (write-region (point-min) (point-max) (expand-file-name file out) nil 'silent)))
        (push `((variant . ,variant) (binary . ,file)
                (sha256 . ,(nelisp-fx-vector--hash (expand-file-name file out)))
                (symbols . ,(vconcat (mapcar (lambda (s) `((name . ,(plist-get s :name)) (offset . ,(plist-get s :value)))) (plist-get unit :symbols))))
                (relocs . ,(vconcat (mapcar (lambda (r) `((offset . ,(plist-get r :offset)) (type . ,(plist-get r :type))
                                                         (symbol . ,(plist-get r :symbol)) (addend . ,(plist-get r :addend)))) (plist-get unit :relocs))))) reports)))
    (with-temp-file (expand-file-name "emission.json" out)
      (insert (json-encode `((emission_seconds . ,(- (float-time) started))
                            (units . ,(vconcat (nreverse reports)))))))))
