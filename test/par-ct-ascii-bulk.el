;;; -*- lexical-binding: t; -*-
;; Bulk ASCII read of a char-table (`emacs-char-table-ascii-values') against 128 per-char
;; arefs, and the assertion map of `nlre--nat-maps-fill' against nlre--word-p / nlre--symbol-p.
;; Prints t/nil per table; test/par-ct-ascii-bulk.expected has every row t.
(defmacro bk-row (n f) `(princ (format "%-28s %S\n" ,n (condition-case e ,f (error (list 'ERR (car e)))))))
(defun bk-same (tb)
  "t when the bulk vector (or the per-char path when nil) equals (aref TB c) for 0..127."
  (let ((v (and (fboundp 'emacs-char-table-ascii-values) (emacs-char-table-ascii-values tb)))
        (ok t) (c 0))
    (while (< c 128)
      (unless (equal (if v (aref v c) (aref tb c)) (aref tb c)) (setq ok nil))
      (setq c (1+ c)))
    ok))
(defun bk-used (tb) "t when the bulk reader answers for TB."
       (and (fboundp 'emacs-char-table-ascii-values) (vectorp (emacs-char-table-ascii-values tb)) t))
(defun bk-syn (tb)
  "t when the assertion map filled for TB equals the predicates for all 128 chars."
  (let ((ok t) (c 0))
    (set-syntax-table tb)
    (nlre-clear-syntax-cache)
    (nlre--nat-maps-fill (funcall nlre--syntax-table-reader))
    (while (< c 128)
      (unless (= (aref nlre--nat-caps (+ 204 c))
                 (if (nlre--word-p c) 1 (if (nlre--symbol-p c) 2 0)))
        (setq ok nil))
      (setq c (1+ c)))
    ok))
(defvar bk-std (standard-syntax-table))
(bk-row "standard" (bk-same bk-std))
(bk-row "make-syntax-table" (bk-same (make-syntax-table)))
(defvar bk-child (make-syntax-table))
(modify-syntax-entry ?_ "w" bk-child) (modify-syntax-entry ?a "." bk-child) (modify-syntax-entry ?- "_" bk-child)
(modify-syntax-entry ?\( "w" bk-child)
(bk-row "child modify" (bk-same bk-child))
(defvar bk-gchild (make-syntax-table bk-child))
(modify-syntax-entry ?b "_" bk-gchild) (modify-syntax-entry ?_ "." bk-gchild)
(bk-row "child of child" (bk-same bk-gchild))
(defvar bk-range (make-syntax-table))
(set-char-table-range bk-range '(48 . 57) (cons 3 nil))
(set-char-table-range bk-range '(65 . 70) nil)
(bk-row "set-char-table-range" (bk-same bk-range))
(defvar bk-swap (make-syntax-table bk-child))
(set-char-table-parent bk-swap bk-gchild)
(bk-row "parent swap" (bk-same bk-swap))
(set-char-table-parent bk-swap nil)
(bk-row "parent removed" (bk-same bk-swap))
(defvar bk-def (make-char-table 'syntax-table (cons 3 nil)))
(aset bk-def ?x (cons 2 nil))
(bk-row "default value" (bk-same bk-def))
(defvar bk-def-child (make-char-table 'foo))
(set-char-table-parent bk-def-child bk-def)
(bk-row "child of default table" (bk-same bk-def-child))
(bk-row "emacs-lisp-mode" (if (boundp 'emacs-lisp-mode-syntax-table) (bk-same emacs-lisp-mode-syntax-table) t))
(bk-row "text-mode" (if (boundp 'text-mode-syntax-table) (bk-same text-mode-syntax-table) t))
(bk-row "case table" (bk-same (standard-case-table)))
(bk-row "plain char-table foo 3" (bk-same (make-char-table 'foo 3)))
(bk-row "plain char-table foo" (let ((tb (make-char-table 'foo))) (aset tb ?q 7) (bk-same tb)))
;; Assertion map = predicates
(bk-row "syn map standard" (bk-syn bk-std))
(bk-row "syn map child" (bk-syn bk-child))
(bk-row "syn map gchild" (bk-syn bk-gchild))
(bk-row "syn map range" (bk-syn bk-range))
(bk-row "syn map swap" (bk-syn bk-swap))
(bk-row "syn map default" (bk-syn bk-def))
(bk-row "syn map el-mode" (if (boundp 'emacs-lisp-mode-syntax-table) (bk-syn emacs-lisp-mode-syntax-table) t))
(bk-row "syn map text-mode" (if (boundp 'text-mode-syntax-table) (bk-syn text-mode-syntax-table) t))
;; The bulk reader must really answer for the owned tables (else the rows above prove nothing).
(bk-row "bulk answers (std,child)" (list (bk-used bk-std) (bk-used bk-child) (bk-used bk-gchild) (bk-used bk-range)))
