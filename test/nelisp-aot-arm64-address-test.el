;;; nelisp-aot-arm64-address-test.el --- Complete raw addresses -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)
(defvar nelisp-arm64-address-test--selected 0)
(defvar nelisp-arm64-address-test--enabled t)
(defconst nelisp-arm64-address-test--qemu
  (or (executable-find "qemu-aarch64")
      (let ((local (expand-file-name "~/bin/qemu-aarch64")))
        (and (file-executable-p local) local))))
(defun nelisp-arm64-address-test--record (fn &rest args)
  (let ((v (apply fn args))) (when v (cl-incf nelisp-arm64-address-test--selected)) v))
(defun nelisp-arm64-address-test--node (form)
  (let* ((nelisp-aot-compiler--arch 'aarch64)
         (nelisp-aot-compiler--abi 'aapcs64)
         (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
         (ir (nelisp-aot-compiler--parse `(defun arm_address_probe (p i v) ,form))))
    (nelisp-aot-compiler--ir-get (car (nelisp-aot-compiler--collect-defuns ir)) :body)))
(defun nelisp-arm64-address-test--bytes (node enabled)
  (let ((nelisp-aot-compiler--arch 'aarch64) (nelisp-aot-compiler--abi 'aapcs64)
        (nelisp-aot-compiler--arm64-affine-addresses enabled)
        (buf (nelisp-asm-arm64-make-buffer)))
    (nelisp-aot-compiler--emit-value node buf)
    (nelisp-asm-arm64-buffer-bytes buf)))
(defun nelisp-arm64-address-test--word (bytes index)
  (let ((n (* index 4)))
    (logior (aref bytes n) (ash (aref bytes (+ n 1)) 8)
            (ash (aref bytes (+ n 2)) 16) (ash (aref bytes (+ n 3)) 24))))
(ert-deftest nelisp-arm64-address/complete-shapes-and-original-fallback ()
  (dolist (width '(1 2 4 8))
    (let* ((op (intern (format "ptr-read-u%d" (* width 8))))
           (node (nelisp-arm64-address-test--node `(,op (+ p (* i ,width)) 0)))
           (bytes (nelisp-arm64-address-test--bytes node t)))
      (should (= (length bytes) 12))
      (should (= (logand (ash (nelisp-arm64-address-test--word bytes 2) -12) 1)
                 (if (= width 1) 0 1)))
      (should (< (length bytes) (length (nelisp-arm64-address-test--bytes node nil))))
      (let ((write (nelisp-arm64-address-test--node
                    `(,(intern (format "ptr-write-u%d" (* width 8))) (+ p (* i ,width)) 0 v))))
        (should (= (length (nelisp-arm64-address-test--bytes write t)) 20)))))
  (dolist (form '((ptr-read-u64 (+ p 20) 0)
                  (ptr-read-u8 (+ p (* i 8)) 7)
                  (ptr-read-u16 p (- (* i 4) 8))
                  (ptr-write-u32 (+ p (* i 4)) 0 v)))
    (let* ((n (nelisp-arm64-address-test--node form))
           (a (nelisp-arm64-address-test--bytes n t))
           (b (nelisp-arm64-address-test--bytes n nil)))
      (should (< (length a) (length b)))))
  (dolist (form '((ptr-read-u64 (seq (ptr-write-u64 p 0 9) p) (* i 8))
                  (ptr-read-u64 p (ptr-read-u64 p 8))
                  (ptr-write-u64 (+ p (* i 8)) 0 (seq (ptr-write-u64 p 0 3) v))))
    (let ((n (nelisp-arm64-address-test--node form)))
      (let ((nelisp-aot-compiler--arch 'aarch64)
            (buf (nelisp-asm-arm64-make-buffer)))
        (should-not (nelisp-aot-compiler--emit-affine-memory-arm64
                     n buf 8 (eq (nelisp-aot-compiler--ir-kind n) 'ptr-write-u64)))
        (should (= (nelisp-asm-arm64-buffer-pos buf) 0)))))
  (let ((n (nelisp-arm64-address-test--node '(ptr-read-u64 (+ p (* i 8)) 0)))
        (nelisp-aot-compiler--arch 'aarch64))
    (let ((nelisp-aot-compiler--checked-arith t))
      (should-not (nelisp-aot-compiler--arm64-affine-address-plan n nil)))
    (let ((nelisp-aot-compiler--runtime-entry-params t))
      (should-not (nelisp-aot-compiler--arm64-affine-address-plan n nil)))
    (let* ((ref (nelisp-aot-compiler--ir-get (nelisp-aot-compiler--ir-get n :ptr) :a))
           (bad (vconcat ref [:foreign t])))
      (let ((ptr (nelisp-aot-compiler--ir-get n :ptr)))
        (aset ptr (1+ (cl-position :a ptr)) bad))
      (should-not (nelisp-aot-compiler--arm64-affine-address-plan n nil)))))
(ert-deftest nelisp-arm64-address/symbolic-origin-and-budget-fallback ()
  (let* ((nelisp-aot-compiler--arch 'aarch64)
         (node (nelisp-arm64-address-test--node
                '(ptr-read-u64 (+ (data-addr arm_external) (* i 8)) 0)))
         (buf (nelisp-asm-arm64-make-buffer)))
    (should (nelisp-aot-compiler--emit-affine-memory-arm64 node buf 8 nil))
    (should (= (length (nelisp-asm-arm64-buffer-relocs buf)) 2))
    (let ((cancel (nelisp-arm64-address-test--node
                   '(ptr-read-u64 (* (data-addr arm_external) 0) 0))))
      (should-not (nelisp-aot-compiler--arm64-affine-address-plan cancel nil)))
    (let ((deep 'p))
      (dotimes (_ 35) (setq deep `(+ ,deep 1)))
      (should-not (nelisp-aot-compiler--arm64-affine-address-plan
                   (nelisp-arm64-address-test--node `(ptr-read-u64 ,deep 0)) nil))))
  (let ((buf (nelisp-asm-arm64-make-buffer)))
    (nelisp-asm-arm64-add-reg-shift buf 'x1 'x1 'x2 3)
    (should (zerop (logand (nelisp-arm64-address-test--word
                           (nelisp-asm-arm64-buffer-bytes buf) 0) #x20000000)))
    (should-error (nelisp-asm-arm64-address-memory buf nil 4 'x0 'x1 'x2 3 0)
                  :type 'nelisp-asm-arm64-error)))
(defun nelisp-arm64-address-test--source ()
  (let (defs tests (serial 0))
    (dolist (bits '(8 16 32 64))
      (dolist (scale '(1 2 4 8))
        (dolist (disp '(0 13 -13 4096 32760 16777216))
          (let* ((name (intern (format "arm_case_%d" (cl-incf serial))))
                 (read (intern (format "ptr-read-u%d" bits)))
                 (write (intern (format "ptr-write-u%d" bits)))
                 (value #xfedcba9876543210)
                 (expected (logand value (1- (ash 1 bits)))))
            (push `(defun ,name (p i v)
                     (seq (,write (+ p (* i ,scale)) ,disp v)
                          (= (,read (+ p ,disp) (* i ,scale)) ,expected))) defs)
            (push `(,name p 3 ,value) tests)))))
    `(seq ,@(nreverse defs)
          (defun arm_wrap (p i v)
            (seq (ptr-write-u64 (+ p (- (* i 8) 8)) 8 v)
                 (= (ptr-read-u64 p (* i 8)) v)))
          (defun arm_guarded_word (w)
            (if (= (logand w 7) 2) 7
              (if (= (logand w 7) 6) (logand (ptr-read-u8 (- w 6) 0) 63) 0)))
          (defun arm_order (p)
            (seq (ptr-write-u64 p 0 0)
                 (ptr-write-u64
                  (seq (ptr-write-u64 p 0 (+ (* (ptr-read-u64 p 0) 10) 1)) (+ p 64))
                  (seq (ptr-write-u64 p 0 (+ (* (ptr-read-u64 p 0) 10) 2)) 0)
                  (seq (ptr-write-u64 p 0 (+ (* (ptr-read-u64 p 0) 10) 3)) 73))
                 (and (= (ptr-read-u64 p 0) 123) (= (ptr-read-u64 p 64) 73))))
          (defun _start ()
            (let* ((mem (syscall-direct 222 0 67108864 3 34 -1 0)) (p (+ mem 65536)))
              (syscall-direct 93
               (if (and ,@(nreverse tests)
                        (arm_wrap p #x8000000000000000 #x8000000000000001)
                        (arm_order p)
                        (= (arm_guarded_word 2) 7)
                        (seq (ptr-write-u8 p 0 42) (= (arm_guarded_word (+ p 6)) 42))) 0 1)
               0 0 0 0 0))))))
(defun nelisp-arm64-address-test--run (source enabled dir name)
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (nelisp-standalone--target 'linux-aarch64)
        (nelisp-aot-compiler--arm64-affine-addresses enabled)
        (file (expand-file-name name dir)))
    (let ((unit (nelisp-standalone--compile-to-unit name source)))
      (nelisp-link-units file (list unit) "_start" nil 'aarch64))
    (set-file-modes file #o755)
    (call-process nelisp-arm64-address-test--qemu nil nil nil file)))
(ert-deftest nelisp-arm64-address/qemu-full64-widths-order-WORD-and-fault ()
  (skip-unless nelisp-arm64-address-test--qemu)
  (let ((dir (make-temp-file "arm-address-" t))
        (nelisp-arm64-address-test--selected 0)
        (enabled (and nelisp-arm64-address-test--enabled
                      (not (getenv "NELISP_ARM_ADDRESS_TEST_DISABLE")))))
    (advice-add 'nelisp-aot-compiler--emit-affine-memory-arm64 :around #'nelisp-arm64-address-test--record)
    (unwind-protect
        (progn
          (should (equal 0 (nelisp-arm64-address-test--run (nelisp-arm64-address-test--source) nil dir "off")))
          (let ((before nelisp-arm64-address-test--selected))
            (should (equal 0 (nelisp-arm64-address-test--run (nelisp-arm64-address-test--source) enabled dir "on")))
            (let* ((src '(defun _start () (syscall-direct 93 (ptr-read-u64 0 0) 0 0 0 0 0)))
                   (off (nelisp-arm64-address-test--run src nil dir "fault-off"))
                   (on (nelisp-arm64-address-test--run src enabled dir "fault-on")))
              (should (stringp off)) (should (string-match-p "[Ss]egmentation fault" off))
              (should (equal on off)))
            (message "A64 QEMU both selectors full64/96width-scale-displacements/order/guardedWORD/fault PASS")
            (should (> nelisp-arm64-address-test--selected before))))
      (advice-remove 'nelisp-aot-compiler--emit-affine-memory-arm64 #'nelisp-arm64-address-test--record)
      (delete-directory dir t))))
(provide 'nelisp-aot-arm64-address-test)
