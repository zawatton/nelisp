;;; nelisp-entry-store-value-test.el --- Exact slow-store differential -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defconst esv--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defvar esv--cache (make-hash-table :test #'equal))
(defun esv--defs (old)
  (let* ((root (if old (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" esv--root)) esv--root)))
    (or (gethash root esv--cache)
        (let ((defs (make-hash-table)))
          (dolist (file '("scripts/nelisp-standalone-build.el" "lisp/nelisp-cc-rootstack.el"
                          "lisp/nelisp-cc-nlrecord-set-slot.el" "lisp/nelisp-cc-nlvector-set-slot.el"
                          "lisp/nelisp-cc-val-load.el" "lisp/nelisp-cc-sexp-clone-into.el"))
            ;; The five-file seed omits unchanged leaf providers. Authenticate
            ;; those against the candidate before using its identical source.
            (let ((path (expand-file-name file root)))
              (unless (file-exists-p path)
                (when (equal file "scripts/nelisp-standalone-build.el") (error "Missing genuine seed"))
                (setq path (expand-file-name file esv--root)))
              (when (and old (equal file "scripts/nelisp-standalone-build.el"))
                (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally path)
                  (should (equal (secure-hash 'sha256 (current-buffer))
                                 "d2ec14505716be066e3101ed84f9c13a7e7ddbd4e0e62d51e2ec4bc9373ad630"))))
              (when (not (equal file "scripts/nelisp-standalone-build.el"))
                (let ((expected (cdr (assoc file
                   '(("lisp/nelisp-cc-rootstack.el" . "718a53c010dc9dc5d6d5e2b11cec0bbe8b38c397f17cff70b7f3b63c0fb7c7d7")
                     ("lisp/nelisp-cc-nlrecord-set-slot.el" . "62d2cd1944abc6d1f7368c22b8c320b5d1342cff74bd44cc8ad17bb5c47c9692")
                     ("lisp/nelisp-cc-nlvector-set-slot.el" . "49362bce09e42b77dbbf623b32be7b9b93a8b98f383e23422bd0eedc7f3c96c9")
                     ("lisp/nelisp-cc-val-load.el" . "c8245f749510b235363754fd4b708ee328cbc1b81747cb6bfb8262564af91d89")
                     ("lisp/nelisp-cc-sexp-clone-into.el" . "c26e3cf1787c0807339cc6b6b4ba713aeb597544f3cfd799f8d20b9c40a4af19"))))))
                  (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally path)
                    (should (equal (secure-hash 'sha256 (current-buffer)) expected)))))
              (with-temp-buffer
                (insert-file-contents path) (goto-char 1)
                (condition-case nil
                    (while t
                      (let ((todo (list (read (current-buffer)))))
                        (while todo
                          (let ((n (pop todo)))
                            (when (consp n)
                              (if (eq (car n) 'defun) (puthash (cadr n) n defs)
                                (push (car n) todo) (push (cdr n) todo)))))))
                  (end-of-file nil)))))
          (puthash root defs esv--cache)))))
(defun esv--form (name old)
  (or (gethash name (esv--defs old)) (error "Missing authenticated body %s" name)))
(defun esv--fn (form)
  (eval `(lambda ,(nth 2 form)
           (cl-macrolet ((seq (&rest xs) (cons 'progn xs))
                         (data-addr (&rest operands)
                           (unless (and (= (length operands) 1) (symbolp (car operands)))
                             (error "data-addr requires one literal symbol"))
                           `(funcall (symbol-function 'data-addr) ',(car operands)))
                         ;; RAW zero is false in the genuine DSL; Elisp0 is true.
                         (if (test then &rest otherwise)
                           `(cond ((let ((value ,test)) (and value (not (eq value 0)))) ,then)
                                  (t ,@otherwise)))
                         (extern-call (name &rest xs) (cons name xs)))
             ,@(cdddr form))) t))
(defun esv--helper-form (old mutant)
  (let ((f (if old
               `(defun nl_ent_store_value (w k val)
                  (let* ,(cadr (cadddr (esv--form 'nl_ent_set_slow t))) v))
             (copy-tree (esv--form 'nl_ent_store_value nil)))))
    (pcase mutant
      ('boolean (setq f (cl-subst '(if (= (nl_val_tag val) 0) 7 3)
                                 '(if (= (nl_val_tag val) 0) 3 7) f :test #'equal)))
      ('integer (setq f (cl-subst 'val '(if (= (nl_val_tag val) 13) val 0) f :test #'equal)))
      ('unbound (setq f (cl-subst 0 '(heap-read-u64 268436336 0) f :test #'equal)))) f))
(defun esv--finite-provider (name body record)
  "Admit only the declared missing-entry fixnum path before any body effect."
  (lambda (word scratch)
    (unless (and (= word 9) (integerp scratch) (> scratch 0) (= (mod scratch 8) 0))
      (error "Unsupported finite provider representation"))
    (funcall record name word scratch)
    (funcall body word scratch)))
(defun esv--run (old spec &optional helper-only mutant)
  (let ((mem (make-hash-table :test #'eql)) (symbols (make-hash-table :test #'equal))
        (symbol-next 1) (next 50000) (allocs 0) (calls 0) provider-calls mirror-call
        (installed nil) (layout (nth 0 spec)) (redirect (nth 1 spec))
        (fwd (nth 2 spec)) (slot (nth 3 spec)) (value (nth 4 spec)) result)
    (cl-labels
        ((rd (p o &optional byte)
           (if byte (gethash (+ p o) mem 0)
             (let ((v 0)) (dotimes (i 8) (setq v (logior v (ash (gethash (+ p o i) mem 0) (* i 8))))) v)))
         (wr (p o v) (dotimes (i 8) (puthash (+ p o i) (logand (ash v (- (* i 8))) 255) mem)) v)
         (resolve (v) v)
         (alloc (size) (cl-incf allocs) (prog1 next (setq next (+ next size 64))))
         (view (tag data out) (wr out 0 tag) (wr out 8 data) out)
         (snapshot () (sort (cl-loop for k being the hash-keys of mem using (hash-values v) collect (cons k v))
                            (lambda (a b) (< (car a) (car b))))))
      (let* ((entry (if (eq layout 'native) 4102 12288))
             (base (if (eq layout 'native) 4096 8192))
             (header (if (eq layout 'native) (+ 4 (* redirect 256) (* fwd 65536))
                       (+ (* (if (eq layout 'short) 5 9) 256) 12))))
        (wr base 0 header)
        (dotimes (i 9) (wr (+ base 16) (* i 8) (if (= i 0) 41 3)))
        (when (not (eq layout 'native))
          (view 12 base entry) (wr (+ base 16) 56 (+ (* fwd 4) 1))
          (when (= redirect 1) (wr (+ base 16) 32 9990)))
        (when (and (eq layout 'native) (= redirect 2))
          (wr base 16 16390) (wr 16384 0 (+ (* 2 256) 8)) (wr 16384 8 3) (wr 16384 16 41))
        (view 2 99 20000) (view 13 123456 20032) (view 5 777 20064) (view 0 0 20096)
        (view 16 1234 20128) (view 16 1234 20160) (view 16 5678 20192)
        (wr 268436336 0 20160)
        (let ((before (snapshot)) (descriptor (rd (+ base 16) 56)))
          (cl-letf
              (((symbol-function 'heap-read-u64) (lambda (p o) (rd p o)))
               ((symbol-function 'heap-read-u8) (lambda (p o) (rd p o t)))
               ((symbol-function 'ptr-read-u64) (lambda (p o) (rd p o)))
               ((symbol-function 'ptr-write-u64) #'wr)
               ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
               ((symbol-function 'data-addr) (lambda (sym) (should (eq sym 'nl_exit_values)) 70000))
               ((symbol-function 'atomic-fetch-add) (lambda (p n) (let ((old (rd p 0))) (wr p 0 (+ old n)) old)))
               ((symbol-function 'alloc-bytes) (lambda (n alignment) (when helper-only (error "Impure helper allocation"))
                                               (let ((p (alloc n))) (should (= (mod p alignment) 0)) p)))
               ((symbol-function 'nl_val_clone_into) (lambda (v dest) (when helper-only (error "Impure helper write")) (wr dest 0 v)))
               ((symbol-function 'nl_alloc_symbol)
                (lambda (bytes len dest)
                  (let* ((name (apply #'string (cl-loop for i below len collect (rd bytes i t))))
                         (key (or (gethash name symbols)
                                  (puthash name (prog1 symbol-next (cl-incf symbol-next)) symbols))))
                    (view 4 key dest))))
               ((symbol-function 'nelisp_cons_construct)
                (lambda (a d dest) (let ((p (alloc 16)))
                                    (wr p 0 a) (wr p 8 d) (view 7 p dest))))
               ((symbol-function 'nl_root_frame) (lambda (&rest _) (error "Impure helper root reservation")))
               ((symbol-function 'nelisp_mirror_lookup_entry) (lambda (&rest _) 0))
               ((symbol-function 'nelisp_env_setv_mirror_lazy)
                (lambda (env sym view scratch)
                  (setq mirror-call (list env sym view scratch
                                          (cl-loop for offset in '(0 8 16 24) collect (rd view offset))))
                  (wr 90000 0 value) 0)))
            ;; Authenticate critical fixed ABI before any generated execution.
            (dolist (pair '((nl_val_tag . 1) (nl_so_p . 1) (nl_word_payload . 1)
                            (nl_record_slot_word . 2) (nl_val_clone_into . 2)
                            (nl_record_set_slot . 3) (nl_vector_set_slot . 3) (nl_exit_signal_w . 2)
                            (nl_val_load . 2) (nl_sexp_clone_into . 2) (nl_sci_store_imm . 2)))
              (dolist (which '(t nil))
                (let ((args (nth 2 (esv--form (car pair) which))))
                  (should (= (length args) (cdr pair)))
                  (should (cl-every (lambda (x) (and (symbolp x) (not (string-prefix-p "&" (symbol-name x))))) args)))))
            (unwind-protect
                (progn
                  (dolist (name '(nl_val_tag nl_word_payload nl_record_slot_word nl_so_p
                                   nl_ent_set nl_ent_set_slow nl_sym_signal_wta_integerp nl_exit_signal_w nl_sb_set))
                    (push (cons name (and (fboundp name) (symbol-function name))) installed)
                    (let ((form (copy-tree (esv--form name old))))
                      (when (and (eq mutant 'alias-store) (eq name 'nl_ent_set_slow))
                        (cl-labels ((walk (x)
                                      (if (and (consp x) (eq (car x) 'if) (equal (cadr x) '(= r 1)) (eql (nth 2 x) 0))
                                          `(if (= r 1) (nl_val_clone_into v (+ b 16)) ,(walk (nth 3 x)))
                                        (if (consp x) (cons (walk (car x)) (walk (cdr x))) x))))
                          (setq form (walk form))))
                      (fset name (esv--fn form))))
                  (dolist (name '(nl_record_set_slot nl_vector_set_slot))
                    (push (cons name (and (fboundp name) (symbol-function name))) installed)
                    (fset name (esv--fn (esv--form name old))))
                  (dolist (name '(nl_val_load nl_sexp_clone_into nl_sci_store_imm))
                    (push (cons name (and (fboundp name) (symbol-function name))) installed)
                    (fset name (esv--finite-provider name (esv--fn (esv--form name old))
                                (lambda (&rest call) (push call provider-calls)))))
                  (push (cons 'nl_ent_store_value (and (fboundp 'nl_ent_store_value) (symbol-function 'nl_ent_store_value))) installed)
                  (let ((fn (esv--fn (esv--helper-form old mutant))))
                    (fset 'nl_ent_store_value (lambda (&rest xs) (cl-incf calls) (apply fn xs))))
                  (let ((rc (cond (helper-only (nl_ent_store_value entry slot value))
                                  ((eq layout 'missing) (nl_sb_set 1000 9900 value))
                                  (t (nl_ent_set entry slot value)))))
                    (setq result (list :rc rc :memory (snapshot) :before before :allocations allocs :helper-calls calls
                                       :provider-calls (nreverse provider-calls) :mirror-call mirror-call
                                       :pending (rd 268435472 0) :epoch (rd 268435544 0)
                                       :tag (rd 70000 0) :data (rd 70000 8)
                                       :error-payload
                                       (when (= (rd 268435472 0) 1)
                                         (let* ((tag (rd 70000 0)) (data (rd 70000 8))
                                                (pair (rd data 8)) (pred (rd pair 0))
                                                (tail (rd pair 8)) (last (rd tail 8)))
                                           (list (rd tag 0) (rd tag 8) (rd data 0)
                                                 (rd pred 0) (rd pred 8) (rd tail 0)
                                                 (rd last 0) (rd last 8))))
                                       :signal-names (sort (cl-loop for name being the hash-keys of symbols collect name) #'string<)
                                       :descriptor (rd (+ base 16) 56) :descriptor-before descriptor :entry entry
                                       :stored (rd (if (and (eq layout 'native) (= redirect 2) (= slot 0)) 16384 base)
                                                   (if (and (eq layout 'native) (= redirect 2) (= slot 0)) 16 (+ 16 (* slot 8))))))))
              (dolist (p installed) (if (cdr p) (fset (car p) (cdr p)) (fmakunbound (car p))))))))
      result)))
(defconst esv--cases
  '((native 0 0 0 9) (native 1 0 0 9) (native 2 0 0 9) (native 3 0 0 9)
    (native 3 2 0 3) (native 3 2 0 7) (native 3 2 0 20096) (native 3 2 0 20064)
    (native 3 1 0 5) (native 3 1 0 -3) (native 3 1 0 20000) (native 3 1 0 20032)
    (native 3 1 0 20064) (native 3 1 0 7) (native 3 1 0 20128) (native 3 1 0 20192)
    ;; Raw WORD2 cases classify malformed pointer bits, not valid heap objects.
    (native 3 1 0 2) (native 0 0 0 2) (native 3 2 0 2) (native 3 1 1 20064)
    (legacy 0 0 0 9) (legacy 1 0 0 9) (legacy 0 2 0 3) (legacy 0 2 0 7)
    (legacy 0 1 0 20032) (legacy 0 1 0 20064) (legacy 0 1 0 20128)
    (short 0 0 0 9) (legacy 0 1 2 20064) (missing 0 0 0 9)))
(defun esv--error-oracle (row original)
  "Check the independent modeled signal ABI, not merely old/new equality."
  (cl-assert (= (plist-get row :pending) 1) nil "signal-kind")
  (cl-assert (= (plist-get row :epoch) 1) nil "signal-epoch")
  (cl-assert (equal (plist-get row :error-payload) (list 4 1 7 4 2 7 original 3)) nil "signal-payload")
  (cl-assert (= (plist-get row :rc) 0) nil "signal-status")
  (cl-assert (= (plist-get row :stored) 41) nil "signal-destination"))
(ert-deftest entry-store-genuine-old-new-finite-differential ()
  ;; Needs the legacy migration seed (LEGACY_MIGRATION_SEED or ../seed).
  (skip-unless (file-exists-p (expand-file-name "scripts/nelisp-standalone-build.el" (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" esv--root)))))
  (dolist (old '(t nil))
    (let* ((row (esv--run old '(missing 0 0 0 9)))
           (mirror (plist-get row :mirror-call)) (scratch (nth 2 mirror)))
      (should (equal mirror (list 1000 9900 scratch 1064 '(2 2 0 0))))
      (should (equal (plist-get row :provider-calls)
                     (mapcar (lambda (name) (list name 9 scratch))
                             '(nl_val_load nl_sexp_clone_into nl_sci_store_imm))))))
  (dolist (spec esv--cases)
    (let ((old (esv--run t spec)) (new (esv--run nil spec)))
      (ert-info ((format "%S" spec))
        (dolist (key '(:rc :memory :pending :epoch :error-payload :tag :data :signal-names :descriptor :entry :stored :allocations))
          (should (equal (plist-get old key) (plist-get new key))))
        (when (= (plist-get new :pending) 1)
          (should (equal (plist-get new :signal-names) '("integerp" "wrong-type-argument")))
          (should (= (plist-get new :rc) 0)))
        (if (= (plist-get new :pending) 1)
            (progn (esv--error-oracle old (nth 4 spec)) (esv--error-oracle new (nth 4 spec)))
          (should (= (plist-get new :epoch) 0)))
        (when (or (/= (nth 3 spec) 0) (eq (car spec) 'short)
                  (and (eq (car spec) 'native) (/= (nth 1 spec) 3)))
          (should (= (plist-get new :helper-calls) 0)))
        (should (= (plist-get new :descriptor) (plist-get new :descriptor-before)))))))
(ert-deftest entry-store-pure-helper-exact-old-normalization ()
  ;; Needs the legacy migration seed (LEGACY_MIGRATION_SEED or ../seed).
  (skip-unless (file-exists-p (expand-file-name "scripts/nelisp-standalone-build.el" (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" esv--root)))))
  (should (equal (cadr (cadddr (esv--form 'nl_ent_set_slow t)))
                 (cadr (cadddr (esv--form 'nl_ent_store_value nil)))))
  (dolist (spec esv--cases)
    (let ((old (esv--run t spec t)) (new (esv--run nil spec t)))
      (should (equal (plist-get old :rc) (plist-get new :rc)))
      (should (equal (plist-get new :memory) (plist-get new :before)))
      (should (= (plist-get new :pending) 0)) (should (= (plist-get new :allocations) 0)))))
(ert-deftest entry-store-purposeful-mutants-have-specific-result-witnesses ()
  ;; Needs the legacy migration seed (LEGACY_MIGRATION_SEED or ../seed).
  (skip-unless (file-exists-p (expand-file-name "scripts/nelisp-standalone-build.el" (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" esv--root)))))
  (let ((writes 0) (entries 0) reason)
    (let ((provider (esv--finite-provider 'nl_sexp_clone_into
                     (lambda (&rest _) (cl-incf writes))
                     (lambda (&rest _) (cl-incf entries)))))
      (condition-case e (funcall provider 3 50000)
        (error (setq reason (error-message-string e)))))
    (should (equal reason "Unsupported finite provider representation"))
    (should (= writes 0)) (should (= entries 0)))
  (should-error (funcall (esv--fn '(defun bad () (data-addr (+ 1 2))))) :type 'error)
  (cl-letf (((symbol-function 'data-addr) (lambda (s) (unless (eq s 'nl_exit_values) (error "Unknown data identifier")) 70000)))
    (should-error (funcall (esv--fn '(defun bad () (data-addr unknown)))) :type 'error))
  (let ((row (esv--run nil '(native 3 1 0 20064))))
    (esv--error-oracle row 20064)
    (dolist (change '((:pending 0 "signal-kind") (:epoch 0 "signal-epoch") (:error-payload nil "signal-payload")))
      (let ((bad (copy-tree row)) (reason nil))
        (setq bad (plist-put bad (car change) (cadr change)))
        (condition-case e (esv--error-oracle bad 20064)
          (error (setq reason (error-message-string e))))
        (should (and reason (string-match-p (nth 2 change) reason))))))
  (dolist (case '((boolean (native 3 2 0 3) :rc 3 7)
                  (integer (native 3 1 0 20064) :rc 0 20064)
                  (unbound (native 3 1 0 20128) :rc 20128 0)))
    (let* ((old (esv--run t (nth 1 case) t))
           (bad (esv--run nil (nth 1 case) t (nth 0 case))))
      (should (equal (plist-get old (nth 2 case)) (nth 3 case)))
      (should (equal (plist-get bad (nth 2 case)) (nth 4 case)))
      (should-not (equal (plist-get old :rc) (plist-get bad :rc)))))
  (let ((old (esv--run t '(native 1 0 0 9))) (bad (esv--run nil '(native 1 0 0 9) nil 'alias-store)))
    (should (= (plist-get old :rc) 1)) (should (= (plist-get bad :rc) 1))
    (should (= (plist-get old :stored) 41)) (should (= (plist-get bad :stored) 9))))
(provide 'nelisp-entry-store-value-test)
