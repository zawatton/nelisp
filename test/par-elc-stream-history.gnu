(compile-form "outer.elc" ((defun . par-elc-stream-function) "outer.elc"))
(expanded "outer.elc" ((defun . par-elc-stream-function) "outer.elc"))
(outer-end "outer.elc" ((provide . par-elc-stream-outer) (defun . par-elc-stream-function) "outer.elc"))
(file-outer "par-elc-stream-history.el" (caller-state))
