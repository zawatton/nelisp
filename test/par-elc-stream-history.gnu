(inner-start "inner.elc" ("inner.elc"))
(inner-end "inner.elc" ((provide . par-elc-stream-inner) "inner.elc"))
(hook-inner "outer.elc" ((defun . par-elc-stream-function) "outer.elc"))
(feature-inner "outer.elc" ((defun . par-elc-stream-function) "outer.elc"))
