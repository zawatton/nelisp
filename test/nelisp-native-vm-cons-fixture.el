     (emit `(ptr-write-u64 ,child 0 741)) (emit `(ptr-write-u64 ,child2 0 852))
     (check '(= (ptr-read-u64 (ptr-read-u64 view-a 8) 0) 741)) (check '(= (ptr-read-u64 (ptr-read-u64 view-b 8) 0) 852)))))
