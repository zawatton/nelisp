  ;; build_args: zero-count leaves the accumulator's entire slot unchanged;
  ;; selected input window, reverse traversal, order and improper tail retained.
  (dolist (kind '(old new))
   (dolist (n '(0 1 2 4))
    (dotimes (i 6) (slot (+ slots (* i 32)) 2 (+ 10 i) 0 0))
    (slot acc 2 99 777 888) (reset)
    (check `(= (,(if (eq kind 'old) 'old_build_args 'wf_bytecode_build_args) ,slots 1 ,n ,acc) 0))
    (if (= n 0) (cl-loop for x in '(2 99 777 888) for k from 0 do (check `(= (ptr-read-u64 ,acc ,(* k 8)) ,x)))
     (progn (emit `(setq view-a ,acc))
      (dotimes (i n) (header 'view-a) (word 'view-a 0 (+ (* (+ i 11) 4) 1))
       (if (= i (1- n)) (word 'view-a 8 397) (emit '(setq view-a (ptr-read-u64 (ptr-read-u64 view-a 8) 8)))))))
    (check `(= (ptr-read-u64 ,base 8) ,(+ (* n 24) (* (max 0 (1- n)) 32) (if (eq kind 'old) (* n 32) 0))))))
