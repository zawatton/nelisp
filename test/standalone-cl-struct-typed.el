;;; standalone-cl-struct-typed.el --- (:type vector|list) cl-defstruct regression -*- lexical-binding: t; -*-
;; GNU builds real vectors/lists for `(:type vector)' / `(:type list)'; the
;; standalone used to build records (avl-tree, timer.el `timerp' broke).
(require 'cl-lib)
(require 'gv)
(cl-defstruct (nelisp-ty-nv (:type vector) :named) a (b 7))
(cl-defstruct (nelisp-ty-uv (:type vector)) a b)
(cl-defstruct (nelisp-ty-nl (:type list) :named) a b)
(cl-defstruct (nelisp-ty-ul (:type list)) a b)
(cl-defstruct (nelisp-ty-boa (:type vector) :named
                             (:constructor nelisp-ty-boa-new (a &optional b))
                             (:copier nil))
  a b)
(cl-defstruct (nelisp-ty-child (:type vector) :named (:include nelisp-ty-nv)) c)
(cl-defstruct nelisp-ty-rec x y)
(defun nelisp-ty--check (ok what)
  (unless ok (error "typed cl-defstruct mismatch: %s" what)))
(let ((v (make-nelisp-ty-nv :a 1)) (u (make-nelisp-ty-uv :a 1 :b 2))
      (l (make-nelisp-ty-nl :a 1 :b 2)) (m (make-nelisp-ty-ul :b 2)))
  (nelisp-ty--check (equal v [nelisp-ty-nv 1 7]) "named vector")
  (nelisp-ty--check (and (vectorp u) (equal u [1 2])) "unnamed vector")
  (nelisp-ty--check (equal l '(nelisp-ty-nl 1 2)) "named list")
  (nelisp-ty--check (equal m '(nil 2)) "unnamed list")
  (nelisp-ty--check (equal (nelisp-ty-boa-new 1) [nelisp-ty-boa 1 nil]) "BOA")
  (setf (nelisp-ty-nv-a v) 10)
  (cl-incf (nelisp-ty-nv-b v))
  (setf (nelisp-ty-uv-b u) 20)
  (cl-incf (nelisp-ty-nl-a l) 5)
  (setf (nelisp-ty-ul-b m) 20)
  (nelisp-ty--check (and (equal v [nelisp-ty-nv 10 8]) (equal u [1 20])
                         (equal l '(nelisp-ty-nl 6 2)) (equal m '(nil 20)))
                    "setf")
  (nelisp-ty--check (and (nelisp-ty-nv-p v) (not (nelisp-ty-nv-p [x 1 2]))
                         (not (nelisp-ty-nv-p [nelisp-ty-nv 1]))
                         (not (nelisp-ty-nv-p l)) (nelisp-ty-nl-p l)
                         (not (fboundp 'nelisp-ty-uv-p)))
                    "predicates")
  (nelisp-ty--check (eq (condition-case e (nelisp-ty-nv-a [zz 1 2])
                          (error (car e)))
                        'wrong-type-argument)
                    "accessor type check")
  (nelisp-ty--check (and (equal (copy-nelisp-ty-nv v) v)
                         (not (eq (copy-nelisp-ty-nv v) v))
                         (not (fboundp 'copy-nelisp-ty-boa)))
                    "copier"))
(let ((c (make-nelisp-ty-child :a 4 :c 9)))
  (nelisp-ty--check (and (equal c [nelisp-ty-child 4 7 9])
                         (nelisp-ty-child-p c) (nelisp-ty-nv-p c)
                         (not (nelisp-ty-child-p (make-nelisp-ty-nv)))
                         (= (nelisp-ty-nv-a c) 4))
                    ":include")
  (setf (nelisp-ty-child-c c) 5)
  (nelisp-ty--check (equal c [nelisp-ty-child 4 7 5]) "child setf"))
;; The default (record) form must be unaffected.
(let ((r (make-nelisp-ty-rec :x 1 :y 2)))
  (setf (nelisp-ty-rec-y r) 3)
  (nelisp-ty--check (and (recordp r) (nelisp-ty-rec-p r) (= (nelisp-ty-rec-x r) 1)
                         (= (nelisp-ty-rec-y r) 3))
                    "record struct"))
(princ "TYPED-STRUCT-PASS\n")
