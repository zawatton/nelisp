;;; nelisp-directcall-alloc-test.el --- Allocating primitives on WORD argv  -*- lexical-binding: t; -*-

;; dcproto: vector, make-vector, list, concat, substring and make-string are
;; directcall entries (ids 112-117) with WORD bodies.  The bodies decline (-3)
;; before the first allocation or store for every case they do not handle, so
;; the unchanged builtin owns it and its error data.  The memory model below is
;; a hash of 64-bit words plus a hash of bytes; strings follow the production
;; header (+0 chars, +8 bytes or -1 for unibyte, +16 intervals, +24 data).

(require 'nelisp-directcall-test)

(defvar nda--mem nil)
(defvar nda--bytes nil)
(defvar nda--next 100000)
(defvar nda--allocs 0)
(defvar nda--made nil)

(defun nda--alloc (n)
  (let ((p nda--next))
    (setq nda--next (+ nda--next (* 8 (ceiling (max n 8) 8)) 64) nda--allocs (1+ nda--allocs))
    p))

(defun nda--str (string &optional multibyte props)
  "A string word for STRING (ASCII bytes) in the model."
  (let* ((h (nda--alloc 32)) (d (nda--alloc (max 1 (length string)))))
    (dotimes (i (length string)) (puthash (+ d i) (aref string i) nda--bytes))
    (puthash h (length string) nda--mem)
    (puthash (+ h 8) (if multibyte (length string) -1) nda--mem)
    (puthash (+ h 16) (if props 1 0) nda--mem)
    (puthash (+ h 24) d nda--mem)
    (+ h 4)))

(defun nda--str-bytes (word)
  (let* ((h (- word 4)) (n (gethash (+ h 8) nda--mem)) (nc (gethash h nda--mem))
         (count (if (< n 0) nc n)) (d (gethash (+ h 24) nda--mem)))
    (apply #'string (cl-loop for i below count collect (gethash (+ d i) nda--bytes)))))

(defun nda--fix (n) (+ (ash n 2) 1))

(defun nda--call (id args)
  "Run `nl_directcall_run' ID on fixnum/word ARGS; (STATUS . RESULT-WORD-or-nil)."
  (let* ((base (nda--alloc (* 8 (max 1 (length args))))) (out (nda--alloc 8)) (st nil))
    (cl-loop for a in args for i from 0 do (puthash (+ base (* i 8)) a nda--mem))
    (puthash out 777 nda--mem)
    (setq nda--allocs 0)
    (setq st (nl_directcall_run id base (length args) out 0))
    (cons st (let ((v (gethash out nda--mem))) (and (/= v 777) v)))))

(defun nda--with-model (thunk)
  (ndc--with-definitions
   (lambda (_defs)
     (let* ((nda--mem (make-hash-table :test #'eql)) (nda--bytes (make-hash-table :test #'eql))
            (nda--next 100000) (nda--allocs 0)
            (eic (nelisp-standalone--eval-call-defuns))
            (prims (mapcar (lambda (n) (ndc--find n eic)) '(nl_eic_prim_list nl_eic_prim_make_vector))))
       (should (cl-every #'identity prims))
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) nda--mem 0)))
                 ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) nda--mem 0)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i v) (puthash (+ p i) v nda--mem)))
                 ((symbol-function 'ptr-read-u8) (lambda (p i) (gethash (+ p i) nda--bytes 0)))
                 ((symbol-function 'alloc-bytes) (lambda (n _a) (nda--alloc n)))
                 ((symbol-function 'nl_alloc_vector)
                  (lambda (n) (should (= n 0)) (puthash 40960 8 nda--mem) 40960))
                 ((symbol-function 'nelisp_cons_construct_w)
                  (lambda (a d _) (let ((c (nda--alloc 16)))
                                    (puthash c a nda--mem) (puthash (+ c 8) d nda--mem) (+ c 2))))
                 ((symbol-function 'nl_string_new)
                  (lambda (src n unibyte)
                    (let* ((h (nda--alloc 32)) (d (nda--alloc (max 1 n))))
                      (dotimes (i n) (puthash (+ d i) (if (= src 0) 0 (gethash (+ src i) nda--bytes 0)) nda--bytes))
                      (puthash h n nda--mem) (puthash (+ h 8) (if (= unibyte 1) -1 n) nda--mem)
                      (puthash (+ h 16) 0 nda--mem) (puthash (+ h 24) d nda--mem)
                      (+ h 4))))
                 ((symbol-function 'nl_string_copy_bytes)
                  (lambda (src dst n) (dotimes (i n) (puthash (+ dst i) (gethash (+ src i) nda--bytes 0) nda--bytes))))
                 ((symbol-function 'm5_make_repeated_string)
                  (lambda (n cp unibyte)
                    (let ((w (nl_string_new 0 n unibyte)))
                      (dotimes (i n) (puthash (+ (gethash (+ (- w 4) 24) nda--mem) i) cp nda--bytes))
                      (push (list n cp unibyte) nda--made)
                      w))))
         (dolist (f prims) (eval (ndc--host f) t))
         (funcall thunk))))))

(defun nda--vec-slots (word)
  (let* ((box (- word 6)) (n (ash (gethash box nda--mem) -8)))
    (cl-loop for i below n collect (gethash (+ box 8 (* i 8)) nda--mem))))

(defun nda--list-words (word)
  (let (out)
    (while (/= word 3)
      (push (gethash (- word 2) nda--mem) out)
      (setq word (gethash (+ (- word 2) 8) nda--mem)))
    (nreverse out)))

(ert-deftest nda-directcall-table-has-the-allocating-primitives ()
  (let ((forms (nelisp-standalone--directcall-defuns)))
    (should (ndc--find 'nl_directcall_alloc_run forms))
    (should (ndc--find 'nl_directcall_text_run forms))
    (dolist (spec '(("vector" 112) ("make-vector" 113) ("list" 114)
                    ("concat" 115) ("substring" 116) ("make-string" 117)))
      (let ((blob (nth 2 (cl-find-if (lambda (f) (eq (car f) 'data-blob)) forms)))
            (sid (nelisp-standalone--sid (car spec))))
        (should sid)
        (should (= (aref blob (* sid 4)) (+ (cadr spec) 17)))))))

(ert-deftest nda-vector-and-make-vector ()
  (nda--with-model
   (lambda ()
     (let* ((r (nda--call 112 (list (nda--fix 1) 3 7))))
       (should (= (car r) 0))
       (should (equal (nda--vec-slots (cdr r)) (list (nda--fix 1) 3 7)))
       (should (= (logand (cdr r) 7) 6)))
     (let ((r (nda--call 112 nil)))
       (should (= (car r) 0)) (should (equal (nda--vec-slots (cdr r)) nil))
       (should (= (cdr r) (+ 40960 6))) (should (= nda--allocs 0)))
     ;; A legacy view operand declines before any allocation.
     (let ((r (nda--call 112 (list (nda--fix 1) 4096))))
       (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0)))
     (let ((r (nda--call 113 (list (nda--fix 3) (nda--fix 9)))))
       (should (= (car r) 0))
       (should (equal (nda--vec-slots (cdr r)) (make-list 3 (nda--fix 9)))))
     (dolist (bad (list (list (nda--fix -1) 3) (list 3 3) (list (nda--fix 2000000) 3)))
       (let ((r (nda--call 113 bad)))
         (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0)))))))

(ert-deftest nda-list ()
  (nda--with-model
   (lambda ()
     (should (= (cdr (nda--call 114 nil)) 3))
     (let ((r (nda--call 114 (list (nda--fix 1) 3 (nda--fix 5)))))
       (should (= (car r) 0))
       (should (equal (nda--list-words (cdr r)) (list (nda--fix 1) 3 (nda--fix 5)))))
     (let ((r (nda--call 114 (list (nda--fix 1) 8192))))
       (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0))))))

(ert-deftest nda-concat ()
  (nda--with-model
   (lambda ()
     (let ((r (nda--call 115 nil))) (should (= (car r) 0)) (should (equal (nda--str-bytes (cdr r)) "")))
     (let ((r (nda--call 115 (list (nda--str "abcdefgh") (nda--str "ijklmnop")))))
       (should (= (car r) 0))
       (should (equal (nda--str-bytes (cdr r)) (concat "abcdefgh" "ijklmnop")))
       (should (< (gethash (+ (- (cdr r) 4) 8) nda--mem) 0)))
     ;; Multibyte ASCII with unibyte ASCII is multibyte; counts are chars and bytes.
     (let ((r (nda--call 115 (list (nda--str "ab" t) (nda--str "cd") (nda--str "" t)))))
       (should (= (car r) 0))
       (should (equal (nda--str-bytes (cdr r)) "abcd"))
       (should (= (gethash (- (cdr r) 4) nda--mem) 4))
       (should (= (gethash (+ (- (cdr r) 4) 8) nda--mem) 4)))
     ;; A unibyte byte >= 128 beside multibyte text, text properties, a non-string:
     ;; decline before the allocation.
     (let* ((hi (nda--str "\200")) (r (nda--call 115 (list (nda--str "a" t) hi))))
       (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0)))
     (dolist (bad (list (list (nda--str "a" nil t))
                        (list (nda--str "a") (nda--fix 1))
                        (list (nda--str "a") 3)))
       (let ((r (nda--call 115 bad)))
         (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0)))))))

(ert-deftest nda-substring ()
  (nda--with-model
   (lambda ()
     (let ((s (nda--str "abcdefghij")))
       (dolist (c `((,(nda--fix 2) ,(nda--fix 5) "cde") (,(nda--fix 0) 3 "abcdefghij")
                    (,(nda--fix 4) nil "efghij") (,(nda--fix 10) 3 "") (,(nda--fix 3) ,(nda--fix 3) "")))
         (let* ((args (append (list s (nth 0 c)) (and (nth 1 c) (list (nth 1 c)))))
                (r (nda--call 116 args)))
           (should (= (car r) 0))
           (should (equal (nda--str-bytes (cdr r)) (nth 2 c)))))
       ;; Negative, reversed or too-long indices, a missing FROM, a non-fixnum,
       ;; a non-string and an interval-carrying source: declined, nothing allocated.
       (dolist (bad (list (list s (nda--fix -1)) (list s (nda--fix 5) (nda--fix 2))
                          (list s (nda--fix 0) (nda--fix 11)) (list s) (list s 3 (nda--fix 2))
                          (list s (nda--fix 1) (nda--fix -1)) (list s (nda--fix 1) 4)
                          (list (nda--fix 1) (nda--fix 1))
                          (list (nda--str "abc" nil t) (nda--fix 1))
                          ;; Multibyte text with a non-ASCII character (bytes /= chars).
                          (list (let ((w (nda--str "abc" t))) (puthash (+ (- w 4) 8) 5 nda--mem) w)
                                (nda--fix 1))))
         (let ((r (nda--call 116 bad)))
           (should (= (car r) -3)) (should (null (cdr r))) (should (= nda--allocs 0))))))))

(ert-deftest nda-make-string ()
  (nda--with-model
   (lambda ()
     (setq nda--made nil)
     (let ((r (nda--call 117 (list (nda--fix 5) (nda--fix ?x)))))
       (should (= (car r) 0))
       (should (equal (nda--str-bytes (cdr r)) "xxxxx"))
       (should (equal nda--made '((5 120 1)))))
     (setq nda--made nil)
     (should (= (car (nda--call 117 (list (nda--fix 2) (nda--fix 233)))) 0))
     (should (equal nda--made '((2 233 0))))
     (setq nda--made nil)
     (dolist (bad (list (list (nda--fix 1) (nda--fix ?x) 3) (list (nda--fix -1) (nda--fix ?x))
                        (list (nda--fix 1) (nda--fix -1)) (list (nda--fix 1) (nda--fix 4194304))
                        (list 3 (nda--fix ?x)) (list (nda--fix 2000000) (nda--fix ?x))
                        (list (nda--fix 1) 3)))
       (let ((r (nda--call 117 bad)))
         (should (= (car r) -3)) (should (null (cdr r))) (should (null nda--made))
         (should (= nda--allocs 0)))))))

(ert-deftest nda-invoke-takes-the-fast-body-only-for-the-leaf-ids ()
  (ndc--with-definitions
   (lambda (_)
     (let ((fast nil) (run nil) (mem (make-hash-table :test #'eql)))
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem 0)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i v) (puthash (+ p i) v mem)))
                 ((symbol-function 'nl_n4_push_words) (lambda (&rest _) 55))
                 ((symbol-function 'nl_n4_finish_w) (lambda (w &rest _) w))
                 ((symbol-function 'nl_val_tag) (lambda (_) 4))
                 ((symbol-function 'nl_directcall_fast_run)
                  (lambda (id _b _n out) (push id fast) (puthash out 9 mem) 0))
                 ((symbol-function 'nl_directcall_run)
                  (lambda (id _b _n out _e) (push id run) (puthash out 11 mem) 0)))
         (dolist (c '((1 1 9 t) (110 1 9 t) (101 3 11 nil) (112 0 11 nil) (1 0 11 nil)))
           (setq fast nil run nil)
           (cl-letf (((symbol-function 'nl_directcall_id) (lambda (&rest _) (nth 0 c))))
             (should (= (nl_directcall_invoke 50002 20022 100 (nth 1 c) 1000 200) 0))
             (should (= (gethash 200 mem) (nth 2 c)))
             (should (eq (and fast t) (nth 3 c))))))))))

(ert-deftest nda-per-target-forms-keep-the-blob-on-linux-only ()
  ;; The descriptor data blob exists only in Linux x86-64 objects; every other
  ;; target reads the same descriptors from an inline chain over the static ids,
  ;; which now also covers the six allocating primitives.
  (dolist (target '(linux-x86_64 windows-x86_64 macos-aarch64 linux-aarch64))
    (let* ((nelisp-standalone--target target)
           (forms (nelisp-standalone--directcall-defuns))
           (blob (cl-find-if (lambda (f) (eq (car f) 'data-blob)) forms))
           (id (ndc--find 'nl_directcall_id forms)))
      (should id)
      (if (eq target 'linux-x86_64)
          (progn (should blob) (should (ndc--contains 'data-addr id)))
        (should-not blob)
        (should-not (ndc--contains 'data-addr id))
        (should-not (ndc--contains 'heap-read-u32 id))
        (dolist (name '("vector" "make-vector" "list" "concat" "substring" "make-string"))
          (should (ndc--contains (nelisp-standalone--sid name) id)))))))

(provide 'nelisp-directcall-alloc-test)
