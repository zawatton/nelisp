(ert-deftest nfi-addition-policy-and-generation ()
  (let* ((nelisp-cc-fxir-native--row-index (make-hash-table :test #'eq))
         (nelisp-cc-fxir-native-inline-additions t)
         (nelisp-cc-fxir-native--eager t)
         (calls '((:call 1 2 (:slot 0) (:slot 1))
                  (:call 4 2 (:slot 0) (:slot 1))
                  (:call 7 2 (:slot 0) (:slot 1))))
         (body (cons :seq (append (make-list 40 '(:slot 0)) calls)))
         (row (list 'caller 20001 2 '(addition-leaf addition-leaf addition-leaf)
                    (list :fn body) '(2 2 -1))))
    (puthash 'addition-leaf nfi--add-leaf nelisp-cc-fxir-native--row-index)
    (let ((text (prin1-to-string (nelisp-cc-fxir-native--defun row))))
      (should (string-match-p "ni_20001_1_41_" text))
      (should (string-match-p "ni_20001_1_42_" text))
      (should-not (string-match-p "ni_20001_1_43_" text)))
    (let ((nelisp-cc-fxir-native--eager nil))
      (should-not (string-match-p "ni_20001_" (prin1-to-string (nelisp-cc-fxir-native--defun row)))))
    (let ((small '(caller 20001 2 (addition-leaf)
                           (:fn (:call 1 2 (:slot 0) (:slot 1))) (2 2 -1))))
      (should-not (string-match-p "ni_20001_" (prin1-to-string (nelisp-cc-fxir-native--defun small)))))
    (should-not (nelisp-cc-fxir-inline-addition
                 '(flat 20002 2 (+) (:fn (:call 9 3 (:slot 0) (:slot 1) (:const 7))) (2 2 -1))))))

