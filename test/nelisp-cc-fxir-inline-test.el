(ert-deftest nfi-addition-overflow-guard-negative-controls ()
  (let* ((form (nelisp-cc-fxir-inline-form nfi--add-leaf 10006 2 '(20001 1) :addition))
         (first '(= (sar (shl ni_20001_1_16_sum 2) 2) ni_20001_1_16_sum))
         (second '(= (sar (shl ni_20001_1_17_next 2) 2) ni_20001_1_17_next))
         (without-first (cl-subst 1 first form :test #'equal))
         (without-second (cl-subst 1 second form :test #'equal))
         (underflow (lambda () (nfi--add-setup -9223372036854775807 -3)))
         (overflow (lambda () (nfi--add-setup 9223372036854775805 1))))
    (should-not (equal form without-first)) (should-not (equal form without-second))
    (should (= (plist-get (nfi--run form underflow) :vm) 1))
    (should (= (plist-get (nfi--run form overflow) :vm) 1))
    ;; Broken guards reach a slow operation inside the supposedly call-free body.
    (should-error (nfi--run without-first underflow) :type 'ert-test-failed)
    (should-error (nfi--run without-second overflow) :type 'ert-test-failed)))

