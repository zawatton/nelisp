(ert-deftest nfi-code-guard-and-slot-negative-controls ()
  ;; These deliberate faults must produce the wrong result, demonstrating
  ;; that the normal and changed-code observations distinguish both defects.
  (let* ((form (nelisp-cc-fxir-inline-form nfi--leaf 10006 2 '(20001 1)))
         (guard '(= (nl_vector_slot_word ni_20001_1_11_livecode 3) 1))
         (load0 '(heap-read-u64 (+ ni_20001_1_25_argw (* 0 8)) 0))
         (load1 '(heap-read-u64 (+ ni_20001_1_25_argw (* 1 8)) 0))
         (unguarded (cl-subst 1 guard form :test #'equal))
         (wrong-slot (cl-subst load1 load0 form :test #'equal)))
    (should-not (equal form unguarded))
    (should-not (equal form wrong-slot))
    (should (= (plist-get (nfi--run unguarded (lambda () (aset nfi--code 3 5))) :result) 33))
    (should (= (plist-get (nfi--run wrong-slot) :result) 69))))

(ert-deftest nfi-selected-site-complete-source-generation ()
  (let ((rows (list nfi--leaf
                    '(projection-caller 20001 2 (projection-leaf)
                      (:fn (:seq (:slot 0) (:slot 1) (:slot 0) (:slot 1)
                                 (:call 1 2 (:slot 0) (:slot 1)))) (2 2 -1))))
        (nelisp-cc-fxir-native-windows nil))
    (cl-letf (((symbol-function 'nelisp-cc-fxir-native--rows) (lambda () rows)))
      (let* ((nelisp-cc-fxir-native-inline-projections nil)
             (disabled (nelisp-cc-fxir-native-source))
             (nelisp-cc-fxir-native-inline-projections t)
             (enabled (nelisp-cc-fxir-native-source))
             (text (prin1-to-string enabled)))
        (should-not (equal disabled enabled))
        (should (string-match-p "ni_20001_" text))
        (should (string-match-p "m5_fx_run_body" text))
        (should (equal enabled (nelisp-cc-fxir-native-source)))))))

(defun nfi--add-setup (&optional x y)
  (setq nfi--code (copy-sequence [69 3 9 1 9 5 17 70006 5 5 17 70006 1 17]))
  (nfi--write 800024 0 (or x 9))
  (nfi--write 800032 0 (or y 13)))

(ert-deftest nfi-addition-direct-and-legacy-vector-guards ()
  (let* ((form (nelisp-cc-fxir-inline-form nfi--add-leaf 10006 2 '(20001 1) :addition t))
         (direct (nfi--run form #'nfi--add-setup))
         (legacy (nfi--run form (lambda () (nfi--add-setup) (aset nfi--record 0 51000)))))
    (dolist (result (list direct legacy))
      (should (= (plist-get result :result) 25))
      (should (= (plist-get result :vm) 0))
      (should (= (plist-get result :push) 1)))
    ;; Twelve guarded code words plus the fresh post-push ENTRY read.
    (should (= (plist-get direct :raw-code-reads) 13))
    (should (= (plist-get direct :header-reads) 1))
    (should (= (plist-get direct :generic-code-reads) 0))
    (should (= (plist-get legacy :raw-code-reads) 0))
    (should (= (plist-get legacy :header-reads) 0))
    (should (= (plist-get legacy :generic-code-reads) 12))
    (dolist (i '(0 1 2 3 4 5 6 8 9 10 12 13))
      (let ((result (nfi--run form (lambda () (nfi--add-setup)
                                     (aset nfi--code i (1+ (aref nfi--code i)))))))
        (should (= (plist-get result :vm) 1))
        (should (= (plist-get result :generic) 0))))
    (let ((legacy-miss (nfi--run form (lambda () (nfi--add-setup)
                                        (aset nfi--record 0 51000)
                                        (aset nfi--code 9 9)))))
      (should (= (plist-get legacy-miss :vm) 1))
      (should (= (plist-get legacy-miss :raw-code-reads) 0)))
    (dolist (mutation (list (lambda () (nfi--add-setup) (setq nfi--code-kind 7))
                            (lambda () (nfi--add-setup) (setq nfi--code (substring nfi--code 0 13)))))
      (let ((result (nfi--run form mutation)))
        (should (= (plist-get result :vm) 1))
        (should (= (plist-get result :raw-code-reads) 0))))))

(ert-deftest nfi-checked-kind-before-wide-header-negative-control ()
  (let* ((form (nelisp-cc-fxir-inline-form nfi--add-leaf 10006 2 '(20001 1) :addition t))
         (kind '(= (logand (ptr-read-u8 (- ni_20001_1_11_livecode 6) 0) 63) 8))
         (bad (cl-subst 1 kind form :test #'equal))
         (setup (lambda () (nfi--add-setup) (setq nfi--code-kind 7))))
    (should-not (equal bad form))
    (should (= (plist-get (nfi--run form setup) :header-reads) 0))
    (should (= (plist-get (nfi--run bad setup) :header-reads) 1))))

(ert-deftest nfi-checked-cold-push-reloads-current-entry ()
  ;; The hook models a reentry boundary, not a claim about allocator behavior.
  (let* ((form (nelisp-cc-fxir-inline-form nfi--add-leaf 10006 2 '(20001 1) :addition t))
         (binding '(ni_20001_1_27_code (ptr-read-u64 (+ ni_20001_1_7_rec 2) 0)))
         (stale (cl-subst '(ni_20001_1_27_code ni_20001_1_11_livecode)
                          binding form :test #'equal))
         (setup (lambda ()
                  (nfi--add-setup)
                  (nfi--write 100000 176 0)
                  (setq nfi--cold-hook
                        (lambda ()
                          (nfi--write 52000 0 (logior (ash 14 8) 8))
                          (dotimes (i (length nfi--code))
                            (nfi--write 52008 (* i 8) (aref nfi--code i)))
                          (nfi--write 53000 0 (logior (ash 2 8) 8))
                          (nfi--write 53008 0 3)
                          (nfi--write 53016 0 3)
                          (nfi--write 52016 0 53006)
                          (nfi--write 40008 0 52006)))))
         (run (nfi--run form setup)) (broken (nfi--run stale setup)))
    (should-not (equal form stale))
    (should (= (plist-get run :entry-checks) 1))
