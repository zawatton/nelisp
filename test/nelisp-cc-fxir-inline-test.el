(require 'ert)
(require 'cl-lib)
(defvar nelisp-cc-fxir-native-windows)
(defvar nelisp-cc-fxir-native--shared-source)
(defvar nelisp-cc-fxir-native--eager)
(defvar nelisp-cc-fxir-native--row-index)
(defvar nelisp-cc-fxir-native-inline-projections)
(defvar nelisp-cc-fxir-native-inline-additions)
(defvar nelisp-cc-fxir-native-inline-checked-additions)
(let ((nelisp-cc-fxir-native-windows t)) (require 'nelisp-cc-fxir-native))
(require 'nelisp-cc-fxir-inline)

(defconst nfi--leaf '(projection-leaf 20000 2 nil (:fn (:slot 0)) (2 2 -1)))
(defconst nfi--add-leaf
  '(addition-leaf 20000 2 nil (:fn (:inline 4 11 (:inline 4 7 (:slot 0) (:slot 1)) (:const 9))) (2 2 -1)))
(defvar nfi--memory)
(defvar nfi--code)
(defvar nfi--record)
(defvar nfi--vm-count)
(defvar nfi--generic-count)
(defvar nfi--finish-count)
(defvar nfi--push-count)
(defvar nfi--cut-depth)
(defvar nfi--status)
(defvar nfi--raw-code-reads)
(defvar nfi--generic-code-reads)
(defvar nfi--header-reads)
(defvar nfi--cold-hook)
(defvar nfi--entry-count)
(defvar nfi--code-kind)
(defun nfi--truth (x) (and x (not (equal x 0))))
(defun nfi--read (p i) (gethash (+ p i) nfi--memory 0))
(defun nfi--raw-read (p i)
  (when (= (+ p i) 50000) (cl-incf nfi--header-reads))
  (when (and (>= (+ p i) 50008) (< (+ p i) 50120))
    (cl-incf nfi--raw-code-reads))
  (nfi--read p i))
(defun nfi--write (p i v) (puthash (+ p i) v nfi--memory) v)
(defun nfi--host (form)
  "Adapt only dialect syntax/truth; preserve generated control structure."
  (cond ((atom form) form)
        ((eq (car form) 'data-addr)
         (pcase (nth 1 form) ('nl_thread_registry 900000) ('nl_rootstack_top 900008)
                ('nl_rootstack_region 100000) (_ (error "Unexpected data address"))))
        ((memq (car form) '(let let*))
         (cons (car form) (cons (mapcar (lambda (b) (list (car b) (nfi--host (nth 1 b)))) (nth 1 form))
                               (mapcar #'nfi--host (cddr form)))))
        ((eq (car form) 'if)
         `(if (nfi--truth ,(nfi--host (nth 1 form)))
              ,(nfi--host (nth 2 form)) ,(nfi--host (nth 3 form))))
        ((eq (car form) 'and)
         (if (null (cdr form)) 1
           `(if (nfi--truth ,(nfi--host (nth 1 form)))
                ,(nfi--host (cons 'and (cddr form))) 0)))
        ((eq (car form) 'or)
         (if (null (cdr form)) 0
           `(if (nfi--truth ,(nfi--host (nth 1 form))) 1
              ,(nfi--host (cons 'or (cddr form))))))
        (t (cons (pcase (car form) ('seq 'progn) ('shl 'nfi--shl)
                        ('sar 'nfi--sar) (_ (car form)))
                 (mapcar #'nfi--host (cdr form))))))
(defun nfi--sar (v n) (ash v (- n)))
(defun nfi--shl (v n)
  (let ((w (logand (ash v n) (1- (expt 2 64)))))
    (if (>= w (expt 2 63)) (- w (expt 2 64)) w)))

(defun nfi--run (form &optional mutate)
  "Run generated source in a bounded memory/protocol model, not native code."
  (let ((nfi--memory (make-hash-table :test #'eql))
        (nfi--code (copy-sequence [69 3 9 1 1 13]))
        (nfi--record (copy-sequence [50006 -80063 9 3 3 9 -3 3]))
        (nfi--vm-count 0) (nfi--generic-count 0) (nfi--finish-count 0) (nfi--push-count 0)
        (nfi--raw-code-reads 0) (nfi--generic-code-reads 0) (nfi--header-reads 0)
        (nfi--code-kind 8)
        (nfi--status -1) (nfi--cut-depth nil) (nfi--cold-hook nil) (nfi--entry-count 0))
    (dolist (p '((10008 . 20006) (10032 . 30006) (10040 . 40006)
                 (20024 . 30006) (40064 . 3) (100176 . 600000)
                 (100040 . 700000) (700024 . 1) (900008 . 123456)
                 (800024 . 33) (800032 . 69)))
      (puthash (car p) (cdr p) nfi--memory))
    (when mutate (funcall mutate))
    (cl-letf (((symbol-function 'heap-read-u64) #'nfi--read)
              ((symbol-function 'ptr-read-u64) #'nfi--raw-read)
              ((symbol-function 'ptr-read-u8) #'nfi--read)
              ((symbol-function 'ptr-write-u64) #'nfi--write)
              ((symbol-function 'nl_word_payload) (lambda (word) (if (= word 51000) 50000 (- word 6))))
              ((symbol-function 'nl_val_tag) (lambda (word) (if (memq word '(50006 51000)) nfi--code-kind 0)))
              ((symbol-function 'vector-len) (lambda (_) (length nfi--code)))
              ((symbol-function 'nl_vector_slot_word)
               (lambda (word slot)
                 (cond ((memq word '(50006 51000)) (cl-incf nfi--generic-code-reads) (aref nfi--code slot))
                       ((= word 10006) (aref [20006 3 3 30006 40006] slot))
                       ((= word 40006) (aref nfi--record slot))
                       (t (error "Unexpected vector %S" word)))))
              ((symbol-function 'nl_n4_cut_capture)
               (lambda (_) (setq nfi--cut-depth (nfi--read 600000 0))
                 (setq nfi--push-count (1+ nfi--push-count)) 4445))
              ((symbol-function 'nl_n4_push_words)
               (lambda (env function stk argc)
                 (should (= env 100000)) (should (= function 20006))
                 (should (= stk 800024)) (should (= argc 2))
                 (setq nfi--push-count (1+ nfi--push-count))
                 (nfi--write 600064 56 4445)
                 (nfi--write 600000 0 (1+ (nfi--read 600000 0))) 600064))
              ((symbol-function 'nl_sb_worker_p) (lambda (_) 1))
              ((symbol-function 'nl_n4_push_words_cold)
               (lambda (env _fn _stk _argc)
                 (unless nfi--cold-hook (ert-fail "Unexpected cold push"))
                 (funcall nfi--cold-hook)
                 (nfi--write env 176 600000)
                 (nfi--write 600064 56 4445)
                 (nfi--write 600000 0 1)
                 (cl-incf nfi--push-count) 600064))
              ((symbol-function 'm5_fx_entry_check)
               (lambda (_entry _env) (cl-incf nfi--entry-count) 1))
              ((symbol-function 'nc_enter) (lambda (_env n) (should (= n 7)) 810000))
              ((symbol-function 'nc_arith) (lambda (&rest _) (ert-fail "Unexpected arithmetic fallback")))
              ((symbol-function 'nl_n4_finish_w)
               (lambda (_st _env _zero _frame)
                 (nfi--write 600000 0 (1- (nfi--read 600000 0))) 0))
              ((symbol-function 'm5_fx_run_done)
               (lambda (status env depth) (nfi--write env 96 depth) status))
              ((symbol-function 'm5_fx_run_body)
               (lambda (_code locals _env _out _args argc argw wout)
                 (should (= locals 2)) (should (= argc 2))
                 (setq nfi--vm-count (1+ nfi--vm-count))
                 (nfi--write wout 0 (if (= (length nfi--code) 14) 901
                                      (nfi--read argw (* 8 (/ (1- (aref nfi--code 3)) 4)))))
                 nfi--status))
              ((symbol-function 'nc_call)
               (lambda (_env _site _stk _argc resw _oslot)
                 (setq nfi--generic-count (1+ nfi--generic-count))
                 (nfi--write resw 0 777) 0))
              ((symbol-function 'm5_fx_call_words_done)
               (lambda (status _env _oslot _resw _frame _pad)
                 (setq nfi--finish-count (1+ nfi--finish-count)) status)))
      ;; The actual activation reads the entry word through raw memory.
      (puthash 50000 (logior (ash (length nfi--code) 8) nfi--code-kind) nfi--memory)
      (dotimes (i (length nfi--code)) (puthash (+ 50008 (* 8 i)) (aref nfi--code i) nfi--memory))
      (dotimes (i 7) (puthash (+ 40008 (* 8 i)) (aref nfi--record i) nfi--memory))
      (unless (= (aref nfi--record 7) 3)
        (puthash 40064 (aref nfi--record 7) nfi--memory))
      (let* ((status (eval (nfi--host form) '((env . 100000) (mem . 800000) (oslot . 0))))
             (result (nfi--read 800000 0)))
        (list :result result :status status :vm nfi--vm-count :generic nfi--generic-count :push nfi--push-count
              :raw-code-reads nfi--raw-code-reads :generic-code-reads nfi--generic-code-reads
              :header-reads nfi--header-reads :entry-checks nfi--entry-count
              :finish nfi--finish-count :depth (nfi--read 100000 96)
              :frames (nfi--read 600000 0) :cut (nfi--read 600064 56) :cut-depth nfi--cut-depth
              :root (nfi--read 900008 0))))))

(ert-deftest nfi-projection-only-certificate ()
  (should (nelisp-cc-fxir-inline-projection nfi--leaf))
  (dolist (body '((:const 1) (:seq (:slot 0)) (:inline 7 1 (:slot 0)) (:slot 2)))
    (let ((row (copy-tree nfi--leaf)))
      (setcar (cdr (nth 4 row)) body)
      (should-not (nelisp-cc-fxir-inline-projection row)))))

(ert-deftest nfi-splice-root-depth-cut-and-result ()
  (let* ((form (nelisp-cc-fxir-inline-form nfi--leaf 10006 2 '(20001 1)))
         (run (nfi--run form)))
    (should (= (plist-get run :result) 33))
    (should (= (plist-get run :vm) 0)) (should (= (plist-get run :generic) 0))
    (should (= (plist-get run :frames) 0)) (should (= (plist-get run :depth) 0))
    (should (= (plist-get run :root) 123456)) (should (= (plist-get run :cut) 4445))
    (should (= (plist-get run :cut-depth) 0))
    (should (= (plist-get run :push) 1))
    (should-not (string-match-p "(nc_20000 " (prin1-to-string form)))))

(ert-deftest nfi-old-push-template-misses-cut-negative-control ()
  (let* ((form (nelisp-cc-fxir-inline-form nfi--leaf 10006 2 '(20001 1)))
         (env (caar (nth 1 form)))
         (old (cl-subst 0 `(nl_n4_cut_capture ,env) form :test #'equal)))
    (should-not (equal form old))
    (should (= (plist-get (nfi--run form) :cut) 4445))
    (should (= (plist-get (nfi--run old) :cut) 0))))

(ert-deftest nfi-environment-read-representation-fallback ()
  ;; Offsets preserve the tag bits.  Model the getter's unusual string arm
  ;; distinctly so a missing guard is observable, even on a non-native host.
  (let* ((form (nelisp-cc-fxir-inline-form nfi--leaf 10006 2 '(20001 1)))
         (env (caar (nth 1 form))))
    (dolist (off '(96 112))
      (let ((read `(if (/= (logand ,env 7) 4)
                       (ptr-read-u64 (+ ,env ,off) 0)
                     (heap-read-u64 (+ ,env ,off) 0))))
        (should (nelisp-cc-fxir-inline--contains form read))
        (cl-letf (((symbol-function 'ptr-read-u64) (lambda (_p _o) 11))
                  ((symbol-function 'heap-read-u64) (lambda (_p _o) 22)))
          (should (= 11 (eval (nfi--host read) `((,env . 100000)))))
          (should (= 22 (eval (nfi--host read) `((,env . 100004)))))
          (should (= 11 (eval (nfi--host (cl-subst 1 `(/= (logand ,env 7) 4) read :test #'equal))
                              `((,env . 100004))))))))))

(ert-deftest nfi-checked-direct-entry-and-dead-local-controls ()
  (let* ((activation (nth 3 (nelisp-cc-fxir-native--defun
                             nfi--add-leaf (lambda (_) (cons nil '(+ (shl next 2) 1))))))
         (selected (nelisp-cc-fxir-inline--checked-activation activation))
         (entry '(heap-read-u64 (+ (+ (nl_word_payload code) 8) 8) 0))
         (fast `(if (= (logand code 7) 6) (ptr-read-u64 (+ code 10) 0) ,entry)))
    (should (nelisp-cc-fxir-inline--contains selected fast))
    (should-not (nelisp-cc-fxir-inline--contains selected
                 '(setq l0 (heap-read-u64 (+ argw (* 0 8)) 0))))
    (should-not (nelisp-cc-fxir-inline--contains selected
                 '(setq l1 (heap-read-u64 (+ argw (* 1 8)) 0))))
    (should (nelisp-cc-fxir-inline--contains selected
             '(if (= st 0) (seq 0 0 (ptr-write-u64 wout 0 (+ (shl next 2) 1))) 0)))
    (should-error (nelisp-cc-fxir-inline--checked-activation
                   (cl-subst '(setq l0 7) '(setq l0 (heap-read-u64 (+ argw (* 0 8)) 0))
                             activation :test #'equal)))
    ;; Insert real uses without changing any of the replacement targets.
    ;; Suppressing only the use-count guard must let these mutants through.
    (let ((original-count (symbol-function 'nelisp-cc-fxir-inline--count-form)))
      (dolist (spec '((l0 (setq l0 (heap-read-u64 (+ argw (* 0 8)) 0)) l0)
                      (l1 (setq l1 (heap-read-u64 (+ argw (* 1 8)) 0)) l1)
                      (nb (if (> nb 0) (wf_bytecode_unbind (+ env 32) nb) 0)
                          (setq nb 1))))
        (let* ((old (nth 1 spec))
               (mutant (cl-subst `(seq ,old ,(nth 2 spec)) old activation :test #'equal))
               (err (should-error (nelisp-cc-fxir-inline--checked-activation mutant))))
          (should (equal (cadr err) "Checked activation local use changed"))
          (cl-letf (((symbol-function 'nelisp-cc-fxir-inline--count-form)
                     (lambda (form target)
                       (if (memq target '(l0 l1 nb))
                           (if (eq target 'nb) 3 2)
                         (funcall original-count form target)))))
            (should (nelisp-cc-fxir-inline--checked-activation mutant))))))
    (should-error (nelisp-cc-fxir-inline--checked-activation
                   (cl-subst '(setq nb 1) '(if (> nb 0) (wf_bytecode_unbind (+ env 32) nb) 0)
                             activation :test #'equal)))))

(defun nfi--enter-run (form top registry)
  (let ((nfi--memory (make-hash-table :test #'eql)) (writes nil) (fallback 0))
    (nfi--write 900008 0 top)
    (nfi--write 900000 0 registry)
    (cl-letf (((symbol-function 'heap-read-u64) #'nfi--read)
              ((symbol-function 'ptr-write-u64)
               (lambda (p o value) (push (list (+ p o) value) writes)
                 (nfi--write p o value)))
              ((symbol-function 'nc_enter)
               (lambda (_env n) (should (= n 7)) (cl-incf fallback) 888)))
      (let ((value (eval (nfi--host form) '((env . 100000)))))
        (list value fallback (nreverse writes))))))

(ert-deftest nfi-enter-seven-order-and-miss-controls ()
  (let* ((form (nelisp-cc-fxir-inline--enter-seven))
         (run (nfi--enter-run form 123456 0))
         (expected (append '((123456 1464226381) (123464 7) (123472 0) (123480 0))
                           (cl-loop for i below 7 collect (list (+ 123488 (* i 8)) 3))
                           '((123552 0) (123560 0) (123568 0) (123576 0) (900008 123584)))))
    (should (= (nth 0 run) 123488))
    (should (= (nth 1 run) 0))
    (should (equal (nth 2 run) expected))
    (should (= (car (nfi--enter-run form 4294176 0)) 4294208))
    (dolist (args '((0 0) (4294180 0) (123456 1)))
      (let ((miss (nfi--enter-run form (car args) (cadr args))))
        (should (equal miss '(888 1 nil)))))
    (let ((bad (cl-subst 0 '(ptr-write-u64 slot 16 3) form :test #'equal)))
      (should-not (equal form bad))
      (should-not (equal (nth 2 (nfi--enter-run bad 123456 0)) expected)))
    (let ((nelisp-cc-fxir-native--shared-source
           (cl-subst 1464226382 1464226381 nelisp-cc-fxir-native--shared-source :test #'equal)))
      (should-error (nelisp-cc-fxir-inline--enter-seven)))))

