(ert-deftest nfi-disabled-and-growth-budget-controls ()
  (let* ((nelisp-cc-fxir-native--row-index (make-hash-table :test #'eq))
         (caller '(projection-caller 20001 2 (projection-leaf projection-leaf projection-leaf)
                   (:fn (:seq (:slot 0) (:slot 1) (:slot 0) (:slot 1) (:slot 0)
                              (:call 1 2 (:slot 0) (:slot 1))
                              (:call 4 2 (:slot 0) (:slot 1))
                              (:call 7 2 (:slot 0) (:slot 1)))) (2 2 -1))))
    (puthash 'projection-leaf nfi--leaf nelisp-cc-fxir-native--row-index)
    (let ((nelisp-cc-fxir-native-inline-projections nil))
      (should-not (string-match-p "ni_20001_" (prin1-to-string (nelisp-cc-fxir-native--defun caller)))))
    (let* ((nelisp-cc-fxir-native-inline-projections t)
           (form (prin1-to-string (nelisp-cc-fxir-native--defun caller))))
      (should (string-match-p "ni_20001_1_6_" form))
      (should (string-match-p "ni_20001_1_7_" form))
      (should-not (string-match-p "ni_20001_1_8_" form)))
    ;; Two IR nodes permit no >=1-node growth charge at the 20% bound.
    (let ((nelisp-cc-fxir-native-inline-projections t))
      (should-not (string-match-p "ni_" (prin1-to-string
                       (nelisp-cc-fxir-native--defun
                        '(tiny 20002 2 (projection-leaf)
                          (:fn (:call 1 2 (:slot 0) (:slot 1))) (2 2 -1)))))))))

