(ert-deftest nfi-rewrite-verifier-gates-emission ()
  (require 'nelisp-cc-fxir-facts)
  (let* ((nelisp-cc-fxir-native--row-index (make-hash-table :test #'eq))
         (nelisp-cc-fxir-native-inline-additions t)
         (nelisp-cc-fxir-native-inline-checked-additions t)
         (nelisp-cc-fxir-native--eager t)
         (row (list 'caller 20001 2 '(addition-leaf)
                    (list :fn (cons :seq (append (make-list 20 '(:slot 0))
                                                 '((:call 1 2 (:slot 0) (:slot 1))))))
                    '(2 2 -1)))
         (seen nil) rejected accepted)
    (puthash 'addition-leaf nfi--add-leaf nelisp-cc-fxir-native--row-index)
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-verify-add-region)
               (lambda (_row _site baseline candidate)
                 (setq seen (list baseline candidate)) nil)))
      (setq rejected (nelisp-cc-fxir-native--defun row)))
    (should seen)
    (let ((nelisp-cc-fxir-native-inline-checked-additions nil))
      (should (equal rejected (nelisp-cc-fxir-native--defun row))))
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-verify-add-region)
               (lambda (_row _site _baseline _candidate) t)))
      (setq accepted (nelisp-cc-fxir-native--defun row)))
    (should-not (equal accepted rejected))))

(ert-deftest nfi-real-verifier-consumes-selected-addition ()
  (require 'nelisp-cc-fxir-facts)
