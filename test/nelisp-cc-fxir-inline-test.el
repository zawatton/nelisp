    (should (= (plist-get run :result) 777))
    (should (= (plist-get run :frames) 0))
    (should (= (plist-get run :depth) 0))
    (should (= (plist-get broken :entry-checks) 0))
    (should (= (plist-get broken :generic) 0))
    (should (= (plist-get broken :result) 25))))

