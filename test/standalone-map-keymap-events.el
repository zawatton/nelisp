;;; standalone-map-keymap-events.el --- Callback event and legacy storage controls -*- lexical-binding: t; -*-
(require 'nelisp-stdlib-sparse-keymap)
(let ((installation (nelisp-stdlib-sparse-keymap-install)))
  (let ((map (make-sparse-keymap)) (prefix (make-sparse-keymap)) events)
    (define-key prefix [98] 'old-command)
    (define-key map [24] prefix)
    (map-keymap (lambda (event definition) (push (list event definition) events)) map)
    (unless (and (= (length events) 1) (= (caar events) 24)
                 (eq (cadar events) prefix))
      (error "Keymap callback event was not integer24"))
    (let ((target (make-sparse-keymap)))
      (substitute-key-definition 'old-command 'new-command target map)
      (unless (eq (lookup-key target [24 98]) 'new-command)
        (error "Generalized key substitution lost prefix events")))
    (unless (condition-case nil (progn (lookup-key map [[24]]) nil) (error t))
      (error "Nested vector event was accepted")))
  (when (eq installation 'installed)
    (let* ((prefix (list 'keymap (cons [98] 'old-command)))
           (legacy (list 'keymap (cons [24] prefix))) events)
      (map-keymap (lambda (event definition) (push event events)) legacy)
      (unless (equal events '(24)) (error "Legacy callback vector leaked"))
      (let ((target (make-sparse-keymap)))
        (substitute-key-definition 'old-command 'new-command target legacy)
        (unless (eq (lookup-key target [24 98]) 'new-command)
          (error "Legacy generalized key substitution failed"))))))
(princ "MAP-KEYMAP-EVENTS-PASS\n")
