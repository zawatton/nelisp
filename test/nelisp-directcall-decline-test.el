;;; nelisp-directcall-decline-test.el --- Cheap directcall misses -*- lexical-binding: t; -*-

(require 'nelisp-directcall-test)

(ert-deftest ndc-decline-symbol-miss-precedes-descriptor-reads ()
  (ndc--with-definitions
   (lambda (_defs)
     (dolist (name '("vector" "make-vector" "make-string"))
       (let ((reads 0))
         (cl-letf (((symbol-function 'nl_val_tag) (lambda (_) 4))
                   ((symbol-function 'nl_sym_sid)
                    (lambda (_) (cl-incf reads) (nelisp-standalone--sid name)))
                   ((symbol-function 'ptr-read-u64)
                    (lambda (&rest _) (ert-fail "Miss inspected the descriptor"))))
           (should (= (nl_directcall_id 10002 20022 1) 0))
           (should (= reads 1))))))))

(ert-deftest ndc-decline-descriptor-sid-read-once-and-revalidated ()
  (ndc--with-definitions
   (lambda (_defs)
     (dolist (spec '(("car" 1 1) ("nth" 10 2) ("length" -16 1)
                     ("aset" -15 3) ("logand" 27 2)))
       (let ((mem (make-hash-table :test #'eql)) (reads 0)
             (name (car spec)) (id (cadr spec)) (argc (nth 2 spec)))
         (puthash 10000 20006 mem) (puthash 10008 10018 mem)
         (puthash 10016 20022 mem) (puthash 10024 3 mem)
         (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                   ((symbol-function 'nl_val_tag)
                    (lambda (w) (if (memq w '(20006 20022)) 4 7)))
                   ((symbol-function 'nl_sym_sid)
                    (lambda (w) (if (= w 20006) (nelisp-standalone--sid "builtin")
                                  (cl-incf reads) (or (nelisp-standalone--sid name) 0))))
                   ((symbol-function 'sexp-name-eq)
                    (lambda (w s) (if (and (= w 20022) (equal s name)) 1 0))))
           (should (= (nl_directcall_id 10002 20022 argc) id))
           (should (= reads 1))
           ;; A warm direct hit must not hide a changed descriptor.
           (puthash 10024 10002 mem)
           (should (= (nl_directcall_id 10002 20022 argc) 0))
           (puthash 10024 3 mem)
           (should (= (nl_directcall_id 10002 10002 argc) id))))))))

(ert-deftest ndc-decline-nonprimitive-precedes-argument-counting ()
  (ndc--with-definitions
   (lambda (_defs)
     (dolist (applyp '(0 1))
       (dolist (target '(30006 30002))
         (cl-letf (((symbol-function 'nl_val_tag)
                    (lambda (w) (cond ((= w 10002) 7) ((= w 30006) 17) (t 7))))
                   ((symbol-function 'nl_cons_car_word) (lambda (_) target))
                   ((symbol-function 'ptr-read-u64) (lambda (&rest _) 40006))
                   ((symbol-function 'nl_sym_sid) (lambda (_) 0))
                   ((symbol-function 'nl_sp_nargs)
                    (lambda (&rest _) (ert-fail "Nonprimitive counted arguments")))
                   ((symbol-function 'wf_arg_word)
                    (lambda (&rest _) (ert-fail "Nonprimitive scanned arguments")))
                   ((symbol-function 'nl_root_frame)
                    (lambda (&rest _) (ert-fail "Nonprimitive allocated argv"))))
           (should (= (nl_directcall_list_words 10002 200 applyp) 2))))))))

(ert-deftest ndc-decline-symbol-bytecode-precedes-argument-counting ()
  (ndc--with-definitions
   (lambda (_defs)
     (dolist (applyp '(0 1))
       (let ((lookups 0))
         (cl-letf (((symbol-function 'nl_val_tag) (lambda (w) (if (= w 20022) 4 7)))
                   ((symbol-function 'nl_cons_car_word) (lambda (_) 20022))
                   ;; w2subr: a class-6 target is checked for the Subr header kind.
                   ((symbol-function 'ptr-read-u64) (lambda (&rest _) 17))
                   ((symbol-function 'nelisp_env_lookup_function_w)
                    (lambda (&rest _) (cl-incf lookups) 30006))
                ((symbol-function 'nelisp_env_lookup_function_raw_w)
                    (lambda (&rest _) (cl-incf lookups) 30006))
                   ((symbol-function 'nl_sp_nargs)
                    (lambda (&rest _) (ert-fail "Bytecode target counted arguments"))))
           (should (= (nl_directcall_list_words 10002 200 applyp) 2))
           (should (= lookups 1))))))))

(ert-deftest ndc-decline-generator-caches-name-sid ()
  (let* ((form (ndc--find 'nl_directcall_id (nelisp-standalone--directcall-defuns)))
         (count 0))
    (cl-labels ((walk (x)
                  (when (consp x)
                    (when (equal x '(nl_sym_sid name)) (cl-incf count))
                    (walk (car x)) (walk (cdr x)))))
      (walk form))
    (should (= count 1))))

(provide 'nelisp-directcall-decline-test)
