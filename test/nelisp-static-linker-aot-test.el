;;; nelisp-static-linker-aot-test.el --- AOT linker bridge tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(let ((root (expand-file-name ".." (file-name-directory (or load-file-name buffer-file-name)))))
  (add-to-list 'load-path (expand-file-name "lisp" root))
  (add-to-list 'load-path (expand-file-name "src" root)))
(require 'nelisp-aot-compiler)
(require 'nelisp-static-linker)

(defun nelisp-link-aot-test--compile (form &optional arch format)
  (nelisp-aot-compile-to-link-unit form :arch (or arch 'x86_64)
                                   :format (or format 'elf)))

(defun nelisp-link-aot-test--read32 (bytes offset)
  (let ((n 0))
    (dotimes (i 4) (setq n (+ n (ash (aref bytes (+ offset i)) (* 8 i)))))
    (if (>= n #x80000000) (- n #x100000000) n)))

(defun nelisp-link-aot-test--target (unit rel symbol-unit)
  (let* ((layout '((text . 4096) (rodata . 8192) (data . 12288) (bss . 16384)))
         (result (nelisp-link-units-2pass (list unit symbol-unit) layout))
         (bytes (cdr (assq 'text (plist-get result :bytes))))
         (offset (plist-get rel :offset)))
    (+ 4096 offset 4 (nelisp-link-aot-test--read32 bytes offset))))

(ert-deftest nelisp-link-aot/data-address-exact ()
  (let* ((raw (nelisp-link-aot-test--compile '(defun probe () (data-addr external_data))))
         (rel (car (plist-get raw :relocs)))
         (def (nelisp-link-unit-make "z" '((data . [1]))
                (list (nelisp-link-symbol "external_data" 0 :section 'data)) nil)))
    (should (= (nelisp-link-aot-test--target
                (nelisp-link-unit-from-aot "a" raw) rel def) 12288))))

(ert-deftest nelisp-link-aot/call-exact ()
  (let* ((raw (nelisp-link-aot-test--compile '(defun probe () (extern-call external_call))))
         (rel (car (plist-get raw :relocs)))
         (def (nelisp-link-unit-make "z" '((rodata . [1]))
                (list (nelisp-link-symbol "external_call" 0 :section 'rodata)) nil)))
    (should (eq (plist-get rel :type) 'plt32))
    (should (= (nelisp-link-aot-test--target
                (nelisp-link-unit-from-aot "a" raw) rel def) 8192))))

(ert-deftest nelisp-link-aot/input-unchanged-and-data ()
  (let* ((raw (nelisp-link-aot-test--compile
               '(progn (data-blob msg (1 2 3 4) rodata)
                       (data-blob ptr (0 0 0 0 0 0 0 0) data ((0 msg 3)))
                       (data-blob zero (0 0 0 0) bss)
                       (defun probe () (data-addr msg)))))
         (before (copy-tree raw t))
         (unit (nelisp-link-unit-from-aot "a" raw))
         (rel (cl-find 'abs64 (plist-get unit :relocs) :key (lambda (r) (plist-get r :type)))))
    (should (equal raw before))
    (should (= (plist-get rel :addend) 3))
    (should (eq (plist-get rel :section) 'data))
    (should (equal (cdr (assq 'data (plist-get unit :sections))) (plist-get raw :data)))
    (should (= (cdr (assq 'bss (plist-get unit :sections))) (plist-get raw :bss-size)))
    (let* ((result (nelisp-link-units-2pass (list unit) '((text . 4096) (rodata . 8192) (data . 12288) (bss . 16384))))
           (bytes (cdr (assq 'data (plist-get result :bytes)))))
      (should (= (nelisp-link-aot-test--read32 bytes 0) 8195)))))

(ert-deftest nelisp-link-aot/arm-pair ()
  (let* ((raw (nelisp-link-aot-test--compile '(defun probe () (data-addr ext)) 'aarch64))
         (unit (nelisp-link-unit-from-aot "a" raw)))
    (should (= (length (plist-get raw :relocs)) 2))
    (should (equal (plist-get raw :relocs) (plist-get unit :relocs)))))

(ert-deftest nelisp-link-aot/local-names-independent ()
  (let* ((a (nelisp-link-aot-test--compile '(progn (data-blob blob (11) rodata) (defun first () (data-addr blob)))))
         (b (nelisp-link-aot-test--compile '(progn (data-blob blob (22) rodata) (defun second () (data-addr blob)))))
         (ua (nelisp-link-unit-from-aot "a" a)) (ub (nelisp-link-unit-from-aot "b" b))
         (result (nelisp-link-units-2pass (list ua ub) '((text . 4096) (rodata . 8192) (data . 12288) (bss . 16384))))
         (bytes (cdr (assq 'text (plist-get result :bytes))))
         (offsets (plist-get result :section-offsets)))
    (dolist (pair (list (list ua "a" a 0 0)
                        (list ub "b" b (length (plist-get a :text))
                              (length (plist-get a :rodata)))))
      (let* ((unit (car pair)) (name (cadr pair))
             (rel (car (plist-get unit :relocs)))
             (offset (+ (nelisp-link--combined-offset offsets 'text name) (plist-get rel :offset)))
             (target (+ 4096 offset 4 (nelisp-link-aot-test--read32 bytes offset)))
             (raw-symbol (cl-find "blob" (plist-get (nth 2 pair) :symbols)
                                  :test #'equal :key (lambda (s) (plist-get s :name)))))
        (should (= offset (+ (nth 3 pair) (plist-get rel :offset))))
        (should (= target (+ 8192 (nth 4 pair) (plist-get raw-symbol :value))))))
    (should-not (gethash "blob" (plist-get result :symtab)))))

(ert-deftest nelisp-link-aot/reject-converted-and-wasm ()
  (let* ((raw (nelisp-link-aot-test--compile '(defun probe () 1)))
         (unit (nelisp-link-unit-from-aot "a" raw)))
    (should-error (nelisp-link-unit-from-aot "a" unit) :type 'nelisp-link-error)
    (should-error (nelisp-link-unit-from-aot "a" '(:machine wasm32 :text "" :symbols nil :relocs nil)) :type 'nelisp-link-error)))

(ert-deftest nelisp-link-aot/weak-and-undefined ()
  (let* ((raw (nelisp-link-aot-test--compile '(defun probe () (data-addr shared))))
         (weak (list :name "shared" :value 0 :section 'data :bind 'weak))
         (strong (nelisp-link-unit-make "z" '((rodata . [9]))
                   (list (nelisp-link-symbol "shared" 0 :section 'rodata)) nil)))
    (plist-put raw :symbols (cons weak (plist-get raw :symbols)))
    (let* ((unit (nelisp-link-unit-from-aot "a" raw))
           (result (nelisp-link-units-2pass (list unit strong)
                    '((text . 4096) (rodata . 8192) (data . 12288) (bss . 16384)))))
      (should-not (cl-find 'undef (plist-get unit :symbols) :key (lambda (s) (plist-get s :section))))
      (should (eq (plist-get (gethash "shared" (plist-get result :symtab)) :bind) 'global))
      (should (= (plist-get (gethash "shared" (plist-get result :symtab)) :value) 8192)))))

(ert-deftest nelisp-link-aot/writer-entries ()
  (dolist (format '(elf coff))
    (let* ((raw (nelisp-link-aot-test--compile '(defun entry () 42) 'x86_64 format))
           (unit (nelisp-link-unit-from-aot "a" raw))
           (file (make-temp-file "nelisp-aot-link-")))
      (unwind-protect
          (progn
            (if (eq format 'elf)
                (nelisp-link-units file (list unit) "entry")
              (nelisp-link-units-pe32 file (list unit) "entry"))
            (should (> (file-attribute-size (file-attributes file)) 100)))
        (delete-file file)))))

(ert-deftest nelisp-link-aot/local-collision-rejected ()
  (let* ((raw (nelisp-link-aot-test--compile
               '(progn (data-blob blob (11) rodata) (defun probe () (data-addr blob)))))
         (collision (list :name "__nelisp_local_1_a_4_blob" :value 0 :section 'text :bind 'global)))
    (plist-put raw :symbols (cons collision (plist-get raw :symbols)))
    (should-error (nelisp-link-unit-from-aot "a" raw) :type 'nelisp-link-error)))

(ert-deftest nelisp-link-aot/addend-metadata ()
  (let ((raw (nelisp-link-aot-test--compile '(defun probe () (data-addr ext)))))
    (dolist (type '(pc32 plt32))
      (dolist (addend '(-4 0 7 -12))
        (let* ((rel (list :type type :sym "ext" :offset 0 :addend addend
                          :section 'data :extra '(keep this)))
               (_ (plist-put raw :relocs (list rel)))
               (out (car (plist-get (nelisp-link-unit-from-aot "a" raw) :relocs))))
          (should (= (plist-get out :addend) (+ addend 4)))
          (should (eq (plist-get out :section) 'data))
          (should (equal (plist-get out :extra) '(keep this))))))
    (plist-put raw :relocs '((:type b26-pc :sym "ext" :offset 0 :addend -4 :section text)))
    (should (equal (plist-get raw :relocs)
                   (plist-get (nelisp-link-unit-from-aot "a" raw) :relocs)))))

(ert-deftest nelisp-link-aot/returned-ownership ()
  (let* ((raw (nelisp-link-aot-test--compile
               '(progn (data-blob msg (1 2 3) data) (defun probe () (data-addr msg)))))
         (first (nelisp-link-unit-from-aot "a" raw))
         (second (nelisp-link-unit-from-aot "a" raw))
         (text (cdr (assq 'text (plist-get first :sections))))
         (data (cdr (assq 'data (plist-get first :sections))))
         (name (plist-get (car (plist-get first :symbols)) :name)))
    (should (equal first second))
    (aset text 0 (logxor 1 (aref text 0)))
    (aset data 0 (logxor 1 (aref data 0)))
    (aset name 0 (if (= (aref name 0) ?x) ?y ?x))
    (should (equal second (nelisp-link-unit-from-aot "a" raw)))
    (should-not (equal first second))))

(ert-deftest nelisp-link-aot/private-name-collisions ()
  (let* ((raw (nelisp-link-aot-test--compile
               '(progn (data-blob blob (11) rodata) (defun probe () (data-addr blob)))))
         (unit (nelisp-link-unit-from-aot "a" raw))
         (qualified "__nelisp_local_1_a_4_blob")
         (layout '((text . 4096) (rodata . 8192) (data . 12288) (bss . 16384))))
    (dolist (bind '(weak global local))
      (let ((other (nelisp-link-unit-make "b" '((rodata . [2]))
                     (list (list :name qualified :value 0 :section 'rodata :bind bind)) nil)))
        (should-error (nelisp-link-units-2pass (list unit other) layout) :type 'nelisp-link-error)))
    (let ((other (nelisp-link-unit-make "b" '((text . [0 0 0 0 0 0 0 0])) nil
                   (list (list :offset 0 :type 'abs64 :symbol qualified)))))
      (should-error (nelisp-link-units-2pass (list unit other) layout) :type 'nelisp-link-error))
    (let ((other (nelisp-link-unit-make "b" nil (list (list :name qualified :section 'undef)) nil)))
      (should-error (nelisp-link-units-2pass (list unit other) layout) :type 'nelisp-link-error))
    (should-error (nelisp-link-units-2pass (list unit unit) layout) :type 'nelisp-link-error)
    (let ((other (nelisp-link-unit-make "a" nil nil nil)))
      (should-error (nelisp-link-units-2pass (list unit other) layout) :type 'nelisp-link-error))
    (plist-put raw :relocs (cons (list :offset 0 :type 'abs64 :symbol qualified)
                                (plist-get raw :relocs)))
    (should-error (nelisp-link-unit-from-aot "a" raw) :type 'nelisp-link-error)))

;;; nelisp-static-linker-aot-test.el ends here

(ert-deftest nelisp-link-aot/copy-value-long-list-default-depth ()
  "Copying a long list must not recurse along its spine."
  (let* ((max-lisp-eval-depth 1600)
         (n 300000)
         (list (cl-loop for i below n collect (format "s%d" i)))
         (copy (nelisp-link--copy-aot-value list)))
    (should (equal copy list))
    (should-not (eq (car copy) (car list)))
    ;; dotted tails, nested lists and vectors are preserved
    (should (equal (nelisp-link--copy-aot-value '(1 (2 . 3) [4 (5)] . 6))
                   '(1 (2 . 3) [4 (5)] . 6)))
    (should (null (nelisp-link--copy-aot-value nil)))))

(ert-deftest nelisp-link-aot/large-unit-default-depth ()
  "A unit with a very long reloc list converts at the default eval depth."
  (let* ((max-lisp-eval-depth 1600)
         (raw (nelisp-link-aot-test--compile '(defun probe () (data-addr ext))))
         (rel (car (plist-get raw :relocs)))
         (big (cl-loop repeat 200000 collect (copy-sequence rel)))
         (raw2 (plist-put (copy-sequence raw) :relocs big))
         (unit (nelisp-link-unit-from-aot "big" raw2)))
    (should (= (length (plist-get unit :relocs)) 200000))
    (should (= (length (plist-get raw2 :relocs)) 200000))))
