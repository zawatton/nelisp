;;; nelisp-aot-private-let-test.el --- Region-private lexical lifetimes -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-private-let-test--imm (n) (nelisp-aot-compiler--make-ir 'imm :value n))
(defun nelisp-aot-private-let-test--ref (n) (nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp))
(defun nelisp-aot-private-let-test--bind (slot value body)
  (nelisp-aot-compiler--make-ir 'let-rt :slot slot :value-ir value :body body))
(defun nelisp-aot-private-let-test--seq (&rest forms)
  (nelisp-aot-compiler--make-ir 'value-seq :forms forms))
(ert-deftest nelisp-aot-private-let/closed-lexical-lifetimes ()
  (let* ((make #'nelisp-aot-private-let-test--imm)
         (ref #'nelisp-aot-private-let-test--ref)
         (bind #'nelisp-aot-private-let-test--bind)
         (inner (funcall bind 2 (funcall ref 1) (funcall ref 2)))
         (outer (funcall bind 1 (funcall ref 0) inner))
         (owners (nelisp-aot-compiler--x86-private-let-owners outer 1))
         (nelisp-aot-compiler--x86-region-private-let-owners owners))
    (should (equal '(1 2) (sort (mapcar #'car owners) #'<)))
    (should (equal '(2) (nelisp-aot-compiler--x86-region-private-let-slots inner '((1 . r8) (2 . r9)))))
    (should-not (nelisp-aot-compiler--x86-region-private-let-slots
                 (nelisp-aot-compiler--ir-get inner :body) '((2 . r9))))
    ;; Parallel initializers read the old scope, including textual shadows.
    (let* ((parallel (nelisp-aot-compiler--make-ir 'let-rt-n
                      :bindings (list (list 'x 1 (funcall ref 0) nil)
                                      (list 'y 2 (funcall ref 0) nil))
                      :body (nelisp-aot-private-let-test--seq (funcall ref 1) (funcall ref 2)))))
      (should (= 2 (length (nelisp-aot-compiler--x86-private-let-owners parallel 1))))
      (let* ((bindings (copy-tree (nelisp-aot-compiler--ir-get parallel :bindings)))
             (_ (setf (nth 2 (nth 1 bindings)) (funcall ref 1)))
             (bad (nelisp-aot-compiler--ir-with parallel :bindings bindings)))
        (should-not (assq 1 (nelisp-aot-compiler--x86-private-let-owners bad 1)))))
    (let ((shared (funcall ref 1)))
      (should-not (nelisp-aot-compiler--x86-private-let-owners
                   (nelisp-aot-private-let-test--seq
                    (funcall bind 1 (funcall make 0) shared) shared) 1)))
    (should-not (nelisp-aot-compiler--x86-private-let-owners
                 (nelisp-aot-private-let-test--seq
                  (nelisp-aot-compiler--ir-with (funcall ref 0) :root-p t) outer) 1))
    (dolist (bad
             (list
              ;; Self-reference in the initializer is outside binder lifetime.
              (funcall bind 1 (funcall ref 1) (funcall ref 1))
              ;; Uses/assignments after scope cannot lose their boundary store.
              (nelisp-aot-private-let-test--seq outer (funcall ref 1))
              (nelisp-aot-private-let-test--seq outer
               (nelisp-aot-compiler--make-ir 'setq-local :slot 1 :value-ir (funcall make 3)))
              ;; Same physical slot has no unique owner, even under shadows.
              (funcall bind 1 (funcall make 0) (funcall bind 1 (funcall make 1) (funcall ref 1)))
              (funcall bind 0 (funcall make 0) (funcall ref 0))
              (nelisp-aot-compiler--make-ir 'let-rt-n
               :bindings (list (list 'x 1 (funcall make 0) nil) (list 'y 1 (funcall make 1) nil))
               :body (funcall ref 1))
              (nelisp-aot-compiler--make-ir 'let-rt-n
               :bindings (list (list 'x 1 (funcall make 0) t)) :body (funcall ref 1))
              ;; Reused IR identity can escape its apparent tree lifetime.
              (nelisp-aot-private-let-test--seq outer outer)
              (funcall bind 1 (funcall make 0)
                       (nelisp-aot-compiler--ir-with (funcall ref 1) :root-p t))))
      (should-not (assq 1 (nelisp-aot-compiler--x86-private-let-owners bad 1))))))
(defvar nelisp-aot-private-let-test--selections nil)
(defun nelisp-aot-private-let-test--record (fn node buf emit &optional plan private)
  (when private (push (copy-sequence private) nelisp-aot-private-let-test--selections))
  (if private (funcall fn node buf emit plan private) (funcall fn node buf emit plan)))
(defun nelisp-aot-private-let-test--target ()
  '(defun target (a b n out)
     (extern-call keep 0)
     (let ((x (+ a b)) (count n))
       (setq out (+ x x x x x x))
       (while (> count 0)
         (let ((x (+ x count)) (y (+ b count)))
           (setq out (+ out x x x y y y))
           (setq a (+ a x)))
         (setq count (- count 1)))
       (if (> b 0)
           (let ((y (+ out b))) (setq b (+ y y y y)))
         (let ((z (- out b))) (setq b (+ z z z z)))))
     (extern-call keep 0)
     (+ a b out)))
(defun nelisp-aot-private-let-test--lexical ()
  '(defun lexical (a b n ignored)
     (let ((out (+ a b)))
       (extern-call keep 0)
       (let ((tmp (+ out n)))
         (let ((alias tmp)) (setq out (+ alias alias alias tmp tmp tmp)))
         (setq b (+ out b)))
       (extern-call keep 0)
       (+ out b a))))
(defun nelisp-aot-private-let-test--golden (v)
  (let ((a (nth 0 v)) (b (nth 1 v)) (count (nth 2 v)) (out (nth 3 v)))
    (let ((x (+ a b)))
      (setq out (* 6 x))
      (while (> count 0)
        (let ((x (+ x count)) (y (+ b count)))
          (setq out (+ out (* 3 x) (* 3 y)) a (+ a x)))
        (setq count (1- count)))
      (setq b (* 4 (if (> b 0) (+ out b) (- out b)))))
    (logand (+ a b out) (1- (ash 1 64)))))
(ert-deftest nelisp-aot-private-let/native-fullword-external-flush-and-callee-saves ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "private-let-abi-" t))
         (c (expand-file-name "caller.c" dir)) (obj (expand-file-name "caller.o" dir))
         (target (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (nelisp-aot-private-let-test--selections nil)
         (values '((3 5) (-3 -5) (1099511627783 -17179869193)
                   (9223372036854775807 -9223372036854775808)
                   (-9223372036854775808 9223372036854775807)))
         (cases (cl-loop for (a b) in values append (cl-loop for n from 0 to 3 collect (list a b n 17)))))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef int64_t I;extern U target(I,I,I,I);extern U lexical(I,I,I,I);\n")
            (insert "__attribute__((noinline)) U keep(U x){__asm__ volatile(\"mov $13,%%r8;mov $17,%%r9;mov $19,%%r10;mov $23,%%r11\"::: \"rdi\",\"rsi\",\"rdx\",\"rcx\",\"r8\",\"r9\",\"r10\",\"r11\");return x;}\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (insert "U verify(U(*fn)(I,I,I,I),I *v,U expected){register U b __asm__(\"rbx\")=101;register U x12 __asm__(\"r12\")=103;register U x13 __asm__(\"r13\")=107;register U x14 __asm__(\"r14\")=109;register U x15 __asm__(\"r15\")=113;\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));U result=fn(v[0],v[1],v[2],v[3]);\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));return result!=expected||b!=101||x12!=103||x13!=107||x14!=109||x15!=113;}\nU run(void){U fail=0;\n")
            (dolist (v cases)
              (insert (format "{I v[]={%s};fail|=verify(target,v,UINT64_C(%d));fail|=verify(lexical,v,UINT64_C(%d));}\n"
                              (mapconcat (lambda(x)(format "(I)UINT64_C(%d)" (logand x (1- (ash 1 64))))) v ",")
                              (nelisp-aot-private-let-test--golden v)
                              (logand (+ (* 12 (+ (nth 0 v) (nth 1 v) (nth 2 v))) (nth 0 v) (nth 1 v)) (1- (ash 1 64))))))
            (insert "return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--emit-promoted-loop-x86 :around #'nelisp-aot-private-let-test--record)
          (nelisp-aot-compile-to-object `(seq ,(nelisp-aot-private-let-test--target) ,(nelisp-aot-private-let-test--lexical)) target)
          (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
          (should (= 0 (call-process bin nil nil nil)))
          (should nelisp-aot-private-let-test--selections)
          (message "Private lets:40 GNU fullword cases, external parameter/lexical mutations across calls, branch/loop/parallel shadows/aliases, C callee saves"))
      (advice-remove 'nelisp-aot-compiler--emit-promoted-loop-x86 #'nelisp-aot-private-let-test--record)
      (delete-directory dir t))))
(ert-deftest nelisp-aot-private-let/frame-observer-and-WORD-control ()
  (let ((nelisp-aot-private-let-test--selections nil)
        (out (make-temp-file "private-let-frame-")))
    (unwind-protect
        (progn
          (advice-add 'nelisp-aot-compiler--emit-promoted-loop-x86 :around #'nelisp-aot-private-let-test--record)
          (nelisp-aot-compile-sexp
           '(seq (defun keep (x) x)
             (defun q (a)
               (keep 0)
               (if (< a 0) (addr-of keep) 0)
               (let ((x (+ a 1))) (+ x x x x x x))
               (keep 0) a)
             (exit (- (q 17) 17))) out)
          (should (= 0 (call-process out nil nil nil)))
          (should-not nelisp-aot-private-let-test--selections)
          ;; Header reads stay behind the cons/vector WORD guards.
          (nelisp-aot-compile-sexp
           '(seq (defun keep (x) x)
             (defun q (w)
               (keep 0)
               (let ((k (if (= (logand w 7) 2) 7
                          (if (= (logand w 7) 6) (logand (ptr-read-u8 w -6) 63) 0))))
                 (+ k k k k k k)))
             (defun run ()
               (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                 (ptr-write-u8 p 0 141)
                 (- (+ (q 2) (q 3) (q (+ p 6))) 120)))
             (exit (run))) out)
          (should (= 0 (call-process out nil nil nil))))
      (advice-remove 'nelisp-aot-compiler--emit-promoted-loop-x86 #'nelisp-aot-private-let-test--record)
      (delete-file out))))
(provide 'nelisp-aot-private-let-test)
