;;; par-fx-live-capture.el --- Read a capture after a nested mutation -*- lexical-binding: t; -*-

(defun par-fx-live-capture-make ()
  (let ((shared 10))
    (cons (lambda (callback value)
            (let ((before shared))
              (funcall callback value)
              (list before shared)))
          (lambda (value) (setq shared value)))))

(defvar par-fx-live-capture-fns (par-fx-live-capture-make))

(defun par-fx-live-capture--map-step ()
  (let ((shared 10) setter)
    (setq setter (lambda (value) (setq shared value)))
    (lambda (value)
      (let ((before shared))
        (funcall setter value)
        (list before shared)))))

(defun par-fx-live-capture--variable-arity ()
  (let ((bias 10))
    (list (lambda (value &optional extra) (list (+ bias value) extra))
          (lambda (value &optional extra &rest tail)
            (list (+ bias value) extra tail))
          (lambda (&rest tail) (cons bias tail)))))

(defun par-fx-live-capture--arity-row ()
  (let* ((fns (par-fx-live-capture--variable-arity))
         (optional (nth 0 fns)) (rest (nth 1 fns)) (rest-only (nth 2 fns))
         (spread (list 'extra 'a 'b)) result)
    (dotimes (i 80)
      (setq result (list (funcall optional i) (apply optional i '(extra))
                         (funcall rest i) (apply rest i spread) (funcall rest-only))))
    (let ((rest-values (apply rest 1 spread)))
      (setcar (nth 2 rest-values) 'changed)
      (prin1 (list result
                   (mapcar optional '(1 2)) (mapcar rest '(1 2)) (mapcar rest-only '(1 2))
                   rest-values spread
                   (condition-case err (funcall optional) (error (car err)))
                   (condition-case err (funcall optional 1 2 3) (error (car err)))))
      (terpri))))

(defun par-fx-live-capture-run ()
  (let ((step (car par-fx-live-capture-fns))
        (set-value (cdr par-fx-live-capture-fns))
        (i 0) result)
    (while (< i 150)
      (setq result (funcall step set-value i)
            i (1+ i)))
    (prin1 (list result (funcall step set-value 'after)))
    (terpri))
  (let* ((step (par-fx-live-capture--map-step))
         (inputs (number-sequence 1 150))
         (results (mapcar step inputs)))
    (prin1 (list (car results) (nth 64 results) (car (last results))
                 (mapcar step '(next last))))
    (terpri))
  (par-fx-live-capture--arity-row))
