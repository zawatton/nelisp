;;; standalone-abi-load-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(defvar abi-load-special)
(defvar abi-load-after-error)
(defvar abi-load-before-syntax)
(let ((checked 0) (root (expand-file-name "test/fixtures/abi-word-load/"))
      (load-file-name "caller-file") (abi-load-special 'dynamic-value)
      (abi-load-after-error nil) (abi-load-before-syntax nil))
  (unless (eq (load (concat root "outer.el") nil t) t)
    (error "load result must be t, not final form"))
  (setq checked (+ checked 1))
  (dolist (pair (list (cons abi-load-outer-before (concat root "outer.el"))
                     (cons abi-load-outer-after (concat root "outer.el"))
                     (cons abi-load-inner-name (concat root "inner.el"))
                     (cons load-file-name "caller-file")))
    (unless (equal (car pair) (cdr pair)) (error "nested load-file-name changed: %S" pair))
    (setq checked (+ checked 1)))
  (unless (eq abi-load-inner-special 'dynamic-value) (error "dynamic load scope lost"))
  (setq checked (+ checked 1))
  (unless (eq (load (concat root "empty.el") nil t) t) (error "empty load changed"))
  (setq checked (+ checked 1))
  (unless (null (load (concat root "does-not-exist.el") t t)) (error "load noerror changed"))
  (setq checked (+ checked 1))
  (unless (eq (condition-case e (load (concat root "does-not-exist.el") nil t)
                (error (car e))) 'file-missing)
    (error "load missing condition changed"))
  (setq checked (+ checked 1))
  (unless (eq (condition-case e (load (concat root "error.el") nil t)
                (error (car e))) 'arith-error)
    (error "load original error changed"))
  (setq checked (+ checked 1))
  (unless (null abi-load-after-error) (error "load continued after error"))
  (setq checked (+ checked 1))
  (unless (equal load-file-name "caller-file") (error "load error name restore lost"))
  (setq checked (+ checked 1))
  (unless (eq (require 'abi-load-outer) 'abi-load-outer) (error "already provided changed"))
  (setq checked (+ checked 1))
  (unless (null (require 'abi-load-absent (concat root "does-not-exist.el") t))
    (error "require noerror missing changed"))
  (setq checked (+ checked 1))
  (unless (null (require 'abi-load-not-provided (concat root "missing-provide.el") t))
    (error "require noerror no provide changed"))
  (setq checked (+ checked 1))
  (unless (= abi-load-no-provide 23) (error "require failed to run no-provide file"))
  (setq checked (+ checked 1))
  (unless (eq (condition-case e (load (concat root "bad.data") nil t)
                (error (car e))) 'invalid-read-syntax)
    (error "load syntax condition changed"))
  (setq checked (+ checked 1))
  (unless abi-load-before-syntax (error "load syntax skipped earlier form"))
  (setq checked (+ checked 1))
  (princ (format "ABI-LOAD-WORD checked=%d PASS\n" checked)))
