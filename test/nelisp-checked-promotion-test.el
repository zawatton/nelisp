;;; nelisp-checked-promotion-test.el --- Unused constructor models -*- lexical-binding: t; -*-
;; Guarded so that a `require' from another test plus the Makefile `-l' define
;; the tests only once.
(unless (featurep 'nelisp-checked-promotion-test)
(require 'ert)
(require 'cl-lib)
(defconst cp--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun cp--form (name)
  (let (found)
    (dolist (path '("scripts/nelisp-standalone-build.el" "lisp/nelisp-cc-nlstr-direct-ops.el"))
      (with-temp-buffer
        (insert-file-contents (expand-file-name path cp--root)) (goto-char 1)
        (condition-case nil
            (while t
              (let ((todo (list (read (current-buffer)))))
                (while todo
                  (let ((x (pop todo)))
                    (when (consp x)
                      (if (eq (car x) 'defun)
                          (when (eq (cadr x) name) (push x found))
                        (push (car x) todo) (push (cdr x) todo)))))))
          (end-of-file nil))))
    (unless (= (length found) 1) (error "Provider uniqueness %s" name)) (car found)))
(defun cp--lower (form)
  "Lower executable while only, preserving identifiers and literal data."
  (if (not (consp form)) form
    (pcase (car form)
      ('cp--raw-while (error "Private loop head in source"))
      ((or 'quote 'function 'data-addr) form)
      ('defun `(defun ,(cadr form) ,(nth 2 form) ,@(mapcar #'cp--lower (cdddr form))))
      ((or 'let 'let*)
       `(,(car form) ,(mapcar (lambda (b) (if (symbolp b) b
                                          (unless (and (proper-list-p b) (<= 1 (length b) 2) (symbolp (car b)))
                                            (error "Unsupported binding"))
                                          (cons (car b) (mapcar #'cp--lower (cdr b)))))
                             (cadr form)) ,@(mapcar #'cp--lower (cddr form))))
      ('setq (unless (and (proper-list-p form) (= (mod (length (cdr form)) 2) 0)) (error "Unsupported setq"))
             (cons 'setq (cl-loop for (key value) on (cdr form) by #'cddr
                                 do (unless (symbolp key) (error "Unsupported setq target"))
                                 append (list key (cp--lower value)))))
      ('extern-call (cons 'extern-call (cons (cadr form) (mapcar #'cp--lower (cddr form)))))
      (_ (cons (if (eq (car form) 'while) 'cp--raw-while (car form))
               (mapcar #'cp--lower (cdr form)))))))
(defun cp--fn (form)
  (setq form (cp--lower form))
  (eval `(lambda ,(nth 2 form)
           (cl-macrolet
               ((seq (&rest xs) (cons 'progn xs))
                (if (test yes &rest no) `(cond ((let ((v ,test)) (and v (not (eq v 0)))) ,yes) (t ,@no)))
                (or (&rest xs) (if (null xs) 0 `(let ((v ,(car xs))) (cond ((and v (not (eq v 0))) 1) (t (or ,@(cdr xs)))))))
                (cp--raw-while (test &rest body) `(while (let ((v ,test)) (and v (not (eq v 0)))) ,@body)))
             ,@(cdddr form))) t))
(defun cp--lowering-check ()
  "Finite expansion/data/RAW controls before the production-body gate."
  (let ((literal '(defun sample (while) (let ((while '(while 0)))
                    (setq while '(while 1)) (function while) (data-addr while)
                    (extern-call while while)))))
    (should (equal (cp--lower literal) literal)))
  (let ((fn (cp--fn '(defun count (x) (let ((n 0))
                     (while (if (< n 1) x 0) (setq n (+ n 1))) n)))))
    (should (= (funcall fn 0) 0)) (should (= (funcall fn 1) 1)))
  (should (= (funcall (cp--fn '(defun compare () (let ((n 0)) (while (< n 3) (setq n (+ n 1))) n)))) 3))
  (should (= (funcall (cp--fn '(defun effects () (let ((n 0) (checks 0))
                    (while (seq (setq checks (+ checks 1)) (< n 2)) (setq n (+ n 1))) checks)))) 3))
  ;; Harmful Host-truth guard is safely bounded independently; it wrongly
  ;; enters RAW0 once. No unbounded wrong-loop execution is attempted.
  (let ((n 0) (raw 0))
    (while (and (< n 1) raw) (cl-incf n))
    (should (= n 1)) (should-not (= n 0)))
  (princ "LOWERING controls PASS: literal preservation; RAW0=0 RAW1=1 comparison=3 wrong-guard=1\n"))
(defun cp--run (mode &optional mutant)
  "Execute genuine ownership flow with explicit source-checked boundary leaves."
  (let ((mem (make-hash-table :test #'eql)) (top 6064) (requests 0) (allocs 0)
        (exhausted 0) (clones 0) (releases nil) (next 10000) installed result)
    (cl-labels ((rd (p o) (gethash (+ p o) mem 0))
                (wr (p o v) (puthash (+ p o) v mem) v)
                (snap () (sort (cl-loop for k being the hash-keys of mem using (hash-values v) collect (cons k v))
                               (lambda (a b) (< (car a) (car b))))))
      ;; Complete synthetic registered-source record. Forwarding/backing sentinels
      ;; are outside constructor ownership and must remain byte-logically intact.
      (wr 1000 0 1036) (wr 1000 8 (if (eq mode 'canonical) 9006 2000))
      (dotimes (i 4) (wr 1000 (+ 16 (* i 8)) (+ 5 (* i 4))))
      (wr 1000 48 777) (wr 4000 0 1006)
      (wr 2000 0 4) (wr 2000 16 1234) (wr 2000 24 3)
      (wr 3000 80 (if (memq mode '(cached relocate)) 8000 0))
      (dotimes (i 4) (wr 8000 (* i 8) (rd 2000 (* i 8))))
      (wr 6032 0 3) (wr 6032 8 3)
      (when (eq mode 'pending) (wr 268435472 0 2) (wr 268435544 0 17) (wr 70000 0 99))
      (let ((before (snap)) (roots (if (eq mode 'workspace-fail) 0 6032)))
        (cl-letf (((symbol-function 'heap-read-u64) #'rd)
                  ((symbol-function 'heap-read-u8) (lambda (p o) (logand (rd p o) 255)))
                  ((symbol-function 'ptr-write-u64) #'wr)
                  ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
                  ((symbol-function 'nl_val_tag) (lambda (w) (rd w 0)))
                  ((symbol-function 'nl_symbol_name_entry_for)
                   (lambda (kind key len) (should (equal (list kind key len) '(1 1234 3))) 3000))
                  ((symbol-function 'nl_root_mark) (lambda (env) (should (= env 0)) top))
                  ((symbol-function 'nl_root_reserve_checked)
                   (lambda (env) (should (= env 0)) (cl-incf requests)
                     (if (or (and (eq mode 'first-refusal) (= requests 1))
                             (and (eq mode 'second-refusal) (= requests 2))) 0
                       (prog1 top (cl-incf top 32)))))
                  ((symbol-function 'nl_root_release)
                   (lambda (env mark) (should (= env 0)) (push mark releases) (setq top mark) 0))
                  ((symbol-function 'nl_symname_copy32)
                   (lambda (src dst offset) (should (= offset 0))
                     (dotimes (i 4) (wr dst (* i 8) (rd src (* i 8)))) dst))
                  ((symbol-function 'nl_symbol_name_value)
                   (lambda (env symbol out) (should (= env 0)) (should (= (rd symbol 0) 4))
                     (if (eq mode 'name-pending)
                         (progn (wr 268435472 0 1) (wr 268435544 0 1) (wr 70000 0 88) 0)
                       (wr out 0 5) 1)))
                  ((symbol-function 'alloc-bytes)
                   (lambda (n alignment) (cl-incf allocs) (should (= alignment 8))
                     (let ((p next)) (cl-incf next 128)
                       (when (= n 48)
                         ;; Only the declared discrete type relocation boundary.
                         (when (eq mode 'relocate) (wr 6032 0 8128))) p)))
                  ((symbol-function 'nl_val_clone_into)
                   (lambda (source destination) (should (= destination 6032))
                     (cl-incf clones) (wr destination 0 source)
                     (when (eq mode 'clone-pending) (wr 268435472 0 1))))
                  ((symbol-function 'wf_bytecode_root_exhausted)
                   (lambda () (cl-incf exhausted) (wr 268435472 0 1) (wr 268435544 0 1) 0)))
          (unwind-protect
              (progn
                (dolist (pair '((nl_record_type_own . 1) (nl_record_type_intern_own . 1)
                                (nl_record_type_own_env . 2) (nl_record_type_intern_own_env . 2)
                                (nl_record_type_word . 1) (nl_record_slot_word . 2) (nl_word_payload . 1)
                                (nl_frame_stack_promote_checked_new . 3)))
                  (let ((form (cp--form (car pair))))
                    (should (= (length (nth 2 form)) (cdr pair)))
                    (when (and mutant (eq (car pair) 'nl_frame_stack_promote_checked_new))
                      (pcase mutant
                        ('stale (setq form (cl-subst 'type '(heap-read-u64 roots 0) form :test #'equal)))
                        ('ignore-zero (setq form (cl-subst 0 '(= type 0) form :test #'equal)))
                        ('ignore-pending (setq form (cl-subst 0 '(/= (heap-read-u64 268435472 0) 0) form :test #'equal)))
                        ('publish (setq form (cl-subst
                          '(seq (ptr-write-u64 (- frame 6) 48 (+ rec 6)) (ptr-write-u64 roots 8 (+ rec 6)))
                          '(ptr-write-u64 roots 8 (+ rec 6)) form :test #'equal)))))
                    (push (cons (car pair) (and (fboundp (car pair)) (symbol-function (car pair)))) installed)
                    (fset (car pair) (cp--fn form))))
                (setq result (nl_frame_stack_promote_checked_new 0 1006 roots)))
            (dolist (pair installed) (if (cdr pair) (fset (car pair) (cdr pair)) (fmakunbound (car pair))))))
        (let* ((base (and result (/= result 0) (- result 6)))
               (answer (list :result result :requests requests :allocs allocs :clones clones
                             :pending (rd 268435472 0) :epoch (rd 268435544 0) :payload (rd 70000 0)
                             :exhausted exhausted :type (and base (rd base 8))
                             :slots (and base (cl-loop for i below 4 collect (rd base (+ 16 (* i 8)))))
                             :forward (rd 1000 48) :backing (rd 4000 0) :top top :releases releases
                             :before before :after (snap))))
          ;; Caller owns/releases the workspace after consuming the result.
          (setq top 6000) (plist-put answer :caller-restored (= top 6000)))))))
(ert-deftest checked-promotion-genuine-owning-control-flow ()
  (dolist (mode '(cached cold canonical relocate))
    (let ((row (cp--run mode)))
      (should (/= (plist-get row :result) 0)) (should (= (plist-get row :pending) 0))
      (should (equal (plist-get row :slots) '(5 9 13 17)))
      (should (= (plist-get row :requests) (if (eq mode 'cold) 2 0)))
      (should (= (plist-get row :top) 6064)) (should (plist-get row :caller-restored))
      (should (= (plist-get row :forward) 777)) (should (= (plist-get row :backing) 1006))
      (when (eq mode 'relocate) (should (= (plist-get row :type) 8128)))))
  (dolist (mode '(first-refusal second-refusal name-pending workspace-fail pending clone-pending))
    (let ((row (cp--run mode)))
      (should (= (plist-get row :result) 0))
      (should (= (plist-get row :clones) (if (eq mode 'clone-pending) 1 0)))
      (should (= (plist-get row :forward) 777)) (should (= (plist-get row :backing) 1006))
      (should (= (plist-get row :top) 6064)) (should (plist-get row :caller-restored))
      (when (memq mode '(first-refusal second-refusal)) (should (= (plist-get row :requests) 2)))
      (when (eq mode 'name-pending) (should (= (plist-get row :payload) 88)) (should (= (plist-get row :exhausted) 0)))
      (when (eq mode 'pending) (should (= (plist-get row :epoch) 17)) (should (= (plist-get row :payload) 99))))))
(ert-deftest checked-promotion-specific-harmful-mutations ()
  (let ((row (cp--run 'relocate 'stale)))
    (should (= (plist-get row :type) 8000)) (should-not (= (plist-get row :type) 8128)))
  (let ((row (cp--run 'first-refusal 'ignore-zero)))
    (should (/= (plist-get row :result) 0)) (should (= (plist-get row :type) 0)))
  (let ((row (cp--run 'pending 'ignore-pending)))
    (should (/= (plist-get row :result) 0)) (should (> (plist-get row :allocs) 0)))
  (let ((row (cp--run 'clone-pending 'publish)))
    (should (= (plist-get row :result) 0)) (should (/= (plist-get row :forward) 777))))
(provide 'nelisp-checked-promotion-test)
)
