;;; nelisp-standalone-extern-inline-test.el --- Same-unit GP calls -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)

(defun nelisp-extern-inline-test--expand (source &optional disabled)
  (let ((process-environment (copy-sequence process-environment))
        (nelisp-standalone--inline-resolved-extern-enabled (not disabled))
        (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
        (nelisp-aot-compiler--checked-arith nil)
        (nelisp-aot-compiler--runtime-entry-params nil)
        (nelisp-aot-compiler--lisp-internal-entry-names nil)
        (nelisp-aot-compiler--object-hidden-boundary-symbols nil))
    (setenv "NELISP_INLINE" "2")
    (nelisp-standalone--inline-unit-source source)))

(defun nelisp-extern-inline-test--owner (source)
  (cl-find 'rx_owner (cdr source) :key #'cadr))

(defun nelisp-extern-inline-test--calls (form name)
  (let ((n 0))
    (cl-labels ((walk (x)
                 (when (consp x)
                   (when (or (eq (car x) name)
                             (and (eq (car x) 'extern-call)
                                  (eq (if (consp (cadr x)) (caadr x) (cadr x)) name)))
                     (cl-incf n))
                   (unless (eq (car x) 'data-addr)
                     (mapc #'walk (if (eq (car x) 'extern-call) (cddr x) x))))))
      (walk form)) n))

(defun nelisp-extern-inline-test--retains (source name)
  (nelisp-extern-inline-test--calls
   (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand source)) name))

(ert-deftest nelisp-extern-inline/two-pass-generic-capture-and-closure ()
  (let* ((s '(seq (defun leaf (x) (let* ((y x)) (logxor y 16)))
                 (defun relay (x) (extern-call leaf x))
                 (defun rx_owner (x) (relay x))))
         (on (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand s)))
         (off (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand s t))))
    (should (= 0 (nelisp-extern-inline-test--calls on 'leaf)))
    (should (= 0 (nelisp-extern-inline-test--calls on 'relay)))
    (should (= 1 (nelisp-extern-inline-test--calls off 'relay)))
    (should (= (eval `(let ((x 123)) ,(nth 3 on)) t) (logxor 123 16)))))

(ert-deftest nelisp-extern-inline/scoped-freshening-and-call-namespace ()
  (let* ((s '(seq (defun identity (x) x)
                 (defun callee (identity y)
                   (let ((a identity) (b y))
                     (let* ((identity b) (a (logxor a b)))
                       (seq (setq a (logxor a 7))
                            (logxor a (extern-call identity identity))))))
                 (defun rx_owner (x)
                   (let* ((a 11) (b 3)) (seq (extern-call callee x a) b)))))
         (on (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand s))))
    ;; A first binder initializer is still outside the existing expansion walk.
    (should (= 0 (nelisp-extern-inline-test--calls on 'callee)))
    (should (= (eval (cl-subst 'progn 'seq `(let ((x 19)) ,(nth 3 on))) t) 3))))

(ert-deftest nelisp-extern-inline/unsupported-signatures-and-actuals ()
  (dolist (call '((extern-call leaf (:i64 x)) (extern-call leaf x x)
                  (extern-call (leaf :f64) x) (extern-call leaf (seq (setq x 3) x))))
    (should (= 1 (nelisp-extern-inline-test--retains
                  `(seq (defun leaf (x) x) (defun rx_owner (x) ,call)) 'leaf))))
  (dolist (extra '((defun leaf (x) x) (defun leaf (&rest x) 0)))
    (should (= 1 (nelisp-extern-inline-test--retains
                  `(seq (defun leaf (x) x) ,extra (defun rx_owner (x) (extern-call leaf x))) 'leaf))))
  (should (= 1 (nelisp-extern-inline-test--retains
                '(seq (defun leaf ((x f64)) x) (defun rx_owner (x) (extern-call leaf x))) 'leaf)))
  (should (= 1 (nelisp-extern-inline-test--retains
                '(seq (defun rx_owner (x) (extern-call unknown x))) 'unknown))))

(ert-deftest nelisp-extern-inline/observers-capture-float-and-effects-fallback ()
  (dolist (body '((current-sp) (addr-of x) (extern-call foreign x)
                  (alloc-bytes x 8) (raw-f64-add x x) 0.5
                  (let ((y free)) y) (seq (setq x 3) x)))
    (should (= 1 (nelisp-extern-inline-test--retains
                  `(seq (defun leaf (x) ,body) (defun rx_owner (x) (extern-call leaf x))) 'leaf))))
  (should (= 1 (nelisp-extern-inline-test--retains
                '(seq (defun leaf (x) x)
                      (defun rx_owner (x) (seq (current-sp) (extern-call leaf x)))) 'leaf))))

(ert-deftest nelisp-extern-inline/whole-caller-constant-overflow-rollback ()
  (dolist (body '((+ x 1) (* x 2) (shl x 1)))
    (let* ((s `(seq (defun leaf (x) ,body)
                    (defun rx_owner () (let* ((v 9223372036854775807)) (extern-call leaf v)))))
           (on (nelisp-extern-inline-test--expand s)) (off (nelisp-extern-inline-test--expand s t)))
      (should (= 1 (nelisp-extern-inline-test--calls (nelisp-extern-inline-test--owner on) 'leaf)))
      (should (equal on off))))
  (should (= 1 (nelisp-extern-inline-test--retains
                '(seq (defun leaf (x) (+ (+ 9223372036854775807 1) x))
                      (defun rx_owner (x) (extern-call leaf x))) 'leaf)))
  (should (= 0 (nelisp-extern-inline-test--retains
                '(seq (defun leaf (x) (+ x 1))
                      (defun rx_owner (x) (extern-call leaf x))) 'leaf))))

(ert-deftest nelisp-extern-inline/original-initializer-walk-and-zero-arity ()
  (should (= 1 (nelisp-extern-inline-test--retains
                '(seq (defun leaf (x) (let* ((v x)) v))
                      (defun rx_owner (x) (let* ((first (extern-call leaf x))) first))) 'leaf)))
  (should (= 0 (nelisp-extern-inline-test--retains
                '(seq (defun leaf () 7) (defun rx_owner () (extern-call leaf))) 'leaf)))
  (let* ((s '(seq (defun leaf (x) (let ((a x)) a))
                 (defun rx_owner (x) (leaf x))))
         (nelisp-standalone--inline-parallel-let-enabled nil))
    (should (= 1 (nelisp-extern-inline-test--retains s 'leaf)))))

(ert-deftest nelisp-extern-inline/budget-and-cold-exit-closure ()
  (let* ((large `(seq ,@(make-list 81 '(logxor x 0))))
         (s `(seq (defun leaf (x) ,large) (defun rx_owner (x) (extern-call leaf x)))))
    (should (= 1 (nelisp-extern-inline-test--retains s 'leaf))))
  (let* ((s '(seq (defun cold (x) (syscall-direct 60 71 0 0 0 0 0))
                 (defun leaf (x) (if (= x 0) (extern-call cold x) x))
                 (defun rx_owner (x) (extern-call leaf x))))
         (on (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand s))))
    (should (= 0 (nelisp-extern-inline-test--calls on 'leaf)))
    (should (= 1 (nelisp-extern-inline-test--calls on 'cold)))))

(ert-deftest nelisp-extern-inline/expression-sites-preserve-binder-and-data-syntax ()
  (let* ((source '(seq (defun leaf (x) x)
                      (defun relay (x) (extern-call leaf x))
                      (defun rx_owner (relay extern-call)
                        (let* ((v relay) (relay extern-call) (extern-call relay))
                          (logxor relay extern-call)))))
         (on (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand source)))
         (off (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand source t))))
    (should (equal on off))
    (should (= 0 (eval `(let ((relay 13) (extern-call 7)) ,(nth 3 on)) t))))
  (dolist (body '((quote ((relay 1) (extern-call leaf 2))) (data-addr relay)))
    (let ((source `(seq (defun leaf (x) x) (defun relay (x) (extern-call leaf x))
                        (defun rx_owner (relay extern-call) ,body))))
      (should (equal (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand source))
                     (nelisp-extern-inline-test--owner (nelisp-extern-inline-test--expand source t)))))))

(ert-deftest nelisp-extern-inline/native-fullword-order-WORD-ABI-and-disabled-gauge ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "extern-inline-" t))
         (c (expand-file-name "caller.c" dir)) (obj (expand-file-name "caller.o" dir))
         (target (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (disabled (getenv "NELISP_EXTERN_INLINE_TEST_DISABLE"))
         (values '((0 1 2 3 4 5) (-1 4294967296 -2 9 0 31)
                   (9223372036854775807 -9223372036854775808 1 -1 3 7)
                   (-9223372036854775808 9223372036854775807 -1 0 4 11)))
         (helper '(defun RxBody (x y z u v w)
                    (let* ((state 0) (old x) (old-u u))
                      (let ((x (logxor x y)) (y x))
                        (let* ((z (logxor y z)) (u z))
                          (seq (setq state (logxor old u))
                               (logxor old
                                 (logxor state
                                   (logxor (shl (logand x 255) 1)
                                     (logxor (shl (logand z 255) 9)
                                       (logxor (shl (logand old-u 255) 17)
                                         (logxor (shl (logand v 255) 25)
                                                 (shl (logand w 255) 33)))))))))))))
         (source `(seq ,helper
                   (defun RxOwner (a b c d e f) (extern-call RxBody a b c d e f))
                   (defun RxTag (w)
                     (if (= (logand w 7) 2) 7
                       (if (= (logand w 7) 6) (logand (ptr-read-u8 w -6) 63)
                         (if (= w 0) 0 (ptr-read-u8 w 0)))))
                   (defun RxTagOwner (w) (extern-call RxTag w))
                   (defun RxEffects (p x)
                     (seq (ptr-write-u64 p 0 x)
                          (ptr-write-u64 p 8 (logxor (ptr-read-u64 p 0) 7))
                          (ptr-read-u64 p 8)))
                   (defun RxEffectsOwner (p x) (extern-call RxEffects p x))
                   (defun RxEffectArg (p x)
                     (extern-call RxEffects p (seq (ptr-write-u64 p 16 x) x)))
                   (defun RxOpaque (x) (extern-call R_observe x))
                   (defun RxOpaqueOwner (x) (extern-call RxOpaque x))
                   (defun RxOver (x) (+ x 1))
                   (defun RxOverOwner ()
                     (let* ((v 9223372036854775807)) (extern-call RxOver v)))
                   (defun RxZero () -1)
                   (defun RxZeroOwner () (extern-call RxZero))
                   (defun RxSP (a b c d e f)
                     (seq (extern-call RxBody a b c d e f) (aot-current-sp)))
                   (defun RxSPControl (a b c d e f)
                     (seq (extern-call RxBody a b c d e f) (aot-current-sp)))))
         (expanded (nelisp-extern-inline-test--expand source disabled))
         (expected (mapcar (lambda (v)
                            (logand (eval `(progn ,(cl-subst 'ash 'shl (cl-subst 'progn 'seq helper)) (RxBody ,@v)) t)
                                    #xffffffffffffffff)) values)))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef U(*F)(U,U,U,U,U,U);\n")
            (insert "extern U RxOwner(U,U,U,U,U,U),RxSP(U,U,U,U,U,U),RxSPControl(U,U,U,U,U,U),RxTagOwner(U),RxEffectsOwner(U,U),RxEffectArg(U,U),RxOpaqueOwner(U),RxOverOwner(void),RxZeroOwner(void);\nstatic U mem[3];static U observed;\n")
            (insert "U R_observe(U x){U *f=__builtin_frame_address(1);if(f[-1]!=x) observed=1;f[-1]=x^UINT64_C(0x123456789abcdef0);return x^1;}\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (insert "U check(F f,U a,U b,U c,U d,U e,U g,U want){register U b0 __asm__(\"rbx\")=101;register U b1 __asm__(\"r12\")=103;register U b2 __asm__(\"r13\")=107;register U b3 __asm__(\"r14\")=109;register U b4 __asm__(\"r15\")=113;U s0,s1;__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s0));__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));U r=f(a,b,c,d,e,g);__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s1));return r!=want||s0!=s1||b0!=101||b1!=103||b2!=107||b3!=109||b4!=113;}\nU run(void){U fail=0;\n")
            (cl-mapc (lambda (v want)
                       (insert (format "fail|=check(RxOwner,%s,UINT64_C(%d));\n"
                                       (mapconcat (lambda (x) (format "UINT64_C(%d)" (logand x #xffffffffffffffff))) v ",") want))) values expected)
            (insert "register U r10 __asm__(\"r10\")=50;register U r8 __asm__(\"r8\")=UINT64_MAX;register U r9 __asm__(\"r9\")=0;U p;__asm__ volatile(\"syscall\":\"=a\"(p):\"a\"(9),\"D\"(UINT64_C(268435456)),\"S\"(4096),\"d\"(3),\"r\"(r10),\"r\"(r8),\"r\"(r9):\"rcx\",\"r11\",\"memory\");if(p!=UINT64_C(268435456))return 90;*(unsigned char*)p=141;*(unsigned char*)(p+64)=4;\n")
            (insert "fail|=RxTagOwner(2)!=7||RxTagOwner(p+6)!=13||RxTagOwner(p+64)!=4||RxTagOwner(0)!=0;\n")
            (insert "U x=UINT64_C(0xfedcba9876543210);fail|=RxEffectsOwner((U)mem,x)!=(x^7)||mem[0]!=x||mem[1]!=(x^7);fail|=RxEffectArg((U)mem,31)!=24||mem[2]!=31;\n")
            (insert "fail|=RxOpaqueOwner(x)!=(x^1)||observed;fail|=RxOverOwner()!=UINT64_C(9223372036854775808)||RxZeroOwner()!=UINT64_MAX;fail|=RxSP(1,2,3,4,5,6)!=RxSPControl(1,2,3,4,5,6);return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil))
            (nelisp-aot-compile-to-object expanded target))
          (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
          (should (= 0 (call-process bin nil nil nil)))
          (message "R fullword/WORD/effects/CABI/SP/returning-observer semantics PASS before admission gauge")
          (dolist (entry '((RxOwner . RxBody) (RxTagOwner . RxTag)
                           (RxEffectsOwner . RxEffects) (RxZeroOwner . RxZero)))
            (should (= 0 (nelisp-extern-inline-test--calls
                          (cl-find (car entry) (cdr expanded) :key #'cadr) (cdr entry)))))
          (dolist (entry '((RxEffectArg . RxEffects) (RxOpaqueOwner . RxOpaque)
                           (RxOverOwner . RxOver) (RxSP . RxBody)))
            (should (= 1 (nelisp-extern-inline-test--calls
                          (cl-find (car entry) (cdr expanded) :key #'cadr) (cdr entry)))))
          (message "R native GNU cases4, guarded WORD4, ordered effects2, returning frame observer1, overflow1, zeroarity1, SP1 PASS"))
      (when (getenv "NELISP_EXTERN_INLINE_TEST_KEEP")
        (message "R test retained at %s" dir))
      (unless (getenv "NELISP_EXTERN_INLINE_TEST_KEEP") (delete-directory dir t)))))

(provide 'nelisp-standalone-extern-inline-test)
