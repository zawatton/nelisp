;;; place-controls.el --- Actual symbol/generalized/key evaluation controls -*- lexical-binding: t; -*-
(let ((symbol-place nil) (rhs-count 0))
  (cl-pushnew (progn (setq rhs-count (1+ rhs-count)) 'one) symbol-place)
  (cl-pushnew (progn (setq rhs-count (1+ rhs-count)) 'one) symbol-place)
  (unless (and (equal symbol-place '(one)) (= rhs-count 2))
    (error "Symbol place/RHS multiplicity failed")))
(let ((cell (list nil)) (place-count 0) (rhs-count 0) (order nil))
  (cl-pushnew (progn (setq rhs-count (1+ rhs-count)) (push 'rhs order) 'one)
              (car (progn (setq place-count (1+ place-count))
                          (push 'place order) cell)))
  (unless (and (equal cell '((one))) (= place-count 1) (= rhs-count 1)
               (equal (nreverse order) '(rhs place)))
    (error "Generalized place/order/single evaluation failed")))
(let ((cell (list '("same"))))
  (cl-pushnew (copy-sequence "same") (car cell) :test #'equal)
  (unless (= (length (car cell)) 1) (error ":test ignored")))
(let ((cell (list '((one . old)))))
  (cl-pushnew '(one . new) (car cell) :key #'car)
  (unless (equal (car cell) '((one . old))) (error ":key ignored")))
(let ((cell (list '(one))))
  (cl-pushnew 'one (car cell) :test-not #'eq)
  (unless (equal (car cell) '(one one)) (error ":test-not ignored")))
(princ "GNU-CL-PLACE-CONTROLS-PASS\n")
