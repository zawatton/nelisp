;;; standalone-gnu-variable-alias-oracle.el --- GNU behavior oracle -*- lexical-binding: t; -*-

(defun nelisp-test-variable-alias-gnu-oracle ()
  "Run variable/function/plist alias assertions against GNU Emacs."
  (let ((nelisp-va-elc (getenv "NELISP_ALIAS_ELC")))
    (unless (and (stringp nelisp-va-elc) (file-readable-p nelisp-va-elc))
      (error "GNU alias oracle needs NELISP_ALIAS_ELC"))
    (fset 'nelisp-va-old-value (lambda () 'alias-function))
    (fset 'nelisp-va-base-value (lambda () 'base-function))
    (put 'nelisp-va-old-value 'nelisp-va-property 'alias-plist)
    (put 'nelisp-va-base-value 'nelisp-va-property 'base-plist)
    (let ((load-verbose nil) (inhibit-message t))
      (load nelisp-va-elc nil t t))
    (princ "alias-oracle: elc-loaded\n")
    (unless (and (eq (funcall 'nelisp-va-old-value) 'alias-function)
                 (eq (funcall 'nelisp-va-base-value) 'base-function)
                 (eq (get 'nelisp-va-old-value 'nelisp-va-property) 'alias-plist)
                 (eq (get 'nelisp-va-base-value 'nelisp-va-property) 'base-plist))
      (error "variable alias changed independent function/plist cells"))
    (princ "alias-oracle: function-and-plist-isolation\n")
    (unless (and (eq (symbol-value 'nelisp-va-old-value) 'initial)
                 (boundp 'nelisp-va-old-value))
      (error "GNU ELC alias did not establish a bound value alias"))
    (set 'nelisp-va-old-value 'written-through)
    (unless (eq (symbol-value 'nelisp-va-base-value) 'written-through)
      (error "alias write did not reach base"))
    (defvaralias 'nelisp-va-chain-value 'nelisp-va-old-value)
    (set 'nelisp-va-chain-value 'chain-write)
    (unless (eq (symbol-value 'nelisp-va-base-value) 'chain-write)
      (error "alias chain write did not reach base"))
    (princ "alias-oracle: chain-read-write\n")
    (let ((nelisp-va-old-value 'dynamic))
      (unless (and (eq (symbol-value 'nelisp-va-base-value) 'dynamic)
                   (eq (symbol-value 'nelisp-va-chain-value) 'dynamic))
        (error "dynamic let did not follow alias chain")))
    (princ "alias-oracle: dynamic-binding\n")
    (unless (eq (funcall 'defvaralias 'nelisp-va-funcall-value
                         'nelisp-va-base-value "funcall doc")
                'nelisp-va-base-value)
      (error "funcall defvaralias returned wrong value"))
    (set 'nelisp-va-funcall-value 'funcall-write)
    (unless (eq (symbol-value 'nelisp-va-base-value) 'funcall-write)
      (error "funcall defvaralias did not establish alias"))
    (princ "alias-oracle: funcall\n")
    (set 'nelisp-va-base-value 'restored)
    (let ((self-rejected
           (condition-case nil
               (progn (defvaralias 'nelisp-va-self 'nelisp-va-self) nil)
             (error t)))
          (cycle-rejected
           (condition-case nil
               (progn (defvaralias 'nelisp-va-base-value 'nelisp-va-old-value) nil)
             (error t))))
      (unless (and self-rejected cycle-rejected
                   (eq (indirect-variable 'nelisp-va-old-value)
                       'nelisp-va-base-value)
                   (eq (symbol-value 'nelisp-va-base-value) 'restored))
        (error "GNU self/cycle rejection damaged existing variable state: %S"
               (list self-rejected cycle-rejected
                     (indirect-variable 'nelisp-va-old-value)
                     (symbol-value 'nelisp-va-base-value)))))
    (princ "alias-oracle: cycle-rejection\n")
    (makunbound 'nelisp-va-old-value)
    (unless (and (boundp 'nelisp-va-base-value)
                 (not (boundp 'nelisp-va-old-value)))
      (error "GNU makunbound alias boundness mismatch"))
    (princ "alias-oracle: boundness\n")
    (set 'nelisp-va-base-value 'restored)
    t))

(unless (nelisp-test-variable-alias-gnu-oracle)
  (error "GNU variable-alias oracle returned nil"))
(princ "variable-alias: PASS\n")
;;; standalone-gnu-variable-alias-oracle.el ends here
