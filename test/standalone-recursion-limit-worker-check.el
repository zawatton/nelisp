;;; standalone-recursion-limit-worker-check.el --- Shared mirror cache regression -*- lexical-binding: t; -*-

(declare-function nelisp-thread-atomic-read nil (address))
(declare-function nelisp-thread-atomic-add nil (address delta))
(declare-function nelisp-thread-join nil (address target))
(declare-function nelisp-thread-shared-alloc nil (bytes))
(declare-function nelisp-thread-gc-inhibit nil (flag))

(defvar rlw-checks 0)
(defvar rlw-failures 0)
(defun rlw-check (ok name)
  (setq rlw-checks (+ rlw-checks 1))
  (unless ok
    (setq rlw-failures (+ rlw-failures 1))
    (princ (format "FAIL %S\n" name))))
(defun rlw-recurse (n) (if (= n 0) 0 (+ 1 (rlw-recurse (- n 1)))))
(defun rlw-observe ()
  (condition-case nil (rlw-recurse 200) (excessive-lisp-nesting 1)))

;; Pause a worker with a warm cache, publish a local shadow from the parent,
;; then change the default through the ordinary assignment path. The selected
;; buffer has no local value; both old and fresh workers must see its new limit.
(if (fboundp 'nelisp-thread-spawn)
(let* ((saved-default (default-value 'max-lisp-eval-depth))
       (saved-local (local-variable-p 'max-lisp-eval-depth))
       (saved-value (symbol-value 'max-lisp-eval-depth))
       (shared (nelisp-thread-shared-alloc 64))
       (result shared) (arrived (+ shared 8)) (release (+ shared 16))
       (done (+ shared 24)) (warm (+ shared 32)) (visible (+ shared 40))
       (observed (+ shared 48)) (cold (+ shared 56))
       (active nil) (released nil) (spawned 0))
  (unwind-protect
      (progn
        (kill-local-variable 'max-lisp-eval-depth)
        (setq max-lisp-eval-depth 2000)
        (unless (= (nelisp-thread-gc-inhibit 1) 1) (error "worker section failed"))
        (setq active t)
        (unless (> (nelisp-thread-spawn
                    2 0 `(progn
                           (nelisp-thread-atomic-add ,warm (rlw-observe))
                           (nelisp-thread-atomic-add ,arrived 1)
                           (nelisp-thread-join ,release 1)
                           (nelisp-thread-atomic-add ,visible (symbol-value 'max-lisp-eval-depth))
                           (nelisp-thread-atomic-add ,observed (rlw-observe))
                           17) result done) 0)
          (error "warm worker did not spawn"))
        (setq spawned 1)
        (unless (= (nelisp-thread-join arrived 1) 1) (error "warm worker did not arrive"))
        (with-temp-buffer
          (make-local-variable 'max-lisp-eval-depth)
          (set 'max-lisp-eval-depth 100))
        (setq max-lisp-eval-depth 100)
        (nelisp-thread-atomic-add release 1)
        (setq released t)
        (unless (= (nelisp-thread-join done 1) 1) (error "warm worker did not finish"))
        (unless (> (nelisp-thread-spawn 2 0 '(rlw-observe) cold done) 0)
          (error "cold worker did not spawn"))
        (setq spawned 2)
        (unless (= (nelisp-thread-join done 2) 2) (error "cold worker did not finish"))
        (rlw-check (= (nelisp-thread-atomic-read warm) 200) 'warm-limit)
        (rlw-check (= (nelisp-thread-atomic-read visible) 100) 'visible-default)
        (rlw-check (= (nelisp-thread-atomic-read observed) 1) 'warm-worker-new-limit)
        (rlw-check (= (nelisp-thread-atomic-read cold) 1) 'fresh-worker-new-limit)
        (rlw-check (= (nelisp-thread-atomic-read result) 17) 'worker-result)
        (unless (= (nelisp-thread-gc-inhibit 0) 1) (error "worker section grew arena"))
        (setq active nil))
    (when active
      (unless released (nelisp-thread-atomic-add release 1))
      (when (> spawned 0) (nelisp-thread-join done spawned))
      (nelisp-thread-gc-inhibit 0))
    (set-default 'max-lisp-eval-depth saved-default)
    (if saved-local
        (progn (make-local-variable 'max-lisp-eval-depth)
               (set 'max-lisp-eval-depth saved-value))
      (kill-local-variable 'max-lisp-eval-depth))))

(let ((saved-default (default-value 'max-lisp-eval-depth))
      (saved-local (local-variable-p 'max-lisp-eval-depth))
      (saved-value (symbol-value 'max-lisp-eval-depth))
      (arrived nil) (release nil) (warm nil) (visible nil) (observed nil) (worker nil))
  (unwind-protect
      (progn
        (kill-local-variable 'max-lisp-eval-depth)
        (setq max-lisp-eval-depth 2000)
        (setq worker (make-thread (lambda ()
                                   (setq warm (rlw-observe) arrived t)
                                   (while (not release) (thread-yield))
                                   (setq visible (symbol-value 'max-lisp-eval-depth)
                                         observed (rlw-observe))
                                   17)))
        (while (not arrived) (thread-yield))
        (with-temp-buffer
          (make-local-variable 'max-lisp-eval-depth)
          (set 'max-lisp-eval-depth 100))
        (setq max-lisp-eval-depth 100)
        (setq release t)
        (let* ((result (thread-join worker))
               (cold (thread-join (make-thread (lambda () (list (symbol-value 'max-lisp-eval-depth) (rlw-observe)))))))
          (rlw-check (= warm 200) 'warm-limit)
          (rlw-check (= visible 100) 'visible-default)
          (rlw-check (= observed 1) 'warm-worker-new-limit)
          (rlw-check (= (cadr cold) 1) 'fresh-worker-new-limit)
          (rlw-check (= result 17) 'worker-result)))
    (setq release t)
    (when (and worker (thread-live-p worker)) (thread-join worker))
    (set-default 'max-lisp-eval-depth saved-default)
    (if saved-local
        (progn (make-local-variable 'max-lisp-eval-depth)
               (set 'max-lisp-eval-depth saved-value))
      (kill-local-variable 'max-lisp-eval-depth))))
)
(princ (format "RECURSION-LIMIT-WORKER checks=%d failures=%d\n" rlw-checks rlw-failures))
(kill-emacs (if (= rlw-failures 0) 0 1))
