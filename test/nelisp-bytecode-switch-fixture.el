;;; nelisp-bytecode-switch-fixture.el --- GNU differential switch corpus -*- lexical-binding: t; -*-
;; The three swf-compiled-* definitions below are frozen GNU 31.1 output.
(defvar swf-checks 0)
(defun swf-check (label actual expected)
  (unless (equal actual expected) (error "%s: %S != %S" label actual expected))
  (setq swf-checks (1+ swf-checks))
  (princ (format "SWITCH %s %S\n" label actual)))
(defun swf-table-function (table)
  ;; One argument, one switch, default at 3, hits at offsets 5 and 7.
  ;; Byte 0 is dup (137): GNU bytecode.c does not implement stack-ref 0.
  (make-byte-code 257 (unibyte-string 137 192 183 193 135 194 135 195 135)
                  (vector table 'default 'first 'second) 3))
(defun swf-table-cases (test first second miss label)
  (let* ((table (make-hash-table :test test)) (fn (swf-table-function table)))
    (puthash first 5 table) (puthash second 7 table)
    (swf-check (concat label "-first") (funcall fn first) 'first)
    (swf-check (concat label "-second") (funcall fn second) 'second)
    (swf-check (concat label "-miss") (funcall fn miss) 'default)
    ;; The bytecode object and table remain the same across all mutations.
    (puthash first 7 table)
    (swf-check (concat label "-replace") (funcall fn first) 'second)
    (remhash second table)
    (swf-check (concat label "-remove") (funcall fn second) 'default)
    (dotimes (i 180) (puthash (+ 10000 i) 5 table))
    (garbage-collect)
    (swf-check (concat label "-grow-gc") (funcall fn 10179) 'first)
;; No clrhash case: GNU 31.1 returns a non-default value from a cleared
    ;; live jump table (the byte compiler never mutates one), so it is not a
    ;; comparable behaviour.
    ))

(fset 'swf-compiled-symbol #[257 "\211\300\267\202\22\0\301\207\302\207\303\207\304\207\305\207\306\207\307\207" [#s(hash-table test eq data (alpha 6 beta 8 gamma 10 delta 12 epsilon 14 zeta 16)) 1 2 3 4 5 6 0] 3 "\n\n(fn KEY)"])
(fset 'swf-compiled-integer #[257 "\211\300\267\202\24\0\301\207\302\207\303\207\304\207\305\207\306\207\307\207\310\207" [#s(hash-table test eq data (-9 6 0 8 11 10 22 12 33 14 44 16 55 18)) 1 2 3 4 5 6 7 0] 3 "\n\n(fn KEY)"])
(fset 'swf-compiled-character #[257 "\211\300\267\202\22\0\301\207\302\207\303\207\304\207\305\207\306\207\307\207" [#s(hash-table test eq data (97 6 98 8 99 10 100 12 101 14 102 16)) 1 2 3 4 5 6 0] 3 "\n\n(fn KEY)"])

(dolist (key '(alpha beta gamma delta epsilon zeta absent))
  (swf-check (symbol-name key) (swf-compiled-symbol key)
             (cond ((eq key 'alpha) 1) ((eq key 'beta) 2) ((eq key 'gamma) 3)
                   ((eq key 'delta) 4) ((eq key 'epsilon) 5) ((eq key 'zeta) 6) (t 0))))
(dolist (key '(-9 0 11 22 33 44 55 999))
  (swf-check (format "integer-%d" key) (swf-compiled-integer key)
             (cond ((eql key -9) 1) ((eql key 0) 2) ((eql key 11) 3)
                   ((eql key 22) 4) ((eql key 33) 5) ((eql key 44) 6)
                   ((eql key 55) 7) (t 0))))
(dolist (key '(?a ?b ?c ?d ?e ?f ?z))
  (swf-check (format "character-%d" key) (swf-compiled-character key)
             (if (and (>= key ?a) (<= key ?f)) (- key 96) 0)))
(swf-table-cases 'eq 'alpha 'beta 'missing "eq-symbol")
(swf-table-cases 'eq 17 -31 18 "eq-fixnum")
(swf-table-cases 'eq nil t 'missing "eq-nil-t")
(swf-table-cases 'eql 1.5 -2.5 9.5 "eql-float")
(swf-table-cases 'equal (copy-sequence "one") (copy-sequence "two") "absent" "equal-string")
(let* ((table (make-hash-table :test 'eql)) (fn (swf-table-function table)))
  (puthash 1.5 5 table)
  (swf-check "eql-fresh-float" (funcall fn (string-to-number "1.5")) 'first))
(let* ((table (make-hash-table :test 'equal)) (fn (swf-table-function table)))
  (puthash "one" 5 table)
  (swf-check "equal-fresh-string" (funcall fn (copy-sequence "one")) 'first))
(let* ((table (make-hash-table :test 'eq)) (fn (swf-table-function table))
       (a (make-symbol "same")) (b (make-symbol "same")))
  (puthash a 5 table) (puthash b 7 table)
  (swf-check "uninterned-a" (funcall fn a) 'first)
  (swf-check "uninterned-b" (funcall fn b) 'second)
  (swf-check "uninterned-miss" (funcall fn (make-symbol "same")) 'default))
(let* ((table (make-hash-table :test 'eq)) (fn (swf-table-function table))
       (old (intern "swf-reinterned-key")))
  (puthash old 5 table) (unintern old obarray)
  (let ((new (intern "swf-reinterned-key")))
    (puthash new 7 table)
    (swf-check "reintern-old" (funcall fn old) 'first)
    (swf-check "reintern-new" (funcall fn new) 'second)))
(princ (format "SWITCH-CORPUS %d PASS\n" swf-checks))
(kill-emacs 0)
