(require 'ert)
(require 'cl-lib)
(defvar nelisp-cc-fxir-native-windows)
(let ((nelisp-cc-fxir-native-windows t))
  (require 'nelisp-cc-fxir-native))
(require 'nelisp-cc-fxir-facts)

(defun nfc-row (body &optional callees slots)
  (list 'renamed_condition_consumer 65001 (or slots 4) callees (list :fn body) '(0 0 -1)))

(defun nfc--main-row ()
  (nfc-row '(:seq
             (:if (:inline 6 8 (:slot 0) (:slot 1)) (:nil) (:nil))
             (:if (:call 10 1 (:slot 2)) (:nil) (:nil)))
           '(ordinary-predicate)))

(defun nfc--forms (tree predicate)
  (let (out)
    (cl-labels ((walk (x)
                  (when (consp x)
                    (when (funcall predicate x) (push x out))
                    (walk (car x)) (walk (cdr x)))))
      (walk tree))
    (nreverse out)))

(defun nfc--generic-count (tree)
  (length (nfc--forms tree (lambda (x) (eq (car-safe x) 'nc_truthy_slow)))))

(defun nfc--simplified-tests (tree)
  (nfc--forms tree (lambda (x)
                     (and (eq (car-safe x) '/=) (= (length x) 3)
                          (symbolp (nth 1 x)) (eql (nth 2 x) 3)))))

(defun nfc--status-guarded-simplified-p (tree)
  (cl-some (lambda (form)
             (and (eq (car-safe form) 'if)
                  (equal (nth 1 form) '(= st 0))
                  (nfc--simplified-tests (nth 2 form))))
           (nfc--forms tree (lambda (x) (eq (car-safe x) 'if)))))

(ert-deftest nfc-snapshot-hash-is-private-from-analyzer-string-alias ()
  (let* ((row (nfc--main-row))
         (analyze (symbol-function 'nelisp-cc-fxir-facts-analyze))
         candidate snapshot)
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
               (lambda (r &optional code)
                 (let ((facts (funcall analyze r code)))
                   (unless candidate (setq candidate facts))
                   facts))))
      (setq snapshot (nelisp-cc-fxir-native--condition-snapshot row)))
    (should snapshot)
    (should (= 1 (length (plist-get snapshot :sites))))
    (let* ((caller-hash (plist-get candidate :analysis-hash))
           (saved (copy-sequence (plist-get snapshot :hash))))
      (should-not (eq caller-hash (plist-get snapshot :hash)))
      (aset caller-hash 0 (if (= (aref caller-hash 0) ?0) ?1 ?0))
      (should (equal saved (plist-get snapshot :hash))))))

(ert-deftest nfc-private-facts-own-nested-origin-and-all-hash-strings ()
  (let* ((row (nfc-row
               '(:let ((:store 2 (:inline 13 8 (:slot 0) (:slot 1))))
                  (:if (:slot 2) (:nil) (:nil)) 0)))
         (analyze (symbol-function 'nelisp-cc-fxir-facts-analyze))
         (analysis-row (symbol-function 'nelisp-cc-fxir-analysis-row))
         (verify (symbol-function 'nelisp-cc-fxir-facts-verify))
         (property-value (list :caller-owned))
         candidate private-facts analysis-hashes snapshot)
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
               (lambda (r &optional code)
                 (let ((facts (funcall analyze r code)))
                   (unless candidate
                     (setq candidate facts)
                     (put-text-property 0 1 'caller-data property-value
                                        (plist-get facts :analysis-hash)))
                   facts)))
              ((symbol-function 'nelisp-cc-fxir-analysis-row)
               (lambda (r &optional code)
                 (let ((analysis (funcall analysis-row r code)))
                   (put-text-property 0 1 'caller-data property-value
                                      (plist-get analysis :syntax-sha256))
                   (push (plist-get analysis :syntax-sha256) analysis-hashes)
                   analysis)))
              ((symbol-function 'nelisp-cc-fxir-facts-verify)
               (lambda (r code facts)
                 (setq private-facts facts)
                 (funcall verify r code facts))))
      (setq snapshot (nelisp-cc-fxir-native--condition-snapshot row)))
    (should snapshot)
    (should (= 1 (length (plist-get snapshot :sites))))
    (let* ((caller-proof (cadar (plist-get candidate :boolean-truth-tests)))
           (private-proof (cadar (plist-get private-facts :boolean-truth-tests)))
           (caller-source (plist-get caller-proof :source))
           (private-source (plist-get private-proof :source))
           (saved-facts (prin1-to-string private-facts))
           (saved-hash (copy-sequence (plist-get snapshot :hash))))
      (should-not (eq caller-source private-source))
      (should-not (eq (plist-get caller-source :source)
                      (plist-get private-source :source)))
      (dolist (key '(:analysis-hash))
        (should-not (eq (plist-get candidate key) (plist-get private-facts key))))
      (should-not (eq (plist-get caller-proof :syntax-sha256)
                      (plist-get private-proof :syntax-sha256)))
      (should-not (eq (plist-get private-facts :analysis-hash)
                      (plist-get snapshot :hash)))
      (should-not (text-properties-at 0 (plist-get private-facts :analysis-hash)))
      (should-not (text-properties-at 0 (plist-get private-proof :syntax-sha256)))
      (should-not (text-properties-at 0 (plist-get snapshot :hash)))
      (dolist (hash analysis-hashes)
        (should-not (eq hash (plist-get snapshot :hash))))
      ;; Mutate all independently observed analyzer hashes, nested provenance,
      ;; and hidden property data after acceptance. Retained data stays private.
      (dolist (hash (append analysis-hashes
                            (list (plist-get candidate :analysis-hash)
                                  (plist-get caller-proof :syntax-sha256))))
        (aset hash 0 (if (= (aref hash 0) ?0) ?1 ?0)))
      (setcar (plist-get caller-source :version) :changed)
      (setcar (plist-get (plist-get caller-source :source) :path) 99)
      (setcar property-value :changed)
      (should (equal saved-facts (prin1-to-string private-facts)))
      (should (equal saved-hash (plist-get snapshot :hash))))))

(ert-deftest nfc-raw-metadata-guard-precedes-owned-copy ()
  (let ((cycle (list :valid t)) (copies 0))
    (setcdr (last cycle) cycle)
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
               (lambda (&rest _) cycle))
              ((symbol-function 'nelisp-cc-fxir-native--facts-owned-copy)
               (lambda (_)
                 (setq copies (1+ copies))
                 (error "Unbounded input reached copy"))))
      (should-not (nelisp-cc-fxir-native--condition-snapshot (nfc--main-row))))
    (should (= copies 0))))

(ert-deftest nfc-default-off-and-authenticated-on-use-real-defun-ast ()
  (let* ((row (nfc--main-row))
         (off (let ((nelisp-cc-fxir-native-condition-facts nil))
                (nelisp-cc-fxir-native--defun row)))
         (on (let ((nelisp-cc-fxir-native-condition-facts t))
               (nelisp-cc-fxir-native--defun row))))
    (should-not nelisp-cc-fxir-native-condition-facts)
    (should (= 2 (nfc--generic-count off)))
    ;; The renamed comparison-to-branch site loses only its classification;
    ;; the ordinary mutable call remains generic in this generated function.
    (should (= 1 (nfc--generic-count on)))
    (should (= 1 (length (nfc--simplified-tests on))))))

(ert-deftest nfc-slot-copy-reassignment-join-and-let-store-flow-to-condition ()
  (let* ((joined (nfc-row
                  '(:seq
                    (:setslot 0 (:inline 6 10 (:slot 3) (:slot 4)))
                    (:setslot 1 (:slot 0))
                    (:setslot 0 (:const 9))
                    (:if (:slot 2)
                         (:setslot 1 (:inline 13 12 (:slot 3) (:slot 4)))
                      (:setslot 1 (:inline 14 14 (:slot 4) (:slot 3))))
                    (:if (:slot 1) (:nil) (:nil)))
                  nil 5))
         (stored (nfc-row
                  '(:let ((:store 0 (:inline 13 8 (:slot 1) (:slot 2))))
                     (:if (:slot 0) (:nil) (:nil)) 0)
                  nil 3))
         (join-off (let ((nelisp-cc-fxir-native-condition-facts nil))
                     (nelisp-cc-fxir-native--defun joined)))
         (join-on (let ((nelisp-cc-fxir-native-condition-facts t))
                    (nelisp-cc-fxir-native--defun joined)))
         (store-off (let ((nelisp-cc-fxir-native-condition-facts nil))
                      (nelisp-cc-fxir-native--defun stored)))
         (store-on (let ((nelisp-cc-fxir-native-condition-facts t))
                     (nelisp-cc-fxir-native--defun stored))))
    (should (= 2 (nfc--generic-count join-off)))
    (should (= 1 (nfc--generic-count join-on)))
    (should (= 1 (length (nfc--simplified-tests join-on))))
    (should (= 1 (nfc--generic-count store-off)))
    (should (= 0 (nfc--generic-count store-on)))
    (should (= 1 (length (nfc--simplified-tests store-on))))))

(ert-deftest nfc-only-unique-original-condition-objects-can-be-consumed ()
  (let* ((shared '(:inline 6 8 (:slot 0) (:slot 1)))
         (row (nfc-row `(:seq (:if ,shared (:nil) (:nil))
                              (:if ,shared (:nil) (:nil)))))
         (on (let ((nelisp-cc-fxir-native-condition-facts t))
               (nelisp-cc-fxir-native--defun row))))
    (should (= 2 (nfc--generic-count on)))
    (should-not (nfc--simplified-tests on))))

(ert-deftest nfc-recomputed-proof-rejects-forced-boolean-on-unknown-call ()
  (let* ((row (nfc-row '(:if (:call 10 1 (:slot 0)) (:nil) (:nil)) '(unknown-predicate)))
         (real-analyze (symbol-function 'nelisp-cc-fxir-facts-analyze))
         (on (let ((nelisp-cc-fxir-native-condition-facts t))
               (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
                          (lambda (r &optional code)
                            (let* ((candidate (funcall real-analyze r code))
                                   (hash (plist-get candidate :analysis-hash))
                                   (origin (nelisp-cc-fxir-facts--origin-make
                                            :comparison :path '(1 1) :opcode 6 :arity 2
                                            :status0 t :representation :word)))
                              (plist-put candidate :boolean-truth-tests
                                         (list (list '(1 1)
                                                     (list :kind :boolean-truth-test
                                                           :syntax-sha256 hash :path '(1 1)
                                                           :source origin :result-mask 6
                                                           :representation :word :status0 t))))
                              candidate)))
                 (nelisp-cc-fxir-native--defun row)))))
    ;; A shape-valid but semantically false site cannot authorize emission.
    (should (= 1 (nfc--generic-count on)))
    (should-not (nfc--simplified-tests on)))))

(defun nfc--defun-with-facts-mutation (row mutation)
  (let ((real-analyze (symbol-function 'nelisp-cc-fxir-facts-analyze))
        (nelisp-cc-fxir-native-condition-facts t)
        (effective-facts nil)
        (result nil))
    (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
               (lambda (r &optional code)
                 (let* ((facts (funcall real-analyze r code))
                        (entry (car (plist-get facts :boolean-truth-tests)))
                        (proof (cadr entry)))
                   (pcase mutation
                     (:hash (setq facts (plist-put facts :analysis-hash "stale")))
                     (:schema (setq facts (plist-put facts :schema 99)))
                     (:origin-schema (setq facts (plist-put facts :origin-schema 99)))
                     (:status0 (setq proof (plist-put proof :status0 nil)))
                     (:origin (setq proof (plist-put proof :source :forged)))
                     (:path (setq proof (plist-put proof :path '(2 1)))))
                   (setq effective-facts facts)
                   facts))))
      (setq result (nelisp-cc-fxir-native--defun row)))
    (cons result effective-facts)))

(ert-deftest nfc-stale-hash-schema-origin-status-and-path-fall-back ()
  (let* ((row (nfc-row '(:if (:inline 13 8 (:slot 0) (:slot 1))
                         (:nil) (:nil))))
         (mutations '(:hash :schema :origin-schema :status0 :origin :path)))
    (dolist (mutation mutations)
      (let* ((pair (nfc--defun-with-facts-mutation row mutation))
             (on (car pair))
             (facts (cdr pair)))
        (should facts)
        (should (if (eq mutation :hash)
                    (equal (plist-get facts :analysis-hash) "stale")
                  t))
        (should (if (= 1 (nfc--generic-count on)) t
                  (error "Mutation did not fall back: %S" mutation)))
        (should-not (nfc--simplified-tests on))))))

(ert-deftest nfc-cyclic-deep-and-malformed-analyzer-candidates-fall-back ()
  (let* ((row (nfc-row '(:if (:inline 13 8 (:slot 0) (:slot 1))
                         (:nil) (:nil))))
         (off (let ((nelisp-cc-fxir-native-condition-facts nil))
                (nelisp-cc-fxir-native--defun row)))
         (cycle (list :valid t))
         (deep nil)
         (long-list (make-list 600 :valid)))
    (setcdr (last cycle) cycle)
    (dotimes (_ 600) (setq deep (list deep)))
    (dolist (bad (list 17 cycle '(:valid t :facts (17)) deep long-list))
      (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-analyze)
                 (lambda (&rest _) bad)))
        (should (equal off
                       (let ((nelisp-cc-fxir-native-condition-facts t))
                         (nelisp-cc-fxir-native--defun row))))))))

(ert-deftest nfc-call-overwrite-stale-slot-and-synthetic-tests-remain-generic ()
  (let* ((rows (list
                (nfc-row '(:seq (:setslot 0 (:inline 6 8 (:slot 1) (:slot 2)))
                            (:call 10 0)
                            (:if (:slot 0) (:nil) (:nil))) '(unknown))
                (nfc-row '(:seq (:setslot 0 (:inline 13 8 (:slot 1) (:slot 2)))
                            (:setslot 0 (:const 9))
                            (:if (:slot 0) (:nil) (:nil))))
                (nfc-row '(:or (:inline 6 8 (:slot 0) (:slot 1))
                               (:slot 2) (:nil))))))
    (dolist (row rows)
      (let ((on (let ((nelisp-cc-fxir-native-condition-facts t))
                  (nelisp-cc-fxir-native--defun row))))
        (should (> (nfc--generic-count on) 0))
        (should-not (nfc--simplified-tests on))))))

(ert-deftest nfc-body-factory-and-native-inline-projections-disable-consumption ()
  (let* ((row (nfc--main-row))
         (factory (let ((nelisp-cc-fxir-native-condition-facts t))
                    (nelisp-cc-fxir-native--defun row #'identity)))
         (projection (let ((nelisp-cc-fxir-native-condition-facts t)
                           (nelisp-cc-fxir-native-inline-projections t))
                       (nelisp-cc-fxir-native--defun row)))
         (addition (let ((nelisp-cc-fxir-native-condition-facts t)
                         (nelisp-cc-fxir-native-inline-additions t))
                     (nelisp-cc-fxir-native--defun row))))
    ;; A body factory declines M2. Merely enabling a global inline option
    ;; must leave this untransformed row eligible.
    (should (= 2 (nfc--generic-count factory)))
    (should (= 1 (nfc--generic-count projection)))
    (should (= 1 (nfc--generic-count addition)))
    (should (= 1 (length (nfc--simplified-tests projection))))
    (should (= 1 (length (nfc--simplified-tests addition))))))

(ert-deftest nfc-actual-projection-row-refuses-m2-consumption ()
  (let* ((leaf '(projection-leaf 65002 1 nil (:fn (:slot 0)) (1 1 -1)))
         (row (nfc-row '(:seq
                         (:if (:inline 6 8 (:slot 0) (:slot 1)) (:nil) (:nil))
                         (:call 10 1 (:slot 2)))
                       '(projection-leaf)))
         (nelisp-cc-fxir-native--row-index (make-hash-table :test 'eq))
         (nelisp-cc-fxir-native-inline-projections t)
         (nelisp-cc-fxir-native-condition-facts t))
    (puthash 'projection-leaf leaf nelisp-cc-fxir-native--row-index)
    (let ((generated (nelisp-cc-fxir-native--defun row)))
      (should (nelisp-cc-fxir-inline-projection leaf))
      (should-not (nfc--forms generated
                              (lambda (x) (eq (car-safe x) 'nc_d_65002))))
      (should (= 1 (nfc--generic-count generated)))
      (should-not (nfc--simplified-tests generated)))))

(ert-deftest nfc-condition-failure-stays-status-dominated-and-loop-polls ()
  (let* ((row (nfc-row '(:if (:inline 6 8 (:slot 0) (:slot 1)) (:nil) (:nil))))
         (normal (let ((nelisp-cc-fxir-native-condition-facts t))
                   (nelisp-cc-fxir-native--defun row)))
         (loop-row (nfc-row '(:while (:inline 13 8 (:slot 0) (:slot 1))
                            (:setslot 2 (:const 9)))))
         (loop (let ((nelisp-cc-fxir-native-condition-facts t))
                 (nelisp-cc-fxir-native--defun loop-row)))
         (mutant (let ((nelisp-cc-fxir-native-condition-facts t))
                   (cl-letf (((symbol-function 'nelisp-cc-fxir-native--block)
                              (lambda (stmts)
                                (cons 'seq (mapcar #'cdr stmts)))))
                     (nelisp-cc-fxir-native--defun row)))))
    (should (nfc--status-guarded-simplified-p normal))
    (should-not (nfc--status-guarded-simplified-p mutant))
    (should (= 0 (nfc--generic-count loop)))
    (should (= 1 (length (nfc--simplified-tests loop))))
    (should (nfc--forms loop (lambda (x) (eq (car-safe x) 'wf_bytecode_poll))))))

(ert-deftest nfc-mixed-real-m1-and-m2-lowers-once-with-exact-m1-ast ()
  (require 'nelisp-cc-fxir-inline)
  (let* ((leaf '(addition-leaf 20000 2 nil
                 (:fn (:inline 4 11 (:inline 4 7 (:slot 0) (:slot 1)) (:const 9)))
                 (2 2 -1)))
         (row (list 'mixed-caller 20001 2 '(addition-leaf)
                    (list :fn (cons :seq
                                    (append (make-list 20 '(:slot 0))
                                            '((:if (:inline 6 8 (:slot 0) (:slot 1))
                                                   (:nil) (:nil))
                                              (:call 1 2 (:slot 0) (:slot 1))))))
                    '(2 2 -1)))
         (nelisp-cc-fxir-native--row-index (make-hash-table :test 'eq))
         (nelisp-cc-fxir-native-inline-additions t)
         (nelisp-cc-fxir-native-inline-checked-additions t)
         (nelisp-cc-fxir-native--eager t)
         (verify (symbol-function 'nelisp-cc-fxir-facts-verify-add-region))
         (generate (symbol-function 'nelisp-cc-fxir-native--defun))
         baseline)
    (puthash 'addition-leaf leaf nelisp-cc-fxir-native--row-index)
    (dolist (enabled '(nil t))
      (let ((nelisp-cc-fxir-native-condition-facts enabled)
            (verified 0) (passes 0) result)
        (cl-letf (((symbol-function 'nelisp-cc-fxir-facts-verify-add-region)
                   (lambda (&rest args)
                     (let ((ok (apply verify args)))
                       (when ok (cl-incf verified)) ok)))
                  ((symbol-function 'nelisp-cc-fxir-native--defun)
                   (lambda (&rest args)
                     (when (eq (car args) row) (cl-incf passes))
                     (apply generate args))))
          (setq result (nelisp-cc-fxir-native--defun row)))
        (should (= verified 1))
        (should (= passes 1))
        (should (= 1 (nfc--generic-count result)))
        (should-not (nfc--simplified-tests result))
        (if enabled (should (equal result baseline)) (setq baseline result))))))

(ert-deftest nfc-global-m1-with-only-fast-or-ineligible-callees-keeps-m2 ()
  (require 'nelisp-cc-fxir-inline)
  (let* ((row (nfc-row '(:seq (:call 1 2 (:slot 0) (:slot 1))
                              (:call 4 3 (:slot 0) (:slot 1) (:slot 2))
                              (:if (:inline 6 8 (:slot 0) (:slot 1)) (:nil) (:nil)))
                       '(aref aset)))
         (nelisp-cc-fxir-native--row-index (make-hash-table :test 'eq))
         (nelisp-cc-fxir-native-inline-projections t)
         (nelisp-cc-fxir-native-inline-additions t)
         (nelisp-cc-fxir-native--eager t)
         (nelisp-cc-fxir-native-condition-facts t))
    ;; Even certificate-shaped harvested rows cannot select M1 when the
    ;; existing primitive fast path wins first.
    (puthash 'aref '(aref 65002 2 nil (:fn (:slot 0)) (2 2 -1))
             nelisp-cc-fxir-native--row-index)
    (puthash 'aset '(aset 65003 3 nil (:fn (:slot 0)) (3 3 -1))
             nelisp-cc-fxir-native--row-index)
    (should (= 1 (length (nfc--simplified-tests (nelisp-cc-fxir-native--defun row)))))
    (let* ((unknown (nfc--main-row))
           (unsupported '(ordinary-predicate 65004 1 nil (:fn (:nil)) (1 1 -1))))
      (puthash 'ordinary-predicate unsupported nelisp-cc-fxir-native--row-index)
      (should-not (nelisp-cc-fxir-inline-projection unsupported))
      (should-not (nelisp-cc-fxir-inline-addition unsupported))
      (should (= 1 (length (nfc--simplified-tests
                            (nelisp-cc-fxir-native--defun unknown)))))
      ;; Stale metadata still declines independently of global M1 settings.
      (should-not (nfc--simplified-tests
                   (car (nfc--defun-with-facts-mutation unknown :hash)))))))

