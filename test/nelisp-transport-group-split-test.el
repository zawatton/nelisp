;;; nelisp-transport-group-split-test.el --- Transport-specialized groups -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'json)
(require 'nelisp-standalone-build)

(defconst nelisp-transport-split--lists '(nl_apply_builtin_group_0_w nl_apply_builtin_group_1_w))
(defconst nelisp-transport-split--frames '(nl_apply_builtin_frame_group_0_w nl_apply_builtin_frame_group_1_w))
(defconst nelisp-transport-split--selected
  '(nelisp_apply_function_w nl_apply_builtin_w nl_apply_builtin_group_0_w nl_apply_builtin_group_1_w
    nl_apply_builtin_frame_group_0_w nl_apply_builtin_frame_group_1_w
    nl_apply_builtin_frame_w nl_eic_argframe_call_w
    bf_garbage_collect_w bf_garbage_collect_snapshot_w nl_gc_stats_run))
(defun nelisp-transport-split--contains (tree form)
  (or (equal tree form) (and (consp tree) (or (nelisp-transport-split--contains (car tree) form)
                                           (nelisp-transport-split--contains (cdr tree) form)))))
(defun nelisp-transport-split--leaves (tree)
  (pcase tree
    (`(if (= nl_dk ,key) ,body ,_) (list (cons key body)))
    (`(if (< nl_dk ,_) ,left ,right)
     (append (nelisp-transport-split--leaves left) (nelisp-transport-split--leaves right)))
    (_ (error "Unexpected generated key tree"))))
(defun nelisp-transport-split--sample ()
  `(let* ((nl_dk func_ptr))
     ,(nelisp-standalone--key-tree
       'nl_dk '((1 . (wf_arg_word args 0)) (2 . (wf_arg_word args 8))
                (3 . (if (= (m5_list_len args 0) 2) (wf_argval args 0)
                       (seq (ptr-write-u64 env 8 1) 0)))
                (4 . (seq (ptr-write-u64 env 0 99) (nl_cons_car_word args)))) 77)))
(defun nelisp-transport-split--check-groups (groups original frame)
  (let (seen)
    (dolist (group groups)
      (should (= (length (nth 2 group)) 6))
      (dolist (leaf (nelisp-transport-split--leaves (nth 3 group)))
        (should-not (memq (car leaf) seen))
        (push (car leaf) seen)
        (should (equal (cdr leaf)
                       (if frame (if (memq (car leaf) '(1 2 3))
                                     (nelisp-argframe-lower (cdr (assq (car leaf) original)) 'args 'argc nil) 2)
                         (cdr (assq (car leaf) original))))))
      (when frame
        (should-not (memq '_pad (flatten-tree (nth 3 group))))
        (dolist (op '(wf_arg_word wf_argval m5_list_len))
          (should-not (memq op (flatten-tree (nth 3 group)))))))
    (should (equal (sort seen #'<) '(1 2 3 4)))))

(ert-deftest nelisp-transport-split-exact-leaves-routing-and-mutation ()
  (let* ((source (nelisp-transport-split--sample))
         (original (nelisp-transport-split--leaves (nth 2 source)))
         (list-parts (nelisp-standalone--applyfn-split-handler-groups source))
         (frame-parts (nelisp-standalone--applyfn-split-handler-groups source t '(1 2 3))))
    (nelisp-transport-split--check-groups (car list-parts) original nil)
    (nelisp-transport-split--check-groups (car frame-parts) original t)
    (dolist (name nelisp-transport-split--frames)
      (should-not (memq name (flatten-tree (cdr list-parts)))))
    (dolist (name nelisp-transport-split--lists)
      (should-not (memq name (flatten-tree (cdr frame-parts)))))
    (let ((bad (copy-tree (car frame-parts))))
      (setcar (cdr (nth 3 (car bad))) '(= _pad 0))
      (should-error (nelisp-transport-split--check-groups bad original t)))
    (should-error (nelisp-standalone--applyfn-split-handler-groups
                   '(let* ((nl_dk func_ptr)) (if (= nl_dk 1) (identity args) 0)) t '(1))
                  :type 'nelisp-argframe-ineligible))
  ;; Inspect every production leaf with the real assembly/SID/N5 context.
  (let ((process-environment (copy-sequence process-environment))
        (split (symbol-function 'nelisp-standalone--applyfn-split-handler-leaves))
        original keys)
    (setenv "NELISP_READER_DYNAMIC" "1")
    (cl-letf (((symbol-function 'nelisp-standalone--applyfn-split-handler-leaves)
               (lambda (dispatch &optional frame admitted)
                 (if frame (setq keys admitted)
                   (setq original (nelisp-transport-split--leaves (nth 2 dispatch))))
                 (funcall split dispatch frame admitted))))
      (let* ((source (nelisp-standalone--patch-autoload-lookups (nelisp-standalone--applyfn-source)))
             (seen nil) (frame-seen nil)
             (names (nelisp-standalone--builtin-leaf-names source)))
        (should names)
        (dolist (name names)
          (let* ((group (cl-find name (cdr source) :key #'cadr))
                 (frame (string-match-p "_frame_leaf_" (symbol-name name)))
                 (key (progn
                        (string-match "leaf_\\([0-9]+\\)_w\\'" (symbol-name name))
                        (string-to-number (match-string 1 (symbol-name name))))))
            (should (equal (nth 2 group)
                           `(nl_dk func_ptr args env name_ptr ,(if frame 'argc '_pad))))
            (when frame
              (should-not (memq '_pad (flatten-tree (nth 3 group))))
              (dolist (op '(wf_arg_word wf_argval m5_list_len))
                (should-not (memq op (flatten-tree (nth 3 group))))))
            (should-not (memq key (if frame frame-seen seen)))
            (if frame (push key frame-seen) (push key seen))
            (should (equal (nth 3 group)
                           (if frame
                               (nelisp-argframe-lower (cdr (assq key original)) 'args 'argc nil)
                             (cdr (assq key original)))))))
        (should (equal (sort seen #'<) (sort (mapcar #'car original) #'<)))
        (should (equal (sort frame-seen #'<) (sort (copy-sequence keys) #'<)))))))

(defun nelisp-transport-split-raw-counts ()
  "Record raw AOT counts only; never label these final owner frame sizes."
  (let* ((process-environment (copy-sequence process-environment))
         (nelisp-standalone--target 'linux-x86_64)
         (nelisp-aot-compiler--allow-external-user-calls t)
         rows)
    (setenv "NELISP_READER_DYNAMIC" "1")
    (dolist (d (cdr (nelisp-standalone--patch-autoload-lookups (nelisp-standalone--applyfn-source))))
      (when (memq (cadr d) (append nelisp-transport-split--selected '(nl_apply_builtin_name_key)))
        (let* ((ir (car (nelisp-aot-compiler--collect-defuns (nelisp-aot-compiler--parse d)))) (nodes 0))
          (nelisp-aot-compiler--walk-ir (nelisp-aot-compiler--ir-get ir :body) (lambda (_) (cl-incf nodes)))
          (push `((name . ,(symbol-name (cadr d))) (raw_nodes . ,nodes)
                  (raw_rt_slots . ,(nelisp-aot-compiler--ir-get ir :rt-slot-count))) rows))))
    (with-temp-file "target/transport-split/raw-counts.json"
      (insert (json-encode `((phase . "RAW_AOT_PARSE_NOT_PRODUCTION_LOWERED") (records . ,(vconcat rows))))))))

(ert-deftest nelisp-transport-split-production-boundaries-and-cache ()
  (let ((nelisp-standalone--target 'linux-x86_64))
    (should (equal (nelisp-standalone--zero-fresh-frame-functions) nelisp-transport-split--selected))
    (dolist (name nelisp-transport-split--frames)
      (should (memq name nelisp-standalone--inline-boundaries))
      (should (memq name nelisp-standalone--direct-only-reader-defuns))
      (should (memq name (nelisp-standalone--direct-only-for "applyfn.o"))))
    (let* ((source '(defun cache_probe (x) x))
           (before (nelisp-standalone--unit-cache-key source))
           (selector (symbol-function 'nelisp-standalone--zero-fresh-frame-functions)))
      (cl-letf (((symbol-function 'nelisp-standalone--zero-fresh-frame-functions)
                 (lambda () (remq 'nl_apply_builtin_frame_group_0_w (funcall selector)))))
        (should-not (equal before (nelisp-standalone--unit-cache-key source))))))
  (dolist (nelisp-standalone--target '(windows-x86_64 linux-aarch64 macos-aarch64))
    (should-not (nelisp-standalone--zero-fresh-frame-functions))))

(ert-deftest nelisp-transport-split-n5-once-and-flat-control ()
  (let ((original (symbol-function 'nelisp-standalone--n5-syscall-dispatch)) (calls 0)
        (table '(((:lit "car") :word wf_arg_word args 0)))
        (process-environment (copy-sequence process-environment)))
    (setenv "NELISP_T104_FLAT_DISPATCH" nil)
    (cl-letf (((symbol-function 'nelisp-standalone--n5-syscall-dispatch)
               (lambda (source) (cl-incf calls) (funcall original source))))
      (let ((source (nelisp-standalone--applyfn-assemble nil table)))
        (should (= calls 1))
        (let ((names (nelisp-standalone--builtin-leaf-names source)))
          (should (= 2 (length names)))
          (dolist (name names)
            (should (= 1 (cl-count name (cdr source) :key #'cadr)))))))
    (setenv "NELISP_T104_FLAT_DISPATCH" "1")
    (let ((source (nelisp-standalone--applyfn-assemble nil table)))
      (should-not (nelisp-standalone--builtin-leaf-names source))
      (dolist (name (append nelisp-transport-split--lists nelisp-transport-split--frames))
        (should-not (cl-find name (cdr source) :key #'cadr))))))

(defun nelisp-transport-split--sha (path)
  (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally path)
                    (secure-hash 'sha256 (current-buffer))))
(defun nelisp-transport-split--write-bytes (path bytes)
  (with-temp-buffer (set-buffer-multibyte nil) (insert bytes)
                    (let ((coding-system-for-write 'binary)) (write-region nil nil path nil 'silent))))

(defun nelisp-transport-split-qualify-owner ()
  "Lower the actual owner once; cache IR before bounded emission/prologue tests."
  (setq max-lisp-eval-depth 40000 max-specpdl-size 80000)
  (let* ((out "target/transport-split/")
         (files '("scripts/nelisp-standalone-build.el" "lisp/nelisp-aot-compiler.el"
                  "lisp/nelisp-standalone-argframe.el" "lisp/nelisp-cc-evalport-combiner-arglist.el"
                  "lisp/nelisp-heap-accessors.el" "lisp/nelisp-cc-fx-call-primitives.el"
                  "test/nelisp-transport-group-split-test.el"))
         (pins (mapcar (lambda (p) (cons p (nelisp-transport-split--sha p))) files))
         (nelisp-standalone--target 'linux-x86_64)
         (process-environment (copy-sequence process-environment))
         (records nil) (frames nil)
         (emit (symbol-function 'nelisp-aot-compiler--emit-defun)))
    (setenv "NELISP_READER_DYNAMIC" "1")
    (let* ((source (nelisp-standalone--patch-autoload-lookups (nelisp-standalone--applyfn-source)))
           (nelisp-standalone--inline-import-sources (nelisp-standalone--unit-inline-imports "applyfn-reader.o"))
           (nelisp-aot-compiler--x86-direct-only-defuns nelisp-standalone--direct-only-reader-defuns))
      ;; Save raw transport shapes first; these are not final lowered counts.
      (with-temp-file (concat out "owner-raw.el")
        (let ((print-length nil) (print-level nil))
          (prin1 (cl-remove-if-not (lambda (d) (memq (cadr d) (append nelisp-transport-split--selected '(nl_apply_builtin_name_key)))) (cdr source)) (current-buffer))))
      (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-defun)
                 (lambda (ir _buf)
                   (when (memq (nelisp-aot-compiler--ir-get ir :name)
                               (append nelisp-transport-split--selected '(nl_apply_builtin_name_key)))
                     (push ir records)))))
        (nelisp-standalone--compile-to-unit "applyfn-reader.o" source)))
    (with-temp-file (concat out "owner-ir.el")
      (let ((print-length nil) (print-level nil) (print-circle t))
        (prin1 (list :inputs pins :definitions records) (current-buffer))))
    (dolist (ir records)
      (let* ((name (nelisp-aot-compiler--ir-get ir :name))
             (slots (nelisp-aot-compiler--ir-get ir :rt-slot-count))
             (params (nelisp-aot-compiler--ir-get ir :params))
             (nodes 0) (calls nil))
        (nelisp-aot-compiler--walk-ir (nelisp-aot-compiler--ir-get ir :body)
          (lambda (node) (cl-incf nodes)
            (when (memq (nelisp-aot-compiler--ir-kind node) '(call extern-call))
              (push (nelisp-aot-compiler--ir-get node :name) calls))))
        (if (eq name 'nl_apply_builtin_name_key)
            (let ((buf (nelisp-asm-x86_64-make-buffer 'sysv)))
              (when calls (error "Pure resolver gained calls"))
              (funcall emit ir buf)
              (when (nelisp-asm-x86_64-extract-relocs buf) (error "Pure resolver has relocations"))
              (nelisp-transport-split--write-bytes (concat out "resolver.bin") (nelisp-asm-x86_64-resolve-fixups buf)))
          (let* ((formal (cl-subseq '(a b c d e f) 0 (length params)))
                 (sum (cl-reduce (lambda (a b) (list '+ a b)) formal))
                 (body `(if (= a 0) (ptr-read-u64 (+ (aot-current-sp) 16) 0)
                          (if (= a 1) (seq (ptr-write-u64 (+ (aot-current-sp) 16) 0 3735928559) ,sum) ,sum)))
                 (probe (car (nelisp-aot-compiler--collect-defuns
                              (nelisp-aot-compiler--parse `(defun ,name ,formal ,body)))))
                 (probe (nelisp-aot-compiler--ir-with probe :rt-slot-count slots))
                 (nelisp-aot-compiler-zero-fresh-frame-functions (nelisp-standalone--zero-fresh-frame-functions))
                 (buf (nelisp-asm-x86_64-make-buffer 'sysv)))
            (funcall emit probe buf)
            (nelisp-transport-split--write-bytes (concat out (symbol-name name) ".bin") (nelisp-asm-x86_64-resolve-fixups buf))
            (let ((nelisp-aot-compiler-zero-fresh-frame-functions nil)
                  (control (nelisp-asm-x86_64-make-buffer 'sysv)))
              (funcall emit probe control)
              (nelisp-transport-split--write-bytes (concat out (symbol-name name) ".control.bin")
                                                 (nelisp-asm-x86_64-resolve-fixups control)))))
        (push `((name . ,(symbol-name name)) (params . ,(length params)) (rt_slots . ,slots) (nodes . ,nodes)
                (calls . ,(vconcat (delete-dups calls)))) frames)))
    (dolist (pin pins) (unless (equal (cdr pin) (nelisp-transport-split--sha (car pin))) (error "Input drift")))
    (with-temp-file (concat out "owner.json")
      (insert (json-encode `((status . "OWNER_IR_AND_PROLOGUES_ONLY") (files . ,pins) (frames . ,(vconcat frames))
                             (limits . "Full owner lowered IR; native prologues retain actual RT counts with checksum bodies. Full handler execution/F1/caps/speed/GC remain actual build gates.")))))))

(defun nelisp-transport-split-emit-native (&optional mutant)
  "Compile actual generated sample groups and real production argument kernels."
  (let* ((state #x3b000000) (argv (+ state 4096)) (cells (+ state 8192))
         (sample (nelisp-transport-split--sample))
         (lists (nelisp-standalone--applyfn-split-handler-groups sample))
         (frames (nelisp-standalone--applyfn-split-handler-groups sample t '(1 2 3)))
         (all (append nelisp-standalone--applyfn-core-helpers nelisp-standalone--applyfn-m5-helpers
                      (cdr nelisp-standalone--arena-source)))
         (kernels (mapcar (lambda (name) (or (cl-find name all :key #'cadr) (error "Missing %S" name)))
                          '(wf_arg_word wf_argval wf_cdr_has_more m5_list_len nl_cons_car_word nl_cons_cdr_word nl_word_payload nl_val_tag)))
         (checks nil))
    (when mutant
      (setq frames (copy-tree frames))
      (cl-labels ((mutate (x)
                    (when (consp x)
                      (if (and (eq (car x) 'if) (eq (car-safe (cadr x)) '<)
                               (eq (nth 2 (cadr x)) 'argc) (equal (nth 3 x) 0))
                          (setcar (nthcdr 3 x) 3)
                        (mapc #'mutate x)))))
        (dolist (group (car frames)) (mutate (nth 3 group)))))
    (dolist (case '((1 0 0) (1 1 13) (2 2 0) (2 9 201) (3 2 3) (3 1 0) (4 2 2) (99 2 2)))
      (let ((key (nth 0 case)) (argc (nth 1 case)) (expected (nth 2 case)))
        (push `(seq (ptr-write-u64 ,state 0 0) (ptr-write-u64 ,state 8 0)
                    (if (= (probe_frame ,key ,argv ,state 0 ,argc) ,expected) 0 (setq failed (+ failed 1)))
                    ,@(when (= key 4) `((if (= (ptr-read-u64 ,state 0) 0) 0 (setq failed (+ failed 1)))))) checks)))
    (push `(seq (ptr-write-u64 ,argv 0 3)
                (if (= (probe_frame 1 ,argv ,state 0 1) 3) 0 (setq failed (+ failed 1)))
                (ptr-write-u64 ,argv 0 13)
                (if (= (probe_list 1 ,(+ cells 2) ,state 0 0) 13) 0 (setq failed (+ failed 1)))
                (if (= (probe_list 2 ,(+ cells 2) ,state 0 0) 201) 0 (setq failed (+ failed 1)))
                (if (= (probe_list 4 ,(+ cells 2) ,state 0 0) 13) 0 (setq failed (+ failed 1)))
                (if (= (ptr-read-u64 ,state 0) 99) 0 (setq failed (+ failed 1)))
                (if (= (probe_list 99 ,(+ cells 2) ,state 0 0) 77) 0 (setq failed (+ failed 1)))) checks)
    (let* ((source `(seq ,@kernels ,@(car lists) ,@(car frames)
                         (defun probe_list (func_ptr args env name_ptr _pad) ,(cdr lists))
                         (defun probe_frame (func_ptr args env name_ptr argc) ,(cdr frames))
                         (defun _start ()
                           (let ((failed 0) (i 0))
                             (seq (syscall-direct 9 ,state 65536 3 50 -1 0)
                                  (while (< i 9)
                                    (seq (ptr-write-u64 ,argv (* i 8) (if (= i 8) 201 (if (= i 1) 3 13)))
                                         (ptr-write-u64 ,cells (* i 16) (if (= i 8) 201 (if (= i 1) 3 13)))
                                         (ptr-write-u64 ,cells (+ (* i 16) 8) (if (= i 8) 3 (+ ,cells (+ (* (+ i 1) 16) 2))))
                                         (setq i (+ i 1))))
                                  ,@(nreverse checks)
                                  (ptr-write-u64 ,state 24 failed)
                                  (syscall-direct 1 1 (+ ,state 24) 8 0 0 0)
                                  (syscall-direct 60 failed 0 0 0 0 0))))))
           (path (concat "target/transport-split/native-controls" (if mutant "-wrong-missing" ""))))
      (with-temp-file (concat path ".source.el") (let ((print-length nil) (print-level nil)) (prin1 source (current-buffer))))
      (nelisp-link-units path (list (nelisp-standalone--compile-to-unit "transport-controls.o" source)) "_start")
      (princ "TRANSPORT-NATIVE-COMPILED\n"))))

(provide 'nelisp-transport-group-split-test)
