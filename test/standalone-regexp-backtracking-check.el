;;; standalone-regexp-backtracking-check.el --- GNU 31.1 captures -*- lexical-binding: nil; -*-
;; Expected values: emacs -Q --batch -l tools/ai/regex-speed-parity.el.
(let ((case-fold-search nil) (search-spaces-regexp (string 255)))
  (unless (and (equal (string-match (unibyte-string 32) (unibyte-string 195 191)) 0)
               (equal (match-data t) '(0 2)))
    (error "REGEXP-SPACE-BYTES: wrong inserted-byte interpretation")))
(let ((case-fold-search nil)
      (search-spaces-regexp (string-to-multibyte (unibyte-string 255))))
  (unless (and (null (string-match (unibyte-string 32) (unibyte-string 255)))
               (equal (string-match (unibyte-string 32) (unibyte-string 193 191)) 0)
               (equal (match-data t) '(0 2)))
    (error "REGEXP-SPACE-RAW: lost raw-character storage bytes")))
(let ((case-fold-search nil) (count 0))
  (dolist (row '(("\\(ab\\|a\\)*b" "ab" (0 (0 2 0 1)))
                 ("\\(ab\\|a\\)+b" "ab" (0 (0 2 0 1)))
                 ("\\(ab\\|a\\)?b" "ab" (0 (0 2 0 1)))
                 ("\\(ab\\|a\\)\\{1,2\\}b" "ab" (0 (0 2 0 1)))
                 ("\\(ab\\|a\\)*?b" "ab" (0 (0 2 0 1)))
                 ("\\(ab\\|a\\)+?b" "ab" (0 (0 2 0 1)))
                 ("\\(\\(ab\\|a\\)\\)*b" "aab" (0 (0 3 1 2 1 2)))
                 ("\\(\\(a\\|b\\)*\\)\\2" "ab" (nil nil))
                 ("\\(a\\|b\\)*\\1" "abb" (0 (0 3 1 2)))
                 ("\\(a\\|b\\)*\\1" "aba" (nil nil))
                 ("\\(a?\\)*" "" (0 (0 0 0 0)))
                 ("\\(a?\\)*" "aa" (0 (0 2 2 2)))
                 ("\\(a*\\)+" "aa" (0 (0 2 2 2)))
                 ("\\(ab\\|a\\)?b" "b" (0 (0 1)))
                 ("\\(\\(a\\)\\|\\(b\\)\\)*c" "abc" (0 (0 3 1 2 0 1 1 2)))
                 ("\\(a\\(b\\)?\\)*" "aba" (0 (0 3 2 3 1 2)))
                 ("\\(a?\\|b\\)\\{0,2\\}a" "ba" (0 (0 2 1 1)))
                 ("\\(a?\\|b\\)\\{0,2\\}a" "baa" (0 (0 3 1 2)))
                 ("\\(a?\\|b\\)\\{1,3\\}a" "ba" (0 (0 2 1 1)))
                 ("\\(a?\\|b\\)\\{2,4\\}a" "ba" (0 (0 2 1 1)))))
    (let* ((hit (string-match (car row) (cadr row)))
           (actual (list hit (and hit (match-data t)))))
      (unless (equal actual (nth 2 row))
        (error "REGEXP-BACKTRACK %S: %S != %S" row actual (nth 2 row)))
      (setq count (1+ count))))
  (princ (format "REGEXP-BACKTRACK %d cases PASS\n" count)))
