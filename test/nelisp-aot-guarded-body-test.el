;;; nelisp-aot-guarded-body-test.el --- Closed staged arms -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-aot-guarded-body-test--enabled t)
(defvar nelisp-aot-guarded-body-test--count 0)
(defun nelisp-aot-guarded-body-test--record (&rest _) (cl-incf nelisp-aot-guarded-body-test--count))
(defun nelisp-aot-guarded-body-test--source ()
  '(seq
    (defun slow (a b c d e f)
      (seq (ptr-write-u64 805306368 56 (+ (ptr-read-u64 805306368 56) 1))
           (+ (+ (+ a b) (+ c d)) (+ (+ e f) 1))))
    (defun guarded (a b c d e f)
      (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow a b c d e f))))
        (if (= entry 0)
            (let ((saved (+ a b)))
              (seq (ptr-write-u64 805306368 8 saved)
                   (if (< saved 0)
                       (ptr-write-u64 805306368 16 c)
                     (ptr-write-u64 805306368 16 d))
                   (ptr-write-u64 805306368 24 (logxor e f))
                   (ptr-write-u64 805306368 32 (+ (ptr-read-u64 805306368 8) 7))
                   (+ (+ saved (ptr-read-u64 805306368 16)) (logxor e f))))
          (+ entry f))))
    (defun guarded_sp (a b c d e f)
      (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow a b c d e f))))
        (if (= entry 0)
            (seq (ptr-write-u64 805306368 72 a)
                 (ptr-write-u64 805306368 80 b) (- a b))
          entry)))
    (defun spwrapper () (guarded_sp (aot-current-sp) (aot-current-sp) 0 0 0 0))
    (defun wordwrapper (w)
      (if (= (sexp-tag w) 7) (guarded_sp w w 0 0 0 0)
        (if (= (sexp-tag w) 9) (guarded_sp w w 0 0 0 0) 77)))
    (defun wrapper (a b c d e f) (guarded a b c d e f))
    (defun effects (a b c d e f)
      (guarded
       (seq (ptr-write-u64 805306368 40 (+ (* (ptr-read-u64 805306368 40) 10) 1)) a)
       (seq (ptr-write-u64 805306368 40 (+ (* (ptr-read-u64 805306368 40) 10) 2)) b)
       c d e f))))
(defun nelisp-aot-guarded-body-test--defs (source)
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil))
    (nelisp-aot-compiler--collect-defuns (nelisp-aot-compiler--parse source))))
(defun nelisp-aot-guarded-body-test--object (source file disabled)
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (nelisp-aot-compiler--x86-guarded-body-folding
         (and nelisp-aot-guarded-body-test--enabled (not disabled)))
        (nelisp-aot-compiler--x86-trivial-call-folding nil)
        (nelisp-aot-compiler--x86-partial-call-folding nil)
        (nelisp-aot-guarded-body-test--count 0))
    (advice-add 'nelisp-aot-compiler--emit-guarded-named-call-x86 :before
                #'nelisp-aot-guarded-body-test--record)
    (unwind-protect
        (progn (nelisp-aot-compile-to-object source file)
               nelisp-aot-guarded-body-test--count)
      (advice-remove 'nelisp-aot-compiler--emit-guarded-named-call-x86
                     #'nelisp-aot-guarded-body-test--record))))
(ert-deftest nelisp-aot-guarded-body/fullword-effects-returning-fallback-native ()
  (let* ((dir (make-temp-file "guarded-body-" t))
         (source (nelisp-aot-guarded-body-test--source))
         (c (expand-file-name "probe.c" dir))
         (o (expand-file-name "probe.o" dir))
         (exe (expand-file-name "probe" dir))
         (counts nil))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\n#include <sys/mman.h>\n#include <stdio.h>\ntypedef uint64_t U; extern U wrapper(U,U,U,U,U,U),effects(U,U,U,U,U,U),spwrapper(void),wordwrapper(U);\nint main(void){ volatile U *p=mmap((void*)0x30000000,4096,3,0x22|0x100000,-1,0); if(p!=(void*)0x30000000)return 99;\nU v[]={0,1,2,6,~0ULL,0xffffffffULL,0x100000001ULL,0x8000000000000000ULL,0x7fffffffffffffffULL,0x4000000000000002ULL,0xabcdef0123456786ULL};\nunsigned n=0; for(unsigned i=0;i<11;i++)for(unsigned j=0;j<11;j++)for(unsigned cold=0;cold<2;cold++){U a=v[i],b=v[j],c=0x8000000000000007ULL,d=0x123456789abcdef6ULL,e=~a,f=b^0xfedcba9876543210ULL; p[0]=cold;p[5]=0;p[7]=0;for(int k=1;k<=4;k++)p[k]=0xdeadbeef; U r=effects(a,b,c,d,e,f),s=a+b,w=((int64_t)s<0?c:d);U want=cold?a+b+c+d+e+f+1+f:s+w+(e^f);if(r!=want||p[5]!=12||p[7]!=cold)return 1;if(!cold&&(p[1]!=s||p[2]!=w||p[3]!=(e^f)||p[4]!=s+7))return 2;if(cold&&(p[1]!=0xdeadbeef||p[2]!=0xdeadbeef||p[3]!=0xdeadbeef||p[4]!=0xdeadbeef))return 3;n++;}p[0]=0;if(spwrapper()!=8||p[9]-p[10]!=8)return 4; n++; U buf[4] __attribute__((aligned(8)))={9,0,0,0};U words[]={2,(U)(uintptr_t)buf+2,(U)(uintptr_t)buf+6};for(unsigned k=0;k<3;k++){if(wordwrapper(words[k])!=0||p[9]!=words[k]||p[10]!=words[k])return 5;n++;}register U q1 asm(\"rbx\")=0xabcdef1234567801ULL,q2 asm(\"r12\")=0x123456789abcdef0ULL,q3 asm(\"r13\")=0xfeedfacecafebeefULL,q4 asm(\"r14\")=0x76543210abcdef09ULL,q5 asm(\"r15\")=0xfedcba9876543210ULL;asm volatile(\"\":\"+r\"(q1),\"+r\"(q2),\"+r\"(q3),\"+r\"(q4),\"+r\"(q5));wrapper(1,2,3,4,5,6);asm volatile(\"\":\"+r\"(q1),\"+r\"(q2),\"+r\"(q3),\"+r\"(q4),\"+r\"(q5));if(q1!=0xabcdef1234567801ULL||q2!=0x123456789abcdef0ULL||q3!=0xfeedfacecafebeefULL||q4!=0x76543210abcdef09ULL||q5!=0xfedcba9876543210ULL)return 6;n++;printf(\"NATIVE %u\\n\",n);return 0;}\n"))
          (dolist (disabled '(nil t))
            (push (nelisp-aot-guarded-body-test--object source o disabled) counts)
            (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-no-pie" c o "-o" exe)))
            (with-temp-buffer
              (should (= 0 (call-process exe nil t nil)))
              (should (string= (buffer-string) "NATIVE 247\n")))
            (message "guarded-body native247 selector%s PASS" (if disabled "-disabled" "-enabled")))
          ;; A true disabled selector control: both semantic runs precede gauge.
          (should (= (car counts) 0))
          (should (> (cadr counts) 0)))
      (delete-directory dir t))))
(ert-deftest nelisp-aot-guarded-body/snapshot-and-closed-proof-negatives ()
  (let* ((source (nelisp-aot-guarded-body-test--source))
         (defs (nelisp-aot-guarded-body-test--defs source))
         (target (cl-find 'guarded defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name)))))
    (should (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts defs)))
    (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts (list target target))))
    (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts nil)))
    (dolist (kind '(sexp-tag aot-current-sp addr-of-local va-list-init atomic-fetch-add alloc-bytes))
      (let ((bad (copy-tree target t)))
        (nelisp-aot-compiler--walk-ir
         (nelisp-aot-compiler--ir-get bad :body)
         (lambda (n) (when (eq (nelisp-aot-compiler--ir-kind n) 'ptr-write-u64)
                       (aset n 0 kind))))
        (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts (list bad))))))
    (dolist (key '(:internal-entry :gc-root-slots :variadic :rest-p))
      (let ((bad (copy-tree target t)))
        (setq bad (apply #'nelisp-aot-compiler--make-ir (aref bad 0)
                         (plist-put (cdr (append bad nil)) key t)))
        (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts (list bad))))))))
(provide 'nelisp-aot-guarded-body-test)

(defun nelisp-aot-guarded-body-test--with-property (node key value)
  (apply #'nelisp-aot-compiler--make-ir (aref node 0)
         (plist-put (cdr (append node nil)) key value)))
(ert-deftest nelisp-aot-guarded-body/unused-hidden-pressure-and-independent-units ()
  (let* ((source (nelisp-aot-guarded-body-test--source))
         (nelisp-aot-compiler--object-hidden-boundary-symbols '(hidden_a hidden_b))
         (nelisp-aot-compiler--allow-external-user-calls t)
         (defs (nelisp-aot-compiler--collect-defuns (nelisp-aot-compiler--parse source)))
         (target (cl-find 'guarded defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name)))))
    (should (= 2 (length (nelisp-aot-compiler--ir-get target :internal-hidden))))
    (should (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts defs)))
    (let ((bad (copy-tree target t)))
      (nelisp-aot-compiler--walk-ir
       (nelisp-aot-compiler--ir-get bad :body)
       (lambda (n) (when (and (eq (nelisp-aot-compiler--ir-kind n) 'ref)
                             (= 0 (nelisp-aot-compiler--ir-get n :slot)))
                    (aset n (1+ (cl-position :slot (append n nil))) 6))))
      (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts (list bad)))))
    (dolist (property '((:param-class . f64) (:param-classes . (f64 gp gp gp gp gp))
                        (:fixed-param-count . 5) (:param-regs . (rcx rdx r8 r9))))
      (should-not (gethash 'guarded
                          (nelisp-aot-compiler--x86-guarded-body-facts
                           (list (nelisp-aot-guarded-body-test--with-property
                                  target (car property) (cdr property)))))))
    (let* ((bad (copy-tree target t))
           (b (nelisp-aot-compiler--ir-get bad :body))
           (i (nelisp-aot-compiler--ir-get b :value-ir))
           (tst (nelisp-aot-compiler--ir-get i :test))
           (r (nelisp-aot-compiler--ir-get tst :a)))
      (aset tst (1+ (cl-position :a (append tst nil)))
            (nelisp-aot-guarded-body-test--with-property r :volatile t))
      (should-not (gethash 'guarded (nelisp-aot-compiler--x86-guarded-body-facts (list bad))))))
  (let* ((source
          '(seq (defun pressure (a b c d e f)
                  (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow a b c d e f))))
                    (if (= entry 0)
                        (let ((x (ptr-read-u64 805306368 8)))
                          (let ((y (ptr-read-u64 805306368 16)))
                            (let ((z (ptr-read-u64 805306368 24))) (+ x (+ y z)))))
                      entry)))
                (defun slow (a b c d e f) a)))
         (defs (nelisp-aot-guarded-body-test--defs source)))
    (should-not (gethash 'pressure (nelisp-aot-compiler--x86-guarded-body-facts defs))))
  (let* ((dir (make-temp-file "guarded-units-" t))
         (o (expand-file-name "unit.o" dir)) (c (expand-file-name "unit.c" dir))
         (exe (expand-file-name "unit" dir)))
    (unwind-protect
        (progn
          (should (> (nelisp-aot-guarded-body-test--object
                      (nelisp-aot-guarded-body-test--source) o nil) 0))
          (should (= 0 (nelisp-aot-guarded-body-test--object
                        '(seq (defun guarded (a b c d e f) 7)
                              (defun wrapper (a b c d e f) (guarded a b c d e f))) o nil)))
          (should-not nelisp-aot-compiler--x86-guarded-body-facts)
          (with-temp-file c
            (insert "#include <stdint.h>\nextern uint64_t wrapper(uint64_t,uint64_t,uint64_t,uint64_t,uint64_t,uint64_t);int main(void){return wrapper(1,2,3,4,5,6)!=7;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-no-pie" c o "-o" exe)))
          (should (= 0 (call-process exe nil nil nil))))
      (delete-directory dir t))))

(ert-deftest nelisp-aot-guarded-body/finite-exact-metadata-before-recursion ()
  (let* ((defs (nelisp-aot-guarded-body-test--defs (nelisp-aot-guarded-body-test--source)))
         (target (cl-find 'guarded defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name)))))
    (dolist (key '(:unknown :eh-region :aot-boundary :frame-observer :atomic-order))
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p
                   (nelisp-aot-guarded-body-test--with-property target key t))))
    (dolist (class '(unknown nil f64))
      (let ((bad (copy-tree target t)))
        (nelisp-aot-compiler--walk-ir
         (nelisp-aot-compiler--ir-get bad :body)
         (lambda (n) (when (eq (nelisp-aot-compiler--ir-kind n) 'ref)
                       (aset n (1+ (cl-position :class (append n nil))) class))))
        (should-not (nelisp-aot-compiler--x86-guarded-body-original-p bad))))
    (let ((bad (copy-tree target t)))
      (nelisp-aot-compiler--walk-ir
       (nelisp-aot-compiler--ir-get bad :body)
       (lambda (n) (when (eq (nelisp-aot-compiler--ir-kind n) 'ref)
                     (aset n (1+ (cl-position :slot (append n nil))) -1))))
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p bad)))
    (let* ((bad (copy-tree target t)) (body (nelisp-aot-compiler--ir-get bad :body)))
      (aset body (1+ (cl-position :body (append body nil))) body)
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p bad)))
    (let* ((bad (copy-tree target t)) (body (nelisp-aot-compiler--ir-get bad :body))
           (init (nelisp-aot-compiler--ir-get body :value-ir)))
      (aset init (1+ (cl-position :else (append init nil)))
            (nelisp-aot-compiler--ir-get init :then))
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p bad)))
    (let ((b (nelisp-aot-compiler--make-ir 'imm :value 0)))
      (dotimes (_ 45) (setq b (nelisp-aot-compiler--make-ir 'value-seq :forms (list b))))
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p
                   (nelisp-aot-guarded-body-test--with-property target :body b))))
    (let ((b (nelisp-aot-compiler--make-ir
              'value-seq :forms
              (cl-loop repeat 6 collect
                       (nelisp-aot-compiler--make-ir
                        'value-seq :forms (cl-loop repeat 100 collect
                                (nelisp-aot-compiler--make-ir 'imm :value 0)))))))
      (should-not (nelisp-aot-compiler--x86-guarded-body-original-p
                   (nelisp-aot-guarded-body-test--with-property target :body b))))))
