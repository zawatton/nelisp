;;; -*- lexical-binding: t; -*-
;; fxadopt parity corpus: same transcript with the VM off, on GNU, and with the VM forced on.
(defvar fxc-glob 0)
(defvar fxc-fns nil)
(defmacro fxc-def (name args &rest body)
  `(progn (eval '(defun ,name ,args ,@body) t) (push ',name fxc-fns) ',name))
(defvar fxc-cases nil)
(defmacro fxc (label &rest body)
  `(push (lambda ()
           (princ (format "%s => %s\n" ,label
                          (condition-case e (format "%S" (progn ,@body))
                            (error (format "ERR %S" e))))))
         fxc-cases))

;; --- multi-pair setq
(fxc-def fxc-setq0 () (setq))
(fxc-def fxc-setq2 (a b) (setq a (1+ a) b (+ a b)) (list a b))
(fxc-def fxc-setq-val (a) (list (setq a 1 a (+ a 10)) a))
(fxc-def fxc-setq-glob () (list (setq fxc-glob 5 fxc-glob (* fxc-glob 2)) fxc-glob))
(fxc-def fxc-setq-mix (x) (let ((y 0)) (setq y x fxc-glob (1+ y) x (list y fxc-glob)) (list x y fxc-glob)))
(fxc-def fxc-setq-order (n) (let ((l nil)) (setq n (progn (push 'a l) 1) n (progn (push 'b l) (+ n 1))) (list n l)))
(fxc-def fxc-setq-odd (a) (eval '(setq a 1 b) t))
(fxc-def fxc-setq-nil () (setq nil 1))
(fxc-def fxc-setq-t () (setq t 1))
(fxc-def fxc-setq-kw () (setq :k 1))
(fxc-def fxc-setq-copy (l) (let ((a (car l)) (b (cdr l))) (setq a (cons a a) b (cons b b)) (list a b)))
(fxc "setq0" (fxc-setq0))
(fxc "setq2" (fxc-setq2 1 2))
(fxc "setq-val" (fxc-setq-val 9))
(fxc "setq-glob" (fxc-setq-glob))
(fxc "setq-mix" (fxc-setq-mix 4))
(fxc "setq-order" (fxc-setq-order 0))
(fxc "setq-nil" (fxc-setq-nil))
(fxc "setq-t" (fxc-setq-t))
(fxc "setq-kw" (fxc-setq-kw))
(fxc "setq-copy" (fxc-setq-copy '(1 . 2)))

;; --- interactive
(fxc-def fxc-int0 () (interactive) 1)
(fxc-def fxc-int1 (n) "Doc." (interactive "p") (list n (interactive "x") 2))
(fxc-def fxc-int2 (&optional n) (interactive (list (read-string "no: "))) (or n 'none))
(fxc "int0" (list (fxc-int0) (commandp 'fxc-int0) (interactive-form 'fxc-int0)))
(fxc "int1" (list (fxc-int1 3) (commandp 'fxc-int1) (interactive-form 'fxc-int1)))
(fxc "int2" (list (fxc-int2) (fxc-int2 7) (interactive-form 'fxc-int2)))
(fxc "int-call" (call-interactively 'fxc-int0))
(fxc "int-doc" (documentation 'fxc-int1))

