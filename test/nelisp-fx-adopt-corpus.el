;; redefinition / fset / advice take effect
(fxc-def fxc-callee (x) (+ x 1))
(fxc-def fxc-caller (x) (setq x (fxc-callee x) x (fxc-callee x)) x)
(fxc "redef-0" (fxc-caller 1))
(fxc "redef-1" (progn (eval (quote (defun fxc-callee (x) (+ x 100))) t) (fxc-caller 1)))
(fxc "redef-2" (progn (fset 'fxc-callee (lambda (x) (* x 3))) (fxc-caller 1)))
(fxc "redef-3" (progn (advice-add 'fxc-callee :around (lambda (f x) (- (funcall f x)))) (fxc-caller 1)))
(fxc "redef-4" (progn (advice-remove 'fxc-callee (lambda (f x) (- (funcall f x)))) (fxc-caller 1)))
(fxc "redef-5" (progn (fset 'fxc-caller (lambda (x) 'replaced)) (fxc-caller 1)))
