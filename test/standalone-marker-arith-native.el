;;; standalone-marker-arith-native.el --- markers in arithmetic, buffer-modified-p -*- lexical-binding: t; -*-
;; GNU accepts markers wherever `number-or-marker-p' is named, and provides
;; `buffer-modified-p' / `set-buffer-modified-p'.  Exits non-zero on mismatch.
;; Native variant: no `nelisp-marker-arith-call' wrapper.  This runtime has no standard marker constructors, so markers
;; come from `nelisp-copy-marker' / `nelisp-make-marker'.
(defvar nm--fail nil)
(defmacro nm--check (form expected)
  `(let ((got (condition-case e ,form (error (list 'ERR (car e))))))
     (unless (equal got ,expected)
       (setq nm--fail t)
       (princ (format "MISMATCH %S => %S (want %S)\n" ',form got ,expected)))))
(with-temp-buffer
  (insert "hello world abc")
  (let ((m (nelisp-copy-marker (current-buffer) 5))
        (m2 (nelisp-copy-marker (current-buffer) (point)))
        (nowhere (nelisp-make-marker)))
    (nm--check (< m 9) t)
    (nm--check (> m 2) t)
    (nm--check (<= m m2) t)
    (nm--check (>= m 1) t)
    (nm--check (= m m) t)
    (nm--check (= 5 m) t)
    (nm--check (/= m 3) t)
    (nm--check (< 1 m 9) t)
    (nm--check (+ m 1) 6)
    (nm--check (+ m m) 10)
    (nm--check (- m 1) 4)
    (nm--check (- m) -5)
    (nm--check (* m 2) 10)
    (nm--check (/ m 1) 5)
    (nm--check (max m 1) 5)
    (nm--check (min m 9) 5)
    (nm--check (1+ m) 6)
    (nm--check (1- m) 4)
    (nm--check (% m 2) 1)
    (nm--check (mod m 2) 1)
    (nm--check (+ nowhere 1) '(ERR error))
    (nm--check (+ 1 2) 3)
    (nm--check (+ 'a 1) '(ERR wrong-type-argument))
    (nm--check (set-buffer-modified-p nil) nil)
    (nm--check (buffer-modified-p) nil)
    (insert "x")
    (nm--check (buffer-modified-p) t)
    (nm--check (progn (set-buffer-modified-p nil) (buffer-modified-p)) nil)
    (nm--check (restore-buffer-modified-p t) t)
    (nm--check (buffer-modified-p) t)
    (nm--check (restore-buffer-modified-p nil) nil)
    (nm--check (buffer-modified-p) nil)
    (nm--check (mod nowhere 2) '(ERR error))
    (nm--check (mod 7 m) 2)
    (nm--check (mod 'a 2) '(ERR wrong-type-argument))))
(when nm--fail (kill-emacs 1))
(princ "OK\n")
