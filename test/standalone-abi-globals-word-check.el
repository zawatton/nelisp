;;; standalone-abi-globals-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0) (index 0))
  (dolist (value (list nil t 0 -7 1.25 "globals" '(a . b) [nil t] (make-symbol "global-value")))
    (let ((name (intern (format "abi-global-word-%d" index)))
          (fn (intern (format "abi-global-fn-%d" index))))
      (unless (eq (nelisp--env-globals-op 'set-value name value) value)
        (error "raw set-value result changed"))
      (unless (eq (nelisp--env-globals-op 'get-value name) value)
        (error "raw get-value changed"))
      (unless (eq (nelisp--env-globals-op 'is-bound name) t) (error "raw bound flag changed"))
      (unless (eq (nelisp--env-globals-op 'clear-value name) name) (error "raw clear-value result changed"))
      (unless (null (nelisp--env-globals-op 'is-bound name)) (error "raw cleared flag changed"))
      (setq checked (+ checked 5))
      (unless (eq (nelisp--env-globals-op 'set-function fn value) value)
        (error "raw set-function result changed"))
      (unless (eq (nelisp--env-globals-op 'get-function fn) value)
        (error "raw get-function changed"))
      (unless (eq (symbol-function fn) value) (error "symbol-function result changed"))
      (unless (eq (fset fn value) value) (error "fset result changed"))
      (unless (eq (nelisp--env-globals-op 'clear-function fn) fn) (error "raw clear-function result changed"))
      (unless (null (symbol-function fn)) (error "symbol-function miss changed"))
      (setq checked (+ checked 6))
      (unless (eq (nelisp--env-globals-op 'set-constant name value) (if value t nil))
        (error "raw set-constant result changed"))
      (unless (eq (nelisp--env-globals-op 'is-constant name) (if value t nil))
        (error "raw constant flag changed"))
      (nelisp--env-globals-op 'set-constant name nil)
      (setq checked (+ checked 2)))
    (setq index (+ index 1)))
  (dolist (form '((symbol-function 17) (fset 17 nil) (fset nil t)
                  (symbol-function) (symbol-function 'car 'cdr)))
    (unless (eq (condition-case e (eval form) (error (car e)))
                (if (eq (car form) 'symbol-function)
                    (if (= (length form) 2) 'wrong-type-argument 'wrong-number-of-arguments)
                  (if (eq (nth 1 form) nil) 'setting-constant 'wrong-type-argument)))
      (error "function-cell condition changed: %S" form))
    (setq checked (+ checked 1)))
  (princ (format "ABI-GLOBALS-WORD checked=%d PASS\n" checked)))
