;;; nelisp-aot-private-continuation-test.el --- Private branch labels -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)
(load "nelisp-aot-cleanup-branch-test" nil t)
(load "nelisp-aot-trace-loop-test" nil t)
(defconst nelisp-private-continuation-test--prefixes
 '("cj-if-evaluated" "cj-cleanup-taken" "cj-cleanup-done"))
(defvar nelisp-private-continuation-test--labels nil)
(defvar nelisp-private-continuation-test--E-label nil)
(defvar nelisp-private-continuation-test--E-count 0)
(defun nelisp-private-continuation-test--seed (fn prefix)
 (let ((label (funcall fn prefix)))
  (when (member prefix nelisp-private-continuation-test--prefixes)
   (puthash prefix (symbol-name label) nelisp-private-continuation-test--labels)) label))
(defun nelisp-private-continuation-test--private (fn prefix)
 (let ((label (funcall fn prefix)))
  (when (member prefix nelisp-private-continuation-test--prefixes)
   (puthash prefix (symbol-name label) nelisp-private-continuation-test--labels)) label))
(defun nelisp-private-continuation-test--trace (fn node role)
 (let ((label (funcall fn node role)))
  (when (and (eq (nelisp-aot-compiler--ir-kind node) 'while) (equal role "entry"))
   (setq nelisp-private-continuation-test--E-label (symbol-name label))) label))
(defun nelisp-private-continuation-test--E (&rest _)
 (cl-incf nelisp-private-continuation-test--E-count))
(ert-deftest nelisp-private-continuation/counter-identity-and-namespace ()
 (let* ((nelisp-aot-compiler--label-counter 40)
        (nelisp-aot-compiler--x86-private-continuations t)
        (nelisp-aot-compiler--x86-trace-unit-names '("trace-cj-cleanup-taken-41-continuation"))
        (label (nelisp-aot-compiler--x86-continuation-label "cj-cleanup-taken")))
  (should (= nelisp-aot-compiler--label-counter 41))
  (should-not (eq label (intern (symbol-name label))))
  (should-not (member (symbol-name label) nelisp-aot-compiler--x86-trace-unit-names))
  (should (intern-soft "cj-cleanup-taken-41"))))
(defun nelisp-private-continuation-test--source (frontend &optional public E)
 (let* ((entry (or public 'pc_public))
        (v (cl-subst 'pc_observe 'V_observe
                    (cl-subst 805306368 268435456 (nelisp-cleanup-test--def 'pc_v '= nil nil))))
        (body (if E
          `(seq (syscall-direct 9 805306368 4096 3 50 -1 0)
            (ptr-write-u8 805306368 0 0) (ptr-write-u8 805306368 1 9) (ptr-write-u8 805306368 2 0)
            (ptr-write-u64 805306368 272 3)
            (if (and (= (trace_probe 805306368 805306624 3 5) 14)
                     (= (call-ptr (addr-of ,entry)) 73)) 0 1))
          `(seq (syscall-direct 9 805306368 4096 3 50 -1 0)
             (ptr-write-u64 805306368 0 1) (ptr-write-u64 805306368 8 2)
             (ptr-write-u64 805306368 16 3) (ptr-write-u64 805306368 32 0)
             (ptr-write-u8 805306368 256 191) (ptr-write-u8 805306368 320 4)
             (let* ((v (pc_v 1 0 0 0)) (u (pc_u 805306368)))
              (if (and (= v -38) (= u -19) (= (ptr-read-u64 805306368 32) 8)
                       (= (pc_word 2) 2) (= (pc_word 805306630) 6) (= (pc_word 805306688) 0)
                       (= (call-ptr (addr-of ,entry)) 73)) 0 1))))))
  `(seq
    ,@(if E
       (list '(defun external_cold (p x y) (seq (syscall-direct 39 0 0 0 0 0 0) (+ x y)))
             (nelisp-aot-trace-loop-test--internal) (nelisp-aot-trace-loop-test--definition))
       (list '(defun pc_observe (v) (seq (syscall-direct 39 0 0 0 0 0 0) v)) v
        '(defun pc_u (p)
          (if (= (if (seq (ptr-write-u64 p 32 (+ (ptr-read-u64 p 32) 1))
                             (ptr-read-u64 p 0)) 7 -9) 0) 17 -19))
        '(defun pc_word (w) (if (= (sexp-tag w) 7) 2 (if (= (sexp-tag w) 63) 6 0)))))
    (defun pc_public () 73)
    (defun pc_main () ,body)
    ,@(if (eq frontend 'pass) '((exit (pc_main)))
         '((defun _start () (syscall-direct 60 (pc_main) 0 0 0 0 0))))
    ,@(and public `((defun ,public () 73))))))
(defun nelisp-private-continuation-test--build (frontend source path)
 (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
       (nelisp-standalone--target 'linux-x86_64))
  (pcase frontend
   ('pass (nelisp-aot-compile-sexp source path))
   ('object
    (let ((object (concat path ".o")))
     (nelisp-aot-compile-to-object source object)
     (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" object "-o" path)))))
   ('standalone
    (nelisp-link-units path (list (nelisp-standalone--compile-to-unit "private-continuations" source)) "_start")))
  (should (equal 0 (call-process path nil nil nil)))))
(ert-deftest nelisp-private-continuation/native-three-frontends-public-collisions ()
 (let* ((dir (make-temp-file "private-continuations-" t))
        (nelisp-aot-compiler--x86-private-continuations
         (not (getenv "NELISP_PRIVATE_CONTINUATION_TEST_DISABLE")))
        (captures nil)
        (nelisp-private-continuation-test--labels (make-hash-table :test 'equal)))
  (advice-add 'nelisp-aot-compiler--gensym :around #'nelisp-private-continuation-test--seed)
  (advice-add 'nelisp-aot-compiler--x86-continuation-label :around #'nelisp-private-continuation-test--private)
  (unwind-protect
   (progn
    (dolist (front '(pass object standalone))
     (clrhash nelisp-private-continuation-test--labels)
     (nelisp-private-continuation-test--build front (nelisp-private-continuation-test--source front)
       (expand-file-name (symbol-name front) dir))
     (dolist (prefix nelisp-private-continuation-test--prefixes)
      (should (gethash prefix nelisp-private-continuation-test--labels)))
     (push (cons front (copy-hash-table nelisp-private-continuation-test--labels)) captures))
    (message "Y1 baseline native/WORD/effect/cold-call/public-entry semantics PASS on all three frontends before collision controls")
    (dolist (capture captures)
     (dolist (prefix nelisp-private-continuation-test--prefixes)
      (let* ((name (intern (gethash prefix (cdr capture))))
             (path (expand-file-name (format "%s-%s" (car capture) prefix) dir)))
       (nelisp-private-continuation-test--build (car capture)
         (nelisp-private-continuation-test--source (car capture) name) path)
       ;; Captures the actual new concrete prefix, rather than accepting
       ;; a generator-format change as collision avoidance.
       (should-not (equal (symbol-name name) (gethash prefix nelisp-private-continuation-test--labels))))))
    (message "Y1 9 actual-private-prefix public collisions/native checks PASS"))
   (advice-remove 'nelisp-aot-compiler--gensym #'nelisp-private-continuation-test--seed)
   (advice-remove 'nelisp-aot-compiler--x86-continuation-label #'nelisp-private-continuation-test--private)
   (unless (getenv "NELISP_PRIVATE_CONTINUATION_TEST_KEEP") (delete-directory dir t)))))
(ert-deftest nelisp-private-continuation/standalone-existing-E-namespace ()
 (let* ((dir (make-temp-file "private-E-names-" t))
        (nelisp-aot-compiler--x86-private-continuations
         (not (getenv "NELISP_PRIVATE_CONTINUATION_TEST_DISABLE")))
        (nelisp-aot-compiler--x86-trace-unit-names nil)
        (nelisp-private-continuation-test--E-label nil)
        (nelisp-private-continuation-test--E-count 0))
  (advice-add 'nelisp-aot-compiler--x86-trace-label :around #'nelisp-private-continuation-test--trace)
  (advice-add 'nelisp-aot-compiler--emit-trace-loop-x86 :before #'nelisp-private-continuation-test--E)
  (unwind-protect
   (progn
    (nelisp-private-continuation-test--build 'standalone
      (nelisp-private-continuation-test--source 'standalone nil t) (expand-file-name "base" dir))
    (message "Y1 original no-hidden standalone semantics PASS before E namespace gauge")
    (should (> nelisp-private-continuation-test--E-count 0))
    (should nelisp-private-continuation-test--E-label)
    (let ((name (intern nelisp-private-continuation-test--E-label)))
     (nelisp-private-continuation-test--build 'standalone
       (nelisp-private-continuation-test--source 'standalone name t) (expand-file-name "collision" dir))
     (should-not (equal (symbol-name name) nelisp-private-continuation-test--E-label)))
    (should-not nelisp-aot-compiler--x86-trace-unit-names))
   (advice-remove 'nelisp-aot-compiler--x86-trace-label #'nelisp-private-continuation-test--trace)
   (advice-remove 'nelisp-aot-compiler--emit-trace-loop-x86 #'nelisp-private-continuation-test--E)
   (unless (getenv "NELISP_PRIVATE_CONTINUATION_TEST_KEEP") (delete-directory dir t)))))
(provide 'nelisp-aot-private-continuation-test)
