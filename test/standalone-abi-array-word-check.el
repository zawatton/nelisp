;;; standalone-abi-array-word-check.el --- Array setter WORD results -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(put 'abi-array-table 'char-table-extra-slots 2)
(let ((checks 0))
  (dolist (value (list nil t 0 -7 1.25 "array" '(a . b) [nil t -7]
                       (make-symbol "array-symbol") (make-bool-vector 9 t)))
    (let ((v (make-vector 3 nil)) (r (make-record 'abi-array-record 3 nil))
          (b (make-bool-vector 3 nil)) (ct (make-char-table 'abi-array-table nil)))
      (unless (eq (aset v 1 value) value) (error "vector setter result changed"))
      (unless (eq (aref v 1) value) (error "vector value changed"))
      (unless (eq (aset r 1 value) value) (error "record setter result changed"))
      (unless (eq (aref r 1) value) (error "record value changed"))
      (unless (eq (aset b 1 value) value) (error "bool setter result changed"))
      (unless (eq (aref b 1) (if value t nil)) (error "bool truth value changed"))
      (unless (eq (aset ct 2 value) value) (error "char setter result changed"))
      (unless (eq (aref ct 2) value) (error "char value changed"))
      (dotimes (_ 2)
        (unless (eq (set-char-table-range ct '(30 . 35) value) value)
          (error "range setter result changed"))
        (unless (eq (aref ct 32) value) (error "range value changed")))
      (unless (eq (set-char-table-extra-slot ct 1 value) value)
        (error "extra-slot setter result changed"))
      (unless (eq (char-table-extra-slot ct 1) value) (error "extra-slot value changed"))
      (unless (eq (set-char-table-range ct nil value) value)
        (error "default setter result changed"))
      (unless (eq (char-table-range ct nil) value) (error "default value changed"))
      (unless (eq (set-char-table-range ct t value) value)
        (error "all-range setter result changed"))
      (unless (eq (aref ct 1000) value) (error "all-range value changed"))
      (garbage-collect)
      (unless (and (eq (aref v 1) value) (eq (aref r 1) value)
                   (eq (char-table-extra-slot ct 1) value))
        (error "array value identity lost at GC"))
      (setq checks (+ checks 19))))
  (dolist (code '(0 65 127 255))
    (let ((s (unibyte-string 65 66 67)))
      (unless (eq (aset s 1 code) code) (error "unibyte result changed"))
      (unless (= (aref s 1) code) (error "unibyte mutation changed"))
      (setq checks (+ checks 2))))
  (dolist (code '(0 65 127))
    (let ((s (copy-sequence "abc")))
      (unless (eq (aset s 1 code) code) (error "ASCII result changed"))
      (unless (= (aref s 1) code) (error "ASCII mutation changed"))
      (setq checks (+ checks 2))))
  (dolist (form '((aset [1 2] -1 0) (aset [1 2] 2 nil)
                  (aset [1 2] t 0) (aset "abc" 1 nil)
                  (aset "abc" 1 t) (aset "abc" 1 'bad)
                  (aset "abc" 1 1.25) (aset (make-bool-vector 2 nil) 2 0)
                  (set-char-table-range (make-char-table 'abi-array-table) 'bad nil)
                  (set-char-table-extra-slot (make-char-table 'abi-array-table) -1 0)))
    (let ((condition (condition-case e (progn (eval form t) nil) (error (car e)))))
      (unless condition (error "invalid setter input accepted: %S" form))
      (princ (format "ARRAY-ERROR %S\n" condition))
      (setq checks (+ checks 1))))
  (princ (format "ABI-ARRAY-WORD checks=%d PASS\n" checks)))
