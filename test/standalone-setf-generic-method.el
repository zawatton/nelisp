;;; standalone-setf-generic-method.el --- Real GV setter generic registration -*- lexical-binding: t; -*-
(require 'gv)
(require 'cl-generic)
(cl-defgeneric nelisp-method-place (object))
(cl-defmethod nelisp-method-place ((object cons)) (car object))
(cl-defgeneric (setf nelisp-method-place) (value object))
(cl-defmethod (setf nelisp-method-place) (value (object cons)) (setcar object value))
(let ((object (list 1)) (effects 0))
  (unless (= (nelisp-method-place object) 1) (error "Generic getter differs"))
  (unless (= (setf (nelisp-method-place (progn (setq effects (1+ effects)) object))
                   (progn (setq effects (1+ effects)) 42)) 42)
    (error "Generalized setter return differs"))
  (unless (and (= effects 2) (= (car object) 42)
               (= (funcall (gv-setter 'nelisp-method-place) 43 object) 43)
               (= (nelisp-method-place object) 43))
    (error "GV setter canonical dispatch/evaluation differs")))
(let ((name (make-symbol "conflicting-method-place")))
  (put name 'gv-expander #'ignore)
  (unless (condition-case nil
              (progn (macroexpand `(cl-defmethod (setf ,name) (value object) value)) nil)
            (error t))
    (error "Existing generalized expander conflict was accepted")))
(unless (condition-case nil
            (progn (macroexpand '(cl-defmethod (setf 1) (value object) value)) nil)
          (wrong-type-argument t))
  (error "Generalized function base name type refusal differs"))
(princ "SETF-GENERIC-METHOD-PASS\n")
