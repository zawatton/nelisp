;;; nelisp-aot-cleanup-branch-test.el --- Region outcome cleanup -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-cleanup-test--ir (kind &rest args)
  (apply #'nelisp-aot-compiler--make-ir kind args))
(ert-deftest nelisp-cleanup-branch/original-owner-and-fallbacks ()
 (let* ((n (nelisp-cleanup-test--ir 'let-rt :slot 4
            :value-ir (nelisp-cleanup-test--ir 'imm :value 5)
            :body (nelisp-cleanup-test--ir 'ref :slot 4)))
        (plan '(((4 . rbx) (5 . r8) (6 . r9)) 4 5 6))
        (nelisp-aot-compiler--x86-zero-branch-context t)
        (nelisp-aot-compiler--x86-cleanup-branches t)
        (nelisp-aot-compiler--promoted-slots nil)
        (nelisp-aot-compiler--x86-tco-entry-state nil)
        (nelisp-aot-compiler--x86-leaf-entry-state nil)
        (nelisp-aot-compiler--x86-shrink-wrap-state nil)
        (nelisp-aot-compiler--abi 'sysv))
  (cl-letf (((symbol-function 'nelisp-aot-compiler--x86-call-free-region-emission-plan)
             (lambda (_) plan)))
   (should (eq plan (nelisp-aot-compiler--x86-cleanup-branch-plan n)))
   (dolist (binding '((nelisp-aot-compiler--promoted-slots . ((4 . rbx)))
                     (nelisp-aot-compiler--x86-tco-entry-state . (:forward t))
                     (nelisp-aot-compiler--x86-leaf-entry-state . (:outer t))
                     (nelisp-aot-compiler--x86-shrink-wrap-state . (:cut t))
                     (nelisp-aot-compiler--x86-trace-loop-exits . nil)
                     (nelisp-aot-compiler--x86-cleanup-branches . nil)
                     (nelisp-aot-compiler--abi . win64)))
     (unless (eq (car binding) 'nelisp-aot-compiler--x86-trace-loop-exits)
      (cl-progv (list (car binding)) (list (cdr binding))
       (should-not (nelisp-aot-compiler--x86-cleanup-branch-plan n)))))
   (let ((nelisp-aot-compiler--x86-trace-loop-exits (list (cons n 'cold))))
    (should-not (nelisp-aot-compiler--x86-cleanup-branch-plan n)))
   (let ((old-plan plan))
    (setq plan '(((4 . r12)) 4))
    (should-not (nelisp-aot-compiler--x86-cleanup-branch-plan n))
    (setq plan old-plan))
   (dolist (key '(:repr :return-repr))
    (dolist (repr '(unknown word sexp-ptr typed raw-f64 f64))
     (should-not (nelisp-aot-compiler--x86-cleanup-branch-plan (vconcat n (vector key repr)))))))))
(defun nelisp-cleanup-test--binding (word)
 `((a (seq (ptr-write-u64 268435456 32 1)
           ,(if word '(if (= (sexp-tag (ptr-read-u64 268435456 24)) 7) 7
                       (if (= (sexp-tag (ptr-read-u64 268435456 24)) 63) 63 4)) '(ptr-read-u64 268435456 0))))
   (b (seq (ptr-write-u64 268435456 32 (+ (ptr-read-u64 268435456 32) 2))
           (ptr-read-u64 268435456 8)))
   (c (seq (ptr-write-u64 268435456 32 (+ (ptr-read-u64 268435456 32) 4))
           (ptr-read-u64 268435456 16)))))
(defun nelisp-cleanup-test--subject (&optional word fault)
 `(let* ,(nelisp-cleanup-test--binding word)
    (seq (setq a (+ a 5)) (setq b (logxor b 85)) (setq c (- c 7))
         (if ,(if fault '(ptr-read-u64 p 0) '(> x 0))
             (+ a (+ a (+ a (+ b (+ b (+ b (+ c (+ c c)))))))) 0))))
(defun nelisp-cleanup-test--def (name op swap sense &optional word fault)
 (let* ((subject (nelisp-cleanup-test--subject word fault))
        (cmp (if swap `(,op 0 ,subject) `(,op ,subject 0))))
  `(defun ,name (x y z p)
    (seq (if (= p -1) (syscall-direct 60 99 0 0 0 0 0) 0)
     (let* ((i 0) (sum 0))
      (seq (while (< i 2)
             (seq (setq sum (+ sum (if ,(if sense `(or ,cmp (= y 7)) cmp)
                                       (extern-call V_observe 17) (extern-call V_observe -19))))
                  (setq i (+ i 1)))) sum))))))
(defun nelisp-cleanup-test--u64 (v) (logand v #xffffffffffffffff))
(defun nelisp-cleanup-test--c (v) (format "UINT64_C(%d)" (nelisp-cleanup-test--u64 v)))
(ert-deftest nelisp-cleanup-branch/native-outcomes-frame-reentry-fault-WORD-and-ABI ()
 (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
 (let* ((dir (make-temp-file "cleanup-branch-" t))
        (target (expand-file-name "target.o" dir)) (c (expand-file-name "caller.c" dir))
        (obj (expand-file-name "caller.o" dir)) (bin (expand-file-name "probe" dir))
        (nelisp-aot-compiler--x86-cleanup-branches (not (getenv "NELISP_CLEANUP_BRANCH_TEST_DISABLE")))
        (defs nil) (specs nil) (serial 0) (emissions 0) (ordinary-flushes 0)
        (count-edge (lambda (&rest _) (cl-incf emissions)))
        (count-flush (lambda (pairs written _saved _buf &optional private _state)
          (when (and (= (length pairs) 3) (equal (sort (mapcar #'car pairs) #'<) '(6 7 8)))
           (should (null private))
           (should (cl-every (lambda(p)(memq (car p) written)) pairs))
           (cl-incf ordinary-flushes)))))
  (dolist (op '(= /=)) (dolist (swap '(nil t)) (dolist (sense '(nil t))
   (let ((name (intern (format "vc_case_%d" serial))))
    (push (nelisp-cleanup-test--def name op swap sense) defs)
    (push (list name op swap sense nil) specs) (cl-incf serial)))))
  (push (nelisp-cleanup-test--def 'vc_word '= nil nil t) defs)
  (push '(vc_word = nil nil t) specs)
  (push (nelisp-cleanup-test--def 'vc_fault '= nil nil nil t) defs)
  (setq defs (nreverse defs) specs (nreverse specs))
  (unwind-protect
   (progn
    (advice-add 'nelisp-aot-compiler--emit-cleanup-branch-x86 :before count-edge)
    (advice-add 'nelisp-aot-compiler--emit-promotion-cleanup-x86 :before count-flush)
    (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil))
     (nelisp-aot-compile-to-object (cons 'seq defs) target))
    (with-temp-file c
     (insert "#include <stdint.h>\ntypedef uint64_t U;typedef U(*F)(U,U,U,U);static volatile U*const m=(void*)268435456;static U e[2][4],want[2],cursor,bad;\n")
     (dolist (d defs) (insert (format "extern U %s(U,U,U,U);\n" (cadr d))))
     (insert "U V_observe(U v){U*f=__builtin_frame_address(1);U j=cursor++;if(j>=2)return 99;if(f[-1]!=e[j][0]||f[-7]!=e[j][1]||f[-8]!=e[j][2]||f[-9]!=e[j][3]||v!=want[j]||m[4]!=7||((U)__builtin_frame_address(0)&15))bad=1;f[-1]^=UINT64_C(0x8000000000000000);f[-7]=UINT64_C(0xdead000000000001);f[-8]=UINT64_C(0xdead000000000002);f[-9]=UINT64_C(0xdead000000000003);m[0]+=11;m[1]^=UINT64_C(0x123456789abcdef0);m[2]-=13;m[4]=0;return v;}\n")
     (insert "static long os(long n,long a,long b,long c,long d){register long t __asm__(\"r10\")=d;long r;__asm__ volatile(\"syscall\":\"=a\"(r):\"a\"(n),\"D\"(a),\"S\"(b),\"d\"(c),\"r\"(t):\"rcx\",\"r11\",\"memory\");return r;}\n__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
     (insert "U check(F f,U x,U y,U w){register U b0 __asm__(\"rbx\")=101;register U b1 __asm__(\"r12\")=103;register U b2 __asm__(\"r13\")=107;register U b3 __asm__(\"r14\")=109;register U b4 __asm__(\"r15\")=113;U s0,s1;__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s0));__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));U v=f(x,y,0,0);__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s1));return v!=w||s0!=s1||b0!=101||b1!=103||b2!=107||b3!=109||b4!=113||bad||cursor!=2;}\nU run(void){U fail=0;register U t __asm__(\"r10\")=50;register U r8 __asm__(\"r8\")=UINT64_MAX;register U r9 __asm__(\"r9\")=0;U p;__asm__ volatile(\"syscall\":\"=a\"(p):\"a\"(9),\"D\"(UINT64_C(268435456)),\"S\"(4096),\"d\"(3),\"r\"(t),\"r\"(r8),\"r\"(r9):\"rcx\",\"r11\",\"memory\");if(p!=UINT64_C(268435456))return 90;*(unsigned char*)(p+256)=191;*(unsigned char*)(p+320)=4;\n")
     (dolist (spec specs)
      (dolist (vals (if (nth 4 spec)
                       '((1 0 1 2 3 2) (1 0 1 2 3 268435718) (1 0 1 2 3 268435776))
                     '((1 0 -90 0 7 0) (-1 0 -90 0 7 0) (1 7 0 1 2 0)
                       (1 0 -1 -9223372036854775808 9223372036854775807 0)
                       (-9223372036854775808 0 18446744073709551615 7 0 0)
                       (9223372036854775807 0 9223372036854775807 -1 85 0))))
       (let* ((x (nth 0 vals)) (y (nth 1 vals)) (ma (nth 2 vals)) (mb (nth 3 vals)) (mc (nth 4 vals))
              (word (nth 5 vals)) (ret 0))
        (insert (format "cursor=bad=0;m[4]=0;m[0]=%s;m[1]=%s;m[2]=%s;m[3]=%s;\n"
                        (nelisp-cleanup-test--c ma) (nelisp-cleanup-test--c mb) (nelisp-cleanup-test--c mc) (nelisp-cleanup-test--c word)))
        (dotimes (j 2)
         (let* ((tag (cond ((= word 2) 7) ((= word 268435718) 63) (t 4)))
                (a (nelisp-cleanup-test--u64 (+ (if (nth 4 spec) tag ma) 5)))
                (b (nelisp-cleanup-test--u64 (logxor mb 85)))
                (cc (nelisp-cleanup-test--u64 (- mc 7)))
                (r (if (> (if (>= (nelisp-cleanup-test--u64 x) (ash 1 63)) (- (nelisp-cleanup-test--u64 x) (ash 1 64)) (nelisp-cleanup-test--u64 x)) 0)
                       (nelisp-cleanup-test--u64 (* 3 (+ a b cc))) 0))
                (truth (if (eq (nth 1 spec) '=) (= r 0) (/= r 0)))
                (v (if (or truth (and (nth 3 spec) (= y 7))) 17 -19)))
          (insert (format "e[%d][0]=%s;e[%d][1]=%s;e[%d][2]=%s;e[%d][3]=%s;want[%d]=%s;\n"
                          j (nelisp-cleanup-test--c x) j (nelisp-cleanup-test--c a) j (nelisp-cleanup-test--c b) j (nelisp-cleanup-test--c cc) j (nelisp-cleanup-test--c v)))
          (setq ret (+ ret v) x (logxor x (ash 1 63))
                ma (nelisp-cleanup-test--u64 (+ ma 11)) mb (logxor mb #x123456789abcdef0) mc (nelisp-cleanup-test--u64 (- mc 13)))))
        (insert (format "fail|=check(%s,%s,%s,%s);\n" (car spec) (nelisp-cleanup-test--c (car vals)) (nelisp-cleanup-test--c y) (nelisp-cleanup-test--c ret))))))
     (insert "long pid=os(57,0,0,0,0);if(pid==0){vc_fault(1,0,0,0);os(60,99,0,0,0);}if(pid<0)return 91;int st=0;if(os(61,pid,(long)&st,0,0)!=pid)return 92;fail|=(st&127)!=11;return fail;}\n"))
    (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
    (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
    (should (equal 0 (call-process bin nil nil nil)))
    (message "V full64 GNU102 outcome observations/order/fault/WORD/returning-frame-mutation/reentry/SP/fivecallee semantics PASS before gauge")
    (should (> ordinary-flushes 0))
    (should (> emissions 0)))
   (advice-remove 'nelisp-aot-compiler--emit-cleanup-branch-x86 count-edge)
   (advice-remove 'nelisp-aot-compiler--emit-promotion-cleanup-x86 count-flush)
   (unless (getenv "NELISP_CLEANUP_BRANCH_KEEP") (delete-directory dir t)))))
