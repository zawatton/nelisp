;;; nelisp-argframe-read-fixture.el --- Native WORD/payload equivalence -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'nelisp-standalone-build)

(let* ((output (or (getenv "ARGFRAME_FIXTURE_OUTPUT")
                   (expand-file-name "../target/argframe/native-reads"
                                     (file-name-directory load-file-name))))
       (s #x3a000000) (argv (+ s 128)) (box (+ s 256))
       (integer (+ s 512)) (floating (+ s 576))
       (string (+ s 640)) (vector (+ s 704))
       (core nelisp-standalone--applyfn-core-helpers)
       (arena (cdr nelisp-standalone--arena-source))
       (m5 nelisp-standalone--applyfn-m5-helpers)
       (forms nil) (checks 0))
  (cl-labels
      ((definition (name source)
         (or (cl-find-if (lambda (form) (and (eq (car-safe form) 'defun)
                                           (eq (cadr form) name))) source)
             (error "Missing production definition %S" name)))
       (check (condition)
         (cl-incf checks)
         (push `(if ,condition 0 (setq failed (+ failed 1))) forms)))
    (dolist (spec `((1 1 0) (-7 -7 -2) (3 3 0) (7 7 0)
                    (,integer ,integer 123)
                    (,(+ floating 4) ,(+ floating 4) ,floating)
                    (,(+ string 4) ,(+ string 4) ,(logior string (ash 1 62)))
                    (,(+ vector 6) ,(+ vector 6) ,vector)
                    (,(+ s 768) ,(+ s 2050) ,(+ s 2048))
                    (,(+ s 832) ,(+ vector 6) ,vector)
                    (,(+ s 896) ,(+ s 1094) ,(+ s 1088))
                    (,(+ s 960) ,(+ s 960) ,(+ s 2048))))
      (push `(ptr-write-u64 ,argv 0 ,(car spec)) forms)
      ;; Compare the exact old production constructor/accessor chain with
      ;; the once-normalized array, including representation-changing views.
      (push `(setq oldargs (m5_fx_slot_list ,argv 1)) forms)
      (push `(ptr-write-u64 ,argv 0 (nl_word_canon (heap-read-u64 ,argv 0))) forms)
      (dolist (mode '(0 2))
        (let ((args (if (= mode 0) 'oldargs argv)))
          (check `(= (argframe_read_word ,args ,mode) ,(cadr spec)))
          (check `(= (argframe_read_payload ,args ,mode) ,(caddr spec))))))
    (check '(= (argframe_read_word 3 0) 0))
    (check `(= (argframe_read_word ,argv 1) 0))
    (let ((source
           `(seq
             ,(definition 'wf_arg_word core)
             ,(definition 'wf_argval core)
             ,(definition 'nl_word_payload arena)
             ,(definition 'nl_word_canon arena)
             ,(definition 'm5_fx_slot_list m5)
             ,(definition 'm5_fx_slot_word m5)
             (defun nl_alloc_consbox ()
               (let ((n (ptr-read-u64 ,s 16)))
                 (seq (ptr-write-u64 ,s 16 (+ n 1)) (+ ,s 4096 (* n 16)))))
             (defun nl_symview_canon (word) word)
             ;; The source accessor is tested on direct-cons and nil fixtures.
             (defun nl_cons_car_word (word)
               (if (= (logand word 7) 2) (ptr-read-u64 (- word 2) 0) 0))
             (defun nl_cons_cdr_word (word)
               (if (= (logand word 7) 2) (ptr-read-u64 (- word 2) 8) 0))
             (defun nl_string_read64 (ptr offset) (ptr-read-u64 ptr offset))
             (defun nl_string_read8 (ptr offset) (ptr-read-u8 ptr offset))
             (defun argframe_read_word (args _pad)
               ,(nelisp-argframe-lower
                 '(wf_arg_word args 0) 'args '(- _pad 1) '_pad))
             (defun argframe_read_payload (args _pad)
               ,(nelisp-argframe-lower
                 '(wf_argval args 0) 'args '(- _pad 1) '_pad))
             (defun _start ()
               (let ((failed 0) (oldargs 3))
                 (seq
                  (syscall-direct 9 ,s 1048576 3 50 -1 0)
                  (ptr-write-u64 ,box 8 3)
                  (ptr-write-u64 ,integer 0 2) (ptr-write-u64 ,integer 8 123)
                  (ptr-write-u64 ,floating 0 3) (ptr-write-u64 ,floating 8 -1)
                  (ptr-write-u64 ,string 0 5) (ptr-write-u64 ,string 8 0)
                  (ptr-write-u64 ,vector 0 8)
                  (ptr-write-u64 ,(+ s 768) 0 7)
                  (ptr-write-u64 ,(+ s 768) 8 ,(+ s 2048))
                  (ptr-write-u64 ,(+ s 832) 0 8)
                  (ptr-write-u64 ,(+ s 832) 8 ,vector)
                  (ptr-write-u64 ,(+ s 896) 0 16)
                  (ptr-write-u64 ,(+ s 896) 8 ,(+ s 1088))
                  (ptr-write-u64 ,(+ s 1088) 0 16)
                  (ptr-write-u64 ,(+ s 960) 0 7)
                  (ptr-write-u64 ,(+ s 960) 8 ,(+ s 2048))
                  (ptr-write-u64 ,(+ s 960) 16 13108)
                  ,@(nreverse forms)
                  (ptr-write-u64 ,s 0 failed)
                  (syscall-direct 1 1 ,s 8 0 0 0)
                  (syscall-direct 60 failed 0 0 0 0 0)))))))
      (nelisp-link-units output
                         (list (nelisp-standalone--compile-to-unit "argframe-reads.o" source))
                         "_start")
      (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
      (princ (format "ARGFRAME-READS-COMPILED checks=%d\n" checks)))))
