;;; nelisp-directcall-decline-native-fixture.el --- Bounded native decline probe -*- lexical-binding: t; -*-
;; Compile just the production helpers, without a full dynamic runtime build.
;; Fixture counters measure helper visits; no counters enter production code.
(require 'cl-lib)
(require 'nelisp-standalone-build)

(when-let* ((seed (getenv "REGFIX_SEED_SOURCE")))
  (with-temp-buffer
    (insert-file-contents seed)
    (goto-char (point-min))
    (re-search-forward "^(defun nelisp-standalone--directcall-defuns ()")
    (goto-char (match-beginning 0))
    (eval (read (current-buffer)) t)))

(let* ((output (or (getenv "REGFIX_FIXTURE_OUTPUT") (error "REGFIX_FIXTURE_OUTPUT is required")))
       (s #x3a000000) (fn (+ s 16386)) (tail (+ s 16402))
       (head (+ s 20006)) (name (+ s 20128)) (args (+ s 25002))
       (bc (+ s 30006)) (checks nil) (nchecks 0)
       (defs (cl-remove-if-not
              (lambda (f) (memq (cadr f) '(nl_directcall_id nl_directcall_list_words)))
              (nelisp-standalone--directcall-defuns))))
  (unless (= (length defs) 2) (error "Missing production helper"))
  (cl-labels ((check (c)
                (cl-incf nchecks)
                (push `(if ,c 0 (seq (setq failed (+ failed 1))
                                    (ptr-write-u64 ,s 64 ,nchecks)
                                    (syscall-direct 1 1 (+ ,s 64) 8 0 0 0))) checks))
              (reset (sid target builtin)
                (push `(seq (ptr-write-u64 ,s 0 0) (ptr-write-u64 ,s 8 0)
                            (ptr-write-u64 ,s 16 0) (ptr-write-u64 ,s 32 ,sid)
                            (ptr-write-u64 ,s 40 ,target)
                            (ptr-write-u64 ,s 48 ,builtin)) checks)))
    (dolist (miss '("vector" "make-vector" "make-string"))
      (reset (nelisp-standalone--sid miss) name 1)
      (push `(setq rc (nl_directcall_id ,fn ,name 1)) checks)
      (check '(= rc 0))
      (check `(= (heap-read-u64 ,s 0) 0))
      (check `(= (heap-read-u64 ,s 8) 1)))
    (reset (nelisp-standalone--sid "car") name 1)
    (push `(setq rc (nl_directcall_id ,fn ,name 1)) checks)
    (check '(= rc 1))
    (check `(= (heap-read-u64 ,s 0) 1))
    (check `(= (heap-read-u64 ,s 8) 1))
    ;; Direct bytecode, symbol resolving to bytecode, and a closure cons.
    (dolist (applyp '(0 1))
      (dolist (target (list bc name fn))
        (reset (nelisp-standalone--sid "car") target 0)
        (push `(setq rc (nl_directcall_list_words ,args 200 ,applyp)) checks)
        (check '(= rc 2))
        (check `(= (heap-read-u64 ,s 16) 0))))
    (let ((source
           `(seq
             ,@defs
             (defun nl_val_tag (w)
               (if (= w ,name) 4 (if (= w ,bc) 17 7)))
             (defun nl_sym_sid (w)
               (if (= w ,head)
                   (seq (ptr-write-u64 ,s 0 (+ (heap-read-u64 ,s 0) 1))
                        (if (= (heap-read-u64 ,s 48) 1)
                            ,(nelisp-standalone--sid "builtin") 0))
                 (seq (ptr-write-u64 ,s 8 (+ (heap-read-u64 ,s 8) 1))
                      (heap-read-u64 ,s 32))))
             (defun sexp-name-eq (w text) 1)
             (defun nl_cons_car_word (w) (heap-read-u64 ,s 40))
             (defun nelisp_env_lookup_function_w (a b c d) ,bc)
             (defun nl_sp_nargs (w)
               (seq (ptr-write-u64 ,s 16 (+ (heap-read-u64 ,s 16) 1)) 2))
             (defun wf_arg_word (a b) 3)
             (defun nl_eic_apply_list_ok (w) 1)
             (defun nl_directcall_list_values (a b c d e f) 999)
             (defun _start ()
               (let* ((failed 0) (rc 0))
                 (seq
                  (syscall-direct 9 ,s 1048576 3 50 -1 0)
                  (ptr-write-u64 ,(- fn 2) 0 ,head)
                  (ptr-write-u64 ,(- fn 2) 8 ,tail)
                  (ptr-write-u64 ,(- tail 2) 0 ,name)
                  (ptr-write-u64 ,(- tail 2) 8 3)
                  ;; sexp-name-eq is a compiler intrinsic: supply a real view.
                  (ptr-write-u64 ,name 0 4)
                  (ptr-write-u64 ,name 16 ,(+ s 20256))
                  (ptr-write-u64 ,name 24 3)
                  (ptr-write-u64 ,(+ s 20256) 0 #x726163)
                  ,@(nreverse checks)
                  (ptr-write-u64 ,s 56 failed)
                  (syscall-direct 1 1 ,s 64 0 0 0)
                  (syscall-direct 60 failed 0 0 0 0 0)))))))
      (make-directory (file-name-directory output) t)
      (nelisp-link-units output
                         (list (nelisp-standalone--compile-to-unit "decline-fixture.o" source))
                         "_start")
      (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
      (princ (format "REGFIX-NATIVE-COMPILED checked=%d\n" nchecks)))))
