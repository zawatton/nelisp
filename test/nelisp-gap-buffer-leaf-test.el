;;; nelisp-gap-buffer-leaf-test.el --- native gap buffer bodies (bufedit) -*- lexical-binding: t; -*-

;; The `nl_gb_*' bodies of lisp/nelisp-cc-fx-call-primitives.el keep the buffer text in the STORE
;; slot of the `nelisp-buffer' record: a unibyte string of little-endian 32-bit character codes
;; with the gap after BLEN characters.  This test runs the production bodies on a byte-addressed
;; memory model (a record of 16 slots, string headers laid out as the runtime lays them out) and
;; checks them against a plain Lisp model of the text, point and narrowing, on fixed cases and on
;; a seeded random walk of edits.

(require 'ert)
(require 'cl-lib)
(require 'nelisp-standalone-build)
(require 'nelisp-cc-fx-call-primitives)
(require 'nelisp-directcall-test)

(defconst nbg--base 65536)
(defvar nbg--mem nil)
(defvar nbg--next 0)
(defvar nbg--dirty 0)
(defvar nbg--delegated nil)
(defvar nbg--current 0)

(defun nbg--rd8 (a) (aref nbg--mem (- a nbg--base)))
(defun nbg--wr8 (a v) (aset nbg--mem (- a nbg--base) (logand v 255)))
(defun nbg--rd (a n signed)
  (let ((v 0))
    (dotimes (i n) (setq v (logior v (ash (nbg--rd8 (+ a i)) (* 8 i)))))
    (if (and signed (>= v (ash 1 (1- (* 8 n))))) (- v (ash 1 (* 8 n))) v)))
(defun nbg--wr (a n v)
  (dotimes (i n) (nbg--wr8 (+ a i) (logand (ash v (* -8 i)) 255))))
(defun nbg--alloc (n)
  (let ((a (+ nbg--base nbg--next)))
    (setq nbg--next (+ nbg--next (logand (+ n 15) -8) 8))
    (when (> nbg--next (length nbg--mem)) (error "model memory exhausted"))
    a))
(defun nbg--fix (n) (+ (ash n 2) 1))

(defun nbg--string-new (bytes n unibyte)
  (let* ((h (nbg--alloc 32)) (d (nbg--alloc (+ n 16))))
    (nbg--wr h 8 n)
    (nbg--wr h 8 n)
    (nbg--wr (+ h 8) 8 (if (= unibyte 1) -1 n))
    (nbg--wr (+ h 16) 8 0)
    (nbg--wr (+ h 24) 8 d)
    (unless (= bytes 0) (dotimes (i n) (nbg--wr8 (+ d i) (nbg--rd8 (+ bytes i)))))
    (+ h 4)))

(defun nbg--make-string-word (string)
  "A string word for STRING (a unibyte or multibyte Lisp string) in the model memory."
  (let* ((mb (multibyte-string-p string))
         (bytes (if mb (encode-coding-string string 'utf-8-emacs-unix) string))
         (n (length bytes))
         (d (nbg--alloc (+ n 16))) (h (nbg--alloc 32)))
    (dotimes (i n) (nbg--wr8 (+ d i) (aref bytes i)))
    (nbg--wr h 8 (length string))
    (nbg--wr (+ h 8) 8 (if mb n -1))
    (nbg--wr (+ h 16) 8 0)
    (nbg--wr (+ h 24) 8 d)
    (+ h 4)))

(defun nbg--read-string-word (w)
  "The Lisp string for the string word W."
  (let* ((h (- w 4)) (n (nbg--rd h 8 nil)) (sb (nbg--rd (+ h 8) 8 t)) (d (nbg--rd (+ h 24) 8 nil))
         (nb (if (< sb 0) n sb)) (bytes (make-string nb 0)))
    (dotimes (i nb) (aset bytes i (nbg--rd8 (+ d i))))
    (if (< sb 0) bytes (nbg--decode-internal bytes))))

(defun nbg--decode-internal (bytes)
  "The multibyte string of Emacs's internal representation BYTES (a unibyte string):
independent of the production decoder (GNU character.h STRING_CHAR)."
  (let ((i 0) (n (length bytes)) (out nil))
    (while (< i n)
      (let ((b0 (aref bytes i)))
        (cond ((< b0 128) (push b0 out) (setq i (1+ i)))
              ((< b0 194) (push (+ #x3FFF80 (* 64 (logand b0 1)) (logand (aref bytes (1+ i)) 63)) out)
               (setq i (+ i 2)))
              ((< b0 224) (push (+ (* 64 (logand b0 31)) (logand (aref bytes (1+ i)) 63)) out)
               (setq i (+ i 2)))
              ((< b0 240) (push (+ (* 4096 (logand b0 15)) (* 64 (logand (aref bytes (+ i 1)) 63))
                                   (logand (aref bytes (+ i 2)) 63)) out)
               (setq i (+ i 3)))
              ((< b0 248) (push (+ (* 262144 (logand b0 7)) (* 4096 (logand (aref bytes (+ i 1)) 63))
                                   (* 64 (logand (aref bytes (+ i 2)) 63)) (logand (aref bytes (+ i 3)) 63)) out)
               (setq i (+ i 4)))
              (t (push (+ (* 262144 (logand (aref bytes (+ i 1)) 63)) (* 4096 (logand (aref bytes (+ i 2)) 63))
                          (* 64 (logand (aref bytes (+ i 3)) 63)) (logand (aref bytes (+ i 4)) 63)) out)
                 (setq i (+ i 5))))))
    (apply #'string (nreverse out))))

(defconst nbg--host-fns
  '(nl_gb_ok nl_gb_at nl_gb_rscan nl_gb_fscan nl_gb_rfind nl_gb_ffind nl_gb_pcount nl_gb_count nl_gb_copy
    nl_gb_move nl_gb_grow nl_gb_dec nl_gb_put nl_gb_wide_p nl_gb_fast nl_gb_bol nl_gb_eol nl_gb_forward_line nl_gb_column nl_gb_enclen nl_gb_enc nl_gb_ascii_p nl_gb_pack nl_gb_usize
    nl_gb_uwrite nl_gb_substring nl_gb_insert_w nl_gb_overwrite_w nl_gb_insert_leaf nl_gb_insert_run
    nl_gb_delete_core nl_gb_delete_run nl_gb_delete_char nl_gb_insert_char nl_gb_leaf_run nl_gb_leaf_ops nl_gb_line_ops nl_gb_record nl_gb_wprim nl_gb_wprim_more
    nl_gb_bufsub_w nl_gb_slow_w nl_gb_prim_w nl_gb_wprim_w))

(defun nbg--host-form (f)
  "The host Lisp form of the DSL defun F: raw memory operations are the model's."
  (ndc--host f))

(defmacro nbg--with (&rest body)
  (declare (indent 0))
  `(let ((nbg--mem (make-vector (* 6 1024 1024) 0)) (nbg--next 0) (nbg--dirty 0)
         (nbg--delegated nil) (nbg--current 0) (saved nil))
     (dolist (f nbg--host-fns)
       (push (cons f (and (fboundp f) (symbol-function f))) saved)
       (eval (nbg--host-form (ndc--find f (cdr nelisp-cc-fx-call-primitives--source))) t))
     (unwind-protect
         (cl-letf (((symbol-function 'ptr-read-u8) (lambda (p i) (nbg--rd (+ p i) 1 nil)))
                   ((symbol-function 'ptr-read-u32) (lambda (p i) (nbg--rd (+ p i) 4 nil)))
                   ((symbol-function 'ptr-read-u64) (lambda (p i) (nbg--rd (+ p i) 8 t)))
                   ((symbol-function 'heap-read-u64) (lambda (p i) (nbg--rd (+ p i) 8 t)))
                   ((symbol-function 'ptr-write-u8) (lambda (p i v) (nbg--wr (+ p i) 1 v)))
                   ((symbol-function 'ptr-write-u16) (lambda (p i v) (nbg--wr (+ p i) 2 v)))
                   ((symbol-function 'ptr-write-u32) (lambda (p i v) (nbg--wr (+ p i) 4 v)))
                   ((symbol-function 'ptr-write-u64) (lambda (p i v) (nbg--wr (+ p i) 8 v)))
                   ((symbol-function 'wf_dirty) (lambda () (cl-incf nbg--dirty)))
                   ((symbol-function 'nl_string_new) #'nbg--string-new)
                   ((symbol-function 'nl_string_copy_bytes)
                    (lambda (src dst n)
                      (let ((tmp (make-vector n 0)))
                        (dotimes (i n) (aset tmp i (nbg--rd8 (+ src i))))
                        (dotimes (i n) (nbg--wr8 (+ dst i) (aref tmp i))))))
                   ((symbol-function 'nl_record_length) (lambda (w) (ash (nbg--rd (- w 6) 8 nil) -8)))
                   ((symbol-function 'alloc-bytes) (lambda (n _a) (nbg--alloc n)))
                   ((symbol-function 'nl_buf_delegate) (lambda (_args _env buf len) (let ((s (make-string len 0))) (dotimes (i len) (aset s i (nbg--rd8 (+ buf i)))) (push s nbg--delegated) -777)))
                   ((symbol-function 'nl_buf_current) (lambda (_env) nbg--current))
                   ((symbol-function 'm5_list_len) (lambda (args _acc) (length args)))
                   ((symbol-function 'wf_arg_word) (lambda (args n) (nth n args))))
           ,@body)
       (dolist (s saved)
         (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s)))))))

;; The record: header word 12 | 16<<8 at r, slots at r+16+8K.
(defconst nbg--slot '((store . 1) (unibyte . 2) (modified . 3) (markers . 4) (overlays . 5)
                      (ns . 6) (ne . 7) (props . 8) (tick . 10) (pend . 11) (blen . 12) (len . 13) (wide . 15)))

(defun nbg--new-buffer (&optional unibyte)
  "A fresh empty buffer record in the model; its word."
  (let* ((r (nbg--alloc 160)) (b (+ r 6)))
    (nbg--wr r 8 (+ 12 (ash 16 8)))
    (dotimes (i 16) (nbg--wr (+ r 16 (* 8 i)) 8 3))
    (nbg--setslot b 'store (nbg--make-string-word ""))
    (nbg--setslot b 'unibyte (if unibyte 7 3))
    (nbg--setslot b 'tick (nbg--fix 0))
    (nbg--setslot b 'blen (nbg--fix 0))
    (nbg--setslot b 'len (nbg--fix 0))
    b))
(defun nbg--slot-addr (b slot) (+ (- b 6) 16 (* 8 (cdr (assq slot nbg--slot)))))
(defun nbg--setslot (b slot v) (nbg--wr (nbg--slot-addr b slot) 8 v))
(defun nbg--getslot (b slot) (nbg--rd (nbg--slot-addr b slot) 8 t))
(defun nbg--fixval (w) (if (= w 3) nil (ash w -2)))

(defun nbg--call (name &rest args) (apply (symbol-function name) args))

(defun nbg--text (b)
  "The buffer text as the list of character codes, read through the model's own layout."
  (let* ((h (- (nbg--getslot b 'store) 4)) (d (nbg--rd (+ h 24) 8 nil))
         (len (ash (nbg--getslot b 'len) -2)) (blen (ash (nbg--getslot b 'blen) -2))
         (cap (/ (nbg--rd h 8 nil) 4)) (gap (- cap len)) (out nil))
    (dotimes (i len)
      (push (nbg--rd (+ d (* 4 (if (< i blen) i (+ i gap)))) 4 nil) out))
    (nreverse out)))

(defun nbg--insert (b string)
  "gb-insert STRING at the gap start of B through the production body; the count word."
  (let ((w (nbg--make-string-word string)))
    (nbg--call 'nl_gb_wprim 73 (list b w) 0)))

(defun nbg--wprim (id b &rest args)
  (nbg--call 'nl_gb_wprim id (cons b args) 0))

(ert-deftest nbg-insert-and-read ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (should (= (nbg--insert b "hello") (nbg--fix 5)))
      (should (equal (nbg--text b) (append "hello" nil)))
      (should (= (nbg--getslot b 'blen) (nbg--fix 5)))
      (should (= (nbg--getslot b 'len) (nbg--fix 5)))
      ;; move the gap to 2 and insert there: the text keeps its order
      (nbg--wprim 71 b (nbg--fix 2))
      (should (= (nbg--getslot b 'blen) (nbg--fix 2)))
      (nbg--insert b "XY")
      (should (equal (nbg--text b) (append "heXYllo" nil)))
      ;; substring across the gap, wholly before, wholly after
      (should (equal (nbg--read-string-word (nbg--wprim 75 b (nbg--fix 1) (nbg--fix 6))) "eXYll"))
      (should (equal (nbg--read-string-word (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 2))) "he"))
      (should (equal (nbg--read-string-word (nbg--wprim 75 b (nbg--fix 5) (nbg--fix 7))) "lo"))
      (should (equal (nbg--read-string-word (nbg--wprim 75 b (nbg--fix 3) (nbg--fix 3))) ""))
      ;; char reads
      (should (= (nbg--wprim 70 b (nbg--fix 0)) (nbg--fix ?h)))
      (should (= (nbg--wprim 70 b (nbg--fix 3)) (nbg--fix ?Y)))
      (should (= (nbg--wprim 70 b (nbg--fix 6)) (nbg--fix ?o))))))

(ert-deftest nbg-multibyte-and-raw-bytes ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "aé€😀z")
      (should (equal (nbg--text b) (list ?a ?é ?€ #x1F600 ?z)))
      (let ((w (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 5))))
        (should (equal (nbg--read-string-word w) "aé€😀z"))
        (should (= (nbg--rd (- w 4) 8 nil) 5))                  ; characters
        (should (> (nbg--rd (+ (- w 4) 8) 8 t) 5)))             ; multibyte, more bytes
      ;; ASCII-only slice of a buffer that holds wide text: a multibyte string (GNU's rule)
      (let ((w (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 1))))
        (should (>= (nbg--rd (+ (- w 4) 8) 8 t) 0)))
      ;; a unibyte string with high bytes is raw-byte characters in a multibyte buffer
      (let ((b2 (nbg--new-buffer)))
        (nbg--insert b2 (string-to-unibyte "a\351z"))
        (should (equal (nbg--text b2) (list ?a (+ #x3FFF00 #xE9) ?z)))
        (let ((w (nbg--wprim 75 b2 (nbg--fix 0) (nbg--fix 3))))
          (should (equal (string-to-list (nbg--read-string-word w)) (list ?a (+ #x3FFF00 #xE9) ?z)))))
      ;; a unibyte buffer keeps bytes, a multibyte string keeps its low byte
      (let ((b3 (nbg--new-buffer t)))
        (nbg--insert b3 (string-to-unibyte "a\351z"))
        (should (equal (nbg--text b3) (list ?a #xE9 ?z)))
        (nbg--insert b3 "é")
        (should (equal (nbg--text b3) (list ?a #xE9 ?z #xE9)))
        (let ((w (nbg--wprim 75 b3 (nbg--fix 0) (nbg--fix 4))))
          (should (< (nbg--rd (+ (- w 4) 8) 8 t) 0)))))))

(ert-deftest nbg-grow-keeps-text-around-the-gap ()
  (nbg--with
    (let ((b (nbg--new-buffer)) (model nil))
      (dotimes (i 40)
        (let ((s (format "<%d>" i)) (pos (min (length model) (* 3 (% i 7)))))
          (nbg--wprim 71 b (nbg--fix pos))
          (nbg--insert b s)
          (setq model (append (cl-subseq model 0 pos) (append s nil) (nthcdr pos model)))))
      (should (equal (nbg--text b) model)))))

(ert-deftest nbg-delete-and-find ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "ab\ncde\n\nfgh\nij")
      (should (= (nbg--wprim 77 b (nbg--fix 0) (nbg--fix 14)) (nbg--fix 4)))
      (should (= (nbg--wprim 77 b (nbg--fix 3) (nbg--fix 8)) (nbg--fix 2)))
      ;; gb-find-char forward and backward, over the gap and across it
      (nbg--wprim 71 b (nbg--fix 6))
      (cl-flet ((ff (c pos lim dir) (nbg--fixval (nbg--call 'nl_gb_wprim 76
                                                            (list b (nbg--fix c) (nbg--fix pos) (nbg--fix lim) (nbg--fix dir)) 0))))
        (should (= (ff 10 0 14 1) 2))
        (should (= (ff 10 3 14 1) 6))
        (should (= (ff 10 7 14 1) 7))
        (should (= (ff 10 8 14 1) 11))
        (should (= (ff 10 12 14 1) -1))
        (should (= (ff 10 14 0 -1) 11))
        (should (= (ff 10 11 0 -1) 7))
        (should (= (ff 10 2 0 -1) -1))
        (should (= (ff 10 3 0 -1) 2))
        (should (= (ff ?z 0 14 1) -1)))
      ;; delete across the gap: "ab\ncde" loses 1..9
      (nbg--wprim 74 b (nbg--fix 1) (nbg--fix 9))
      (should (equal (nbg--text b) (append "agh\nij" nil)))
      (should (= (nbg--getslot b 'blen) (nbg--fix 1)))
      (should (= (nbg--getslot b 'len) (nbg--fix 6))))))

(ert-deftest nbg-declines ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "abc")
      ;; ranges outside the text, non-fixnums, a non-buffer: declined (0)
      (should (= (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 4)) 0))
      (should (= (nbg--wprim 75 b (nbg--fix 2) (nbg--fix 1)) 0))
      (should (= (nbg--wprim 75 b (nbg--fix -1) (nbg--fix 1)) 0))
      (should (= (nbg--wprim 70 b (nbg--fix 3)) 0))
      (should (= (nbg--wprim 71 b (nbg--fix 4)) 0))
      (should (= (nbg--wprim 74 b (nbg--fix 2) (nbg--fix 9)) 0))
      (should (= (nbg--wprim 75 b 3 (nbg--fix 1)) 0))
      (should (= (nbg--call 'nl_gb_wprim 70 (list 12345 (nbg--fix 0)) 0) 0))
      (should (= (nbg--call 'nl_gb_wprim 73 (list b 3) 0) 0))
      (should (equal (nbg--text b) (append "abc" nil))))))

(defun nbg--model-op (model op)
  "MODEL is (TEXT POINT NS NE) with TEXT a list; apply OP, return the new model."
  (pcase-let ((`(,text ,pt ,ns ,ne) model))
    (pcase op
      (`(insert ,s)
       (let* ((n (length s)) (at (1- pt)))
         (list (append (cl-subseq text 0 at) (append s nil) (nthcdr at text)) (+ pt n) ns (and ne (+ ne n)))))
      (`(delete ,a ,b)
       (let* ((s (min a b)) (e (max a b)) (d (- e s)))
         (list (append (cl-subseq text 0 (1- s)) (nthcdr (1- e) text))
               (cond ((<= pt s) pt) ((>= pt e) (- pt d)) (t s))
               (and ns (cond ((<= ns s) ns) ((>= ns e) (- ns d)) (t s)))
               (and ne (cond ((<= ne s) ne) ((>= ne e) (- ne d)) (t s))))))
      (`(goto ,p) (list text (max (or ns 1) (min (or ne (1+ (length text))) p)) ns ne))
      (`(narrow ,a ,b)
       (let ((lo (min a b)) (hi (max a b)))
         (list text (max lo (min hi pt)) lo hi))))))

(defun nbg--sync-point (b pt)
  "Make PT the record's point as `nelisp-goto-char' stores it: pend nil at the gap start."
  (nbg--setslot b 'pend (if (= pt (1+ (ash (nbg--getslot b 'blen) -2))) 3 (nbg--fix pt))))

(defun nbg--leaf (id b args)
  "Run the leaf body ID on current buffer B with ARGS (words): (RC . RESULT-WORD)."
  (let* ((stk (nbg--alloc 160)) (res (nbg--alloc 16)) (k 0))
    (dolist (a args) (nbg--wr (+ stk (* 8 k)) 8 a) (setq k (1+ k)))
    (nbg--wr res 8 12345)
    (cons (nbg--call 'nl_gb_leaf_run id stk (length args) (length args) res b)
          (nbg--rd res 8 t))))

(defun nbg--random-string (rng-state)
  (let ((n (random* 6 rng-state)) (out nil))
    (dotimes (_ n)
      (push (pcase (random* 12 rng-state)
              (0 ?\n) (1 ?\n) (2 ?\t) (3 #xE9) (4 #x20AC) (5 #x1F600)
              (_ (+ ?a (random* 26 rng-state))))
            out))
    (apply #'string out)))

(defun random* (n _s) (random n))

(ert-deftest nbg-leaf-readers-and-edits-against-a-model ()
  (nbg--with
    (random "bufedit-leaf-seed")
    (let* ((b (nbg--new-buffer)) (model (list nil 1 nil nil)) (steps 0))
      (progn (setq nbg--current b)
        (dotimes (_ 400)
          (let* ((text (nth 0 model)) (len (length text)) (pt (nth 1 model))
                 (ns (nth 2 model)) (ne (nth 3 model))
                 (lo (or ns 1)) (hi (or ne (1+ len)))
                 (op (pcase (random 9)
                       (0 (list 'insert (nbg--random-string nil)))
                       (1 (list 'insert (nbg--random-string nil)))
                       (2 (let ((a (+ lo (random (1+ (- hi lo))))) (c (+ lo (random (1+ (- hi lo))))))
                            (list 'delete a c)))
                       (3 (list 'goto (+ lo (random (1+ (- hi lo))))))
                       (4 (list 'goto (+ lo (random (1+ (- hi lo))))))
                       (5 (if (< (random 4) 1) (list 'narrow (1+ (random (1+ len))) (1+ (random (1+ len)))) (list 'goto lo)))
                       (_ (list 'goto hi)))))
            (cl-incf steps)
            ;; apply to the record: edits go through the leaf bodies when they take them, else the store ops
            (pcase op
              (`(insert ,s)
               (let ((r (nbg--leaf 58 b (list (nbg--make-string-word s)))))
                 (if (= (car r) 0)
                     (should (= (cdr r) 3))
                   ;; declined (gap too small): reserve, settle the point, insert
                   (nbg--wprim 72 b (nbg--fix (length s)))
                   (let ((p (nbg--getslot b 'pend)))
                     (unless (= p 3) (nbg--wprim 71 b (nbg--fix (1- (ash p -2)))) (nbg--setslot b 'pend 3)))
                   (nbg--insert b s)
                   (nbg--setslot b 'modified 7)
                   (nbg--setslot b 'tick (+ (nbg--getslot b 'tick) 4))
                   (when ne (nbg--setslot b 'ne (nbg--fix (+ ne (length s))))))))
              (`(delete ,x ,y)
               (let ((r (nbg--leaf 61 b (list (nbg--fix x) (nbg--fix y)))))
                 (should (= (car r) 0))))
              (`(goto ,p)
               (nbg--sync-point b (max lo (min hi p))))
              (`(narrow ,x ,y)
               (let ((l (min x y)) (h (max x y)) (npt (nth 1 (nbg--model-op model op))))
                 (nbg--setslot b 'ns (nbg--fix l)) (nbg--setslot b 'ne (nbg--fix h))
                 (nbg--sync-point b npt))))
            (setq model (nbg--model-op model op))
            ;; compare the whole state
            (should (equal (nbg--text b) (nth 0 model)))
            (should (= (ash (nbg--getslot b 'len) -2) (length (nth 0 model))))
            (should (equal (nbg--fixval (nbg--getslot b 'ns)) (nth 2 model)))
            (should (equal (nbg--fixval (nbg--getslot b 'ne)) (nth 3 model)))
            ;; the point as the leaf body reads it
            (let* ((text (nth 0 model)) (len (length text)) (pt (nth 1 model))
                   (lo (or (nth 2 model) 1)) (hi (or (nth 3 model) (1+ len)))
                   (p (nbg--getslot b 'pend)))
              (should (= pt (if (= p 3) (1+ (ash (nbg--getslot b 'blen) -2)) (ash p -2))))
              ;; char-after / char-before / following / preceding
              (should (equal (nbg--leaf 50 b nil)
                             (cons 0 (if (and (>= pt lo) (< pt hi)) (nbg--fix (nth (1- pt) text)) 3))))
              (should (equal (nbg--leaf 51 b nil)
                             (cons 0 (if (and (> pt lo) (<= pt hi)) (nbg--fix (nth (- pt 2) text)) 3))))
              (let ((q (+ lo (random (1+ (- hi lo))))))
                (should (equal (nbg--leaf 50 b (list (nbg--fix q)))
                               (cons 0 (if (< q hi) (nbg--fix (nth (1- q) text)) 3)))))
              (should (equal (nbg--leaf 50 b (list (nbg--fix (+ hi 3)))) (cons 0 3)))
              (should (equal (nbg--leaf 50 b (list (nbg--fix (- lo 2)))) (cons 0 3)))
              (should (equal (nbg--leaf 52 b nil)
                             (cons 0 (if (and (>= pt lo) (< pt hi)) (nbg--fix (nth (1- pt) text)) 1))))
              (should (equal (nbg--leaf 53 b nil)
                             (cons 0 (if (and (> pt lo) (<= pt hi)) (nbg--fix (nth (- pt 2) text)) 1))))
              ;; line functions: 54 beginning, 55 end, bolp 56, eolp 57
              (let* ((bol (let ((i (- pt 2)) (r lo))
                            (when (> pt lo)
                              (while (and (>= i (1- lo)) (not (eq (nth i text) ?\n))) (setq i (1- i)))
                              (setq r (if (>= i (1- lo)) (+ i 2) lo)))
                            r))
                     (eol (let ((i (1- pt)) (r hi))
                            (when (< pt hi)
                              (while (and (<= i (- hi 2)) (not (eq (nth i text) ?\n))) (setq i (1+ i)))
                              (setq r (if (<= i (- hi 2)) (1+ i) hi)))
                            r)))
                (should (equal (nbg--leaf 54 b nil) (cons 0 (nbg--fix bol))))
                (should (equal (nbg--leaf 55 b nil) (cons 0 (nbg--fix eol))))
                (should (equal (nbg--leaf 54 b (list 3)) (cons 0 (nbg--fix bol))))
                (should (equal (nbg--leaf 55 b (list (nbg--fix 1))) (cons 0 (nbg--fix eol))))
                (should (equal (nbg--leaf 59 b nil) (cons 0 (nbg--fix bol))))
                (should (equal (nbg--leaf 60 b nil) (cons 0 (nbg--fix eol))))
                (should (equal (nbg--leaf 56 b nil) (cons 0 (if (= pt bol) 7 3))))
                (should (equal (nbg--leaf 57 b nil) (cons 0 (if (= pt eol) 7 3))))
                (should (eq (car (nbg--leaf 54 b (list (nbg--fix 2)))) -3)))))))
      (should (> steps 100)))))

(ert-deftest nbg-leaf-declines ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "abc")
      (progn (setq nbg--current b)
        ;; a marker table, overlays or text properties send insert and delete to the Lisp
        (dolist (slot '(markers overlays props))
          (nbg--setslot b slot 4097)
          (should (= (car (nbg--leaf 58 b (list (nbg--make-string-word "x")))) -3))
          (should (= (car (nbg--leaf 61 b (list (nbg--fix 1) (nbg--fix 2)))) -3))
          (nbg--setslot b slot 3))
        ;; a string with intervals, a non-string, no gap room
        (let ((w (nbg--make-string-word "x")))
          (nbg--wr (+ (- w 4) 16) 8 4097)
          (should (= (car (nbg--leaf 58 b (list w))) -3)))
        (should (= (car (nbg--leaf 58 b (list (nbg--fix 65)))) -3))
        (nbg--wprim 72 b (nbg--fix 4))
        (let* ((h (- (nbg--getslot b 'store) 4)) (cap (/ (nbg--rd h 8 nil) 4)))
          (should (= (car (nbg--leaf 58 b (list (nbg--make-string-word (make-string (- cap 3 -1) ?x))))) -3)))
        ;; an out-of-range delete, a bad argument shape
        (should (= (car (nbg--leaf 61 b (list (nbg--fix 1) (nbg--fix 9)))) -3))
        (should (= (car (nbg--leaf 61 b (list (nbg--fix 1)))) -3))
        (should (= (car (nbg--leaf 50 b (list (nbg--fix 1) (nbg--fix 2)))) -3))
        (should (= (car (nbg--leaf 52 b (list (nbg--fix 1)))) -3))
        ;; a damaged store (a gap larger than the capacity) declines everything
        (nbg--setslot b 'len (nbg--fix 100000))
        (dolist (id '(50 51 52 53 54 55 56 57))
          (should (= (car (nbg--leaf id b nil)) -3)))))))

(ert-deftest nbg-buffer-substring-builtins ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "ab\ncdé\nfgh")
      (setq nbg--current b)
      (cl-flet ((bs (id x y) (nbg--call 'nl_gb_bufsub_w id (list (nbg--fix x) (nbg--fix y)) 0)))
        (should (equal (nbg--read-string-word (bs 62 1 4)) "ab\n"))
        (should (equal (nbg--read-string-word (bs 63 4 8)) "cdé\n"))
        (should (equal (nbg--read-string-word (bs 62 8 1)) "ab\ncdé\n"))      ; either order
        (should (equal (nbg--read-string-word (bs 62 3 3)) ""))
        ;; narrowing: outside the accessible portion is the reference's
        (nbg--setslot b 'ns (nbg--fix 3)) (nbg--setslot b 'ne (nbg--fix 6))
        (setq nbg--delegated nil)
        (should (= (bs 62 1 4) -777))
        (should (equal nbg--delegated '("nelisp--buffer-substring-reference")))
        (should (equal (nbg--read-string-word (bs 62 3 6)) "\ncd"))
        (setq nbg--delegated nil)
        (should (= (bs 63 3 7) -777))
        (should (equal nbg--delegated '("nelisp--buffer-substring-no-properties-reference")))
        ;; text properties: buffer-substring declines, the no-properties form does not
        (nbg--setslot b 'ns 3) (nbg--setslot b 'ne 3)
        (nbg--setslot b 'props 4097)
        (setq nbg--delegated nil)
        (should (= (bs 62 1 4) -777))
        (should (equal (nbg--read-string-word (bs 63 1 4)) "ab\n"))))))

(ert-deftest nbg-builtin-routes ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (nbg--insert b "abc\ndef")
      (setq nbg--current b)
      (nbg--setslot b 'pend (nbg--fix 6))
      ;; a leaf id through the builtin route: the value word, and the reference when it declines
      (should (= (nbg--call 'nl_gb_prim_w 50 nil 0) (nbg--fix ?e)))
      (should (= (nbg--call 'nl_gb_prim_w 50 (list (nbg--fix 1)) 0) (nbg--fix ?a)))
      (setq nbg--delegated nil)
      (should (= (nbg--call 'nl_gb_prim_w 50 (list 40006) 0) -777))
      (should (equal nbg--delegated '("nelisp--char-after-reference")))
      ;; insert with several strings through the builtin route
      (should (= (nbg--call 'nl_gb_prim_w 58 (list (nbg--make-string-word "X") (nbg--make-string-word "YZ")) 0) 3))
      (should (equal (nbg--text b) (append "abc\ndXYZef" nil)))
      (should (= (nbg--getslot b 'pend) 3))
      (should (= (ash (nbg--getslot b 'blen) -2) 8))
      ;; the store builtins: a declined shape goes to the reference by name
      (setq nbg--delegated nil)
      (should (= (nbg--call 'nl_gb_wprim_w 75 (list b (nbg--fix 0) (nbg--fix 99)) 0) -777))
      (should (equal nbg--delegated '("nelisp--gb-substring-reference")))
      (should (equal (nbg--read-string-word (nbg--call 'nl_gb_wprim_w 75 (list b (nbg--fix 0) (nbg--fix 3)) 0)) "abc")))))

(ert-deftest nbg-wide-flag-makes-slices-multibyte ()
  (nbg--with
    (let ((b (nbg--new-buffer)))
      (setq nbg--current b)
      (nbg--insert b "plain ascii")
      (should (= (nbg--getslot b 'wide) 3))
      (should (< (nbg--rd (+ (- (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 3)) 4) 8) 8 t) 0))
      ;; multibyte text beyond ASCII sets the flag through the store insert ...
      (nbg--insert b "é")
      (should (= (nbg--getslot b 'wide) 7))
      ;; ... after which even an ASCII slice is a multibyte string, as GNU's are
      (should (>= (nbg--rd (+ (- (nbg--wprim 75 b (nbg--fix 0) (nbg--fix 3)) 4) 8) 8 t) 0))
      ;; the leaf insert sets it too, a unibyte buffer never does
      (let ((b2 (nbg--new-buffer)))
        (setq nbg--current b2)
        (nbg--leaf 58 b2 (list (nbg--make-string-word "x")))   ; declined: no gap yet
        (nbg--wprim 72 b2 (nbg--fix 8))
        (should (= (car (nbg--leaf 58 b2 (list (nbg--make-string-word "日本")))) 0))
        (should (= (nbg--getslot b2 'wide) 7)))
      (let ((b3 (nbg--new-buffer t)))
        (nbg--insert b3 "日本")
        (should (= (nbg--getslot b3 'wide) 3))))))

(ert-deftest nbg-eight-wide-scans-against-a-model ()
  (nbg--with
    (random "bufedit-scan-seed")
    (dotimes (round 60)
      (let* ((b (nbg--new-buffer)) (n (+ 5 (random 700))) (dens (nth (random 5) '(1 3 8 40 400)))
             (text (let (l) (dotimes (_ n) (push (if (= (random dens) 0) ?\n (+ ?a (random 5))) l)) (nreverse l)))
             (s (apply #'string text)))
        (nbg--insert b s)
        (nbg--wprim 71 b (nbg--fix (random (1+ n))))
        (should (equal (nbg--text b) text))
        (dotimes (_ 25)
          (let* ((c (nth (random 3) (list 10 ?a ?z))) (pos (random (1+ n))) (lim (random (1+ n))) (dir (if (= 0 (random 2)) 1 -1))
                 (want (if (> dir 0)
                           (let ((j pos) (r -1)) (while (and (< j lim) (= r -1)) (if (eq (nth j text) c) (setq r j) (setq j (1+ j)))) r)
                         (let ((j (1- pos)) (r -1)) (while (and (>= j lim) (= r -1)) (if (eq (nth j text) c) (setq r j) (setq j (1- j)))) r))))
            (should (= (nbg--fixval (nbg--call 'nl_gb_wprim 76
                                               (list b (nbg--fix c) (nbg--fix pos) (nbg--fix lim) (nbg--fix dir)) 0))
                       want))))
        (dotimes (_ 10)
          (let* ((a (random (1+ n))) (z (+ a (random (1+ (- n a))))))
            (should (= (nbg--fixval (nbg--wprim 77 b (nbg--fix a) (nbg--fix z)))
                       (cl-count ?\n (cl-subseq text a z))))))))))

;; GNU Emacs is the oracle for the line functions: the same text, narrowing and point in a real buffer.
(ert-deftest nbg-line-functions-against-gnu-emacs ()
  (nbg--with
    (random "bufedit-gnu-seed")
    (dotimes (round 80)
      (let* ((n (random 220)) (dens (nth (random 4) '(1 3 6 30)))
             (chars (let (l) (dotimes (_ n) (push (cond ((= (random dens) 0) ?\n) ((= (random 12) 0) ?\t) (t (+ ?a (random 5)))) l)) (nreverse l)))
             (s (apply #'string chars))
             (b (nbg--new-buffer)))
        (nbg--insert b s)
        (nbg--wprim 71 b (nbg--fix (random (1+ n))))
        (setq nbg--current b)
        (dotimes (_ 12)
          (let* ((narrow (= 0 (random 3)))
                 (lo (if narrow (1+ (random (1+ n))) 1)) (hi (if narrow (+ lo (random (- (+ n 2) lo))) (1+ n)))
                 (pt (+ lo (random (1+ (- hi lo))))))
            (nbg--setslot b 'ns (if narrow (nbg--fix lo) 3))
            (nbg--setslot b 'ne (if narrow (nbg--fix hi) 3))
            (nbg--sync-point b pt)
            (with-temp-buffer
              (insert s)
              (when narrow (narrow-to-region lo hi))
              (goto-char pt)
              (let ((width (nth (random 3) '(8 4 3))))
                (setq-local tab-width width)
                ;; line positions and predicates
                (should (equal (cdr (nbg--leaf 54 b nil)) (nbg--fix (line-beginning-position))))
                (should (equal (cdr (nbg--leaf 55 b nil)) (nbg--fix (line-end-position))))
                (should (equal (cdr (nbg--leaf 56 b nil)) (if (bolp) 7 3)))
                (should (equal (cdr (nbg--leaf 57 b nil)) (if (eolp) 7 3)))
                ;; the column and the line count of the accessible part
                (should (= (nbg--fixval (nbg--wprim 80 b (nbg--fix width))) (current-column)))
                (let* ((a (+ lo (random (1+ (- hi lo))))) (z (+ lo (random (1+ (- hi lo)))))
                       (l1 (min a z)) (h1 (max a z)))
                  (should (= (nbg--fixval (nbg--wprim 79 b (nbg--fix l1) (nbg--fix h1))) (count-lines l1 h1))))
                ;; forward-line by several counts: the value and the new point
                (dolist (k (list 0 1 2 -1 -2 7 -7 (1+ (random 5)) (- (random 5))))
                  (nbg--setslot b 'pend (if (= pt (1+ (ash (nbg--getslot b 'blen) -2))) 3 (nbg--fix pt)))
                  (goto-char pt)
                  (let* ((want (forward-line k)) (wpt (point))
                         (r (nbg--leaf 64 b (list (nbg--fix k))))
                         (p (nbg--getslot b 'pend)))
                    (should (= (car r) 0))
                    (unless (= (cdr r) (nbg--fix want)) (message "MISMATCH k=%S text=%S narrow=%S lo=%S hi=%S pt=%S gnu=%S/%S nl=%S" k s narrow lo hi pt want wpt (ash (cdr r) -2)))
                    (should (= (cdr r) (nbg--fix want)))
                    (should (= wpt (if (= p 3) (1+ (ash (nbg--getslot b 'blen) -2)) (ash p -2)))))
                  (nbg--sync-point b pt)))))))))
  )

;; GNU Emacs as the oracle for edits: the same random operations on a real buffer and on the model.
(ert-deftest nbg-edits-against-gnu-emacs ()
  (nbg--with
    (random "bufedit-edit-seed")
    (dotimes (round 40)
      (let* ((b (nbg--new-buffer)) (gb (generate-new-buffer " nbg-gnu")))
        (setq nbg--current b)
        (unwind-protect
            (dotimes (_ 60)
              (let* ((len (ash (nbg--getslot b 'len) -2))
                     (ns (nbg--fixval (nbg--getslot b 'ns))) (ne (nbg--fixval (nbg--getslot b 'ne)))
                     (lo (or ns 1)) (hi (or ne (1+ len)))
                     (pt (let ((p (nbg--getslot b 'pend))) (if (= p 3) (1+ (ash (nbg--getslot b 'blen) -2)) (ash p -2))))
                     (op (random 8)))
                (with-current-buffer gb
                  (widen)
                  (when ns (narrow-to-region ns ne))
                  (goto-char pt)
                  (pcase op
                    ((or 0 1)
                     (let ((s (nbg--random-string nil)))
                       (let ((r (nbg--leaf 58 b (list (nbg--make-string-word s)))))
                         (unless (= (car r) 0)
                           (nbg--wprim 72 b (nbg--fix (length s)))
                           (let ((p (nbg--getslot b 'pend)))
                             (unless (= p 3) (nbg--wprim 71 b (nbg--fix (1- (ash p -2)))) (nbg--setslot b 'pend 3)))
                           (nbg--insert b s)
                           (nbg--setslot b 'modified 7)
                           (when ne (nbg--setslot b 'ne (nbg--fix (+ ne (length s)))))))
                       (insert s)))
                    (2
                     (let* ((c (nth (random 5) (list ?x ?\n ?\t #xE9 #x1F600))) (k (nth (random 5) (list 0 1 2 5 -3))))
                       (let ((r (nbg--leaf 65 b (list (nbg--fix c) (nbg--fix k)))))
                         (unless (= (car r) 0)
                           (when (> k 0)
                             (nbg--wprim 72 b (nbg--fix k))
                             (let ((p (nbg--getslot b 'pend)))
                               (unless (= p 3) (nbg--wprim 71 b (nbg--fix (1- (ash p -2)))) (nbg--setslot b 'pend 3)))
                             (nbg--insert b (make-string k c))
                             (nbg--setslot b 'modified 7)
                             (when ne (nbg--setslot b 'ne (nbg--fix (+ ne k)))))))
                       (insert-char c k)))
                    ((or 3 4)
                     (let* ((a (+ lo (random (1+ (- hi lo))))) (z (+ lo (random (1+ (- hi lo))))))
                       (let ((r (nbg--leaf 61 b (list (nbg--fix a) (nbg--fix z)))))
                         (should (= (car r) 0)))
                       (delete-region a z)))
                    (5
                     (let* ((n (- (random 9) 4))
                            (err (condition-case nil (progn (delete-char n) nil) (error t)))
                            (r (nbg--leaf 66 b (list (nbg--fix n)))))
                       (if err
                           (should (= (car r) -3))
                         (should (= (car r) 0)))))
                    (6
                     (let ((p (+ lo (random (1+ (- hi lo))))))
                       (nbg--sync-point b p) (goto-char p)))
                    (_
                     (if (= 0 (random 3))
                         (let* ((a (1+ (random (1+ len)))) (z (1+ (random (1+ len)))))
                           (nbg--setslot b 'ns (nbg--fix (min a z))) (nbg--setslot b 'ne (nbg--fix (max a z)))
                           (narrow-to-region (min a z) (max a z))
                           (nbg--sync-point b (point)))
                       (nbg--setslot b 'ns 3) (nbg--setslot b 'ne 3) (widen))))
                  ;; the whole state agrees with GNU
                  (let ((want (append (save-restriction (widen) (buffer-substring-no-properties 1 (1+ (buffer-size)))) nil)))
                    (should (equal (nbg--text b) want)))
                  (let ((p (nbg--getslot b 'pend)))
                    (should (= (point) (if (= p 3) (1+ (ash (nbg--getslot b 'blen) -2)) (ash p -2)))))
                  (should (= (or (nbg--fixval (nbg--getslot b 'ns)) 1) (point-min)))
                  (should (= (or (nbg--fixval (nbg--getslot b 'ne)) (1+ (ash (nbg--getslot b 'len) -2))) (point-max)))))
              )
          (kill-buffer gb))))))

