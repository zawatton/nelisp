     (should (= 0 (nl_n4_view_visible env nested link 0 10120)))
     (should (= 0 (nl_n4_view_visible env nested link 0 10136)))
     (puthash (+ aux 96) 17 mem)
     (should (= 1 (nl_n4_view_visible env nested link 0 10152)))
     (aset (gethash view objects) 2 999999)
