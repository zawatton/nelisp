     (should (= 0 (nl_n4_view_visible env view link 0 10104))))))
(defun n4-cut-test--read-definition (source name)
  (with-temp-buffer
    (insert-file-contents source) (goto-char (point-min))
    (search-forward (concat "(defun " (symbol-name name) " "))
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun n4-cut-test--old-definition (name)
  (let* ((root (or (getenv "N4_CUT_SEED")
                   (expand-file-name "../../seed/" (file-name-directory n4-cut-test--source))))
         (source (expand-file-name "scripts/nelisp-standalone-build.el" root)))
    (n4-cut-test--read-definition source name)))
(defun n4-cut-test--bad-source ()
  "Resolve the authentic rejected builder independently of checkout location."
  (let ((path (expand-file-name
               (or (getenv "N4_CUT_BAD_SOURCE")
                   (expand-file-name "../../out/before-migration-correction/builder177683.el"
                                     (file-name-directory n4-cut-test--source))))))
    (unless (file-readable-p path) (error "Rejected N4 source missing: %s" path))
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally path)
      (unless (equal (secure-hash 'sha256 (current-buffer))
                     "177683e1a425678426ca1ccad1310e4e51c29ccca300f7be83be0e680a36fb4f")
        (error "Rejected N4 source identity mismatch")))
    (file-truename path)))
(defun n4-cut-test--migration (version)
  "Execute the genuine parent schedule and conversion body with raw primitives."
  (n4-cut-test--model
   (let* ((mirror 5) (scratch 70000) (name 6006) (cell (+ scratch 32))
          (event (wf_bytecode_w_cons2 name 1))
          (head (wf_bytecode_w_cons2 event 3))
          (view 42006) (selected 51006)
          (tag (symbol-function 'nl_val_tag)) saved-migration)
     (puthash (+ aux 8) head mem)
     (puthash selected (vector 3 1 3) objects)
     (puthash view (vector selected (+ (* aux 4) 1) head 3) objects)
     (aset (gethash owner objects) 3 view)
     (cl-letf (((symbol-function 'nl_val_tag)
                (lambda (w) (cond ((= w name) 4) ((= w cell) 11) (t (funcall tag w)))))
               ((symbol-function 'alloc-bytes) (lambda (&rest _) scratch))
               ((symbol-function 'nl_frame_stack_promote_env) (lambda (&rest _) 0))
               ((symbol-function 'nl_thread_registry_find) (lambda (_) 0))
               ((symbol-function 'nelisp_env_lkv_mirror)
                (lambda (e sym out _) (should (= e env)) (should (= sym name))
                  (puthash out mirror mem) 0))
               ((symbol-function 'cell-make)
                (lambda (value out) (should (= out cell)) (puthash out (gethash value mem) mem) 0))
               ((symbol-function 'vector-make)
                (lambda (n out) (puthash out (make-vector n 3) objects) 0))
               ((symbol-function 'nl_sb_set)
                (lambda (e sym value) (should (= e env)) (should (= sym name)) (setq mirror value) 0))
               ((symbol-function 'cons-set-car) (lambda (p value) (setcar (gethash p objects) value)))
               ((symbol-function 'cons-set-cdr) (lambda (p value) (setcdr (gethash p objects) value)))
               ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2))))
       (unwind-protect
           (progn
             (dolist (n '(wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events nl_thread_lean_depth
                           nl_thread_unshallow_lean_one nl_thread_unshallow_lean_at nl_thread_parent_unshallow))
               (push (cons n (and (fboundp n) (symbol-function n))) saved-migration)
               (let ((f (if (eq n 'nl_thread_unshallow_lean_at)
                            (pcase version
                              ('seed (n4-cut-test--old-definition n))
                              ('bad (n4-cut-test--read-definition
                                     (n4-cut-test--bad-source) n))
                              (_ (n4-cut-test--definition n)))
                          (n4-cut-test--definition n))))
                 (when (and (eq version 'seed) (eq n 'nl_thread_unshallow_lean_at))
                   ;; ABI-only adaptation of the genuine pre-Env seed body.
                   (setq f (cl-subst '(nl_thread_lean_depth penv link) '(nl_thread_lean_depth link) f :test #'equal))
                   (setq f (cl-subst '(wf_bytecode_w_link_events penv link) '(wf_bytecode_w_link_events link) f :test #'equal)))
                 (fset n (eval (cons 'lambda (cddr (sst--host-form f))) t))))
             (nl_thread_parent_unshallow env)
             (list mirror (nl_val_tag (nl_cons_car_word event)) (gethash (+ env 168) mem)
                   (gethash cell mem)))
         (dolist (entry saved-migration)
           (if (cdr entry) (fset (car entry) (cdr entry)) (fmakunbound (car entry)))))))))
(ert-deftest n4-cut-suspended-shallow-record-still-migrates ()
  (should (equal '(1 11 1 5) (n4-cut-test--migration 'seed)))
  (should (equal '(5 4 1 nil) (n4-cut-test--migration 'bad)))
  (should-error (should (equal '(1 11 1 5) (n4-cut-test--migration 'bad))) :type 'ert-test-failed)
  (should (equal '(1 11 1 5) (n4-cut-test--migration 'current)))
  (dolist (n '(nl_thread_unshallow_lean_at nl_thread_lean_depth wf_bytecode_w_aux_spill))
    (should-not (sst--find (n4-cut-test--definition n)
                          (lambda (node) (eq (car-safe node) 'nl_n4_binding_visible))))))
(ert-deftest n4-cut-image-root-copy-strips-only-private-export-metadata ()
  (n4-cut-test--model
   (let* ((backing 62006) (view 42006) (raw-cut (+ (* (+ aux 120) 4) 1))
          (snapshot (eval (cons 'lambda (cddr (sst--host-form (n4-cut-test--definition 'nl_frame_stack_snapshot_w)))) t))
          (choose (eval (cons 'lambda (cddr (sst--host-form (n4-cut-test--definition 'nl_frame_stack_image_word)))) t))
          allocation-shapes)
     (puthash backing (vector 111 222 333 444) objects)
     (puthash view (vector 51006 raw-cut raw-cut 3) objects)
     (aset (gethash owner objects) 0 backing)
     (aset (gethash owner objects) 1 9)
     (aset (gethash owner objects) 3 view)
     (puthash (+ env 40) (- owner 6) mem)
     (let ((before (copy-sequence (gethash owner objects))))
       (cl-letf (((symbol-function 'nl_frame_stack_snapshot_w) snapshot)
                 ((symbol-function 'nl_frame_stack_promote_owner) (lambda (&rest _) 0))
                 ((symbol-function 'nl_alloc_vector) (lambda (n) (push (list 'vector n) allocation-shapes) 70000))
                 ((symbol-function 'nl_alloc_record) (lambda (type n) (should (= type 9990)) (push (list 'record n) allocation-shapes) 71000))
                 ((symbol-function 'nl_record_type_word) (lambda (_) 9990)))
         (let* ((copy (funcall choose env))
                (bad (n4-cut-test--read-definition
                      (n4-cut-test--bad-source)
                      'bf_arena_dump_image_stream_w))
                (old-binding (sst--find bad (lambda (x) (and (eq (car-safe x) 'fbox) (= (length x) 2))))))
           ;; Execute the genuine rejected dumper's actual fbox selection.
           (should (= (- owner 6) (eval `(let ((env ,env)) ,(sst--host-form (cadr old-binding))) t)))
           (should (= view (aref (gethash owner objects) 3)))
           (should (= raw-cut (aref (gethash view objects) 1)))
           (should (= copy 71006))
           (should (equal allocation-shapes '((record 2) (vector 2))))
           (should (= 70006 (gethash 71016 mem)))
           (should (= 9 (gethash 71024 mem)))
           (should (= 111 (gethash 70008 mem))) (should (= 222 (gethash 70016 mem)))
           (should-not (gethash 71032 mem)) (should-not (gethash 71040 mem))
           (should (equal before (gethash owner objects))))
         ;; Ordinary3-slot stack retains original identity and allocates nothing.
         (puthash (+ env 32) (vector backing 9 3) objects)
         (setq allocation-shapes nil)
         (should (= owner (funcall choose env)))
         (should-not allocation-shapes))))))
