(ert-deftest n4-cut-replacement-exit-restores-owner-before-root-release ()
  (n4-cut-test--model
   (let ((finish (eval (cons 'lambda (cddr (sst--host-form (n4-cut-test--definition 'nl_n4_eval_finish)))) t))
         (expected (vector 3 1 3)) (saved-owner 7000) log)
     (cl-letf (((symbol-function 'nl_frame_stack_retire_env) (lambda (&rest _) (push 'retire log)))
               ((symbol-function 'nl_sexp_clone_into)
                (lambda (src dst) (should (= src saved-owner)) (should (= dst (+ env 32)))
                  (puthash dst expected objects) (push 'restore log)))
               ((symbol-function 'nl_cons_root_finish)
                (lambda (_env _mark rc)
                  (should (eq expected (gethash (+ env 32) objects)))
                  (push 'release log) rc)))
       (dolist (status '(0 1 -1))
         (setq log nil)
         (should (= status (funcall finish status env saved-owner 0 123)))
         (should (equal (reverse log) '(retire restore release))))))))
(ert-deftest n4-cut-n4-field-root-and-scope-structure ()
  (dolist (name '(nl_n4_push nl_n4_push_words nl_n4_push_words_cold))
    (should (sst--find (n4-cut-test--definition name)
                      (lambda (x) (equal x '(ptr-write-u64 frame 56 (nl_n4_cut_capture env)))))))
  (should (sst--find (n4-cut-test--definition 'nl_n4_mark_env)
                    (lambda (x) (equal x '(nl_gc_mark_word (heap-read-u64 frame 56))))))
  (should (sst--find (n4-cut-test--definition 'nl_n4_rewrite_env)
                    (lambda (x) (equal x '(nl_compact_rw_word (nl_compact_rw_word_edge (+ frame 56)))))))
  (dolist (name '(nl_n4_frame_eval_w nl_n4_frame_eval))
    (should (sst--find (n4-cut-test--definition name) (lambda (x) (equal x '(record-make type 4 fresh)))))
    (should (sst--find (n4-cut-test--definition name) (lambda (x) (equal x '(record-slot-set fresh 3 view)))))))
(provide 'nelisp-n4-cut-test)
