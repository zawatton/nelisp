   (let ((empty (nl_n4_cut_capture env)))
     (should (= empty (+ (* aux 4) 1)))
     (puthash 10096 9 mem)
     (let ((cut (+ (* (+ aux 120) 4) 1)))
       (should (= 1 (nl_n4_cut_prefix env cut link 0 10104)))
       (should (= 0 (nl_n4_cut_prefix env cut link 0 10120)))
       (should (= 0 (nl_n4_cut_prefix env empty link 0 10104)))
       (should (= -1 (nl_n4_cut_prefix env (+ cut 4) link 0 10104)))
       (should (= -1 (nl_n4_cut_prefix 2000 cut link 0 10104)))))))
(ert-deftest n4-cut-spill-rebases-exact-24-and-25-boundaries ()
  (n4-cut-test--model
   (puthash state 25 mem)
   (dotimes (i 25)
     (let ((frame (+ state 64 (* i 64))))
       (puthash (+ frame 40) owner mem)
       (puthash (+ frame 56) (+ (* (+ aux 104 (* i 16)) 4) 1) mem)))
   (dotimes (i 24) (puthash (+ aux 104 (* i 16)) 1 mem)
     (puthash (+ aux 112 (* i 16)) 3 mem))
   (puthash (+ aux 96) 97 mem)
   (wf_bytecode_w_aux_spill env aux)
   (should (= (gethash (+ aux 96) mem) 1))
   (should (= (gethash (+ state 64 56) mem) (+ (* aux 4) 1)))
   (let ((cursor (gethash (+ aux 8) mem)))
     (cl-loop for i downfrom 24 to 1 do
              (should (= cursor (gethash (+ state 64 (* i 64) 56) mem)))
              (setq cursor (nl_cons_cdr_word cursor)))
     (should (= cursor 3)))
   ;; The25th record reuses a cleared pair; old cuts still name outer tails.
   (let ((old (gethash (+ state 64 (* 24 64) 56) mem)))
     (puthash (+ aux 96) 5 mem) (puthash (+ aux 104) 1 mem)
     (puthash (+ aux 112) 3 mem) (wf_bytecode_w_aux_spill env aux)
     (should (= old (gethash (+ state 64 (* 24 64) 56) mem))))))
(ert-deftest n4-cut-nested-view-prefix-and-extensions ()
