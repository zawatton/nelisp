;;; nelisp-n4-cut-test.el --- Exact binding cut contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defconst n4-cut-test--source
  (expand-file-name "../scripts/nelisp-standalone-build.el"
                    (file-name-directory (or load-file-name buffer-file-name))))
(defconst n4-cut-test--seams
  '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds
    wf_bytecode_w_link_events m5_fx_general_event nl_thread_lean_depth))
(defun n4-cut-test--forms ()
  "Read syntax without evaluating the builder or expanding its templates."
  (with-temp-buffer
    (insert-file-contents n4-cut-test--source)
    (goto-char (point-min))
    (let (forms)
      (condition-case nil (while t (push (read (current-buffer)) forms))
        (end-of-file nil))
      forms)))
(defun n4-cut-test--check-arity (forms)
  "Check the finite production seam inventory, including quoted DSL syntax."
  (let ((todo forms) (definitions (make-hash-table)) (calls (make-hash-table)))
    (while todo
      (let ((form (pop todo)))
        (when (consp form)
          (cond
           ((eq (car form) 'defun)
            (when (memq (cadr form) n4-cut-test--seams)
              (puthash (cadr form) (caddr form) definitions))
            (setq todo (append (cdddr form) todo)))
           ((memq (car form) n4-cut-test--seams)
            (unless (= (length (cdr form)) 2)
              (error "Wrong production seam arity: %S" form))
            (unless (memq (cadr form) '(env penv))
              (error "Missing explicit owning Env: %S" form))
            (puthash (car form) (1+ (gethash (car form) calls 0)) calls)
            (setq todo (append (cdr form) todo)))
           (t (push (car form) todo) (push (cdr form) todo))))))
    (dolist (name n4-cut-test--seams)
      (unless (equal (gethash name definitions)
                     (if (memq name '(wf_bytecode_w_link_events nl_thread_lean_depth))
                         '(env link) '(env aux)))
        (error "Wrong production seam definition: %S" name))
      (unless (> (gethash name calls 0) 0) (error "Uncalled seam %S" name)))
    calls))
(ert-deftest n4-cut-explicit-env-seam-arity ()
  (let ((calls (n4-cut-test--check-arity (n4-cut-test--forms))))
    (should (= (gethash 'wf_bytecode_w_aux_spill calls) 5))
    (should (= (gethash 'wf_bytecode_w_aux_unwinds calls) 4))
    (should (= (gethash 'wf_bytecode_w_link_events calls) 3))
    (should (= (gethash 'm5_fx_general_event calls) 1))
    (should (= (gethash 'nl_thread_lean_depth calls) 1))))
(ert-deftest n4-cut-explicit-env-mutants-rejected ()
  (let ((forms (n4-cut-test--forms)))
    (should-error (n4-cut-test--check-arity
                   (cons '(wf_bytecode_w_aux_spill aux) forms)))
    (should-error (n4-cut-test--check-arity
                   (cons '(wf_bytecode_w_link_events wrong-owner link) forms)))))
(require 'nelisp-bytecode-stackset-fast-test)
(defvar n4-cut-test--definitions nil)
(defun n4-cut-test--definition (name)
  (unless n4-cut-test--definitions
    (setq n4-cut-test--definitions (make-hash-table))
    (let ((todo (n4-cut-test--forms)))
      (while todo
        (let ((node (pop todo)))
          (when (consp node)
            (if (eq (car node) 'defun)
                (puthash (cadr node) node n4-cut-test--definitions)
              (push (car node) todo) (push (cdr node) todo)))))))
  (or (gethash name n4-cut-test--definitions) (error "Missing production helper %S" name)))
(defmacro n4-cut-test--model (&rest body)
  "Run genuine generated bodies, adapting only raw memory/object primitives."
  `(let ((mem (make-hash-table :test #'eql)) (objects (make-hash-table :test #'eql))
         (next 30002) (env 1000) (state 8000) (link 9000) (aux 10000)
         (owner 2006) saved)
     (puthash 1176 state mem) (puthash 8000 0 mem) (puthash 8016 link mem)
     (puthash 9008 0 mem) (puthash 9016 10008 mem) (puthash 9024 0 mem)
     (puthash 10008 3 mem) (puthash 10096 1 mem)
     (puthash owner (vector 3 1 3 3) objects)
     (puthash 1032 (gethash owner objects) objects)
     (cl-letf (((symbol-function 'heap-read-u64) (lambda (p o) (gethash (+ p o) mem 0)))
               ((symbol-function 'ptr-read-u64) (lambda (p o) (gethash (+ p o) mem 0)))
               ((symbol-function 'ptr-write-u64) (lambda (p o v) (puthash (+ p o) v mem)))
               ((symbol-function 'nl_val_tag)
                (lambda (w) (cond ((= w 3) 0) ((consp (gethash w objects)) 7)
                                  ((vectorp (gethash w objects)) 8) (t 2))))
               ((symbol-function 'nl_cons_car_word) (lambda (w) (car (gethash w objects))))
               ((symbol-function 'nl_cons_cdr_word) (lambda (w) (cdr (gethash w objects))))
               ((symbol-function 'record-slot-count) (lambda (w) (length (gethash w objects))))
               ((symbol-function 'nl_record_slot_word) (lambda (w i) (aref (gethash w objects) i)))
               ((symbol-function 'nl_vector_slot_word) (lambda (w i) (aref (gethash w objects) i)))
               ((symbol-function 'vector-len) (lambda (w) (length (gethash w objects))))
               ((symbol-function 'vector-slot-set) (lambda (w i v) (aset (gethash w objects) i v)))
               ((symbol-function 'wf_bytecode_w_cons2)
                (lambda (a d) (setq next (+ next 8)) (puthash next (cons a d) objects) next)))
       (unwind-protect
           (progn
             (dolist (name '(nl_n4_record nl_n4_cut_capture nl_n4_owner_view
                             nl_n4_cut_rebase_word nl_n4_cut_rebase_view nl_n4_cut_rebase
                             nl_n4_cut_owner nl_n4_cut_prefix nl_n4_view_visible
                             nl_n4_binding_visible wf_bytecode_w_aux_spill
                             nl_sb_aux_default_bound_here nl_sb_saved_default_match))
               (push (cons name (and (fboundp name) (symbol-function name))) saved)
               (fset name (eval (cons 'lambda (cddr (sst--host-form (n4-cut-test--definition name)))) t)))
             ,@body)
         (dolist (entry saved)
           (if (cdr entry) (fset (car entry) (cdr entry)) (fmakunbound (car entry))))))))
(ert-deftest n4-cut-equal-depth-array-and-empty-owner ()
