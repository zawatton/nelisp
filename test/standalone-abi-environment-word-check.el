;;; standalone-abi-environment-word-check.el --- Environment WORD producers -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(let ((checks 0))
  (dolist (value (list nil t 0 -7 "environment" '(a . b) [nil t -7]
                       (make-symbol "environment-symbol") (make-bool-vector 9 t)))
    (let ((name (intern (format "abi-environment-default-%d" checks)))
          (alias (intern (format "abi-environment-alias-%d" checks)))
          (constant (intern (format "abi-environment-constant-%d" checks))))
      (unless (eq (eval (list 'defvar name (list 'quote value)) t) name)
        (error "defvar result identity changed"))
      (unless (eq (symbol-value name) value) (error "default value changed"))
      (unless (eq (defvaralias alias name) name) (error "alias result changed"))
      (unless (eq (symbol-value alias) value) (error "alias value changed"))
      (unless (eq (makunbound name) name) (error "makunbound result changed"))
      (when (boundp name) (error "makunbound left name bound"))
      (unless (eq (eval (list 'defvar name (list 'quote value)) t) name)
        (error "default reinitialization result changed"))
      (unless (eq (symbol-value name) value) (error "default reinitialization changed"))
      (unless (eq (eval (list 'defconst constant (list 'quote value)) t) constant)
        (error "defconst result changed"))
      (unless (eq (symbol-value constant) value) (error "constant value changed"))
      (garbage-collect)
      (unless (eq (symbol-value alias) value) (error "alias lost value at GC"))
      (setq checks (+ checks 11))))
  (unless (eq (condition-case nil (symbol-value 'abi-environment-missing)
                (void-variable 'missing)) 'missing)
    (error "missing lookup did not signal void-variable"))
  (when (boundp 'abi-environment-missing) (error "miss became a binding"))
  (setq checks (+ checks 2))
  (unless (equal (eval '(list (defvar nil) (defvar t)) t) '(nil t))
    (error "immediate declaration result changed"))
  (setq checks (+ checks 1))
  (princ (format "ABI-ENVIRONMENT-WORD checks=%d PASS\n" checks)))
