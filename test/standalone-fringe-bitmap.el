;;; standalone-fringe-bitmap.el --- Actual terminal fallback probe -*- lexical-binding: t; -*-
(defvar nelisp-fringe-probe-state '(preserved terminal))
(defvar nelisp-fringe-probe-before nil)
(condition-case failure
    (define-fringe-bitmap 'test [0 1] 2 8 '(center t))
  (void-function (setq nelisp-fringe-probe-before (car failure))))
(unless (eq nelisp-fringe-probe-before 'void-function)
  (error "Expected original fringe bitmap void-function"))
(princ "FRINGE-BITMAP-BEFORE void-function\n")
(load (expand-file-name "nelisp-stdlib-terminal-output.el"
                        (or (getenv "NELISP_FRINGE_BASE_PROVIDER_ROOT") "lisp")) nil nil t)
(load "lisp/nelisp-stdlib-fringe-bitmap.el" nil nil t)
(unless (eq 'installed (nelisp-stdlib-fringe-bitmap-install (getenv "NELISP_GNU_BUILD_SOURCE_ROOT")))
  (error "Expected new fringe fallback installation"))
(unless (and (equal nelisp-fringe-probe-state '(preserved terminal))
             (equal (nth 3 nelisp-stdlib-fringe-bitmap--form)
                    (define-fringe-bitmap 'test [0 1] 2 8 '(center t)))
             (equal (nth 3 nelisp-stdlib-fringe-bitmap--form)
                    (define-fringe-bitmap nil nil))
             (null (selected-frame)) (null (window-system))
             (not (display-graphic-p)))
  (error "Non-GUI fringe fallback behavior differs"))
(unless (eq 'preserved (nelisp-stdlib-fringe-bitmap-install (getenv "NELISP_GNU_BUILD_SOURCE_ROOT")))
  (error "Repeated fringe installation changed provider"))
(princ "FRINGE-BITMAP-PASS checked=9 state=preserved\n")
