;;; standalone-abi-sourceeval-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0))
  (dolist (pair '(("" . nil) ("nil" . nil) ("t" . t) ("0" . 0) ("-7" . -7)
                  ("1.25" . 1.25) ("\"source\"" . "source")
                  ("[nil t 0 -7]" . [nil t 0 -7])
                  ("'(a . b)" . (a . b)) (":keyword" . :keyword)
                  ("17 nil" . nil) ("17 t" . t) ("17 0" . 0) ("17 -7" . -7)
                  ("(cons 17 nil) (garbage-collect) '(a . b)" . (a . b))
                  ("(let ((x 17)) (+ x 23))" . 40)
                  ("(nelisp--eval-source-string \"-7\") 23" . 23)
                  ("(defun abi-sourceeval-fn (x) (+ x 7)) (abi-sourceeval-fn 23)" . 30)))
    (let ((actual (nelisp--eval-source-string (car pair))))
      (unless (equal actual (cdr pair)) (error "source eval value changed: %S -> %S" pair actual)))
    (setq checked (+ checked 1)))
  (let ((i 0))
    (while (< i 12)
      (unless (= (nelisp--eval-source-string
                  "(defmacro abi-sourceeval-m (x) (list '+ x 7)) (abi-sourceeval-m 23)") 30)
        (error "source eval macro cache changed"))
      (setq i (+ i 1)) (setq checked (+ checked 1))))
  (unless (eq (condition-case e (nelisp--eval-source-string "(signal 'arith-error '(sourceeval))")
                (error (car e))) 'arith-error)
    (error "source eval original signal changed"))
  (setq checked (+ checked 1))
  (unless (eq (condition-case e (nelisp--eval-source-string "(") (error (car e)))
              'invalid-read-syntax)
    (error "source eval original reader condition changed"))
  (setq checked (+ checked 1))
  (unless (= (catch 'abi-sourceeval-exit
               (nelisp--eval-source-string "(throw 'abi-sourceeval-exit -7)")) -7)
    (error "source eval throw changed"))
  (setq checked (+ checked 1))
  (unless (= (nelisp--eval-source-string "23") 23) (error "source eval stale exit leaked"))
  (setq checked (+ checked 1))
  (princ (format "ABI-SOURCEEVAL-WORD checked=%d PASS\n" checked)))
