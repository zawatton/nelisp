;;; par-gc-init-policy.el --- GC inhibition and explicit accounting -*- lexical-binding: t; -*-

;; Each string has a fresh backing store. The total crosses the former
;; 64 MiB allocation backstop even when the conses themselves are tiny.
(defun par-gc-init-policy-allocate ()
  (let ((i 0))
    (while (< i 5)
      (make-string (* 16 1024 1024) ?x)
      (setq i (1+ i)))))

(let ((gc-cons-threshold most-positive-fixnum)
      (gc-cons-percentage 0.0))
  (let ((before gcs-done))
    (par-gc-init-policy-allocate)
    (prin1 (list 'inhibited (= before gcs-done)))
    (terpri))
  (let ((before gcs-done))
    (when (fboundp 'emacs-load--periodic-gc)
      (let ((load-garbage-collect-interval 1)
            (emacs-load--gc-last-cost 0.0)
            (emacs-load--gc-last-end nil))
        (emacs-load--periodic-gc 1)
        (emacs-load--periodic-gc 2)))
    (prin1 (list 'loader-inhibited (= before gcs-done)))
    (terpri))
  (let ((before gcs-done) (elapsed gc-elapsed))
    (garbage-collect)
    (prin1 (list 'explicit (= (1+ before) gcs-done)
                 (and (floatp elapsed) (> gc-elapsed elapsed))
                 (and (integerp (memory-limit)) (> (memory-limit) 0))))
    (terpri))
  (let ((gc-elapsed nil) (before gcs-done))
    (garbage-collect)
    (prin1 (list 'elapsed-disabled (null gc-elapsed) (= (1+ before) gcs-done)))
    (terpri)))
