;;; nelisp-aot-unit-frame-proof-test.el --- Unit proof context -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)
(defvar nelisp-unit-frame-proof-test--owners nil)
(defvar nelisp-unit-frame-proof-test--selected 0)
(defvar nelisp-unit-frame-proof-test--current nil)
(defun nelisp-unit-frame-proof-test--owner (original owner buf)
  (let* ((nelisp-unit-frame-proof-test--current (nelisp-aot-compiler--ir-get owner :name))
         (defs nelisp-aot-compiler--x86-frame-alias-definitions)
         (cache nelisp-aot-compiler--x86-frame-alias-proof-cache)
         (result (funcall original owner buf)))
    (push (list :name nelisp-unit-frame-proof-test--current :owner owner :defs defs :cache cache
                :proof (and cache (gethash owner cache))) nelisp-unit-frame-proof-test--owners)
    result))
(defun nelisp-unit-frame-proof-test--copy (result)
  (when (and (integerp result) (eq nelisp-unit-frame-proof-test--current 'unit_proof_main))
    (cl-incf nelisp-unit-frame-proof-test--selected))
  result)
(defun nelisp-unit-frame-proof-test--source (&optional mode)
  (let* ((ps '(out mirror))
         (call (if (eq mode 'unknown) 'unit_proof_missing 'unit_proof_tick))
         (tests (mapcar
                 (lambda (n)
                   `(= (unit_proof_main p 3 ,n)
                       ,(logand (* 2 (+ n 7)) (1- (ash 1 64)))))
                 (list 0 2 6 (1- (ash 1 63)) (1- (ash 1 64))))))
    `(seq (defun unit_proof_tick ,ps (atomic-fetch-add out mirror))
          ,@(and (eq mode 'duplicate)
                 `((defun unit_proof_tick ,ps (atomic-fetch-add out mirror))))
          (defun unit_proof_main (out mirror x)
            (seq (atomic-fetch-add out 0)
                 (if (= out 0) 0
                   (let* ((source (+ x 7)) (copy source))
                     (seq (,call ,@ps) (+ copy copy))))))
          (defun _start ()
            (let* ((p (syscall-direct 9 0 4096 3 34 -1 0)))
              (syscall-direct 60 (if (and ,@tests) 0 1) 0 0 0 0 0))))))
(defun nelisp-unit-frame-proof-test--compile (source &optional disabled default-boundary)
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols
         (and default-boundary nelisp-aot-compiler--object-hidden-boundary-symbols))
        (nelisp-standalone--target 'linux-x86_64)
        (nelisp-aot-compiler--runtime-entry-params nil)
        (nelisp-aot-compiler--checked-arith nil)
        (nelisp-aot-compiler--x86-frame-copy-aliases
         (not (or disabled (getenv "NELISP_UNIT_FRAME_PROOF_TEST_DISABLE"))))
        (nelisp-unit-frame-proof-test--owners nil)
        (nelisp-unit-frame-proof-test--selected 0))
    (advice-add 'nelisp-aot-compiler--emit-defun :around #'nelisp-unit-frame-proof-test--owner)
    (advice-add 'nelisp-aot-compiler--x86-frame-copy-source :filter-return #'nelisp-unit-frame-proof-test--copy)
    (unwind-protect
        (let ((unit (nelisp-standalone--compile-to-unit "unit-frame-proof" source)))
          (list :unit unit :owners nelisp-unit-frame-proof-test--owners
                :selected nelisp-unit-frame-proof-test--selected))
      (advice-remove 'nelisp-aot-compiler--emit-defun #'nelisp-unit-frame-proof-test--owner)
      (advice-remove 'nelisp-aot-compiler--x86-frame-copy-source #'nelisp-unit-frame-proof-test--copy))))
(defun nelisp-unit-frame-proof-test--main (result)
  (cl-find 'unit_proof_main (plist-get result :owners) :key (lambda (x) (plist-get x :name))))
(ert-deftest nelisp-unit-frame-proof/ordinary-unit-real-proof-and-native ()
  (let* ((source (nelisp-unit-frame-proof-test--source))
         (off (nelisp-unit-frame-proof-test--compile source t))
         (on (nelisp-unit-frame-proof-test--compile source))
         (dir (make-temp-file "unit-frame-proof-" t)))
    (unwind-protect
        (progn
          (dolist (result (list off on))
            (let ((file (expand-file-name (if (eq result off) "off" "on") dir)))
              (nelisp-link-units file (list (plist-get result :unit)) "_start")
              (set-file-modes file #o755)
              (should (equal 0 (call-process file nil nil nil)))))
          (should (= 0 (plist-get off :selected)))
          (message "UNIT-FRAME-PROOF native on/off full64/WORD-bits PASS")
          (let* ((main (nelisp-unit-frame-proof-test--main on))
                 (owner (plist-get main :owner)))
            (should-not (nelisp-aot-compiler--ir-get owner :internal-hidden))
            (should (plist-get main :proof))
            (should (> (plist-get on :selected) 0))))
      (delete-directory dir t))))
(ert-deftest nelisp-unit-frame-proof/duplicate-unknown-and-cache-scope ()
  (let* ((sentinel (make-hash-table :test #'eq))
         (nelisp-aot-compiler--x86-frame-alias-definitions sentinel)
         (nelisp-aot-compiler--x86-frame-alias-proof-cache sentinel)
         (a (nelisp-unit-frame-proof-test--compile (nelisp-unit-frame-proof-test--source)))
         (b (nelisp-unit-frame-proof-test--compile (nelisp-unit-frame-proof-test--source))))
    (should (eq sentinel nelisp-aot-compiler--x86-frame-alias-definitions))
    (should (eq sentinel nelisp-aot-compiler--x86-frame-alias-proof-cache))
    (let ((ma (nelisp-unit-frame-proof-test--main a)) (mb (nelisp-unit-frame-proof-test--main b)))
      (should (hash-table-p (plist-get ma :cache)))
      (should-not (eq (plist-get ma :cache) (plist-get mb :cache)))
      (should-not (eq sentinel (plist-get ma :defs)))
      (should (eq (gethash 'unit_proof_main (plist-get ma :defs)) (plist-get ma :owner))))
    (should-error (nelisp-unit-frame-proof-test--compile
                   (nelisp-unit-frame-proof-test--source 'duplicate))
                  :type 'nelisp-aot-compiler-error)
    (let* ((main (nelisp-unit-frame-proof-test--main a))
           (owner (plist-get main :owner))
           (nelisp-aot-compiler--x86-frame-alias-definitions
            (nelisp-aot-compiler--x86-frame-alias-definitions (list owner owner))))
      (should (eq :duplicate (gethash 'unit_proof_main nelisp-aot-compiler--x86-frame-alias-definitions)))
      (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner)))
    (let* ((result (nelisp-unit-frame-proof-test--compile (nelisp-unit-frame-proof-test--source 'unknown)))
           (main (nelisp-unit-frame-proof-test--main result)))
      (should (= 0 (plist-get result :selected)))
      (should (eq :rejected (plist-get main :proof))))))
(ert-deftest nelisp-unit-frame-proof/default-hidden-still-rejected ()
  (let* ((result (nelisp-unit-frame-proof-test--compile
                  (nelisp-unit-frame-proof-test--source) nil t))
         (main (nelisp-unit-frame-proof-test--main result)))
    (should (nelisp-aot-compiler--ir-get (plist-get main :owner) :internal-hidden))
    (should (= 0 (plist-get result :selected)))
    (should (eq :rejected (plist-get main :proof)))))
(provide 'nelisp-aot-unit-frame-proof-test)
