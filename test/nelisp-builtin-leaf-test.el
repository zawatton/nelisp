;;; nelisp-builtin-leaf-test.el --- Private handler boundaries -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-standalone-build)

(defun nelisp-builtin-leaf-test--split (form &optional frame admitted)
  "Use the old grouping as the negative-control baseline before the change."
  (funcall (if (fboundp 'nelisp-standalone--applyfn-split-handler-leaves)
               #'nelisp-standalone--applyfn-split-handler-leaves
             #'nelisp-standalone--applyfn-split-handler-groups)
           form frame admitted))

(defun nelisp-builtin-leaf-test--with-definitions (definitions thunk)
  "Temporarily install generated DEFINITIONS and call THUNK."
  (let ((old (mapcar (lambda (d) (cons (cadr d) (and (fboundp (cadr d))
                                                    (symbol-function (cadr d))))) definitions)))
    (unwind-protect
        (progn (dolist (definition definitions) (eval definition t)) (funcall thunk))
      (dolist (entry old)
        (if (cdr entry) (fset (car entry) (cdr entry)) (fmakunbound (car entry)))))))

(ert-deftest nelisp-builtin-leaf-route-is-independent-and-default-preserved ()
  (let* ((tree (nelisp-standalone--key-tree 'nl_dk '((1 . 11) (2 . 22) (3 . 33)) 99))
         (parts (nelisp-builtin-leaf-test--split `(let* () ,tree))))
    (should (= (length (car parts)) 3))
    (should (equal (mapcar (lambda (d) (nth 3 d)) (car parts)) '(11 22 33)))
    (should (cl-every (lambda (d) (equal (nth 2 d) '(nl_dk func_ptr args env name_ptr _pad))) (car parts)))
    (nelisp-builtin-leaf-test--with-definitions
     (car parts)
     (lambda ()
       (dolist (key '(-1 0 1 2 3 4 9999999))
         (let ((bindings `((nl_dk . ,key) (func_ptr . 1) (args . 2) (env . 3) (name_ptr . 4) (_pad . 0))))
           (should (= (eval tree bindings) (eval (cdr parts) bindings)))))))))

(ert-deftest nelisp-builtin-leaf-rejects-missing-input-and-noncanonical-tree ()
  (should-error (nelisp-builtin-leaf-test--split '(let* () (if (= nl_dk 1) (+ missing-input 1) 9))))
  (should-error (nelisp-builtin-leaf-test--split '(let* () (if (< nl_dk 2) (if (= nl_dk 1) 11 90) (if (= nl_dk 2) 22 91)))))
  (should-error (nelisp-builtin-leaf-test--split '(let* () (if (< nl_dk 2) (if (= nl_dk 1) 11 90) (if (= nl_dk 1) 22 90))))))

(ert-deftest nelisp-builtin-leaf-frame-missing-nil-and-decline-before-effects ()
  (let* ((tree (nelisp-standalone--key-tree 'nl_dk '((1 . (wf_arg_word args 0)) (2 . (unproven_list_consumer args))) 99))
         (parts (nelisp-builtin-leaf-test--split `(let* () ,tree) t '(1))))
    (should (= (length (car parts)) 1))
    (should (equal (nth 2 (caar parts)) '(nl_dk func_ptr args env name_ptr argc)))
    (cl-letf (((symbol-function 'heap-read-u64) (lambda (base offset) (aref base (/ offset 8)))))
      (nelisp-builtin-leaf-test--with-definitions
       (car parts)
       (lambda ()
         (dolist (case '((1 [] 0 0) (1 [3] 1 3) (1 [17] 1 17) (2 [] 0 2) (99 [] 0 2)))
           (should (= (eval (cdr parts) `((nl_dk . ,(nth 0 case)) (func_ptr . 1)
                                         (args . ,(nth 1 case)) (env . 3) (name_ptr . 4)
                                         (argc . ,(nth 2 case)))) (nth 3 case)))))))
    (should-error (funcall (eval (caar parts) t) 1 2 3))))

(ert-deftest nelisp-builtin-leaf-no-inline-all-production-paths-and-controls ()
  (should (fboundp 'nelisp-standalone--no-inline-p))
  (let* ((leaf 'nl_apply_builtin_leaf_42_w)
         (definition `(defun ,leaf (a) (+ a 1)))
         (source `(seq ,definition (defun caller (a) (,leaf a))))
         (initializer `(seq ,definition (defun caller (a) (let* ((r (,leaf a))) r))))
         (control '(seq (defun ordinary_leaf (a) (+ a 1))
                        (defun caller (a) (ordinary_leaf a)))))
    (should (nelisp-standalone--no-inline-p leaf))
    (should-not (nelisp-standalone--inline-body-ok-p '(+ a 1) leaf))
    (should (equal source (nelisp-standalone--inline-source source nil)))
    (should (equal source (nelisp-standalone--inline-unit-source source)))
    (cl-letf (((symbol-function 'nelisp-standalone--no-inline-p) (lambda (&rest _) nil)))
      (should-not (equal source (nelisp-standalone--inline-unit-source source))))
    (should (equal initializer (nelisp-standalone--inline-wrapper-initializers initializer initializer)))
    (should-not (equal control (nelisp-standalone--inline-unit-source control)))
    (let ((nelisp-standalone--xinline-table (make-hash-table :test #'eq))
          (nelisp-standalone--xinline-used (make-hash-table :test #'eq)))
      (nelisp-standalone--xinline-register `(seq ,definition))
      (should-not (gethash leaf nelisp-standalone--xinline-table))
      ;; A stale/imported table cannot undo the boundary at expansion time.
      (puthash leaf '((a) . (+ a 1)) nelisp-standalone--xinline-table)
      (let ((caller `(seq (defun caller (a) (,leaf a)))))
        (should (equal caller (nelisp-standalone--xinline-expand caller)))))))

(ert-deftest nelisp-builtin-leaf-owner-policies-and-cache-are-derived ()
  (should (fboundp 'nelisp-standalone--builtin-leaf-names))
  (let* ((source '(seq (defun nl_apply_builtin_leaf_42_w (a) (+ a 1))))
         (names (nelisp-standalone--builtin-leaf-names source))
         (nelisp-standalone--builtin-leaf-active-names names)
         (nelisp-standalone--target 'linux-x86_64))
    (should (equal names '(nl_apply_builtin_leaf_42_w)))
    (let ((normal (nelisp-standalone--unit-cache-key source)))
      (cl-letf (((symbol-function 'nelisp-standalone--builtin-leaf-names) (lambda (_) nil)))
        (let ((nelisp-standalone--builtin-leaf-active-names nil))
          (should-not (equal normal (nelisp-standalone--unit-cache-key source))))))))

(ert-deftest nelisp-builtin-leaf-production-table-every-key-matches-original ()
  (let ((process-environment (copy-sequence process-environment)) table)
    (setenv "NELISP_READER_DYNAMIC" "1")
    (setenv "NELISP_T104_FLAT_DISPATCH" nil)
    (cl-letf (((symbol-function 'nelisp-standalone--applyfn-assemble)
               (lambda (_helpers entries &optional _default) (setq table entries) '(seq))))
      (nelisp-standalone--applyfn-source))
    (let* ((original (nelisp-standalone--n5-syscall-dispatch
                      (nelisp-standalone--applyfn-build-dispatch table nil t)))
           (parts (nelisp-builtin-leaf-test--split
                   (cdr (nelisp-standalone--applyfn-split-name-resolver original))))
           (old-tree (nth 2 original)))
      (dolist (definition (car parts))
        (let* ((name (symbol-name (cadr definition)))
               (key (string-to-number (progn (string-match "leaf_\\([0-9]+\\)_w\\'" name) (match-string 1 name)))))
          (should (equal (nth 3 definition) (nelisp-name-split-test--leaf old-tree key))))))))

(ert-deftest nelisp-builtin-leaf-production-assembly-does-not-use-group-oracle ()
  (let ((process-environment (copy-sequence process-environment)))
    (setenv "NELISP_T104_FLAT_DISPATCH" nil)
    (cl-letf (((symbol-function 'nelisp-standalone--applyfn-split-handler-groups)
               (lambda (&rest _) (error "Production still uses grouping"))))
      (dolist (default '(nil 1))
        (let* ((source (nelisp-standalone--applyfn-assemble
                        nil '(((:lit "car") :word . 11) ((:lit "cdr") :word . 22)) default))
               (names (nelisp-standalone--builtin-leaf-names source)))
          (should (= (length names) (if default 2 4)))
          (should-not (cl-find-if
                       (lambda (f) (memq (cadr f) '(nl_apply_builtin_group_0_w nl_apply_builtin_group_1_w)))
                       (cdr source))))))))

(provide 'nelisp-builtin-leaf-test)
