;;; standalone-setf-eieio-accessor.el --- Genuine EIEIO-generated setter method -*- lexical-binding: t; -*-
(require 'eieio)
(defclass nelisp-setf-accessor-probe ()
  ((value :initarg :value :initform 1 :accessor nelisp-setf-accessor-value)))
(let ((object (make-instance 'nelisp-setf-accessor-probe :value 7)) (effects 0))
  (unless (= (nelisp-setf-accessor-value object) 7)
    (error "Genuine class getter initialization differs"))
  (unless (= (setf (nelisp-setf-accessor-value (progn (setq effects (1+ effects)) object))
                   (progn (setq effects (1+ effects)) 44)) 44)
    (error "Genuine class setter value differs"))
  (unless (and (= effects 2) (= (nelisp-setf-accessor-value object) 44)
               (= (slot-value object 'value) 44))
    (error "Genuine class accessor/slot state differs")))
(princ "SETF-EIEIO-ACCESSOR-PASS\n")
