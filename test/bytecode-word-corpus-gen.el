;;; bytecode-word-corpus-gen.el --- write the GNU bytecode equality corpus -*- lexical-binding: t -*-

;; Usage (host GNU Emacs, from the repository root):
;;   emacs --batch -Q -l test/bytecode-word-corpus-gen.el
;;
;; Byte-compiles every `defun' in test/bytecode-word-corpus-src.el, runs
;; each case of `bwc-cases' in order, and writes
;; test/bytecode-word-corpus.eld:
;;   (EMACS-VERSION
;;    ((VAR . INITIAL-VALUE) ...)        ; defvars, reset before the cases
;;    ((NAME . #[...]) ...)              ; compiled functions
;;    ((NAME ARGS ANSWER) ...))          ; ANSWER is GNU's `%S' text
;; BWC_SRC names another source file and BWC_OUT another output file (test/bytecode-arith-corpus-src.el and .eld).
;; Cases run in file order on both sides, so their side effects line up.

(require 'bytecomp)
(require 'cl-lib)

(let* ((root (file-name-directory (directory-file-name
                                   (file-name-directory load-file-name))))
       (src (or (getenv "BWC_SRC")
                (expand-file-name "test/bytecode-word-corpus-src.el" root)))
       (dst (or (getenv "BWC_OUT")
                (expand-file-name "test/bytecode-word-corpus.eld" root)))
       (forms (with-temp-buffer
                (insert-file-contents src)
                (goto-char (point-min))
                (let (acc form)
                  (while (setq form (condition-case nil (read (current-buffer))
                                      (end-of-file nil)))
                    (push form acc))
                  (nreverse acc))))
       (defvars nil) (fns nil) (cases nil))
  (dolist (f forms)
    (pcase f
      (`(defvar ,name ,val . ,_)
       (eval f t)
       (push (cons name (eval val t)) defvars))
      (`(defconst bwc-cases ,val) (setq cases (eval val t)))
      (`(defun ,name . ,_)
       (eval f t)
       (byte-compile name)
       (push (cons name (symbol-function name)) fns))))
  (setq defvars (nreverse defvars) fns (nreverse fns))
  (unless (cl-every (lambda (p) (byte-code-function-p (cdr p))) fns)
    (error "a corpus function did not byte-compile"))
  (dolist (p defvars) (set (car p) (cdr p)))
  (let ((answers
         (mapcar (lambda (c)
                   (list (car c) (cdr c)
                         (format "%S" (condition-case e (apply (car c) (cdr c))
                                        (error (list 'error (car e)))))))
                 cases)))
    (with-temp-file dst
      (let ((print-escape-newlines t) (print-escape-nonascii t)
            (print-length nil) (print-level nil) (print-circle nil)
            (print-gensym nil))
        (insert ";;; Generated by test/bytecode-word-corpus-gen.el -- do not edit.\n")
        (prin1 (list emacs-version defvars fns answers) (current-buffer))
        (insert "\n")))
    (message "wrote %s: %d functions, %d cases" dst (length fns) (length answers))))

;;; bytecode-word-corpus-gen.el ends here
