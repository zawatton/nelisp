;;; standalone-unibyte-format-check.el --- ASCII byte format admission -*- lexical-binding: t; -*-
;; GNU 31.1 supplies the public reference. On standalone also require the
;; simple formatter to handle each safe call before the Lisp fallback runs.
(dolist (entry (list
               (list (unibyte-string 107 101 121 45 37 100) 42)
               (list (concat "round-" "%i") -7)
               (list "prefix-%s" (number-to-string 123))
               (list "[%s]" (unibyte-string 65 66))
               (list "%x/%X/%o" 255 255 8)
               (list "%c:%%" 65)
               (list (string-as-multibyte "multi-%d") 9)
               (list "日本語-%s" (unibyte-string 65 66))
               (list "%s/%d" nil 1)))
  (let* ((fmt (car entry)) (args (cdr entry))
         (reference (apply #'format fmt args))
         (simple (if (fboundp 'nelisp--format-simple)
                     (nelisp--format-simple fmt args)
                   reference)))
    (unless (and simple (equal simple reference)
                 (eq (multibyte-string-p simple) (multibyte-string-p reference)))
      (error "ASCII format path declined or differed: %S" entry))
    (prin1 (list (append reference nil) (multibyte-string-p reference)))
    (terpri)))
;; High raw bytes must retain the existing representation-sensitive fallback.
(dolist (entry (list (list (unibyte-string 200 45 37 100) 1)
                    (list "[%s]" (unibyte-string 200))))
  (when (and (fboundp 'nelisp--format-simple)
             (nelisp--format-simple (car entry) (cdr entry)))
    (error "Raw high-byte format unexpectedly admitted"))
  (let ((result (apply #'format (car entry) (cdr entry))))
    (prin1 (list (append result nil) (multibyte-string-p result)))
    (terpri)))
(dolist (entry (list (list "%c!" 128) (list "%c!" 233)
                    (list "%c!" 256) (list "%c!" #x3fffc8)
                    (list "%s!" (intern "日本"))
                    (list "%s!" (intern (unibyte-string 200)))
                    (list "%s/%c" (intern (unibyte-string 200)) 233)
                    (list "%s!" (list "abc"))
                    (list "%s!" (list (quote abc)))
                    (list "%%/%s" (list (quote abc)))
                    (list "%s%%" (list (quote abc)))
                    (list "%s!" (list (unibyte-string 200)))
                    (list "%s!" (vector "日本" (unibyte-string 200)))
                    (list "%s!" (list "a\"b\\c"))))
  (let ((result (apply #'format (car entry) (cdr entry))))
    (prin1 (list (append result nil) (multibyte-string-p result)))
    (terpri)))
(dolist (name (list (string-as-multibyte "abc")
                   (string-as-multibyte "日本")
                   (string-as-unibyte "abc") (unibyte-string 200)))
  (condition-case err
      (let ((result (format "%c!" (make-symbol name))))
        (prin1 (list (append result nil) (multibyte-string-p result))))
    (error (prin1 err)))
  (terpri))
(let ((strings (mapcar #'number-to-string
                      (list 0 42 -17 10000000000000000000000000000000000000000 3.5)))
      (expected (list "0" "42" "-17" "10000000000000000000000000000000000000000" "3.5")))
  (garbage-collect)
  (unless (equal strings expected) (error "Fresh numeric buffer lost during GC"))
  (let ((alias (car strings)))
    (aset alias 0 233)
    (garbage-collect)
    (unless (and (= (aref (car strings) 0) 233) (= (length alias) 1)
                 (not (multibyte-string-p alias)))
      (error "Fresh numeric buffer alias/byte representation changed")))
  (princ "FRESH-NUMBER-GC: PASS\n"))
(princ "UNIBYTE-FORMAT: PASS\n")
(kill-emacs 0)
