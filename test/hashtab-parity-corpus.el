;;; hashtab-parity-corpus.el --- hash table behaviour corpus; run on NeLisp and GNU, diff  -*- lexical-binding: t; -*-
(defmacro hp (name form)
  `(princ (format "%s: %S\n" ,name (condition-case e ,form (error (list 'err (car e)))))))
(defun hp-dump (h) (let (r) (maphash (lambda (k v) (push (cons k v) r)) h) (nreverse r)))
;; basic tests and key kinds
(dolist (test '(eq eql equal))
  (let ((h (make-hash-table :test test)) (s1 (copy-sequence "abc")) (f 1.5) (big (expt 2 70)))
    (puthash 1 'one h) (puthash 'sym 'symv h) (puthash s1 's h) (puthash f 'fl h) (puthash big 'big h)
    (puthash (list 1 2) 'lst h) (puthash [1 2] 'vec h) (puthash nil 'nilv h) (puthash 0.0 'z h) (puthash -0.0 'nz h)
    (hp (format "%s lookups" test)
        (list (gethash 1 h) (gethash 'sym h) (gethash s1 h) (gethash (copy-sequence "abc") h)
              (gethash 1.5 h) (gethash (expt 2 70) h) (gethash (list 1 2) h) (gethash [1 2] h)
              (gethash nil h) (gethash 0.0 h) (gethash -0.0 h) (gethash 'absent h 'dflt) (gethash 2 h)))
    (hp (format "%s count/dump" test) (list (hash-table-count h) (hp-dump h)))
    (puthash 1 'uno h) (puthash s1 's2 h)
    (hp (format "%s update" test) (list (gethash 1 h) (gethash s1 h) (hash-table-count h)))
    (remhash 1 h) (remhash 'nokey h) (remhash (copy-sequence "abc") h)
    (hp (format "%s after rem" test) (list (hash-table-count h) (hp-dump h)))))
;; growth, removal and free-list reuse order
(dolist (test '(eq eql equal))
  (let ((h (make-hash-table :test test)))
    (dotimes (i 300) (puthash i (* i i) h))
    (dotimes (i 300) (when (= 0 (% i 3)) (remhash i h)))
    (dotimes (i 50) (puthash (+ 1000 i) i h))
    (hp (format "%s grow" test) (list (hash-table-count h) (gethash 299 h) (gethash 300 h) (gethash 1049 h)
                                      (hp-dump h)))
    (clrhash h)
    (hp (format "%s clr" test) (list (hash-table-count h) (hp-dump h) (gethash 1 h)))
    (puthash 'a 1 h) (puthash 'b 2 h)
    (hp (format "%s reuse" test) (hp-dump h))))
;; symbol and string key tables of 16 entries (benchmark shapes)
(let ((h (make-hash-table :test 'eq)) ks)
  (dotimes (i 16) (push (intern (format "s7k%d" i)) ks))
  (dolist (k ks) (puthash k (symbol-name k) h))
  (hp "eq-sym" (mapcar (lambda (k) (gethash k h)) ks)))
(let ((h (make-hash-table :test 'equal)) ks)
  (dotimes (i 16) (push (format "key-%d" i) ks))
  (dolist (k ks) (puthash k (length k) h))
  (hp "equal-str" (mapcar (lambda (k) (gethash (copy-sequence k) h)) ks)))
;; rehash after GC
(let ((h (make-hash-table :test 'eq)) (h2 (make-hash-table :test 'eql)) (h3 (make-hash-table :test 'equal)) ks)
  (dotimes (i 200) (let ((k (list i))) (push k ks) (puthash k i h) (puthash (+ i 0.5) i h2) (puthash (format "k%d" i) i h3)))
  (garbage-collect) (garbage-collect)
  (hp "gc eq" (list (apply #'+ (mapcar (lambda (k) (gethash k h)) ks)) (hash-table-count h)))
  (hp "gc eql" (list (gethash 100.5 h2) (gethash 199.5 h2) (hash-table-count h2)))
  (hp "gc equal" (list (gethash "k100" h3) (hash-table-count h3)))
  (dolist (k ks) (when (= 0 (% (car k) 2)) (remhash k h)))
  (garbage-collect)
  (hp "gc eq rem" (list (hash-table-count h) (gethash (nth 10 ks) h) (gethash (nth 11 ks) h))))
;; custom test
(define-hash-table-test 'hp-ci (lambda (a b) (string= (downcase a) (downcase b))) (lambda (k) (sxhash-equal (downcase k))))
(let ((h (make-hash-table :test 'hp-ci)))
  (puthash "Foo" 1 h) (puthash "BAR" 2 h) (puthash "foo" 3 h)
  (hp "custom" (list (gethash "FOO" h) (gethash "bar" h) (hash-table-count h) (hash-table-test h)))
  (remhash "BAR" h)
  (hp "custom rem" (list (hash-table-count h) (hp-dump h))))
;; weakness
(dolist (w '(nil key value key-or-value key-and-value))
  (let ((h (make-hash-table :test 'eq :weakness w)))
    (puthash 'a 1 h) (puthash 'b 2 h) (puthash 'a 3 h)
    (hp (format "weak %S" w) (list (hash-table-weakness h) (gethash 'a h) (hash-table-count h) (hp-dump h)))
    (remhash 'a h)
    (hp (format "weak %S rem" w) (list (gethash 'a h) (hash-table-count h)))))
;; copy-hash-table independence
(let* ((h (make-hash-table :test 'equal)) c)
  (puthash "a" 1 h) (puthash "b" 2 h)
  (setq c (copy-hash-table h))
  (puthash "a" 10 c) (remhash "b" c) (puthash "c" 3 c)
  (hp "copy" (list (hp-dump h) (hp-dump c) (hash-table-count h) (hash-table-count c) (hash-table-test c))))
;; modification during maphash (allowed: update/remove current entry)
(let ((h (make-hash-table :test 'eq)))
  (dotimes (i 10) (puthash i i h))
  (maphash (lambda (k v) (puthash k (* 10 v) h) (when (cl-evenp k) (remhash k h))) h)
  (hp "maphash mutate" (hp-dump h)))
(let ((h (make-hash-table :test 'eql)) (n 0))
  (dotimes (i 5) (puthash i i h))
  (maphash (lambda (k _v) (setq n (1+ n)) (when (< k 3) (puthash (+ k 100) k h))) h)
  (hp "maphash add" (list n (hash-table-count h))))
(hp "maphash ret" (let ((h (make-hash-table))) (puthash 1 2 h) (maphash #'ignore h)))
(hp "maphash prim" (let ((h (make-hash-table)) (r 0)) (puthash 1 2 h) (puthash 3 4 h) (maphash (lambda (k v) (setq r (+ r k v))) h) r))
;; errors
(hp "gethash wta" (gethash 1 '(a)))
(hp "puthash wta" (puthash 1 2 nil))
(hp "remhash wta" (remhash 1 [1]))
(hp "maphash wta" (maphash #'ignore 5))
(hp "hash-table-p" (list (hash-table-p (make-hash-table)) (hash-table-p '(a)) (hash-table-p nil)))
;; bytecode callers (compiled lambdas) when available
(let* ((h (make-hash-table :test 'eq)))
  (dotimes (i 16) (puthash i (* 2 i) h))
  (hp "loop" (let ((s 0) (i 0)) (while (< i 1000) (setq s (+ s (gethash (logand i 15) h 0))) (puthash (logand i 15) (+ 1 (logand i 15)) h) (setq i (1+ i))) (list s (hp-dump h)))))
