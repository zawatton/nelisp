;;; nelisp-bytecode-arglist-shape-test.el --- amp_kind / arglist_shape equivalence -*- lexical-binding: t; -*-
;; The production `wf_bytecode_arglist_shape' (one loop, one `wf_bytecode_amp_kind'
;; decode per name) must answer exactly what the former recursive definition
;; answered, for every short formals list over a small alphabet that includes
;; the two markers, a look-alike `&' name, plain names and a non-symbol.
(require 'ert)
(require 'cl-lib)

(defconst swa--root (file-name-directory (directory-file-name
                                          (file-name-directory load-file-name))))
(defun swa--definition (name)
  (with-temp-buffer
    (insert-file-contents (or (getenv "SWITCHFAST_SOURCE")
                              (expand-file-name "scripts/nelisp-standalone-build.el" swa--root)))
    (goto-char (point-min))
    (unless (re-search-forward (concat "(defun " (symbol-name name) "[[:space:]]") nil t)
      (error "Missing production definition %s" name))
    (goto-char (match-beginning 0))
    (read (current-buffer))))
(defun swa--truth (value) (and value (not (equal value 0))))
(defun swa--host (form)
  (cond ((atom form) form)
        ((memq (car form) '(if while))
         (cons (car form) (cons `(swa--truth ,(swa--host (cadr form)))
                               (mapcar #'swa--host (cddr form)))))
        ((eq (car form) 'and)
         (if (null (cdr form)) 1
           `(if (swa--truth ,(swa--host (cadr form)))
                ,(swa--host (cons 'and (cddr form))) 0)))
        ((eq (car form) 'or)
         (if (null (cdr form)) 0
           `(if (swa--truth ,(swa--host (cadr form))) 1
              ,(swa--host (cons 'or (cddr form))))))
        ((eq (car form) 'let*) ;; bindings are (VAR INIT)
         `(let* ,(mapcar (lambda (b) (list (car b) (swa--host (cadr b)))) (cadr form))
            ,@(mapcar #'swa--host (cddr form))))
        ((consp (car form)) (mapcar #'swa--host form))
        (t (cons (pcase (car form) ('seq 'progn) ('sar 'swa--sar) (_ (car form)))
                 (mapcar #'swa--host (cdr form))))))
(defun swa--sar (x n) (ash x (- n)))

(defconst swa--old-source
  '(defun swa--old-shape (formals state required maximum)
  ;; FORMALS is a word.  Return counts packed with a private, wider
  ;; layout: required[0..15], maximum[16..31], rest[32].
  (if (= (wf_bytecode_w_nilp formals) 1)
      (+ required (* maximum 65536))
    (if (= (wf_bytecode_w_consp formals) 1)
        (let* ((name (heap-read-u64 (nl_word_payload formals) 0))
               (tail (heap-read-u64 (nl_word_payload formals) 8)))
          (if (= (wf_bytecode_w_tag name) 4)
              (if (= (swa--opt-p name) 1)
                  (if (= state 0)
                      (swa--old-shape tail 1 required maximum)
                    -1)
                (if (= (swa--rest-p name) 1)
                    (if (= (wf_bytecode_w_consp tail) 1)
                        (let* ((rest-name (heap-read-u64 (nl_word_payload tail) 0))
                               (after-rest (heap-read-u64 (nl_word_payload tail) 8)))
                          (if (if (= (wf_bytecode_w_tag rest-name) 4)
                                  (if (= (wf_bytecode_w_nilp after-rest) 1)
                                      (if (= (swa--opt-p rest-name) 0)
                                          (if (= (swa--rest-p rest-name) 0) 1 0)
                                        0)
                                    0)
                                0)
                              (+ required (* maximum 65536) 4294967296)
                            -1))
                      -1)
                  (if (if (= state 0)
                          (if (< required 65535) 1 0)
                        (if (< maximum 65535) 1 0))
                      (if (= state 0)
                          (swa--old-shape tail 0
                                                     (+ required 1)
                                                     (+ maximum 1))
                        (swa--old-shape tail 1 required
                                                   (+ maximum 1)))
                    -1)))
            -1))
      -1))))

(defun swa--model-name-p (sym) (if (and (symbolp sym) (string-prefix-p "&" (symbol-name sym))) 1 0))
(defun swa--opt-p (sym) (if (and (= (swa--model-name-p sym) 1) (equal (symbol-name sym) "&optional")) 1 0))
(defun swa--rest-p (sym) (if (and (= (swa--model-name-p sym) 1) (equal (symbol-name sym) "&rest")) 1 0))

(defun swa--all-lists (alphabet max-len)
  (let ((acc (list nil)) (frontier (list nil)))
    (dotimes (_ max-len)
      (setq frontier (apply #'append
                            (mapcar (lambda (l) (mapcar (lambda (x) (append l (list x))) alphabet))
                                    frontier)))
      (setq acc (append acc frontier)))
    acc))

(ert-deftest swa-shape-matches-former-recursive-definition ()
  (eval (swa--host swa--old-source) t)
  (eval (swa--host (swa--definition 'wf_bytecode_arglist_shape)) t)
  (eval (swa--host (swa--definition 'wf_bytecode_amp_kind)) t)
  (cl-letf (((symbol-function 'wf_bytecode_w_nilp) (lambda (w) (if (null w) 1 0)))
            ((symbol-function 'wf_bytecode_w_consp) (lambda (w) (if (consp w) 1 0)))
            ((symbol-function 'wf_bytecode_w_tag) (lambda (w) (if (symbolp w) 4 2)))
            ((symbol-function 'nl_word_payload) #'identity)
            ((symbol-function 'heap-read-u64)
             (lambda (cell off) (if (= off 0) (car cell) (cdr cell))))
            ((symbol-function 'wf_bytecode_amp_name_p) #'swa--model-name-p)
            ((symbol-function 'symbol-name-eq)
             (lambda (sym str) (if (equal (symbol-name sym) str) 1 0)))
            ((symbol-function 'wf_bytecode_optional_marker_p) #'swa--opt-p)
            ((symbol-function 'wf_bytecode_rest_marker_p) #'swa--rest-p))
    (let ((n 0) (shapes nil))
      (dolist (l (swa--all-lists '(a &optional &rest b &foo 5) 5))
        (let ((old (swa--old-shape l 0 0 0)) (new (wf_bytecode_arglist_shape l 0 0 0)))
          (should (= old new))
          (cl-incf n)
          (push new shapes)))
      ;; improper tails and a start state of 1 as well
      (dolist (l '((a . b) (a &optional . 5) (&rest a . b) (&rest . a) 7))
        (should (= (swa--old-shape l 0 0 0) (wf_bytecode_arglist_shape l 0 0 0)))
        (should (= (swa--old-shape l 1 2 3) (wf_bytecode_arglist_shape l 1 2 3))))
      ;; the comparison is not vacuous: valid, invalid and rest shapes all occur
      (should (> n 9000))
      (should (cl-find-if (lambda (s) (< s 0)) shapes))
      (should (cl-find-if (lambda (s) (>= s 4294967296)) shapes))
      (should (cl-find-if (lambda (s) (and (>= s 0) (< s 4294967296) (> s 65536))) shapes)))))

(ert-deftest swa-amp-kind-classifies-markers ()
  (eval (swa--host (swa--definition 'wf_bytecode_amp_kind)) t)
  (cl-letf (((symbol-function 'wf_bytecode_amp_name_p) #'swa--model-name-p)
            ((symbol-function 'symbol-name-eq)
             (lambda (sym str) (if (equal (symbol-name sym) str) 1 0))))
    (should (= (wf_bytecode_amp_kind '&optional) 1))
    (should (= (wf_bytecode_amp_kind '&rest) 2))
    (should (= (wf_bytecode_amp_kind '&foo) 0))
    (should (= (wf_bytecode_amp_kind 'a) 0))))
(provide 'nelisp-bytecode-arglist-shape-test)
