;;; par-gc-percentage.el --- Threshold and percentage at safepoints -*- lexical-binding: t; -*-

(defun par-gc-percentage-allocate (count)
  (let ((i 0))
    (while (< i count)
      (make-string 524288 ?x)
      (setq i (1+ i)))))

(let ((gc-cons-threshold 80000)
      (gc-cons-percentage 4.0))
  (garbage-collect)
  (let ((before gcs-done))
    (par-gc-percentage-allocate 4)
    (prin1 (list 'percentage-higher (= before gcs-done)))
    (terpri)
    (let ((gc-cons-percentage 0.0))
      (par-gc-percentage-allocate 4)
      (prin1 (list 'threshold-fires (> gcs-done before)))
      (terpri)))
  (let ((before gcs-done))
    (par-gc-percentage-allocate 4)
    (prin1 (list 'percentage-restored (= before gcs-done)))
    (terpri)))

(let ((gc-cons-threshold 80000) (gc-cons-percentage 0.0))
  (garbage-collect)
  (let ((before gcs-done) (i 0))
    (while (< i 4)
      (make-list 20000 nil)
      (setq i (1+ i)))
    (prin1 (list 'cons-charged (> gcs-done before)))
    (terpri))
  (let ((before gcs-done) (i 0))
    (while (< i 4)
      (make-vector 32768 nil)
      (setq i (1+ i)))
    (prin1 (list 'vector-charged (> gcs-done before)))
    (terpri))
  (let ((before gcs-done) (i 0))
    (while (< i 4)
      (make-bool-vector 1048576 t)
      (setq i (1+ i)))
    (prin1 (list 'bool-vector-charged (> gcs-done before)))
    (terpri)))
