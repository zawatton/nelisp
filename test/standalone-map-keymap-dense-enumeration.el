;;; standalone-map-keymap-dense-enumeration.el --- Actual dense callbacks -*- lexical-binding: t; -*-
(require 'nelisp-stdlib-sparse-keymap)
(let ((installation (nelisp-stdlib-sparse-keymap-install)))
  (let ((map (make-keymap)) (parent (make-sparse-keymap)) events)
    (define-key map [24] 'child-command)
    (define-key parent [24] 'parent-command)
    (define-key parent [foo] 'symbol-command)
    (set-keymap-parent map parent)
    (map-keymap (lambda (event definition) (push (list event definition) events)) map)
    (unless (and (= (length events) 3)
                 (member '(24 child-command) events)
                 (member '(24 parent-command) events)
                 (member '(foo symbol-command) events))
      (error "Dense inherited event enumeration differs: %S" events))
    (setq events nil)
    (set-char-table-range (cadr map) '(30 . 32) 'range-command)
    (map-keymap (lambda (event definition)
                  (when (eq definition 'range-command) (push event events))) map)
    (unless (equal events '((30 . 32)))
      (error "Dense range event differs: %S" events))
    (define-key map [97] nil)
    (setq events nil)
    (map-keymap (lambda (event definition)
                  (when (equal event 97) (push definition events))) map)
    (unless (equal events '(nil))
      (error "Explicit nil sentinel callback differs: %S" events)))
  (when (eq installation 'installed)
    (let ((owner (symbol-function 'map-char-table)) (entered nil))
      (unwind-protect
          (progn
            (fset 'map-char-table (lambda (&rest _) (setq entered t)))
            (unless (condition-case nil
                        (progn (map-keymap (lambda (&rest _)) (make-keymap)) nil)
                      (error t))
              (error "Mutated character table owner accepted"))
            (when entered (error "Mutated character table owner executed")))
        (fset 'map-char-table owner)))))
(princ "MAP-KEYMAP-DENSE-ENUMERATION-PASS\n")
