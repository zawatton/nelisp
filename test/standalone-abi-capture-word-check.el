;;; standalone-abi-capture-word-check.el --- Captured WORDs -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(let ((checks 0))
  (dolist (value (list nil t 0 -7 "capture" '(a . b) [nil t -7]
                       (make-symbol "capture-symbol") (make-bool-vector 9 t)))
    (let* ((cell value)
           (reader (lambda () cell))
           (writer (lambda (next) (setq cell next))))
      (garbage-collect)
      (unless (eq (funcall reader) value) (error "initial capture changed"))
      (let ((next (list value)))
        (funcall writer next)
        (garbage-collect)
        (let ((cell 'shadow))
          (unless (eq cell 'shadow) (error "shadow changed"))
          (unless (eq (funcall reader) next) (error "shared cell lost")))
        (unless (eq cell next) (error "write did not reach original binding")))
      (unless (eq value
                  (eval '(let ((f (lambda () abi-explicit-capture)))
                           (garbage-collect) (funcall f))
                        (list (cons 'abi-explicit-capture value))))
        (error "explicit eval alist capture changed"))
      (setq checks (+ checks 4))))
  (unless (equal
           (eval '(let* ((x (list 1)) (f (lambda () x))
                         (x (progn (garbage-collect) (list 2))))
                    (list x (funcall f))) t)
           '((2) (1)))
    (error "sequential rebinding changed"))
  (setq checks (+ checks 1))
  (unless (equal
           (eval '(progn
                    (defvar abi-capture-special 0)
                    (let ((f (let ((abi-capture-special 7))
                               (lambda () abi-capture-special))))
                      (list (funcall f)
                            (let ((abi-capture-special 9)) (funcall f))))) t)
           '(0 9))
    (error "dynamic binding was captured"))
  (setq checks (+ checks 1))
  (unless (equal
           (eval '(let ((saved 'outer))
                    (defvar abi-capture-local-special)
                    (let ((f (lambda ()
                               (let ((abi-capture-local-special 7))
                                 (list saved (symbol-value 'abi-capture-local-special))))))
                      (garbage-collect)
                      (funcall f))) t)
           '(outer 7))
    (error "local declaration was lost"))
  (setq checks (+ checks 1))
  (unless (equal (eval '(lambda () 19) t) (eval '(lambda () 19) t))
    (error "empty capture changed"))
  (setq checks (+ checks 1))
  (princ (format "ABI-CAPTURE-WORD checks=%d PASS\n" checks)))
