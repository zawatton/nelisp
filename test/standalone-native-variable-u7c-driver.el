;;; standalone-native-variable-u7c-driver.el --- Bare native variables -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'nelisp-native-cache)
(load "test/support/native-frame-u7a-fixtures.el" nil t t)

(defvar u7a-special)
(defvar u7a-bare-target)

(defun u7c-assert (value label)
  (unless value (error "U7c: %s" label)))

(defun u7c-observe (function &rest arguments)
  (condition-case err
      (list 'returned (apply function arguments))
    (error (list 'signal err))
    (quit (list 'quit err))))

(let* ((nelisp-native-cache-backend
        (if (equal (getenv "U7C_BACKEND") "gccjit") 'gccjit 'in-house))
       (case-name (intern (or (getenv "U7C_CASE") "rich")))
       (function (native-frame-u7a-bare-function case-name))
       (native-name 'u7c-native))
  (princ (format "U7C-STAGE install case=%S\n" case-name))
  (nelisp-native-cache-install native-name function)
  (u7c-assert (subrp (symbol-function native-name)) "installed machine entry")
  (cond
   ((eq case-name 'constant-set)
    ;; GNU 31.1 supplies this oracle.  This reader's BVM currently crashes on
    ;; the same raw bytecode before native entry, so executing it here would
    ;; test that separate interpreter bug instead of the F1 exit contract.
    (let ((expected '(signal (setting-constant t)))
          (before u7a-special))
      (princ "U7C-STAGE native-constant-set\n")
      (u7c-assert (equal expected (u7c-observe native-name 'changed))
                  "native constant-set payload")
      (u7c-assert (equal expected (u7c-observe native-name 'again))
                  "constant-set entry reusable after error")
      (u7c-assert (eq t t) "constant remains t")
      (u7c-assert (eq u7a-special before) "unrelated variable unchanged")))
   ((eq case-name 'rich)
    (setq u7a-special 'outside u7a-bare-target 'target-outside)
    (u7c-assert (eq (funcall native-name 'get nil) 'outside) "plain get")
    (let ((u7a-special 'caller))
      (u7c-assert (eq (funcall native-name 'get nil) 'caller) "caller let get")
      (u7c-assert (eq (funcall native-name 'set 'caller-changed) 'caller-changed)
                  "caller let set result")
      (u7c-assert (eq u7a-special 'caller-changed) "caller let cell changed"))
    (u7c-assert (eq u7a-special 'outside) "caller let restored")
    (with-temp-buffer
      (make-local-variable 'u7a-special)
      (if (local-variable-p 'u7a-special)
          (progn
            (set 'u7a-special 'local)
            (u7c-assert (eq (funcall native-name 'get nil) 'local) "buffer-local get")
            (u7c-assert (eq (funcall native-name 'set 'local-changed) 'local-changed)
                        "buffer-local set result")
            (u7c-assert (eq u7a-special 'local-changed) "buffer-local cell changed")
            (u7c-assert (eq (default-value 'u7a-special) 'outside)
                        "default cell preserved"))
        (princ "U7C-BUFFER-LOCAL-UNAVAILABLE\n")))
    (u7c-assert (eq (funcall native-name 'alias-get nil) 'target-outside) "alias get")
    (u7c-assert (eq (funcall native-name 'alias-set 'target-changed) 'target-changed)
                "alias set result")
    (u7c-assert (eq u7a-bare-target 'target-changed) "alias target changed")
    (let ((live (list 'live)))
      (setq u7a-special live)
      (let ((pair (funcall native-name 'gc-diamond t)))
        (u7c-assert (and (eq (car pair) live) (eq (cdr pair) live))
                    "live heap identity across forced GC and join")))
    (setq u7a-special 'outside)
    (let ((pair (funcall native-name 'gc-diamond nil)))
      (u7c-assert (and (eq (car pair) u7a-special)
                       (eq (cdr pair) u7a-special)
                       (equal u7a-special '(changed)))
                  "setter value rooted across forced GC and join"))
    (makunbound 'u7a-special)
    (let ((expected (u7c-observe function 'get nil)))
      (u7c-assert (equal expected '(signal (void-variable u7a-special)))
                  (format "GNU void payload %S" expected))
      (u7c-assert (equal expected (u7c-observe native-name 'get nil))
                  "native void payload"))
    (u7c-assert (eq (funcall native-name 'set 'recovered) 'recovered)
                "entry reusable after void-variable")
    (u7c-assert (eq u7a-special 'recovered) "set recovers void cell")
    (let ((expected (catch 'u7a-exit (funcall function 'throw nil))))
      (u7c-assert (eq expected 'recovered) "GNU throw payload")
      (u7c-assert (eq (catch 'u7a-exit (funcall native-name 'throw nil)) expected)
                  "native throw payload"))
    (u7c-assert (eq (funcall native-name 'get nil) 'recovered)
                "entry reusable after throw")
    (let ((expected (u7c-observe function 'error nil)))
      (u7c-assert (equal expected '(signal (error u7a-bare recovered)))
                  (format "GNU error payload %S" expected))
      (u7c-assert (equal expected (u7c-observe native-name 'error nil))
                  "native error payload"))
    (u7c-assert (eq (funcall native-name 'get nil) 'recovered)
                "entry reusable after error"))
   (t (error "Unknown U7c case %S" case-name)))
  (princ (format "U7C-NATIVE-PASS backend=%S case=%S\n"
                 nelisp-native-cache-backend case-name)))
