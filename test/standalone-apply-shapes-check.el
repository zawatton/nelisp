;;; standalone-apply-shapes-check.el --- apply / funcall / eval call shapes -*- lexical-binding: t; -*-

;; Each line prints what one call shape returns or the error it raises, as the
;; interpreter's apply, funcall and eval entries answer it.  GNU 31.1 prints
;; the reference:
;;   emacs -Q --batch -l test/standalone-apply-shapes-check.el

(defvar asc-base 10)
(defvar asc-log nil)
(defun asc-f (&rest xs) (cons 'f xs))
(defun asc-g (a b) (list 'g a b))
(defun asc-h (a &optional b &rest c) (list 'h a b c))
(defalias 'asc-alias 'asc-f)
(defvaralias 'asc-alias-var 'asc-base)

(defmacro asc-case (name form)
  `(princ (format "%s %S\n" ,name
                  (condition-case err (list 'returned ,form)
                    (t (list 'caught err))))))

(asc-case "apply-list" (apply 'asc-f '(1 2 3)))
(asc-case "apply-spread" (apply 'asc-f 1 2 '(3 4)))
(asc-case "apply-empty" (apply 'asc-f nil))
(asc-case "apply-prefix-nil" (apply 'asc-f 1 2 nil))
(asc-case "apply-sole" (apply '(asc-f 1 2)))
(asc-case "apply-sole-subr" (apply '(list)))
(asc-case "apply-lambda" (apply (lambda (a b) (+ a b)) '(1 2)))
(asc-case "apply-lambda-spread" (apply (lambda (a b c) (list a b c)) 1 '(2 3)))
(asc-case "apply-alias" (apply 'asc-alias 1 '(2)))
(asc-case "apply-subr-plus" (apply #'+ 1 2 '(3 4)))
(asc-case "apply-subr-car" (apply 'car '((1 2))))
(asc-case "apply-optional" (apply 'asc-h 1 '(2 3 4)))
(asc-case "apply-optional-short" (apply 'asc-h '(1)))
(asc-case "apply-void" (apply 'asc-undefined '(1)))
(asc-case "apply-too-few" (apply 'asc-g '(1)))
(asc-case "apply-too-many" (apply 'asc-g 1 2 '(3)))
(asc-case "apply-dotted" (apply 'asc-f '(1 . 2)))
(asc-case "apply-non-list" (apply 'asc-f 1 2))
(asc-case "apply-no-args" (apply))
(asc-case "apply-nil-fn" (apply nil '(1)))
(asc-case "apply-int-fn" (apply 5 '(1)))
(asc-case "apply-circular"
          (let ((l (list 1 2))) (setcdr (cdr l) l) (apply 'asc-f l)))
(asc-case "apply-shared-tail"
          (let* ((tl (list 3 4)) (r (apply 'asc-f 1 2 tl))) (eq (cdddr r) (cdr tl))))
(asc-case "funcall-symbol" (funcall 'asc-f 1 2))
(asc-case "funcall-lambda" (funcall (lambda (&rest r) r) 1 2))
(asc-case "funcall-void" (funcall 'asc-undefined))
(asc-case "funcall-nil" (funcall nil))
(asc-case "funcall-int" (funcall 5))
(asc-case "funcall-none" (funcall))
(asc-case "funcall-subr" (funcall #'car '(7)))
(asc-case "eval-plain" (eval '(+ 1 2)))
(asc-case "eval-alist" (eval '(+ x 1) '((x . 5))))
(asc-case "eval-lexical-t" (eval '(let ((y 2)) (* y 3)) t))
(asc-case "eval-none" (eval))
(asc-case "eval-three" (eval 1 2 3))
(asc-case "eval-float" (eval '(+ 1.5 2)))
(asc-case "eval-sub" (eval '(- 10 3 2)))
(asc-case "eval-div" (eval '(/ 10 4)))
(asc-case "eval-mul" (eval '(* 3 4 5)))
(asc-case "eval-neg" (eval '(- 5)))
(asc-case "eval-one-plus" (list (1+ 4) (1- 4) (1+ 1.5) (1- 1.5)))
(asc-case "div-float" (list (/ 7 2.0) (/ 2.0) (/ 8 2 2)))
(asc-case "div-zero" (/ 1 0))
(asc-case "arith-type" (+ 1 'a))
(asc-case "arith-marker"
          (with-temp-buffer
            (insert "abcdef")
            (let ((m (copy-marker 3)))
              (list (+ m 1) (- m) (- m 1) (* m 2) (/ m 1) (1+ m) (1- m)))))
(asc-case "make-string" (list (make-string 3 ?a) (make-string 0 ?b) (make-string 2 ?é)))
(asc-case "make-string-multibyte" (multibyte-string-p (make-string 2 ?a t)))
(asc-case "make-string-bad" (make-string -1 ?a))
(asc-case "substring" (list (substring "hello" 1 3) (substring "hello" 1) (substring "hello" -3 -1)))
(asc-case "substring-vector" (substring [1 2 3 4] 1 3))
(asc-case "substring-range" (substring "abc" 0 9))
(asc-case "substring-list" (substring '(1 2) 0))
(asc-case "format" (format "%d-%s-%S" 5 "x" "y"))
(asc-case "alias-var" (list asc-alias-var (setq asc-alias-var 11) asc-base))
(asc-case "alias-set-default" (set-default 'asc-base 12))
(add-variable-watcher 'asc-base (lambda (&rest a) (push a asc-log)))
(asc-case "watch-setq" (progn (setq asc-base 13) (reverse asc-log)))
(asc-case "watch-let" (progn (setq asc-log nil) (list (let ((asc-base 1)) asc-base) (reverse asc-log))))
(asc-case "watch-alias" (progn (setq asc-log nil) (setq asc-alias-var 14) (reverse asc-log)))
(kill-emacs 0)
