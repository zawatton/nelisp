;;; nelisp-gc-rt-init-test.el --- Bounded collector entry RT checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'json)
(require 'nelisp-standalone-build)
(unless (ert-test-boundp 'nelisp-fresh-frame-loop-is-bounded-and-exact)
  (load (expand-file-name "test/nelisp-aot-fresh-frame-test.el" nelisp-standalone--repo-root) nil t))

(defconst nelisp-gc-rt-init--names '(bf_garbage_collect_w nl_gc_stats_run))

(ert-deftest nelisp-gc-rt-init-exact-nine-and-other-targets ()
  (let ((nelisp-standalone--target 'linux-x86_64))
    (should (equal (nelisp-standalone--zero-fresh-frame-functions)
                   '(nelisp_apply_function_w nl_apply_builtin_w nl_apply_builtin_group_0_w nl_apply_builtin_group_1_w
                     nl_apply_builtin_frame_group_0_w nl_apply_builtin_frame_group_1_w
                     nl_apply_builtin_frame_w nl_eic_argframe_call_w
                     bf_garbage_collect_w bf_garbage_collect_snapshot_w nl_gc_stats_run
                     m5_fx_run_body))))
  (dolist (nelisp-standalone--target '(windows-x86_64 linux-aarch64 macos-aarch64))
    (should-not (nelisp-standalone--zero-fresh-frame-functions))))

(ert-deftest nelisp-gc-rt-init-cache-includes-both-entries ()
  (let* ((nelisp-standalone--target 'linux-x86_64)
         (source '(seq (defun gc_cache_probe (x) x)))
         (selector (symbol-function 'nelisp-standalone--zero-fresh-frame-functions))
         (normal (nelisp-standalone--unit-cache-key source)))
    (dolist (name nelisp-gc-rt-init--names)
      (cl-letf (((symbol-function 'nelisp-standalone--zero-fresh-frame-functions)
                 (lambda () (remq name (funcall selector)))))
        (should-not (equal normal (nelisp-standalone--unit-cache-key source)))))))

(ert-deftest nelisp-gc-rt-init-both-entry-shapes-preserve-rejection ()
  ;; Admission controls only; these simple bodies do not model either GC.
  (dolist (spec '((bf_garbage_collect_w (func args env _pad) 24)
                  (nl_gc_stats_run (mode) 80)))
    (let* ((ir (nelisp-fresh-frame-test--definition
                `(defun ,(car spec) ,(cadr spec) ,(caadr spec)) (nth 2 spec)))
           (nelisp-aot-compiler-zero-fresh-frame-functions nelisp-gc-rt-init--names))
      (dolist (abi '(win64))
        (let ((nelisp-aot-compiler--abi abi) (nelisp-aot-compiler--arch 'x86_64))
          (should-error (nelisp-aot-compiler--emit-defun ir (nelisp-asm-x86_64-make-buffer abi))
                        :type 'nelisp-aot-compiler-error)))
      (let ((nelisp-aot-compiler--abi 'sysv) (nelisp-aot-compiler--arch 'aarch64))
        (should-error (nelisp-aot-compiler--emit-defun ir (nelisp-asm-x86_64-make-buffer))
                      :type 'nelisp-aot-compiler-error))
      (dolist (field '(:internal-entry :self-tco-raw :variadic :gc-root-slots))
        (let ((nelisp-aot-compiler--abi 'sysv) (nelisp-aot-compiler--arch 'x86_64))
          (should-error (nelisp-aot-compiler--emit-defun
                         (nelisp-aot-compiler--ir-with ir field t)
                         (nelisp-asm-x86_64-make-buffer)) :type 'nelisp-aot-compiler-error))))))

(defun nelisp-gc-rt-init-export ()
  "Parse the two real owners and emit only their actual GC entry IR.
No source body is replaced. This does not link or run a complete collector."
  (let* ((nelisp-standalone--target 'linux-x86_64)
         (nelisp-aot-compiler--abi 'sysv) (nelisp-aot-compiler--arch 'x86_64)
         (nelisp-aot-compiler-zero-fresh-frame-functions
          (nelisp-standalone--zero-fresh-frame-functions))
         (directory (expand-file-name "target/gc-rt-init/emitted" nelisp-standalone--repo-root))
         records)
    (make-directory directory t)
    (dolist (spec `((bf_garbage_collect_w 4 6 ,nelisp-standalone--applyfn-census-helpers)
                    (nl_gc_stats_run 1 12 ,nelisp-standalone--gc-source)))
      (let* ((name (nth 0 spec)) (argc (nth 1 spec)) (hole (nth 2 spec))
             (source (nelisp-standalone--abi-box-split-source (nth 3 spec)))
             (parsed (nelisp-aot-compiler--parse source nil))
             (ir (cl-find name (nelisp-aot-compiler--collect-defuns parsed)
                          :key (lambda (item) (nelisp-aot-compiler--ir-get item :name))))
             (slots (and ir (nelisp-aot-compiler--ir-get ir :rt-slot-count)))
             (rounded (and (integerp slots) (* 2 (/ (+ slots 1) 2))))
             (buf (nelisp-asm-x86_64-make-buffer 'sysv))
             (loop (nelisp-asm-x86_64-make-buffer 'sysv)))
        (unless (and ir rounded (> rounded hole)) (error "Missing actual entry IR: %S" name))
        (nelisp-aot-compiler--emit-defun ir buf)
        (nelisp-aot-compiler--emit-zero-fresh-rt-slots loop rounded)
        (let* ((bytes (nelisp-asm-x86_64-resolve-fixups buf))
               (initialization (nelisp-asm-x86_64-resolve-fixups loop))
               (position (string-match (regexp-quote initialization) bytes)))
          (unless position (error "Actual entry omitted initializer: %S" name))
          (dolist (kind '(initialized omitted short overlong))
            (let* ((variant (nelisp-asm-x86_64-make-buffer 'sysv))
                   (count (pcase kind ('short (- rounded 2)) ('overlong (+ rounded 2)) (_ rounded)))
                   (coding-system-for-write 'binary))
              (unless (eq kind 'omitted) (nelisp-aot-compiler--emit-zero-fresh-rt-slots variant count))
              (with-temp-file (expand-file-name (format "%s-%s-prefix.bin" name kind) directory)
                (set-buffer-multibyte nil)
                (insert (substring bytes 0 position))
                (insert (nelisp-asm-x86_64-resolve-fixups variant)))))
          (push `((name . ,(symbol-name name)) (argc . ,argc) (rt-slots . ,slots)
                  (rounded-rt-slots . ,rounded) (observed-hole-index . ,hole)
                  (parameter-rounded . ,(* 2 (/ (+ argc 1) 2)))
                  (initializer-offset . ,position) (initializer-size . ,(length initialization))
                  (full-emitted-bytes . ,(length bytes))) records))))
    (with-temp-file (expand-file-name "frames.json" directory)
      (insert (json-encode `((scope . "actual owner parse and GC entry emission; prefix ABI unit only")
                             (frames . ,(vconcat (nreverse records)))))))
    (princ "GC-PRODUCTION-ENTRY-EMIT PASS\n")))

(provide 'nelisp-gc-rt-init-test)
