;;; standalone-string-compare-check.el --- String compiler semantics -*- lexical-binding: t -*-

(defvar sc-count 0)
(defun sc-assert (condition)
  (setq sc-count (1+ sc-count))
  (unless condition (error "string comparison assertion %d failed" sc-count)))
(let ((raw (unibyte-string 233))
      (byte8 (string-as-multibyte (unibyte-string 233))))
  (sc-assert (= (compare-strings raw nil nil "é" nil nil) 1))
  (sc-assert (eq (compare-strings raw nil nil byte8 nil nil) t))
  (sc-assert (not (string-prefix-p raw "é")))
  (sc-assert (string-prefix-p raw byte8))
  (sc-assert (not (string-lessp raw "é")))
  (sc-assert (not (string-lessp "é" raw)))
  (sc-assert (not (string= raw "é")))
  (sc-assert (not (string-equal raw byte8))))
(sc-assert (string-lessp 'alpha 'beta))
(sc-assert (string> 'beta 'alpha))
(sc-assert (string< "ab" "abc"))
(sc-assert (string-greaterp "abc" "ab"))
(sc-assert (eq (compare-strings "abc" -2 99 "ABC" 1 nil t) t))
(sc-assert (string-prefix-p "É" "école" t))
(sc-assert (eq (condition-case e (compare-strings "abc" 4 nil "abc" nil nil)
                 (error (car e))) 'args-out-of-range))
(sc-assert (equal (condition-case e (compare-strings "abc" 'bad nil "abc" nil nil)
                    (error e)) '(wrong-type-argument integerp bad)))
;; The compiled identity is the definition, never its symbol's spelling.
(let ((less (symbol-function 'string-lessp))
      (compare (symbol-function 'compare-strings)))
  (unwind-protect
      (progn
        (fset 'string-lessp (lambda (_a _b) 'replacement))
        (sc-assert (eq (string-greaterp "a" "b") 'replacement))
        (sc-assert (eq (string< "a" "b") 'replacement))
        (fset 'compare-strings (lambda (&rest _args) t))
        (sc-assert (string-prefix-p "ab" "cd")))
    (fset 'string-lessp less)
    (fset 'compare-strings compare)))
(dotimes (_ 10)
  (garbage-collect)
  (sc-assert (string= (concat "a" "b") "ab"))
  (sc-assert (string-lessp "あい" "あう")))
(princ (format "STRING-COMPARE PASS: %d assertions\n" sc-count))
(kill-emacs 0)
