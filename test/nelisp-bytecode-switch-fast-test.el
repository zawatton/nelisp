;;; nelisp-bytecode-switch-fast-test.el --- Switch production IR -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(defconst swf--root (file-name-directory (directory-file-name
                                      (file-name-directory load-file-name))))
(defun swf--definition (name)
  "Read one exact production DSL definition without loading the generator."
  (with-temp-buffer
    (insert-file-contents (or (getenv "SWITCHFAST_SOURCE")
                             (expand-file-name "scripts/nelisp-standalone-build.el" swf--root)))
    (goto-char (point-min))
    (unless (re-search-forward (concat "(defun " (symbol-name name) "[[:space:]]") nil t)
      (error "Missing production definition %s" name))
    (goto-char (match-beginning 0))
    (read (current-buffer))))
(defun swf--find (tree predicate)
  (cond ((funcall predicate tree) tree)
        ((consp tree) (or (swf--find (car tree) predicate)
                         (swf--find (cdr tree) predicate)))))
(defun swf--truth (value) (and value (not (equal value 0))))
(defun swf--host (form)
  "Adapt only syntax and integer-zero truth, retaining production branches."
  (cond ((atom form) form)
        ((memq (car form) '(if while))
         (cons (car form) (cons `(swf--truth ,(swf--host (cadr form)))
                               (mapcar #'swf--host (cddr form)))))
        ((eq (car form) 'and)
         (if (null (cdr form)) 1
           `(if (swf--truth ,(swf--host (cadr form)))
                ,(swf--host (cons 'and (cddr form))) 0)))
        ((eq (car form) 'or)
         (if (null (cdr form)) 0
           `(if (swf--truth ,(swf--host (cadr form))) 1
              ,(swf--host (cons 'or (cddr form))))))
        (t (cons (pcase (car form) ('seq 'progn) (_ (car form)))
                 (mapcar #'swf--host (cdr form))))))

(defun swf--run (key mode pairs hashes next buckets &optional fast target-limit)
  "Execute the production indexed search or opcode arm on checked storage.
The small memory model supplies table layout, identity hashing and eq/eql
semantics; the collision walk and all opcode state updates are production IR."
  (let* ((table 8192) (meta 12288) (mem 4096) (sp 2) (pc 0)
         (length (or target-limit 128)) (go 128) (back 255)
         (a 0) (b 0) (branch 0) (fused 0) (target 0) (ref 0) (word 0) (cmp 0)
         (probes 0) (comparisons 0) (syncs 0))
    (eval (swf--host (swf--definition 'wf_bytecode_switch_find)) t)
    (cl-letf (((symbol-function 'nl_ht_identity_sync) (lambda (_) (cl-incf syncs) 0))
              ((symbol-function 'nl_ht_meta_slot) (lambda (_) meta))
              ((symbol-function 'nl_ht_data_slot) (lambda (_) buckets))
              ((symbol-function 'nl_ht_marker_word)
               (lambda (_ i) (pcase i (11 pairs) (12 hashes) (14 next))))
              ((symbol-function 'nl_ht_int) (lambda (v i) (aref v i)))
              ((symbol-function 'nl_vector_slot_word)
               (lambda (v i) (cl-incf probes) (aref v i)))
              ((symbol-function 'vector-len) #'length)
              ((symbol-function 'nl_ht_hash) (lambda (k _) (ash k -2)))
              ((symbol-function 'nl_ht_hash_index) (lambda (h n) (mod h n)))
              ((symbol-function 'nl_so_p)
               (lambda (w) (if (memq w '(102 110 118)) 1 0)))
              ((symbol-function 'bf_eq2)
               (lambda (k other)
                 (cl-incf comparisons)
                 (if (or (= k other) (equal (list k other) '(120 102))) 1 0)))
              ((symbol-function 'nl_ht_key_match)
               (lambda (k other _)
                 (cl-incf comparisons)
                 ;; A canonical object/view pair, and an eql float pair.
                 (if (or (= k other) (equal (list k other) '(120 102))
                         (and (= mode 2) (equal (list k other) '(128 136)))) 1 0)))
              ((symbol-function 'wf_bytecode_w_tag)
               (lambda (w) (cond ((= (logand w 3) 1) 2) ((= w 144) 19) (t 4))))
              ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2)))
              ((symbol-function 'bf_hash_table_p_raw) (lambda (w) (if (= w table) 1 0)))
              ((symbol-function 'nl_ht_test_mode) (lambda (_) mode))
              ((symbol-function 'nl_ht_entry_value)
               (lambda (_ entry) (aref pairs (1+ (* (1- entry) 2)))))
              ((symbol-function 'heap-read-u64)
               (lambda (p off) (should (= p mem)) (pcase off (0 key) (8 table)
                                                (_ (error "Unexpected stack read"))))))
      (if fast
          (let ((arm (swf--find (swf--definition 'wf_bytecode_w_fast_run)
                                (lambda (x) (equal (car-safe x) '(= raw 183))))))
            (should arm)
            ;; ARM is the tail of the IF: ((= raw 183) THEN ELSE).
            (let ((state `((pc . ,pc) (sp . ,sp) (go . ,go) (back . ,back)
                           (mem . ,mem) (length . ,length) (a . ,a) (b . ,b)
                           (branch . ,branch) (fused . ,fused) (target . ,target)
                           (ref . ,ref) (word . ,word) (cmp . ,cmp))))
              (eval (swf--host (cadr arm)) state)
              (append (mapcar (lambda (s) (cdr (assq s state))) '(pc sp go back))
                      (list probes comparisons syncs))))
        (list (wf_bytecode_switch_find table key mode) probes comparisons syncs)))))

(ert-deftest swf-adapter-controls ()
  (should (= (eval (swf--host '(if (and 0 (error "must not run")) 1 2))) 2))
  (should (= (eval (swf--host '(if (or 0 1) 7 8))) 7)))
(ert-deftest swf-indexed-large-table ()
  (let ((pairs (make-vector 4096 0)) (hashes (make-vector 2048 0))
        (next (make-vector 2048 -1)) (buckets (make-vector 2048 -1)))
    (dotimes (i 2048)
      (aset pairs (* i 2) (1+ (* i 4))) (aset pairs (1+ (* i 2)) 29)
      (aset hashes i i) (aset buckets i i))
    (should (equal (swf--run 8189 1 pairs hashes next buckets) '(2048 1 0 1)))
    (should (equal (swf--run 16381 1 pairs hashes next buckets) '(0 1 0 1)))
    (should (equal (cl-subseq (swf--run 8189 1 pairs hashes next buckets t) 0 4)
                   '(7 0 128 255)))))
(ert-deftest swf-collisions-and-symbol-representations ()
  (should (equal (swf--run 110 1 [102 29 110 33] [27 27] [1 -1] [0]) '(2 2 0 1)))
  (should (equal (swf--run 120 1 [102 29] [30] [-1] [0]) '(1 1 1 1)))
  ;; Keep generic find_index's eq-before-stored-hash behavior for views.
  (should (equal (swf--run 120 1 [102 29] [31] [-1] [0]) '(1 1 1 1)))
  (should (equal (swf--run 128 2 [136 29] [32] [-1] [0]) '(1 1 2 1))))
(ert-deftest swf-opcode-default-decline-and-invalid-target ()
  (should (equal (cl-subseq (swf--run 5 1 [9 29] [2] [-1] [0] t) 0 4)
                 '(1 0 128 255)))
  (dolist (mode '(0 3))
    (should (equal (cl-subseq (swf--run 5 mode [5 29] [1] [-1] [0] t) 0 3)
                   '(0 2 0))))
  (dolist (offset '(-1 128))
    (should (equal (cl-subseq (swf--run 5 1 (vector 5 (1+ (* offset 4)))
                                       [1] [-1] [0] t) 0 3) '(0 2 0))))
  (should (equal (cl-subseq (swf--run 144 1 [144 29] [36] [-1] [0] t) 0 3)
                 '(0 2 0))))
