;;; standalone-abi-reader-control-word-check.el --- Physical/WORD control edges -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(defun abi-reader-control-exit (value)
  (backtrace-debug 0 t 'abi-reader-control-exit)
  value)

(let ((checked 0)
      ;; Catch supplies physical boxed descriptors on the compatibility path.
      ;; GNU byte-compilation of (lambda (x) x) emits return (opcode 135).
      (identity-code (make-byte-code (catch 'abi-code (throw 'abi-code 257))
                                     (unibyte-string 135) []
                                     (catch 'abi-code (throw 'abi-code 2)))))
  (dolist (value (list nil t 0 -7 2305843009213693951 -2305843009213693952
                       1.25 (concat "caught-" "string") (list 'caught [17 29])
                       (vector nil t -7) (make-symbol "caught")))
    (let ((answer (catch 'abi-reader-control (throw 'abi-reader-control value))))
      (unless (eq answer value) (error "caught value changed: %S" value))
      (unless (eq (not answer) (not value)) (error "caught truth value changed"))
      (unless (eq (car (list answer)) value) (error "caught container child changed"))
      (garbage-collect)
      (unless (eq answer value) (error "caught value collected"))
      (setq checked (+ checked 4)))
    (let ((debugger (lambda (reason result)
                      (unless (eq reason 'exit) (error "wrong debug reason"))
                      (garbage-collect)
                      (vector reason result))))
      (unless (equal (abi-reader-control-exit value) (vector 'exit value))
        (error "debugger result changed: %S" value))
      (setq checked (1+ checked)))
    (unless (eq (funcall identity-code value) value)
      (error "boxed bytecode metadata changed: %S" value))
    (setq checked (1+ checked)))
  (unless (null (catch 'abi-reader-control
                  (unwind-protect (throw 'abi-reader-control nil)
                    (catch 'abi-inner (throw 'abi-inner t)) (garbage-collect))))
    (error "nested throw overwrote the saved nil"))
  (setq checked (1+ checked))
  (let* ((empty (catch 'abi-reader-control (throw 'abi-reader-control nil)))
         (table (make-char-table nil 'fallback)))
    (set-char-table-range table 65 empty)
    (unless (eq (aref table 65) 'fallback) (error "boxed nil suppressed the default"))
    (set-char-table-parent table (make-char-table nil 'parent))
    (set-char-table-range table nil empty)
    (unless (eq (aref table 65) 'parent) (error "boxed nil suppressed the parent"))
    (unless (floatp (float-time empty)) (error "boxed nil time was rejected"))
    (setq checked (+ checked 3)))
  ;; GNU's materialized Bswitch fixture, with owned boxed jump targets.
  (let* ((table (make-hash-table :test 'eq))
         (code (unibyte-string 137 192 183 130 10 0 193 135 194 135 195 135))
         (function (make-byte-code 257 code (vector table 10 20 30) 4)))
    (puthash 1 (catch 'abi-code (throw 'abi-code 6)) table)
    (puthash 2 (catch 'abi-code (throw 'abi-code 8)) table)
    (dolist (case '((1 . 10) (2 . 20) (7 . 30)))
      (unless (= (funcall function (car case)) (cdr case))
        (error "boxed switch target changed: %S" case))
      (setq checked (1+ checked))))
  (dolist (value '(nil t 0 -7))
    (let* ((load-file-name value) (pair (read-from-string "(#$ [#$] . #$)")))
      (unless (equal (car pair) (cons value (cons (vector value) value)))
        (error "reader context child changed: %S" value))
      (setq checked (1+ checked))))
  (princ (format "ABI-READER-CONTROL-WORD checks=%d PASS\n" checked)))
nil
