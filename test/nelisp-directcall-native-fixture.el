;;; nelisp-directcall-native-fixture.el --- Production bytecode argv witness -*- lexical-binding: t; -*-
;; Counters and substitutes below exist only in this native fixture.
(require 'cl-lib)
(require 'nelisp-standalone-build)

(let* ((output (getenv "DIRECTCALL_FIXTURE_OUTPUT"))
       (s #x3a000000) (env (+ s 4096)) (mem (+ s 8192))
       (fn (+ s 16386)) (tail (+ s 16402))
       (head (+ s 20000)) (name (+ s 20128)) (text (+ s 20256))
       (roots (+ s 21000)) (frame (+ s 22000))
       (defs (if (fboundp 'nelisp-standalone--directcall-defuns)
                 (nelisp-standalone--directcall-defuns) nil))
       (checks nil))
  (unless output (error "DIRECTCALL_FIXTURE_OUTPUT is required"))
  (cl-labels ((definition (n)
                (or (cl-find-if (lambda (f) (eq (cadr f) n))
                                nelisp-standalone--applyfn-bytecode-helpers)
                    (error "Missing production %s" n)))
              (check (c) (push `(if ,c 0 (setq failed (+ failed 1))) checks)))
    (dolist (mode '(0 1 2 3))
      (push `(seq
              (ptr-write-u64 ,s 0 0) (ptr-write-u64 ,s 8 0)
              (ptr-write-u64 ,s 16 0) (ptr-write-u64 ,s 24 ,mode)
              (ptr-write-u64 ,mem 0 ,name)
              (ptr-write-u64 ,mem 8 29)
              (ptr-write-u64 ,mem 16 ,(if (= mode 1) 3 13))
              (setq rc (wf_bytecode_call ,env ,mem 3 2 0))) checks)
      (check '(= rc 0))
      (check `(= (heap-read-u64 ,mem 0) 13))
      (check `(= (heap-read-u64 ,s 0) ,(if (= mode 0) 0 2)))
      (check `(= (heap-read-u64 ,s 8) ,(if (= mode 0) 0 1)))
      (check `(= (heap-read-u64 ,s 16) ,(if (>= mode 2) 0 1))))
    (let* ((source
            `(seq
              ,(definition 'wf_bytecode_call)
              ,(definition 'wf_bytecode_w_call_words)
              ,@defs
              (defun nl_val_tag (w)
                (if (= w 3) 0 (if (= w ,name) 4 (if (= w ,fn) 7 2))))
              (defun nl_sym_sid (w)
                (if (= w ,head)
                    (if (= (heap-read-u64 ,s 24) 2) 0
                      ,(nelisp-standalone--sid "builtin")) 0))
              (defun nelisp_env_lookup_function_w (a b c d) ,fn)
              (defun nelisp_env_lookup_function_raw_w (a b c d) ,fn)
              (defun wf_bytecode_w_function (a b c d e f g h) 2)
              (defun wf_bytecode_flat_path_int_cell (a) 0)
              (defun nl_ct_throw_words (a b c) 1)
              (defun bf_wrong_number_of_args (a b) 1)
              (defun wf_bytecode_w_call_views (a b c d e) 2)
              (defun wf_bytecode_w_cons2 (a b)
                (seq (ptr-write-u64 ,s 0 (+ (heap-read-u64 ,s 0) 1)) 3))
              (defun nl_apply_function_w (a b c d)
                (seq (ptr-write-u64 ,s 8 (+ (heap-read-u64 ,s 8) 1)) 13))
              (defun nl_root_mark (a) 0)
              (defun nl_root_frame (a b) (if (= (heap-read-u64 ,s 24) 3) 0 ,roots))
              (defun nl_cons_root_finish (a b c) c)
              (defun nl_n4_push (a b c d)
                (seq (ptr-write-u64 ,s 16 (+ (heap-read-u64 ,s 16) 1)) ,frame))
              (defun m5_fx_frame_lazy (a b c d) 0)
              (defun nl_n4_finish_w (a b c d) a)
              (defun m5_fx_primitive_run (a b c d e f g) -3)
              (defun _start ()
                (let* ((failed 0) (rc 0))
                  (seq
                   (syscall-direct 9 ,s 1048576 3 50 -1 0)
                   (ptr-write-u64 ,(- fn 2) 0 ,head)
                   (ptr-write-u64 ,(- fn 2) 8 ,tail)
                   (ptr-write-u64 ,(- tail 2) 0 ,name)
                   (ptr-write-u64 ,(- tail 2) 8 3)
                   (ptr-write-u64 ,name 0 4)
                   (ptr-write-u64 ,name 16 ,text)
                   (ptr-write-u64 ,name 24 6)
                   (ptr-write-u64 ,text 0 ,(string-to-number "646e61676f6c" 16))
                   ,@(nreverse checks)
                   (ptr-write-u64 ,s 32 failed)
                   (syscall-direct 1 1 ,s 40 0 0 0)
                   (syscall-direct 60 failed 0 0 0 0 0)))))))
      (make-directory (file-name-directory output) t)
      (nelisp-link-units output
                         (list (nelisp-standalone--compile-to-unit "directcall-fixture.o" source))
                         "_start")
      (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
      (princ "DIRECTCALL-FIXTURE-COMPILED cases=4 checks=20\n"))))
