;;; nelisp-aot-predicate-facts-test.el --- Completed-plan must facts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-aot-predicate-facts-test--changes 0)
(defvar nelisp-aot-predicate-facts-test--enabled t)
(defun nelisp-aot-predicate-facts-test--record (old plan)
  (let ((q (funcall old plan)))
    (when (and q (not (equal q plan))) (cl-incf nelisp-aot-predicate-facts-test--changes)) q))
(defun nelisp-aot-predicate-facts-test--plan (&optional middle)
  (let ((bad (make-symbol "bad")) (good (make-symbol "good"))
        (work (make-symbol "work")) (done (make-symbol "done")))
    (append `((:mov r10 (:reg rdi)) (:alu + r10 (:imm 32))
              (:cmp r10 (:reg rsi)) (:jcc g ,bad) (:jmp ,work) (:label ,work))
            middle
            `((:mov r11 (:reg rdi)) (:alu + r11 (:imm 32))
              (:cmp r11 (:reg rsi)) (:jcc g ,bad) (:jmp ,good)
              (:label ,good) (:mov rax (:reg rdi)) (:jmp ,done)
              (:label ,bad) (:mov rax (:imm 0)) (:label ,done)))))
(ert-deftest nelisp-aot-predicate-facts/exact-snapshot-and-memory-identity ()
  (let* ((p (nelisp-aot-predicate-facts-test--plan '((:store (:mem rdx nil 1 0) (:reg rcx)))))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
    (should q) (should (= (- (length p) (length q)) 4))
    (should (= (cl-count :cmp q :key #'car) 1))
    (dolist (i p) (when (memq (car i) '(:jmp :store)) (should (memq i q))))))
(ert-deftest nelisp-aot-predicate-facts/must-join-and-register-definition ()
  (let* ((one (make-symbol "one")) (two (make-symbol "two"))
         (join (make-symbol "join")) (bad (make-symbol "bad")) (done (make-symbol "done"))
         (repeat (list :jcc 'e bad))
         (p `((:cmp rsi (:imm 0)) (:jcc e ,one) (:jmp ,two)
              (:label ,one) (:cmp rdi (:imm 0)) (:jcc e ,bad) (:jmp ,join)
              (:label ,two) (:jmp ,join) (:label ,join)
              (:cmp rdi (:imm 0)) ,repeat (:mov rax (:imm 1)) (:jmp ,done)
              (:label ,bad) (:mov rax (:imm 2)) (:label ,done))))
    (should (memq repeat (nelisp-aot-compiler--x86-predicate-facts-plan p))))
  (let* ((p (nelisp-aot-predicate-facts-test--plan '((:mov rdi (:reg rdx))))))
    ;; ABI destinations are outside the closed emitter destination grammar.
    (should-not (nelisp-aot-compiler--x86-predicate-facts-plan p))))
(ert-deftest nelisp-aot-predicate-facts/fresh-load-and-fallback-epochs ()
  (dolist (middle '(((:load r10 (:mem rdi nil 1 0))) ((:fallback))))
    (let* ((p (nelisp-aot-predicate-facts-test--plan middle))
           ;; Read the changed physical snapshot in the repeated expression.
           (start (cl-position :label p :key #'car)))
      (setcar (nthcdr (+ start 2 (length middle)) p) '(:mov r11 (:reg r10)))
      (let ((q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
        (should q) (should (= (cl-count :jcc q :key #'car) 2))
        (dolist (i p) (when (memq (car i) '(:load :fallback)) (should (memq i q)))))))
  (let* ((bad (make-symbol "bad")) (work (make-symbol "work")) (done (make-symbol "done"))
         (second (list :load 'rax '(:mem rdi nil 1 0)))
         (repeat (list :jcc 'e bad))
         (p `((:load rax (:mem rdi nil 1 0)) (:cmp rax (:imm 0)) (:jcc e ,bad) (:jmp ,work)
              (:label ,work) ,second (:cmp rax (:imm 0)) ,repeat
              (:mov rax (:imm 2)) (:jmp ,done) (:label ,bad) (:mov rax (:imm 3)) (:label ,done)))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
    (should (memq second q)) (should (memq repeat q))))
(ert-deftest nelisp-aot-predicate-facts/flags-remain-live ()
  (let* ((yes (make-symbol "yes")) (done (make-symbol "done"))
         (alu '(:alu + r10 (:imm 1)))
         (p `((:mov r10 (:reg rdi)) ,alu (:jcc g ,yes)
              (:mov rax (:imm 1)) (:jmp ,done) (:label ,yes) (:mov rax (:imm 2)) (:label ,done)))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
    (should (memq alu q)) (should (equal p q))))
(ert-deftest nelisp-aot-predicate-facts/known-true-and-independent-plans ()
  (let* ((work (make-symbol "work")) (good (make-symbol "good"))
         (bad (make-symbol "bad")) (done (make-symbol "done"))
         (p `((:cmp rdi (:imm 0)) (:jcc g ,work) (:jmp ,bad) (:label ,work)
              (:cmp rdi (:imm 0)) (:jcc g ,good) (:jmp ,bad)
              (:label ,good) (:mov rax (:reg rdi)) (:jmp ,done)
              (:label ,bad) (:mov rax (:imm 0)) (:label ,done)))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
    (should (= (- (length p) (length q)) 1))
    (should (= (cl-count :jcc q :key #'car) 1))
    (should (= (cl-count :jmp q :key #'car) 4))
    (dolist (i p) (when (eq (car i) :jmp) (should (memq i q))))
    (let ((independent `((:cmp rdi (:imm 0)) (:jcc g ,good) (:mov rax (:imm 3))
                         (:jmp ,done) (:label ,good) (:mov rax (:imm 4)) (:label ,done))))
      (should (equal independent (nelisp-aot-compiler--x86-predicate-facts-plan independent))))))
(ert-deftest nelisp-aot-predicate-facts/closed-preflight-and-cycles ()
  (let ((l (make-symbol "l")))
    (dolist (p (list '((:unknown)) '((:mov rax (:reg rsp))) '((:cmp rdi (:imm 1.0)))
                     '((:load rax (:mem rdi rsi 8 0))) '((:store (:mem rdi nil 1 0) (:imm 4294967295)))
                     `((:jmp ,l)) `((:label ,l) (:label ,l)) `((:label ,l) (:jmp ,l))
                     '((:jcc e missing)) '((:mov rax (:reg rdi) unexpected))))
      (should-not (nelisp-aot-compiler--x86-predicate-facts-plan p))))
  (let ((p (list '(:mov rax (:imm 1)))))
    (setcdr p p) (should-not (nelisp-aot-compiler--x86-predicate-facts-plan p)))
  (should-not (nelisp-aot-compiler--x86-predicate-facts-plan
               (make-list 8193 '(:mov rax (:imm 1))))))
(defun nelisp-aot-predicate-facts-test--source ()
  '(seq
    (defun slow (a b c d e f)
      (seq (ptr-write-u64 805306368 56 (+ (ptr-read-u64 805306368 56) 1))
           (logior (+ (+ (+ a b) (+ c d)) (+ e f)) 1)))
    (defun guarded (a b c d e f)
      (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow a b c d e f))))
        (if (= entry 0)
            (let ((snapshot (ptr-read-u64 805306368 8)))
              (if (> (+ snapshot 32) b) 0
                (seq (ptr-write-u64 805306368 16 c)
                     (if (> (+ snapshot 32) b) 77
                       (seq (ptr-write-u64 805306368 24 d)
                            (ptr-write-u64 805306368 32 e)
                            (ptr-write-u64 805306368 48 f) (- a b)))))) entry)))
    (defun fresh_guarded (a b c d e f)
      (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow a b c d e f))))
        (if (= entry 0)
            (let ((first (ptr-read-u64 805306368 8)))
              (if (> (+ first 32) b) 0
                (seq (ptr-write-u64 805306368 8 c)
                     (let ((second (ptr-read-u64 805306368 8)))
                       (if (> (+ second 32) b) 1 2))))) entry)))
    (defun wrapper (a b c d e f) (guarded a b c d e f))
    (defun fresh_wrapper (a b c d e f) (fresh_guarded a b c d e f))
    (defun effects (a b c d e f)
      (guarded (seq (ptr-write-u64 805306368 40 (+ (* (ptr-read-u64 805306368 40) 10) 1)) a)
               (seq (ptr-write-u64 805306368 40 (+ (* (ptr-read-u64 805306368 40) 10) 2)) b) c d e f))
    (defun spwrapper () (wrapper (aot-current-sp) (aot-current-sp) 0 0 0 0))
    (defun wordwrapper (w)
      (if (= (sexp-tag w) 7) (wrapper w 4096 w 0 0 0)
        (if (= (sexp-tag w) 9) (wrapper w 4096 w 0 0 0) 77)))))
(ert-deftest nelisp-aot-predicate-facts/native-fullword-order-abi-and-disabled-gauge ()
  (let* ((dir (make-temp-file "predicate-facts-" t))
         (c (expand-file-name "probe.c" dir)) (o (expand-file-name "probe.o" dir))
         (exe (expand-file-name "probe" dir)) (changes nil) (objects nil))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\n#include <sys/mman.h>\n#include <stdio.h>\ntypedef uint64_t U;extern U wrapper(U,U,U,U,U,U),effects(U,U,U,U,U,U),fresh_wrapper(U,U,U,U,U,U),spwrapper(void),wordwrapper(U);\nint main(void){volatile U*p=mmap((void*)0x30000000,4096,3,0x22|0x100000,-1,0);if(p!=(void*)0x30000000)return 99;U v[]={0,1,2,6,~0ULL,0xffffffffULL,0x100000001ULL,0x8000000000000000ULL,0x7fffffffffffffffULL,0x4000000000000002ULL,0xabcdef0123456786ULL};unsigned n=0;for(unsigned i=0;i<11;i++)for(unsigned j=0;j<11;j++)for(unsigned cold=0;cold<2;cold++){U a=v[i],b=v[j],c=0x8000000000000007ULL,d=0x123456789abcdef6ULL,e=~a,f=b^0xfedcba9876543210ULL;U sum=a+b+c+d+e+f,expected=cold?(sum|1):((int64_t)(a+32)>(int64_t)b?0:a-b);p[0]=cold;p[1]=a;p[2]=p[3]=0xdeadbeef;p[5]=p[7]=0;U got=effects(a,b,c,d,e,f);if(got!=expected||p[5]!=12||p[7]!=cold)return 1;if(!cold&&(int64_t)(a+32)<=(int64_t)b){if(p[2]!=c||p[3]!=d||p[4]!=e||p[6]!=f)return 2;}else if(p[2]!=0xdeadbeef||p[3]!=0xdeadbeef)return 3;n++;p[1]=a;p[7]=0;expected=cold?(sum|1):((int64_t)(a+32)>(int64_t)b?0:((int64_t)(c+32)>(int64_t)b?1:2));if(fresh_wrapper(a,b,c,d,e,f)!=expected||p[7]!=cold)return 4;if(p[1]!=((!cold&&(int64_t)(a+32)<=(int64_t)b)?c:a))return 5;n++;}p[0]=p[1]=0;if(spwrapper()!=8)return 6;n++;U buf[4] __attribute__((aligned(8)))={9,0,0,0};U words[]={2,(U)(uintptr_t)buf+2,(U)(uintptr_t)buf+6};for(unsigned k=0;k<3;k++){p[1]=0;if(wordwrapper(words[k])!=words[k]-4096||p[2]!=words[k])return 7;n++;}register U q1 asm(\"rbx\")=0xabcdef1234567801ULL,q2 asm(\"r12\")=0x123456789abcdef0ULL,q3 asm(\"r13\")=0xfeedfacecafebeefULL,q4 asm(\"r14\")=0x76543210abcdef09ULL,q5 asm(\"r15\")=0xfedcba9876543210ULL;asm volatile(\"\":\"+r\"(q1),\"+r\"(q2),\"+r\"(q3),\"+r\"(q4),\"+r\"(q5));p[1]=0;wrapper(1,40,3,4,5,6);asm volatile(\"\":\"+r\"(q1),\"+r\"(q2),\"+r\"(q3),\"+r\"(q4),\"+r\"(q5));if(q1!=0xabcdef1234567801ULL||q2!=0x123456789abcdef0ULL||q3!=0xfeedfacecafebeefULL||q4!=0x76543210abcdef09ULL||q5!=0xfedcba9876543210ULL)return 8;n++;printf(\"NATIVE %u\\n\",n);return 0;}\n"))
          (dolist (enabled '(t nil))
            (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
                  (nelisp-aot-compiler--x86-predicate-facts (and enabled nelisp-aot-predicate-facts-test--enabled))
                  (nelisp-aot-compiler--x86-trivial-call-folding nil)
                  (nelisp-aot-compiler--x86-partial-call-folding nil)
                  (nelisp-aot-predicate-facts-test--changes 0))
              (advice-add 'nelisp-aot-compiler--x86-predicate-facts-plan :around #'nelisp-aot-predicate-facts-test--record)
              (unwind-protect (nelisp-aot-compile-to-object (nelisp-aot-predicate-facts-test--source) o)
                (advice-remove 'nelisp-aot-compiler--x86-predicate-facts-plan #'nelisp-aot-predicate-facts-test--record))
              (push nelisp-aot-predicate-facts-test--changes changes))
            (push (with-temp-buffer (insert-file-contents-literally o) (secure-hash 'sha256 (current-buffer))) objects)
            (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-no-pie" c o "-o" exe)))
            (with-temp-buffer (should (= 0 (call-process exe nil t nil)))
              (should (equal (buffer-string) "NATIVE 489\n")))
            (message "predicate native489 selector%s PASS" (if enabled "-on" "-off")))
          ;; These gauges run only after BOTH native semantic controls pass.
          (should (> (cadr changes) 0)) (should (= (car changes) 0))
          (should-not (equal (car objects) (cadr objects))))
      (delete-directory dir t))))
(provide 'nelisp-aot-predicate-facts-test)
