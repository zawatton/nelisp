;;; standalone-abi-environment-watch-check.el --- WORD writer callbacks -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(load (expand-file-name "packages/nelisp-emacs-foundation/src/emacs-parity-misc.el") nil t)
(defvar abi-environment-events nil)
(defun abi-environment-watch (symbol value operation where)
  (push (list symbol value operation (null where)) abi-environment-events))
(add-variable-watcher 'abi-environment-watched #'abi-environment-watch)
(makunbound 'abi-environment-watched)
(setq abi-environment-events nil)
(defvar abi-environment-watched nil)
(makunbound 'abi-environment-watched)
(defvar abi-environment-watched 0)
(set 'abi-environment-watched -7)
(unless (equal (reverse abi-environment-events)
               '((abi-environment-watched nil set t)
                 (abi-environment-watched nil makunbound t)
                 (abi-environment-watched 0 set t)
                 (abi-environment-watched -7 set t)))
  (error "default writer callback sequence changed: %S" abi-environment-events))
(remove-variable-watcher 'abi-environment-watched #'abi-environment-watch)
(setq abi-environment-events nil)
(add-variable-watcher 'abi-environment-watched-alias #'abi-environment-watch)
(defvaralias 'abi-environment-watched-alias 'abi-environment-watched)
(unless (equal abi-environment-events
               '((abi-environment-watched-alias abi-environment-watched defvaralias t)))
  (error "alias writer callback changed: %S" abi-environment-events))
(remove-variable-watcher 'abi-environment-watched-alias #'abi-environment-watch)
(defun abi-environment-reject (&rest args) (error "watch rejected"))
(add-variable-watcher 'abi-environment-rejected #'abi-environment-reject)
(unless (eq (condition-case nil (defvar abi-environment-rejected 19)
              (error 'caught)) 'caught)
  (error "callback error did not propagate"))
(remove-variable-watcher 'abi-environment-rejected #'abi-environment-reject)
(princ "ABI-ENVIRONMENT-WATCHERS checks=3 PASS\n")
