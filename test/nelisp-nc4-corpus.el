;;; nelisp-nc4-corpus.el --- transcript over the nc4 handler forms  -*- lexical-binding: t; -*-
;; nativecomp N3 (nc4).  The functions of test/nelisp-nc4-fx.el (catch /
;; throw / condition-case / unwind-protect / save-*) on non-local exits,
;; signal data, unwind order, dynamic bindings undone at landings, throws
;; through native frames, quit, loops over handlers and collections inside
;; handlers.  tools/ai/nc4-check.sh runs it with the VM off (interpreter),
;; with the records on the word VM (NC_MODE=vm), as built (native), with the
;; mutant (NC_MODE=mutant) and through the fxir reference evaluator
;; (NC_FXIR=1); NC_GC=1 collects between cases.  Runs on GNU Emacs too.
(when (getenv "NC_HOTPATCH") (load (expand-file-name "tools/ai/nc4-hotpatch.el") nil t))
(defvar nc4--hot nil)
(load (expand-file-name "test/nelisp-nc4-fx.el") nil t)
(defvar nc4-cases nil)
(defmacro nc4 (label &rest body)
  `(push (cons ,label (lambda () ,@body)) nc4-cases))
(defun nc4-gc () (when (getenv "NC_GC") (garbage-collect)))
(defmacro nc4-err (form) `(condition-case e ,form (error (list 'err (car e) (cdr e)))))

(nc4 "catch-basic" (list (nc4-catch-basic 5) (nc4-catch-basic 0) (nc4-catch-basic -1)))
(nc4 "catch-dyn" (list (nc4-catch-dyn 'a 1) (nc4-catch-dyn 'b 2)))
(nc4 "catch-nested" (list (nc4-catch-nested 1) (nc4-catch-nested 2)))
(nc4 "throw-nowhere" (nc4-err (nc4-throw-nowhere 7)))
(nc4 "throw-outer-caller" (catch 'nc4-nowhere (nc4-throw-nowhere 8)))
(nc4 "catch-stack" (list (nc4-catch-stack t) (nc4-catch-stack nil)))
(nc4 "cc-basic" (list (nc4-cc-basic '(1 2)) (nc4-cc-basic 5) (nc4-cc-basic "s")))
(nc4 "cc-order" (mapcar #'nc4-cc-order '(arith-error error wrong-type-argument nc4-err quit void-variable)))
(nc4 "cc-nil-var" (list (nc4-cc-nil-var 2) (nc4-cc-nil-var 0)))
(nc4 "cc-success" (list (nc4-cc-success 1) (nc4-cc-success 'a)))
(nc4 "cc-list-spec" (list (nc4-cc-list-spec 'nc4-undefined-fn) (nc4-cc-list-spec (lambda () (car 1)))
                          (nc4-cc-list-spec (lambda () 'fine)) (nc4-cc-list-spec (lambda () (signal 'quit nil)))
                          (nc4-err (nc4-cc-list-spec (lambda () (error "other"))))))
(nc4 "cc-quit" (nc4-cc-quit nil))
(nc4 "cc-resignal" (nc4-cc-resignal 3))
(nc4 "cc-stack" (list (nc4-cc-stack '(5)) (nc4-cc-stack 7)))
(nc4 "cc-data" (nc4-cc-data 'x))
(nc4 "cc-closure" (nc4-cc-closure 'y))
(nc4 "uwp-order" (list (nc4-uwp-order t) (nc4-uwp-order nil)))
(nc4 "uwp-normal" (nc4-uwp-normal 4))
(nc4 "uwp-cleanup-error" (nc4-uwp-cleanup-error 'e))
(nc4 "uwp-cleanup-throw" (nc4-uwp-cleanup-throw 't1))
(nc4 "uwp-keeps-throw" (nc4-uwp-keeps-throw 9))
(nc4 "uwp-escapes" (let ((r (nc4-err (nc4-uwp-cleanup-error 'z)))) (list r nc4-dv)))
(nc4 "dyn-cc" (nc4-dyn-cc 1))
(nc4 "dyn-uwp" (nc4-dyn-uwp 'bound))
(nc4 "deep-catch" (list (nc4-deep-catch 0) (nc4-deep-catch 5) (nc4-deep-catch 40)))
(nc4 "deep-cc" (nc4-deep-cc 6))
(nc4 "loop-catch" (nc4-loop-catch 3000))
(nc4 "loop-cc" (nc4-loop-cc 3000))
(nc4 "loop-uwp" (nc4-loop-uwp 3000))
(nc4 "gc-in-handler" (nc4-gc-in-handler 'gc))
(nc4 "save-excursion" (nc4-save-excursion 8))
(nc4 "save-restriction" (nc4-save-restriction 6))
(nc4 "save-current-buffer" (nc4-save-current-buffer "xyz"))
(nc4 "save-match-data" (nc4-save-match-data "aabbbcc"))
(nc4 "catch-value-types" (nc4-catch-value-types 'sy))
(nc4 "handler-args" (list (nc4-handler-args 6 3) (nc4-handler-args 6 0)))
(nc4 "catch-nil-tag" (nc4-err (catch nil (nc4-thrower nil 1))))
(nc4 "throw-through-catches" (catch 'outer (nc4-catch-dyn 'inner-tag (nc4-thrower 'outer 'passed))))

(when (and (fboundp 'nelisp--fx-register) (not (getenv "NELISP_FX_DISABLE")))
  (let ((nc4--hot nc4-names) (nelisp--fx-want-ir (or (getenv "NC_FXIR") nelisp--fx-want-ir)))
    (ignore nc4--hot)
    (dolist (n nc4-names) (nelisp--fx-register n))))
(when (getenv "NC_FXIR")
  (load (expand-file-name "test/nelisp-fxir-eval.el") nil t)
  ;; A native record holds -(16+ID) as NLOCALS: give it its compiled count back.
  (when (fboundp 'nelisp-nc-select) (dolist (n nc4-names) (nelisp-nc-select n 'vm)))
  (let ((k 0)) (dolist (n nc4-names) (when (nelisp-fxir-install n) (setq k (1+ k))))
       (princ (format "FXIR installed=%d\n" k))))
(when (and (getenv "NC_MODE") (boundp 'nelisp-nc--table))
  (let ((mode (intern (getenv "NC_MODE"))) (n 0))
    (dolist (row nelisp-nc--table)
      (when (and (fboundp (car row)) (not (memq :mutant row)))
        (when (nelisp-nc-select (car row) (if (eq mode 'mutant) 'native mode)) (setq n (1+ n)))))
    (when (eq mode 'mutant)
      (dolist (row nelisp-nc--table)
        (when (memq :mutant row) (nelisp-nc-select (car row) 'mutant))))
    (princ (format "MODE %s selected=%d\n" mode n))))
(when (getenv "NC_REPORT")
  (princ (format "NC4NATIVE %d\n" (length (seq-filter (lambda (n) (memq n (and (boundp 'nelisp-nc--converted) nelisp-nc--converted)))
                                                       nc4-names))))
  (princ (format "NC4FX %d\n" (length (seq-filter (lambda (n) (let* ((f (symbol-function n)) (r (and (eq (car-safe f) 'closure) (gethash (nthcdr 3 f) nelisp--fx-table)))) (vectorp r)))
                                                   nc4-names)))))
;; NC_HMUTANT=1: the negative control on the handler path itself.  The
;; condition spec `arith-error' of `nc4-cc-order''s first clause is replaced
;; in its live code vector, which the VM and the native code both read
;; (PUSHCONDITIONCASE's operand), so its transcript must change.
(when (and (getenv "NC_HMUTANT") (boundp 'nelisp--fx-table))
  (let* ((f (symbol-function 'nc4-cc-order))
         (rec (and (eq (car-safe f) 'closure) (gethash (nthcdr 3 f) nelisp--fx-table)))
         (code (and (vectorp rec) (aref rec 0))) (i 0) (hit 0))
    (when code
      (while (< i (length code))
        (when (eq (aref code i) 'arith-error) (aset code i 'void-variable) (setq hit (1+ hit)))
        (setq i (1+ i))))
    (princ (format "HMUTANT %d\n" hit))))
(dolist (c (reverse nc4-cases))
  (nc4-gc)
  (princ (format "%s => %s\n" (car c)
                 (condition-case e (format "%S" (funcall (cdr c))) (error (format "ERR %S" e))))))
