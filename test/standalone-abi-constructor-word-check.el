;;; standalone-abi-constructor-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0))
  (dolist (value (list nil t 0 -7 1.25 "constructor" '(a . b) [nil t]
                       (make-symbol "constructor")))
    (let* ((captured value) (fn (lambda () captured)))
      (unless (functionp fn) (error "lambda object is not callable"))
      (garbage-collect)
      (unless (eq (funcall fn) value) (error "lambda captured WORD changed"))
      (setq checked (+ checked 2))))
  (dolist (mode '(nil t))
    (dolist (form '((lambda () nil) (lambda () t) (lambda () 0) (lambda () -7)
                    (lambda (x) x) (lambda (&optional x) x) (lambda (&rest xs) xs)))
      (let ((fn (eval (list 'function form) mode)))
        (unless (functionp fn) (error "lambda mode produced a non-function"))
        (setq checked (+ checked 1)))))
  (dolist (definition '((defun abi-constructor-plain (x) x)
                        (defun abi-constructor-declared (x) (declare (pure t)) x)
                        (defmacro abi-constructor-macro (x) x)))
    (unless (eq (eval definition t) (nth 1 definition))
      (error "definer result changed"))
    (setq checked (+ checked 1)))
  (unless (= (abi-constructor-plain 17) 17) (error "plain function changed"))
  (unless (= (abi-constructor-declared 23) 23) (error "declared function changed"))
  (unless (= (abi-constructor-macro 29) 29) (error "macro result changed"))
  (setq checked (+ checked 3))
  (princ (format "ABI-CONSTRUCTOR-WORD checked=%d PASS\n" checked)))
