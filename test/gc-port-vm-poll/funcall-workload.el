;;; bytecode-workload.el --- same frozen GNU bytecode in both runtimes -*- lexical-binding: t; -*-
(let* ((file (getenv "CODEGEN_RUNTIME_BYTECODE"))
       (data (with-temp-buffer (insert-file-contents file)
                               (goto-char (point-min)) (read (current-buffer))))
       (name (getenv "CODEGEN_RUNTIME_WORKLOAD"))
       (n (string-to-number (getenv "CODEGEN_RUNTIME_N")))
       (fn (cdr (assq (intern name) data)))
       (expected (if (equal name "while") n (+ n 2))))
  (fset 'cr-add (cdr (assq 'add data)))
  (unless (= (funcall fn 1000) (if (equal name "while") 1000 1002))
    (error "S5 bytecode warmup failed"))
  (garbage-collect)
  (let* ((start (float-time)) (answer (funcall fn n))
         (collected (garbage-collect))
         (seconds (- (float-time) start)))
    (unless (= answer expected) (error "S5 %s wrong result %s" name answer))
    (princ (format "S5-WORK %s %d %d %.9f\n" name n answer seconds))))
