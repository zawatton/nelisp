(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)

(defvar nelisp-aot-trivial-call-test--calls nil)
(defun nelisp-aot-trivial-call-test--record (fn buf name)
  (push name nelisp-aot-trivial-call-test--calls)
  (funcall fn buf name))
(defun nelisp-aot-trivial-call-test--object (program path &optional disabled)
  (let ((nelisp-aot-compiler--x86-trivial-call-folding (not disabled))
        ;; Explicitly RAW C-ABI units do not need the object frontend's
        ;; optional synthetic Lisp dispatcher boundary.
        (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (nelisp-aot-trivial-call-test--calls nil))
    (advice-add 'nelisp-asm-x86_64-call-rel32 :around #'nelisp-aot-trivial-call-test--record)
    (unwind-protect
        (progn (nelisp-aot-compile-to-object program path)
               (copy-sequence nelisp-aot-trivial-call-test--calls))
      (advice-remove 'nelisp-asm-x86_64-call-rel32 #'nelisp-aot-trivial-call-test--record))))

(ert-deftest nelisp-aot-trivial-call/fullword-effects-frame-native-ABI ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "trivial-call-" t))
         (c (expand-file-name "caller.c" dir)) (co (expand-file-name "caller.o" dir))
         (obj (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (params '(a b c d e f))
         (cases '(0 1 -1 2 6 4294967295 -4294967296 1099511627783
                    -1099511627783 9223372036854775807 -9223372036854775808))
         (mask (1- (ash 1 64))) (defs nil) (checks nil))
    (unwind-protect
        (progn
          (dotimes (i 7)
            (let* ((ps (cl-subseq params 0 i)) (name (intern (format "identity%d" i)))
                   (wrapper (intern (format "wrapper%d" i)))
                   (value (if (= i 0) -9223372036854775808 (car (last ps)))))
              (push `(defun ,name ,ps ,value) defs)
              (push `(defun ,wrapper ,ps (,name ,@ps)) defs)
              (push (format "extern U %s(%s);extern U %s(%s);\n" name
                            (if ps (mapconcat (lambda (_) "I") ps ",") "void") wrapper
                            (if ps (mapconcat (lambda (_) "I") ps ",") "void")) checks)))
          (setq defs (append (nreverse defs)
                     '((defun literal () 4294967295)
                       (defun literal_wrapper () (literal))
                       (defun constant_one (x) 4294967295)
                       (defun constant_effect (p)
                         (constant_one (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) 1))))
                       (defun effects (p v)
                         (identity2
                          (seq (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) 1)) 19)
                          (seq (ptr-write-u64 p 8 (+ (ptr-read-u64 p 0) 100)) v)))
                       (defun frame (p)
                         (identity2
                          (seq (ptr-write-u64 p 0 (aot-current-sp)) 0)
                          (seq (ptr-write-u64 p 8 (aot-current-sp)) (aot-current-sp)))))))
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef int64_t I;\n")
            (insert (apply #'concat checks))
            (insert "extern U effects(U*,I),frame(U*),literal_wrapper(void),constant_effect(U*);\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\nU run(void){U fail=0,p[2];\n")
            (dolist (v cases)
              (dotimes (i 7)
                (let* ((expected (if (= i 0) (ash 1 63) (logand v mask)))
                       (args (mapconcat (lambda (_) (format "(I)UINT64_C(%d)" (logand v mask)))
                                        (cl-subseq params 0 i) ",")))
                  (insert (format "fail|=wrapper%d(%s)!=UINT64_C(%d);fail|=identity%d(%s)!=UINT64_C(%d);\n"
                                  i args expected i args expected))))
              (insert (format "p[0]=1;p[1]=0;fail|=effects(p,(I)UINT64_C(%d))!=UINT64_C(%d)||p[0]!=2||p[1]!=102;\n"
                              (logand v mask) (logand v mask)))
              (insert "p[0]=1;fail|=constant_effect(p)!=UINT64_C(4294967295)||p[0]!=2;\n"))
            (insert "fail|=literal_wrapper()!=UINT64_C(4294967295);p[0]=p[1]=0;U r=frame(p);fail|=r!=p[1]||p[0]-p[1]!=8;return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-stack-protector" "-fno-pie" "-c" c "-o" co)))
          (dolist (disabled '(nil t))
            (let ((calls (nelisp-aot-trivial-call-test--object `(seq ,@defs) obj disabled)))
              (message "Trivial call control disabled=%S retained=%S" disabled calls)
              (dotimes (i 7)
                (should (eq (not (memq (intern (format "identity%d" i)) calls)) (not disabled))))
              (should (eq (not (memq 'literal calls)) (not disabled))))
            (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" co obj "-o" bin)))
            (should (= 0 (call-process bin nil nil nil))))
          (message "Trivial calls: 178 GNU fullword/effect/frame C ABI checks each, enabled and disabled; real removed-call gauge"))
      (delete-directory dir t))))

(ert-deftest nelisp-aot-trivial-call/scope-independent-units-and-executable-pass ()
  (let* ((dir (make-temp-file "trivial-call-scope-" t)) (obj (expand-file-name "unit.o" dir))
         (exe (expand-file-name "unit" dir))
         (a '(seq (defun same (x) x) (defun caller (x) (same x))))
         (b '(seq (defun same (x) (+ x 1)) (defun caller (x) (same x)))))
    (unwind-protect
        (progn
          (should-not (memq 'same (nelisp-aot-trivial-call-test--object a obj)))
          (should (memq 'same (nelisp-aot-trivial-call-test--object b obj)))
          (should-not nelisp-aot-compiler--x86-trivial-call-facts)
          (nelisp-aot-compile-sexp '(seq (defun same (x) x) (exit (- (same 19) 19))) exe)
          (should (= 0 (call-process exe nil nil nil)))
          (nelisp-aot-compile-sexp '(seq (defun same (x) (+ x 1)) (exit (- (same 19) 20))) exe)
          (should (= 0 (call-process exe nil nil nil)))
          (should-not nelisp-aot-compiler--x86-trivial-call-facts))
      (delete-directory dir t))))

(ert-deftest nelisp-aot-trivial-call/closed-metadata-and-callsite-fallbacks ()
  (let* ((ref (nelisp-aot-compiler--make-ir 'ref :var 'a :slot 0 :class 'gp))
         (d (nelisp-aot-compiler--make-ir 'defun :name 'same :params '(a) :param-regs '(rdi)
                                        :param-class 'gp :param-classes '(gp) :fixed-param-count 1 :body ref))
         (node (nelisp-aot-compiler--make-ir 'call :name 'same :args (list ref)))
         (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--x86-trivial-call-facts (nelisp-aot-compiler--x86-trivial-call-facts (list d))))
    (should (gethash 'same nelisp-aot-compiler--x86-trivial-call-facts))
    (should-not (gethash 'same (nelisp-aot-compiler--x86-trivial-call-facts (list d d d))))
    (dolist (change '((:variadic . t) (:rest-p . t) (:internal-entry . t) (:internal-hidden . (0))
                      (:gc-root-slots . (0)) (:self-tco-raw . t) (:fixed-param-count . 2)
                      (:param-class . f64) (:param-classes . (f64)) (:param-regs . (rsi))))
      (should-not (gethash 'same (nelisp-aot-compiler--x86-trivial-call-facts
                                  (list (nelisp-aot-compiler--ir-with d (car change) (cdr change)))))))
    (should-not (gethash 'same (nelisp-aot-compiler--x86-trivial-call-facts
                                (list (nelisp-aot-compiler--ir-with d :body
                                        (nelisp-aot-compiler--ir-with ref :root-p t))))))
    (cl-labels ((emits-call (n)
                 (let ((called nil))
                   (cl-letf (((symbol-function 'nelisp-asm-x86_64-call-rel32) (lambda (_ name) (setq called name))))
                     (nelisp-aot-compiler--emit-named-gp-call-x86 n (nelisp-asm-x86_64-make-buffer 'sysv)))
                   called)))
      (should-not (emits-call node))
      (dolist (change '((:args) (:varargs-p . t) (:fn-value . t) (:internal-boundary-disp . 8)
                        (:ret-class . f64)))
        (should (emits-call (nelisp-aot-compiler--ir-with node (car change) (cdr change)))))
      (should (emits-call (nelisp-aot-compiler--ir-with node :args
                           (list (nelisp-aot-compiler--ir-with ref :class 'f64)))))
      (let ((nelisp-aot-compiler--abi 'win64)) (should (emits-call node)))
      (let ((nelisp-aot-compiler--checked-arith t)) (should (emits-call node)))
      (cl-letf (((symbol-function 'nelisp-aot-compiler--lisp-values-p) (lambda () t)))
        (should (emits-call node)))
      (let ((nelisp-aot-compiler--native-emit-enabled t))
        (cl-letf (((symbol-function 'nl-jit-call-out-2) #'ignore)) (should (emits-call node)))))))
