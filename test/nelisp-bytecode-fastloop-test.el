;;; nelisp-bytecode-fastloop-test.el --- Fast-loop coverage -*- lexical-binding: t; -*-

(require 'nelisp-bytecode-stackset-fast-test)

(defun fcl--admitted (raw)
  (let ((form (sst--find (sst--function 'wf_bytecode_execute_frame)
                         (lambda (x) (equal (car-safe x) '=)
                           (and (eq (car-safe x) '=)
                                (eq (car-safe (cadr x)) 'if)
                                (sst--find (cadr x) (lambda (y) (equal y '(< first-op 64)))))))))
    (eval (sst--host-form `(let ((first-op ,raw)) ,form)) t)))

(ert-deftest fcl-a-starters ()
  (dolist (raw '(32 33 34 35 36 37 64 65))
    (should (fcl--admitted raw)))
  (dolist (raw '(38 39 135 179 184)) (should-not (fcl--admitted raw))))

(ert-deftest fcl-probe-existing-leaf ()
  (let ((r (sst--run [0 138] 1 4)))
    (should (= (plist-get r :state) (+ (ash 1 17) 2))))
  (let ((r (sst--run [0 138] 4 4)))
    (should (= (plist-get r :state) 4))
    (should-not (plist-get r :stack-writes))))

(defun fcl--run (code stack &optional constants outer cells depth)
  "Execute production IR with checked memory; OUTER selects its real arm."
  (let* ((data 1024) (mem 4096) (cdata 2048) (cell 8192)
         (depth (or depth 16)) (sp (length stack))
         (words (make-hash-table :test #'eql)) (writes nil) (fuel 100000)
         (raw (aref code 0))
         (width (cond ((memq raw '(7 129 131 132 133 134)) 2)
                      ((memq raw '(6 182)) 1) (t 0)))
         (operand (if (> (length code) width)
                      (cond ((= width 2) (+ (aref code 1) (* 256 (aref code 2))))
                            ((= width 1) (aref code 1)) (t raw)) 0)))
    (cl-loop for i from -1 to (+ depth 8) do (puthash (+ mem (* i 8)) 3 words))
    (cl-loop for w in stack for i from 0 do (puthash (+ mem (* i 8)) w words))
    (cl-loop for w in constants for i from 0 do (puthash (+ cdata (* i 8)) w words))
    (puthash cell 1 words) (puthash (+ cell 8) (1+ (* mem 4)) words)
    (cl-loop for i below 16 do (puthash (+ 12000 (* i 8)) 3 words))
    (dolist (pair cells) (puthash (car pair) (cdr pair) words))
    (let ((before (copy-hash-table words)))
      (cl-labels
          ((rd (p o) (let ((a (+ p o)))
                       (if (not (gethash a words)) (error "Invalid read %s" a)
                         (gethash a words))))
           (wr (p o w) (let ((a (+ p o)))
                         (unless (gethash a words) (error "Invalid write %s" a))
                         (push (cons a w) writes) (puthash a w words)))
           (byte (p o) (if (= p data)
                            (progn (unless (and (<= 0 o) (< o (length code)))
                                     (error "Invalid byte read %s %s" p o)) (aref code o))
                          (rd p o)))
           (payload (w) (logand w -8))
           (tag (w) (cond ((= w 3) 0) ((= w 7) 1) ((= (logand w 3) 1) 2)
                          ((= (logand w 7) 2) 7) (t (rd w 0))))
           (nilp (w) (if (= (tag w) 0) 1 0))
           (consp (w) (if (= (tag w) 7) 1 0))
           (slot (w i) (rd (payload w) (* (1+ i) 8)))
           (unword (w) (cond ((= w 3) nil) ((= (logand w 3) 1) (ash w -2))
                             ((= (tag w) 7) (cons (unword (rd (payload w) 0))
                                                       (unword (rd (payload w) 8)))) (t w))))
        (cl-letf (((symbol-function 'sst--truth)
                   (lambda (value)
                     (setq fuel (1- fuel))
                     (when (< fuel 0) (error "IR predicate budget exhausted before poll/exit"))
                     (and value (not (equal value 0)))))
                  ((symbol-function 'heap-read-u8) #'byte)
                  ((symbol-function 'heap-read-u64) #'rd)
                  ((symbol-function 'ptr-read-u64) #'rd)
                  ((symbol-function 'ptr-write-u64) #'wr)
                  ((symbol-function 'wf_bytecode_w_tag) #'tag)
                  ((symbol-function 'wf_bytecode_w_nilp) #'nilp)
                  ((symbol-function 'wf_bytecode_w_consp) #'consp)
                  ((symbol-function 'nl_word_payload) #'payload)
                  ((symbol-function 'nl_cons_car_word) (lambda (w) (rd (payload w) 0)))
                  ((symbol-function 'nl_cons_cdr_word) (lambda (w) (rd (payload w) 8)))
                  ((symbol-function 'wf_bytecode_w_eq) (lambda (a b _s) (if (= a b) 1 0)))
                  ((symbol-function 'wf_bytecode_w_eqw) (lambda (a b) (if (= a b) 1 0)))
                  ((symbol-function 'sexp-tag) #'tag)
                  ((symbol-function 'bf_hash_table_p_raw) (lambda (w) (if (= w 24578) 1 0)))
                  ((symbol-function 'nl_ht_meta_slot) (lambda (w) (rd (payload w) 0)))
                  ((symbol-function 'nl_ht_marker_word) #'slot)
                  ((symbol-function 'nl_vector_slot_word) #'slot)
                  ((symbol-function 'nl_ht_int) (lambda (w i) (ash (slot w i) -2)))
                  ((symbol-function 'vector-len) (lambda (w) (rd (payload w) 0)))
                  ((symbol-function 'heap-sexp-length) (lambda (w) (rd w 24)))
                  ((symbol-function 'heap-sexp-data) (lambda (w) (rd w 16)))
                  ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2)))
                  ((symbol-function 'nl_ht_find_in)
                   (lambda (_table key)
                     (let* ((pairs (slot 32774 11))
                            (keys (cl-loop for i below (ash (slot 32774 3) -2)
                                           collect (slot pairs (* i 2))))
                            (i (cl-position key keys :test #'eql)))
                       (if i (1+ i) 0))))
                  ;; Switchfast: opcode 183 reads the table's test mode and
                  ;; looks the key up through the live index.  The fake table
                  ;; names its test at 60000 ("eq" = 1, anything else declines).
                  ((symbol-function 'nl_ht_test_mode)
                   (lambda (_table)
                     (if (and (eql (gethash 60000 words) 101)
                              (eql (gethash 60001 words) 113))
                         1 0)))
                  ((symbol-function 'wf_bytecode_switch_find)
                   (lambda (table key _mode)
                     (funcall (symbol-function 'nl_ht_find_in) table key)))
                  ((symbol-function 'nl_ht_entry_value)
                   (lambda (_table entry) (slot (slot 32774 11) (1+ (* 2 (1- entry))))))
                  ((symbol-function 'wf_bytecode_switch)
                   (eval (cons 'lambda (cddr (sst--host-form (sst--function 'wf_bytecode_switch)))) t))
                  ((symbol-function 'wf_bytecode_w_memq)
                   (eval (cons 'lambda (cddr (sst--host-form (sst--function 'wf_bytecode_w_memq)))) t))
                  ((symbol-function 'wf_bytecode_w_view) (lambda (w _s) w))
                  ((symbol-function 'wf_bytecode_w_boxed)
                   (lambda (_env _mem _sp _argc op _s)
                     (should (= op 56))
                     (let ((v (nth (unword (rd mem (* (- sp 2) 8)))
                                   (unword (rd mem (* (1- sp) 8))))))
                       (wr mem (* (- sp 2) 8) (if v (1+ (* v 4)) 3)) 0)))
                  ((symbol-function 'wf_bytecode_call_primitive)
                   (lambda (_env _mem _sp op)
                     (should (= op 158))
                     (let* ((key (unword (rd mem (* (- sp 2) 8))))
                            (lst (rd mem (* (1- sp) 8)))
                            (match (assq key (unword lst))) (cur lst))
                       (while (and match (/= cur 3)
                                   (not (equal (unword (rd (payload cur) 0)) match)))
                         (setq cur (rd (payload cur) 8)))
                       (wr mem (* (- sp 2) 8) (if match (rd (payload cur) 0) 3)) 0)))
                  ((symbol-function 'bf_length_checked)
                   (lambda (w out) (wr out 0 (1+ (* 4 (length (unword w))))) 0))
                  ((symbol-function 'wf_bytecode_w_store)
                   (lambda (_mem index p) (wr mem (* index 8) (rd p 0))))
                  ((symbol-function 'wf_bytecode_scratch) (lambda (_p) 12000))
                  ((symbol-function 'wf_bytecode_back_edge) (lambda (_p) 0)))
          (let* ((state
                  (if outer
                      (eval (sst--host-form
                             `(let ((sp ,sp) (depth ,depth) (operand ,operand)
                                    (mem ,mem) (top ,(+ mem (* (1- sp) 8)))
                                    (next ,(+ mem (* (- sp 2) 8))) (base ,(if (< raw 8) 0 raw))
                                    (raw ,raw) (pc ,(1+ width)) (code-len ,(length code))
                                    (cdata ,cdata) (nconst ,(length constants)) (curfp ,cell)
                                    (done 0) (bad-op 0) (env 0))
                                ,outer (list pc sp done))) t)
                    (apply (eval (cons 'lambda (cddr (sst--host-form
                                                     (sst--function 'wf_bytecode_w_fast_run)))) t)
                           (list data (length code) mem depth cdata (length constants) 0 sp 0 cell))))
                 (pc (if outer (car state) (ash state -17)))
                 (new-sp (if outer (cadr state) (logand state 131071))))
            (list :pc pc :sp new-sp :before before :after words
                  :writes (cl-remove-if (lambda (x) (>= (car x) cell)) writes))))))))

(defun fcl--outer (condition)
  (let ((form (sst--find (sst--function 'wf_bytecode_execute_frame)
                        (lambda (x) (or (and (eq (car-safe x) 'if)
                                              (equal (cadr x) condition))
                                        (equal (car-safe x) condition))))))
    (unless form (error "Missing outer arm %S" condition))
    (if (eq (car form) 'if) (caddr form) (cons 'seq (cdr form)))))

(defun fcl--compare (code stack constants condition &optional cells)
  (let ((fast (fcl--run code stack constants nil cells))
        (outer (fcl--run code stack constants (fcl--outer condition) cells)))
    (should (= (plist-get fast :pc) (plist-get outer :pc)))
    (should (= (plist-get fast :sp) (plist-get outer :sp)))
    (cl-loop for i below 16 do
             (should (equal (gethash (+ 4096 (* i 8)) (plist-get fast :after))
                            (gethash (+ 4096 (* i 8)) (plist-get outer :after)))))))

(ert-deftest fcl-b-pure-semantics ()
  (dolist (raw '(6 7 61 63 129 162 182)) (should (fcl--admitted raw)))
  (dolist (code '([6 0 138] [6 2 138] [7 0 0 138] [7 2 0 138]))
    (fcl--compare code '(5 9 13) nil '(= base 0)))
  (fcl--compare [129 1 0 138] '(5) '(17 21) '(or (= base 129) (= base 192)))
  (dolist (operand '(0 1 3 128 129 130))
    (fcl--compare (vector 182 operand 138) '(5 9 13) nil '(= base 182)))
  (dolist (pair '((5 5) (5 9) (3 3) (16386 16386) (16386 16402)))
    (fcl--compare [61 138] pair nil '(= base 61)))
  (dolist (w '(3 7 5 16386))
    (fcl--compare [63 138] (list w) nil '(= base 63)))
  (dolist (w '(3 7 5 16386))
    (fcl--compare [162 138] (list w) nil '(or (= base 64) (= base 162))
                  '((16384 . 29) (16392 . 3))))
  (dolist (raw '(131 132 133 134))
    (dolist (w '(3 7 5 16386))
      (fcl--compare (vector raw 4 0 138 138) (list w) nil
                    (cond ((= raw 131) '(= base 131))
                          ((= raw 133) '(= base 133))
                          (t '(or (= base 132) (= base 134))))))))

(ert-deftest fcl-b-invalid-untouched ()
  (dolist (case '(([6] (5)) ([7 0] (5)) ([6 1 138] (5))
                  ([129 1] (5)) ([129 1 0 138] (5))
                  ([182] (5)) ([182 2 138] (5)) ([182 129 138] (5))
                  ([61 138] (5)) ([63 138] ()) ([162 138] ())
                  ([131 255 0 138] (16386)) ([134 0] (16386))))
    (pcase-let* ((`(,code ,stack) case) (r (fcl--run code stack)))
      (should (= (plist-get r :pc) 0))
      (should (= (plist-get r :sp) (length stack)))
      (should-not (plist-get r :writes)))))

(ert-deftest fcl-b-back-edge-count ()
  ;; Start one edge before the poll boundary. The first assertion fails
  ;; before the repair, before any preserving backward branch can loop.
  (dolist (case '((131 3) (132 16386) (133 3) (134 16386)))
    (let ((r (fcl--run (vector (car case) 0 0 138) (cdr case) nil nil '((8192 . 1017)))))
      (should (= (gethash 8192 (plist-get r :after)) 1021))
      (should (= (plist-get r :pc) 0)))))

(ert-deftest fcl-b-goto-self-poll ()
  ;; The watchdog makes the pre-fix unconditional self-loop fail promptly.
  (dolist (initial '(1 1017))
    (let ((r (fcl--run [130 0 0 138] nil nil nil `((8192 . ,initial)))))
      (should (= (gethash 8192 (plist-get r :after)) 1021))
      (should (= (plist-get r :pc) 0))
      (should (= (plist-get r :sp) 0))
      (should-not (plist-get r :writes)))))

(ert-deftest fcl-b-branch-operand-end-boundary ()
  (dolist (raw '(130 131 132 133 134))
    (dolist (dest '(0 1 2 3))
      (let* ((w (if (memq raw '(131 133)) 3 16386))
             (r (fcl--run (vector raw dest 0 138) (unless (= raw 130) (list w))
                          nil nil '((8192 . 1017)))))
        (should (= (gethash 8192 (plist-get r :after)) (if (< dest 3) 1021 1017)))
        (should (= (plist-get r :pc) dest))))))

(defconst fcl--list-cells
  '((16384 . 5) (16392 . 16402) (16400 . 9) (16408 . 16418)
    (16416 . 13) (16424 . 3)))

(ert-deftest fcl-c-list-semantics ()
  (dolist (raw '(56 62 71 158 183)) (should (fcl--admitted raw)))
  (dolist (key '(5 9 17))
    (fcl--compare [62 138] (list key 16386) nil '(= base 62) fcl--list-cells))
  (dolist (n '(-1 0 1 2 3 10))
    (fcl--compare [56 138] (list (1+ (* n 4)) 16386) nil
                  '(or (= base 155) (= base 157) (= base 93) (= base 94)
                       (= base 166) (= base 56) (and (>= base 85) (<= base 90)))
                  fcl--list-cells))
  (fcl--compare [71 138] '(16386) nil '(= base 71) fcl--list-cells)
  (fcl--compare [71 138] '(3) nil '(= base 71))
  (let ((cells '((16384 . 16418) (16392 . 16402) (16400 . 5) (16408 . 3)
                 (16416 . 9) (16424 . 13))))
    (dolist (key '(5 9 17))
      (fcl--compare [158 138] (list key 16386) nil
                    '(or (= base 147) (= base 148) (= base 149) (= base 150) (= base 151)
                         (= base 156) (= base 79) (= base 158) (= base 152) (= base 153)
                         (= base 75) (= base 77)) cells))))

(ert-deftest fcl-c-invalid-and-circular-untouched ()
  (dolist (raw '(56 62 71 158))
    (dolist (cells '(((16384 . 5) (16392 . 13))
                      ((16384 . 5) (16392 . 16386))))
      (let ((r (fcl--run (vector raw 138)
                         (if (= raw 71) '(16386) (list (if (= raw 56) 401 17) 16386))
                         nil nil cells)))
        (should (= (plist-get r :pc) 0))
        (should-not (plist-get r :writes))))))

(defun fcl--table (target)
  `((24576 . 32774) (32768 . 15) (32784 . 9) (32792 . 50000)
    (32800 . 9) (32864 . 40006) (32872 . 45006)
    (40000 . 4) (40008 . 5) (40016 . ,target) (40024 . 9) (40032 . 13)
    (45000 . 2) (45008 . 1) (45016 . 1)
    (50000 . 4) (50016 . 60000) (50024 . 2) (60000 . 101) (60001 . 113)))

(ert-deftest fcl-c-switch-semantics ()
  (dolist (key '(5 9 17))
    (fcl--compare [183 138 138 138 138] (list key 24578) nil '(= base 183)
                  (fcl--table 17)))
  (dolist (target '(37 -3 3))
    (let ((r (fcl--run [183 138 138 138 138] '(5 24578) nil nil (fcl--table target))))
      (should (= (plist-get r :pc) 0)) (should-not (plist-get r :writes))))
  (dolist (stack '((5 3) (5) ()))
    (let ((r (fcl--run [183 138] stack)))
      (should (= (plist-get r :pc) 0)) (should-not (plist-get r :writes)))))

(ert-deftest fcl-c-switch-self-poll ()
  (let ((r (fcl--run [183 138] '(5 24578) nil nil
                     (cons '(8192 . 1017) (fcl--table 1)))))
    (should (= (gethash 8192 (plist-get r :after)) 1021))
    (should (= (plist-get r :pc) 0))
    (should (= (plist-get r :sp) 0))))

(provide 'nelisp-bytecode-fastloop-test)
