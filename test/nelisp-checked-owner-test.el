;;; nelisp-checked-owner-test.el --- Unused owner traversal E2E -*- lexical-binding: t; -*-
(require 'nelisp-checked-promotion-env-test)
(defconst co--providers
  '((nl_frame_stack_promote_owner_checked . 3) (nl_frame_stack_containing . 2)
    (nl_frame_stack_control . 0) (nl_vector_slot_word . 2)))
(define-error 'co-structure "Checked owner structure")
(define-error 'co-loop-budget "Checked owner loop budget")
(defvar co--last-cleanup nil)
(defun co--bad-form ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "../out/checked-owner/attempt1/failed-helper.sexp" cp--root))
    (unless (equal (secure-hash 'sha256 (current-buffer)) "dc2558fe15fa0d54726d93482199f04a31ca5af011ac2262574e928ed773d746")
      (error "Authentic failed source pin"))
    (goto-char 1) (read (current-buffer))))
(defun co--shape (form)
  "Validate this helper's two unconditional advances, not generic DSL if."
  (cl-assert (equal (cl-subseq form 0 3)
                   '(defun nl_frame_stack_promote_owner_checked (env frames roots))))
  ;; Classify the observed nested advance before the surrounding malformed seq.
  (let ((todo (list (cadddr form))) loops
        (guard '(if (= ok 1) (if (= (heap-read-u64 268435472 0) 0) (< i depth) 0) 0)))
    (while todo
      (let ((x (pop todo)))
        (when (consp x)
          (when (and (eq (car x) 'while) (equal (cadr x) guard)) (push x loops))
          (push (cdr x) todo) (push (car x) todo))))
    (setq loops (nreverse loops))
    (cl-assert (= (length loops) 2))
    (cl-loop for loop in loops for n from 1 do
      (let* ((scope (nth 2 loop)) (seq (nth 2 scope)) (state-if (nth 1 seq))
             (advance '(setq i (+ i 1))))
        (when (and (eq (car scope) 'let*) (eq (car seq) 'seq)
                   (equal (cl-subseq state-if 0 3) '(if (= state 0) 0))
                   (cl-member advance (cdddr state-if) :test #'equal)
                   (not (cl-member advance (cddr seq) :test #'equal)))
          (signal 'co-structure (list 'counter-nested-in-state-if n))))))
  (let* ((body (cadddr form)) (root-guard (nth 3 body))
         (setup (nth 3 root-guard)) (sequence (nth 2 setup)))
    (cl-assert (equal (cl-subseq body 0 3) '(if (/= (heap-read-u64 268435472 0) 0) 0)))
    (cl-assert (equal (cl-subseq root-guard 0 2) '(if (= roots 0))))
    (cl-assert (and (eq (car setup) 'let*) (eq (car sequence) 'seq) (= (length sequence) 5)))
    (cl-assert (equal (nth 2 sequence) '(setq i 0)))
    (cl-assert (equal (nth 4 sequence) '(if (/= (heap-read-u64 268435472 0) 0) 0 ok)))
    (cl-loop for loop in (list (nth 1 sequence) (nth 3 sequence)) for n from 1 do
      (let* ((scope (nth 2 loop)) (seq (nth 2 scope)) (state-if (nth 1 seq)))
        (cl-assert (equal (cl-subseq loop 0 2)
          '(while (if (= ok 1) (if (= (heap-read-u64 268435472 0) 0) (< i depth) 0) 0))))
        (unless (and (= (length seq) 3) (= (length state-if) 4)
                     (equal (cl-subseq state-if 0 3) '(if (= state 0) 0))
                     (equal (nth 2 seq) '(setq i (+ i 1))))
          (signal 'co-structure (list 'counter-nested-in-state-if n)))))
    (cl-labels ((count-advance (x)
                  (if (not (consp x)) 0
                    (+ (if (equal x '(setq i (+ i 1))) 1 0)
                       (count-advance (car x)) (count-advance (cdr x))))))
      (cl-assert (= (count-advance (nth 1 sequence)) 1))
      (cl-assert (= (count-advance (nth 3 sequence)) 1)))
    t))
(defun co--seal (path)
  (let ((ce--providers (append ce--providers co--providers)))
    (co--shape (ce--form 'nl_frame_stack_promote_owner_checked))
    (ce--seal-manifest path)))
(defun co--run (env kind &optional mutant disabled)
  (let ((ce--providers (append ce--providers co--providers)) (clones 0) calls
        (original-containing (and (fboundp 'nl_frame_stack_containing) (symbol-function 'nl_frame_stack_containing))))
    (setq co--last-cleanup nil)
    (let ((row (ce--run env (if (eq kind 'pending) 'pending 'cold)
                (and (eq kind 'prepare-fail) 5) nil
                (list
                 :allowed-keys '(1234 5678)
                 :setup
                 (lambda (rd wr)
                   (funcall wr 92000 0 10000) (funcall wr 10000 0 0)
                   (funcall wr 92000 16 (if disabled 0 1))
                   (funcall wr 92000 40 50) (funcall wr 92000 48 80)
                   (funcall wr 10000 8 20006) (funcall wr 10000 16 4)
                   (funcall wr 20000 0 780) (funcall wr 20000 8 3)
                   (funcall wr 20000 16 21006) (funcall wr 20000 24 21)
                   (funcall wr 21000 0 (+ 8 (* 5 256)))
                   (funcall wr 2032 0 4) (funcall wr 2032 16 5678) (funcall wr 2032 24 3)
                   (dotimes (i 4)
                     (let ((base (+ 10128 (* i 64))))
                       (funcall wr base 0 (logior 1036 (* (1+ (mod i 3)) 64)))
                       (funcall wr base 8 (if (= i 0) 2000 2032))
                       (dotimes (j 4) (funcall wr base (+ 16 (* j 8)) (+ 5 (* j 4))))
                       (funcall wr base 48 (if (= i 3) 60006 0))
                       (funcall wr 21000 (+ 8 (* i 8)) (+ base 6))))
                   (funcall wr 21000 40 70006) (funcall wr 70000 0 1036)
                   (ignore rd))
                 :invoke (lambda (e roots)
                   (let* ((body (symbol-function 'nl_frame_stack_containing))
                          (depth (ash (nl_record_slot_word 20006 1) -2)) (count 0))
                     (cl-letf (((symbol-function 'nl_frame_stack_containing)
                       (lambda (frame pad) (cl-incf count)
                         (when (> count (* 2 depth)) (signal 'co-loop-budget (list count frame depth)))
                         (funcall body frame pad))))
                       (nl_frame_stack_promote_owner_checked e 20006 roots))))
                 :cleanup (lambda (initial final)
                   (setq co--last-cleanup (list initial final
                     (eq original-containing (and (fboundp 'nl_frame_stack_containing)
                                                  (symbol-function 'nl_frame_stack_containing))))))
                 :observe (lambda (frame) (push frame calls))
                 :clone (lambda (_rd wr)
                          (cl-incf clones)
                          (when (and (eq kind 'late-fail) (= clones 5))
                            (funcall wr 268435472 0 1) (funcall wr 268435544 0 1)
                            (funcall wr 70000 0 88)))
                 :mutate
                 (lambda (name form)
                   (if (not (eq name 'nl_frame_stack_promote_owner_checked)) form
                     (pcase mutant
                       ('authentic-bad (co--bad-form))
                       ('early (cl-subst
                         '(seq (ptr-write-u64 (nl_word_payload frame) 48 99998) (ptr-write-u64 roots 0 type))
                         '(ptr-write-u64 roots 0 type) form :test #'equal))
                       ('continue (cl-subst 1 '(= (heap-read-u64 268435472 0) 0)
                                   (cl-subst '(setq ok 1) '(setq ok 0) form :test #'equal) :test #'equal))
                       (_ form))))
                 :collect
                 (lambda (rd _wr)
                   (let ((backing (cl-loop for i below 5 collect (funcall rd 21000 (+ 8 (* i 8))))))
                     (list :forward (cl-loop for i below 4 collect (funcall rd (+ 10128 (* i 64)) 48))
                           :backing backing :headers (mapcar (lambda (w) (funcall rd (- w 6) 0)) backing)
                           :slots (mapcar (lambda (w) (cl-loop for j below 4 collect (funcall rd (- w 6) (+ 16 (* j 8)))))
                                          (cl-subseq backing 0 3))
                           :depth (funcall rd 20000 24) :registered-count (funcall rd 10000 16)
                           :counters (list (funcall rd 92000 40) (funcall rd 92000 48))
                           :disabled disabled
                           :deep (funcall rd env 168))))))))
      (plist-put row :constructor-calls (nreverse calls)))))
(defun co--contract (row kind)
  (let* ((extra (plist-get row :extra)) (forward (plist-get extra :forward))
         (backing (plist-get extra :backing)) (calls (plist-get row :constructor-calls)))
    (cl-assert (equal (plist-get row :initial) (plist-get row :final)) nil "root-restoration")
    (cl-assert (= (plist-get extra :depth) 21) nil "logical-depth")
    (cl-assert (= (plist-get extra :registered-count) 4) nil "registered-count")
    (cl-assert (= (plist-get extra :deep) 0) nil "Env168")
    (cl-assert (equal (plist-get extra :counters)
                     (pcase (if (plist-get extra :disabled) 'disabled kind)
                       ('success '(53 83)) ('late-fail '(51 81)) (_ '(50 80)))) nil "promotion-counters")
    (cl-assert (= (nth 3 forward) 60006) nil "forwarded-identity")
    (cl-assert (equal (nthcdr 3 backing) '(10326 70006)) nil "forwarded-heap-identity")
    (pcase kind
      ('success
       (cl-assert (= (plist-get row :result) 1) nil "success-status")
       (cl-assert (equal calls '(10134 10198 10262)) nil "constructor-order")
       (cl-assert (equal (cl-subseq forward 0 3) (cl-subseq backing 0 3)) nil "publication-identity")
       (cl-assert (cl-every (lambda (w) (/= w 0)) (cl-subseq forward 0 3)) nil "complete-prefix")
       (cl-assert (equal (cl-subseq (plist-get extra :headers) 0 3) '(1100 1164 1228)) nil "source-flags")
       (cl-assert (equal (plist-get extra :slots) '((5 9 13 17) (5 9 13 17) (5 9 13 17))) nil "slot-identity"))
      ((or 'prepare-fail 'pending)
       (cl-assert (= (plist-get row :result) 0) nil "failure-status")
       (cl-assert (equal (cl-subseq forward 0 3) '(0 0 0)) nil "prepare-published")
       (cl-assert (equal (cl-subseq backing 0 3) '(10134 10198 10262)) nil "prepare-backing")
       (cl-assert (null calls) nil "preparation-constructed"))
      ('late-fail
       (cl-assert (= (plist-get row :result) 0) nil "failure-status")
       (cl-assert (equal calls '(10134 10198)) nil "continued-after-failure")
       (cl-assert (and (/= (car forward) 0) (= (car forward) (car backing))) nil "valid-prefix")
       (cl-assert (equal (cl-subseq forward 1 3) '(0 0)) nil "incomplete-publication")
       (cl-assert (equal (cl-subseq backing 1 3) '(10198 10262)) nil "suffix-preserved")
       (cl-assert (= (plist-get row :pending) 1) nil "pending-kind")
       (cl-assert (= (plist-get row :epoch) 1) nil "pending-epoch")
       (cl-assert (= (plist-get row :payload) 88) nil "pending-payload")))))
(ert-deftest checked-owner-genuine-root-and-traversal-e2e ()
  ;; RAW and must remain false as a Host conditional guard, and short-circuit.
  (let ((raw (ce--fn '(defun raw () (if (and 1 0) 99 17))))
        (effects (ce--fn '(defun effects () (let ((n 0)) (and 0 (setq n 1)) n)))))
    (should (= (funcall raw) 17)) (should (= (funcall effects) 0)))
  (dolist (env '(0 200000 300000))
    (dolist (kind '(success prepare-fail late-fail pending))
      (let ((row (co--run env kind)))
        (co--contract row kind)
        (when (eq kind 'pending)
          (should (= (plist-get row :pending) 2)) (should (= (plist-get row :epoch) 17))
          (should (= (plist-get row :payload) 99)))
        (when (eq kind 'prepare-fail) (should (= (plist-get row :pending) 1))))))
  (dolist (kind '(success prepare-fail late-fail pending))
    (co--contract (co--run 0 kind nil t) kind)))
(defun co--expect-structure (form source)
  (let (caught)
    (condition-case e (co--shape form) (co-structure (setq caught e)))
    (should (equal caught '(co-structure counter-nested-in-state-if 2)))
    (princ (format "STRUCTURE source=%S observed=nested-advance loop=2 condition=%S\n" source caught))))
(ert-deftest checked-owner-shape-current ()
  (should (co--shape (ce--form 'nl_frame_stack_promote_owner_checked))))
(ert-deftest checked-owner-shape-authentic-bad ()
  ;; Needs the untracked out/ attempt artifact next to the checkout.
  (skip-unless (file-exists-p (expand-file-name "../out/checked-owner/attempt1/failed-helper.sexp" cp--root)))
  (co--expect-structure (co--bad-form) 'authenticated-attempt1))
(ert-deftest checked-owner-shape-moved-advance ()
  (let* ((bad (copy-tree (ce--form 'nl_frame_stack_promote_owner_checked)))
         (sequence (nth 2 (nth 3 (nth 3 (cadddr bad)))))
         (loop (nth 3 sequence)) (scope (nth 2 loop)) (body (nth 2 scope))
         (state-if (nth 1 body)) (advance (nth 2 body)))
    (setcdr body (list (append state-if (list advance))))
    (co--expect-structure bad 'moved-actual-advance)))
(ert-deftest checked-owner-loop-authentic-budget ()
  ;; Needs the untracked out/ attempt artifact next to the checkout.
  (skip-unless (file-exists-p (expand-file-name "../out/checked-owner/attempt1/failed-helper.sexp" cp--root)))
  (let (caught)
    (condition-case e (co--run 0 'success 'authentic-bad)
      (co-loop-budget (setq caught e)))
    (should (equal caught '(co-loop-budget 11 70006 5)))
    (should (equal (nth 0 co--last-cleanup) (nth 1 co--last-cleanup)))
    (should (eq (nth 2 co--last-cleanup) t))
    (princ (format "AUTHENTIC-BUDGET %S roots-restored=t function-restored=t\n" caught))))
(ert-deftest checked-owner-raw-truth ()
  (let ((fn (ce--fn '(defun tiny (x) (let ((n 0))
                      (list (and x (seq (setq n (+ n 1)) 1)) n (or 0 x)))))))
    (should (equal (funcall fn 0) '(0 0 0)))
    (should (equal (funcall fn 1) '(1 1 1))))
  (let ((fn (ce--fn '(defun loopraw (x) (let ((n 0))
                      (while x (setq n (+ n 1)) (setq x 0)) n)))))
    (should (= (funcall fn 0) 0)) (should (= (funcall fn 1) 1)))
  (let ((fn (ce--fn '(defun oreffects () (let ((n 0))
                       (list (or (seq (setq n (+ n 1)) 0)
                                 (seq (setq n (+ n 1)) 1) (setq n 99)) n))))))
    (should (equal (funcall fn) '(1 2))))
  (let ((fn (ce--fn '(defun countchecks () (let ((n 0) (checks 0))
                      (while (seq (setq checks (+ checks 1)) (and (< n 1) 1)) (setq n (+ n 1)))
                      (list n checks))))))
    (should (equal (funcall fn) '(1 2))))
  (let ((literal '(defun while (and) (let ((and '(while 0))) (setq and '(and 1))
                    (function while) (data-addr and) (extern-call while and)))))
    (should (equal (cp--lower literal) literal)))
  (let* ((actual (funcall (ce--fn '(defun rawif () (if (and 1 0) 17 23)))))
         (bad (let ((raw (and 1 0))) (if raw 17 23))))
    (should (= actual 23)) (should (= bad 17))
    (princ "RAW wrong-Host-guard actual=17 correct-DSL=23\n")))
(defun co--name-control (leaf)
  (let* ((args (pcase leaf ('entry-for '(1 5678 3))
                         ('alloc-str '(5678 3 3 8000 9000 14)) (_ '(1 5678 3 8000))))
         (good (copy-sequence args)) (index (if (eq leaf 'alloc-str) 0 1))
         (ce--name-trace nil) (calls 0) caught)
    (setcar (nthcdr index good) 1234)
    (should (= (apply (ce--name-leaf leaf '(1234) (lambda (&rest _) (cl-incf calls) 42)) good) 42))
    (should (= calls 1)) (setq ce--name-trace nil)
    (condition-case e
        (apply (ce--name-leaf leaf '(1234) (lambda (&rest _) (cl-incf calls) 42)) args)
      (ert-test-failed (setq caught e)))
    (should (= calls 1))
    (should (equal (car ce--name-trace) (list leaf '(memq key allowed) 5678 '(1234) nil)))
    (let ((data (cadr caught)))
      (should (eq (car caught) 'ert-test-failed))
      (should (equal (car data) '(should (memq key allowed))))
      (should (equal (plist-get (cdr data) :form) '(memq 5678 (1234))))
      (should (plist-member (cdr data) :value))
      (should (eq (plist-get (cdr data) :value) nil)))
    (should (= (apply (ce--name-leaf leaf '(1234 5678) (lambda (&rest _) (cl-incf calls) 42)) args) 42))
    (should (= calls 2))
    (princ (format "NAME leaf=%S predicate=(memq key allowed) key=5678 allowed=(1234) value=nil default1234/owner5678=accepted\n" leaf))))
(ert-deftest checked-owner-name-entry-for-contract () (co--name-control 'entry-for))
(ert-deftest checked-owner-name-alloc-str-contract () (co--name-control 'alloc-str))
(ert-deftest checked-owner-name-register-contract () (co--name-control 'register))
(defun co--expect-contract (row kind expected mutation)
  (let (caught)
    (condition-case e (co--contract row kind)
      (error (if (equal e expected) (setq caught e) (signal (car e) (cdr e)))))
    (should (equal caught expected))
    (princ (format "MUTANT helper=nl_frame_stack_promote_owner_checked mutation=%S condition=%S calls=%S forward=%S pending=%S epoch=%S payload=%S\n"
                   mutation caught (plist-get row :constructor-calls) (plist-get (plist-get row :extra) :forward)
                   (plist-get row :pending) (plist-get row :epoch) (plist-get row :payload)))))
(ert-deftest checked-owner-mutant-early-publication ()
  (let* ((row (co--run 200000 'prepare-fail 'early)) (extra (plist-get row :extra)))
    (should (= (car (plist-get extra :forward)) 99998))
    (should-not (plist-get row :constructor-calls))
    (should (equal (plist-get extra :backing) '(10134 10198 10262 10326 70006)))
    (co--expect-contract row 'prepare-fail '(error "prepare-published") 'early)))
(ert-deftest checked-owner-mutant-continue-after-pending ()
  (let* ((row (co--run 200000 'late-fail 'continue)) (extra (plist-get row :extra)))
    (should (equal (plist-get row :constructor-calls) '(10134 10198 10262)))
    (should (= (plist-get row :pending) 1)) (should (= (plist-get row :epoch) 1))
    (should (= (plist-get row :payload) 88))
    (should (/= (car (plist-get extra :forward)) 0))
    (should (= (car (plist-get extra :forward)) (car (plist-get extra :backing))))
    (co--expect-contract row 'late-fail '(error "continued-after-failure") 'continue)))
(provide 'nelisp-checked-owner-test)
