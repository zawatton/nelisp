(let ((bad nil))
  (dolist (c string-to-number-cases)
    (let ((got (string-to-number (car c))))
      (unless (equal got (cdr c)) (push (list (car c) got (cdr c)) bad))))
  (dolist (b (reverse bad)) (princ (format "  MISMATCH %S\n" b)))
  (princ (format "STRING-TO-NUMBER cases=%d failures=%d %s\n"
                 (length string-to-number-cases) (length bad) (if bad "FAIL" "PASS")))
  (kill-emacs (if bad 1 0)))

