;;; nelisp-bytecode-native-rooted-stack-call-test.el --- checked stack caller -*- lexical-binding: t; -*-
(require 'ert)
(require 'nelisp-bytecode-native-rooted-stack-call)

(defun nelisp-bytecode-native-rooted-stack-call-test--result ()
  (list :status 'complete :entry-name "nl_native_stack_probe_v1"
        :artifact-path "test-artifact.nelr" :artifact-sha256 "artifact-sha"
        :runtime-binary-sha256 "binary-sha" :gateway-imports '("nl_native_car_v2")
        :argument-count 1 :constants [] :input '(:constants [])
        :plan '(:status complete :initial-roots (1) :constant-roots nil
                :operations ((:operation car :inputs (1) :outputs (1)))
                :final-root 1 :required-root-count 2)))

(ert-deftest nelisp-bytecode-native-rooted-stack-call-accepts-only-attested-gateway-mode ()
  (let* ((names '("nl_native_car_v2" "nl_native_cdr_v2" "nl_native_cons_v2"))
         (descriptors
          (mapcar (lambda (name)
                    (list :name name :kind 'func
                          :abi nelisp-native-load-raw-runtime-abi-v2
                          :index 0 :address-mode 'native-bridgeable-v1))
                  names)))
    (should (equal (nelisp-bytecode-native-rooted-stack-call--manifest-import-names
                    `(:native (:imports ,descriptors)))
                   names))
    (dolist (mode '(resolver call1-typed-v1 unknown))
      (should-error
       (nelisp-bytecode-native-rooted-stack-call--manifest-import-names
        `(:native (:imports ((:name "nl_native_car_v2" :kind func
                              :abi ,nelisp-native-load-raw-runtime-abi-v2
                              :index 0 :address-mode ,mode)))))))))

(ert-deftest nelisp-bytecode-native-rooted-stack-call-public-resolver-is-fixed-and-attested ()
  (let (resolved)
    (cl-letf (((symbol-function 'nelisp-native-load--raw-v2-contract)
               (lambda () '((runtime . 1))))
              ((symbol-function 'nelisp-native-load--raw-supported-p) (lambda () t))
              ((symbol-function 'nelisp-runtime-reload-contract-matches-p) (lambda () t))
              ((symbol-function 'nelisp--native-env) (lambda () 77))
              ((symbol-function 'nelisp-native-load--symbol-addr)
               (lambda (name)
                 (push name resolved)
                 (1+ (length resolved)))) )
      (should (equal (nelisp-native-load-root-v2-addresses)
                     '(:environment 77 :begin 2 :reserve 3 :end 4 :slot 5)))
      (should (equal (nreverse resolved)
                     '("nl_root_pin_begin_v2" "nl_root_pin_reserve_v2"
                       "nl_root_pin_end_v2" "nl_root_pin_slot_v2"))))))

(ert-deftest nelisp-bytecode-native-rooted-stack-call-rejects-unauthenticated-before-map ()
  (let ((maps 0) (result (nelisp-bytecode-native-rooted-stack-call-test--result)))
    (cl-letf (((symbol-function 'nelisp-bytecode-native-rooted-stack-authenticated-result-p)
               (lambda (_) nil))
              ((symbol-function 'nelisp-native-load-raw-v2-artifact)
               (lambda (&rest _) (setq maps (1+ maps)))) )
      (should-error (nelisp-bytecode-native-rooted-stack-call result 'x))
      (should (= maps 0)))))

(ert-deftest nelisp-bytecode-native-rooted-stack-call-refuses-mutated-arity-before-map ()
  (let ((result (nelisp-bytecode-native-rooted-stack-call-test--result))
        (maps 0) (auth-count 0))
    (setf (plist-get result :argument-count) 2)
    (cl-letf (((symbol-function 'nelisp-bytecode-native-rooted-stack-authenticated-result-p)
               (lambda (_) (setq auth-count (1+ auth-count)) t))
              ((symbol-function 'nelisp-native-load-raw-v2-artifact)
               (lambda (&rest _) (setq maps (1+ maps)))) )
      (should-error (nelisp-bytecode-native-rooted-stack-call result 'x))
      (should (= auth-count 0))
      (should (= maps 0)))))

