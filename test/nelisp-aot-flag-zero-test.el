;;; nelisp-aot-flag-zero-test.el --- Completed AND zero flags -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-flag-zero-test--enabled t)
(defvar nelisp-flag-zero-test--changes 0)
(defun nelisp-flag-zero-test--record (fn &rest args)
  (let ((r (apply fn args))) (cl-incf nelisp-flag-zero-test--changes (length r)) r))
(defun nelisp-flag-zero-test--plan (&optional cc middle)
  (let ((zero (make-symbol "zero")) (join (make-symbol "join")) (negative (make-symbol "negative")) (done (make-symbol "done")))
    (append `((:mov r10 (:reg rdi)) (:alu logand r10 (:reg rsi)) (:cmp r10 (:imm 0)))
            middle
            `((:jcc ,(or cc 'e) ,zero) (:store (:mem rdx nil 1 0) (:reg r10)) (:jmp ,join)
              (:label ,zero) (:store (:mem rdx nil 1 8) (:reg r10)) (:label ,join)
              (:cmp rcx (:imm 0)) (:jcc l ,negative) (:mov rax (:reg r10)) (:jmp ,done)
              (:label ,negative) (:mov rax (:reg rdi)) (:label ,done)))))
(ert-deftest nelisp-flag-zero/validated-ZF-joins-and-data-liveness ()
  (dolist (cc '(e ne))
    (let* ((p (nelisp-flag-zero-test--plan cc))
           (comparison (nth 2 p)) (and-op (nth 1 p))
           (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
      (should q) (should-not (memq comparison q)) (should (memq and-op q))
      (dolist (x p) (when (memq (car x) '(:mov :store :jmp :label)) (should (memq x q))))))
  ;; The data result is otherwise dead; only the ZF consumer keeps AND alive.
  (let* ((yes (make-symbol "yes")) (done (make-symbol "done"))
         (and-op '(:alu logand r10 (:reg rsi)))
         (p `((:mov r10 (:reg rdi)) ,and-op (:cmp r10 (:imm 0)) (:jcc e ,yes)
              (:mov rax (:imm 1)) (:jmp ,done) (:label ,yes) (:mov rax (:imm 2))
              (:label ,done) (:alu + r11 (:imm 1))))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
    (should (memq and-op q)) (should (= 0 (cl-count :cmp q :key #'car)))))
(ert-deftest nelisp-flag-zero/original-consumers-and-fallbacks-reject ()
  (dolist (cc '(l le g ge))
    (let* ((p (nelisp-flag-zero-test--plan cc)) (q (nelisp-aot-compiler--x86-predicate-facts-plan p)))
      (should (memq (nth 2 p) q))))
  (let* ((p (nelisp-flag-zero-test--plan 'e '((:fallback))))
         (q (nelisp-aot-compiler--x86-predicate-facts-plan p))
         (off (let ((nelisp-aot-compiler--x86-flag-zero nil))
                (nelisp-aot-compiler--x86-predicate-facts-plan p))))
    ;; X independently removes an unused compare before a fallback writer.
    (should (equal q off)))
  (let* ((l (make-symbol "l"))
         (p `((:alu logand r10 (:reg rdi)) (:cmp r10 (:imm 0)) (:jcc e ,l)
              (:mov rax (:imm 1)) (:label ,l))))
    (should-not (memq (nth 1 p) (nelisp-aot-compiler--x86-predicate-facts-plan p)))))
(ert-deftest nelisp-flag-zero/ABI-dead-flags-exit-keeps-result-and-six-args ()
 (let* ((yes (make-symbol "yes")) (done (make-symbol "done"))
        (p `((:mov r10 (:reg rdi)) (:alu logand r10 (:reg rsi)) (:cmp r10 (:imm 0))
             (:jcc e ,yes) (:store (:mem rdx nil 1 0) (:reg rcx))
             (:mov rax (:reg r8)) (:jmp ,done)
             (:label ,yes) (:store (:mem rdx nil 1 8) (:reg r9))
             (:mov rax (:reg rdi)) (:label ,done)))
        (q (nelisp-aot-compiler--x86-predicate-facts-plan p))
        (args '(rdi rsi rdx rcx r8 r9)))
  (should q) (should-not (memq (nth 2 p) q))
  (dolist (x p) (unless (eq (car x) :cmp) (should (memq x q))))
  ;; Exact closed opcode writes preserve every ABI input at the exit, and
  ;; the two original RAX return definitions remain live on their edges.
  (dolist (x q)
   (pcase (car x)
    ((or :mov :load) (should-not (memq (nth 1 x) args)))
    (:alu (should-not (memq (nth 2 x) args)))))
  (should (= 2 (cl-count-if (lambda(x)(and (eq (car x) :mov) (eq (nth 1 x) 'rax))) q)))))
(ert-deftest nelisp-flag-zero/adjacency-bypass-width-and-complete-preflight ()
  (dolist (middle '((:mov r11 (:imm 1)) (:label between) (:alu + r10 (:imm 1))))
    (let* ((p (nelisp-flag-zero-test--plan)) (cmp (nth 2 p)))
      (setcdr (nthcdr 1 p) (cons middle (nthcdr 2 p)))
      (should (memq cmp (nelisp-aot-compiler--x86-predicate-facts-plan p)))))
  (dolist (replacement '((:cmp r10 (:imm 1)) (:cmp r11 (:imm 0))))
    (let ((p (nelisp-flag-zero-test--plan)))
      (setcar (nthcdr 2 p) replacement)
      (should (memq replacement (nelisp-aot-compiler--x86-predicate-facts-plan p)))))
  (let* ((p (nelisp-flag-zero-test--plan)) (between (make-symbol "between")) (cmp (nth 2 p)))
    (setcdr (nthcdr 1 p) (cons (list :label between) (nthcdr 2 p)))
    (setq p (append `((:cmp r8 (:imm 0)) (:jcc e ,between)) p))
    (should (memq cmp (nelisp-aot-compiler--x86-predicate-facts-plan p))))
  (dolist (bad '((:alu logand r10 (:imm 4294967295)) (:alu32 logand r10 (:imm 31))
                 (:lea r11 (:mem rdi nil 1 0)) (:alu logand eax (:reg rsi))
                 (:cmp r10 (:imm 0.0)) (:jcc b nowhere) (:unknown)))
    (let ((p (nelisp-flag-zero-test--plan)))
      (setcar (nthcdr 1 p) bad) (should-not (nelisp-aot-compiler--x86-predicate-facts-plan p))))
  (let* ((p (nelisp-flag-zero-test--plan)) (l (make-symbol "duplicate")))
    (should-not (nelisp-aot-compiler--x86-predicate-facts-plan (append p `((:label ,l) (:label ,l)))))
    (should-not (nelisp-aot-compiler--x86-predicate-facts-plan (append p `((:label ,l) (:jmp ,l))))))
  (let ((p (nelisp-flag-zero-test--plan))) (setcdr (last p) p) (should-not (nelisp-aot-compiler--x86-predicate-facts-plan p)))
  (should-not (nelisp-aot-compiler--x86-predicate-facts-plan (make-list 8193 '(:mov rax (:imm 1))))))
(defun nelisp-flag-zero-test--source ()
 '(seq
   (defun zslow (p x m y z q) (seq (ptr-write-u64 p 56 (+ (ptr-read-u64 p 56) 1)) (- q 7)))
   (defun zguard (p x m y z q)
     (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (zslow p x m y z q))))
       (if (= entry 0)
           (let ((v (ptr-read-u64 p 8)))
             (seq (ptr-write-u64 p 8 q)
               (let ((bits (logand v m)))
                 (if (= bits 0)
                     (seq (ptr-write-u64 p 16 bits) (ptr-write-u64 p 24 1)
                          (if (< y z) (+ bits x) (- bits x)))
                   (seq (ptr-write-u64 p 16 bits) (ptr-write-u64 p 24 2)
                        (if (< y z) (+ bits q) (- bits q))))))) entry)))
   (defun zwrapper (p x m y z q) (zguard p x m y z q))
   (defun zeffects (p x m y z q)
     (zwrapper (seq (ptr-write-u64 p 40 (+ (* (ptr-read-u64 p 40) 10) 1)) p)
               (seq (ptr-write-u64 p 40 (+ (* (ptr-read-u64 p 40) 10) 2)) x) m y z q))
   (defun zword (p w)
     (if (= (sexp-tag w) 7) (zwrapper p w -1 0 1 8)
       (if (= (sexp-tag w) 63) (zwrapper p w -1 0 1 8) 73)))))
(defun nelisp-flag-zero-test--u64 (n) (logand n #xffffffffffffffff))
(defun nelisp-flag-zero-test--s64 (n)
 (let ((n (nelisp-flag-zero-test--u64 n))) (if (>= n #x8000000000000000) (- n #x10000000000000000) n)))
(ert-deftest nelisp-flag-zero/native-GNU-full64-order-fault-WORD-ABI-disabled ()
 (let* ((dir (make-temp-file "flag-zero-" t)) (c (expand-file-name "probe.c" dir))
        (o (expand-file-name "probe.o" dir)) (exe (expand-file-name "probe" dir)) (changes nil) (objects nil)
        (values '(0 1 2 6 -1 4294967295 4294967296 4294967297 -9223372036854775808 9223372036854775807 -6066930334832433274))
        (masks '(0 1 31 -1 2147483648 4294967295 4294967296 -2147483648 -9223372036854775808)) (rows nil))
  (unwind-protect
   (progn
    (dolist (v values) (dolist (m masks) (dolist (cold '(0 1))
     (let* ((x (logxor v #x7654321089abcdef)) (y (nelisp-flag-zero-test--s64 v))
            (z (nelisp-flag-zero-test--s64 m)) (q (logxor x #xfedcba9876543210))
            (bits (logand (nelisp-flag-zero-test--u64 v) (nelisp-flag-zero-test--u64 m)))
            (a (if (= bits 0) x q))
            (answer (nelisp-flag-zero-test--u64 (if (= cold 1) (- q 7) (if (< y z) (+ bits a) (- bits a))))))
       (push (mapcar #'nelisp-flag-zero-test--u64 (list v m x y z q cold answer bits (if (= bits 0) 1 2))) rows)))))
    (setq rows (nreverse rows))
    (when (getenv "Z_GNU_OUT")
      (with-temp-file (getenv "Z_GNU_OUT") (prin1 rows (current-buffer))))
    (with-temp-file c
     (insert "#include <stdint.h>\n#include <stdio.h>\n#include <sys/mman.h>\n#include <sys/wait.h>\n#include <unistd.h>\n#include <signal.h>\ntypedef uint64_t U;extern U zwrapper(U,U,U,U,U,U),zeffects(U,U,U,U,U,U),zword(U,U);\nstatic const U rows[][10]={\n")
     (dolist (r rows) (insert "{" (mapconcat (lambda(n)(format "0x%xULL" n)) r ",") "},\n"))
     (insert "};\nint main(void){volatile U*p=mmap((void*)0x30000000,4096,3,0x22|0x100000,-1,0);if(p!=(void*)0x30000000)return 90;for(unsigned i=0;i<sizeof(rows)/sizeof(rows[0]);i++){const U*r=rows[i];p[0]=r[6];p[1]=r[0];p[2]=p[3]=0xdeadbeef;p[5]=p[7]=0;U before,after;asm volatile(\"mov %%rsp,%0\":\"=r\"(before));U got=zeffects((U)p,r[2],r[1],r[3],r[4],r[5]);asm volatile(\"mov %%rsp,%0\":\"=r\"(after));if(got!=r[7]||p[5]!=12||p[7]!=r[6]||before!=after)return 1;if(!r[6]){if(p[1]!=r[5]||p[2]!=r[8]||p[3]!=r[9])return 2;}else if(p[1]!=r[0]||p[2]!=0xdeadbeef||p[3]!=0xdeadbeef)return 3;}p[0]=0;((volatile unsigned char*)p)[256]=191;((volatile unsigned char*)p)[320]=4;U words[]={2,(U)p+262,(U)p+320};for(unsigned i=0;i<3;i++){p[1]=words[i];p[7]=0;if(zword((U)p,words[i])!=(i==2?73:words[i]+8))return 4;}register U a asm(\"rbx\")=0xabcdef1234567801ULL,b asm(\"r12\")=0x123456789abcdef0ULL,d asm(\"r13\")=0xfeedfacecafebeefULL,e asm(\"r14\")=0x76543210abcdef09ULL,f asm(\"r15\")=0xfedcba9876543210ULL;asm volatile(\"\":\"+r\"(a),\"+r\"(b),\"+r\"(d),\"+r\"(e),\"+r\"(f));p[1]=31;zwrapper((U)p,1,31,0,1,8);asm volatile(\"\":\"+r\"(a),\"+r\"(b),\"+r\"(d),\"+r\"(e),\"+r\"(f));if(a!=0xabcdef1234567801ULL||b!=0x123456789abcdef0ULL||d!=0xfeedfacecafebeefULL||e!=0x76543210abcdef09ULL||f!=0xfedcba9876543210ULL)return 5;U*pages=mmap(0,8192,3,0x22,-1,0);if(pages==(void*)-1||mprotect((char*)pages+4096,4096,0))return 91;U*edge=(U*)((char*)pages+4088);*edge=0;pid_t child=fork();if(child==0){zwrapper((U)edge,1,31,0,1,8);_exit(99);}int status;if(waitpid(child,&status,0)!=child||!WIFSIGNALED(status)||WTERMSIG(status)!=SIGSEGV)return 6;printf(\"NATIVE %zu WORD3 fault1 ABI1\\n\",sizeof(rows)/sizeof(rows[0]));return 0;}\n"))
    (dolist (enabled '(t nil))
     (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
           (nelisp-aot-compiler--x86-flag-zero (and enabled nelisp-flag-zero-test--enabled))
           (nelisp-aot-compiler--x86-trivial-call-folding nil)
           (nelisp-aot-compiler--x86-partial-call-folding nil)
           (nelisp-flag-zero-test--changes 0))
      (advice-add 'nelisp-aot-compiler--x86-flag-zero-comparisons :around #'nelisp-flag-zero-test--record)
      (unwind-protect (nelisp-aot-compile-to-object (nelisp-flag-zero-test--source) o)
       (advice-remove 'nelisp-aot-compiler--x86-flag-zero-comparisons #'nelisp-flag-zero-test--record))
      (push nelisp-flag-zero-test--changes changes))
     (push (with-temp-buffer (insert-file-contents-literally o) (secure-hash 'sha256 (current-buffer))) objects)
     (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-no-pie" c o "-o" exe)))
     (with-temp-buffer (should (= 0 (call-process exe nil t nil)))
      (should (equal (buffer-string) (format "NATIVE %d WORD3 fault1 ABI1\n" (length rows)))))
     (message "Z GNU%d fullword/order/mutation/WORD/fault/SP/five-save native selector%s PASS" (length rows) (if enabled "-on" "-off")))
    (message "Z native gauge after semantics: on%d off%d" (cadr changes) (car changes))
    ;; Only after both complete native semantic runs may the gauge fail.
    (should (> (cadr changes) 0)) (should (= (car changes) 0))
    (should-not (equal (car objects) (cadr objects))))
   (delete-directory dir t))))
(when (getenv "NELISP_FLAG_ZERO_TEST_DISABLE") (setq nelisp-flag-zero-test--enabled nil))
(provide 'nelisp-aot-flag-zero-test)
