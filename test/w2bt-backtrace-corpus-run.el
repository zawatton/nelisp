(defun bt-show (tag thunk)
  (princ (format "%s %S\n" tag (condition-case e (funcall thunk) (error (list 'ERR e))))))
(bt-show 'chain (lambda () (bt-top1 3)))
(bt-show 'frame-1 (lambda () (bt-fr2 4 5)))
(bt-show 'locals-let (lambda () (bt-loc-outer 5)))
(bt-show 'locals-twice (lambda () (bt-loc-twice 7)))
(bt-show 'exit (lambda () (bt-exit-run 14)))
(bt-show 'overflow (lambda () (bt-overflow)))
(bt-show 'restore (lambda () (bt-restore)))
(bt-show 'wrongargs (lambda () (bt-wrongargs 'bt-two)))
(bt-show 'fn-op (lambda () (bt-fn-op)))
(bt-show 'apply-op (lambda () (bt-apply-op 1 2 3)))
(bt-show 'gc (lambda () (bt-gc-top 5)))
(bt-show 'deep (lambda () (let ((r nil)) (dotimes (_ 3) (push (bt-top1 2) r)) r)))
(defun bt-iloc-inner (z) (backtrace--locals 1 'bt-iloc-inner))
(defun bt-iloc-outer (a) (let ((bt-sv (+ a 10))) (bt-iloc-inner (+ a 1))))
(defun bt-iloc-twice (a) (let ((bt-sv 1)) (let ((bt-sv 2)) (bt-iloc-inner a))))
(defun bt-ibc (a) (let ((bt-sv (+ a 100))) (bt-iloc-inner (bt-two a a))))
(bt-show 'ilocals-let (lambda () (bt-iloc-outer 5)))
(bt-show 'ilocals-twice (lambda () (bt-iloc-twice 7)))
(bt-show 'ilocals-after-bc (lambda () (bt-ibc 3)))
(kill-emacs 0)
