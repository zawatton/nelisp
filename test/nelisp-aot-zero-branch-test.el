;;; nelisp-aot-zero-branch-test.el --- RAW condition projection -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-zero-test--ir (kind &rest args) (apply #'nelisp-aot-compiler--make-ir kind args))
(defun nelisp-zero-test--subject ()
  (nelisp-zero-test--ir 'if :test (nelisp-zero-test--ir 'ref :slot 0)
                       :then (nelisp-zero-test--ir 'imm :value 7)
                       :else (nelisp-zero-test--ir 'ref :slot 1)))
(defun nelisp-zero-test--cmp (subject &optional swap op)
  (let ((zero (nelisp-zero-test--ir 'imm :value 0)))
    (nelisp-zero-test--ir 'cmp :op (or op '=)
                         :a (if swap zero subject) :b (if swap subject zero))))
(ert-deftest nelisp-zero-branch/exact-zero-GP-mode-and-swaps ()
  (let ((subject (nelisp-zero-test--subject))
        (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
        (nelisp-aot-compiler--checked-arith nil)
        (nelisp-aot-compiler--runtime-entry-params nil)
        (nelisp-aot-compiler--lisp-internal-entry-names nil))
    (dolist (swap '(nil t))
      (dolist (op '(= /=))
        (should (eq subject (nelisp-aot-compiler--x86-zero-branch-subject
                             (nelisp-zero-test--cmp subject swap op))))))
    (should-not (nelisp-aot-compiler--x86-zero-branch-subject
                 (nelisp-zero-test--cmp subject nil '<)))
    (let ((typed-zero (nelisp-zero-test--ir 'cmp :op '= :a subject
                                            :b (nelisp-zero-test--ir 'imm :value 0 :class 'f64))))
      (should-not (nelisp-aot-compiler--x86-zero-branch-subject typed-zero)))
    (dolist (key '(:repr :return-repr))
      (dolist (repr '(unknown f64 sexp-ptr word typed nonsense))
        (let ((annotated (vconcat subject (vector key repr))))
          (should-not (nelisp-aot-compiler--x86-zero-branch-subject
                       (nelisp-zero-test--cmp annotated))))))
    (let ((nelisp-aot-compiler--checked-arith t))
      (should-not (nelisp-aot-compiler--x86-zero-branch-subject (nelisp-zero-test--cmp subject))))
    (let ((nelisp-aot-compiler--abi 'win64))
      (should-not (nelisp-aot-compiler--x86-zero-branch-subject (nelisp-zero-test--cmp subject))))
    (let ((nelisp-aot-compiler--runtime-entry-params t))
      (should-not (nelisp-aot-compiler--x86-zero-branch-subject (nelisp-zero-test--cmp subject))))
    (should-not (nelisp-aot-compiler--x86-zero-branch-gp-p
                 (nelisp-zero-test--ir 'ref :slot 0 :class 'f64)))
    (should-not (nelisp-aot-compiler--x86-zero-branch-gp-p
                 (nelisp-zero-test--ir 'imm :value (ash 1 64))))
    (should (nelisp-aot-compiler--x86-zero-branch-gp-p
             (nelisp-zero-test--ir 'imm :value (1- (ash 1 64)))))))
(ert-deftest nelisp-zero-branch/cleanup-and-value-boundaries ()
  (let* ((n (nelisp-zero-test--ir 'let-rt :slot 7 :value-ir (nelisp-zero-test--ir 'imm :value 1)
                                   :body (nelisp-zero-test--subject)))
         (nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--x86-call-free-regions t)
         (nelisp-aot-compiler--promoted-slots nil))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--x86-call-free-region-plan)
               (lambda (_) '(((7 . r12)) 7))))
      (should-not (nelisp-aot-compiler--x86-zero-branch-let-safe-p n)))
    (let ((nelisp-aot-compiler--promoted-slots '((7 . rbx))))
      (cl-letf (((symbol-function 'nelisp-aot-compiler--x86-call-free-region-plan)
                 (lambda (_) (error "must not create a nested map"))))
        (should (nelisp-aot-compiler--x86-zero-branch-let-safe-p n))))
    (let ((nelisp-aot-compiler--x86-shrink-wrap-state (list :cut n)))
      (should (nelisp-aot-compiler--x86-zero-branch-value-boundary-p n)))
    (let ((nelisp-aot-compiler--x86-tco-entry-state (list :outer n)))
      (should (nelisp-aot-compiler--x86-zero-branch-value-boundary-p n)))
    (let ((nelisp-aot-compiler--x86-leaf-entry-state (list :terminal-barriers (list n))))
      (should (nelisp-aot-compiler--x86-zero-branch-value-boundary-p n)))
    (let ((nelisp-aot-compiler--x86-trace-loop-exits (list (cons n 'exit))))
      (should (nelisp-aot-compiler--x86-zero-branch-value-boundary-p n)))))

(ert-deftest nelisp-zero-branch/native-fullword-effects-faults-WORD-and-ABI ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "zero-branch-" t))
         (c (expand-file-name "caller.c" dir)) (obj (expand-file-name "caller.o" dir))
         (target (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (nelisp-aot-compiler--x86-zero-branches (not (getenv "NELISP_ZERO_BRANCH_TEST_DISABLE")))
         (defs nil) (cases nil) (serial 0) (projected 0) (direct-lets 0) (cleanup-fallbacks 0)
         (values '(0 1 -1 -9223372036854775808 9223372036854775807 18446744073709551615))
         (count-if (lambda (&rest _) (when nelisp-aot-compiler--x86-zero-branch-context (cl-incf projected))))
         (count-let (lambda (test &rest _)
                      (when (and nelisp-aot-compiler--x86-zero-branch-context
                                 (eq (nelisp-aot-compiler--ir-kind test) 'let-rt))
                        (if (nelisp-aot-compiler--x86-zero-branch-let-safe-p test)
                            (cl-incf direct-lets) (cl-incf cleanup-fallbacks))))))
    (dolist (op '(= /=))
      (dolist (swap '(nil t))
        (dolist (sense '(nil t))
          (let* ((name (intern (format "uz_case_%d" serial)))
                 (subject '(if (> x 0) 7 y))
                 (cmp (if swap `(,op 0 ,subject) `(,op ,subject 0)))
                 (body `(if ,(if sense `(or ,cmp (= z 7)) cmp) 17 -19)))
            (push `(defun ,name (x y z p) ,body) defs)
            (dolist (x '(-1 0 1)) (dolist (y values) (dolist (z '(0 7))
              (push (list name x y z
                          (eval `(let ((x ,x) (y ,y) (z ,z)) ,body) t)) cases))))
            (cl-incf serial)))))
    (setq defs (nreverse defs) cases (nreverse cases))
    (setq defs (append defs
          '((defun uz_let (x y z p)
              (if (= (let* ((a (seq (atomic-fetch-add (+ p 32) 1) (ptr-read-u64 p 0)))
                             (b a)) (if (> x 0) 9 b)) 0) 17 -19))
            (defun uz_same (x y z p)
              (if (= (if (seq (atomic-fetch-add (+ p 32) 1) (ptr-read-u64 p 8)) 7 -9) 0) 17 -19))
            (defun uz_same_call (x y z p)
              (if (= (if (extern-call U_observe x) 7 -9) 0) 17 -19))
            (defun uz_fault (p)
              (if (= (if (ptr-read-u64 p 0) 7 -9) 0) 17 -19))
            (defun uz_word (w)
              (if (= (if (= (sexp-tag w) 7) 2 (if (= (sexp-tag w) 63) 6 0)) 0) 17 -19))
            (defun uz_call (x y z p)
              (if (= (if (> x 0) 7 (extern-call U_id y)) 0) 17 -19))
            (defun uz_cleanup (x y z p)
              (seq (extern-call U_observe x)
                   (if (= (let* ((a (ptr-read-u64 p 0)) (b (ptr-read-u64 p 8))
                                  (c (ptr-read-u64 p 16)) (d (ptr-read-u64 p 24)))
                            (if (> a 0)
                                (+ a (+ a (+ a (+ b (+ b (+ b (+ c (+ c (+ c (+ d (+ d d)))))))))))
                              0)) 0) (extern-call U_id 17) (extern-call U_id -19)))))))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef U(*F)(U,U,U,U);static U mem[5],bad,calls,observed;extern U uz_let(U,U,U,U),uz_same(U,U,U,U),uz_cleanup(U,U,U,U),uz_call(U,U,U,U),uz_same_call(U,U,U,U),uz_fault(U),uz_word(U);\n")
            (dolist (d defs) (when (string-prefix-p "uz_case_" (symbol-name (cadr d)))
                              (insert (format "extern U %s(U,U,U,U);\n" (cadr d)))))
            (insert "U U_id(U x){++calls;if((U)__builtin_frame_address(0)&15)bad=1;return x;}U U_observe(U x){++observed;U*f=__builtin_frame_address(1);if(f[-1]!=x||((U)__builtin_frame_address(0)&15))bad=1;f[-1]=x^UINT64_C(0x123456789abcdef0);return x^1;}\n")
            (insert "static long os(long n,long a,long b,long c,long d){register long t __asm__(\"r10\")=d;long r;__asm__ volatile(\"syscall\":\"=a\"(r):\"a\"(n),\"D\"(a),\"S\"(b),\"d\"(c),\"r\"(t):\"rcx\",\"r11\",\"memory\");return r;}\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (insert "U check(F f,U a,U b,U c,U d,U want){register U b0 __asm__(\"rbx\")=101;register U b1 __asm__(\"r12\")=103;register U b2 __asm__(\"r13\")=107;register U b3 __asm__(\"r14\")=109;register U b4 __asm__(\"r15\")=113;U s0,s1;__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s0));__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));U v=f(a,b,c,d);__asm__ volatile(\"\":\"+r\"(b0),\"+r\"(b1),\"+r\"(b2),\"+r\"(b3),\"+r\"(b4));__asm__ volatile(\"mov %%rsp,%0\":\"=r\"(s1));return v!=want||s0!=s1||b0!=101||b1!=103||b2!=107||b3!=109||b4!=113;}\nU run(void){U fail=0;mem[0]=1;mem[1]=2;mem[2]=3;mem[3]=4;\n")
            (dolist (v cases)
              (insert (format "fail|=check(%s,%s,0,UINT64_C(%d));\n" (car v)
                              (mapconcat (lambda (n) (format "UINT64_C(%d)" (logand n #xffffffffffffffff))) (cl-subseq v 1 4) ",")
                              (logand (nth 4 v) #xffffffffffffffff))))
            (insert "mem[4]=0;fail|=check(uz_let,0,0,0,(U)mem,UINT64_C(0xffffffffffffffed))||mem[4]!=1;mem[0]=0;mem[4]=0;fail|=check(uz_let,0,0,0,(U)mem,17)||mem[4]!=1;mem[4]=0;fail|=check(uz_same,0,0,0,(U)mem,UINT64_C(0xffffffffffffffed))||mem[4]!=1;\n")
            (insert "mem[0]=1;fail|=check(uz_cleanup,UINT64_C(0xfedcba9876543210),0,0,(U)mem,UINT64_C(0xffffffffffffffed));mem[0]=0;fail|=check(uz_cleanup,1,0,0,(U)mem,17);fail|=check(uz_same_call,1,0,0,0,UINT64_C(0xffffffffffffffed));fail|=check(uz_same_call,UINT64_MAX,0,0,0,UINT64_C(0xffffffffffffffed));fail|=bad||observed!=4;calls=0;fail|=check(uz_call,1,0,0,0,UINT64_C(0xffffffffffffffed))||calls!=0;fail|=check(uz_call,0,0,0,0,17)||calls!=1;fail|=check(uz_call,0,UINT64_C(0x8000000000000000),0,0,UINT64_C(0xffffffffffffffed))||calls!=2;\n")
            (insert "register U t __asm__(\"r10\")=50;register U r8 __asm__(\"r8\")=UINT64_MAX;register U r9 __asm__(\"r9\")=0;U p;__asm__ volatile(\"syscall\":\"=a\"(p):\"a\"(9),\"D\"(UINT64_C(268435456)),\"S\"(4096),\"d\"(3),\"r\"(t),\"r\"(r8),\"r\"(r9):\"rcx\",\"r11\",\"memory\");if(p!=UINT64_C(268435456))return 90;*(unsigned char*)p=191;*(unsigned char*)(p+64)=4;fail|=uz_word(2)!=UINT64_C(0xffffffffffffffed)||uz_word(p+6)!=UINT64_C(0xffffffffffffffed)||uz_word(p+64)!=17;\n")
            (insert "long pid=os(57,0,0,0,0);if(pid==0){uz_fault(0);os(60,99,0,0,0);}if(pid<0)return 91;int st=0;if(os(61,pid,(long)&st,0,0)!=pid)return 92;fail|=(st&127)!=11;return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--emit-if-cond-jump-x86 :before count-if)
          (advice-add 'nelisp-aot-compiler--emit-cond-jump :before count-let)
          (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil))
            (nelisp-aot-compile-to-object (cons 'seq defs) target))
          (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
          (should (= 0 (call-process bin nil nil nil)))
          (message "U fullword/senses/swaps/effects/faults/WORD/returning-frame-observer/SP/callee-saves PASS before projection gauge")
          (should (> projected 0))
          (should (> direct-lets 0))
          (should (> cleanup-fallbacks 0))
          (message "U GNU fullword cases=%d; WORD3, ordered-effects3, genuine-fault1, returning-cleanup2, returning-call3 PASS" (length cases)))
      (advice-remove 'nelisp-aot-compiler--emit-if-cond-jump-x86 count-if)
      (advice-remove 'nelisp-aot-compiler--emit-cond-jump count-let)
      (when (getenv "NELISP_ZERO_BRANCH_TEST_KEEP") (message "U retained test at %s" dir))
      (unless (getenv "NELISP_ZERO_BRANCH_TEST_KEEP") (delete-directory dir t)))))

(provide 'nelisp-aot-zero-branch-test)
