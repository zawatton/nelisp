;;; GNU subr.el definition ownership -*- lexical-binding: t; -*-
(let* ((list (list 65 66))
       (copied (string-to-list list)))
  (prin1 (list 'string-to-list (string-to-list "Aβ") copied (eq list copied)))
  (terpri))
(prin1 (list 'string-to-vector (string-to-vector "Aβ") (string-to-vector '(65 66))))
(terpri)
(prin1 (list 'xor (xor nil 'right) (xor 'left nil) (xor 1 2)))
(terpri)
(prin1 (list 'kbd (append (kbd "C-x C-f") nil) (kbd "<f8>")))
(terpri)
(prin1 (list 'condition-case-unless-debug
             (condition-case-unless-debug error-data (signal 'arith-error nil)
               (error (car error-data)))
             (condition-case-unless-debug result (+ 2 3)
               (:success (1+ result)))))
(terpri)
(with-temp-buffer
  (insert "abc")
  (let ((marker (make-marker)))
    (move-marker marker 2)
    (prin1 (list 'move-marker (marker-position marker)
                 (eq (marker-buffer marker) (current-buffer))))
    (terpri)))
