;;; nelisp-reader-span-smoke.el --- reader span fast paths and label skip  -*- lexical-binding: t -*-
;; Run: BIN --load test/nelisp-reader-span-smoke.el   (also valid under GNU Emacs --batch -l)
;; Expected values are GNU Emacs results.
(defvar rs--fail 0)
(defun rs--check (name ok)
  (unless ok (setq rs--fail (1+ rs--fail)))
  (princ (format "%s %s\n" (if ok "PASS" "FAIL") name)))
(defun rs--r (text) (car (read-from-string text)))
(defmacro rs--case (name text expected)
  `(rs--check ,name (equal (condition-case e (rs--r ,text) (error (list 'err e))) ,expected)))

;; strings with escapes (fast path must decline on any backslash)
(rs--case "str backslash" "\"a\\\\b\"" "a\\b")
(rs--case "str quote" "\"q\\\"q\"" "q\"q")
(rs--case "str hex/unicode/newline" "\"\\x41\\u00e9\\n\"" "Aé\n")
(rs--case "str escape then plain" "\"ab\\tcd\"" "ab\tcd")
(rs--case "str raw newline" "\"l1\nl2\"" "l1\nl2")
(rs--case "str multibyte" "\"日本語ab\"" "日本語ab")
(rs--case "str empty" "\"\"" "")
(rs--check "str ascii is unibyte" (not (multibyte-string-p (rs--r "\"abc\""))))
(rs--check "str non-ascii is multibyte" (multibyte-string-p (rs--r "\"é\"")))
(rs--check "str escaped is unibyte when ascii" (not (multibyte-string-p (rs--r "\"a\\x41\""))))
(rs--case "str unterminated" "\"abc" '(err (end-of-file)))
(rs--case "str trailing backslash" "(\"a\\\\\" 1)" '("a\\" 1))
;; chars
(rs--case "char ctrl-a" "?\\C-a" 1)
(rs--case "char caret" "?\\^a" 1)
(rs--case "char meta" "?\\M-a" 134217825)
(rs--case "char hex" "?\\x41" 65)
(rs--case "char unicode" "?\\u00e9" 233)
(rs--case "char multibyte" "?あ" 12354)
(rs--case "char backslash" "?\\\\" 92)
;; symbols
(rs--check "sym space escape" (eq (rs--r "foo\\ bar") (intern "foo bar")))
(rs--check "sym paren escape" (eq (rs--r "a\\(b") (intern "a(b")))
(rs--check "sym numeric escape" (eq (rs--r "\\123") (intern "123")))
(rs--check "sym backslash escape" (eq (rs--r "a\\\\b") (intern "a\\b")))
(rs--check "sym plain" (eq (rs--r "foo-bar") 'foo-bar))
(rs--check "sym multibyte" (eq (rs--r "日本語") (intern "日本語")))
(rs--check "sym in list" (equal (rs--r "(a\\ b c\\)d e)") (list (intern "a b") (intern "c)d") 'e)))
(rs--case "sym minus plus" "(+ - + 1 -1)" '(+ - + 1 -1))
;; numbers and dots
(rs--case "int/float" "(1 +1 -1 1. 1.5 .5 -.5 1e3 #x1F)" '(1 1 -1 1 1.5 0.5 -0.5 1000.0 31))
(rs--case "dotted" "(a . b)" '(a . b))
(rs--case "dot float" "(0.5 . .5)" '(0.5 . 0.5))
;; labels
(let ((x (rs--r "(#1=(a) #1#)")))
  (rs--check "label shared" (and (equal x '((a) (a))) (eq (car x) (cadr x)))))
(let ((x (rs--r "#1=(a . #1#)")))
  (rs--check "label circular" (and (eq (car x) 'a) (eq (cdr x) x))))
(let ((x (rs--r "[#1=(b) #1#]")))
  (rs--check "label in vector" (and (equal x [(b) (b)]) (eq (aref x 0) (aref x 1)))))
(let ((x (rs--r "(#1=\"s\" #1#)")))
  (rs--check "label string shared" (and (equal x '("s" "s")) (eq (car x) (cadr x)))))
(rs--case "label unused" "#1=(z)" '(z))
(rs--case "no label big" "(a (b (c \"d\" e) [f g]) h)" '(a (b (c "d" e) [f g]) h))
(princ (format "SMOKE-RESULT fail=%d\n" rs--fail))
(kill-emacs (if (= rs--fail 0) 0 1))
