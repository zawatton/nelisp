;;; -*- lexical-binding: t; -*-
;; primx corpus: prints one line per case; run on GNU Emacs and on the NeLisp binary and diff.
(defmacro pxc (name form)
  `(princ (format "%s => %S\n" ,name (condition-case e ,form (error (list 'err (car e)))))))
(defun pxc-ht (&rest args)
  (let ((h (apply #'make-hash-table args)))
    (puthash 1 'a h) (puthash "k" 'b h) (puthash 1.0 'c h) (puthash 'x 'd h)
    (list (hash-table-test h) (hash-table-weakness h) (hash-table-count h)
          (gethash 1 h) (gethash "k" h) (gethash 1.0 h) (gethash 'x h) (hash-table-p h))))
(defun pxc-run ()
  (let ((pl '(:a 1 :b 2 :c 3)) (s "str") (circ (list :a 1 :b)))
    (setcdr (cddr circ) circ)
    (pxc "pg-hit" (plist-get pl :b))
    (pxc "pg-first" (plist-get pl :a))
    (pxc "pg-last" (plist-get pl :c))
    (pxc "pg-miss" (plist-get pl :z))
    (pxc "pg-nil" (plist-get nil :a))
    (pxc "pg-odd" (plist-get '(:a 1 :b) :b))
    (pxc "pg-improper" (plist-get '(:a . 5) :b))
    (pxc "pg-nonlist" (plist-get 5 :a))
    (pxc "pg-circ-hit" (plist-get circ :a))
    (pxc "pg-circ-miss" (plist-get circ :q))
    (pxc "pg-string-key" (plist-get (list s 1) s))
    (pxc "pg-string-equal-key" (plist-get (list "a" 1) "a"))
    (pxc "pg-num-key" (plist-get '(1 :one 2 :two) 2))
    (pxc "pg-nil-key" (plist-get '(nil :n) nil))
    (pxc "pg-pred-eq" (plist-get pl :b #'eq))
    (pxc "pg-pred-equal" (plist-get (list "a" 1) "a" #'equal))
    (pxc "pg-pred-nil" (plist-get pl :b nil))
    (pxc "pg-arity0" (funcall 'plist-get))
    (pxc "pg-arity1" (funcall 'plist-get pl))
    (pxc "pg-arity4" (funcall 'plist-get pl :a nil nil))
    (pxc "pg-apply" (apply #'plist-get (list pl :c)))
    (pxc "mh-default" (pxc-ht))
    (pxc "mh-eq" (pxc-ht :test 'eq))
    (pxc "mh-eql" (pxc-ht :test 'eql))
    (pxc "mh-equal" (pxc-ht :test 'equal))
    (pxc "mh-size" (pxc-ht :size 10))
    (pxc "mh-size0" (pxc-ht :size 0))
    (pxc "mh-size-neg" (pxc-ht :size -1))
    (pxc "mh-size-nil" (pxc-ht :size nil))
    (pxc "mh-size-str" (pxc-ht :size "x"))
    (pxc "mh-weak-key" (hash-table-weakness (make-hash-table :weakness 'key)))
    (pxc "mh-weak-value" (hash-table-weakness (make-hash-table :weakness 'value)))
    (pxc "mh-weak-kov" (hash-table-weakness (make-hash-table :weakness 'key-or-value)))
    (pxc "mh-weak-kav" (hash-table-weakness (make-hash-table :weakness 'key-and-value)))
    (pxc "mh-weak-t" (hash-table-weakness (make-hash-table :weakness t)))
    (pxc "mh-weak-nil" (hash-table-weakness (make-hash-table :weakness nil)))
    (pxc "mh-weak-bad" (make-hash-table :weakness 'bogus))
    (pxc "mh-all" (pxc-ht :test 'eql :size 5 :weakness nil :rehash-size 1.5 :rehash-threshold 0.8 :purecopy t))
    (pxc "mh-first-wins" (hash-table-test (make-hash-table :test 'eq :test 'equal)))
    (pxc "mh-first-wins-size" (pxc-ht :size 3 :size 100))
    (pxc "mh-odd" (make-hash-table :test))
    (pxc "mh-unknown-kw" (make-hash-table :bogus 1))
    (pxc "mh-nonkw" (make-hash-table 1 2))
    (pxc "mh-bad-test" (make-hash-table :test 'nosuchtest))
    (pxc "mh-bad-test-num" (make-hash-table :test 5))
    (pxc "mh-apply" (hash-table-test (apply #'make-hash-table '(:test equal))))
    ;; user-defined test
    (define-hash-table-test 'pxc-ci (lambda (a b) (equal (downcase a) (downcase b))) (lambda (k) (sxhash-equal (downcase k))))
    (pxc "mh-custom" (let ((h (make-hash-table :test 'pxc-ci))) (puthash "A" 1 h) (list (gethash "a" h) (hash-table-test h))))
    ;; redefinition / advice fall back
    (let ((orig (symbol-function 'plist-get)))
      (fset 'plist-get (lambda (&rest _) 'redefined))
      (pxc "pg-redefined" (plist-get pl :b))
      (fset 'plist-get orig)
      (pxc "pg-restored" (plist-get pl :b)))
    (let ((orig (symbol-function 'make-hash-table)))
      (fset 'make-hash-table (lambda (&rest _) 'redefined))
      (pxc "mh-redefined" (make-hash-table :test 'eq))
      (fset 'make-hash-table orig)
      (pxc "mh-restored" (hash-table-test (make-hash-table :test 'eq))))
    (defvar pxc-count 0)
    (advice-add 'plist-get :before (lambda (&rest _) (setq pxc-count (1+ pxc-count))))
    (pxc "pg-advised" (list (plist-get pl :b) pxc-count))
    (advice-remove 'plist-get (car (mapcar #'identity (let (l) (advice-mapc (lambda (f _) (push f l)) 'plist-get) l))))
    (pxc "pg-unadvised" (plist-get pl :b))
    ;; loop shape used by the hot rows
    (pxc "loop-pg" (let ((s 0)) (dotimes (_ 200) (setq s (+ s (plist-get pl :b)))) s))
    (pxc "loop-mh" (let ((n 0)) (dotimes (_ 200) (setq n (+ n (hash-table-count (make-hash-table :test 'eq))))) n))))
(pxc-run)
(kill-emacs 0)
