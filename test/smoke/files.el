;;; files.el --- File lifecycle and coding systems -*- lexical-binding: t; -*-

(defun smoke-files ()
  (let ((file (expand-file-name "notes.txt"))
        (make-backup-files t)
        (backup-directory-alist nil)
        (backup-inhibited nil)
        (auto-save-default t)
        (auto-save-file-name-transforms nil))
    (smoke-step "files-open-save"
      (find-file file)
      (goto-char (point-max))
      (insert "saved\n")
      (save-buffer)
      (list (smoke-state) (smoke-read file) (smoke-read (concat file "~"))))
    (smoke-step "files-autosave"
      (with-current-buffer (find-file-noselect file)
        (goto-char (point-max))
        (insert "unsaved\n")
        (auto-save-mode 1)
        (do-auto-save t t)
        (and buffer-auto-save-file-name (smoke-read buffer-auto-save-file-name))))
    (smoke-step "files-revert"
      (with-current-buffer (find-file-noselect file)
        (revert-buffer t t)
        (list (smoke-state) (buffer-modified-p))))
    (dolist (coding '(utf-8 shift_jis euc-jp))
      (smoke-step (symbol-name coding)
        (let* ((text "日本語 かな\n")
               (name (expand-file-name (concat (symbol-name coding) ".txt")))
               (coding-system-for-write coding))
          (with-temp-buffer (insert text) (write-region nil nil name nil 'silent))
          (let ((coding-system-for-read coding))
            (with-current-buffer (find-file-noselect name)
              (list (file-attribute-size (file-attributes name))
                    (coding-system-base buffer-file-coding-system)
                    (smoke-state)
                    (equal (buffer-substring-no-properties (point-min) (point-max))
                           text)))))))
    (smoke-step "files-gzip"
      (require 'jka-compr)
      (auto-compression-mode 1)
      (find-file (expand-file-name "compressed.txt.gz"))
      (let ((text (buffer-substring-no-properties (point-min) (point-max))))
        (unless (equal text "gzip fixture\n")
          (error "Expected gzip fixture text, got %d characters" (length text)))
        (list major-mode (point) text)))))
