;;; nelisp-primitive-callback-test.el --- Rooted primitive callbacks -*- lexical-binding: t; -*-
(require 'nelisp-directcall-test)
(require 'nelisp-hashfast-test)

(defconst npc--specs '(("1+" 105 1 1) ("1-" 106 1 1) ("+" 107 0 many)
                       ("-" 108 0 many) ("cdr" 109 1 1)
                       ("identity" 110 1 1) ("cons" 111 2 2)))

(ert-deftest npc-descriptors-use-gnu-arity ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (name "1+"))
       (puthash 10000 20006 mem) (puthash 10008 10018 mem)
       (puthash 10016 20022 mem) (puthash 10024 3 mem)
       (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'nl_val_tag) (lambda (_) 4))
                 ((symbol-function 'nl_sym_sid)
                  (lambda (w) (or (nelisp-standalone--sid (if (= w 20006) "builtin" name)) 0)))
                 ((symbol-function 'sexp-name-eq) (lambda (_ s) (if (equal name s) 1 0))))
         (dolist (spec npc--specs)
           (setq name (car spec))
           (dolist (n '(-1 0 1 2 3 255 256))
             (should (= (nl_directcall_id 10002 20022 n)
                        (if (and (>= n (nth 2 spec)) (<= n 255)
                                 (or (eq (nth 3 spec) 'many) (<= n (nth 3 spec))))
                            (nth 1 spec) 0))))))))))

(ert-deftest npc-word-bodies-match-gnu-and-decline-without-effects ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (conses 0))
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                 ((symbol-function 'nl_val_tag) (lambda (w) (cond ((= w 3) 0) ((= w 10002) 7) (t 4))))
                 ((symbol-function 'nl_cons_cdr_word) (lambda (_) 29))
                 ((symbol-function 'nelisp_cons_construct_w)
                  (lambda (a b _) (cl-incf conses) (should (= a 29)) (should (= b 3)) 10002))
                 ((symbol-function 'm5_fx_primitive_run) (lambda (&rest _) -3)))
         (dolist (row '((105 (0) 1) (106 (0) -1) (107 () 0) (108 () 0)
                        (107 (1 2 -8) -5) (108 (1 2 -8) 7) (108 (-5) 5)))
           (cl-loop for x in (nth 1 row) for i from 0 do (puthash (+ 100 (* i 8)) (1+ (* x 4)) mem))
           (should (= (nl_directcall_run (car row) 100 (length (nth 1 row)) 200 0) 0))
           (should (= (gethash 200 mem) (1+ (* 4 (nth 2 row))))))
         (dolist (row `((105 (,(1- (expt 2 61)))) (106 (,(- (expt 2 61))))
                        (107 (,(1- (expt 2 61)) 1)) (108 (,(- (expt 2 61))))
                        (108 (,(- (expt 2 61)) 1))))
           (cl-loop for x in (cadr row) for i from 0 do (puthash (+ 100 (* i 8)) (1+ (* x 4)) mem))
           (puthash 200 999 mem)
           (should (= (nl_directcall_run (car row) 100 (length (cadr row)) 200 0) -3))
           (should (= (gethash 200 mem) 999)))
         ;; Nonfixnums include marker/float/bignum/wrong-type words. No output
         ;; or cons allocation is allowed before declining to the reference.
         (dolist (id '(105 106 107 108 109))
           (puthash 100 20022 mem) (puthash 200 999 mem)
           (should (= (nl_directcall_run id 100 1 200 0) -3))
           (should (= (gethash 200 mem) 999)))
         (puthash 100 3 mem)
         (should (= (nl_directcall_run 109 100 1 200 0) 0))
         (should (= (gethash 200 mem) 3))
         (puthash 100 10002 mem)
         (should (= (nl_directcall_run 109 100 1 200 0) 0))
         (should (= (gethash 200 mem) 29))
         (should (= (nl_directcall_run 110 100 1 200 0) 0))
         (should (= (gethash 200 mem) 10002))
         (puthash 100 29 mem) (puthash 108 3 mem)
         (should (= (nl_directcall_run 111 100 2 200 0) 0))
         (should (= conses 1))
         (should (= (gethash 200 mem) 10002)))))))

(ert-deftest npc-callback-kind-and-current-cell-per-element ()
  ;; cbfast: the id is computed once by `wf_cb_kind' (for the walk's own argc);
  ;; `wf_cb_call_words' never asks `nl_directcall_id' again for an unchanged
  ;; cell, and a changed cell re-resolves through `nl_directcall_invoke'.
  (hf--install '(wf_cb_target wf_cb_kind wf_cb_prim_call wf_cb_call_words))
  (let ((mem (make-hash-table :test #'eql)) (current 10002) (seen nil) (ids 0)
        (frames 0) (finished 0) (ran nil))
    (puthash 100 20024 mem) (puthash 1112 0 mem)
    (puthash 10000 20006 mem) (puthash 10008 10018 mem)
    (puthash 10016 20030 mem) (puthash 10024 3 mem)
    (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
              ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
              ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
              ((symbol-function 'nl_val_tag) (lambda (w) (if (= w 20024) 4 7)))
              ((symbol-function 'nelisp_env_lookup_function_w) (lambda (&rest _) current))
                ((symbol-function 'nelisp_env_lookup_function_raw_w) (lambda (&rest _) current))
              ((symbol-function 'nl_directcall_id)
               (lambda (fn _ n) (cl-incf ids) (if (and (= fn 10002) (= n 1)) 112 0)))
              ((symbol-function 'nl_n4_push_words)
               (lambda (_env name argp argc) (cl-incf frames) (should (= name 20024))
                 (should (= argp 132)) (should (= argc 1)) 7777))
              ((symbol-function 'nl_directcall_fast_run) (lambda (&rest _) -4))
              ((symbol-function 'nl_directcall_run)
               (lambda (id base argc result _env)
                 (push (list id base argc result) ran) (puthash result 555 mem) 0))
              ((symbol-function 'nl_n4_finish_w)
               (lambda (w _env _pad frame) (cl-incf finished) (should (= frame 7777)) w))
              ((symbol-function 'nl_directcall_invoke)
               (lambda (fn original base argc env out)
                 (push (list fn original base argc env out) seen)
                 2)))
      (should (= (wf_cb_kind 1000 100 40 1) (+ 1000 17 112)))
      (should (= ids 1))
      (should (= (gethash 140 mem) 10002))
      (should (= (gethash 148 mem) 20006))
      (should (= (gethash 156 mem) 10018))
      (should (= (gethash 164 mem) 20030))
      (puthash 108 3 mem)
      ;; Unchanged cell: no id, no invoke, one backtrace entry, one WORD body.
      ;; (w1leaf: id 112 is an allocating id and keeps its record; the leaf ids
      ;; take none, see nelisp-directcall-leaf-test.el.)
      (should (= (wf_cb_call_words 1000 100 1 40 (+ 1000 17 112)) 0))
      (should (= (wf_cb_call_words 1000 100 1 40 (+ 1000 17 112)) 0))
      (should (= ids 1))
      (should (null seen))
      (should (= frames 2))
      (should (= finished 2))
      (should (equal (car ran) '(112 132 1 124)))
      (should (= (gethash 124 mem) 555))
      ;; A redefined cell takes the existing per-element validation.
      (setq current 30002)
      (should (= (wf_cb_call_words 1000 100 1 40 (+ 1000 17 112)) 2))
      (should (equal (nreverse seen) '((30002 20024 132 1 1000 124))))
      (should (= frames 2)))))

(ert-deftest npc-callback-cell-mutated-in-place-takes-old-route ()
  ;; The builtin cell is a cons: a setcar on its head (or its name) keeps the
  ;; cell word but must not keep the walk's id.
  (hf--install '(wf_cb_prim_call))
  (dolist (mutation '((10000 . 29) (10016 . 31) (10008 . 10098)))
    (let ((mem (make-hash-table :test #'eql)) (seen nil) (ran 0))
      (puthash 100 20024 mem) (puthash 1112 0 mem) (puthash 140 10002 mem)
      (puthash 148 20006 mem) (puthash 156 10018 mem) (puthash 164 20030 mem)
      (puthash 10000 20006 mem) (puthash 10008 10018 mem)
      (puthash 10016 20030 mem) (puthash 10024 3 mem)
      (puthash 10090 3 mem)
      (puthash (car mutation) (cdr mutation) mem)
      (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'nl_val_tag) (lambda (w) (if (= w 20024) 4 7)))
                ((symbol-function 'nelisp_env_lookup_function_w) (lambda (&rest _) 10002))
                ((symbol-function 'nelisp_env_lookup_function_raw_w) (lambda (&rest _) 10002))
                ((symbol-function 'nl_n4_push_words) (lambda (&rest _) (cl-incf ran) 1))
                ((symbol-function 'nl_directcall_fast_run) (lambda (&rest _) (cl-incf ran) -4))
                ((symbol-function 'nl_directcall_run) (lambda (&rest _) (cl-incf ran) 0))
                ((symbol-function 'nl_directcall_invoke)
                 (lambda (fn &rest _) (push fn seen) 2)))
        (should (= (wf_cb_prim_call 1000 100 1 40 (+ 1000 17 105)) 2))
        (should (equal seen '(10002)))
        (should (= ran 0))))))

(ert-deftest npc-callback-debug-policy-and-symbol-object-cell-read ()
  ;; A tag-6 symbol object's function slot (+24) is read in place, as GNU
  ;; reads XSYMBOL (fun)->u.s.function; the debug policy bits decline per element.
  (hf--install '(wf_cb_prim_call))
  (dolist (policy '(0 1048576))
    (let ((mem (make-hash-table :test #'eql)) (lookups 0) (invoked 0) (pushed nil))
      (puthash 100 20006 mem) (puthash 140 10002 mem)
      (puthash 148 20006 mem) (puthash 156 10018 mem) (puthash 164 20030 mem)
      (puthash 10000 20006 mem) (puthash 10008 10018 mem)
      (puthash 10016 20030 mem) (puthash 10024 3 mem)
      (puthash (+ 20000 24) 10002 mem)       ; object 20006 - 6 = 20000
      (puthash (+ 2000 112) policy mem) (puthash 124 555 mem)
      (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'nl_val_tag) (lambda (_) 4))
                ((symbol-function 'nelisp_env_lookup_function_w)
                 (lambda (&rest _) (cl-incf lookups) 10002))
                ((symbol-function 'nelisp_env_lookup_function_raw_w)
                 (lambda (&rest _) (cl-incf lookups) 10002))
                ((symbol-function 'nl_n4_push_words)
                 (lambda (_env name &rest _) (push name pushed) 9))
                ((symbol-function 'nl_directcall_fast_run) (lambda (&rest _) -4))
                ((symbol-function 'nl_directcall_run) (lambda (&rest _) 0))
                ((symbol-function 'nl_n4_finish_w) (lambda (w &rest _) w))
                ((symbol-function 'nl_directcall_invoke)
                 (lambda (&rest _) (cl-incf invoked) 2)))
        (should (= (wf_cb_prim_call 2000 100 1 40 (+ 1000 17 112)) (if (= policy 0) 0 2)))
        (should (= invoked (if (= policy 0) 0 1)))
        (should (= lookups (if (= policy 0) 0 1)))
        (should (equal pushed (if (= policy 0) '(20006) nil)))))))

(ert-deftest npc-fast-run-agrees-with-the-reference-bodies ()
  ;; `nl_directcall_fast_run' either declines (-4, nothing written) or writes
  ;; exactly what the reference body `nl_directcall_callback_run' writes.
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (handled 0) (declined 0)
           (cons-word 10002) (edge (list 0 1 -1 7 -8 (1- (expt 2 61)) (- (expt 2 61))
                                         (- (expt 2 61) 2) (+ (- (expt 2 61)) 1))))
       (puthash 10000 29 mem) (puthash 10008 33 mem) ; car/cdr of the cons at 10002
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                 ((symbol-function 'nl_val_tag)
                  (lambda (w) (cond ((= w 3) 0) ((= (logand w 7) 2) 7) (t 4))))
                 ((symbol-function 'nl_cons_car_word) (lambda (_) 29))
                 ((symbol-function 'nl_cons_cdr_word) (lambda (_) 33)))
         (dolist (id '(1 109 110 105 106 107 108))
           (dolist (argc (if (memq id '(107 108)) '(1 2) '(1)))
             (dolist (a (append (mapcar (lambda (x) (1+ (* 4 x))) edge) (list 3 cons-word 20022)))
               (dolist (b (if (= argc 2) (append (mapcar (lambda (x) (1+ (* 4 x))) edge) (list 3 20022)) '(3)))
                 (puthash 100 a mem) (puthash 108 b mem)
                 (puthash 200 999 mem) (puthash 300 999 mem)
                 (let ((fast (nl_directcall_fast_run id 100 argc 200))
                       (ref (nl_directcall_callback_run id 100 argc 300)))
                   (if (= fast -4)
                       (progn (cl-incf declined) (should (= (gethash 200 mem) 999)))
                     (cl-incf handled)
                     (should (= fast 0)) (should (= ref 0))
                     (should (= (gethash 200 mem) (gethash 300 mem)))))))))
         ;; The common shapes are really handled, not declined.
         (puthash 100 (1+ (* 4 5)) mem) (puthash 108 (1+ (* 4 7)) mem)
         (should (= (nl_directcall_fast_run 107 100 2 200) 0))
         (should (= (gethash 200 mem) (1+ (* 4 12))))
         (should (= (nl_directcall_fast_run 105 100 1 200) 0))
         (puthash 100 cons-word mem)
         (should (= (nl_directcall_fast_run 1 100 1 200) 0))
         (should (= (gethash 200 mem) 29))
         (should (> handled 100))
         (should (> declined 20)))))))

(ert-deftest npc-length-walk-compares-words-not-identity-calls ()
  (hf--install '(wf_mapc_length_w))
  (let* ((cdrs (make-hash-table :test #'eql)) (identity-calls 0))
    ;; Direct cons words are 8k+2; nil is 3.
    (cl-letf (((symbol-function 'nl_val_tag)
               (lambda (w) (cond ((= (logand w 7) 2) 7) ((= w 3) 0) (t 4))))
              ((symbol-function 'nl_cons_cdr_word) (lambda (w) (gethash w cdrs)))
              ((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (- (+ p i) 6) cdrs)))
              ((symbol-function 'nl_imm_int) (lambda (n) (list 'int n)))
              ((symbol-function 'bf_signal_circular_list) (lambda (w) (list 'circular w)))
              ((symbol-function 'bf_wrong_type_listp) (lambda (w) (list 'listp w)))
              ((symbol-function 'nl_abi_fail) (lambda (e _) e))
              ((symbol-function 'bf_plist_cons_identity_w)
               (lambda (a b) (cl-incf identity-calls) (if (= a b) 1 0))))
      (let ((chain (lambda (&rest ws)
                     (cl-loop for i below (1- (length ws))
                              do (puthash (nth i ws) (nth (1+ i) ws) cdrs)))))
        (funcall chain 10 18 26 34 42 50 58 3)
        (should (equal (wf_mapc_length_w 10) '(int 7)))
        (funcall chain 10 18 26 34 42 50 58 18)
        ;; parity7: like GNU's FOR_EACH_TAIL, circular-list carries the tail
        ;; where the Brent walk detected the cycle, not the list head.
        (should (equal (wf_mapc_length_w 10) '(circular 58)))
        (funcall chain 10 18 26 99)
        (should (equal (wf_mapc_length_w 10) '(listp 99)))
        (should (= identity-calls 0))))))

(ert-deftest npc-car-has-a-word-body-and-declines-without-effects ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (slow 0))
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                 ((symbol-function 'nl_val_tag) (lambda (w) (cond ((= w 3) 0) ((= w 10002) 7) (t 4))))
                 ((symbol-function 'nl_cons_car_word) (lambda (_) 29))
                 ((symbol-function 'm5_fx_primitive_run) (lambda (&rest _) (cl-incf slow) -3)))
         (puthash 100 10002 mem) (puthash 200 999 mem)
         (should (= (nl_directcall_run 1 100 1 200 0) 0))
         (should (= (gethash 200 mem) 29))
         (puthash 100 3 mem)
         (should (= (nl_directcall_run 1 100 1 200 0) 0))
         (should (= (gethash 200 mem) 3))
         (puthash 100 20022 mem) (puthash 200 999 mem)
         (should (= (nl_directcall_run 1 100 1 200 0) -3))
         (should (= (gethash 200 mem) 999))
         (should (= slow 0)))))))

(ert-deftest npc-id-hits-a-symbol-object-original-without-the-name-chain ()
  ;; The walkers hold the symbol OBJECT word (tag 6); the descriptor's name is a
  ;; view (tag 0), so no word is ever `=' to it.  The static id decides.
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (comparisons 0) (name "car"))
       (puthash 10000 20006 mem) (puthash 10008 10018 mem)
       (puthash 10016 20024 mem) (puthash 10024 3 mem)
       (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'nl_val_tag) (lambda (_) 4))
                 ((symbol-function 'nl_sym_sid)
                  (lambda (w) (cond ((= w 20006) (nelisp-standalone--sid "builtin"))
                                    ((= w 20024) (nelisp-standalone--sid "car"))
                                    ((= w 30006) (nelisp-standalone--sid "car"))
                                    ((= w 30014) (nelisp-standalone--sid "cdr"))
                                    (t 0))))
                 ((symbol-function 'sexp-name-eq) (lambda (&rest _) (cl-incf comparisons) 0)))
         (should (= (nl_directcall_id 10002 30006 1) 1))
         (should (= comparisons 0))
         ;; Another symbol, an uninterned one (no static id) and a view stay on
         ;; the conservative path, which these mocks make decline.
         (should (= (nl_directcall_id 10002 30014 1) 0))
         (should (= (nl_directcall_id 10002 30022 1) 0))
         (should (= (nl_directcall_id 10002 30006 2) 0)))))))

(ert-deftest npc-mapcar-rooted-argv-status-and-fallback ()
  (hf--install '(wf_mapcar_step))
  (dolist (status '(0 1 2))
    (let ((mem (make-hash-table :test #'eql)) (old 0) (direct 0) (conses 0))
      (puthash 100 20022 mem) (puthash 108 10002 mem) (puthash 116 3 mem)
      (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                ((symbol-function 'nl_val_tag) (lambda (w) (if (= w 10002) 7 0)))
                ((symbol-function 'nl_cons_car_word) (lambda (_) 29))
                ((symbol-function 'nl_cons_cdr_word) (lambda (_) 3))
                ((symbol-function 'wf_word_view) #'identity)
                ((symbol-function 'wf_cb_kind) (lambda (&rest _) 3))
                ((symbol-function 'wf_cb_call_words)
                 (lambda (_ roots argc slot kind)
                   (cl-incf direct) (should (= (gethash (+ roots 32) mem) 29))
                   (should (equal (list argc slot kind) '(1 40 3)))
                   (puthash (+ roots 24) 33 mem) status))
                ((symbol-function 'nl_apply_function_w) (lambda (&rest _) (cl-incf old) 33))
                ((symbol-function 'nelisp_cons_construct_w) (lambda (&rest _) (cl-incf conses) 10010)))
        ;; parity7: the third argument is the Flength pre-pass length; the
        ;; one-element list runs exactly one trip.
        (should (= (wf_mapcar_step 100 1000 1) (if (= status 1) 1 0)))
        (should (= direct 1))
        (should (= old (if (= status 2) 1 0)))
        (should (= conses (if (= status 1) 0 (if (= status 2) 2 1))))))))

(ert-deftest npc-mapcar-keeps-original-symbol-and-six-root-slots ()
  (let ((f (hf--definition 'wf_mapcar_w)))
    ;; Recursive structural checks below inspect exact forms, not substrings.
    (cl-labels ((has (needle x) (or (equal needle x)
                                  (and (consp x) (or (has needle (car x)) (has needle (cdr x)))))))
      (should (has '(nl_root_words env 9) f))
      (should (has '(ptr-write-u64 roots 0 (nl_word_canon fnw)) f)))))

(provide 'nelisp-primitive-callback-test)
