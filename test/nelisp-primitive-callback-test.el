;;; nelisp-primitive-callback-test.el --- Rooted primitive callbacks -*- lexical-binding: t; -*-
(require 'nelisp-directcall-test)
(require 'nelisp-hashfast-test)

(defconst npc--specs '(("1+" 105 1 1) ("1-" 106 1 1) ("+" 107 0 many)
                       ("-" 108 0 many) ("cdr" 109 1 1)
                       ("identity" 110 1 1) ("cons" 111 2 2)))

(ert-deftest npc-descriptors-use-gnu-arity ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (name "1+"))
       (puthash 10000 20006 mem) (puthash 10008 10018 mem)
       (puthash 10016 20022 mem) (puthash 10024 3 mem)
       (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'nl_val_tag) (lambda (_) 4))
                 ((symbol-function 'nl_sym_sid)
                  (lambda (w) (or (nelisp-standalone--sid (if (= w 20006) "builtin" name)) 0)))
                 ((symbol-function 'sexp-name-eq) (lambda (_ s) (if (equal name s) 1 0))))
         (dolist (spec npc--specs)
           (setq name (car spec))
           (dolist (n '(-1 0 1 2 3 255 256))
             (should (= (nl_directcall_id 10002 20022 n)
                        (if (and (>= n (nth 2 spec)) (<= n 255)
                                 (or (eq (nth 3 spec) 'many) (<= n (nth 3 spec))))
                            (nth 1 spec) 0))))))))))

(ert-deftest npc-word-bodies-match-gnu-and-decline-without-effects ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (conses 0))
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                 ((symbol-function 'nl_val_tag) (lambda (w) (cond ((= w 3) 0) ((= w 10002) 7) (t 4))))
                 ((symbol-function 'nl_cons_cdr_word) (lambda (_) 29))
                 ((symbol-function 'nelisp_cons_construct_w)
                  (lambda (a b _) (cl-incf conses) (should (= a 29)) (should (= b 3)) 10002))
                 ((symbol-function 'm5_fx_primitive_run) (lambda (&rest _) -3)))
         (dolist (row '((105 (0) 1) (106 (0) -1) (107 () 0) (108 () 0)
                        (107 (1 2 -8) -5) (108 (1 2 -8) 7) (108 (-5) 5)))
           (cl-loop for x in (nth 1 row) for i from 0 do (puthash (+ 100 (* i 8)) (1+ (* x 4)) mem))
           (should (= (nl_directcall_run (car row) 100 (length (nth 1 row)) 200 0) 0))
           (should (= (gethash 200 mem) (1+ (* 4 (nth 2 row))))))
         (dolist (row `((105 (,(1- (expt 2 61)))) (106 (,(- (expt 2 61))))
                        (107 (,(1- (expt 2 61)) 1)) (108 (,(- (expt 2 61))))
                        (108 (,(- (expt 2 61)) 1))))
           (cl-loop for x in (cadr row) for i from 0 do (puthash (+ 100 (* i 8)) (1+ (* x 4)) mem))
           (puthash 200 999 mem)
           (should (= (nl_directcall_run (car row) 100 (length (cadr row)) 200 0) -3))
           (should (= (gethash 200 mem) 999)))
         ;; Nonfixnums include marker/float/bignum/wrong-type words. No output
         ;; or cons allocation is allowed before declining to the reference.
         (dolist (id '(105 106 107 108 109))
           (puthash 100 20022 mem) (puthash 200 999 mem)
           (should (= (nl_directcall_run id 100 1 200 0) -3))
           (should (= (gethash 200 mem) 999)))
         (puthash 100 3 mem)
         (should (= (nl_directcall_run 109 100 1 200 0) 0))
         (should (= (gethash 200 mem) 3))
         (puthash 100 10002 mem)
         (should (= (nl_directcall_run 109 100 1 200 0) 0))
         (should (= (gethash 200 mem) 29))
         (should (= (nl_directcall_run 110 100 1 200 0) 0))
         (should (= (gethash 200 mem) 10002))
         (puthash 100 29 mem) (puthash 108 3 mem)
         (should (= (nl_directcall_run 111 100 2 200 0) 0))
         (should (= conses 1))
         (should (= (gethash 200 mem) 10002)))))))

(ert-deftest npc-callback-kind-and-current-cell-per-element ()
  (hf--install '(wf_cb_target wf_cb_kind wf_cb_call_words))
  (let ((mem (make-hash-table :test #'eql)) (current 10002) (seen nil))
    (puthash 100 20022 mem)
    (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
              ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
              ((symbol-function 'nl_val_tag) (lambda (w) (if (= w 20022) 4 7)))
              ((symbol-function 'nelisp_env_lookup_function_w) (lambda (&rest _) current))
              ((symbol-function 'nl_directcall_id) (lambda (fn _ n) (if (and (= fn 10002) (= n 1)) 105 0)))
              ((symbol-function 'nl_directcall_invoke)
               (lambda (fn original base argc env out)
                 (push (list fn original base argc env out) seen)
                 (should (= (gethash 140 mem) fn))
                 (if (= fn 10002) 0 2))))
      (should (= (wf_cb_kind 1000 100 40) 3))
      (should (= (wf_cb_call_words 1000 100 1 40 3) 0))
      (setq current 30002)
      (should (= (wf_cb_call_words 1000 100 1 40 3) 2))
      (should (equal (nreverse seen) '((10002 20022 132 1 1000 124)
                                      (30002 20022 132 1 1000 124)))))))

(ert-deftest npc-mapcar-rooted-argv-status-and-fallback ()
  (hf--install '(wf_mapcar_step))
  (dolist (status '(0 1 2))
    (let ((mem (make-hash-table :test #'eql)) (old 0) (direct 0) (conses 0))
      (puthash 100 20022 mem) (puthash 108 10002 mem) (puthash 116 3 mem)
      (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                ((symbol-function 'ptr-write-u64) (lambda (p i w) (puthash (+ p i) w mem)))
                ((symbol-function 'nl_val_tag) (lambda (w) (if (= w 10002) 7 0)))
                ((symbol-function 'nl_cons_car_word) (lambda (_) 29))
                ((symbol-function 'nl_cons_cdr_word) (lambda (_) 3))
                ((symbol-function 'wf_word_view) #'identity)
                ((symbol-function 'wf_cb_kind) (lambda (&rest _) 3))
                ((symbol-function 'wf_cb_call_words)
                 (lambda (_ roots argc slot kind)
                   (cl-incf direct) (should (= (gethash (+ roots 32) mem) 29))
                   (should (equal (list argc slot kind) '(1 40 3)))
                   (puthash (+ roots 24) 33 mem) status))
                ((symbol-function 'nl_apply_function_w) (lambda (&rest _) (cl-incf old) 33))
                ((symbol-function 'nelisp_cons_construct_w) (lambda (&rest _) (cl-incf conses) 10010)))
        (should (= (wf_mapcar_step 100 1000) (if (= status 1) 1 0)))
        (should (= direct 1))
        (should (= old (if (= status 2) 1 0)))
        (should (= conses (if (= status 1) 0 (if (= status 2) 2 1))))))))

(ert-deftest npc-mapcar-keeps-original-symbol-and-six-root-slots ()
  (let ((f (hf--definition 'wf_mapcar_w)))
    ;; Recursive structural checks below inspect exact forms, not substrings.
    (cl-labels ((has (needle x) (or (equal needle x)
                                  (and (consp x) (or (has needle (car x)) (has needle (cdr x)))))))
      (should (has '(nl_root_words env 6) f))
      (should (has '(ptr-write-u64 roots 0 (nl_word_canon fnw)) f)))))

(provide 'nelisp-primitive-callback-test)
