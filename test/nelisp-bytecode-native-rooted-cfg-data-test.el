(require 'ert)
(require 'nelisp-bytecode-native-rooted-cfg-data)
(require 'nelisp-bytecode-native-rooted-cfg-shared-emit)
(require 'nelisp-bytecode-native-rooted-cfg-contract)

(ert-deftest rooted-cfg-data/interns-equal-subterms-without-changing-tree-bytes ()
  (let* ((tree (list (list 'extern-call 'callee "name" [1 2])
                     (list 'extern-call 'callee (copy-sequence "name") (vector 1 2))))
         (shared (nelisp-bytecode-native-rooted-cfg-data-share tree))
         (print-circle nil))
    (should (equal tree shared))
    (should (eq (car shared) (cadr shared)))
    (should-not (eq (car tree) (car shared)))
    (should (equal (prin1-to-string tree) (prin1-to-string shared)))
    (aset (nth 2 (car tree)) 0 ?x)
    (should (equal (nth 2 (car shared)) "name"))))

(ert-deftest rooted-cfg-data/canonical-print-retains-complete-tree-grammar ()
  (let* ((node (list 'extern-call 'callee 1 2 3 4))
         (tree (list node node))
         (expected (let ((print-circle nil) (print-length nil) (print-level nil))
                     (prin1-to-string tree))))
    (let ((print-circle t) (print-length 1) (print-level 1))
      (should (equal expected (nelisp-bytecode-native-rooted-cfg-data-print tree))))))

(ert-deftest rooted-cfg-data/rejects-cycle-and-visits-shared-ancestor-correctly ()
  (let ((cycle (list 1)) (shared (list 2)))
    (setcdr cycle cycle)
    (should-error (nelisp-bytecode-native-rooted-cfg-data-share cycle))
    (should (equal (nelisp-bytecode-native-rooted-cfg-data-share (list shared shared))
                   '((2) (2))))))

(ert-deftest rooted-cfg-data/grows-interning-context-and-retains-old-identities ()
  "A growing compilation must preserve its already interned containers."
  (let* ((context (nelisp-bytecode-native-rooted-cfg-data-context))
         (initial-size (length (aref context 0)))
         (first (nelisp-bytecode-native-rooted-cfg-data-share '(first [1 2]) context)))
    (dotimes (i (* 2 initial-size))
      (nelisp-bytecode-native-rooted-cfg-data-share (list 'constant (vector i)) context))
    (should (> (length (aref context 0)) initial-size))
    (should (> (length (aref context 1)) initial-size))
    (should (eq first (nelisp-bytecode-native-rooted-cfg-data-share '(first [1 2]) context)))
    (let ((cycle (list 1)))
      (setcdr cycle cycle)
      (should-error (nelisp-bytecode-native-rooted-cfg-data-share cycle context)))))

(ert-deftest rooted-cfg-data/compact-preserves-expression-sharing-and-input ()
  (let* ((expression (list 'extern-call 'callee 'env 'ticket 0 0 0 0))
         (cfg (list 'cfg 1 'start
                    (list 'block 'start nil '(branch env left right))
                    (list 'block 'left (list (list 'setq 'out expression)) '(jump finish))
                    (list 'block 'right (list (list 'setq 'out expression)) '(jump finish))
                    (list 'block 'finish nil '(return out))))
         (before (copy-tree cfg))
         (compact (nelisp-bytecode-native-rooted-cfg-shared-emit--compact cfg)))
    (should (equal cfg before))
    (should (eq (nth 2 (car (nth 2 (nth 4 compact))))
                (nth 2 (car (nth 2 (nth 5 compact))))))
    (should (eq expression (nth 2 (car (nth 2 (nth 4 compact))))))))

(ert-deftest rooted-cfg-data/pair-memoization-does-not-hide-distinct-right-nodes ()
  (let* ((node '(extern-call callee env ticket 0 0 0 0))
         (shared (list node node)) (expanded (copy-tree shared)))
    (should (nelisp-bytecode-native-rooted-cfg-data-equal shared expanded))
    (setcar (cadr expanded) 'forged-call)
    (should-not (nelisp-bytecode-native-rooted-cfg-data-equal shared expanded))
    (should-not (nelisp-bytecode-native-rooted-cfg-data-equal expanded shared))))

(ert-deftest rooted-cfg-data/arena-rewrite-preserves-shared-expressions ()
  (require 'nelisp-standalone-arena-rewrite)
  (let* ((nelisp-standalone--target 'linux-x86_64)
         (node (list 'ptr-read-u64 (+ nelisp-standalone--arena-base 32) 0))
         (source (list node node))
         (before (copy-tree source))
         (rewritten (nelisp-standalone-arena-rewrite-source source))
         (expected '(ptr-read-u64 (+ (ptr-read-u64 (data-addr nl_arena_base) 0) 32) 0)))
    (should (equal source before))
    (should (equal rewritten (list expected expected)))
    (should (eq (car rewritten) (cadr rewritten)))
    (should-not (eq node (car rewritten)))
    (let ((initialization (list 'defun 'nl_arena_init nil nelisp-standalone--arena-base)))
      (should (eq initialization
                  (nelisp-standalone-arena-rewrite-source initialization))))
    (let ((cycle (list 'progn)))
      (setcdr cycle cycle)
      (should-error (nelisp-standalone-arena-rewrite-source cycle)))))

(ert-deftest rooted-cfg-data/loader-rewrite-and-scans-retain-sharing-and-order ()
  (require 'nelisp-native-load)
  (let* ((node (list 'ptr-read-u64 (list 'data-addr 'nl_arena_base) 0))
         (source (list node '(data-addr second) node))
         (before (copy-tree source))
         (rewritten (nelisp-native-load--raw-v2-rewrite-data-addr source)))
    (should (equal source before))
    (should (equal rewritten '((ptr-read-u64 (nl_arena_base) 0) (second)
                               (ptr-read-u64 (nl_arena_base) 0))))
    (should (eq (car rewritten) (nth 2 rewritten)))
    ;; Retain the old reverse-occurrence name order, even with a repeated DAG.
    (should (equal (nelisp-native-load--raw-v2-collect-data-addr-names source)
                   '("nl_arena_base" "second")))
    (should-not (nelisp-native-load--raw-v2-fixed-address-p source))
    (setcar (cddr node) 268435488)
    (should (nelisp-native-load--raw-v2-fixed-address-p source))
    (setcar (cddr node) 0)
    (should-not (nelisp-native-load--raw-v2-fixed-address-p source))))

(defun rooted-cfg-data-test--contracts ()
  "Build cheap, exact U10 audit fixtures, including branches and handlers."
  (require 'json)
  (load (expand-file-name "test/support/native-corpus-u10-fixtures.el") nil t t)
  ;; Read only the authenticated generator's constructor, without executing
  ;; its full oracle, native compilation or projection side effects.
  (let (form)
    (with-temp-buffer
      (insert-file-contents "test/support/generate-native-corpus-u10.el")
      (goto-char (point-min))
      (while (not (and (eq (car-safe form) 'defun) (eq (cadr form) 'u10-mixed-function)))
        (setq form (read (current-buffer)))))
    (fset 'rooted-cfg-data-test--mixed-function (eval (cons 'lambda (cddr form)) t)))
  (let* ((json-object-type 'alist) (json-array-type 'vector)
         (data (json-read-file "test/fixtures/native-bytecode/gnu-31.1-valid-fixtures.json"))
         contracts)
    (dolist (fixture (append (alist-get 'valid data) nil))
      (when (memq (alist-get 'opcode fixture) '(48 49 50 64 65 66 131 132 133 134))
        (let* ((function (rooted-cfg-data-test--mixed-function fixture))
               (input (nelisp-bytecode-compiler-input-build function))
               (pair (nelisp-bytecode-native-rooted-cfg-shared-emit-build-from-input
                      input nelisp-bytecode-native-rooted-cfg-contract-shared-entry nil 'off))
               (contract (nelisp-bytecode-native-rooted-cfg-contract-create-shared-v2
                          input (plist-get pair :plan) (plist-get pair :emitted))))
          (should contract) (push contract contracts))))
    (should (= (length contracts) 10)) contracts))

(ert-deftest rooted-cfg-data/shared-and-expanded-u10-contracts-validate-identically ()
  (dolist (shared (rooted-cfg-data-test--contracts))
    (let* ((expanded (copy-tree shared t))
           (reconstruction (nelisp-bytecode-native-rooted-cfg-contract-valid-p shared :reconstruction)))
      (should reconstruction)
      (should (nelisp-bytecode-native-rooted-cfg-contract-valid-p expanded))
      (let ((expanded-result
             (nelisp-bytecode-native-rooted-cfg-contract-valid-p expanded :reconstruction)))
        (should expanded-result)
        (should (equal (plist-get reconstruction :expected-contract)
                       (plist-get expanded-result :expected-contract))))
      (should (equal shared (plist-get reconstruction :expected-contract)))
      (should (equal (nelisp-bytecode-native-rooted-cfg-contract--digest shared)
                     (nelisp-bytecode-native-rooted-cfg-contract--digest expanded)))
      (let ((print-circle t))
        (should (equal (nelisp-bytecode-native-rooted-cfg-contract--digest shared)
                       (plist-get shared :digest))))
      (plist-put expanded :root-count 999)
      (plist-put expanded :digest (nelisp-bytecode-native-rooted-cfg-contract--digest expanded))
      (should-not (nelisp-bytecode-native-rooted-cfg-contract-valid-p expanded)))))

(ert-deftest rooted-cfg-data/corruption-in-shared-subterm-is-refused-after-redigest ()
  (let* ((contract (car (rooted-cfg-data-test--contracts)))
         (counts (make-hash-table :test 'eq))
         (recipe-before (prin1-to-string (plist-get contract :input-recipe)))
         (pending (list (plist-get contract :entry-ast))) shared-node)
    ;; Count occurrences, rather than unique identities, to find a node used
    ;; by more than one AST path.  Leave the recipe and outer schema intact.
    (while pending
      (let ((node (pop pending)))
        (when (consp node)
          (puthash node (1+ (gethash node counts 0)) counts)
          (when (and (> (gethash node counts) 1) (integerp (car node)))
            (setq shared-node node))
          (push (car node) pending) (push (cdr node) pending))))
    (should shared-node)
    (should (nelisp-bytecode-native-rooted-cfg-contract-valid-p contract))
    (setcar shared-node 'forged-call)
    (should (equal recipe-before (prin1-to-string (plist-get contract :input-recipe))))
    (plist-put contract :digest (nelisp-bytecode-native-rooted-cfg-contract--digest contract))
    (should-not (nelisp-bytecode-native-rooted-cfg-contract-valid-p contract))
    (should-not (nelisp-bytecode-native-rooted-cfg-contract-valid-p contract :reconstruction))))

(ert-deftest rooted-cfg-data/replaced-comparator-cannot-authorize-contract ()
  (let ((contract (car (rooted-cfg-data-test--contracts))))
    (cl-letf (((symbol-function 'nelisp-bytecode-native-rooted-cfg-data-equal)
               (lambda (&rest _) t)))
      (should-not (nelisp-bytecode-native-rooted-cfg-contract-valid-p contract)))))

(defconst rooted-cfg-data-test--file
  (expand-file-name (or load-file-name buffer-file-name))
  "This file, reloaded by the child Emacs that runs the printer check.")

(defun rooted-cfg-data-test--printing-memo-check ()
  "Signal unless the standalone printer memo keeps bytes and expires on mutation.
Run only in a child Emacs: loading the standalone printer replaces host
printer helpers for every later test in the same process."
  (let ((printer (symbol-function 'prin1-to-string))
        (native-comp-enable-subr-trampolines nil))
    (cl-letf (((symbol-function 'prin1-to-string) printer)
              ((symbol-function 'prin1) (symbol-function 'prin1))
              ((symbol-function 'terpri) (symbol-function 'terpri)))
      (load (expand-file-name "lisp/nelisp-stdlib-prn.el") nil t t)
      (let* ((string (copy-sequence "line\n\"quoted\""))
             (node (list 'extern-call 'callee string 'env 'ticket 0 0 0 0))
             (tree (list node node (vector 'foo 7 1.25) '(quote foo)))
             (print-length nil) (print-level nil) (print-circle nil)
             (print-quoted t) (print-escape-newlines t)
             (before (funcall printer tree)))
        (cl-assert (equal before (let ((nelisp--prn-call-cache (make-vector 4096 nil)))
                                   (nelisp--prn-to-string tree t))))
        (cl-assert (equal before (nelisp-bytecode-native-rooted-cfg-data-print tree)))
        (aset string 0 ?x)
        (let ((after (let ((nelisp--prn-call-cache (make-vector 4096 nil)))
                       (nelisp--prn-to-string tree t))))
          (cl-assert (not (equal before after)))
          (cl-assert (equal after (nelisp-bytecode-native-rooted-cfg-data-print tree)))
          (cl-assert (equal (funcall printer tree) after)))))))

(ert-deftest rooted-cfg-data/printing-memo-retains-bytes-and-does-not-survive-mutation ()
  (let* ((test-file rooted-cfg-data-test--file)
         (args (append '("--batch" "-Q")
                       (mapcan (lambda (dir) (list "-L" dir)) load-path)
                       (list "-l" "cl-lib" "-l" test-file
                             "--eval" "(rooted-cfg-data-test--printing-memo-check)")))
         (status (with-temp-buffer
                   (let ((rc (apply #'call-process
                                    (expand-file-name invocation-name invocation-directory)
                                    nil t nil args)))
                     (unless (eql rc 0) (message "%s" (buffer-string)))
                     rc))))
    (should (eql status 0))))

(ert-deftest rooted-cfg-data/sharing-does-not-coalesce-distinct-string-properties ()
  (let* ((left (propertize "name" 'face 'bold))
         (right (propertize "name" 'face 'italic))
         (shared (nelisp-bytecode-native-rooted-cfg-data-share (list left right))))
    (should-not (eq (car shared) (cadr shared)))
    (should (equal-including-properties left (car shared)))
    (should (equal-including-properties right (cadr shared)))))

(provide 'nelisp-bytecode-native-rooted-cfg-data-test)
