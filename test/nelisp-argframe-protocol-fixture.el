;;; nelisp-argframe-protocol-fixture.el --- Actual native transport protocol -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'nelisp-standalone-build)

(defun nelisp-argframe-protocol--definition (name pools)
  "Return the exact production definition NAME from POOLS."
  (or (cl-find-if (lambda (form) (and (eq (car-safe form) 'defun)
                                    (eq (cadr form) name))) pools)
      (error "Missing production definition %S" name)))

(let* ((output (or (getenv "ARGFRAME_FIXTURE_OUTPUT")
                   (expand-file-name "../target/argframe/native-protocol"
                                     (file-name-directory load-file-name))))
       (legacy (equal (getenv "ARGFRAME_FIXTURE_VARIANT") "legacy"))
       (s #x3a000000) (env (+ s 512)) (fw (+ s 768))
       (state (+ s 1024)) (frame (+ state 64)) (argv (+ s 8192))
       (boxes (+ s 16384)) (sid (nelisp-standalone--sid "make-hash-table"))
       (pools (append (nelisp-standalone--eval-call-defuns)
                      nelisp-standalone--combiner-cons-word
                      nelisp-standalone--applyfn-m5-helpers
                      (cdr nelisp-standalone--n4-source)
                      (cdr nelisp-standalone--arena-source)
                      (cdr nelisp-cc-evalport-combiner-arglist--source)))
       (production (copy-tree (nelisp-argframe-protocol--definition
                               'nl_eic_builtin_call_w pools)))
       (calls nil) (count 0) (check-count 0))
  (when legacy
    ;; Reproduce the old generic transport in the same native fixture.
    (setq production
          '(defun nl_eic_builtin_call_w (d nm tail env fw call_name)
             (let* ((p (nl_eic_primitive_w d nm tail env fw call_name)))
               (if (= p 2)
                   (let ((mark (nl_root_mark env)))
                     (seq (ptr-write-u64 fw 0 d)
                          (nl_cons_root_finish env mark
                            (nl_eic_after_args_w (nl_eval_arg_list_w tail env 0)
                                                 env fw call_name)))) p)))))
  (cl-labels
      ((check (form)
         (cl-incf check-count)
         `(if ,form 0 (seq (setq failed (+ failed 1))
                           (ptr-write-u64 ,s 104 ,count))))
       (case-forms (argc mode &optional unknown)
         (cl-incf count)
         (let* ((frame-path (and (not unknown) (<= argc 255) (/= mode 6)))
                (evaluates (/= mode 6))
                (allocations (if (or (not frame-path) (memq mode '(1 2 3 4)))
                                 (if evaluates argc 0) 0))
                (result (cond ((memq mode '(1 3 5 6)) 0)
                              ((= mode 2) 21) (t 3))))
           `(seq
             (let ((i 0))
               (while (< i 112) (seq (ptr-write-u64 ,s i 0) (setq i (+ i 8)))))
             (ptr-write-u64 ,s 48 ,mode)
             (ptr-write-u64 ,s 72 ,argc)
             (ptr-write-u64 ,env 176 ,state)
             (ptr-write-u64 ,state 0 1)
             (ptr-write-u64 ,frame 8 3)
             (ptr-write-u64 ,frame 16 ,(if (memq mode '(2 3)) 65536 0))
             (ptr-write-u64 ,frame 24 0)
             (ptr-write-u64 ,(+ s 256) 0 8)
             (ptr-write-u64 ,(+ s 256) 8 ,(+ s 320))
             (ptr-write-u64 ,(+ s 320) 0 8)
             (let ((r (nl_eic_builtin_call_w 5 ,(if unknown 0 sid) ,argc ,env ,fw 0)))
               (seq
                ,(check `(= r ,result))
                ,(check `(= (ptr-read-u64 ,s 0) ,allocations))
                ,(check `(= (ptr-read-u64 ,s 8) ,(if evaluates 1 0)))
                ,(check `(= (ptr-read-u64 ,s 24) ,(if (and frame-path (/= mode 5)) 1 0)))
                ,(check `(= (ptr-read-u64 ,s 40) ,(if (memq mode '(2 3)) 1 0)))
                ,(check `(= (ptr-read-u64 ,frame 24) 0))
                ,(check `(= (ptr-read-u64 ,s 56) 0))
                ,(check `(= (ptr-read-u64 ,s 64) ,(if (memq mode '(1 3)) 987 0)))
                ,(check `(= (ptr-read-u64 ,s 88) 0))))))))
    (dolist (n '(0 1 2 8 9 255 256)) (push (case-forms n 0) calls))
    (dolist (mode '(1 2 3 4 5 6 7)) (push (case-forms 2 mode) calls))
    (push (case-forms 2 0 t) calls))
  (let* ((helpers '(nl_eic_argframe_call_w m5_fx_slot_list m5_fx_word_list m5_fx_frame_lazy
                   nl_eval_arg_list_w nl_n4_record nl_n4_materialize nl_word_canon
                   nl_n4_store_args nl_eic_exit_debug_now))
         (source
          `(seq
            ,production
            ,@(mapcar (lambda (name) (nelisp-argframe-protocol--definition name pools)) helpers)
            ;; Fixture addresses are raw mmap storage, never String objects.
            (defun nl_string_read64 (ptr offset) (ptr-read-u64 ptr offset))
            (defun nl_string_read8 (ptr offset) (ptr-read-u8 ptr offset))
            (defun nl_sym_sid (word) word)
            (defun nl_sp_nargs (tail) tail)
            (defun nl_eic_primitive_w (d nm tail env fw call_name)
              (if (= (ptr-read-u64 ,s 48) 6) 0 2))
            (defun nl_root_mark (env) 0)
            (defun nl_root_frame (env n)
              (seq (ptr-write-u64 ,s 88 1) ,argv))
            (defun nl_root_release (env mark)
              (seq (ptr-write-u64 ,s 16 (+ (ptr-read-u64 ,s 16) 1))
                   (ptr-write-u64 ,s 88 0) 0))
            (defun nl_cons_root_finish (env mark word)
              (seq (nl_root_release env mark) word))
            (defun wf_bytecode_root_exhausted () 0)
            (defun m5_fx_arg_count (tail _pad) tail)
            (defun m5_fx_slot_word (slot _pad) (heap-read-u64 slot 0))
            (defun nl_symview_canon (word) word)
            (defun nl_n4_list_word (word) word)
            (defun m5_fx_eval_forms (tail env base n)
              (let ((i 0))
                (seq (ptr-write-u64 ,s 8 (+ (ptr-read-u64 ,s 8) 1))
                     (while (< i n)
                       (seq (ptr-write-u64 base (* i 8) (+ (* i 4) 1))
                            (setq i (+ i 1))))
                     (if (= (ptr-read-u64 ,s 48) 7)
                         (ptr-write-u64 base 0 ,(+ s 256)) 0)
                     (if (= (ptr-read-u64 ,s 48) 5) 1 0))))
            (defun nl_alloc_consbox ()
              (let ((n (ptr-read-u64 ,s 0)))
                (seq (ptr-write-u64 ,s 0 (+ n 1)) (+ ,boxes (* n 16)))))
            (defun nl_apply_builtin_frame_w (fn base env argc)
              (seq (ptr-write-u64 ,s 24 (+ (ptr-read-u64 ,s 24) 1))
                   (if (= (ptr-read-u64 ,s 48) 7)
                       (if (= (ptr-read-u64 base 0) ,(+ s 326)) 0
                         (ptr-write-u64 ,s 56 7)) 0)
                   (if (= (ptr-read-u64 ,s 48) 4) 2
                     (if (= (ptr-read-u64 ,s 48) 1)
                         (seq (ptr-write-u64 ,s 64 987) 0) 3))))
            (defun nl_eic_after_args_w (args env fw name)
              (seq (ptr-write-u64 ,s 32 (+ (ptr-read-u64 ,s 32) 1))
                   (ptr-write-u64 ,frame 8 args)
                   (ptr-write-u64 ,frame 24 0)
                   (if (= (ptr-read-u64 ,s 48) 5) 0 3)))
            (defun nl_n4_exit_debug_w (word env)
              (seq
               (ptr-write-u64 ,s 40 (+ (ptr-read-u64 ,s 40) 1))
               ;; Callback models GC/backtrace traversal while roots are live.
               (if (= (ptr-read-u64 ,s 88) 1) 0 (ptr-write-u64 ,s 56 1))
               (if (= (ptr-read-u64 ,argv (* (ptr-read-u64 ,s 72) 8)) word)
                   0 (ptr-write-u64 ,s 56 2))
               (nl_n4_materialize ,frame)
               (if (= (ptr-read-u8 ,frame 16) 1) 0 (ptr-write-u64 ,s 56 3))
               (if (= (ptr-read-u64 ,s 48) 3)
                   (seq (ptr-write-u64 ,s 64 987) 0) 21)))
            (defun _start ()
              (let ((failed 0))
                (seq (syscall-direct 9 ,s 1048576 3 50 -1 0)
                     ,@(mapcar (lambda (call)
                                 `(seq ,call (ptr-write-u64 ,s 112 failed)
                                       (syscall-direct 1 1 ,s 120 0 0 0)))
                               (nreverse calls))
                     (ptr-write-u64 ,s 112 failed)
                     (syscall-direct 1 1 ,s 120 0 0 0)
                     (syscall-direct 60 failed 0 0 0 0 0)))))))
    (make-directory (file-name-directory output) t)
    (nelisp-link-units output
                       (list (nelisp-standalone--compile-to-unit "argframe-protocol.o" source))
                       "_start")
    (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
    (princ (format "ARGFRAME-PROTOCOL-COMPILED cases=%d checks=%d legacy=%S\n"
                   count check-count legacy))))
