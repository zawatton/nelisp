;;; -*- lexical-binding: t; -*-
(require 'nelisp-aot-address-fold-test)
(ert-deftest nelisp-address-preference/legacy-safe-and-dependencies ()
 (let ((nelisp-aot-compiler--x86-affine-addresses t)
       (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
       (nelisp-aot-compiler--os 'linux) (nelisp-aot-compiler--checked-arith nil))
  (dolist (row '((nil "mov rdi,QWORD PTR [rbp-8]\nmov rsi,QWORD PTR [rbp-16]\nmov rax,QWORD PTR [rdi+rsi*8+20]")
                 (((0 . rdi) (1 . rsi)) "mov rax,QWORD PTR [rdi+rsi*8+20]")
                 (((1 . rdi)) "mov rsi,QWORD PTR [rbp-8]\nmov rax,QWORD PTR [rsi+rdi*8+20]")
                 (((0 . rsi)) "mov rdi,QWORD PTR [rbp-16]\nmov rax,QWORD PTR [rsi+rdi*8+20]")))
   (let* ((nelisp-aot-compiler--promoted-slots (car row))
          (offset (nelisp-address-test--arith '+ (nelisp-address-test--arith '*
                            (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))
                            (nelisp-address-test--imm 20)))
          (buf (nelisp-asm-x86_64-make-buffer))
          (mem (nelisp-aot-compiler--x86-address (nelisp-address-test--ref 0) offset buf)))
    (should mem)
    (nelisp-aot-compiler--x86-load-mem buf 64 'rax mem)
    (should (equal (nelisp-asm-x86_64-buffer-bytes buf) (nelisp-address-test--as (cadr row))))))
  (let* ((nelisp-aot-compiler--promoted-slots '((1 . rcx) (2 . rdi)))
         (buf (nelisp-asm-x86_64-make-buffer))
         (node (nelisp-aot-compiler--make-ir 'ptr-write-u64 :ptr (nelisp-address-test--ref 0)
                 :offset (nelisp-address-test--arith '* (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))
                 :val (nelisp-address-test--ref 2))))
   (should (nelisp-aot-compiler--emit-ptr-write-x86 node buf))
   (should (equal (nelisp-asm-x86_64-buffer-bytes buf)
                  (nelisp-address-test--as "mov rsi,QWORD PTR [rbp-8]\nmov QWORD PTR [rsi+rcx*8],rdi"))))))
(ert-deftest nelisp-address-preference/pressure-and-disabled-are-preflight ()
 (let* ((nelisp-aot-compiler--x86-affine-addresses nil)
        (nelisp-aot-compiler--promoted-slots '((0 . rsi)))
        (buf (nelisp-asm-x86_64-make-buffer))
        (offset (nelisp-address-test--arith '* (nelisp-address-test--ref 1) (nelisp-address-test--imm 8))))
  (should-not (nelisp-aot-compiler--x86-address (nelisp-address-test--ref 0) offset buf))
  (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))))
