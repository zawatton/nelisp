;;; nelisp-bytecode-core-threaded-test.el --- Threaded (replicated) dispatch -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
;; vmcore W1d: an allow-listed dispatch `while' whose body is (FETCH TABLE-IF) is emitted with a
;; copy of the exit test, the byte fetch and the table jump at the end of every arm.
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defconst nelisp-threaded-test--source
  '(seq
    (defun toy_run (data length)
      (let* ((pc 0) (raw 0) (go length) (acc 0))
        (while (< pc go)
          (setq raw (ptr-read-u8 data pc))
          (if (< raw 4)
              (seq (setq acc (+ acc raw)) (setq pc (+ pc 1)))
            (if (< raw 8)
                (seq (setq acc (+ acc 100)) (setq pc (+ pc 1)))
              (if (< raw 12)
                  (seq (setq acc (+ acc 1000)) (setq pc (+ pc 1)))
                (if (< raw 16)
                    (if (> acc 1000000) (setq go 0)
                      (seq (setq acc (+ acc 7)) (setq pc (+ pc 1))))
                  (if (< raw 20)
                      (seq (setq acc (+ acc 10000)) (setq pc (+ pc 1)))
                    (if (< raw 24)
                        (seq (setq acc (+ acc 3)) (setq pc (+ pc 1)))
                      (if (< raw 28)
                          (seq (setq acc (- acc 1)) (setq pc (+ pc 1)))
                        (if (< raw 32)
                            (seq (setq acc (+ acc 2)) (setq pc (+ pc 1)))
                          (if (> raw 100) (setq go 0)
                            (seq (setq acc (+ acc 5)) (setq pc (+ pc 1)))))))))))))
        (+ (* acc 1024) pc)))
    (defun main ()
      (let* ((data (syscall-direct 9 0 4096 3 34 -1 0)) (i 0) (n SEED-N))
        (while (< i 300) (ptr-write-u8 data i (logand (+ (* i SEED-A) SEED-B) 255)) (setq i (+ i 1)))
        (logand (toy_run data n) 255)))
    (exit (main))))
(defun nelisp-threaded-test--expected (n a b)
  (let ((data (cl-loop for i below 300 collect (logand (+ (* i a) b) 255)))
        (pc 0) (go n) (acc 0))
    (while (< pc go)
      (let ((raw (nth pc data)))
        (cond ((< raw 4) (cl-incf acc raw) (cl-incf pc))
              ((< raw 8) (cl-incf acc 100) (cl-incf pc))
              ((< raw 12) (cl-incf acc 1000) (cl-incf pc))
              ((< raw 16) (if (> acc 1000000) (setq go 0) (cl-incf acc 7) (cl-incf pc)))
              ((< raw 20) (cl-incf acc 10000) (cl-incf pc))
              ((< raw 24) (cl-incf acc 3) (cl-incf pc))
              ((< raw 28) (cl-decf acc 1) (cl-incf pc))
              ((< raw 32) (cl-incf acc 2) (cl-incf pc))
              ((> raw 100) (setq go 0))
              (t (cl-incf acc 5) (cl-incf pc)))))
    (logand (+ (* acc 1024) pc) 255)))
(defun nelisp-threaded-test--build (n a b path &optional threaded names)
  (let ((nelisp-aot-compiler-threaded-dispatch threaded)
        (nelisp-aot-compiler-threaded-dispatch-functions names)
        (nelisp-aot-compiler-vm-register-functions '((toy_run pc raw data go acc)))
        (nelisp-aot-compiler--emit-message-p nil)
        (source (let ((s (prin1-to-string nelisp-threaded-test--source)))
                  (dolist (r `(("SEED-N" . ,n) ("SEED-A" . ,a) ("SEED-B" . ,b)))
                    (setq s (replace-regexp-in-string (car r) (number-to-string (cdr r)) s t t)))
                  (car (read-from-string s)))))
    (cl-letf (((symbol-function 'message) #'ignore))
      (nelisp-aot-compile-sexp source path))
    (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally path) (buffer-string))))
(defun nelisp-threaded-test--count (bytes pattern)
  (let ((n 0) (i 0))
    (while (setq i (string-search pattern bytes i)) (cl-incf n) (cl-incf i))
    n))
(ert-deftest nelisp-bytecode-core-threaded/results-and-shape ()
  (let ((dir (make-temp-file "nelisp-threaded-" t)) (indirect (unibyte-string #xFF #xE0)))
    (unwind-protect
        (progn
          (dolist (case '((300 7 3) (300 13 1) (150 5 9) (300 1 0) (299 33 17) (300 3 250) (200 11 4)))
            (let* ((expected (apply #'nelisp-threaded-test--expected case))
                   (off (nelisp-threaded-test--build (nth 0 case) (nth 1 case) (nth 2 case)
                                                     (expand-file-name "off" dir) nil))
                   (on (nelisp-threaded-test--build (nth 0 case) (nth 1 case) (nth 2 case)
                                                    (expand-file-name "on" dir) t '(toy_run)))
                   (other (nelisp-threaded-test--build (nth 0 case) (nth 1 case) (nth 2 case)
                                                       (expand-file-name "other" dir) t '(not_toy))))
              (should (= expected (call-process (expand-file-name "off" dir) nil nil nil)))
              (should (= expected (call-process (expand-file-name "on" dir) nil nil nil)))
              ;; Negative control: a defun outside the allow list is emitted exactly as before.
              (should (equal off other))
              ;; The switch changes the code: one table jump per arm instead of one shared jump.
              (should (> (nelisp-threaded-test--count on indirect)
                         (+ 6 (nelisp-threaded-test--count off indirect))))
              (should-not (equal on off))))
          ;; A malformed loop (extra body form) is left alone.
          (let ((nelisp-aot-compiler-threaded-dispatch t)
                (nelisp-aot-compiler-threaded-dispatch-functions '(toy_run)))
            (should-not (nelisp-aot-compiler--threaded-loop-plan
                         (nelisp-aot-compiler--make-ir 'while :id 'w :test nil :body '(a b c))))))
      (delete-directory dir t))))
(provide 'nelisp-bytecode-core-threaded-test)
