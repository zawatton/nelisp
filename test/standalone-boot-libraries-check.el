;;; standalone-boot-libraries-check.el --- Clean boot and deferred providers -*- lexical-binding: t; -*-
;; Run in a fresh process, before any test harness preloads optional libraries.
(let ((failures 0))
  (dolist (feature '(backquote macroexp))
    (unless (featurep feature)
      (setq failures (1+ failures))
      (princ (format "BOOT-LIBRARIES missing preload %S\n" feature))))
  (dolist (feature '(byte-run inline json easy-mmode rx cl-seq nelisp-process-buffer))
    (when (featurep feature)
      (setq failures (1+ failures))
      (princ (format "BOOT-LIBRARIES eager feature %S\n" feature))))
  ;; GNU's JSON primitive is available without loading the json library.
  (unless (equal (json-parse-string "{\"a\":1}" :object-type 'alist) '((a . 1)))
    (setq failures (1+ failures)))
  (when (featurep 'json) (setq failures (1+ failures)))
  ;; rx's guarded fallbacks require explicit demand. The unconditional inline
  ;; entry point below still exercises autoload publication.
  (unless (eq (require 'rx) 'rx) (setq failures (1+ failures)))
  (unless (equal (eval '(rx "a")) "a") (setq failures (1+ failures)))
  (require 'json)
  (unless (equal (json-read-from-string "{\"a\":1}") '((a . 1)))
    (setq failures (1+ failures)))
  (require 'cl-lib)
  (unless (equal (cl-remove 2 '(1 2 3 2) :count 1) '(1 3 2))
    (setq failures (1+ failures)))
  (eval '(define-inline boot-libraries--increment (x) (inline-quote (1+ ,x))))
  (unless (= (boot-libraries--increment 4) 5) (setq failures (1+ failures)))
  (eval '(define-minor-mode boot-libraries--mode "Boot library test." :global t))
  (unless (fboundp 'boot-libraries--mode) (setq failures (1+ failures)))
  ;; Conditional process aliases are intentionally absent until explicit demand.
  (require 'nelisp-process-buffer nil t)
  (let ((process (make-pipe-process :name "boot-libraries" :noquery t)))
    (unless (processp process) (setq failures (1+ failures)))
    (delete-process process))
  (dolist (feature '(inline json easy-mmode rx cl-seq))
    (unless (featurep feature)
      (setq failures (1+ failures))
      (princ (format "BOOT-LIBRARIES missing demanded feature %S\n" feature))))
  (princ (format "BOOT-LIBRARIES checks=23 failures=%d %s\n"
                 failures (if (= failures 0) "PASS" "FAIL")))
  (kill-emacs (if (= failures 0) 0 1)))
