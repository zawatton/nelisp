;;; nelisp-nc2-corpus.el --- transcript over the N2 hot set (direct calls)  -*- lexical-binding: t; -*-
;; nativecomp N2.  Public entry points of the text-property, line/column and
;; string families whose call trees run natively compiled closures calling one
;; another directly (nc_d_ID) and native subrs through `nl_directcall_invoke'.
;; tools/ai/nc2-check.sh runs it with the VM off (interpreter), with every
;; converted record back on the word VM (NC_MODE=vm), as built (native) and
;; through the fxir evaluator (NC_FXIR=1, on any binary), and compares the
;; transcripts.  NC_GC=1 collects garbage between cases and inside the loops.
;; Runs on GNU Emacs too (the NeLisp-only parts are guarded).
(defvar nc2-cases nil)
(defmacro nc2 (label &rest body)
  `(push (cons ,label (lambda () ,@body)) nc2-cases))
(defun nc2-gc () (when (getenv "NC_GC") (garbage-collect)))
(defmacro nc2-buf (text &rest body)
  `(with-temp-buffer (insert ,text) (goto-char (point-min)) ,@body))
(defun nc2-props (s)
  "S's text and intervals as a plain list (printer-independent)."
  (let ((i 0) (out nil) (n (length s)))
    (while (< i n)
      (let ((next (or (next-property-change i s) n)))
        (push (list i next (text-properties-at i s)) out)
        (setq i next)))
    (list (substring-no-properties s) (nreverse out))))

;; --- text properties on strings
(nc2 "ptp-basic" (let ((s (copy-sequence "abcdefghij")))
                   (list (put-text-property 0 5 'face 'bold s) (nc2-props s)
                         (put-text-property 3 8 'face 'italic s) (nc2-props s)
                         (put-text-property 2 4 'x 1 s) (nc2-props s))))
(nc2 "ptp-same-value" (let ((s (copy-sequence "abcdef")))
                        (put-text-property 0 6 'face 'bold s)
                        (list (put-text-property 1 3 'face 'bold s) (nc2-props s))))
(nc2 "ptp-empty-reversed" (let ((s (copy-sequence "abcdef")))
                            (list (put-text-property 3 3 'a 1 s) (put-text-property 5 2 'a 2 s) (nc2-props s))))
(nc2 "ptp-errors" (let ((s (copy-sequence "abc")))
                    (list (condition-case e (put-text-property 0 9 'a 1 s) (error e))
                          (condition-case e (put-text-property -1 2 'a 1 s) (error e))
                          (condition-case e (put-text-property 'x 2 'a 1 s) (error e))
                          (nc2-props s))))
(nc2 "propertize" (list (nc2-props (propertize "hello" 'face 'bold 'help-echo "x"))
                        (nc2-props (propertize "" 'a 1))
                        (condition-case e (propertize "x" 'a) (error e))
                        (condition-case e (propertize 5 'a 1) (error e))
                        (nc2-props (concat (propertize "ab" 'p 1) "cd" (propertize "ef" 'p 2)))))
(nc2 "add-tp" (let ((s (copy-sequence "abcdefgh")))
                (list (add-text-properties 1 6 '(a 1 b 2) s) (nc2-props s)
                      (add-text-properties 1 6 '(a 1 b 2) s)
                      (add-text-properties 4 8 '(b 3) s) (nc2-props s)
                      (condition-case e (add-text-properties 0 2 '(a) s) (error e)))))
(nc2 "get-tp" (let ((s (propertize "abcdef" 'face 'bold)))
                (put-text-property 2 4 'k 'v s)
                (list (get-text-property 0 'face s) (get-text-property 3 'k s) (get-text-property 5 'k s)
                      (text-properties-at 2 s) (text-properties-at 6 s)
                      (condition-case e (get-text-property 9 'face s) (error e))
                      (next-single-property-change 0 'k s) (next-single-property-change 2 'k s)
                      (previous-single-property-change 6 'k s) (next-property-change 0 s)
                      (text-property-any 0 6 'k 'v s) (text-property-not-all 0 6 'face 'bold s))))
(nc2 "set-remove-tp" (let ((s (copy-sequence "abcdefgh")))
                       (put-text-property 0 8 'a 1 s) (put-text-property 2 6 'b 2 s)
                       (list (remove-text-properties 1 3 '(a nil) s) (nc2-props s)
                             (remove-list-of-text-properties 0 8 '(b) s) (nc2-props s)
                             (set-text-properties 2 5 '(c 3) s) (nc2-props s)
                             (set-text-properties 0 8 nil s) (nc2-props s))))
(nc2 "tp-buffer" (nc2-buf "abcdefghij"
                   (put-text-property 2 6 'face 'bold)
                   (add-text-properties 4 9 '(k 1))
                   (list (get-text-property 3 'face) (get-text-property 5 'k) (text-properties-at 5)
                         (next-single-property-change 1 'face) (next-single-char-property-change 1 'k)
                         (progn (remove-text-properties 2 4 '(face nil)) (get-text-property 3 'face))
                         (nc2-props (buffer-string)))))
(nc2 "tp-loop-gc" (let ((s (make-string 40 ?x)) (acc nil) (i 0))
                    (while (< i 60)
                      (put-text-property (% (* i 7) 30) (+ 5 (% (* i 7) 30)) 'face (if (= (% i 2) 0) 'bold 'italic) s)
                      (when (= (% i 20) 0) (nc2-gc) (push (length (cadr (nc2-props s))) acc))
                      (setq i (1+ i)))
                    (list (nreverse acc) (nc2-props s))))

;; The route `text-properties-at' takes on a buffer: its fast path (no full
;; validation) while point-min < point-max; the negative-control mutant
;; (`<' lowered as `>') takes the full validation, with the same answer.
(nc2 "tp-at-route" (nc2-buf "abcdef" (put-text-property 2 5 'face 'bold)
                     (let ((calls 0) r)
                       (unwind-protect
                           (progn (advice-add 'nelisp--tp-validate :before (lambda (&rest _) (setq calls (1+ calls))) '((name . nc2-tpv)))
                                  (setq r (list (text-properties-at 3) (text-properties-at 5) (get-text-property 4 'face))))
                         (advice-remove 'nelisp--tp-validate 'nc2-tpv))
                       (list r calls))))

;; --- lines and columns
(nc2 "columns" (nc2-buf "ab\tcd\nefgh\n\nxyz"
                 (list (current-column) (progn (goto-char 4) (current-column)) (progn (end-of-line) (current-column))
                       (progn (forward-line 1) (move-to-column 2)) (point) (move-to-column 99) (point)
                       (progn (goto-char 1) (move-to-column 3)) (point) (move-to-column 1 t) (point))))
(nc2 "bol-eol" (nc2-buf "one\ntwo\nthree"
                 (list (progn (goto-char 6) (beginning-of-line) (point)) (progn (end-of-line) (point))
                       (progn (beginning-of-line 2) (point)) (progn (end-of-line 0) (point))
                       (progn (goto-char 1) (end-of-line 3) (point)) (line-number-at-pos) (line-number-at-pos 5))))
(nc2 "chars" (nc2-buf "hello world"
               (list (progn (forward-char 3) (point)) (progn (backward-char 2) (point))
                     (condition-case e (forward-char 99) (error (car e))) (point)
                     (condition-case e (backward-char 99) (error (car e))) (point)
                     (progn (goto-char 1) (skip-chars-forward "a-z")) (point) (skip-chars-forward " ") (point)
                     (progn (goto-char (point-max)) (skip-chars-backward "a-z")) (point)
                     (skip-chars-backward "^h") (point))))

;; --- strings
(nc2 "split" (list (split-string "a b c d e" " ") (split-string "  two words ") (split-string "a,b,,c" ",")
                   (split-string "a,b,,c" "," t) (split-string " a , b " "," t " ") (split-string "" ",")
                   (split-string "abc" "") (split-string "a\nb\n" "\n") (split-string "x--y--" "--")
                   (split-string "aXbXc" "X" nil "a")))
(nc2 "split-loop-gc" (let ((acc nil) (i 0))
                       (while (< i 50)
                         (push (split-string (format "w%d v%d u%d" i (* 2 i) (* 3 i)) " ") acc)
                         (when (= (% i 10) 0) (nc2-gc))
                         (setq i (1+ i)))
                       (list (length acc) (car acc) (nth 49 acc))))
(nc2 "trim" (list (string-trim "  ab  ") (string-trim-left "\t x ") (string-trim-right " x \n")
                  (string-trim "xxabxx" "x+" "x+") (string-trim "") (string-trim "   ")
                  (condition-case e (string-trim 5) (error (car e)))))
(nc2 "mapconcat" (list (mapconcat #'identity '("a" "b" "c") "-") (mapconcat #'upcase ["x" "y"] ", ")
                       (mapconcat (lambda (c) (string c c)) "abc" "") (mapconcat #'symbol-name '(p q) "")
                       (mapconcat #'identity nil "-") (mapconcat #'identity '("solo"))
                       (condition-case e (mapconcat #'identity 5 "-") (error (car e)))))
(nc2 "join-etc" (list (string-join '("a" "b") "/") (string-join nil) (string-search "lo" "hello") (string-search "z" "hello")
                      (string-search "l" "hello" 3) (string-replace "l" "L" "hello") (string-prefix-p "he" "hello")
                      (string-suffix-p "lo" "hello") (string-remove-prefix "he" "hello") (string-remove-suffix "lo" "hello")
                      (string-empty-p "") (string-blank-p " \t") (string-to-list "abc") (string-pad "ab" 5)
                      (string-pad "ab" 5 ?. t) (string-lines "a\nb\n") (substring-no-properties (propertize "abc" 'a 1) 1)
                      (string-width "abc") (condition-case e (string-search 5 "x") (error (car e)))))
(nc2 "seq-helpers" (list (nreverse (list 1 2 3)) (reverse [1 2 3]) (reverse "abc") (copy-sequence [1 2]) (copy-sequence "xy")
                         (copy-sequence nil) (condition-case e (copy-sequence 5) (error (car e)))
                         (condition-case e (nreverse 'x) (error (car e)))))

;; --- direct calls under redefinition: `string-trim' calls `string-trim-left'
;; and `string-trim-right' directly, `nelisp--split-string-literal' calls the
;; directcall subr `substring'; each redefinition is undone before printing.
(nc2 "redef-direct-fset" (let ((old (symbol-function 'string-trim-left)) r)
                           (unwind-protect
                               (progn (fset 'string-trim-left (lambda (s &optional _r) (concat "<" s)))
                                      (setq r (list (string-trim " a ") (string-trim " b "))))
                             (fset 'string-trim-left old))
                           (list r (string-trim " c "))))
(nc2 "redef-direct-advice" (let (r)
                             (unwind-protect
                                 (progn (advice-add 'string-trim-right :filter-return (lambda (s) (concat s "!")) '((name . nc2-adv)))
                                        (setq r (list (string-trim " a ") (string-trim " b "))))
                               (advice-remove 'string-trim-right 'nc2-adv))
                             (list r (string-trim " c "))))
(nc2 "redef-subr-advice" (let (r)
                           (unwind-protect
                               (progn (advice-add 'substring :filter-return (lambda (s) (list 'adv s)) '((name . nc2-sub)))
                                      (setq r (split-string "a b" " ")))
                             (advice-remove 'substring 'nc2-sub))
                           (list r (split-string "c d" " "))))
(nc2 "redef-subr-fset" (let ((old (symbol-function 'substring)) r)
                         (unwind-protect
                             (progn (fset 'substring (lambda (s &optional _a _b) (list 'fs s)))
                                    (setq r (split-string "a b" " ")))
                           (fset 'substring old))
                         (list r (split-string "c d" " "))))
(nc2 "redef-in-loop" (let ((old (symbol-function 'string-trim-left)) (acc nil) (i 0))
                       (unwind-protect
                           (while (< i 6)
                             (if (= (% i 2) 0) (fset 'string-trim-left (lambda (s &optional _r) (concat "#" s)))
                               (fset 'string-trim-left old))
                             (push (string-trim " z ") acc)
                             (setq i (1+ i)))
                         (fset 'string-trim-left old))
                       (nreverse acc)))

(when (and (getenv "NC_MODE") (boundp 'nelisp-nc--table))
  (let ((mode (intern (getenv "NC_MODE"))) (n 0))
    (dolist (row nelisp-nc--table)
      (when (and (fboundp (car row)) (not (memq :mutant row)))
        (when (nelisp-nc-select (car row) (if (eq mode 'mutant) 'native mode)) (setq n (1+ n)))))
    (when (eq mode 'mutant)
      (dolist (row nelisp-nc--table)
        (when (memq :mutant row) (nelisp-nc-select (car row) 'mutant))))
    (princ (format "MODE %s selected=%d\n" mode n))))
(when (getenv "NC_FXIR")
  ;; Every hot-set name (NC_FXIR_NAMES, one per line) runs its fxir through
  ;; the reference evaluator (test/nelisp-fxir-eval.el).
  (load (expand-file-name "test/nelisp-fxir-eval.el") nil t)
  (let ((n 0))
    (dolist (s (with-temp-buffer (insert-file-contents (getenv "NC_FXIR_NAMES"))
                                 (split-string (buffer-string) "\n" t)))
      (let* ((name (intern s)) (fn (and (fboundp name) (symbol-function name)))
             (rec (and (eq (car-safe fn) 'closure) (gethash (nthcdr 3 fn) nelisp--fx-table)))
             (c (and (vectorp rec) (/= (aref rec 1) -1) (nelisp-fxir-recompile fn))))
        (when (and c (nth 2 c) (nelisp-fxir-code-same-p (car c) (aref rec 0)))
          (let ((ir (nth 2 c)))
            (fset name (lambda (&rest args) (nelisp-fxir-run rec ir args fn)))
            (setq n (1+ n))))))
    (princ (format "MODE fxir selected=%d\n" n))))
(dolist (c (reverse nc2-cases))
  (nc2-gc)
  (princ (format "%s => %s\n" (car c)
                 (condition-case e (format "%S" (funcall (cdr c))) (error (format "ERR %S" e))))))
