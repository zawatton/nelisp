;;; standalone-abi-worker-parked-calls-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let* ((shared (nelisp-thread-shared-alloc 64))
       (result0 shared) (result1 (+ shared 8))
       (arrived (+ shared 16)) (release (+ shared 24)) (done (+ shared 32))
       (form0 `(car (apply (lambda (&rest xs)
                             (nelisp-thread-atomic-add ,arrived 1)
                             (nelisp-thread-join ,release 1) xs)
                           17 (list 23))))
       (form1 `(car (funcall (lambda (x)
                               (nelisp-thread-atomic-add ,arrived 1)
                               (nelisp-thread-join ,release 1) x)
                             (list 29))))
       (active nil) (released nil) (spawned 0))
  (unless (> shared 0) (error "parked call allocation failed"))
  (unwind-protect
      (progn
        (unless (= (nelisp-thread-gc-inhibit 1) 1) (error "parked call section failed"))
        (setq active t)
        (unless (> (nelisp-thread-spawn 2 0 form0 result0 done) 0)
          (error "parked apply worker did not spawn"))
        (setq spawned 1)
        (unless (> (nelisp-thread-spawn 2 0 form1 result1 done) 0)
          (error "parked funcall worker did not spawn"))
        (setq spawned 2)
        (unless (= (nelisp-thread-join arrived 2) 2) (error "call workers did not arrive"))
        (let* ((before (nelisp--debug-switch 0))
               (missed (nth 19 before)) (collects (nth 20 before)))
          (unless (= (nth 16 before) 2) (error "two call workers were not registered"))
          (garbage-collect)
          (let ((after (nelisp--debug-switch 0)))
            (unless (and (= (nth 18 after) 2) (= (nth 19 after) missed)
                         (= (nth 20 after) (+ collects 1)))
              (error "call test did not perform an actual parked collection"))))
        (nelisp-thread-atomic-add release 1)
        (setq released t)
        (unless (= (nelisp-thread-join done 2) 2) (error "call workers did not finish"))
        (unless (= (nelisp-thread-atomic-read result0) 17)
          (error "parked apply value lost"))
        (unless (= (nelisp-thread-atomic-read result1) 29)
          (error "parked funcall value lost"))
        (unless (= (nelisp-thread-gc-inhibit 0) 1) (error "call section grew the arena"))
        (setq active nil))
    (when active
      (unless released (nelisp-thread-atomic-add release 1))
      (when (> spawned 0) (nelisp-thread-join done spawned))
      (nelisp-thread-gc-inhibit 0))))
(princ "ABI-WORKER-PARKED-CALLS checked=3 PASS\n")
