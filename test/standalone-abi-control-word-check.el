;;; standalone-abi-control-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0))
  (dolist (value (list nil t 0 -7 1.25 "control" '(a . b) [nil t]
                       (make-symbol "control")))
    (unless (eq (prog1 value (garbage-collect)) value) (error "prog1 saved WORD changed"))
    (unless (eq (prog2 (garbage-collect) value (garbage-collect)) value)
      (error "prog2 saved WORD changed"))
    (setq checked (+ checked 2)))
  (unless (eq (eval :abi-control-keyword) :abi-control-keyword)
    (error "self-evaluating keyword changed"))
  (unless (eq (intern "nil") nil) (error "nil intern changed"))
  (unless (eq (intern "t") t) (error "t intern changed"))
  (setq checked (+ checked 3))
  (let ((seen nil) (values (list nil t 0 -7 "list-value")))
    (dolist (value values) (push value seen) (garbage-collect))
    (unless (equal (nreverse seen) values) (error "dolist values changed"))
    (setq checked (+ checked 1)))
  (dolist (result '(nil t 0 -7))
    (unless (eq (dolist (_ nil result)) result) (error "dolist empty result changed"))
    (setq checked (+ checked 1)))
  (let ((total 0))
    (dotimes (_ 20)
      (unless (= (dolist (_ '(nil t 0 -7) 0) (setq total (+ total 1))) 0)
        (error "cached dolist result changed")))
    (unless (= total 80) (error "cached dolist side effect changed"))
    (setq checked (+ checked 1)))
  (let ((functions nil))
    (dolist (value '(nil t 0 -7)) (push (lambda () value) functions))
    (unless (equal (mapcar #'funcall (nreverse functions)) '(nil t 0 -7))
      (error "dolist lexical binding changed"))
    (setq checked (+ checked 1)))
  (unless (condition-case nil (progn (dolist (_ '(a . 0))) nil)
            (wrong-type-argument t))
    (error "dolist dotted tail accepted"))
  (setq checked (+ checked 1))
  (princ (format "ABI-CONTROL-WORD checked=%d PASS\n" checked)))
