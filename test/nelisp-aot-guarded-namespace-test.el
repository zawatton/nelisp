;;; nelisp-aot-guarded-namespace-test.el --- Standalone K names -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)
(ert-deftest nelisp-aot-guarded-namespace/standalone-unit-private-public-collision ()
  (let* ((dir (make-temp-file "guarded-names-" t)) (exe (expand-file-name "probe" dir))
         (nelisp-standalone--target 'linux-x86_64)
         (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
         (nelisp-aot-compiler--x86-trace-unit-names nil)
         (source '(seq
                   (defun slow (x) (+ x 3))
                   (defun guarded (x)
                     (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow x))))
                       (if (= entry 0)
                           (seq (ptr-write-u64 805306368 0 1)
                                (ptr-write-u64 805306368 8 (+ (ptr-read-u64 805306368 8) 1))
                                (ptr-write-u64 805306368 16 x) (+ x 1)) entry)))
                   (defun trace-guarded-call-label (x) (+ x 73))
                   (defun _start ()
                     (seq (syscall-direct 9 805306368 4096 3 50 -1 0)
                          (let* ((r (guarded 7))
                                 (v (call-ptr (addr-of trace-guarded-call-label) 5)))
                            (syscall-direct 60 (if (and (= r 8) (= v 78)) 0 1) 0 0 0 0 0)))))))
    (unwind-protect
        (let* ((unit (nelisp-standalone--compile-to-unit "guarded-names" source)))
          (nelisp-link-units exe (list unit) "_start")
          (should (= 0 (call-process exe nil nil nil))))
      (delete-directory dir t))
    (should-not nelisp-aot-compiler--x86-trace-unit-names)
    (should-not nelisp-aot-compiler--x86-guarded-body-facts)))
(provide 'nelisp-aot-guarded-namespace-test)
