;;; standalone-prim-sort-native-check.el --- Native sort callback/GC cases -*- lexical-binding: t -*-

(defvar ps-native-cases
  '((sort)
    (sort '(3 1 2) (lambda (a b) (and (< a b) 123)))
    (sort '(3 1 2) '(1 2))
    (sort '(3 1 2) 12 nil)
    (sort '(3.0 1 2.0) #'<)
    (sort '(3 1.0 2) #'>)
    (sort '("a" "b" "aa") #'string>)
    (sort '(3 1 2) (symbol-function '<))
    (sort '(3 1 2) :lessp 'no-such :key (lambda (_x) (error "key-first")))
    (sort '(3 1 2) :lessp 12 :key (lambda (_x) (error "key-first")))
    (let ((old (symbol-function '<)))
      (unwind-protect
          (sort '(3 1 2) :lessp '< :key (lambda (x) (fset '< (lambda (_a _b) nil)) x))
        (fset '< old)))
    (let ((old (symbol-function 'string-lessp)))
      (unwind-protect
          (sort '("b" "a" "c") :lessp 'string-lessp
                :key (lambda (x) (fset 'string-lessp (lambda (_a _b) nil)) x))
        (fset 'string-lessp old)))
    (progn (fset 'ps-frozen (lambda (a b) (< a b)))
           (sort '(3 1 2) :lessp 'ps-frozen
                 :key (lambda (x) (fset 'ps-frozen (lambda (a b) (> a b))) x)))
    (progn (fset 'ps-frozen-key (lambda (x) (fset 'ps-frozen-key (lambda (v) (- v))) x))
           (sort '(3 1 2) :key 'ps-frozen-key))
    (let ((x (list 5 4 3 2 1)))
      (list (condition-case e
                (sort x (lambda (a b) (if (= a 2) (error "oops") (< a b))))
              (error e)) x))
    (let ((offset 7))
      (sort '(3 1 2) (lambda (a b) (< (+ a offset) (+ b offset)))))
    (sort '(4 1 3 2) (lambda (a b) (garbage-collect) (< a b)))
    (sort '((4) (1) (3) (2)) :key (lambda (x) (garbage-collect) (car x)))
    (sort '(4 1 3 2) (lambda (a b) (equal (sort (list a b) #'<) (list a b))))
    (let* ((x (mapcar (lambda (i) (cons (% (* i 7) 13) i)) (number-sequence 0 149)))
           (y (sort x :key #'car)))
      (list (= (length y) 150) (equal x y) y))
    (sort (vconcat (mapcar (lambda (i) (cons (% (* i 7) 13) i)) (number-sequence 0 149)))
          :key #'car :reverse t)
    (sort (mapcar (lambda (i) (list (% i 7) (% i 3))) (number-sequence 0 99)))
    (sort (mapcar (lambda (i) (vector (% i 7) (% i 3))) (number-sequence 0 99)))
    (let* ((a (make-hash-table)) (b (make-hash-table))
           (result (sort (vector a b))))
      (list (eq (aref result 0) a) (eq (aref result 1) b)))
    (sort '(1 2) :key nil :key #'identity :lessp #'> :reverse t :in-place t)
    (let ((old (symbol-function 'value<)))
      (unwind-protect
          (progn (fset 'value< (lambda (_a _b) nil))
                 (list (sort '(3 1 2)) (sort '(3 1 2) 'value<)
                       (sort '(3 1 2) (symbol-function 'value<))))
        (fset 'value< old)))
    (let* ((x (list 3 1 2)) (y (copy-sequence x)))
      (list x y (eq x y) (eq (cdr x) (cdr y))))
    (copy-sequence '(1 . 2))
    (let* ((x (list 3 1 2)) (y (copy-sequence x)))
      (setcar y 9) (list x y))
    (let ((old (symbol-function 'string-lessp)))
      (unwind-protect
          (progn (fset 'string-lessp (lambda (_a _b) nil))
                 (sort '("b" "a" "c") #'string>))
        (fset 'string-lessp old)))
    (let ((old (symbol-function '<)))
      (unwind-protect
          (progn (fset '< (lambda (_a _b) nil)) (sort '(3.0 1 2.0)))
        (fset '< old)))))
(let ((index 0))
  (dolist (form ps-native-cases)
    (princ (format "PS-NATIVE %d " index))
    (prin1 (condition-case problem (eval form t) (error problem)))
    (terpri)
    (setq index (1+ index)))
  (unless (= index 31) (error "native sort case count")))
(unless (equal (sort (list 3 1 2) #'<) '(1 2 3))
  (error "native sort assertion"))
(princ "PS-NATIVE COMPLETE\n")
