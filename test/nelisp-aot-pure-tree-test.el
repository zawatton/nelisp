;;; nelisp-aot-pure-tree-test.el --- Pure GP expression temporaries -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)

(defun nelisp-aot-pure-tree-test--ir (kind &rest args)
  (apply #'nelisp-aot-compiler--make-ir kind args))
(defun nelisp-aot-pure-tree-test--ref (slot)
  (nelisp-aot-pure-tree-test--ir 'ref :slot slot :class 'gp))
(defun nelisp-aot-pure-tree-test--pair ()
  (nelisp-aot-pure-tree-test--ir
   'arith :op '+ :a (nelisp-aot-pure-tree-test--ref 0)
   :b (nelisp-aot-pure-tree-test--ref 1)))

(ert-deftest nelisp-aot-pure-tree/balanced-tree-uses-registers ()
  (let* ((nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (nelisp-aot-compiler--rsp-temp-depth 0)
         (a (nelisp-aot-pure-tree-test--pair))
         (b (nelisp-aot-pure-tree-test--pair))
         (buf (nelisp-asm-x86_64-make-buffer)))
    (should (equal '(1) (nelisp-aot-compiler--x86-memory-tree-info a)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-temp-push)
               (lambda (&rest _) (ert-fail "pure tree pushed a temporary")))
              ((symbol-function 'nelisp-aot-compiler--emit-temp-pop)
               (lambda (&rest _) (ert-fail "pure tree popped a temporary"))))
      (should (nelisp-aot-compiler--emit-memory-tree-binop-x86 '+ a b buf)))
    (should (> (length (nelisp-asm-x86_64-buffer-bytes buf)) 0))
    (should (= nelisp-aot-compiler--rsp-temp-depth 0))))

(ert-deftest nelisp-aot-pure-tree/preflight-keeps-effects-and-live-registers ()
  (let* ((nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (pair (nelisp-aot-pure-tree-test--pair))
         (two (nelisp-aot-pure-tree-test--ir 'arith :op '+ :a pair :b pair))
         (three (nelisp-aot-pure-tree-test--ir 'arith :op '+ :a two :b two)))
    (dolist (b (list (nelisp-aot-pure-tree-test--ir 'call :name 'opaque)
                     (nelisp-aot-pure-tree-test--ir 'setq-local :slot 0 :value-ir pair)
                     (nelisp-aot-pure-tree-test--ir
                      'shift :op 'shl :a pair :b (nelisp-aot-pure-tree-test--ref 2))
                     (nelisp-aot-pure-tree-test--ir 'ref :slot 0 :class 'f64)
                     three))
      (let ((buf (nelisp-asm-x86_64-make-buffer)))
        (should-not (nelisp-aot-compiler--emit-memory-tree-binop-x86 '+ pair b buf))
        (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))))
    (dolist (reg '(rax r10 r11 rdi rsi))
      (let ((nelisp-aot-compiler--promoted-slots (list (cons 0 reg)))
            (buf (nelisp-asm-x86_64-make-buffer)))
        (should-not (nelisp-aot-compiler--emit-memory-tree-binop-x86 '+ pair pair buf))
        (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))))
    (dolist (mode '(leaf checked))
      (let ((nelisp-aot-compiler--x86-call-containing-defun-p (not (eq mode 'leaf)))
            (nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (buf (nelisp-asm-x86_64-make-buffer)))
        (should-not (nelisp-aot-compiler--emit-memory-tree-binop-x86 '+ pair pair buf))
        (should (equal "" (nelisp-asm-x86_64-buffer-bytes buf)))))))

(defun nelisp-aot-pure-tree-test--wrap (n)
  (let ((u (logand n (1- (ash 1 64)))))
    (if (>= u (ash 1 63)) (- u (ash 1 64)) u)))
(defun nelisp-aot-pure-tree-test--gnu-form (form)
  (cond ((atom form) form)
        ((eq (car form) 'quote) form)
        (t (cons (cond ((eq (car form) 'seq) 'progn)
                       ((eq (car form) 'shl) 'ash)
                       (t (car form)))
                 (mapcar #'nelisp-aot-pure-tree-test--gnu-form (cdr form))))))
(defun nelisp-aot-pure-tree-test--run (program)
  (let ((path (make-temp-file "pure-tree-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp program path)
               (call-process path nil nil nil))
      (delete-file path))))

(ert-deftest nelisp-aot-pure-tree/gnu-native-full-width-and-fallbacks ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((cases 0))
    (dolist (expr '((+ (+ a b) (+ c d))
                    (- (* a b) (* c d))
                    (logxor (+ (* a b) (* c d)) (* (- a c) (+ b d)))
                    (logxor (shl (+ a b) 7) (shl (- c d) 3))
                    (+ (* (+ a b) (+ c d))
                       (* (* (+ a b) (+ c d)) (* (- a b) (- c d))))
                    (+ (seq (setq a (+ a 1)) (+ a b))
                       (seq (setq b (+ b 2)) (+ a b)))
                    (+ (+ a b) (opaque (+ c d)))))
      (dolist (args '((0 1 2 3) (-1 2 -3 4)
                      (4294967299 8589934597 1099511627783 -17179869193)
                      (9223372036854775807 -9223372036854775808 4294967295 -7)))
        (let* ((defs `((defun opaque (x) (+ x 17))
                       (defun f (a b c d) (seq (opaque 0) ,expr))))
               (value (eval (nelisp-aot-pure-tree-test--gnu-form
                             `(seq ,@defs (f ,@args))) t))
               (golden (nelisp-aot-pure-tree-test--wrap value)))
          ;; Native compares all 64 bits before turning equality into exit0.
          (should (= 0 (nelisp-aot-pure-tree-test--run
                        `(seq ,@defs (exit (if (= (f ,@args) ,golden) 0 1))))))
          (setq cases (1+ cases)))))
    (message "Pure GP tree GNU/native full-width cases: %d" cases)))

(ert-deftest nelisp-aot-pure-tree/checked-overflow-fallback ()
  (skip-unless (and (eq system-type 'gnu/linux)
                    (string-match-p "x86_64" system-configuration)))
  (let ((nelisp-aot-compiler--checked-arith t))
    (should (= 30 (nelisp-aot-pure-tree-test--run
                   '(seq (defun opaque (x) x)
                         (defun f (a b c d) (opaque 0) (+ (+ a b) (+ c d)))
                         (exit (f 3 5 9 13))))))
    ;; Existing RAW checked-arithmetic contract exits97 at the fixnum bound.
    (should (= 97 (nelisp-aot-pure-tree-test--run
                   '(seq (defun opaque (x) x)
                         (defun f (a b c d) (opaque 0) (+ (+ a b) (+ c d)))
                         (exit (f 2305843009213693951 1 0 0))))))))

(provide 'nelisp-aot-pure-tree-test)
