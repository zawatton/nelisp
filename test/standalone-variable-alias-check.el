;;; standalone-variable-alias-check.el --- GNU 31.1 alias regression -*- lexical-binding: t; -*-
;; Expected rows were executed on GNU Emacs 31.1, not computed by this runtime.
(let ((root (expand-file-name ".." (file-name-directory load-file-name))))
  (add-to-list 'load-path (expand-file-name "lisp" root))
  (load (expand-file-name "test/perf/prim-alias-extra.el" root) nil t t))
(let ((expected '(
(uninterned-read-set (3 3 nil t))
(makunbound-detaches (t nil 9))
(independent-cells (1 2 4 3))
(reference-setq (12 12 12))
(let-alias ((30 30 30) 12 12))
(let-base (41 41))
(re-alias (12 71 71 pa-other))
(cycle-data (cyclic-variable-indirection pa-cycle-a))
(self-cycle (cyclic-variable-indirection pa-self))
(non-symbol-indirect (nil t 1 "x" (a) [a] :kw))
(nil-t-keyword (nil nil t t t :pa-key :pa-key))
(constant-write-errors ((setting-constant pa-nil) (setting-constant pa-true) (setting-constant pa-key)))
(uninterned-nil (t 88))
(long-chain (t 99))
(documentation ("first" nil 42))
(delete-nonalias (error "Cannot undeclare a variable that is not an alias" pa-not-alias))
(let-bound-source (error "Don’t know how to make a let-bound variable an alias: pa-source"))
(bytecode-bind (81 71 71))
(bytecode-constant-bind (setting-constant nil))
(interpreted-constant-bind (setting-constant nil))
(buffer-local ((4 4 1) 2 5 t 5))
(buffer-local-source (error "Don’t know how to make a buffer-local variable an alias: pa-local-source"))
(local-migration (2 nil))
(local-void-migration (1 4))
(local-uninterned-identity (2 2 8 1 nil))
(multi-hop-operations ((9 9 9 9) 8 8 nil pa-chain-b))
(re-alias-local-base (7 2))
(void-default (nil (void-variable pa-default-void-alias) :pa-default-key t :pa-default-key))
(old-lexical-base (19 (void-variable pa-old-alias)))
(buffer-multibyte-default ((t t t) (nil t t) nil "abc"))
)))
  (unless (equal (reverse pa-results) expected)
    (error "VARIABLE-ALIAS mismatch: got %S expected %S" (reverse pa-results) expected))
  (princ (format "VARIABLE-ALIAS PASS checked=%d\n" (length expected))))
(when (fboundp 'nelisp--native-env)
  (unless (fboundp 'nelisp--native-variable-alias-pairs)
    (error "Native alias enumerator is missing"))
  (let ((a (make-symbol "enumerated-alias")) (b (make-symbol "enumerated-base")))
    (set b 17)
    (defvaralias a b)
    (unless (eq (cdr (assq a (nelisp--native-variable-alias-pairs))) b)
      (error "Native enumerator lost uninterned identity"))
    (unless (assq 'pa-nil (nelisp--native-variable-alias-pairs))
      (error "Native enumerator lost nil target"))
    (unless (null (cdr (assq 'pa-nil (nelisp--native-variable-alias-pairs))))
      (error "Native enumerator exposed private nil key"))
    (makunbound a)
    (when (assq a (nelisp--native-variable-alias-pairs))
      (error "Native enumerator retained a deleted alias"))))
(when (fboundp 'nelisp--native-env)
  ;; The actual library provider must leave native accessors installed.
  (let ((before (mapcar #'symbol-function
                       '(symbol-value boundp set makunbound defvaralias)))
        (provider (expand-file-name
                   "../packages/nelisp-emacs-foundation/src/emacs-cc-variable-alias-1.el"
                   (file-name-directory load-file-name))))
    (unless (and (fboundp 'nelisp--repr) nelisp--native-variable-aliases)
      (error "Native library capability was not exercised"))
    (load provider nil t t)
    (let ((after (mapcar #'symbol-function
                        '(symbol-value boundp set makunbound defvaralias))))
      (while before
        (unless (eq (car before) (car after))
          (error "Library provider replaced a native function cell"))
        (setq before (cdr before) after (cdr after))))))
(when (fboundp 'nelisp--env-globals-op)
  ;; Exercise the native resolver's valid missing-terminal sentinel without
  ;; defvaralias's usual terminal autovivification hiding the handoff edge.
  (defvar pa-bytecode-missing-terminal 1)
  (progn
    (nelisp--env-globals-op 'variable-entry-slot-set 'pa-bytecode-missing-terminal
                            (cons 4 (make-symbol "missing-terminal")))
    (unless (eq (condition-case e
                    (funcall (make-byte-code 0 (unibyte-string 8 135)
                                             [pa-bytecode-missing-terminal] 1))
                  (error (car e))) 'void-variable)
      (error "Bytecode missing-terminal handoff did not signal void-variable"))))
(kill-emacs 0)
