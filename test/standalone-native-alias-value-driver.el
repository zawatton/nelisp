;;; standalone-native-alias-value-driver.el -*- lexical-binding: t; -*-

(unless (fboundp 'nelisp--variable-alias-install)
  (error "The private diagnostic alias adapter is required"))

(defvar route-target 10)
(defvar route-alias 20)
(setq route-plain 31)
(defun route-install-alias ()
  (nelisp--variable-alias-install 'route-alias 'route-target))

(unless (= (route-install-alias) 0)
  (error "Alias installation failed"))
(garbage-collect)
(unless (and (= (symbol-value 'route-alias) 10)
             (= (symbol-value 'route-target) 10))
  (error "Alias initial read failed after GC"))

(setq route-alias 11)
(unless (and (= (symbol-value 'route-alias) 11)
             (= (symbol-value 'route-target) 11))
  (error "Alias write-through failed"))
(setq route-target 12)
(unless (= (symbol-value 'route-alias) 12)
  (error "Base write-through failed"))

(fset 'route-alias (lambda () 'alias-function))
(fset 'route-target (lambda () 'target-function))
(put 'route-alias 'route-property 'alias-property)
(put 'route-target 'route-property 'target-property)
(unless (and (eq (funcall 'route-alias) 'alias-function)
             (eq (funcall 'route-target) 'target-function)
             (eq (get 'route-alias 'route-property) 'alias-property)
             (eq (get 'route-target 'route-property) 'target-property))
  (error "Alias changed function or plist identity"))

(let ((route-target 77))
  (unless (= (symbol-value 'route-alias) 77)
    (error "Dynamic target binding was not visible through alias")))
(setq route-lexical 23)
(let ((route-lexical 99))
  (unless (= (symbol-value 'route-lexical) 23)
    (error "symbol-value observed a lexical binding")))

(unless (and (= (symbol-value 'route-plain) 31)
             (= (nelisp--variable-alias-install 'route-target 'route-alias) 2)
             (= (nelisp--variable-alias-install 'route-alias "bad-target") 1))
  (error "Nonalias, cycle, or malformed-target control failed"))
(princ "NATIVE-ALIAS-VALUE-PASS\n")
