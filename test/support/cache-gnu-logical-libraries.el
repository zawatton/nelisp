;;; cache-gnu-logical-libraries.el --- Preserve GNU library resolution in bounded source caches -*- lexical-binding: t; -*-
(require 'json)
(unless (equal emacs-version "31.1") (error "GNU31 resolver required"))
(let* ((libraries (split-string (or (getenv "NELISP_GNU_CACHE_LIBRARIES") "speedbar") ";" t))
       (output (expand-file-name (or (getenv "NELISP_GNU_CACHE_OUTPUT")
                                    "target/progress/production-sol-source-cache-r16/cache")))
       (gnu-root (file-name-directory (locate-library "subr")))
       (executable (file-truename (expand-file-name invocation-name invocation-directory)))
       (executable-sha (with-temp-buffer
                         (set-buffer-multibyte nil)
                         (insert-file-contents-literally executable)
                         (secure-hash 'sha256 (current-buffer))))
       (resolver-owner (secure-hash 'sha256 (prin1-to-string (symbol-function 'locate-library))))
       (total 0) records)
  (when (> (length libraries) 64) (error "Source cache exceeds original64 file bound"))
  (unless (= (length libraries) (length (delete-dups (copy-sequence libraries))))
    (error "Duplicate logical library request"))
  (when (file-exists-p output) (error "Refusing to replace existing source cache"))
  ;; Complete resolution and validation before creating the new cache.
  (dolist (library libraries)
    (unless (and (string-match-p "\\`[[:alnum:]_+./-]+\\'" library)
                 (not (string-prefix-p "/" library))
                 (not (member ".." (split-string library "/"))))
      (error "Invalid logical library: %S" library))
    (let* ((located (locate-library library))
           (base (and located (file-name-sans-extension located)))
           (source (and base (cond ((file-exists-p (concat base ".el.gz")) (concat base ".el.gz"))
                                   ((file-exists-p (concat base ".el")) (concat base ".el")))))
           bytes features)
      (unless (and source (file-in-directory-p source gnu-root))
        (error "No GNU source owner for logical library: %S" library))
      (with-temp-buffer
        (set-buffer-multibyte nil)
        (let ((coding-system-for-read 'no-conversion)) (insert-file-contents source))
        (setq bytes (buffer-string) total (+ total (buffer-size)))
        (when (> total 8388608) (error "Source cache exceeds original8MiB byte bound"))
        (goto-char (point-min))
        (condition-case nil
            (while t
              (let ((form (read (current-buffer))))
                (when (and (eq (car-safe form) 'provide)
                           (eq (car-safe (cadr form)) 'quote))
                  (push (symbol-name (cadr (cadr form))) features))))
          (end-of-file nil)))
      (push (list :library library :located located :source source :bytes bytes
                  :sha256 (secure-hash 'sha256 bytes) :provides (nreverse features)) records)))
  (make-directory output t)
  (setq records (nreverse records))
  (dolist (record records)
    (let ((destination (expand-file-name (concat (plist-get record :library) ".el") output)))
      (make-directory (file-name-directory destination) t)
      (with-temp-buffer
        (set-buffer-multibyte nil) (insert (plist-get record :bytes))
        (let ((coding-system-for-write 'no-conversion)) (write-region (point-min) (point-max) destination nil 'silent)))))
  (with-temp-file (expand-file-name "manifest.json" output)
    (insert (json-encode
             `((format . "GNU-logical-source-cache-v1") (gnu-version . ,emacs-version)
               (gnu-executable-sha256 . ,executable-sha) (locate-library-owner-sha256 . ,resolver-owner)
               (file-limit . 64) (byte-limit . 8388608) (actual-bytes . ,total)
               (files . ,(vconcat
                          (mapcar (lambda (r)
                                    `((library . ,(plist-get r :library))
                                      (located-relative . ,(file-relative-name (plist-get r :located) gnu-root))
                                      (source-relative . ,(file-relative-name (plist-get r :source) gnu-root))
                                      (raw-sha256 . ,(plist-get r :sha256))
                                      (bytes . ,(length (plist-get r :bytes)))
                                      (provides . ,(vconcat (plist-get r :provides))))) records))))))
    (insert "\n")))
