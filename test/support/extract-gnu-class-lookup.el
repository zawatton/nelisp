;;; extract-gnu-class-lookup.el --- Authenticated one-macro GNU class lookup -*- lexical-binding: t; -*-
(unless (equal emacs-version "31.1") (error "GNU31.1 class expander is required"))
(let* ((root (getenv "NELISP_GNU_BUILD_SOURCE_ROOT"))
       (extra (expand-file-name "lisp/emacs-lisp/cl-extra.el" root))
       (macs (expand-file-name "lisp/emacs-lisp/cl-macs.el" root)) found)
  (dolist (entry `((,extra . "4aca78d4d9c161ba688bf0253f0c4445415d5c0fcb9a8f573cc6ab1270583d42")
                   (,macs . "f58f3f9b88755549a7713b59045059affda99c2e22251e22e5c40fbe017f2394")))
    (with-temp-buffer
      (insert-file-contents-literally (car entry))
      (unless (equal (secure-hash 'sha256 (current-buffer)) (cdr entry))
        (error "GNU class lookup source pin differs"))))
  (load macs nil nil t)
  (unless (and (subrp (symbol-function 'macroexpand))
               (equal (file-truename (symbol-file 'cl--find-class 'defun))
                      (file-truename macs)))
    (error "Genuine GNU class macro owner differs"))
  (with-temp-buffer
    (insert-file-contents extra)
    (goto-char (point-min))
    (condition-case nil
        (while t
          (let ((form (read (current-buffer))))
            (when (and (consp form) (eq (car form) 'defun) (eq (cadr form) 'cl-find-class))
              (push form found))))
      (end-of-file nil)))
  (unless (and (= (length found) 1) (= (length (car found)) 5)
               (equal (car (last (car found))) '(cl--find-class type)))
    (error "GNU class lookup definition uniqueness/body differs"))
  (let* ((form (copy-tree (car found)))
         (expansion (macroexpand '(cl--find-class type))))
    (unless (equal expansion '(get type 'cl--class))
      (error "Genuine GNU class macro expansion differs"))
    (setcar (last form) expansion)
    (with-temp-file (getenv "NELISP_CLASS_LOOKUP_OUTPUT")
      (insert ";;; Genuine GNU class lookup expansion -*- lexical-binding: t; -*-\n")
      (prin1 form (current-buffer))
      (insert "\n"))
    (princ (list 'GNU-CLASS-EXPANDER emacs-version
                 (symbol-file 'cl--find-class 'defun) 'native-macroexpand))))
