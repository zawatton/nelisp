;;; -*- lexical-binding: t; -*-
;; F293 semantic parity rows for the native rows nconc, mapcan, string-clean-whitespace
;; (live native after the regfix reconvert pass).  GNU 31.1 is the spec; see test/par-regfix.gnu.
;; The circular-list rows run last: GNU nconc/mapcan of a circular list is checked by a separate timeout run.
(defmacro row (name form) `(princ (format "%-26s %S\n" ,name (condition-case e ,form (error (list 'ERR e))))))
(row "nconc none" (nconc))
(row "nconc nil" (nconc nil))
(row "nconc nil nil" (nconc nil nil))
(row "nconc atom only" (nconc 5))
(row "nconc nil atom" (nconc nil 5))
(row "nconc list atom" (nconc (list 1) 2))
(row "nconc dotted last" (nconc (list 1) (cons 2 3)))
(row "nconc dotted first" (nconc (cons 1 2) (list 3)))
(row "nconc nonlist middle" (nconc (list 1) 2 (list 3)))
(row "nconc nil middle" (nconc (list 1) nil nil (list 2) nil))
(row "nconc 3 lists" (nconc (list 1) (list 2) (list 3 4)))
(row "nconc shares last" (let* ((z (list 9)) (r (nconc (list 1) z))) (list r (eq (cdr r) z))))
(row "nconc mutates first" (let* ((a (list 1)) (r (nconc a (list 2)))) (list (eq r a) a)))
(row "nconc same list twice" (let ((a (list 1 2))) (condition-case e (let ((r (nconc a a))) (list 'circ (car r) (eq (nthcdr 2 r) r))) (error (list 'ERR e)))))
(row "nconc string arg" (nconc "ab" nil))
(row "nconc vector middle" (nconc (list 1) [2] (list 3)))
(row "funcall nconc" (funcall #'nconc (list 1) (list 2)))
(row "apply nconc" (apply #'nconc (list (list 1) nil (list 2))))
(row "mapcan basic" (mapcan #'list '(1 2 3)))
(row "mapcan nil seq" (mapcan #'list nil))
(row "mapcan nil results" (mapcan (lambda (_) nil) '(1 2)))
(row "mapcan identity lists" (mapcan #'identity (list (list 1) nil (list 2 3))))
(row "mapcan atom result one" (mapcan #'identity '(1)))
(row "mapcan atom result two" (mapcan #'identity '(1 2)))
(row "mapcan atom last" (mapcan (lambda (x) (if (= x 2) 7 (list x))) '(1 2)))
(row "mapcan dotted result" (mapcan (lambda (x) (cons x 9)) '(1 2)))
(row "mapcan string seq" (mapcan #'list "ab"))
(row "mapcan vector seq" (mapcan #'list [1 2]))
(row "mapcan dotted seq" (mapcan #'list '(1 . 2)))
(row "mapcan non-seq" (mapcan #'list 5))
(row "mapcan shared result" (let* ((a (list 1)) (r (mapcan (lambda (_) a) '(1)))) (list r (eq r a))))
(row "mapcan bool-vector seq" (mapcan #'list (make-bool-vector 2 t)))
(row "scw empty" (string-clean-whitespace ""))
(row "scw blank" (string-clean-whitespace "   "))
(row "scw plain" (string-clean-whitespace "a"))
(row "scw spaces" (string-clean-whitespace "  a   b  "))
(row "scw tabs newlines" (string-clean-whitespace "\t a\n\nb\t\r\n c "))
(row "scw nbsp KNOWN-DIV" (string-clean-whitespace " a  b "))
(row "scw unicode KNOWN-DIV" (string-clean-whitespace "  あ  い　う "))
(row "scw formfeed vtab" (string-clean-whitespace "a\fb\vc"))
(row "scw nil" (string-clean-whitespace nil))
(row "scw symbol" (string-clean-whitespace 'a))
(row "scw number" (string-clean-whitespace 5))
;; GNU signals (circular-list LIST) for a circular non-last nconc argument and for a circular mapcan sequence.
(defun pr-circ () (let ((c (list 1 2))) (setcdr (cdr c) c) c))
(row "nconc circular first" (condition-case e (progn (nconc (pr-circ) (list 3)) 'returned) (circular-list 'circular-list)))
(row "nconc circular last" (condition-case e (progn (nconc (list 0) (pr-circ)) 'returned) (circular-list 'circular-list)))
(row "mapcan circular seq" (condition-case e (mapcan #'list (pr-circ)) (circular-list 'circular-list)))
