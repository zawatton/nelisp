;;; nelisp-cc-fxir-intrinsic-test.el --- Intrinsic fallback protocol model -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(defvar nelisp-cc-fxir-native-windows)
(let ((nelisp-cc-fxir-native-windows t)) (require 'nelisp-cc-fxir-native))

(defun nfp--source-defun (name)
  "Read NAME from the bounded quoted runtime definition."
  (with-temp-buffer
    (insert-file-contents "scripts/nelisp-standalone-build.el")
    (goto-char (point-min))
    (search-forward "(defconst nelisp-standalone--applyfn-m5-helpers")
    (goto-char (match-beginning 0))
    (let* ((definition (read (current-buffer)))
           (forms (cadr (nth 2 definition)))
           (helper (cl-find-if (lambda (form)
                                 (and (eq (car-safe form) 'defun)
                                      (eq (cadr form) name))) forms)))
      (unless helper (error "Missing intrinsic provider"))
      helper)))
(defun nfp--source-helper () (nfp--source-defun 'm5_fx_intrinsic_slow))
(defun nfp--count-call (form symbol)
  (if (consp form)
      (+ (if (eq (car form) symbol) 1 0)
         (nfp--count-call (car form) symbol) (nfp--count-call (cdr form) symbol))
    0))

(defun nfp--host (form)
  (cond ((atom form) form)
        ((eq (car form) 'data-addr) 900016)
        ((memq (car form) '(let let*))
         (cons (car form) (cons (mapcar (lambda (b) (list (car b) (nfp--host (cadr b)))) (cadr form))
                               (mapcar #'nfp--host (cddr form)))))
        ((eq (car form) 'if)
         `(if (nfp--truth ,(nfp--host (nth 1 form)))
              ,(nfp--host (nth 2 form)) ,(nfp--host (nth 3 form))))
        (t (cons (if (eq (car form) 'seq) 'progn (car form))
                 (mapcar #'nfp--host (cdr form))))))
(defun nfp--truth (value) (and value (not (equal value 0))))

(defun nfp--run (helper op argc &optional fail-root signal-result)
  "Execute HELPER in a protocol model, not in the native runtime."
  (let ((memory (make-hash-table :test #'eql)) (polls 0) (releases 0) (finish 0)
        (name nil) (logical-operator nil) (published nil))
    (puthash 900016 -1 memory)
    (cl-labels ((readmem (p off) (gethash (+ p off) memory 0))
                (writemem (p off v) (puthash (+ p off) v memory) v))
      (cl-letf (((symbol-function 'ptr-write-u64) #'writemem)
                ((symbol-function 'heap-read-u64) #'readmem)
                ((symbol-function 'wf_bytecode_poll)
                 (lambda () (setq polls (1+ polls)) (writemem 8008 0 9014) 0))
                ((symbol-function 'nl_root_mark) (lambda (_) 123))
                ((symbol-function 'nl_root_frame) (lambda (_ n) (should (= n 5)) (if fail-root 0 30000)))
                ((symbol-function 'nl_root_release) (lambda (_ marker) (should (= marker 123)) (setq releases (1+ releases)) 0))
                ((symbol-function 'wf_bytecode_root_exhausted) (lambda () 1))
                ((symbol-function 'alloc-bytes) (lambda (&rest _) 35000))
                ((symbol-function 'nl_string_new)
                 (lambda (bytes len unibyte)
                   (should (= unibyte 1)) (setq name (cons (readmem bytes 0) len)) 7004))
                ((symbol-function 'nelisp_cons_construct_w)
                 (lambda (a b _) (cond ((and (= a 7004) (= b 3)) 7106)
                                       ((and (= a 3) (= b 7106)) 7206)
                                       (t (ert-fail "Invalid private carrier")))))
                ((symbol-function 'nl_n4_push_words)
                 (lambda (_ sym argv actual)
                   (setq logical-operator sym) (should (= argv 6000)) (should (= actual argc)) 40000))
                ((symbol-function 'm5_fx_word_list)
                 (lambda (stk sp n _) (should (= stk 6000)) (should (= sp argc)) (should (= n argc)) 7306))
                ((symbol-function 'nelisp_apply_function_w)
                 (lambda (carrier args _env _) (should (= carrier 7206)) (should (= args 7306))
                   (if signal-result 0 41)))
                ((symbol-function 'nl_n4_finish_w)
                 (lambda (word _env _ frame)
                   (should (= frame 40000)) (should (= (readmem 8000 0) word))
                   (setq published t finish (1+ finish)) (if (= word 0) 0 45)))
                ((symbol-function 'm5_fx_take)
                 (lambda (word dst) (if (= word 0) 1 (progn (writemem dst 0 word) 0)))))
        (let ((status (eval (nfp--host (cons 'seq (cdddr helper)))
                            `((op . ,op) (env . 1000) (sym . 9006) (stk . 6000)
                              (sp . ,argc) (argc . ,argc) (resw . 8000) (xw . 8008) (oslot . 8100)))))
          (list :status status :polls polls :release releases :finish finish
                :name name :operator logical-operator :published published :result (readmem 8000 0)))))))

(ert-deftest nfp-opcode-mapping-and-protocol ()
  (let ((helper (nfp--source-helper)))
    (dolist (case '((4 2 43 1) (5 2 45 1) (6 2 60 1) (13 2 61 1)
                    (14 2 62 1) (7 1 11057 2) (15 1 11569 2)))
      (let ((result (nfp--run helper (nth 0 case) (nth 1 case))))
        (should (equal (plist-get result :name) (cons (nth 2 case) (nth 3 case))))
        (should (= (plist-get result :operator) 9014))
        (should (= (plist-get result :polls) 1)) (should (= (plist-get result :release) 1))
        (should (= (plist-get result :finish) 1)) (should (= (plist-get result :result) 45))))))

(ert-deftest nfp-signal-and-root-exhaustion ()
  (let ((helper (nfp--source-helper)))
    (let ((result (nfp--run helper 4 2 nil t)))
      (should (= (plist-get result :status) 1)) (should (= (plist-get result :finish) 1))
      (should (= (plist-get result :release) 1)))
    (let ((result (nfp--run helper 4 2 t)))
      (should (= (plist-get result :status) 1)) (should (= (plist-get result :finish) 0))
      (should (= (plist-get result :release) 1)))
    (should (= (plist-get (nfp--run helper 4 1) :status) -3))))

(ert-deftest nfp-poll-and-publication-mutants-detected ()
  (let* ((helper (nfp--source-helper))
         (no-poll (cl-subst 0 '(wf_bytecode_poll) helper :test #'equal))
         (no-publish (cl-subst 0 '(ptr-write-u64 resw 0 word) helper :test #'equal)))
    (should-not (equal helper no-poll)) (should-not (equal helper no-publish))
    (should (= (plist-get (nfp--run no-poll 4 2) :polls) 0))
    (should-error (nfp--run no-publish 4 2) :type 'ert-test-failed)))

(ert-deftest nfp-vm-and-native-use-provider-only-for-intrinsics ()
  (let* ((vm (nfp--source-defun 'm5_fx_run_body))
         (provider (nfp--source-helper))
         (native (cl-find 'nc_arith nelisp-cc-fxir-native--shared-source :key #'cadr)))
    (should (= (nfp--count-call vm 'm5_fx_intrinsic_slow) 2))
    (should (= (nfp--count-call vm 'm5_fx_callout) 1))
    (should (= (nfp--count-call native 'm5_fx_intrinsic_slow) 1))
    (should (= (nfp--count-call native 'nc_call1) 0))
    (should (= (nfp--count-call native 'nc_call2) 0))
    (should (= (nfp--count-call provider 'nelisp_apply_function_w) 1))
    (should (= (nfp--count-call provider 'nl_alloc_symbol_w) 0))
    (should (= (nfp--count-call provider 'm5_fx_callout) 0))))

(provide 'nelisp-cc-fxir-intrinsic-test)
