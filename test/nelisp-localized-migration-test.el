;;; nelisp-localized-migration-test.el --- Genuine-body legacy migration models -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(defvar nelisp--fx-alias-hints)
(defconst lmm--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defvar lmm--cache (make-hash-table :test #'equal))
(defun lmm--definitions (root)
  (or (gethash root lmm--cache)
      (let ((defs (make-hash-table)))
        (dolist (file '("scripts/nelisp-standalone-build.el" "lisp/nelisp-cc-frame-stack-find.el"
                        "lisp/nelisp-cc-env-lookup-value.el" "lisp/nelisp-cc-env-set-value.el"))
          (with-temp-buffer
            (insert-file-contents (expand-file-name file root)) (goto-char 1)
            (condition-case nil
                (while t
                  (let ((todo (list (read (current-buffer)))))
                    (while todo
                      (let ((node (pop todo)))
                        (when (consp node)
                          (if (eq (car node) 'defun) (puthash (cadr node) node defs)
                            (push (car node) todo) (push (cdr node) todo)))))))
              (end-of-file nil))))
        (puthash root defs lmm--cache))))
(defun lmm--form (name &optional old)
  (or (gethash name (lmm--definitions (if old
                     (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root)) lmm--root)))
      (and old (lmm--form name)) (error "Missing genuine definition %S" name)))
(defun lmm--function (name old mutant)
  (let ((f (copy-tree (lmm--form name old))))
    (pcase mutant
      ('wrong-local (when (eq name 'nl_thread_unshallow_localized)
                      (setq f (cl-subst '(lmm-current-value sym) '(nl_ent_w sym 0) f :test #'equal))))
      ('dropped-where (when (eq name 'nl_thread_unshallow_localized)
                         (setq f (cl-subst '(nelisp_cons_construct sym (heap-read-u64 roots 32) (+ scratch 64))
                                           '(nelisp_cons_construct entry (heap-read-u64 roots 32) (+ scratch 64))
                                           f :test #'equal))))
      ('dynamic (when (eq name 'nl_capture_filter_contains)
                  (setq f (cl-subst 0 '(nl_sb_migrated_default_vector item) f :test #'equal))))
      ('double-restore (when (eq name 'nl_sb_restore_one)
                        (setq f `(defun ,name (env item)
                                   (let ((saved (nl_sb_migrated_default_vector item)))
                                     (if (/= saved 0) (nl_ent_set (nl_vector_slot_word saved 0) 0
                                                                         (nl_vector_slot_word saved 1))
                                       ,(cadddr f)))))))
      ('root-failure (when (eq name 'nl_thread_parent_unshallow)
                       (setq f (cl-subst '(seq (nl_thread_parent_unshallow_rooted penv roots)
                                              (wf_bytecode_root_exhausted))
                                         '(wf_bytecode_root_exhausted) f :test #'equal)))))
    (eval `(lambda ,(nth 2 f)
             (cl-macrolet ((seq (&rest xs) (cons 'progn xs))
                           (extern-call (fn &rest xs) (cons fn xs)))
               ,@(cdddr f))) t)))
(defun lmm--run (&optional old repeat fail-root mutant watcher)
  "Execute parsed production bodies; only memory/object/OS primitives are modeled."
  (let ((objects (make-hash-table :test #'eql)) (tags (make-hash-table :test #'eql))
        (mem (make-hash-table :test #'eql)) (bindings (make-hash-table :test #'equal))
        (next 30000) (scratch 200000) (root-top 0) (root-base 500000)
        (default (if repeat 13 9)) (local 13) (writes 0) (notifications nil)
        (env 1000) (name 20006) (local-name 20014) (alias-name 20022)
        (a 21006) (b 22006) (current 22006) (redirect nil) (frame nil) (names nil)
        (registered nil) (alias-path nil)
        (pending 0) (trace nil) (installed nil) (original-entry nil) result)
    (puthash name 4 tags)
    (puthash local-name 4 tags) (puthash alias-name 4 tags)
    (cl-labels
        ((box (x tag) (setq next (+ next 8))
           (let ((word (+ next (if (= tag 7) 2 6))))
             (puthash word x objects) (puthash word tag tags) word))
         (resolve (w) (gethash w mem w))
         (obj (w) (or (gethash (resolve w) objects) (error "Invalid object %s" w)))
         (tag (w) (if (= (resolve w) 3) 0 (gethash (resolve w) tags 2)))
         (rd (p o) (gethash (+ p o) mem 0))
         (wr (p o v) (when (< p 16) (error "Unreserved root write")) (puthash (+ p o) v mem))
         (slot (p n) (aref (obj p) n))
         (cell-value (p) (aref (obj p) 0))
         (clone (value dest) (wr dest 0 (resolve value)) 1)
         (bind (f n c &rest _) (push 'map-insert trace) (puthash (cons f (resolve n)) (resolve c) bindings) 1)
         (find-cell (_frames n _dynamic _raw)
           (if (= (nl_capture_filter_contains (slot frame 1) n) 1)
               (gethash (cons frame (resolve n)) bindings 0) 0)))
      (setq redirect (box (vector 40006 (box (cons (box (cons b local-name) 7) 3) 7) 40014) 8))
      (let* ((outer (box (vector name 5 a) 8))
             (inner (and repeat (box (vector name 9 a) 8)))
             (tail (box (cons outer 3) 7)))
        (setq names (if repeat (box (cons inner tail) 7) tail))
        (setq original-entry (if repeat inner outer))
        (setq frame (box (vector 3 names) 12))
        (let ((backing (box (vector frame) 8)))
          (puthash 1032 (vector backing 5 3) objects) (puthash 1032 12 tags)))
      (cl-letf
          (((symbol-function 'nl_val_tag) #'tag)
           ((symbol-function 'sexp-tag) #'tag)
           ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
           ((symbol-function 'heap-read-u64) #'rd)
           ((symbol-function 'ptr-read-u64) #'rd)
           ((symbol-function 'ptr-write-u64) #'wr)
           ((symbol-function 'data-addr) (lambda (_) 600000))
           ((symbol-function 'nl_root_mark) (lambda (_) root-top))
           ((symbol-function 'nl_root_frame)
            (lambda (_ n) (push 'root-reserve trace)
              (if fail-root 0 (prog1 root-base (setq root-base (+ root-base 1000) root-top (+ root-top n))))))
           ((symbol-function 'nl_root_release) (lambda (_ mark) (setq root-top mark) 0))
           ((symbol-function 'wf_bytecode_root_exhausted) (lambda () (setq pending 1) 0))
           ((symbol-function 'alloc-bytes) (lambda (n _) (prog1 scratch (setq scratch (+ scratch n 64)))))
           ((symbol-function 'nl_val_clone_into) #'clone)
           ((symbol-function 'wf_write_nil) (lambda (p) (wr p 0 3) 0))
           ((symbol-function 'nl_sexp_clone_into) (lambda (v dest) (clone v dest) 0))
           ((symbol-function 'vector-len) (lambda (w) (length (obj w))))
           ((symbol-function 'record-slot-count) (lambda (w) (length (obj w))))
           ((symbol-function 'nl_record_slot_word) #'slot)
           ((symbol-function 'nelisp_frame_slot_raw_word) #'slot)
           ((symbol-function 'nl_vector_slot_word) #'slot)
           ((symbol-function 'vector-ref-ptr) #'slot)
           ((symbol-function 'nl_cons_car_word) (lambda (w) (car (obj w))))
           ((symbol-function 'nl_cons_car_ptr) (lambda (w) (car (obj w))))
           ((symbol-function 'nl_cons_cdr_word) (lambda (w) (cdr (obj w))))
           ((symbol-function 'nl_cons_cdr_ptr) (lambda (w) (cdr (obj w))))
           ((symbol-function 'cons-set-car) (lambda (p v) (push 'names-commit trace) (setcar (obj p) (resolve v)) 1))
           ((symbol-function 'cell-make) (lambda (v dest) (wr dest 0 (box (vector (resolve v)) 11)) 1))
           ((symbol-function 'nelisp_cons_construct) (lambda (x y dest) (wr dest 0 (box (cons (resolve x) (resolve y)) 7)) 1))
           ((symbol-function 'nl_ent_w) (lambda (sym k)
                                         (if (= k 5) redirect
                                           (if (= (resolve sym) local-name) local default))))
           ((symbol-function 'nl_ent_set) (lambda (sym k v) (should (= sym name)) (should (= k 0))
                                          (push 'shared-restore trace) (cl-incf writes) (setq default (resolve v)) 1))
           ((symbol-function 'nl_sb_set) (lambda (_ sym v) (nl_ent_set sym 0 v) 0))
           ((symbol-function 'lmm-current-value) (lambda (_) local))
           ((symbol-function 'nelisp_env_lkv_mirror) (lambda (_ _ dest _) (clone local dest) 0))
           ((symbol-function 'nelisp_symbol_key_equal) (lambda (x y) (if (= (resolve x) (resolve y)) 1 0)))
           ((symbol-function 'nl_word_payload) #'identity)
           ((symbol-function 'nelisp_mirror_lookup_entry) (lambda (_ n) (resolve n)))
           ((symbol-function 'nelisp_env_alias_canonicalize)
            (if (eq mutant 'bad-abi)
                ;; Retain the rejected historical adapter as an ABI control.
                (lambda (_ _ _ n address) (wr address 0 (if (= (resolve n) alias-name) name (resolve n))) 0)
              (lambda (mirror entry n address)
                (should (= mirror env)) (should (= (resolve entry) (resolve n)))
                (should (>= address 200000))
                (if (= (resolve n) alias-name)
                    (progn (push (list mirror entry n address) alias-path)
                           (wr address 0 name) 0)
                  (wr address 0 n) 3))))
           ((symbol-function 'nelisp_env_alias_slot_candidate)
            (lambda (entry index) (should (= index 0))
              (if (= (resolve entry) alias-name) 0 3)))
           ((symbol-function 'nl_ent_n) (lambda (n) (if (= (resolve n) name) 9 5)))
           ((symbol-function 'nelisp_env_entry_slot_tag) (lambda (n _) (if (= (resolve n) name) 8 0)))
           ((symbol-function 'nelisp_env_lookup_value_w) (lambda (&rest _) current))
           ((symbol-function 'nelisp_env_lkv_mirror_w) (lambda (&rest _) current))
           ((symbol-function 'nelisp_mirror_is_constant) (lambda (&rest _) 0))
           ((symbol-function 'dealloc-bytes) (lambda (&rest _) 0))
           ((symbol-function 'nelisp_env_setv_cell_hit)
            (lambda (cell v) (aset (obj cell) 0 (resolve v)) 0))
           ((symbol-function 'nelisp_env_setv_mirror_lazy)
            (lambda (_ n v _) (should (= (resolve n) local-name)) (setq local (resolve v)) 0))
           ((symbol-function 'bf_apply_named_1)
            (lambda (&rest _) (push current registered)
              (aset (obj redirect) 1 (box (cons (box (cons current local-name) 7) 3) 7)) 0))
           ((symbol-function 'bf_eq2) (lambda (x y) (if (= x y) 1 0)))
           ((symbol-function 'nl_sb_aux_default_bound_here) (lambda (&rest _) 0))
           ((symbol-function 'nelisp_frame_bind_in_frame) #'bind)
           ((symbol-function 'nelisp_frame_bind) (lambda (_ n c &rest xs) (apply #'bind frame n c xs)))
           ((symbol-function 'nelisp_frame_stack_find_kind) #'find-cell)
           ((symbol-function 'nelisp_frame_stack_find_kind_descend) (lambda (&rest _) 0))
           ((symbol-function 'nl_cell_get_value) (lambda (cell dest) (clone (cell-value cell) dest) 0))
           ((symbol-function 'nl_n3_cell_set) (lambda (cell v) (aset (obj cell) 0 (resolve v)) 0))
           ((symbol-function 'nl_n3_notify)
            (lambda (_ sym value operation)
              (push (list sym (resolve value) operation) notifications)
              (if watcher
                  (progn (aset (obj (gethash (cons frame name) bindings)) 0 21) (setq pending 1) 1) 0)))
           ((symbol-function 'nl_frame_stack_promote_env) (lambda (&rest _) 0))
           ((symbol-function 'nl_thread_unshallow_lean_at) (lambda (&rest _) 0))
           ((symbol-function 'nl_thread_registry_find) (lambda (_) 0)))
        ;; Authenticate both real catalogs and reject bad adapters before any
        ;; migration, even in tests that later expect a semantic rejection.
        (let* ((seed (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root)))
               (roots (list seed lmm--root)))
          (dolist (root roots)
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally (expand-file-name "lisp/nelisp-cc-env-lookup-value.el" root))
              (unless (equal (secure-hash 'sha256 (current-buffer))
                             "b559a143076b6b379e01d0688ebd02fa2d2c3d4ce7ccb4276ab541109f9340fc")
                (error "LMM ABI source authentication failed"))))
          (dolist (name '(nelisp_env_alias_canonicalize nelisp_env_alias_slot_candidate))
            (let ((expected nil))
              (dolist (root roots)
                ;; No lmm--form fallback: both genuine definitions must exist.
                (let* ((definition (gethash name (lmm--definitions root)))
                       (args (nth 2 definition)))
                  (unless (and definition (listp args) args
                               (cl-every (lambda (x) (and (symbolp x)
                                                         (not (string-prefix-p "&" (symbol-name x))))) args))
                    (error "LMM ABI unsupported/missing genuine argument list: %s" name))
                  (when expected (unless (equal expected args) (error "LMM ABI seed/candidate mismatch: %s" name)))
                  (setq expected args)))
              (let ((actual (func-arity (symbol-function name))) (arity (length expected)))
                (unless (equal actual (cons arity arity))
                  (signal 'error (list "LMM ABI adapter arity mismatch" name actual arity writes trace)))))))
        (unwind-protect
            (progn
              (dolist (n '(nl_sb_migrated_default_vector nl_capture_filter_contains
                           nl_thread_converted_name_p nl_thread_older_shallow_p nl_thread_unshallow_one
                           nl_thread_unshallow_localized nl_thread_unshallow_names
                           nl_thread_parent_unshallow_rooted nl_thread_parent_unshallow
                           nl_sb_saved_default_match nl_sb_default_bound_here
                           nl_sb_restore_one nl_sb_restore_list nl_thread_pop_localized nl_n3_pop_names
                           nl_n4_pop_names_raw nelisp_env_variable_canonicalize
                           nelisp_env_setv_automatic_local nelisp_env_setv_alias_or_mirror))
                (push (cons n (and (fboundp n) (symbol-function n))) installed)
                (fset n (lmm--function n old mutant)))
              (nl_thread_parent_unshallow env)
              (let* ((first (car (obj names))) (active (gethash (cons frame name) bindings 0))
                     (saved (nl_sb_migrated_default_vector first))
                     (in-a (nl_sb_default_bound_here 1032 name a))
                     (in-b (nl_sb_default_bound_here 1032 name b))
                     (dynamic (nl_capture_filter_contains (slot frame 1) name)))
                (setq result (list :default default :active (if (= active 0) 0 (cell-value active))
                                   :saved saved :first first :original original-entry
                                   :where-a in-a :where-b in-b :dynamic dynamic :pending pending
                                   :deep (rd env 168) :writes writes :root-top root-top :trace (reverse trace)))
                (when (and (not old) (not fail-root) (= dynamic 1))
                  ;; Match the genuine symbol key rather than a borrowed
                  ;; view address, before exercising the setter schedules.
                  (let ((view (alloc-bytes 32 8)) (address (alloc-bytes 8 8))
                        (alias-view (alloc-bytes 32 8)))
                    (clone name view)
                    (setq current a)
                    (should (= (nelisp_env_variable_canonicalize env 1032 alias-name
                                                               alias-name address 0) 0))
                    (clone (rd address 0) alias-view)
                    (setq result (append result
                                         (list :identity-cell active
                                               :raw-cell (find-cell 1032 name 1 0)
                                               :view-cell (find-cell 1032 view 1 0)
                                               :alias-view-cell (find-cell 1032 alias-view 1 0)
                                               :local-name-cell (find-cell 1032 local-name 1 0)
                                               ;; Execute the old adapter's exact unresolved hash lookup.
                                               :old-view-cell (gethash (cons frame view) bindings 0))))
                    (setq current b))
                  ;; Execute unchanged real setter/canonicalizer/automatic-local bodies.
                  (setq current a)
                  (should (= (nelisp_env_setv_alias_or_mirror env 1032 name 25 0 0 1 0) 0))
                  (let ((a-value (cell-value active)) (a-local (memq a registered)))
                    (setq current b)
                    (should (= (nelisp_env_setv_alias_or_mirror env 1032 name 29 0 0 1 0) 0))
                    (let ((b-existing local))
                      (aset (obj redirect) 1 3)
                      (should (= (nelisp_env_setv_alias_or_mirror env 1032 name 33 0 0 1 0) 0))
                      (setq result (append result (list :a-set a-value :a-local a-local
                                                       :b-existing-set b-existing :b-created (memq b registered)
                                                       :b-created-set local :shared-after-set default))))
                  (setq current a)
                  (should (= (nelisp_env_setv_alias_or_mirror env 1032 alias-name 37 0 0 1 0) 0))
                  (setq result (append result (list :alias-set (cell-value active) :alias-path alias-path)))
                  (aset (obj active) 0 (if repeat 13 9))))
                (unless fail-root
                  ;; Genuine shallow restore must not reclaim the child's new shared default.
                  (setq default 17) (nl_sb_restore_list env names)
                  (setq result (append result (list :after-restore default)))
                  (when (not old)
                    (if (= saved 0)
                        ;; A control corrupted the carrier. Retain its observed
                        ;; result instead of entering an unrelated generic-pop ABI.
                        (setq result (append result (list :invalid-carrier first)))
                      (nl_n3_pop_names env names 1 0)
                      (setq result (append result (list :after-pop default :notifications (reverse notifications)
                                                       :pending-after-pop pending :roots-after-pop root-top))))))))
          (dolist (x installed) (if (cdr x) (fset (car x) (cdr x)) (fmakunbound (car x)))))))
    result))
(defun lmm--assert-contract (r &optional repeat)
  (should (= (plist-get r :default) 5))
  (should (= (plist-get r :active) (if repeat 13 9)))
  (should (= (plist-get r :saved) (plist-get r :original)))
  (should (= (plist-get r :where-a) 1)) (should (= (plist-get r :where-b) 0))
  (should (= (plist-get r :dynamic) 1))
  (should (= (plist-get r :after-restore) 17))
  (should (= (plist-get r :after-pop) 17))
  (should (= (plist-get r :root-top) 0)) (should (= (plist-get r :roots-after-pop) 0)))
(ert-deftest localized-migration-genuine-seed-red-current-green ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (let ((old (lmm--run t))) (should (= (plist-get old :active) 13))
       (should-error (lmm--assert-contract old)))
  (lmm--assert-contract (lmm--run)))
(ert-deftest localized-migration-repeat-history-and-child-default-survival ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (lmm--assert-contract (lmm--run nil t) t))
(ert-deftest localized-migration-real-setter-buffer-routing-and-alias ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (let ((r (lmm--run)))
    (should (= (plist-get r :a-set) 25)) (should-not (plist-get r :a-local))
    (should (= (plist-get r :b-existing-set) 29))
    (should (plist-get r :b-created)) (should (= (plist-get r :b-created-set) 33))
    (should (= (plist-get r :shared-after-set) 5)) (should (= (plist-get r :alias-set) 37))
    (let ((cell (plist-get r :identity-cell)))
      (should (/= cell 0))
      (dolist (key '(:raw-cell :view-cell :alias-view-cell))
        (should (= (plist-get r key) cell)))
      (should (= (plist-get r :local-name-cell) 0))
      (let ((old (plist-get r :old-view-cell)))
        (should (= old 0))
        (should-error (should (= old cell)))))
    (should (plist-get r :alias-path))
    (should (cl-every (lambda (row) (and (= (nth 0 row) 1000) (= (nth 1 row) 20022)
                                        (= (nth 2 row) 20022) (>= (nth 3 row) 200000)))
                      (plist-get r :alias-path)))))
(ert-deftest localized-migration-checked-root-failure-before-mutation ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (let ((r (lmm--run nil nil t)))
    (should (= (plist-get r :pending) 1)) (should (= (plist-get r :active) 0))
    (should (= (plist-get r :default) 9)) (should (= (plist-get r :writes) 0))
    (should (= (plist-get r :deep) 0)) (should (equal (plist-get r :trace) '(root-reserve))))
  (let ((bad (condition-case e (lmm--run nil nil nil 'bad-abi) (error e))))
    (should (eq (car bad) 'error))
    (should (equal (nth 1 bad) "LMM ABI adapter arity mismatch"))
    (should (eq (nth 2 bad) 'nelisp_env_alias_canonicalize))
    (should (equal (nth 3 bad) '(5 . 5))) (should (= (nth 4 bad) 4))
    (should (= (nth 5 bad) 0)) (should-not (nth 6 bad))))
(ert-deftest localized-migration-real-body-harmful-mutants-rejected ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (dolist (mutant '(wrong-local dropped-where dynamic double-restore))
    ;; Execution is outside semantic rejection: an unrelated ABI error fails.
    (let ((r (lmm--run nil nil nil mutant)))
      (pcase mutant
        ('wrong-local (should (= (plist-get r :active) 13)))
        ('dropped-where (should (= (plist-get r :saved) 0))
                        (should (= (plist-get r :where-a) 0))
                        (should (= (plist-get r :invalid-carrier) (plist-get r :first))))
        ('dynamic (should (= (plist-get r :dynamic) 0)))
        ('double-restore (should (= (plist-get r :after-restore) 5))))
      (should-error (lmm--assert-contract r))))
  (let ((bad (condition-case e (lmm--run nil nil t 'root-failure) (error e))))
    (should (eq (car bad) 'error)) (should (equal (cadr bad) "Unreserved root write"))))
(ert-deftest localized-migration-watcher-error-keeps-current-write-and-pending ()
  (skip-unless (file-directory-p (or (getenv "LEGACY_MIGRATION_SEED") (expand-file-name "../seed" lmm--root))))
  (let ((r (lmm--run nil nil nil nil t)))
    (should (= (plist-get r :after-pop) 21))
    (should (= (plist-get r :pending-after-pop) 1))
    (should (= (plist-get r :roots-after-pop) 0))
    (should (= (caddar (plist-get r :notifications)) 6))))
(ert-deftest localized-migration-authentic-public-alias-precheck ()
  ;; Read the actual public policy rather than the obsolete builder alias copy.
  (let ((new (make-symbol "lmm-source")) (base (make-symbol "lmm-base"))
        (nelisp--fx-alias-hints nil) (kind 2) (installed nil) form)
    (with-temp-buffer
      (insert-file-contents (expand-file-name "scripts/nelisp-stdlib-prelude.el" lmm--root))
      (goto-char 1) (search-forward "(defun defvaralias ")
      (goto-char (match-beginning 0)) (setq form (read (current-buffer))))
    (cl-letf (((symbol-function 'nelisp--env-globals-op)
               (lambda (op &rest _)
                 (pcase op ('variable-alias-source-kind kind)
                   ('variable-alias-set (setq installed t)) (_ nil)))))
      (let ((fn (eval `(lambda ,(nth 2 form) ,@(cdddr form)) t)))
        (should-error (funcall fn new base)) (should-not installed)
        (setq kind 1) (should-error (funcall fn new base)) (should-not installed)
        (setq kind 0) (should (eq (funcall fn new base) base)) (should installed)))))
(ert-deftest localized-migration-common-symbol-does-not-call-carrier-decoder ()
  (cl-letf (((symbol-function 'nl_val_tag) (lambda (_) 7))
            ((symbol-function 'nl_cons_car_word) (lambda (_) 20006))
            ((symbol-function 'nelisp_symbol_key_equal) (lambda (a b) (if (= a b) 1 0)))
            ((symbol-function 'nl_sb_migrated_default_vector) (lambda (_) (error "Unexpected hot-path call"))))
    (should (= (funcall (lmm--function 'nl_capture_filter_contains nil nil) 30002 20006) 1))))
(provide 'nelisp-localized-migration-test)
