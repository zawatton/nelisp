;;; standalone-dense-keymap.el --- Real character table keymap controls -*- lexical-binding: t; -*-
(require 'nelisp-stdlib-sparse-keymap)
(nelisp-stdlib-sparse-keymap-install)
(let ((map (make-keymap)))
  (define-key map [97] 'dense-command)
  (unless (and (char-table-p (cadr map))
               (eq (aref (cadr map) 97) 'dense-command)
               (eq (lookup-key map "a") 'dense-command))
    (error "Dense character owner mismatch"))
  (define-key map [f5] 'dense-function)
  (unless (eq (lookup-key map [f5]) 'dense-function)
    (error "Dense noncharacter entry mismatch"))
  (let (refused)
    (condition-case nil (define-key map "ab" 'dense-nested)
      (error (setq refused t)))
    (unless (and refused (eq (lookup-key map "a") 'dense-command))
      (error "Dense nonprefix overwritten")))
  (define-key map "bc" 'dense-nested)
  (unless (and (keymapp (aref (cadr map) 98))
               (eq (lookup-key map "bc") 'dense-nested))
    (error "Dense prefix table mismatch"))
  (define-key map [97] nil)
  (unless (and (eq (aref (cadr map) 97) t) (null (lookup-key map [97])))
    (error "Dense explicit nil sentinel failed"))
  (define-key map [97] 'dense-command)
  (define-key map [97] nil t)
  (unless (null (lookup-key map [97])) (error "Dense remove failed")))
(let ((parent (make-keymap)) (child (make-keymap)))
  (define-key parent [97] 'dense-inherited)
  (set-keymap-parent child parent)
  (unless (eq (lookup-key child [97]) 'dense-inherited)
    (error "Dense parent missing"))
  (define-key child [97] 'dense-shadow)
  (unless (and (eq (lookup-key child [97]) 'dense-shadow)
               (eq (lookup-key parent [97]) 'dense-inherited))
    (error "Dense parent overwritten"))
  (define-key child [97] nil)
  (unless (null (lookup-key child [97])) (error "Dense nil did not shadow"))
  (define-key child [97] nil t)
  (unless (eq (lookup-key child [97]) 'dense-inherited)
    (error "Dense removed entry parent fallback missing")))
(let ((map (make-keymap)))
  (suppress-keymap map t)
  (unless (eq (lookup-key map [remap self-insert-command]) 'undefined)
    (error "Genuine suppress-keymap remap missing")))
(princ "DENSE-KEYMAP-PASS\n")
