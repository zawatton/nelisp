;;; standalone-native-alias-makunbound-driver.el -*- lexical-binding: t; -*-

(unless (fboundp 'nelisp--variable-alias-install)
  (error "The private diagnostic alias adapter is required"))

(defvar detach-base 40)
(defvar detach-alias 50)
(defvar detach-plain 31)
(defun detach-install-alias ()
  (nelisp--variable-alias-install 'detach-alias 'detach-base))
(unless (= (detach-install-alias) 0)
  (error "Alias installation failed"))
(fset 'detach-alias (lambda () 'alias-function))
(fset 'detach-base (lambda () 'base-function))
(put 'detach-alias 'identity-probe 'alias-plist)
(put 'detach-base 'identity-probe 'base-plist)

(let ((detach-base 77))
  (unless (eq (makunbound 'detach-alias) 'detach-alias)
    (error "makunbound returned the wrong symbol"))
  (when (boundp 'detach-alias)
    (error "makunbound did not unbind the alias"))
  (unless (= (symbol-value 'detach-base) 77)
    (error "makunbound changed the active base binding")))
(let ((caught (condition-case err
                  (progn (symbol-value 'detach-alias) nil)
                (void-variable err))))
  (unless (equal caught '(void-variable detach-alias))
    (error "Detached alias read did not signal void-variable(alias): %S" caught)))
(unless (eq (makunbound 'detach-alias) 'detach-alias)
  (error "Repeated makunbound returned the wrong symbol"))
(unless (and (not (boundp 'detach-alias))
             (= (symbol-value 'detach-base) 40))
  (error "Alias detach did not preserve the base global value"))
(setq detach-alias 88)
(unless (and (= (symbol-value 'detach-alias) 88)
             (= (symbol-value 'detach-base) 40))
  (error "Detached alias remained connected to its base"))
(unless (and (eq (funcall 'detach-alias) 'alias-function)
             (eq (funcall 'detach-base) 'base-function)
             (eq (get 'detach-alias 'identity-probe) 'alias-plist)
             (eq (get 'detach-base 'identity-probe) 'base-plist))
  (error "makunbound changed function or plist identity"))

(makunbound 'detach-plain)
(when (boundp 'detach-plain)
  (error "Nonalias makunbound did not preserve its existing behavior"))

(defconst detach-constant-target 63)
(defvar detach-constant-alias 64)
(defun detach-install-constant-alias ()
  (nelisp--variable-alias-install
   'detach-constant-alias 'detach-constant-target))
(unless (= (detach-install-constant-alias) 0)
  (error "Alias to constant target failed to install"))
(unless (eq (makunbound 'detach-constant-alias) 'detach-constant-alias)
  (error "makunbound of a defconst-target alias returned the wrong symbol"))
(let ((alias-bound (boundp 'detach-constant-alias))
      (target-value (symbol-value 'detach-constant-target)))
  (unless (and (not alias-bound) (= target-value 63))
    (error "Defconst-target alias detach changed state: alias-bound=%S target=%S"
           alias-bound target-value)))
(princ "NATIVE-ALIAS-MAKUNBOUND-PASS\n")
