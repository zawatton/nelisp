    (depth-let (let ((max-lisp-eval-depth 200)) (condition-case e (eval '(let ((a 1)) (let ((b 2)) (let ((c 3)) (list a b c)))) t) (error (car e)))))
    (depth-recursion (let ((max-lisp-eval-depth 100)) (condition-case e (funcall (lambda (f n) (funcall f f n)) (lambda (f n) (let ((m (1+ n))) (funcall f f m))) 0) (error (car e)))))
