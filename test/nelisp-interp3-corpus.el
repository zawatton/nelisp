    (let-value-vector (let ((v (vector 1 2 3))) (aset v 0 9) v))
    (let-value-string (let ((s "abc")) (concat s s)))
    (let-value-float (let ((x 1.5)) (+ x x)))
    (let-value-bignum (let ((x 2305843009213693951)) (+ x 1)))
    (let-body-value-pointer (let ((a (list 1 2)) (b (list 3))) (nconc a b)))
    ;; let: errors and constants
    (let-constant-nil (let ((nil 1)) nil))
