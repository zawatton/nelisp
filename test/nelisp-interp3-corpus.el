(defun i3c-run (case-)
  (let ((tag (car case-)) (form (cadr case-)))
    (condition-case e
        (princ (format "%S\n" (list tag (let ((r (eval form t))) (list 'ok r)))))
      (error (princ (format "%S\n" (list tag (list 'err e)))))
      (wrong-type-argument (princ (format "%S\n" (list tag (list 'err e))))))))

(dolist (c i3c-cases) (i3c-run c))

;; The same forms with the frames of an enclosing function around them, so a lookup
;; and a store meet more than one frame.
(defun i3c-in-function (form)
  (funcall (lambda (outer1 outer2)
             (let ((mid 3))
               (ignore outer1 outer2 mid)
               (eval form t)))
           1 2))
(dolist (c i3c-cases)
  (let ((tag (car c)) (form (cadr c)))
    ;; GNU Emacs 31.1 itself crashes on a setq of a keyword reached through a function frame.
    (unless (memq tag '(setq-keyword setq-keyword-self))
      (condition-case e
          (princ (format "%S\n" (list (list 'fn tag) (list 'ok (i3c-in-function form)))))
        (error (princ (format "%S\n" (list (list 'fn tag) (list 'err e)))))))))

;; Redefinition and advice of the builtins a `let' or `setq' form evaluates.
(dolist (name '(1+ car))
  (let ((saved (symbol-function name)) result)
    (unwind-protect
        (progn (fset name (lambda (&rest xs) (cons 'redefined (cons name xs))))
               (setq result (eval `(let ((a 1)) (setq a (,name a)) a) t)))
      (fset name saved))
    (princ (format "%S\n" (list (list 'redefined name) result)))))

(princ "I3-CORPUS COMPLETE\n")
(kill-emacs 0)
