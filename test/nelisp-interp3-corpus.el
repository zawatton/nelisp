;;; nelisp-interp3-corpus.el --- setq and let in the source interpreter -*- lexical-binding: t; -*-

;; interp3: every case enters EVAL with an unevaluated form.  The same file runs
;; unchanged on GNU Emacs and on NeLisp; the outputs must be byte-equal.  It covers
;; `let' of lexical and special variables (declared globally and locally), constants,
;; malformed binding lists, parallel binding, closures capturing the bound variables,
;; non-local exits through a `let', the dynamic-binding mode of `eval', variable
;; watchers, and `setq' of lexical, special and constant symbols, several pairs, the
;; value of the form, the order of evaluation and the store into a captured variable.
(defvar i3c-sp 10)
(defvar i3c-sp2 20)
(defvar i3c-unbound-before)
(defvar i3c-log nil)
(defun i3c-read-sp () i3c-sp)
(defun i3c-read-sp2 () i3c-sp2)
(defun i3c-note (x) (push x i3c-log) x)
(defmacro i3c-m (v) `(setq ,v (1+ ,v)))

(defconst i3c-cases
