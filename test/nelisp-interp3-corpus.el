    (setq-param-closure (funcall (lambda (a) (let ((f (lambda () a))) (setq a 6) (funcall f))) 4))
    (setq-error-in-value (let ((a 1)) (condition-case nil (setq a (car 1)) (error nil)) a))
    (setq-throw-in-value (let ((a 1)) (list (catch 'tag (setq a (throw 'tag 5))) a)))
    (setq-macro (let ((a 1)) (i3c-m a) (i3c-m a) a))
