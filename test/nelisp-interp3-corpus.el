    (setq-watched (progn (add-variable-watcher 'i3c-sp (lambda (&rest a) (push (list (nth 1 a) (nth 2 a)) i3c-log))) (setq i3c-log nil) (setq i3c-sp 6) (remove-variable-watcher 'i3c-sp (car (get-variable-watchers 'i3c-sp))) (nreverse i3c-log)))
