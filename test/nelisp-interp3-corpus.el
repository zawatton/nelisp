    (let-declared-during-values (let ((a (progn (defvar i3c-dv) 1)) (i3c-dv 2)) (list a (boundp 'i3c-dv))))
    (let-local-defvar-scope (let ((i3c-ld 1)) (defvar i3c-ld) (let ((i3c-ld 2)) (boundp 'i3c-ld))))
    (let-local-defvar-outer (progn (let ((i3c-ld2 1)) (defvar i3c-ld2) nil) (let ((i3c-ld2 2)) (boundp 'i3c-ld2))))
    (let-in-lambda-declared (funcall (lambda () (defvar i3c-ld3) (let ((i3c-ld3 4)) (boundp 'i3c-ld3)))))
    (let-in-lambda-plain (funcall (lambda (i3c-ld4) (let ((i3c-ld4 4)) i3c-ld4)) 3))
    (let-watched (progn (add-variable-watcher 'i3c-sp (lambda (&rest a) (push (list (nth 1 a) (nth 2 a)) i3c-log))) (setq i3c-log nil) (let ((i3c-sp 1)) nil) (remove-variable-watcher 'i3c-sp (car (get-variable-watchers 'i3c-sp))) (nreverse i3c-log)))
    ;; let: the dynamic-binding mode of eval
    (dyn-let (eval '(let ((i3c-dyn 1)) (symbol-value 'i3c-dyn)) nil))
    (dyn-let-restore (progn (eval '(let ((i3c-dyn2 1)) i3c-dyn2) nil) (boundp 'i3c-dyn2)))
