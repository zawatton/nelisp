    (let-shadow (let ((a 1)) (list (let ((a 2)) a) a)))
    (let-nested-deep (let ((a 1)) (let ((b 2)) (let ((c 3)) (let ((d 4)) (list a b c d))))))
    (let-value-form (let ((a (+ 1 2)) (b (list 1 2))) (list a b)))
    (let-value-sees-outer (let ((a 5)) (let ((a (1+ a)) (b (* a 2))) (list a b))))
    (let-closure (let ((a 1)) (let ((f (lambda () a))) (setq a 2) (funcall f))))
    (let-closure-set (let ((a 1)) (let ((f (lambda () (setq a (1+ a))))) (funcall f) (funcall f) a)))
    (let-closure-counter (let ((n 0)) (let ((f (lambda () (setq n (1+ n))))) (list (funcall f) (funcall f) (funcall f) n))))
