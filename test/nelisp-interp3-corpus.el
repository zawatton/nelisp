    ;; let: special variables
    (let-special (let ((i3c-sp 1)) (i3c-read-sp)))
    (let-special-restore (progn (let ((i3c-sp 1)) (i3c-read-sp)) i3c-sp))
    (let-special-mixed (let ((a 1) (i3c-sp 2)) (list a (i3c-read-sp))))
    (let-special-parallel (let ((i3c-sp 1) (i3c-sp2 i3c-sp)) (list (i3c-read-sp) (i3c-read-sp2))))
    (let-special-nested (let ((i3c-sp 1)) (let ((i3c-sp (1+ i3c-sp))) (i3c-read-sp))))
    (let-special-error-restores (progn (condition-case nil (let ((i3c-sp 99)) (car i3c-sp)) (error nil)) i3c-sp))
