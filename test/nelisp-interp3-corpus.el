    (dyn-lambda (eval '(let ((x 1)) (funcall (lambda () (boundp 'x)))) nil))
    ;; setq
    (setq-global (progn (setq i3c-sp 3) i3c-sp))
    (setq-value (setq i3c-sp 4))
    (setq-none (setq))
    (setq-two (setq i3c-sp 1 i3c-sp2 2))
    (setq-two-value (list (setq i3c-sp 1 i3c-sp2 2) i3c-sp i3c-sp2))
    (setq-order (progn (setq i3c-log nil) (setq i3c-sp (i3c-note 1) i3c-sp2 (i3c-note 2)) (nreverse i3c-log)))
    (setq-value-first (let ((a 1) (b 2)) (setq a b b a) (list a b)))
