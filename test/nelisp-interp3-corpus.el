    (let-body-error (let ((a 1)) (car a)))
    (let-error-pops-frame (progn (condition-case nil (let ((i3c-zz 1)) (car i3c-zz)) (error nil)) (boundp 'i3c-zz)))
    (let-error-restores-outer (let ((a 1)) (condition-case nil (let ((a 2)) (car a)) (error nil)) a))
