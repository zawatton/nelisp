    (setq-dotted-1 (setq . 5))
    (setq-new-global (progn (setq i3c-created 17) i3c-created))
    (setq-lexical (let ((a 1)) (setq a 2) a))
    (setq-lexical-value (let ((a 1)) (setq a 2)))
    (setq-lexical-pairs (let ((a 1) (b 2)) (setq a 10 b 20) (list a b)))
    (setq-lexical-first-of-many (let ((a 1) (b 2) (c 3) (d 4)) (setq a 5) (setq d 8) (list a b c d)))
    (setq-lexical-chain (let ((a 1) (b 2)) (setq a (setq b 5)) (list a b)))
    (setq-lexical-expr (let ((i 0)) (setq i (+ i 1)) (setq i (+ i 1)) i))
