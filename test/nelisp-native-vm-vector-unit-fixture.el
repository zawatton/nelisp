;;; -*- lexical-binding: t; -*-
;; Word-model fixture for wf_bytecode_vector_primitive (Baref/Baset).  The
;; operand stack is an array of 8-byte words (3afb0f0cc); a vector is a
;; compact backing (header kind | len<<8, then 8-byte element words) and its
;; word is backing|6.  An immediate fixnum is (n<<2)|1, nil 3, t 7.
(require 'cl-lib)
(load (expand-file-name "nelisp-aot-test-runtime.el" (file-name-directory load-file-name)) nil t t)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)
(defun av-def (name forms)
 (or (cl-find-if (lambda (f) (eq (cadr f) name)) forms) (error "Missing %S" name)))
(let* ((variant (or (getenv "AV_VARIANT") "positive"))
       (output (getenv "AV_OUTPUT")) (base #x37000000)
       (slots (+ base 256)) (vec (+ base 1024)) (arrw (+ vec 6))
       (boxed (+ base 3000)) (marker (+ base 2112)) (text (+ base 2200))
       (pools (append nelisp-standalone--applyfn-bytecode-helpers nelisp-standalone--applyfn-core-helpers nelisp-standalone--applyfn-bf-helpers))
       (helper (copy-tree (av-def 'wf_bytecode_vector_primitive pools)))
       (checks nil) (count 0))
 (cl-labels ((imm (n) (+ (* n 4) 1))
             (check (predicate) (push `(if ,predicate 0 (when (= failure 0) (setq failure ,(cl-incf count)))) checks))
             (emit (form) (push form checks))
             (elt-word (k) (imm (+ 100 k)))
             (setup (kind index-word len first)
                ;; MEM[0] array word, MEM[1] index word, MEM[2] a value operand.
                (emit `(ptr-write-u64 ,slots 0 ,arrw)) (emit `(ptr-write-u64 ,slots 8 ,index-word))
                (emit `(ptr-write-u64 ,slots 16 ,(imm 9)))
                (emit `(ptr-write-u64 ,vec 0 ,(+ kind (* len 256))))
                (dotimes (k len) (emit `(ptr-write-u64 ,vec ,(+ 8 (* k 8)) ,(if (= k 0) first (elt-word k)))))
                (emit `(ptr-write-u64 ,base 0 0)) (emit `(ptr-write-u64 ,base 8 0))))
  (pcase variant
   ("bad-bounds" (setq helper (cl-subst t '(and (>= i 0) (< i (vector-len arr))) helper :test #'equal)))
   ("bad-bridge" (setq helper (cl-subst t '(= (bf_nemacs_char_table_vector_p arr) 0) helper :test #'equal)))
   ;; The index must be a fixnum word.
   ("bad-index-tag" (setq helper (cl-subst nil '(/= (wf_bytecode_w_tag index) 2) helper :test #'equal)))
   ;; Baref answers the first element whatever the index.
   ("bad-read" (setq helper (cl-subst '(ptr-read-u64 data 0) '(ptr-read-u64 data (* i 8)) helper :test #'equal)))
   ;; Baset forgets to mark the heap dirty for the GC.
   ("bad-copy" (setq helper (cl-subst 0 '(wf_dirty) helper :test #'equal))))
  (emit `(ptr-write-u64 ,marker 0 4)) (emit `(ptr-write-u64 ,marker 8 19))
  (emit `(ptr-write-u64 ,marker 16 ,text)) (emit `(ptr-write-u64 ,marker 24 19))
  (dotimes (i 19) (emit `(ptr-write-u8 ,text ,i ,(aref "--nemacs-char-table" i))))
  ;; Baref: every element word comes back unchanged, with no allocation.
  (dolist (word (append (list 3 7)
                        (mapcar #'imm (list -2305843009213693952 -2 -1 0 1 2305843009213693951))
                        (list boxed)))
   (setup 8 (imm 0) 1 word)
   (check `(= (wf_bytecode_vector_primitive ,slots 2 72) 0))
   (check `(= (ptr-read-u64 ,slots 0) ,word))
   (check `(= (ptr-read-u64 ,slots 8) ,(imm 0)))
   (check `(= (ptr-read-u64 ,base 8) 0))
   (check `(= (ptr-read-u64 ,base 0) 0)))
  ;; Baref at every index of a longer vector.
  (dotimes (k 3)
   (setup 8 (imm k) 3 (imm 100))
   (check `(= (wf_bytecode_vector_primitive ,slots 2 72) 0))
   (check `(= (ptr-read-u64 ,slots 0) ,(elt-word k)))
   (check `(= (ptr-read-u64 ,base 0) 0)))
  ;; Rejections (kind index-word len) must neither mutate the array/result slot nor the epoch.
  (dolist (row `((8 ,(imm -1) 1) (8 ,(imm 1) 1) (8 ,(imm 0) 0) (5 ,(imm 0) 1) (8 7 5)))
   (dolist (op '(72 73))
    (setup (nth 0 row) (nth 1 row) (nth 2 row) 3)
    (check `(= (wf_bytecode_vector_primitive ,slots ,(if (= op 73) 3 2) ,op) 2))
    (check `(= (ptr-read-u64 ,slots 0) ,arrw))
    (check `(= (ptr-read-u64 ,slots 8) ,(nth 1 row)))
    (check `(= (ptr-read-u64 ,vec 8) 3))
    (check `(= (ptr-read-u64 ,base 8) 0))))
  ;; A seven-element vector headed by the char-table marker symbol goes to the bridge.
  (dolist (op '(72 73))
   (setup 8 (imm 0) 7 marker)
   (check `(= (wf_bytecode_vector_primitive ,slots ,(if (= op 73) 3 2) ,op) 2))
   (check `(= (ptr-read-u64 ,vec 8) ,marker))
   (check `(= (ptr-read-u64 ,base 8) 0)))
  ;; Baset stores the value word itself and answers it in the array's slot.
  (dolist (word (list 3 7 (imm -2) (imm 2305843009213693951) (imm 5)))
   (setup 8 (imm 1) 3 3)
   (emit `(ptr-write-u64 ,slots 16 ,word))
   (check `(= (wf_bytecode_vector_primitive ,slots 3 73) 0))
   (check `(= (ptr-read-u64 ,vec 16) ,word))
   (check `(= (ptr-read-u64 ,vec 8) 3))
   (check `(= (ptr-read-u64 ,slots 0) ,word))
   (check `(= (ptr-read-u64 ,slots 8) ,(imm 1)))
   (check `(= (ptr-read-u64 ,base 8) 1))
   (check `(= (ptr-read-u64 ,base 0) 0)))
  (let ((source `(seq
    (defun wf_dirty () (atomic-fetch-add ,(+ base 8) 1))
    (defun nl_alloc_bytes (size align) (let ((p (ptr-read-u64 ,base 16))) (seq (ptr-write-u64 ,base 16 (+ p size)) (ptr-write-u64 ,base 0 (+ (ptr-read-u64 ,base 0) 1)) (ptr-write-u64 ,base 40 (+ (ptr-read-u64 ,base 40) 1)) p)))
    ,helper
    (defun audit_run () (let ((failure 0)) (seq
       (syscall-direct 9 ,base 16777216 3 50 -1 0)
       (ptr-write-u64 ,base 16 ,(+ base 65536))
       ,@(nreverse checks)
       (ptr-write-u64 ,base 0 (ptr-read-u64 ,base 40))
       (ptr-write-u64 ,base 24 failure)
       (syscall-direct 1 1 ,base 32 0 0 0) failure)))
    (defun _start () (syscall-direct 60 (audit_run) 0 0 0 0 0)))))
   (let ((inhibit-message t)) (nelisp-aot-test-runtime-link-units output "array-audit.o" source (list (nelisp-standalone--arena-base-slot-unit)) "_start"))
   (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
   (princ (format "ARRAY-UNIT-COMPILED variant=%s checks=%d\n" variant count)))))
