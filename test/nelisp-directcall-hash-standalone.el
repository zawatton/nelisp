;;; nelisp-directcall-hash-standalone.el --- GNU hash call parity -*- lexical-binding: t; -*-

(defvar ndh-checks 0)
(defvar ndh-failures 0)
(defvar ndh-events 0)
(defvar ndh-advice-table nil)
(defun ndh-check (name value)
  (setq ndh-checks (1+ ndh-checks))
  (unless value (setq ndh-failures (1+ ndh-failures)))
  (princ (format "DIRECTCALL-HASH %s %s\n" name (if value "PASS" "FAIL"))))
(defun ndh-condition (thunk) (condition-case e (funcall thunk) (error e)))
(fset 'ndh-bc0 #[257 "\211 \207" [] 2])
(fset 'ndh-bc1 #[514 "\1\1!\207" [] 4])
(fset 'ndh-bc2 #[771 "\2\2\2\"\207" [] 6])
(fset 'ndh-bc3 #[1028 "\3\3\3\3#\207" [] 8])

(dolist (test '(eq eql equal))
  (let ((h (make-hash-table :test test :size 1)))
    (ndh-check (list test 'insert) (eq (ndh-bc3 'puthash 'key 'value h) 'value))
    (ndh-check (list test 'get) (eq (ndh-bc2 'gethash 'key h) 'value))
    (ndh-check (list test 'default) (eq (ndh-bc3 'gethash 'missing h 'default) 'default))
    (ndh-check (list test 'absent) (null (ndh-bc2 'gethash 'missing h)))
    (ndh-bc3 'puthash 'key nil h)
    (ndh-check (list test 'nil-value) (null (ndh-bc3 'gethash 'key h 'default)))
    (ndh-check (list test 'count) (= (ndh-bc1 'hash-table-count h) 1))
    (ndh-check (list test 'remove) (null (ndh-bc2 'remhash 'key h)))
    (ndh-check (list test 'remove-miss) (null (ndh-bc2 'remhash 'key h)))
    (ndh-check (list test 'empty) (= (ndh-bc1 'hash-table-count h) 0))))

(let ((h (make-hash-table)))
  (puthash 'key 'value h)
  (ndh-check 'object (eq (ndh-bc2 (symbol-function 'gethash) 'key h) 'value))
  (ndh-check 'funcall (eq (funcall 'gethash 'key h) 'value))
  (ndh-check 'apply (eq (apply 'gethash 'key (list h 'default)) 'value))
  (ndh-check 'bc-funcall (eq (ndh-bc3 'funcall 'gethash 'key h) 'value))
  (ndh-check 'bc-apply (eq (ndh-bc3 'apply 'gethash 'key (list h)) 'value)))

;; Warm the same bytecode site, replace the cell, alias it, then restore it.
(let ((saved (symbol-function 'gethash)) (h (make-hash-table)))
  (unwind-protect
      (progn
        (ndh-bc2 'gethash 'key h)
        (fset 'gethash (lambda (&rest _) 'replacement))
        (ndh-check 'redefinition (eq (ndh-bc2 'gethash 'key h) 'replacement))
        (fset 'ndh-alias (lambda (&rest _) 'alias))
        (defalias 'gethash 'ndh-alias)
        (ndh-check 'defalias (eq (ndh-bc2 'gethash 'key h) 'alias))
        (fset 'gethash (symbol-function 'cons))
        (ndh-check 'other-subr (equal (ndh-bc2 'gethash 1 2) '(1 . 2))))
    (fset 'gethash saved))
  (ndh-check 'restored (null (ndh-bc2 'gethash 'key h))))

;; Load the real GNU advice provider, including on the standalone engine.
(if (equal (getenv "DIRECTCALL_ENGINE") "gnu")
    (require 'nadvice)
  (add-to-list 'load-path (expand-file-name "lisp" (getenv "DIRECTCALL_ROOT")))
  (require 'nelisp-nadvice-substrate))
(ndh-check 'real-advice-provider (featurep 'nadvice))
(defun ndh-before (_key table &rest _)
  (when (eq table ndh-advice-table) (setq ndh-events (1+ ndh-events))))
(defun ndh-around (old &rest args)
  ;; The standalone's Lisp library also uses gethash internally. Keep its
  ;; unrelated metadata tables intact while exercising real advice dispatch.
  (if (eq (cadr args) ndh-advice-table)
      (list 'advised (apply old args))
    (apply old args)))
(let* ((h (make-hash-table)) (ndh-advice-table h))
  (puthash 'key 'value h)
  (unwind-protect
      (progn
        (advice-add 'gethash :before #'ndh-before)
        (advice-add 'gethash :around #'ndh-around)
        (ndh-check 'advice (equal (ndh-bc2 'gethash 'key h) '(advised value)))
        (ndh-check 'advice-once (= ndh-events 1)))
    (advice-remove 'gethash #'ndh-before)
    (advice-remove 'gethash #'ndh-around))
  (ndh-check 'advice-restored (eq (ndh-bc2 'gethash 'key h) 'value)))

(define-hash-table-test 'ndh-custom #'equal #'sxhash-equal)
(let ((h (make-hash-table :test 'ndh-custom :size 1)))
  (ndh-check 'custom-put (= (ndh-bc3 'puthash (list 1 2) 17 h) 17))
  (ndh-check 'custom-get (= (ndh-bc2 'gethash (list 1 2) h) 17))
  (ndh-check 'custom-rem (null (ndh-bc2 'remhash (list 1 2) h)))
  (ndh-check 'custom-count (= (ndh-bc1 'hash-table-count h) 0)))

(dolist (weak '(nil key value key-or-value key-and-value))
  (let ((h (make-hash-table :test 'eq :weakness weak :size 1))
        (key (list 'key)) (value (list 'value)))
    (ndh-bc3 'puthash key value h)
    (garbage-collect)
    (ndh-check (list 'weak weak) (eq (ndh-bc2 'gethash key h) value))
    (ndh-bc2 'remhash key h)
    (ndh-check (list 'weak-empty weak) (= (hash-table-count h) 0))))

;; Growth uses native allocations while argv and the selected function stay live.
(let ((h (make-hash-table :test 'equal :size 1)) (keys (make-vector 4096 nil)))
  (dotimes (i 4096)
    (let ((key (list i)) (value (list 'value i)))
      (aset keys i key)
      (unless (eq (ndh-bc3 'puthash key value h) value) (error "Put return identity"))))
  (garbage-collect)
  (let ((ok t))
    (dotimes (i 4096)
      (unless (equal (ndh-bc2 'gethash (aref keys i) h) (list 'value i)) (setq ok nil)))
    (ndh-check 'growth-roots ok))
  (ndh-check 'growth-count (= (ndh-bc1 'hash-table-count h) 4096)))
(let ((h (make-hash-table :test 'eq)) (key (list 1)))
  (ndh-bc3 'puthash key 'value h)
  (setcar key 2)
  (ndh-check 'mutated-identity-key (eq (ndh-bc2 'gethash key h) 'value))
  (ndh-bc2 'remhash key h)
  (ndh-check 'mutated-key-remove (= (hash-table-count h) 0)))

(dolist (spec '((gethash 2) (puthash 3) (remhash 2) (hash-table-count 1)))
  (let* ((name (car spec)) (argc (cadr spec))
         (args (if (eq name 'puthash) '(key value 17)
                 (if (= argc 1) '(17) '(key 17)))))
    (ndh-check (list 'wrong-type name)
               (equal (ndh-condition (lambda () (apply name args)))
                      '(wrong-type-argument hash-table-p 17)))
    (ndh-check (list 'arity name)
               (equal (ndh-condition (lambda () (ndh-bc0 name)))
                      (list 'wrong-number-of-arguments (symbol-function name) 0)))))
(ndh-check 'source-arity-before-effects
           (let ((ndh-events 0))
             (and (equal (ndh-condition (lambda () (eval '(gethash (setq ndh-events 1)))))
                         '(wrong-number-of-arguments gethash 1))
                  (= ndh-events 0))))
(princ (format "DIRECTCALL-HASH DONE checked=%d failed=%d\n" ndh-checks ndh-failures))
(kill-emacs (if (= ndh-failures 0) 0 1))
