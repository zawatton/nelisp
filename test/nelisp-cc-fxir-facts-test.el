(require 'ert)
(require 'cl-lib)
(require 'nelisp-cc-fxir-facts)
(defvar nelisp-cc-fxir-native-windows nil)
(let ((nelisp-cc-fxir-native-windows t)) (require 'nelisp-cc-fxir-native))
(require 'nelisp-cc-fxir-inline)

(defun nff-row (body &optional callees)
  (list 'fixture 201 2 callees (list :fn body) '(1 1 -1)))

(ert-deftest nff-constants-and-target-boundaries ()
  (let ((min nelisp-cc-fxir-facts--min) (max nelisp-cc-fxir-facts--max))
    (dolist (v (list min max 4294967296 -4294967296))
      (should (= 1 (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:const 1)) (vector 1 v)) :result))))
    (dolist (v (list (1- min) (1+ max) 1.5 "heap"))
      (should (= 8 (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:const 1)) (vector 1 v)) :result))))
    (should (= 2 (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:const 1)) (vector 1 nil)) :result)))
    (should (= 4 (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:const 1)) (vector 1 t)) :result)))
    (should (= 15 (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:const 1))) :result)))))

(ert-deftest nff-reassignment-and-join ()
  (let* ((row (nff-row '(:seq (:setslot 1 (:nil))
                              (:if (:slot 0) (:setslot 1 (:const 1)) (:setslot 1 (:nil)))
                              (:slot 1))))
         (code [1 12]) (result (nelisp-cc-fxir-facts-analyze row code)))
    (should (plist-get result :valid))
    (should (= 3 (plist-get result :result)))
    (should (equal (plist-get result :joins)
                   '((((1 2) 1) (:inputs ((1 (:assignment (1 2 2) 1))
                                          (2 (:assignment (1 2 3) 1)))
                                  :result (3 (:join (1 2) 1)))))))
    (should (nelisp-cc-fxir-facts-verify row code result))
    (let ((bad (copy-tree result)))
      (setcar (cdar (plist-get bad :joins)) :mutated-join)
      (should-not (nelisp-cc-fxir-facts-verify row code bad)))
    (let ((bad (copy-tree result)))
      (setcar (cdar (plist-get bad :facts)) :mutated-slot)
      (should-not (nelisp-cc-fxir-facts-verify row code bad)))
    (let ((bad (copy-tree result)))
      (setcar (cdar (plist-get bad :boundaries)) :payload)
      (should-not (nelisp-cc-fxir-facts-verify row code bad)))))

(ert-deftest nff-loops-and-boundaries ()
  (let* ((row (nff-row '(:seq (:setslot 1 (:nil))
                              (:while (:slot 0) (:setslot 1 (:const 1)))
                              (:slot 1))))
         (result (nelisp-cc-fxir-facts-analyze row [1 12])))
    (should (plist-get result :valid))
    (should (= 15 (plist-get result :result)))
    (should (assoc '(:poll (1 2)) (plist-get result :boundaries)))
    (should (equal result (nelisp-cc-fxir-facts-analyze row [1 12])))
    (let* ((nelisp-cc-fxir-facts--loop-iterations 1)
           (widened (nelisp-cc-fxir-facts-analyze row [1 12]))
           (exit (cadr (assoc '(1 3) (plist-get widened :facts)))))
      (should (= 15 (plist-get exit :type)))
      (should (equal (cadr (nth 1 (plist-get exit :slots))) '(:widen (1 2) 1)))))
  (let* ((row (nff-row '(:seq (:call 1 1 (:slot 0)) (:inline 7 5 (:slot 0))) '(foo)))
         (result (nelisp-cc-fxir-facts-analyze row)))
    (should (plist-get result :valid))
    (should (assoc '(:call (1 1)) (plist-get result :boundaries)))
    (should (assoc '(:signal (1 2)) (plist-get result :boundaries)))
    (should (assoc '(:exit) (plist-get result :boundaries)))
    (should (= 15 (plist-get result :result)))))

(ert-deftest nff-conversion-and-refusal ()
  (should (nelisp-cc-fxir-facts-conversion-valid-p 1 :word :payload))
  (should (nelisp-cc-fxir-facts-conversion-valid-p 1 :payload :word t))
  (should-not (nelisp-cc-fxir-facts-conversion-valid-p 3 :word :payload))
  (should-not (nelisp-cc-fxir-facts-conversion-valid-p 1 :payload :payload t))
  (should-not (nelisp-cc-fxir-facts-conversion-valid-p 1 :condition :word t))
  (should-not (nelisp-cc-fxir-facts-conversion-valid-p 1 :word :address))
  (should-not (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:slot 5))) :valid))
  (should (equal (plist-get (nelisp-cc-fxir-facts-analyze (nff-row '(:prog1 (:nil)))) :refusal)
                 '(:unsupported :prog1 (1)))))

(ert-deftest nff-add-region-actual-ast-and-mutations ()
  (let* ((row '(nested 22222 2 nil (:fn (:inline 4 11 (:inline 4 7 (:slot 0) (:slot 1)) (:const 9))) (2 2 -1)))
         (site 10006)
         (baseline (nelisp-cc-fxir-inline-form row site 2 '(20001 1) :addition))
         (candidate (nelisp-cc-fxir-inline-form row site 2 '(20001 1) :addition t))
         (saved (copy-tree (list row site baseline candidate)))
         (x 'ni_20001_1_14_x) (y 'ni_20001_1_15_y)
         (sum 'ni_20001_1_16_sum) (next 'ni_20001_1_17_next)
         (live 'ni_20001_1_11_livecode) (base 'ni_20001_1_12_codebase)
         (site-local 'ni_20001_1_2_site) (code 'ni_20001_1_27_code)
         (top 'ni_20001_1_46_top) (slot 'ni_20001_1_49_slot)
         (view 'ni_20001_1_51_view) (entry-next 'ni_20001_1_48_next)
         (stk 'ni_20001_1_3_stk) (rtop 'ni_20001_1_13_rtop))
    (should (nelisp-cc-fxir-facts-verify-add-region row site baseline candidate))
    (should (equal saved (list row site baseline candidate)))
    (dolist (change `(((= (logand ,x 3) 1) . 1)
                      ((= (logand ,y 3) 1) . 1)
                      ((and (/= ,rtop 0)
                            (<= (+ ,rtop 128) (+ (data-addr nl_rootstack_region) 4194304))
                            (= (logand ,x 3) 1) (= (logand ,y 3) 1))
                       . (and (= (logand ,x 3) 1) (= (logand ,y 3) 1)))
                      ((= (sar (shl ,sum 2) 2) ,sum) . 1)
                      ((= (sar (shl ,next 2) 2) ,next) . 1)
                      ((<= (+ ,rtop 128) (+ (data-addr nl_rootstack_region) 4194304)) . 1)
                      ((= (nl_vector_slot_word ,live 9) 5) . 1)
                      ((= (logand ,live 7) 6) . 1)
                      ((= (logand (ptr-read-u8 (- ,live 6) 0) 63) 8) . 1)
                      ((= (sar (ptr-read-u64 (- ,live 6) 0) 8) 14) . 1)
                      ((+ ,live 2) . (+ ,live 10))
                      ((logxor (ptr-read-u64 ,base 72) 5) . 0)
                      ((ptr-read-u64 (+ ,site-local 2) 0) . (ptr-read-u64 (+ ,site-local 2) 8))
                      ((ptr-read-u64 (+ ,site-local 2) 24) . (ptr-read-u64 (+ ,site-local 2) 0))
                      ((ptr-read-u64 (+ ,code 10) 0) . (ptr-read-u64 (+ ,code 18) 0))
                      ((,code (ptr-read-u64 (+ ni_20001_1_7_rec 2) 0)) . (,code ,live))
                      ((= ni_20001_1_40_st 0) . 1)
                      ((ptr-write-u64 ,top 0 1464226381) . 0)
                      ((ptr-write-u64 ,slot 16 3) . 0)
                      ((ptr-write-u64 ,view 24 0) . 0)
                      ((ptr-write-u64 (data-addr nl_rootstack_top) 0 ,entry-next) . 0)
                      ((nc_enter ni_20001_1_1_env 7) . 0)
                      ((ptr-read-u64 ,stk 0) . (ptr-read-u64 (+ ,stk 8) 0))
                      ((+ mem 24) . (+ mem 32))
                      ((+ (shl ,next 2) 1) . (+ (shl ,sum 2) 1))
                      ((+ (shl ,next 2) 1) . ,next)))
      (let ((mutant (cl-subst (cdr change) (car change) candidate :test #'equal)))
        (should-not (equal mutant candidate))
        (should-not (nelisp-cc-fxir-facts-verify-add-region row site baseline mutant))))
    (should-not (nelisp-cc-fxir-facts-verify-add-region row 10007 baseline candidate))
    (let ((bad-row (copy-tree row)))
      (setcar (cdr bad-row) 22223)
      (should-not (nelisp-cc-fxir-facts-verify-add-region bad-row site baseline candidate)))
    (let ((bad-row (cl-subst '(:slot 0) '(:slot 1) row :test #'equal)))
      (should-not (nelisp-cc-fxir-facts-verify-add-region bad-row site baseline candidate)))
    (should-not (nelisp-cc-fxir-facts-verify-add-region row site
                  (cl-subst 0 `(= (logand ,x 3) 1) baseline :test #'equal) candidate))
    (let* ((after (copy-tree candidate))
           (binding (nth 1 (nth 1 after))))
      (setcar (cdr binding) 10007)
      (should-not (nelisp-cc-fxir-facts-verify-add-region row site baseline after)))
    (let* ((after (copy-tree candidate))
           (wout-binding (nth 4 (nth 1 after))))
      (setcar (cdr wout-binding) 0)
      (should-not (nelisp-cc-fxir-facts-verify-add-region row site baseline after)))
    (should (equal saved (list row site baseline candidate)))
    ;; A previous success is not a reusable certificate for a modified tree.
    (setcar (cdr (nth 1 (nth 1 candidate))) 10007)
    (should-not (nelisp-cc-fxir-facts-verify-add-region row site baseline candidate))))

(ert-deftest nff-add-region-other-site-and-row ()
  (let* ((row '(another 16384 2 nil (:fn (:inline 4 11 (:inline 4 7 (:slot 0) (:slot 1)) (:const 9))) (2 2 -1)))
         (site '(+ mem 80))
         (baseline (nelisp-cc-fxir-inline-form row site 2 '(99 7 2) :addition))
         (candidate (nelisp-cc-fxir-inline-form row site 2 '(99 7 2) :addition t)))
    (should (nelisp-cc-fxir-facts-verify-add-region row site baseline candidate))
    (should-not (nelisp-cc-fxir-facts-verify-add-region row '(+ mem 88) baseline candidate))))

(provide 'nelisp-cc-fxir-facts-test)
