;;; nelisp-aot-offset-tree-test.el --- Load-only let chains -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-offset-tree-test--ref (n)
  (nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp))
(defun nelisp-aot-offset-tree-test--imm (n)
  (nelisp-aot-compiler--make-ir 'imm :value n))
(defun nelisp-aot-offset-tree-test--add (a b)
  (nelisp-aot-compiler--make-ir 'arith :op '+ :a a :b b))
(defun nelisp-aot-offset-tree-test--let (slot value body)
  (nelisp-aot-compiler--make-ir 'let-rt :slot slot :value-ir value :body body))
(defun nelisp-aot-offset-tree-test--run (program)
  (let ((path (make-temp-file "offset-tree-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp program path) (call-process path nil nil nil))
      (delete-file path))))
(defun nelisp-aot-offset-tree-test--wrap (n)
  (let ((v (logand n (1- (ash 1 64)))))
    (if (>= v (ash 1 63)) (- v (ash 1 64)) v)))
(ert-deftest nelisp-aot-offset-tree/chain-preflight ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (p (nelisp-aot-offset-tree-test--ref 0)) (i (nelisp-aot-offset-tree-test--ref 1))
         (value (nelisp-aot-offset-tree-test--add i (nelisp-aot-offset-tree-test--imm 1)))
         (load (nelisp-aot-compiler--make-ir 'ptr-read-u64
                :ptr (nelisp-aot-offset-tree-test--ref 2) :offset (nelisp-aot-offset-tree-test--ref 3)))
         (inner (nelisp-aot-offset-tree-test--let 3 value load))
         (node (nelisp-aot-offset-tree-test--let 2 p inner)))
    (should (nelisp-aot-compiler--x86-forward-load-offset node))
    (should (equal (cons 1 t) (nelisp-aot-compiler--x86-memory-tree-info node)))
    (dolist (bad (list
                  ;; Dead binding, multiple uses, self/future references.
                  (nelisp-aot-compiler--ir-with node :body
                   (nelisp-aot-compiler--ir-with inner :body (nelisp-aot-compiler--ir-with load :ptr p)))
                  (nelisp-aot-compiler--ir-with node :body
                   (nelisp-aot-compiler--ir-with inner :value-ir (nelisp-aot-offset-tree-test--ref 2)))
                  (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-offset-tree-test--ref 2))
                  (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-offset-tree-test--ref 3))
                  (nelisp-aot-compiler--ir-with node :root-p t)
                  (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-compiler--ir-with p :root-p t))
                  (nelisp-aot-compiler--ir-with node :value-ir (nelisp-aot-compiler--ir-with p :class 'f64))
                  (nelisp-aot-compiler--ir-with node :value-ir
                   (nelisp-aot-compiler--make-ir 'ptr-read-u64 :ptr p :offset i))
                  (nelisp-aot-compiler--ir-with node :value-ir
                   (nelisp-aot-compiler--make-ir 'call :name 'effect :args nil))
                  (nelisp-aot-compiler--ir-with node :body
                   (nelisp-aot-compiler--make-ir 'value-seq :forms (list inner)))
                  (nelisp-aot-compiler--ir-with node :body
                   (nelisp-aot-compiler--ir-with inner :value-ir
                    (nelisp-aot-offset-tree-test--imm 1099511627776)))))
      (should-not (nelisp-aot-compiler--x86-forward-load-offset bad))
      (should-not (nelisp-aot-compiler--x86-memory-tree-info bad)))
    (dolist (mode '(checked lisp frame scratch))
      (let ((nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (nelisp-aot-compiler--runtime-entry-params (and (eq mode 'lisp) '(x)))
            (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p (eq mode 'frame))
            (nelisp-aot-compiler--promoted-slots (and (eq mode 'scratch) '((0 . r10)))))
        (should-not (nelisp-aot-compiler--x86-memory-tree-info node))))))
(ert-deftest nelisp-aot-offset-tree/fullword-and-live-siblings ()
  "Four balanced load chains exercise RAX/R10/R11 without reordering reads."
  (let ((emit (symbol-function 'nelisp-aot-compiler--emit-memory-tree-x86))
        (destinations nil) (cases 0))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-memory-tree-x86)
               (lambda (node buf registers)
                 (when (eq (nelisp-aot-compiler--ir-kind node) 'let-rt)
                   (push (car registers) destinations))
                 (funcall emit node buf registers))))
      (dolist (width '(8 16 32 64))
        (dolist (value '(1311768467139281697 -81985529216486896))
          (let* ((read-op (intern (format "ptr-read-u%d" width)))
                 (write-op (intern (format "ptr-write-u%d" width)))
                 (words (cl-loop for k below 4 collect (+ value (* k 4294967311))))
                 (golden (nelisp-aot-offset-tree-test--wrap
                          (cl-loop for v in words sum (logand v (1- (ash 1 width))))))
                 (loads (cl-loop for k below 4 collect
                                 `(let ((base p))
                                    (let ((index (+ (* i 8) ,(* k 8))))
                                      (,read-op base index))))))
            (should (= 0 (nelisp-aot-offset-tree-test--run
                          `(seq (defun opaque (x) (+ x 17))
                                (defun f (p i) (opaque 0)
                                  (+ (+ ,(nth 0 loads) ,(nth 1 loads))
                                     (+ ,(nth 2 loads) ,(nth 3 loads))))
                                (defun run ()
                                  (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                                    ,@(cl-loop for v in words for k from 0
                                               collect `(,write-op p ,(* k 8) ,v))
                                    (if (= (f (+ p 8) -1) ,golden) 0 1)))
                                (exit (run))))))
            (setq cases (1+ cases))))))
    (dolist (reg '(rax r10 r11)) (should (memq reg destinations)))
    (message "Load-chain fullword cases:%d; live sibling destinations:RAX/R10/R11" cases)))
(ert-deftest nelisp-aot-offset-tree/effect-and-capture-fallback ()
  (should (= 0 (nelisp-aot-offset-tree-test--run
                 '(seq (defun opaque (x) (+ x 17))
                       (defun f (p) (opaque 0)
                         (+ (ptr-read-u64 p 0)
                            (let ((base p))
                              (let ((index (seq (ptr-write-u64 p 0 9) 0)))
                                (ptr-read-u64 base index)))))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u64 p 0 5) (if (= (f p) 14) 0 1)))
                       (exit (run))))))
  (should (= 0 (nelisp-aot-offset-tree-test--run
                 '(seq (defun opaque (x) (+ x 17))
                       (defun f (p q) (opaque 0)
                         (let ((base p))
                           (let ((index (seq (setq p q) 0)))
                             (ptr-read-u64 base index))))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u64 p 0 5) (ptr-write-u64 p 8 9)
                           (if (= (f p (+ p 8)) 5) 0 1)))
                       (exit (run)))))))
(provide 'nelisp-aot-offset-tree-test)
