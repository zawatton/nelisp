;;; bytecode-word-corpus-src.el --- GNU bytecode equality corpus source -*- lexical-binding: t -*-

;; Not loaded by NeLisp.  `test/bytecode-word-corpus-gen.el' byte-compiles
;; every `defun' below with host GNU Emacs, calls each case, and writes the
;; compiled functions together with GNU's answers to
;; `test/bytecode-word-corpus.eld', which
;; `test/standalone-bytecode-word-check.el' replays on NeLisp.
;;
;; The functions cover the opcodes the native bytecode interpreter has word
;; fast paths for (stack-ref/set, varref/varset/varbind, constants,
;; fixnum arithmetic and comparison with generic fallback, branches,
;; car/cdr/cons/eq/not/null, calls) and the paths around them that must
;; keep GNU semantics: non-fixnum operands, overflow into bignums, floats,
;; markers of wrong type, handlers, unwinding and dynamic binding.

(defvar bwc-dyn 10)
(defvar bwc-dyn2 'outer)
(defvar bwc-log nil)

(defun bwc-loop (n) (let ((i 0)) (while (< i n) (setq i (1+ i))) i))
;; No arguments and fixnums only: the shape the whole-function fixnum
;; fast path (wf_bytecode_fixnum_fast) takes.
(defun bwc-fixloop0 () (let ((i 0) (s 0)) (while (< i 100) (setq s (+ s i) i (1+ i))) s))
(defun bwc-sum (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s i) i (1+ i))) s))
(defun bwc-add3 (a b c) (+ a (+ b c)))
(defun bwc-sub (a b) (- a b))
(defun bwc-mul (a b) (* a b))
(defun bwc-div (a b) (/ a b))
(defun bwc-rem (a b) (% a b))
(defun bwc-neg (a) (- a))
(defun bwc-cmp (a b) (list (< a b) (> a b) (<= a b) (>= a b) (= a b) (eq a b) (eql a b) (equal a b)))
(defun bwc-1+ (a) (list (1+ a) (1- a)))
(defun bwc-max (a b c) (list (max a b c) (min a b c)))
(defun bwc-car (x) (list (car x) (cdr x) (car-safe x) (cdr-safe x)))
(defun bwc-cons (a b) (cons a (cons b nil)))
(defun bwc-list (a b c) (list a b c (list a) (list a b c a)))
(defun bwc-not (x) (list (not x) (null x) (consp x) (atom x) (listp x) (symbolp x) (stringp x) (integerp x) (numberp x)))
(defun bwc-eq (a b) (if (eq a b) 'same 'diff))
(defun bwc-nth (n l) (list (nth n l) (nthcdr n l) (elt l n)))
(defun bwc-length (x) (length x))
(defun bwc-memq (x l) (list (memq x l) (member x l) (assq x l) (rassq x l)))
(defun bwc-aref (v i) (aref v i))
(defun bwc-aset (v i x) (aset v i x) v)
(defun bwc-setcar (l x) (setcar l x) (setcdr (cdr l) (list x)) l)
(defun bwc-nconc (a b) (nconc (copy-sequence a) b))
(defun bwc-reverse (l) (list (reverse l) (nreverse (copy-sequence l))))
(defun bwc-concat (a b) (concat a "-" b))
(defun bwc-substring (s a b) (substring s a b))
(defun bwc-string= (a b) (list (string= a b) (string< a b)))
(defun bwc-upcase (s) (upcase s))
(defun bwc-number-to-string (n) (number-to-string n))
(defun bwc-optional (a &optional b c) (list a b c))
(defun bwc-rest (a &rest r) (list a r (length r)))
(defun bwc-opt-rest (a &optional b &rest r) (list a b r))
(defun bwc-dolist (l) (let ((acc nil)) (dolist (x l) (push (* x x) acc)) (nreverse acc)))
(defun bwc-dotimes (n) (let ((acc 0)) (dotimes (i n) (setq acc (+ acc (* i i)))) acc))
(defun bwc-mapcar (l) (mapcar (lambda (x) (* 2 x)) l))
(defun bwc-closure (k) (let ((f (lambda (x) (+ x k)))) (mapcar f '(1 2 3))))
(defun bwc-counter () (let ((n 0)) (list (lambda () (setq n (1+ n))) (lambda () n))))
(defun bwc-use-counter () (let* ((c (bwc-counter)) (inc (car c)) (get (cadr c)))
                            (funcall inc) (funcall inc) (funcall inc) (funcall get)))
(defun bwc-fact (n) (if (< n 2) 1 (* n (bwc-fact (1- n)))))
(defun bwc-fib (n) (if (< n 2) n (+ (bwc-fib (- n 1)) (bwc-fib (- n 2)))))
(defun bwc-cond (x) (cond ((eq x 'a) 1) ((eq x 'b) 2) ((eq x 'c) 3) ((eq x 'd) 4) ((eq x 'e) 5) (t 0)))
(defun bwc-pcase (x) (pcase x ('one 1) ('two 2) ("str" 'string) (3 'three) (_ 'other)))
(defun bwc-and-or (a b) (list (and a b) (or a b) (and a (not b)) (or (not a) b)))
(defun bwc-when (x) (when (> x 0) (setq x (* x 10)) (list x)))
(defun bwc-catch (x) (catch 'bwc-tag (when (> x 5) (throw 'bwc-tag 'thrown)) 'normal))
(defun bwc-catch-deep (n) (catch 'bwc-tag (bwc-thrower n)))
(defun bwc-thrower (n) (if (< n 1) (throw 'bwc-tag 'bottom) (list (bwc-thrower (1- n)))))
(defun bwc-condcase (x) (condition-case e (/ 10 x) (arith-error (list 'caught (car e)))))
(defun bwc-condcase-car (x) (condition-case e (car x) (wrong-type-argument (list 'wta (cadr e)))))
(defun bwc-unwind (x) (let ((log nil))
                        (list (catch 'bwc-tag
                                (unwind-protect (if x (throw 'bwc-tag 'out) 'in)
                                  (push 'cleanup log)))
                              log)))
(defun bwc-dynread () bwc-dyn)
(defun bwc-dynlet (v) (let ((bwc-dyn v)) (bwc-dynread)))
(defun bwc-dynlet-after (v) (list (let ((bwc-dyn v)) (bwc-dynread)) bwc-dyn))
(defun bwc-dynset (v) (let ((bwc-dyn 0)) (setq bwc-dyn v) (list bwc-dyn (bwc-dynread))))
(defun bwc-dynlet-throw (v) (list (catch 'bwc-tag (let ((bwc-dyn v)) (throw 'bwc-tag (bwc-dynread)))) bwc-dyn))
(defun bwc-dynlet-signal (v) (list (condition-case nil (let ((bwc-dyn v)) (car bwc-dyn)) (error bwc-dyn)) bwc-dyn))
(defun bwc-dynlet2 (a b) (let ((bwc-dyn a) (bwc-dyn2 b)) (list bwc-dyn bwc-dyn2 (bwc-dynread))))
(defun bwc-dynlet-par (a) (let ((bwc-dyn a) (bwc-dyn2 bwc-dyn)) (list bwc-dyn bwc-dyn2)))
(defun bwc-push-log (x) (push x bwc-log) (prog1 bwc-log (setq bwc-log nil)))
(defun bwc-bignum (a) (list (* a a a) (+ a most-positive-fixnum) (- most-negative-fixnum a) (1+ most-positive-fixnum) (1- most-negative-fixnum)))
(defun bwc-float (a b) (list (+ a b) (* a b) (- a b) (/ a b) (< a b) (= a b)))
(defun bwc-wta-plus (a) (condition-case e (+ a 1) (wrong-type-argument (car e))))
(defun bwc-wta-1+ (a) (condition-case e (1+ a) (wrong-type-argument (car e))))
(defun bwc-wta-lt (a) (condition-case e (< a 1) (wrong-type-argument (car e))))
(defun bwc-string-build (n) (let ((s "")) (dotimes (i n) (setq s (concat s (number-to-string i)))) s))
(defun bwc-assoc (k al) (cdr (assoc k al)))
(defun bwc-plist (p k) (plist-get p k))
(defun bwc-vector (n) (let ((v (make-vector n 0))) (dotimes (i n) (aset v i (* i i))) v))
(defun bwc-apply (f &rest args) (apply f args))
(defun bwc-funcall2 (f a b) (funcall f a b))
(defun bwc-let* (a) (let* ((b (* a 2)) (c (+ b 1)) (d (list a b c))) (cons c d)))
(defun bwc-many-locals (a b c d e f g h) (let ((i (+ a h)) (j (+ b g)) (k (+ c f)) (l (+ d e))) (list i j k l (+ i j k l))))
(defun bwc-while-list (l) (let ((n 0)) (while l (setq n (+ n (car l)) l (cdr l))) n))
(defun bwc-string-match (s) (when (string-match "\\`\\(.*\\)\\(\\.el\\)\\'" s) (list (match-string 1 s) (match-string 2 s))))
(defun bwc-temp-buffer (s) (with-temp-buffer (insert s) (goto-char (point-min)) (forward-char 2) (list (point) (buffer-string) (char-after))))
(defun bwc-char (s i) (let ((c (aref s i))) (list c (char-to-string c) (= c ?a))))
(defun bwc-eq-ints (a) (list (eq a 5) (eq a a) (memq a '(1 5 9))))
(defun bwc-stack-heavy (a b) (list (list a b) (list b a) (cons (list a) (list b)) (vector a b a b)))
(defun bwc-ignore-errors (x) (ignore-errors (car x)))
(defun bwc-nested-cc (x) (condition-case e1 (condition-case e2 (if (eq x 'inner) (signal 'arith-error nil) (error "outer %s" x)) (arith-error (list 'inner-caught (car e2)))) (error (list 'outer-caught (cadr e1)))))
(defun bwc-symbol-value (s) (symbol-value s))
(defun bwc-set (s v) (set s v) (symbol-value s))
(defun bwc-intern (s) (eq (intern s) 'bwc-sym))
(defun bwc-number-seq (n) (number-sequence 1 n))
(defun bwc-sort (l) (sort (copy-sequence l) #'<))
(defun bwc-hash (n) (let ((h (make-hash-table :test 'equal))) (dotimes (i n) (puthash (format "k%d" i) i h)) (list (gethash "k3" h) (hash-table-count h))))
(defun bwc-format (a b) (format "%s=%S;%d" a b (length (list a b))))
;; Bget runs Fget on the symbol's plist (bytecode.c Bget, fns.c Fget).
(defun bwc-get-put (v)
  (put 'bwc-prop-sym 'bwc-key v)
  (list (get 'bwc-prop-sym 'bwc-key) (get 'bwc-prop-sym 'bwc-missing) (get nil 'bwc-key)))
(defun bwc-get-wta (x) (condition-case e (get x 'bwc-key) (wrong-type-argument (car e))))

;; Each case: (FUNCTION ARGUMENTS...).  Answers are compared as `%S' text;
;; a signal compares as (error ERROR-SYMBOL).
;; Exits carry their values to the handler (GNU internal_catch reads
;; handlerlist->val, eval.c:1399; signal_or_quit's Fcons (error_symbol,
;; data), eval.c:1952): thrown values of several types, nested catches,
;; cleanups on the way out, no-catch, and an error raised in a cleanup.
(defvar bwc-cleanup nil)
(defun bwc-exits ()
  (setq bwc-cleanup nil)
  (list (catch 'bwc-k (throw 'bwc-k 42))
        (catch 'bwc-k (throw 'bwc-k "str"))
        (catch 'bwc-k (throw 'bwc-k (list 1 2 3)))
        (catch 'bwc-k (throw 'bwc-k nil))
        (catch 'bwc-k (catch 'bwc-j (throw 'bwc-k 'outer)))
        (catch 'bwc-k (unwind-protect (throw 'bwc-k 'through) (setq bwc-cleanup 'ran)))
        bwc-cleanup
        (condition-case e (throw 'bwc-nobody 9) (no-catch (list 'no-catch e)))
        (condition-case e (unwind-protect (car 1) (setq bwc-cleanup 'ran2)) (error e))
        bwc-cleanup
        (condition-case e (condition-case nil (car 1) (arith-error 'wrong))
          (wrong-type-argument (list 'outer e)))
        (condition-case e (signal 'wrong-type-argument (list 1 (list 2)))
          (wrong-type-argument (cdr e)))
        (catch 'bwc-k (condition-case nil (throw 'bwc-k 'not-an-error) (error 'caught)))
        (condition-case e (catch 'bwc-k (unwind-protect (throw 'bwc-k 1) (car 'x)))
          (wrong-type-argument (list 'cleanup-error e)))))

;; The same exits with a collection while the exit is pending: a cleanup
;; collects with a thrown value pending, after a signal raised and caught
;; inside it replaced the pending exit.
(defun bwc-exit-churn (n)
  (catch 'bwc-k
    (unwind-protect (throw 'bwc-k (list n (make-string 3 ?q) (cons n n)))
      (condition-case nil (car 1) (error nil))
      (garbage-collect)
      (let ((junk nil) (i 0))
        (while (< i 2000) (setq junk (cons (make-string 7 ?z) junk) i (1+ i))))
      (garbage-collect))))
(defun bwc-handler-churn (n)
  (condition-case e (signal 'wrong-type-argument (list (list n (make-string 2 ?w))))
    (wrong-type-argument
     (garbage-collect)
     (let ((junk nil) (i 0))
       (while (< i 2000) (setq junk (cons (make-string 7 ?z) junk) i (1+ i))))
     (garbage-collect)
     (cadr e))))

(defconst bwc-cases
  '((bwc-loop 0) (bwc-loop 1000) (bwc-fixloop0) (bwc-sum 100) (bwc-add3 1 2 3) (bwc-add3 1.5 2 3)
    (bwc-sub 10 3) (bwc-sub 1 2.5) (bwc-mul 6 7) (bwc-mul 3037000500 3037000500)
    (bwc-div 7 2) (bwc-div -7 2) (bwc-div 7.0 2) (bwc-div 7 0) (bwc-rem 7 3) (bwc-rem -7 3)
    (bwc-neg 5) (bwc-neg -2.5)
    (bwc-cmp 1 2) (bwc-cmp 2 2) (bwc-cmp 2.0 2) (bwc-cmp 3 1.5)
    (bwc-1+ 5) (bwc-1+ 2.5) (bwc-1+ 2305843009213693951) (bwc-1+ -2305843009213693952)
    (bwc-max 3 9 1) (bwc-max 1 2.0 0)
    (bwc-car (1 . 2)) (bwc-car nil) (bwc-car 5) (bwc-cons a b) (bwc-list 1 "x" sym)
    (bwc-not nil) (bwc-not t) (bwc-not 3) (bwc-not "s") (bwc-not (1)) (bwc-not 1.5)
    (bwc-eq a a) (bwc-eq a b) (bwc-eq 3 3) (bwc-eq "s" "s")
    (bwc-nth 1 (a b c)) (bwc-nth 5 (a b c)) (bwc-length (1 2 3)) (bwc-length "abcd") (bwc-length [1 2])
    (bwc-length 5)
    (bwc-memq b (a b c)) (bwc-memq z ((z . 1))) (bwc-aref [1 2 3] 1) (bwc-aref "abc" 2) (bwc-aref [1] 5)
    (bwc-aset [1 2 3] 0 x) (bwc-setcar (1 2 3) z) (bwc-nconc (1 2) (3)) (bwc-reverse (1 2 3))
    (bwc-concat "ab" "cd") (bwc-substring "hello" 1 3) (bwc-string= "a" "b") (bwc-string= "a" "a")
    (bwc-upcase "abc") (bwc-number-to-string 42) (bwc-number-to-string 1.5)
    (bwc-optional 1) (bwc-optional 1 2) (bwc-optional 1 2 3) (bwc-optional) (bwc-optional 1 2 3 4)
    (bwc-rest 1) (bwc-rest 1 2 3) (bwc-opt-rest 1) (bwc-opt-rest 1 2 3 4)
    (bwc-dolist (1 2 3)) (bwc-dotimes 10) (bwc-mapcar (1 2 3)) (bwc-closure 10) (bwc-use-counter)
    (bwc-fact 10) (bwc-fact 25) (bwc-fib 15)
    (bwc-cond a) (bwc-cond e) (bwc-cond z) (bwc-pcase one) (bwc-pcase "str") (bwc-pcase 3) (bwc-pcase 4)
    (bwc-and-or t nil) (bwc-and-or 1 2) (bwc-when 3) (bwc-when -3)
    (bwc-catch 1) (bwc-catch 9) (bwc-catch-deep 5) (bwc-condcase 0) (bwc-condcase 5) (bwc-condcase-car 7)
    (bwc-unwind nil) (bwc-unwind t)
    (bwc-dynread) (bwc-dynlet 5) (bwc-dynlet-after 6) (bwc-dynset 7) (bwc-dynlet-throw 8)
    (bwc-dynlet-signal 9) (bwc-dynlet2 1 2) (bwc-dynlet-par 3) (bwc-push-log x)
    (bwc-bignum 3000000000) (bwc-bignum 7) (bwc-float 1.5 0.5) (bwc-float 1 2.0)
    (bwc-wta-plus x) (bwc-wta-1+ "s") (bwc-wta-lt nil)
    (bwc-string-build 12) (bwc-assoc "b" (("a" . 1) ("b" . 2))) (bwc-plist (:a 1 :b 2) :b)
    (bwc-vector 6) (bwc-apply + 1 2 3) (bwc-apply list) (bwc-funcall2 cons 1 2) (bwc-let* 4)
    (bwc-many-locals 1 2 3 4 5 6 7 8) (bwc-while-list (1 2 3 4))
    (bwc-string-match "some-library.el") (bwc-string-match "nope")
    (bwc-temp-buffer "hello") (bwc-char "abc" 0) (bwc-eq-ints 5) (bwc-eq-ints 6) (bwc-stack-heavy 1 x)
    (bwc-ignore-errors 5) (bwc-ignore-errors (q)) (bwc-nested-cc inner) (bwc-nested-cc outer)
    (bwc-symbol-value bwc-dyn) (bwc-set bwc-dyn2 changed) (bwc-intern "bwc-sym") (bwc-number-seq 5)
    (bwc-sort (3 1 2)) (bwc-hash 10) (bwc-format x "y")
    (bwc-get-put 42) (bwc-get-put (a b)) (bwc-get-wta 5) (bwc-get-wta "s")
    (bwc-exits) (bwc-exit-churn 4) (bwc-handler-churn 5)))

