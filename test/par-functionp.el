;;; -*- lexical-binding: t; -*-
;; functionp (F416).  Spec = GNU 31.1 eval.c FUNCTIONP (par-functionp.gnu): a symbol is followed through
;; indirect-function (macro cons, special form, unbound, loop-free chain); a (closure ...) list, a
;; (macro . _) cons and an autoload object reached directly are NOT functions; an autoload object reached through a
;; symbol is one only when its type slot is nil.  Timing row lives in par-functionp-time.el.
(defmacro fp-m (x) x)
(defun fp-f (x) x)
(defalias 'fp-al 'fp-f)
(defalias 'fp-mal 'fp-m)
(fset 'fp-mcons (cons 'macro (lambda (x) x)))
(fset 'fp-au1 '(autoload "f" nil nil nil))
(fset 'fp-au2 '(autoload "f" nil nil macro))
(fset 'fp-au3 '(autoload "f" nil nil t))
(fset 'fp-au4 '(autoload "f" nil nil keymap))
(fset 'fp-lm '(lambda (x) x))
(fset 'fp-cl '(closure (t) (x) x))
(fset 'fp-sf (symbol-function 'if))
(setq fp-lex (let ((y 1)) (lambda (x) (+ x y))))
(defmacro row (n f) `(princ (format "%-34s %S\n" ,n (condition-case e ,f (error (list 'ERR (car e)))))))
(row "F1 subr car" (functionp 'car))
(row "F2 macro when" (functionp 'when))
(row "F3 special form if" (functionp 'if))
(row "F4 defmacro" (functionp 'fp-m))
(row "F5 defun" (functionp 'fp-f))
(row "F6 alias to defun" (functionp 'fp-al))
(row "F7 alias to macro" (functionp 'fp-mal))
(row "F8 symbol with (macro . f)" (functionp 'fp-mcons))
(row "F9 unbound symbol" (functionp 'fp-unbound-xyz))
(row "F10 nil" (functionp nil))
(row "F11 t" (functionp t))
(row "F12 keyword" (functionp :kw))
(row "F13 subr object car" (functionp (symbol-function 'car)))
(row "F14 subr object if" (functionp (symbol-function 'if)))
(row "F15 macro object when" (functionp (symbol-function 'when)))
(row "F16 (lambda (x) x) list" (functionp '(lambda (x) x)))
(row "F17 (closure ...) list" (functionp '(closure (t) (x) x)))
(row "F18 (lambda) list" (functionp '(lambda)))
(row "F19 (macro . car) cons" (functionp '(macro . car)))
(row "F20 other lists" (list (functionp '(foo)) (functionp '(1 . 2)) (functionp '(autoload "f" nil nil nil))))
(row "F21 non-functions" (list (functionp 1) (functionp 1.5) (functionp "s") (functionp [1]) (functionp ?a)))
(row "F22 lambda closure object" (functionp (lambda (x) x)))
(row "F23 lexical closure object" (functionp fp-lex))
(row "F24 #'fp-f" (functionp #'fp-f))
(row "F25 byte-code object" (functionp (make-byte-code 0 "" [] 0)))
(row "F26 symbol bound to a value" (progn (setq fp-val 5) (functionp 'fp-val)))
(row "F27 defun macro special" (list (functionp 'defun) (functionp 'save-excursion) (functionp 'cond) (functionp 'funcall)))
(row "F28 symbol -> (lambda)" (functionp 'fp-lm))
(row "F29 symbol -> (closure) list" (functionp 'fp-cl))
(row "F30 symbol -> special subr" (functionp 'fp-sf))
(row "F31 autoload type nil" (functionp 'fp-au1))
(row "F32 autoload type macro/t/keymap" (list (functionp 'fp-au2) (functionp 'fp-au3) (functionp 'fp-au4)))
(row "F33 closure through a mapcar" (mapcar #'functionp (list fp-lex 'car 'when "x" nil)))
