;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun literal-test--node (kind &rest fields) (apply #'nelisp-aot-compiler--make-ir kind fields))
(ert-deftest literal-branch/real-structured-admission-and-guards ()
  (let* ((subject (literal-test--node 'if :test (literal-test--node 'ref :slot 0)
                                     :then (literal-test--node 'imm :value 2)
                                     :else (literal-test--node 'extern-call :name 'unknown :args nil)))
         (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--lisp-internal-entry-names nil))
    (dolist (literal '(1 2 -1 3 2147483647 -2147483648))
      (dolist (swap '(nil t))
        (dolist (op '(= /=))
          (let* ((value (literal-test--node 'imm :value literal))
                 (test (literal-test--node 'cmp :op op :a (if swap value subject) :b (if swap subject value))))
            (should (nelisp-aot-compiler--x86-literal-branch-plan test))))))
    (let ((test (literal-test--node 'cmp :op '= :a subject :b (literal-test--node 'imm :value 2))))
      (let ((nelisp-aot-compiler--abi 'win64)) (should-not (nelisp-aot-compiler--x86-literal-branch-plan test)))
      (let ((nelisp-aot-compiler--checked-arith t)) (should-not (nelisp-aot-compiler--x86-literal-branch-plan test)))
      (let ((nelisp-aot-compiler--runtime-entry-params t)) (should-not (nelisp-aot-compiler--x86-literal-branch-plan test))))
    (dolist (literal '(2147483648 -2147483649))
      (should-not (nelisp-aot-compiler--x86-literal-branch-plan
                   (literal-test--node 'cmp :op '= :a subject :b (literal-test--node 'imm :value literal)))))))

(ert-deftest literal-branch/typed-boundary-budget-and-value-refusals ()
  (let* ((subject (literal-test--node 'if :test (literal-test--node 'ref :slot 0)
                                     :then (literal-test--node 'imm :value 2)
                                     :else (literal-test--node 'imm :value -1)))
         (cmp (lambda (s) (literal-test--node 'cmp :op '= :a s :b (literal-test--node 'imm :value 2)))))
    (dolist (repr '(word sexp-ptr f64 unknown))
      (should-not (nelisp-aot-compiler--x86-literal-branch-plan
                   (funcall cmp (vconcat subject (vector :repr repr))))))
    (dolist (kind '(logic let-rt value-seq))
      (should-not (nelisp-aot-compiler--x86-literal-branch-plan
                   (funcall cmp (literal-test--node kind :root-p t)))))
    (let ((nelisp-aot-compiler--x86-trace-loop-exits (list (cons subject 'boundary))))
      (should-not (nelisp-aot-compiler--x86-literal-branch-plan (funcall cmp subject))))
    (dotimes (_ 300) (setq subject (literal-test--node 'if :test (literal-test--node 'imm :value 1)
                                                        :then subject :else (literal-test--node 'imm :value 2))))
    (should-not (nelisp-aot-compiler--x86-literal-branch-plan (funcall cmp subject)))))


(ert-deftest literal-branch/result-position-only-benefit ()
  (let* ((pred (literal-test--node 'if :test (literal-test--node 'ref :slot 0)
                                  :then (literal-test--node 'imm :value 1)
                                  :else (literal-test--node 'imm :value 0)))
         (subject (literal-test--node 'if :test pred
                                     :then (literal-test--node 'ref :slot 1)
                                     :else (literal-test--node 'ref :slot 2))))
    (should-not (nelisp-aot-compiler--x86-literal-branch-tree-p subject))))
(ert-deftest literal-branch/raw64-normalization-oracle ()
  (should (= -1 (nelisp-aot-compiler--x86-wrap-i64 18446744073709551615)))
  (should (= -9223372036854775808
             (nelisp-aot-compiler--x86-wrap-i64 9223372036854775808))))
(ert-deftest literal-branch/saved-actual-sites ()
  (skip-unless (and (file-exists-p "target/fxir-effects/real-site/site-ir.el")
                    (file-exists-p "../resume-4943-20261024/target/fxir-effects/transport-design/parsed.txt")))
  (let ((site (with-temp-buffer
                (insert-file-contents "target/fxir-effects/real-site/site-ir.el")
                (read (current-buffer)))))
    (should (nelisp-aot-compiler--x86-literal-branch-plan (plist-get site :test))))
  (let* ((data (with-temp-buffer
                 (insert-file-contents "../resume-4943-20261024/target/fxir-effects/transport-design/parsed.txt")
                 (read (current-buffer))))
         (test nil))
    (nelisp-aot-compiler--walk-ir
     (plist-get data :ir)
     (lambda (node)
       (when (and (eq (nelisp-aot-compiler--ir-kind node) 'defun)
                  (eq (nelisp-aot-compiler--ir-get node :name) 'transport_witness))
         (setq test (nelisp-aot-compiler--ir-get node :body)))))
    (should (nelisp-aot-compiler--x86-literal-branch-plan test))))
(ert-deftest literal-branch/canonical-full-tag-positive ()
  (skip-unless (file-exists-p "target/fxir-effects/canonical-bound/full-tag.el"))
  (let ((tag (with-temp-buffer
               (insert-file-contents "target/fxir-effects/canonical-bound/full-tag.el")
               (read (current-buffer)))))
    (should (nelisp-aot-compiler--x86-literal-branch-plan tag))))
(ert-deftest literal-branch/canonical-occurrence-and-structure-limits ()
  (let ((dag (literal-test--node 'imm :value 1)))
    (dotimes (_ 7) (setq dag (literal-test--node 'arith :op '+ :a dag :b dag)))
    (should (nelisp-aot-compiler--x86-literal-branch-bounded-p dag))
    (should (nelisp-aot-compiler--x86-literal-branch-bounded-p
             (literal-test--node 'call :args (list dag))))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p
                 (literal-test--node 'call :args (list (literal-test--node 'call :args (list dag))))))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p
                 (literal-test--node 'arith :op '+ :a dag :b dag))))
  (let ((slots (make-vector 64 nil)))
    (aset slots 0 'imm)
    (should (nelisp-aot-compiler--x86-literal-branch-bounded-p slots))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p (vconcat slots [nil]))))
  (let ((chain nil))
    (dotimes (_ 128) (setq chain (cons nil chain)))
    (should (nelisp-aot-compiler--x86-literal-branch-bounded-p chain))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p (cons nil chain))))
  (let ((tree nil))
    (dotimes (_ 13) (setq tree (cons tree tree)))
    (should (nelisp-aot-compiler--x86-literal-branch-bounded-p tree))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p
                 (cons nil tree)))))
(ert-deftest literal-branch/canonical-cycles-opaque-and-state ()
  (let* ((v (literal-test--node 'imm :value nil)) (c (cons v nil)))
    (aset v 2 c)
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p v))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--x86-zero-branch-gp-p)
               (lambda (&rest _) (error "Recursive proof must not see a cycle"))))
      (should-not (nelisp-aot-compiler--x86-literal-branch-plan
                   (literal-test--node 'cmp :op '= :a v :b (literal-test--node 'imm :value 1)))))
    (setcdr c c)
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p c)))
  (let ((c (cons nil nil)))
    (setcar c c)
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p c)))
  (dolist (opaque (list [unknown-kind] [] [nil] (make-hash-table)
                        (make-bool-vector 3 nil) (make-char-table nil) 1.5))
    (should-not (nelisp-aot-compiler--x86-literal-branch-bounded-p opaque)))
  (should (nelisp-aot-compiler--x86-literal-branch-bounded-p
           (literal-test--node 'imm :value 1))))
(provide 'nelisp-aot-literal-branch-test)

