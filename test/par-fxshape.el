;;; -*- lexical-binding: t; -*-
;; fx shape variants (F396): one body under several env/formals shapes, both warmed, then called alternately.
;; Spec = GNU 31.1 (par-fxshape.gnu); identical with fx on and off.  VM coverage (timing) is in par-fxshape-cov.el.
(defmacro row (n f) `(princ (format "%-26s %S\n" ,n (condition-case e ,f (error (list 'ERR (car e)))))))
(defun fs-rd (s) (if (boundp s) (symbol-value s) 'unbound))
(defun fs-vw (c) (delq t (copy-sequence (aref c 2))))
(defun fs-alt (form e1 e2 reader &rest args)
  "Closures of FORM under E1 and E2, both warmed 300x, then called A B A B."
  (let ((a (eval form e1)) (b (eval form e2)))
    (dotimes (_ 300) (apply a args))
    (dotimes (_ 300) (apply b args))
    (list (funcall reader (apply a args)) (funcall reader (apply b args))
          (funcall reader (apply a args)) (funcall reader (apply b args)))))
(defun fs-id (x) x)
;; E1 / E1r / E2: declared marker decides dynamic vs lexical let
(row "E1 let" (fs-alt '(lambda () (let ((fs-m 9)) (fs-rd 'fs-m))) '(fs-m t) '(t) #'fs-id))
(row "E1r let reversed" (fs-alt '(lambda () (let ((fs-m 9)) (fs-rd 'fs-m))) '(t) '(fs-m t) #'fs-id))
(row "E2 let*" (fs-alt '(lambda () (let* ((fs-m2 1) (fs-x 2)) (list fs-x (fs-rd 'fs-m2)))) '(fs-m2 t) '(t) #'fs-id))
;; E3 / O1 / O2: nested lambda bakes the outer env (order and duplicates)
(row "E3 view" (fs-alt '(lambda () (lambda () 1)) '(fs-k1 t) '(fs-k2 fs-k3 t) #'fs-vw))
(row "O1 order only view" (fs-alt '(lambda () (lambda () 1)) '(fs-o1 fs-o2 t) '(fs-o2 fs-o1 t) #'fs-vw))
(row "O2 dup marker view" (fs-alt '(lambda () (lambda () 1)) '(fs-o1 t) '(fs-o1 fs-o1 t) #'fs-vw))
;; E4 inner closure inherits specialness through the baked env
(row "E4 inner let" (fs-alt '(lambda () (funcall (lambda () (let ((fs-m4 4)) (fs-rd 'fs-m4))))) '(fs-m4 t) '(t) #'fs-id))
;; F1 / F2b: formals order and arity
(row "F1 formals swapped" (let ((tail '((list a b)))) (let ((f1 (eval `(lambda (a b) ,@tail) t)) (f2 (eval `(lambda (b a) ,@tail) t)))
  (dotimes (_ 300) (funcall f1 1 2)) (dotimes (_ 300) (funcall f2 1 2))
  (list (funcall f1 1 2) (funcall f2 1 2) (funcall f1 1 2) (funcall f2 1 2)))))
(row "F2b arity &rest" (let ((tail '((list a b)))) (let ((f1 (eval `(lambda (a b) ,@tail) t)) (f2 (eval `(lambda (a &rest b) ,@tail) t)))
  (dotimes (_ 300) (funcall f1 1 2)) (dotimes (_ 300) (funcall f2 1 2))
  (list (funcall f1 1 2) (funcall f2 1 2) (funcall f1 1 2) (funcall f2 1 2)))))
;; mapcar and a VM caller reach the variants too
(row "M1 mapcar" (let* ((form '(lambda (_) (let ((fs-mm 9)) (fs-rd 'fs-mm)))) (a (eval form '(fs-mm t))) (b (eval form '(t))))
  (dotimes (_ 300) (funcall a 0)) (dotimes (_ 300) (funcall b 0))
  (list (mapcar a '(1 2)) (mapcar b '(1 2)) (mapcar a '(1 2)) (mapcar b '(1 2)))))
(defun fs-caller (f) (let ((s 0)) (dotimes (_ 3) (setq s (+ s 0))) (funcall f)))
(row "V1 from VM code" (let* ((form '(lambda () (let ((fs-v 9)) (fs-rd 'fs-v)))) (a (eval form '(fs-v t))) (b (eval form '(t))))
  (dotimes (_ 300) (fs-caller a)) (dotimes (_ 300) (fs-caller b))
  (list (fs-caller a) (fs-caller b) (fs-caller a) (fs-caller b))))
;; cap+1: six shapes of one body (head + 3 variants + 2 beyond the cap), all correct
(row "CAP 6 shapes" (let* ((form '(lambda () (list (fs-rd 'fs-q1) (let ((fs-q1 7)) (fs-rd 'fs-q1)))))
                           (envs (list '(t) '(fs-q1 t) '(fs-z1 t) '(fs-z1 fs-q1 t) '(fs-q1 fs-z1 t) '(fs-q1 fs-q1 t)))
                           (fns (mapcar (lambda (e) (eval form e)) envs)) (out nil))
                      (dolist (f fns) (dotimes (_ 100) (funcall f)))
                      (dolist (f fns) (push (funcall f) out))
                      (dolist (f (reverse fns)) (push (funcall f) out))
                      (nreverse out)))
;; redefine with two live variants
(row "RV redefine two variants" (let* ((form '(lambda () (let ((fs-rv 9)) (fs-rd 'fs-rv))))
                                       (ca (eval form '(fs-rv t))) (cb (eval form '(t))) (cc (eval form '(fs-rv fs-rz t))) out)
                                  (defalias 'fs-rvf ca)
                                  (dotimes (_ 300) (fs-rvf)) (dotimes (_ 300) (funcall cb))
                                  (push (list (fs-rvf) (funcall cb) (funcall ca)) out)
                                  (defalias 'fs-rvf cc)
                                  (push (list (fs-rvf) (funcall cb) (funcall ca) (funcall cc)) out)
                                  (dotimes (_ 300) (fs-rvf))
                                  (defalias 'fs-rvf cb)
                                  (push (list (fs-rvf) (funcall cb) (funcall ca) (funcall cc)) out)
                                  (nreverse out)))
;; a defvar loop: 50 distinct marker envs over one body, correct and bounded
(defun fs-loop-env (i) (if (= (% i 2) 0) (list (intern (format "fs-lp%d" i)) 'fs-lpx t) (list (intern (format "fs-lp%d" i)) t)))
(defun fs-loop-time (form lo hi)
  (let ((s (float-time)))
    (let ((i lo)) (while (< i hi) (let ((f (eval form (fs-loop-env i)))) (dotimes (_ 200) (funcall f))) (setq i (1+ i))))
    (- (float-time) s)))
(row "LP 50 envs results" (let ((form '(lambda () (let ((fs-lpx 5)) (list (fs-rd 'fs-lpx))))) (out nil))
                            (dotimes (i 50) (let ((f (eval form (fs-loop-env i)))) (dotimes (_ 100) (funcall f)) (push (funcall f) out)))
                            (nreverse out)))
(row "LP bounded time" (let* ((form '(lambda () (let ((fs-lpx 5)) (list (fs-rd 'fs-lpx)))))
                              (t1 (fs-loop-time form 0 10)) (t2 (fs-loop-time form 10 20)) (t3 (fs-loop-time form 20 30))
                              (t4 (fs-loop-time form 30 40)) (t5 (fs-loop-time form 40 50)))
                         (< (/ t5 (max t1 1e-6)) 3.0)))
