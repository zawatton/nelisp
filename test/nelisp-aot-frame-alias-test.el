(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)

(defvar nelisp-aot-frame-alias-test--selected 0)
(defvar nelisp-aot-frame-alias-test--owner nil)
(defvar nelisp-aot-frame-alias-test--layout nil)
(defvar nelisp-aot-frame-alias-test--functions nil)
(defvar nelisp-aot-frame-alias-test--nested 0)
(defvar nelisp-aot-frame-alias-test--forced-disabled nil)
(defconst nelisp-aot-frame-alias-test--source
  '(seq (defun fa_tick (p x) (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) x)))
        (defun fa_main (p x) (let* ((source x) (copy source)) (seq (fa_tick p 1) (+ copy copy))))))
(defmacro nelisp-aot-frame-alias-test--with (source &rest body)
  (declare (indent 1))
  `(let* ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
          (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
          (nelisp-aot-compiler--os 'linux) (nelisp-aot-compiler--checked-arith nil)
          (nelisp-aot-compiler--value-abi 'raw)
          (nelisp-aot-compiler--x86-frame-copy-aliases t)
          (defs (nelisp-aot-compiler--collect-defuns (nelisp-aot-compiler--parse ,source)))
          (owner (cl-find 'fa_main defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name))))
          (nelisp-aot-compiler--x86-frame-alias-definitions (nelisp-aot-compiler--x86-frame-alias-definitions defs))
          (nelisp-aot-compiler--x86-frame-alias-proof-cache nil)
          (nelisp-aot-compiler--x86-frame-alias-owner-state (nelisp-aot-compiler--x86-frame-alias-owner-proof owner))
          (nelisp-aot-compiler--promoted-slots nil) (nelisp-aot-compiler--x86-frame-read-aliases nil))
     ,@body))
(defun nelisp-aot-frame-alias-test--copies (owner)
  (let (nodes)
    (nelisp-aot-compiler--walk-ir
     (nelisp-aot-compiler--ir-get owner :body)
     (lambda (n) (when (and (eq (nelisp-aot-compiler--ir-kind n) 'let-rt)
                           (eq (nelisp-aot-compiler--ir-kind (nelisp-aot-compiler--ir-get n :value-ir)) 'ref)) (push n nodes))))
    nodes))

(ert-deftest nelisp-aot-frame-alias/closed-owner-and-boundaries ()
  (nelisp-aot-frame-alias-test--with nelisp-aot-frame-alias-test--source
    (should nelisp-aot-compiler--x86-frame-alias-owner-state)
    (should (= 2 (length (nelisp-aot-frame-alias-test--copies owner))))
    (dolist (copy (nelisp-aot-frame-alias-test--copies owner))
      (should (integerp (nelisp-aot-compiler--x86-frame-copy-source copy))))
    (dolist (kind '(addr-of aot-current-sp alloc-bytes aot-gc-root-scope native-assembly unknown))
      (let* ((bad (nelisp-aot-compiler--ir-with owner :body (nelisp-aot-compiler--make-ir kind))))
        (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof bad))))
    (dolist (field '(:gc-root-slots :internal-hidden :variadic :rest-p :self-tco-raw :unknown-boundary))
      (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof (nelisp-aot-compiler--ir-with owner field '(1)))))
    (let* ((tick (car defs)) (bad (nelisp-aot-compiler--ir-with tick :body (nelisp-aot-compiler--make-ir 'aot-current-sp)))
           (nelisp-aot-compiler--x86-frame-alias-definitions (nelisp-aot-compiler--x86-frame-alias-definitions (list bad owner))))
      (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner)))
    (dolist (field '(:param-repr :return-repr))
      (dolist (value '(f64 word sexp-ptr hidden-root bogus))
        (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof
                     (nelisp-aot-compiler--ir-with owner field value)))))
    (let ((copy (car (nelisp-aot-frame-alias-test--copies owner))))
      (dolist (annotation '((:class . f64) (:cls . f64) (:repr . f64) (:repr . sexp-ptr)
                            (:repr . hidden-root) (:varargs-p . t) (:unknown-metadata . gp)))
        (let* ((value (nelisp-aot-compiler--ir-with (nelisp-aot-compiler--ir-get copy :value-ir)
                                                   (car annotation) (cdr annotation)))
               (bad (nelisp-aot-compiler--ir-with owner :body
                       (nelisp-aot-compiler--ir-with copy :value-ir value))))
          (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof bad))))
      (dolist (repr '(unknown raw-i64 raw-ptr raw-bool))
        (should (nelisp-aot-compiler--x86-frame-alias-gp-p
                 (nelisp-aot-compiler--ir-with (nelisp-aot-compiler--ir-get copy :value-ir) :repr repr)))))
    (dolist (abi '(win64 unknown))
      (let ((nelisp-aot-compiler--abi abi)) (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner))))
    (let ((nelisp-aot-compiler--arch 'aarch64)) (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner)))
    (let ((nelisp-aot-compiler--os 'darwin)) (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner)))
    (let ((nelisp-aot-compiler--checked-arith t)) (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof owner)))
    (let ((nelisp-aot-compiler--x86-frame-copy-aliases nil)) (should-not (nelisp-aot-compiler--x86-frame-copy-source (car (nelisp-aot-frame-alias-test--copies owner)))))))

(ert-deftest nelisp-aot-frame-alias/lifetime-mmap-and-RAX ()
  (dolist (tail '((seq (setq source (+ source 1)) (+ copy source))
                  (seq (setq copy (+ copy 1)) (+ copy source))))
    (nelisp-aot-frame-alias-test--with `(seq (defun fa_main (p x) (let* ((source x) (copy source)) ,tail)))
      (should nelisp-aot-compiler--x86-frame-alias-owner-state)
      (let ((copy (cl-find 'copy (nelisp-aot-frame-alias-test--copies owner) :key (lambda (n) (nelisp-aot-compiler--ir-get n :var)))))
        (should-not (nelisp-aot-compiler--x86-frame-copy-source copy)))))
  (nelisp-aot-frame-alias-test--with nelisp-aot-frame-alias-test--source
    (let ((bad (nelisp-aot-compiler--ir-with owner :body (nelisp-aot-compiler--make-ir 'value-seq :forms nil))))
      (should-not (nelisp-aot-compiler--x86-frame-alias-owner-proof bad))))
  (nelisp-aot-frame-alias-test--with '(seq (defun fa_main (p x) (let* ((source x) (copy source)) (seq (syscall-direct 9 0 4096 3 34 -1 0) (+ copy copy)))))
    (should nelisp-aot-compiler--x86-frame-alias-owner-state)
    (dolist (copy (nelisp-aot-frame-alias-test--copies owner)) (should-not (nelisp-aot-compiler--x86-frame-copy-source copy))))
  (nelisp-aot-frame-alias-test--with '(seq (defun fa_main (p x) (let* ((mapping (syscall-direct 9 0 4096 3 34 -1 0)) (source x) (copy source)) (+ copy copy))))
    (should nelisp-aot-compiler--x86-frame-alias-owner-state)
    (should (integerp (nelisp-aot-compiler--x86-frame-copy-source (car (nelisp-aot-frame-alias-test--copies owner))))))
  (nelisp-aot-frame-alias-test--with '(seq (defun fa_main (p x) (let* ((source x) (copy source)) (seq (syscall-direct 60 1 0 0 0 0 0) (+ copy copy)))))
    (should nelisp-aot-compiler--x86-frame-alias-owner-state)
    (should (integerp (nelisp-aot-compiler--x86-frame-copy-source (car (nelisp-aot-frame-alias-test--copies owner)))))))

(ert-deftest nelisp-aot-frame-alias/central-read-and-map-precedence ()
  (let ((nelisp-aot-compiler--x86-frame-read-aliases '((2 . 1) (1 . 0)))
        (nelisp-aot-compiler--promoted-slots nil))
    (should (= 0 (nelisp-aot-compiler--x86-frame-read-slot 2)))
    (should (equal (nelisp-aot-compiler--x86-slot-operand 2) (nelisp-aot-compiler--x86-slot-mem 0)))
    (should (equal (nelisp-aot-compiler--x86-slot-operand 2 t) (nelisp-aot-compiler--x86-slot-mem 2)))
    (let ((nelisp-aot-compiler--promoted-slots '((2 . r12))))
      (should (equal (nelisp-aot-compiler--x86-slot-operand 2) '(:reg r12))))
    (let ((nelisp-aot-compiler--x86-frame-read-aliases '((1 . 2) (2 . 1))))
      (should-error (nelisp-aot-compiler--x86-frame-read-slot 2) :type 'nelisp-aot-compiler-error))))

(defun nelisp-aot-frame-alias-test--record (value &rest _)
  (when (integerp value)
    (cl-incf nelisp-aot-frame-alias-test--selected)
    (cl-incf (alist-get nelisp-aot-frame-alias-test--owner nelisp-aot-frame-alias-test--functions 0))) value)
(defun nelisp-aot-frame-alias-test--defun (fn d buf)
  (let ((nelisp-aot-frame-alias-test--owner (nelisp-aot-compiler--ir-get d :name)))
    (setf (alist-get nelisp-aot-frame-alias-test--owner nelisp-aot-frame-alias-test--layout)
          (list (nelisp-aot-compiler--ir-get d :rt-slot-count)
                (nelisp-aot-compiler--ir-get d :gc-root-slots)
                (nelisp-aot-compiler--ir-get d :internal-hidden)
                (nelisp-aot-compiler--ir-get d :param-regs)))
    (funcall fn d buf)))
(defun nelisp-aot-frame-alias-test--region (node _buf _emit &optional plan private)
  (dolist (pair (car (or plan (nelisp-aot-compiler--x86-promotion-plan node))))
    (when (and (assq (car pair) nelisp-aot-compiler--x86-frame-read-aliases)
               (not (memq (car pair) private)))
      (cl-incf nelisp-aot-frame-alias-test--nested))))
(defun nelisp-aot-frame-alias-test--empty-carry (ir)
  "Exercise existing low-level empty-value lowering that source parse folds."
  (dolist (d (nelisp-aot-compiler--collect-defuns ir))
    (when (eq (nelisp-aot-compiler--ir-get d :name) 'fa_empty)
      (cl-labels ((replace-body (n)
                    (if (eq (nelisp-aot-compiler--ir-get n :var) 'copy)
                        (nelisp-aot-compiler--ir-with n :body (nelisp-aot-compiler--make-ir 'value-seq :forms nil))
                      (nelisp-aot-compiler--ir-with n :body (replace-body (nelisp-aot-compiler--ir-get n :body))))))
        (let ((body (replace-body (nelisp-aot-compiler--ir-get d :body))))
          (cl-loop for i from 1 below (length d) by 2
                   when (eq (aref d i) :body) do (aset d (1+ i) body))))))
  ir)
(defun nelisp-aot-frame-alias-test--object (source file disabled)
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv) (nelisp-aot-compiler--os 'linux)
        (nelisp-aot-compiler--x86-frame-copy-aliases (not (or disabled nelisp-aot-frame-alias-test--forced-disabled)))
        (nelisp-aot-frame-alias-test--selected 0)
        (nelisp-aot-frame-alias-test--layout nil)
        (nelisp-aot-frame-alias-test--functions nil)
        (nelisp-aot-frame-alias-test--nested 0))
    (advice-add 'nelisp-aot-compiler--emit-defun :around #'nelisp-aot-frame-alias-test--defun)
    (advice-add 'nelisp-aot-compiler--emit-promoted-loop-x86 :before #'nelisp-aot-frame-alias-test--region)
    (advice-add 'nelisp-aot-compiler--parse :filter-return #'nelisp-aot-frame-alias-test--empty-carry)
    (advice-add 'nelisp-aot-compiler--x86-frame-copy-source :filter-return #'nelisp-aot-frame-alias-test--record)
    (unwind-protect
        (progn (nelisp-aot-compile-to-object source file)
               (list :selected nelisp-aot-frame-alias-test--selected :layout nelisp-aot-frame-alias-test--layout
                     :functions nelisp-aot-frame-alias-test--functions :nested nelisp-aot-frame-alias-test--nested))
      (advice-remove 'nelisp-aot-compiler--x86-frame-copy-source #'nelisp-aot-frame-alias-test--record)
      (advice-remove 'nelisp-aot-compiler--parse #'nelisp-aot-frame-alias-test--empty-carry)
      (advice-remove 'nelisp-aot-compiler--emit-defun #'nelisp-aot-frame-alias-test--defun)
      (advice-remove 'nelisp-aot-compiler--emit-promoted-loop-x86 #'nelisp-aot-frame-alias-test--region))))

(ert-deftest nelisp-aot-frame-alias/fullword-delayed-effects-WORD-native-ABI ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "nelisp-frame-alias-" t))
         (source '(seq
           (defun fa_clobber (p a b c d e) (seq (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) 1)) (+ (+ a b) (+ (+ c d) e))))
           (defun fa_delayed (p x) (let* ((source (ptr-read-u64 p 8)) (noise (+ x 7)) (copy source)) (seq (ptr-write-u64 p 8 x) (fa_clobber p 1 2 3 4 5) (+ copy copy))))
           (defun fa_chain (p x) (let* ((source x) (copy source) (again copy)) (seq (extern-call fa_clobber p 1 2 3 4 5) (+ again copy))))
           (defun fa_parallel (p x) (let* ((source x)) (let ((source (+ x 1)) (copy source)) (seq (fa_clobber p 1 2 3 4 5) (+ copy source)))))
           (defun fa_nested (p x) (let* ((source x) (copy source) (i 0) (sum 0)) (seq (while (< i 5) (setq sum (+ sum copy) i (+ i 1))) (fa_clobber p 1 2 3 4 5) (+ sum copy))))
           (defun fa_empty (p x) (let* ((source x) (noise (+ x 7)) (copy source)) copy))
           (defun fa_observer (p x) (let* ((source x) (copy source)) (seq (ptr-write-u64 p 16 (aot-current-sp)) (fa_clobber p 1 2 3 4 5) (+ copy copy))))
           (defun fa_escaped (p x) (let* ((source x) (copy source)) (seq (ptr-write-u64 p 16 (aot-current-sp)) copy)))
           (defun fa_addr (p x) (let* ((source x) (copy source)) (seq (ptr-write-u64 p 16 (addr-of fa_clobber)) copy)))
           (defun fa_map_before (p x) (let* ((mapping (syscall-direct 9 0 4096 3 34 -1 0)) (source x) (copy source)) (seq (fa_clobber p 1 2 3 4 5) (+ copy copy))))
           (defun fa_map_inside (p x) (let* ((source x) (copy source)) (seq (syscall-direct 9 0 4096 3 34 -1 0) (fa_clobber p 1 2 3 4 5) (+ copy copy))))
           (defun fa_word (p w) (let* ((source w) (copy source)) (seq (fa_clobber p 1 2 3 4 5) (if (= (logand copy 7) 2) 7 (if (= (logand copy 7) 6) (logand (ptr-read-u64 (- copy 6) 0) 63) (if (= (logand copy 3) 1) 2 0))))))))
         (c (expand-file-name "driver.c" dir)) (co (expand-file-name "driver.o" dir))
         (enabled nil) (disabled-result nil))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "typedef unsigned long U;\n"
                    "extern U fa_delayed(U*,U),fa_chain(U*,U),fa_parallel(U*,U),fa_nested(U*,U),fa_empty(U*,U),fa_addr(U*,U),fa_observer(U*,U),fa_escaped(U*,U),fa_map_before(U*,U),fa_map_inside(U*,U),fa_word(U*,U);\n"
                    "int run(void){U xs[]={0,1,2,7,63,0x7fffffffffffffffUL,0x8000000000000000UL,~0UL,0xdeadbeefdeadbeefUL};U mem[4]={0};U box[8]={0};box[0]=17;\n"
                    "for(U i=0;i<sizeof(xs)/sizeof(xs[0]);i++){U x=xs[i];mem[0]=0;mem[1]=x+3; if(fa_delayed(mem,x)!=(x+3)*2||mem[1]!=x||mem[0]!=1)return 1;\n"
                    "U old=mem[0];if(fa_chain(mem,x)!=x*2||mem[0]!=old+1)return 2; if(fa_parallel(mem,x)!=x*2+1||fa_nested(mem,x)!=x*6||fa_empty(mem,x)!=x)return 2;\n"
                    "if(fa_observer(mem,x)!=x*2||!mem[2]||fa_escaped(mem,x)!=x||fa_addr(mem,x)!=x)return 3;\n"
                    "if(fa_map_before(mem,x)!=x*2||fa_map_inside(mem,x)!=x*2)return 4;\n"
                    "if(fa_word(mem,2)!=7||fa_word(mem,(U)box+6)!=17||fa_word(mem,(x<<2)|1)!=2)return 5;}return 0;}\n"
                    "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-stack-protector" "-fno-pie" "-c" c "-o" co)))
          (dolist (disabled '(t nil))
            (let ((o (expand-file-name (if disabled "off.o" "on.o") dir))
                  (exe (expand-file-name (if disabled "off" "on") dir)))
              (let ((n (nelisp-aot-frame-alias-test--object source o disabled)))
                (if disabled (setq disabled-result n) (setq enabled n)))
              (should (= 0 (call-process "ld" nil nil nil "-o" exe co o)))
              ;; Values/effects pass before the optimization gauge: real red/green.
              (let ((status (call-process exe nil nil nil)))
                (message "FRAME-ALIAS native disabled=%S values-status=%S" disabled status)
                (should (equal 0 status)))))
          (should (= (plist-get disabled-result :selected) 0))
          (should (equal (plist-get disabled-result :layout) (plist-get enabled :layout)))
          (should (> (plist-get enabled :selected) 0))
          (should (> (plist-get enabled :nested) 0))
          (dolist (name '(fa_delayed fa_chain fa_nested fa_map_before fa_word))
            (should (> (alist-get name (plist-get enabled :functions) 0) 0)))
          (dolist (name '(fa_empty fa_observer fa_escaped fa_addr fa_map_inside))
            (should (= (alist-get name (plist-get enabled :functions) 0) 0))))
      (delete-directory dir t))))

(provide 'nelisp-aot-frame-alias-test)
