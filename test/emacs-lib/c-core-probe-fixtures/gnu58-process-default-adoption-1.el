                  (accept-process-output child 0.02)))))
   (unwind-protect
       (progn
         (kill-buffer buffer)
         (process-send-eof child)
         (funcall wait 'exit)
         (list :case 'dead-buffer :status (process-status child) :code (process-exit-status child)
               :count (length events) :events (nreverse events)
