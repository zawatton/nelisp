;;; gnu58-process-default-adoption-1.el --- default sentinel adoption regressions -*- lexical-binding: t; -*-
;; Use a symmetric fixture driver when one is provided; the current --extra
;; smoke path is asymmetric. This directory stays outside the automatic census.
;;; cases.el --- Public default adoption contract -*- lexical-binding: t; -*-
(gnu58-default-adoption
 (let* ((events nil)
        (buffer (generate-new-buffer " *sol-default-1*"))
        (cat (or (executable-find "cat") (error "Missing cat")))
        (child (make-process :name "sol-default-factory-custom" :buffer buffer
                             :command (list cat) :connection-type 'pipe :noquery t
                             :sentinel (lambda (proc event)
                                         (push (list (process-status proc) (process-exit-status proc)
                                                     (string-to-list event)) events))))
        (wait (lambda (status)
                (let ((deadline (+ (float-time) 2)) (iterations 0))
                  (while (and (not (eq (process-status child) status))
                              (< (float-time) deadline) (< iterations 128))
                    (setq iterations (1+ iterations))
                    (accept-process-output child 0.02))
                  (unless (eq (process-status child) status)
                    (error "Status timeout %S actual %S" status (process-status child)))
                  (accept-process-output child 0.02)
                  (accept-process-output child 0.02)))))
   (unwind-protect
       (progn
         (process-send-eof child)
         (funcall wait 'exit)
         (list :case 'factory-custom :status (process-status child) :code (process-exit-status child)
               :count (length events) :events (nreverse events)
               :buffer-live (buffer-live-p buffer)
               :buffer (and (buffer-live-p buffer) (with-current-buffer buffer (string-to-list (buffer-string))))))
     (ignore-errors (signal-process child 'CONT))
     (ignore-errors (delete-process child))
     (when (buffer-live-p buffer) (kill-buffer buffer))))
