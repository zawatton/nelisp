   (unwind-protect
       (progn
         (signal-process child 'STOP)
         (funcall wait 'stop)
         (let ((stopped (with-current-buffer buffer (string-to-list (buffer-string)))))
           (signal-process child 'CONT)
           (funcall wait 'run)
           (let ((continued (with-current-buffer buffer (string-to-list (buffer-string)))))
             (process-send-eof child)
             (funcall wait 'exit)
             (list :case 'default-transitions :stop-buffer stopped :run-buffer continued
