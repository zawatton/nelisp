;;; gnu58-active-lexical-frame-1.el --- live lexical frame regressions -*- lexical-binding: t; -*-

;; The harness reads this matrix as probe data and evaluates each member.
(funcall
 (let* ((events nil)
        (writer (lambda (event) (push event events)))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0))
                  (while (and (< (length events) count)
                              (< (float-time) deadline)
                              (< iterations 4))
                    (setq iterations (1+ iterations))
                    (funcall callback event))
                  (unless (= (length events) count)
                    (error "Active waiter count %s: %s" count events))
                  events))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) events)))
 (let* ((events nil)
        (writer (lambda (event) (push event events)))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0))
                  (while (and (< (length events) count)
                              (< (float-time) deadline)
                              (< iterations 4))
                    (setq iterations (1+ iterations))
                    (garbage-collect)
                    (funcall callback event)
                    (garbage-collect))
                  (unless (= (length events) count)
                    (error "Active waiter count %s: %s" count events))
                  events))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) events)))
 (let* ((sol-queue nil)
        (writer (lambda (event) (push event sol-queue)))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0) last-write)
                  (while (and (< (length sol-queue) count) (< (float-time) deadline) (< iterations 4))
                    (setq iterations (1+ iterations))
                    (setq last-write (funcall callback event)))
                  (unless (= (length sol-queue) count)
                    (error "Diagnostic count=%S read=%S writer-return=%S" count sol-queue last-write))
                  sol-queue))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) sol-queue)))
 (let* ((events (list nil))
        (writer (lambda (event) (setcar events (cons event (car events)))))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0) last-write)
                  (while (and (< (length (car events)) count) (< (float-time) deadline) (< iterations 4))
                    (setq iterations (1+ iterations))
                    (setq last-write (funcall callback event)))
                  (unless (= (length (car events)) count)
                    (error "Diagnostic count=%S read=%S writer-return=%S" count (car events) last-write))
                  (car events)))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) (car events))))
 (let* ((sol-queue (list nil))
        (writer (lambda (event) (setcar sol-queue (cons event (car sol-queue)))))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0) last-write)
                  (while (and (< (length (car sol-queue)) count) (< (float-time) deadline) (< iterations 4))
                    (setq iterations (1+ iterations))
                    (setq last-write (funcall callback event)))
                  (unless (= (length (car sol-queue)) count)
                    (error "Diagnostic count=%S read=%S writer-return=%S" count (car sol-queue) last-write))
                  (car sol-queue)))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) (car sol-queue))))
 (let* ((events nil)
        (writer (lambda (event) (setq events (cons event events))))
        (wait (lambda (count callback event)
                (let ((deadline (+ (float-time) 2)) (iterations 0) last-write)
                  (while (and (< (length events) count) (< (float-time) deadline) (< iterations 4))
                    (setq iterations (1+ iterations))
                    (setq last-write (funcall callback event)))
                  (unless (= (length events) count)
                    (error "Diagnostic count=%S read=%S writer-return=%S" count events last-write))
                  events))))
   (let ((first (funcall wait 1 writer 'stop)))
     (list first (funcall wait 2 writer 'run) events)))
 ;; Callback rebinds STATE; the active callback must observe its current cell
 ;; both within one mapcar element and on the next element.
 (let* ((state 0)
        (reader (lambda () state)))
   (mapcar (lambda (x) (setq state x) (list x (funcall reader))) '(1 2)))
 ;; Pure capture baseline, uncaptured local, and dynamic-scope control.
 (let ((state 17)) (let ((reader (lambda () state))) (funcall reader)))
 (let ((local 5)) (+ local 1))
 (progn (defvar gnu58-dynamic-control)
        (let ((gnu58-dynamic-control 9))
          (funcall (lambda () gnu58-dynamic-control))))
 ;; A read-only callback observes the live captured value before and after a
 ;; nested writer changes the same binding, including across mapcar elements.
 (let* ((state 0)
        (writer (lambda (value) (setq state value))))
   (mapcar (lambda (value)
             (let ((before state))
               (funcall writer value)
               (list before state)))
           '(1 2)))
 ;; The lambda argument is not a captured lexical variable.
 (funcall (lambda (x) (+ x 1)) 5))
