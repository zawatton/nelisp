(text-char-description
 (mapcar #'text-char-description '(0 1 9 10 13 27 31 32 65 126 127))
 (mapcar #'text-char-description '(128 255 955 26085 1114111 4194303))
 (let ((description (text-char-description 4194303)))
   (list (length description) (aref description 0)
         (string-bytes description) (multibyte-string-p description)))
 (mapcar (lambda (c)
           (let ((description (text-char-description c)))
             (list (length description) (aref description 0)
                   (string-bytes description))))
         '(2097151 2097152 4194175 4194176 4194239 4194240 4194303))
 (mapcar (lambda (c) (multibyte-string-p (text-char-description c)))
         '(0 32 65 127 128 255 955))
 (let ((first (text-char-description 65)) (second (text-char-description 65)))
   (list (equal first second) (eq first second)))
 (condition-case err (text-char-description nil) (error err))
 (condition-case err (text-char-description 'symbol) (error err))
 (condition-case err (text-char-description 1.5) (error err))
 (condition-case err (text-char-description -1) (error err))
 (condition-case err (text-char-description #x4000000) (error err))
 (condition-case err (text-char-description #x8000000) (error err))
 (condition-case err (text-char-description) (error err))
 (condition-case err (text-char-description 65 66) (error err)))

(char-resolve-modifiers
 (mapcar #'char-resolve-modifiers '(0 32 63 65 97 127 128 955))
 (mapcar (lambda (c) (char-resolve-modifiers (logior #x4000000 c)))
         '(0 9 32 33 63 64 65 90 91 95 96 97 122 123 127 128 955))
 (mapcar (lambda (c) (char-resolve-modifiers (logior #x2000000 c)))
         '(0 9 32 33 63 64 65 90 91 95 96 97 122 123 127 128 955))
 (mapcar (lambda (c) (char-resolve-modifiers (logior #x6000000 c)))
         '(0 9 32 33 63 64 65 90 91 95 96 97 122 123 127 128 955))
 (mapcar (lambda (c) (char-resolve-modifiers (logior #xc000000 c))) '(32 65 97 955))
 (char-resolve-modifiers (logior #x3c00000 97))
 (condition-case err (char-resolve-modifiers nil) (error err))
 (condition-case err (char-resolve-modifiers 1.5) (error err)))
