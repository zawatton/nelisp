;;; standalone-eieio-type-dispatch.el --- Genuine class type dispatch -*- lexical-binding: t; -*-
(require 'eieio)
(defclass nelisp-type-left () ((value :initform 1 :initarg :value :accessor nelisp-type-value)))
(defclass nelisp-type-right () ())
(defclass nelisp-type-child (nelisp-type-left nelisp-type-right) ())
(defclass nelisp-type-unrelated () ())
(cl-defgeneric nelisp-type-dispatch (object))
(cl-defmethod nelisp-type-dispatch ((_object nelisp-type-left)) 'left)
(cl-defmethod nelisp-type-dispatch ((_object nelisp-type-right)) 'right)
(cl-defmethod nelisp-type-dispatch ((_object nelisp-type-child)) 'child)
(let ((object (make-instance 'nelisp-type-child :value 7)) (effects 0))
  (unless (and (eq (nelisp-type-dispatch object) 'child)
               (= (nelisp-type-value object) 7))
    (error "Genuine class constructor/type specialization differs"))
  (setf (nelisp-type-value (progn (setq effects (1+ effects)) object))
        (progn (setq effects (1+ effects)) 44))
  (unless (and (= effects 2) (= (slot-value object 'value) 44))
    (error "Inherited accessor setter/evaluation order differs")))
(let ((refused nil))
  (condition-case nil
      (nelisp-type-dispatch (make-instance 'nelisp-type-unrelated))
    (cl-no-applicable-method (setq refused t)))
  (unless refused (error "Unrelated class wrongly matched")))
(cl-defgeneric nelisp-type-parent-order (object))
(cl-defmethod nelisp-type-parent-order ((_object nelisp-type-left)) 'left)
(cl-defmethod nelisp-type-parent-order ((_object nelisp-type-right)) 'right)
(unless (eq (nelisp-type-parent-order (make-instance 'nelisp-type-child)) 'left)
  (error "Genuine multiple-parent class precedence differs"))
(princ "EIEIO-TYPE-DISPATCH-PASS\n")
