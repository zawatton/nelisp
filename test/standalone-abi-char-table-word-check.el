;;; standalone-abi-char-table-word-check.el --- char-table child roots -*- lexical-binding: t; -*-
(let ((table (make-char-table (make-symbol (concat "word-" "subtype")) nil)))
  (put (char-table-subtype table) 'char-table-extra-slots 2)
  ;; GNU chooses extra storage at construction, so use a registered subtype
  ;; for the independently collected extra-slot child.
  (put 'abi-char-word 'char-table-extra-slots 2)
  (let ((extra (make-char-table 'abi-char-word nil)))
    (set-char-table-extra-slot extra 0 (vector (concat "extra-" "child") (list 17 29)))
    (set-char-table-range table nil (concat "default-" "child"))
    (set-char-table-parent table (make-char-table 'abi-char-parent (concat "parent-" "child")))
    (aset table 100 (list (concat "entry-" "child") (vector 17 29)))
    (set-char-table-range table '(200 . 250) (concat "split-" "child"))
    (set-char-table-range table '(210 . 220) 17)
    (let ((i 0))
      (while (< i 200) (aset table (+ 1000 (* i 2)) (list i (concat "growth-" "child"))) (setq i (1+ i))))
    (aset table 400 table)
    (when (fboundp 'nelisp--debug-switch) (nelisp--debug-switch 28))
    (garbage-collect)
    (unless (equal (symbol-name (char-table-subtype table)) "word-subtype") (error "subtype root lost"))
    (unless (equal (char-table-range table nil) "default-child") (error "default root lost"))
    (unless (equal (char-table-extra-slot extra 0) '["extra-child" (17 29)]) (error "extra root lost"))
    (unless (equal (aref table 100) '("entry-child" [17 29])) (error "interval root lost"))
    (unless (equal (aref table 205) "split-child") (error "left split root lost"))
    (unless (= (aref table 215) 17) (error "middle split changed"))
    (unless (equal (aref table 225) "split-child") (error "right split root lost"))
    (unless (equal (aref table 1398) '(199 "growth-child")) (error "grown interval root lost"))
    (unless (eq (aref table 400) table) (error "cyclic interval changed"))
    (set-char-table-range table nil nil)
    (unless (equal (aref table 500) "parent-child") (error "parent root lost"))
    (when (fboundp 'nelisp--debug-switch) (nelisp--debug-switch 29))
    (princ "ABI-CHAR-TABLE-WORD checks=10 PASS\n")))
nil
