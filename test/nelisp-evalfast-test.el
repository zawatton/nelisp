;;; nelisp-evalfast-test.el --- Evaluator floor probes -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)

;; EVALFAST_SOURCE_ROOT also runs these exact probes against the copied seed.
(let ((root (getenv "EVALFAST_SOURCE_ROOT")))
  (dolist (file '("nelisp-cc-frame-stack-find.el"
                  "nelisp-cc-evalport-env-leaves-simple.el"
                  "nelisp-cc-env-set-value.el" "nelisp-cc-sf-setq.el"
                  "nelisp-cc-sf-while.el"))
    (load (if root (expand-file-name file root)
            (expand-file-name file "lisp")) nil t)))

(defvar eft--memory nil)
(defvar eft--walks 0)
(defvar eft--polls 0)
(defvar eft--evaluations nil)

(defun eft--truth (v) (and v (not (eql v 0))))
(defun eft--shift (v n) (ash v (- n)))
(defun eft--read (p o)
  (or (gethash (+ p o) eft--memory)
      (error "Unexpected memory read %s+%s" p o)))
(defun eft--write (p o v) (puthash (+ p o) v eft--memory) 0)

(defun eft--adapt (x)
  "Adapt only source IR syntax and raw memory operations, retaining its logic."
  (cond
   ((atom x) x)
   ((memq (car x) '(if while))
    `(,(car x) (eft--truth ,(eft--adapt (cadr x)))
      ,@(mapcar #'eft--adapt (cddr x))))
   ((eq (car x) 'extern-call) (eft--adapt (cdr x)))
   (t (cons (pcase (car x)
              ('seq 'progn) ((or 'sar 'shr) 'eft--shift)
              ((or 'ptr-read-u64 'heap-read-u64) 'eft--read)
              ('ptr-write-u64 'eft--write) (_ (eft--adapt (car x))))
            (mapcar #'eft--adapt (cdr x))))))

(defun eft--definition (source name)
  (or (cl-find name (cdr source) :key #'cadr :test #'eq)
      (error "Missing source definition %s" name)))

(defun eft--install (source names)
  (dolist (name names)
    (eval (eft--adapt (eft--definition source name)) t)))

(defun eft--setup ()
  "One frame, two binding pairs; all reads require initialized memory."
  (setq eft--memory (make-hash-table :test #'eql) eft--walks 0)
  (dolist (kv '((32 . 12) (40 . 4096) (4112 . 8198) (4120 . 5)
               (8192 . 8) (8200 . 12294) (12288 . 780) (12312 . 1)
               (12320 . 3) (12304 . 16386)
               (16384 . 20482) (16392 . 16418)
               (16416 . 20514) (16424 . 3)
               (20480 . 24582) (20488 . 28678)
               (20512 . 24614) (20520 . 28710)
               (28672 . 11) (28680 . 29) (28704 . 11) (28712 . 37)))
    (puthash (car kv) (cdr kv) eft--memory)))

(eft--install nelisp-cc-frame-stack-find--source '(nl_lex_walk))
(eft--install nelisp-cc-evalport-env-leaves-simple--source '(nl_env_lookup_val_w))
(eft--install nelisp-cc-env-set-value--source '(nelisp_env_set_value_lazy))

(ert-deftest eft-adapter-zero-control ()
  (should (= (eval (eft--adapt '(if 0 10 20)) t) 20))
  (should (= (eval (eft--adapt '(if (= 1 1) 10 20)) t) 10)))

(ert-deftest eft-lex-walk-is-a-leaf ()
  (cl-labels ((scan (x)
               (when (consp x)
                 (when (and (symbolp (car x))
                            (string-match-p "\\`\\(?:nl_\\|extern-call\\)" (symbol-name (car x))))
                   (error "Non-leaf operation %s" (car x)))
                 (mapc #'scan x))))
    (mapc #'scan (cdddr (eft--definition nelisp-cc-frame-stack-find--source 'nl_lex_walk)))))

(ert-deftest eft-walk-shadowing-boundary-and-fallback ()
  (eft--setup)
  (cl-letf (((symbol-function 'nl_word_payload) (lambda (p) (eft--read p 8))))
    (should (= (nl_lex_walk 32 24582 2) 29))
    (should (= (nl_lex_walk 32 24614 2) 37))
    (should (= (nl_lex_walk 32 24582 0) 28678))
    (should (= (nl_lex_walk 32 24582 1) 28678))
    (should (= (nl_lex_walk 32 25030 2) 0))
    ;; A second, outer frame binds the same name to another cell.
    (eft--write 4112 8 9)
    (eft--write 8192 16 12294)
    (eft--write 8192 8 12358)
    (eft--write 12352 0 780)
    (eft--write 12352 16 16418)
    (eft--write 12352 24 1)
    (eft--write 12352 32 3)
    (should (= (nl_lex_walk 32 24582 2) 29))
    (should (= (nl_lex_walk 32 24614 2) 37))
    (eft--write 12304 0 3)
    (eft--write 12320 0 7)
    (should (= (nl_lex_walk 32 24614 2) 0))
    ;; Dynamic-declaration metadata forces the existing general descent.
    (eft--write 12312 0 16386)
    (should (= (nl_lex_walk 32 24614 2) -1))
    (should (= (nl_lex_walk 32 1 2) -1))))

(ert-deftest eft-first-frame-read-avoids-walker ()
  (eft--setup)
  (cl-letf (((symbol-function 'nl_lex_walk)
             (lambda (&rest _) (cl-incf eft--walks) 29)))
    (should (= (nl_env_lookup_val_w 24582 0 0) 29))
    (should (= (nl_env_lookup_val_w 24614 0 0) 37))
    (should (= eft--walks 0))
    (should (= (nl_env_lookup_val_w 25030 0 0) 29))
    (should (= eft--walks 1))))

(ert-deftest eft-first-frame-write-avoids-walker ()
  (eft--setup)
  (cl-letf (((symbol-function 'nelisp_env_set_value_name_ok) (lambda (_) 1))
            ((symbol-function 'nl_lex_walk)
             (lambda (&rest _) (cl-incf eft--walks) 28678))
            ((symbol-function 'nelisp_env_setv_cell_hit)
             (lambda (cell val) (eft--write (- cell 6) 8 val))))
    (should (= (nelisp_env_set_value_lazy 0 32 24582 45 64 0) 0))
    (should (= (eft--read 28672 8) 45))
    (should (= eft--walks 0))))

(ert-deftest eft-first-frame-declarations-and-cells-fall-back ()
  (eft--setup)
  (let ((walks nil))
    (cl-letf (((symbol-function 'nl_lex_walk)
               (lambda (_frames _name mode) (push mode walks) 29)))
      ;; A non-fixnum declarations slot must never be skipped, even on a hit.
      (eft--write 12312 0 16386)
      (should (= (nl_env_lookup_val_w 24582 0 0) 29))
      (should (equal walks '(2)))
      (eft--write 12312 0 1)
      (setq walks nil)
      ;; A pair-backed Cell must be decoded by the general accessor.
      (eft--write 28672 0 267)
      (should (= (nl_env_lookup_val_w 24582 0 0) 29))
      (should (equal walks '(2))))))

(ert-deftest eft-lex-walk-hybrid-and-pair-backed-fall-back ()
  (eft--setup)
  (eft--write 20488 0 45)
  (should (= (nl_lex_walk 32 24582 2) 45))
  (should (= (nl_lex_walk 32 24582 1) 45))
  (should (= (nl_lex_walk 32 24582 0) -1))
  (eft--write 20488 0 28678)
  (eft--write 28672 0 267)
  (should (= (nl_lex_walk 32 24582 2) -1))
  (should (= (nl_lex_walk 32 24582 0) 28678)))

(ert-deftest eft-setq-direct-pair-bypasses-accessors ()
  (eft--setup)
  (eft--install nelisp-cc-sf-setq--source
                '(nl_sf_setq_w nl_sf_setq_evaled_w))
  (eft--write 16416 0 53)
  (let ((writes nil))
    (cl-letf (((symbol-function 'nelisp_eval_call_w)
               (lambda (form &rest _) (should (= form 53)) 61))
              ((symbol-function 'nl_env_set_value)
               (lambda (env sym w) (push (list env sym w) writes) 0))
              ((symbol-function 'sexp-tag) (lambda (_) 7))
              ((symbol-function 'nl_cons_cdr_ptr)
               (lambda (&rest _) (error "Generic accessor on direct pair"))))
      (should (= (nl_sf_setq_w 16386 0 0 0) 61))
      (should (equal writes '((0 20482 61)))))))

(ert-deftest eft-while-direct-loop-polls-and-signals ()
  (eft--setup)
  (eft--install nelisp-cc-sf-while--source '(nl_sf_while_w))
  (setq eft--polls 0 eft--evaluations nil)
  (let ((trips 0) (failed nil))
    (cl-letf (((symbol-function 'nelisp_eval_call_w)
               (lambda (form &rest _)
                 (push form eft--evaluations)
                 (if (= form 20482)
                     (if (< trips 3) (progn (cl-incf trips) 7) 3)
                   (if failed 0 29))))
              ((symbol-function 'nl_sf_while_midform_collect)
               (lambda (&rest _) (cl-incf eft--polls) 0))
              ((symbol-function 'sexp-tag) (lambda (_) 7))
              ((symbol-function 'nl_sf_while_iter)
               (lambda (&rest _) (error "Unfused direct while"))))
      (should (= (nl_sf_while_w 16386 0 0 0) 3))
      (should (= eft--polls 3))
      (should (= (length eft--evaluations) 7))
      (setq trips 0 failed t eft--polls 0)
      (should (= (nl_sf_while_w 16386 0 0 0) 0))
      (should (= eft--polls 0)))))

;; interp2: after the in-line probe read the newest frame to its end with no binding of
;; the name, the general walk starts below that frame (MODE 6: mode 2 and one frame
;; skipped); any frame the probe does not take, a scope boundary, or a binding it found
;; but could not decode, is walked from the top (MODE 2).
(ert-deftest eft-first-frame-clean-miss-skips-the-newest-frame ()
  (eft--setup)
  (let ((skips nil))
    (cl-letf (((symbol-function 'nl_lex_walk)
               (lambda (_frames _name mode) (push mode skips) 29)))
      ;; 25030 is bound in no frame of the fixture: a clean miss of the newest frame.
      (should (= (nl_env_lookup_val_w 25030 0 0) 29))
      (should (equal skips '(6)))
      ;; A hit never walks.
      (setq skips nil)
      (should (= (nl_env_lookup_val_w 24582 0 0) 29))
      (should (equal skips nil))
      ;; A frame with the scope-boundary mark in slot 2 ends the descent below it:
      ;; the walk must see it (SKIP 0).
      (eft--write 12320 0 5)
      (setq skips nil)
      (nl_env_lookup_val_w 25030 0 0)
      (should (equal skips '(2)))
      ;; Declarations in slot 1 keep the probe from reading the frame at all.
      (eft--write 12320 0 3)
      (eft--write 12312 0 16386)
      (setq skips nil)
      (nl_env_lookup_val_w 25030 0 0)
      (should (equal skips '(2)))
      ;; A hit whose value the probe cannot decode (pair-backed Cell) is walked
      ;; from the top.
      (eft--write 12312 0 1)
      (eft--write 28672 0 267)
      (setq skips nil)
      (nl_env_lookup_val_w 24582 0 0)
      (should (equal skips '(2))))))

(ert-deftest eft-lex-walk-skips-the-newest-frames-by-mode ()
  (eft--setup)
  (cl-letf (((symbol-function 'nl_word_payload) (lambda (p) (eft--read p 8))))
    (should (= (nl_lex_walk 32 24582 2) 29))
    (should (= (nl_lex_walk 32 24582 6) 0))
    (should (= (nl_lex_walk 32 24582 1) 28678))
    (should (= (nl_lex_walk 32 24582 5) 0))))

(provide 'nelisp-evalfast-test)
