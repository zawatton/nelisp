;;; nelisp-aot-fxloop-test.el --- fixnum loops in registers (aot-regs)  -*- lexical-binding: t; -*-

;; Host-side tests of `nelisp-aot-compiler-fixnum-loops'.  The in-image
;; differential (bignums, errors, floats, budget exhaustion) is generated by
;; test/nelisp-aot-fxloop-gen.el and run in the runtime image.  Run:
;;   emacs -Q --batch -L lisp -L src -L test -l test/nelisp-aot-fxloop-test.el \
;;     -f ert-run-tests-batch-and-exit

(require 'ert)
(require 'cl-lib)
(require 'nelisp-artifact)
(require 'nelisp-aot-compiler)
(require 'nelisp-aot-fxloop-gen)

(defvar nelisp-aot-fxloop-test--dir nil)

(defun nelisp-aot-fxloop-test--dir ()
  (or nelisp-aot-fxloop-test--dir
      (setq nelisp-aot-fxloop-test--dir (make-temp-file "fxl" t))))

(defun nelisp-aot-fxloop-test--compile (source tag flag &optional mutation)
  "Compile SOURCE text; return (ARTIFACT-PATH . LOG)."
  (let* ((dir (nelisp-aot-fxloop-test--dir))
         (src (expand-file-name (concat tag ".el") dir))
         (art (concat src ".neln"))
         (nelisp-aot-compiler-fixnum-loops flag)
         (nelisp-aot-compiler-fixnum-loop-quit-poll nil) ; host exec cannot run quoted constants
         (nelisp-aot-compiler--fxloop-mutation mutation)
         (nelisp-aot-compiler--fxloop-log nil))
    (with-temp-file src (insert source))
    (nelisp-artifact-compile-file src art nil nil nil nil nil 'neln 'required)
    (cons art (reverse nelisp-aot-compiler--fxloop-log))))

(defun nelisp-aot-fxloop-test--object (art)
  (with-temp-buffer
    (insert-file-contents art)
    (unless (re-search-forward ":object-base64 \"\\([^\"]+\\)\"" nil t) (error "no object"))
    (let ((obj (expand-file-name (concat (file-name-nondirectory art) ".o")
                                 (nelisp-aot-fxloop-test--dir)))
          (bytes (base64-decode-string (match-string 1))))
      (with-temp-file obj
        (set-buffer-multibyte nil)
        (insert bytes))
      obj)))

(defun nelisp-aot-fxloop-test--loops (art)
  "Return a list (INSNS CALLS MEMS) per backward-jump loop of ART's object."
  (let ((obj (nelisp-aot-fxloop-test--object art)) (ins nil) (out nil))
    (with-temp-buffer
      (call-process "objdump" nil t nil "-d" "-M" "intel" obj)
      (goto-char (point-min))
      (while (re-search-forward "^ *\\([0-9a-f]+\\):\t[0-9a-f ]+\t\\(.*\\)$" nil t)
        (let ((a (string-to-number (match-string 1) 16)) (txt (match-string 2))) (push (cons a (string-trim txt)) ins))))
    (setq ins (vconcat (nreverse ins)))
    (dotimes (i (length ins))
      (let ((a (car (aref ins i))) (txt (cdr (aref ins i))))
        (when (string-match "\\`j[a-z]+ +\\([0-9a-f]+\\) <" txt)
          (let* ((tgt (string-to-number (match-string 1 txt) 16))
                 (start (cl-position tgt ins :key #'car)))
            (when (and start (<= tgt a))
              (let ((span (cl-subseq ins start (1+ i))))
                (push (list (length span)
                            (cl-count-if (lambda (x) (string-match-p "call" (cdr x))) span)
                            (cl-count-if (lambda (x) (string-match-p "PTR" (cdr x))) span))
                      out)))))))
    (nreverse out)))

(defconst nelisp-aot-fxloop-test--host-source
  (mapconcat #'identity
             (cl-remove-if (lambda (l) (string-match-p "fx-call\\|fx-let" l))
                           (split-string nelisp-aot-fxloop-gen--source "\n" t))
             "\n")
  "The gen source without the closure and call defuns the host harness cannot run.")

(defun nelisp-aot-fxloop-test--tools-p ()
  (and (eq system-type 'gnu/linux) (string-match-p "x86_64" system-configuration)
       (executable-find "cc") (executable-find "objcopy") (executable-find "objdump")))

(defconst nelisp-aot-fxloop-test--sum
  "(defun fxt-sum (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s i)) (setq i (1+ i))) s))\n")

(ert-deftest nelisp-aot-fxloop/decisions ()
  "The pass applies to whitelisted loops and declines everything else, with a reason."
  (let* ((r (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-gen--source "dec" t))
         (log (cdr r)))
    (dolist (n '(fx-sum fx-sum2 fx-sum3 fx-acc fx-two fx-tree4 fx-up fx-down fx-neq fx-and fx-neg
                        fx-zero fx-not))
      (should (equal (list n 'applied nil) (assq n (cl-remove-if-not (lambda (e) (eq (nth 1 e) 'applied)) log)))))
    (should (member '(fx-tree8 declined leaf-cap) log))
    (should (member '(fx-call declined (form abs)) log))
    (should (member '(fx-let declined (body-form let)) log))))

(ert-deftest nelisp-aot-fxloop/declined-is-byte-identical ()
  "A unit with only declined loops compiles to the same object with the pass on or off."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let* ((src "(defun fxd-call (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s (abs i)) i (1+ i))) s))
(defun fxd-let (n) (let ((i 0)) (while (< i n) (let ((j i)) (setq i (1+ j)))) i))\n")
         (on (nelisp-aot-fxloop-test--compile src "dbi-on" t))
         (off (nelisp-aot-fxloop-test--compile src "dbi-off" nil)))
    (should (cl-every (lambda (e) (eq (nth 1 e) 'declined)) (cdr on)))
    (should (equal (with-temp-buffer (insert-file-contents (nelisp-aot-fxloop-test--object (car on)))
                                     (buffer-string))
                   (with-temp-buffer (insert-file-contents (nelisp-aot-fxloop-test--object (car off)))
                                     (buffer-string))))))

(ert-deftest nelisp-aot-fxloop/hot-loop-is-registers-only ()
  "The hot loop has no call and no memory operand, and stays under the instruction ceiling."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let* ((r (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--sum "hot" t))
         (loops (nelisp-aot-fxloop-test--loops (car r)))
         (hot (cl-find-if (lambda (l) (< (nth 0 l) 60)) loops)))
    (should hot)
    (should (<= (nth 0 hot) 30))
    (should (= 0 (nth 1 hot)))
    (should (= 0 (nth 2 hot)))
    (should-not (cl-find 'allocator (cdr r) :key #'cadr))
    (should (cl-find 'promoted (cdr r) :key #'cadr))))

(ert-deftest nelisp-aot-fxloop/pass-off-keeps-the-slow-loop ()
  "Control: without the pass the loop calls through the generic path."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let* ((r (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--sum "hotoff" nil)))
    (should-not (cl-find-if (lambda (l) (and (< (nth 0 l) 60) (= 0 (nth 1 l)) (= 0 (nth 2 l))))
                            (nelisp-aot-fxloop-test--loops (car r))))))

(defun nelisp-aot-fxloop-test--k-source (k)
  (let* ((vars (cl-loop for j from 1 to k collect (intern (format "v%d" j))))
         (sum (let ((e 'i)) (dolist (v vars) (setq e (list '+ e v))) e)))
    (format "(defun fxk%d (n) (let ((i 0) %s) (while (< i n) (setq i (1+ i) %s)) %S))\n"
            k (mapconcat (lambda (v) (format "(%s 0)" v)) vars " ")
            (mapconcat (lambda (v) (format "%s (+ %s 1)" v v)) vars " ")
            sum)))

(ert-deftest nelisp-aot-fxloop/carried-variable-counts-and-diagnostic ()
  "k = 1..6 carried variables: results equal GNU; the log says whether the allocator covered the loop."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let ((promoted nil) (partial nil))
    (dolist (k '(1 2 3 4 5 6))
      (let* ((r (nelisp-aot-fxloop-test--compile (nelisp-aot-fxloop-test--k-source k)
                                                 (format "k%d" k) t))
             (name (format "fxk%d" k))
             (entry (cl-find-if (lambda (e) (memq (nth 1 e) '(promoted allocator))) (cdr r))))
        (should entry)
        (if (eq (nth 1 entry) 'promoted) (push k promoted) (push k partial))
        (should (= (* 10 (1+ k)) (nelisp-artifact-native-exec-general (car r) name '(10))))))
    ;; The diagnostic is visible: small loops are fully promoted, large ones are reported.
    (should (memq 1 promoted))
    (should (memq 6 partial))))

(ert-deftest nelisp-aot-fxloop/host-native-differential ()
  "Integer-only cases run on the host harness and equal GNU, including operand order."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let* ((r (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--host-source "hd" t))
         (art (car r)) (n 0)
         (mpf nelisp-aot-fxloop-gen--mpf) (mnf nelisp-aot-fxloop-gen--mnf))
    (with-temp-buffer (insert nelisp-aot-fxloop-gen--source) (goto-char (point-min))
                      (condition-case nil (while t (eval (read (current-buffer)) t)) (end-of-file nil)))
    (dolist (c `((fx-sum (0)) (fx-sum (1)) (fx-sum (2)) (fx-sum (1000)) (fx-sum2 (70)) (fx-sum3 (70))
                 (fx-neg (50)) (fx-neq (0)) (fx-neq (9)) (fx-and (10 4)) (fx-and (4 10))
                 (fx-down (5 5)) (fx-down (3 -2)) (fx-up (7 3)) (fx-up (0 0))
                 (fx-up (,(- mpf 3) ,mpf)) (fx-down (,(+ mnf 3) ,mnf)) (fx-not (12))
                 (fx-zero (0)) (fx-zero (9)) (fx-tree4 (1 10)) ))
      (let ((want (apply (car c) (cadr c)))
            (got (nelisp-artifact-native-exec-general art (symbol-name (car c)) (cadr c))))
        (should (equal want got))
        (cl-incf n)))
    (should (> n 20))))

(ert-deftest nelisp-aot-fxloop/mutation-old-temps-is-detected ()
  "Control: reading the old temporaries (no sequential setq) breaks fx-sum2 on the host."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let* ((good (car (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--host-source "mg" t)))
         (bad (car (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--host-source "mb" t 'old-temps))))
    (should (= 2485 (nelisp-artifact-native-exec-general good "fx-sum2" '(70))))
    (should-not (= 2485 (nelisp-artifact-native-exec-general bad "fx-sum2" '(70))))))

(defconst nelisp-aot-fxloop-test--closure-source
  "(defun fxc-before (n) (let* ((i 0) (f (lambda () i))) (while (< i n) (setq i (1+ i))) (funcall f)))
(defun fxc-after (n) (let ((i 0) (f nil)) (while (< i n) (setq i (1+ i))) (setq f (lambda () i)) (funcall f)))
(defun fxc-sets (n) (let* ((i 0) (f (lambda () (setq i (+ i 100)) i))) (while (< i n) (setq i (1+ i))) (funcall f)))
(defun fxc-other (n) (let ((i 0) (k 5)) (while (< i n) (setq i (1+ i))) (funcall (lambda () k))))\n")

(ert-deftest nelisp-aot-fxloop/closure-captured-variable-declines ()
  "A loop variable mentioned by any lambda of the function is not rewritten."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let ((log (cdr (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--closure-source "cl" t))))
    (should (member '(fxc-before declined (captured-by-lambda i)) log))
    (should (member '(fxc-after declined (captured-by-lambda i)) log))
    (should (member '(fxc-sets declined (captured-by-lambda i)) log))
    ;; A lambda that does not mention the loop variable does not block it.
    (should (member '(fxc-other applied nil) log))))

(ert-deftest nelisp-aot-fxloop/mutation-ignore-closures-is-detected ()
  "Control: with the closure scan off the captured loops are reported applied."
  (skip-unless (nelisp-aot-fxloop-test--tools-p))
  (let ((log (cdr (nelisp-aot-fxloop-test--compile nelisp-aot-fxloop-test--closure-source
                                                   "clm" t 'ignore-closures))))
    (should (member '(fxc-before applied nil) log))
    (should (member '(fxc-sets applied nil) log))))

(defun nelisp-aot-fxloop-test--quit-run (home mutation)
  "Run a 2e9-iteration fast loop with `quit-flag' set in HOME's image; return the output."
  (let* ((dir (make-temp-file "fxq" t))
         (src (expand-file-name "spin.el" dir))
         (art (expand-file-name "spin.neln" dir))
         (probe (expand-file-name "probe.el" dir))
         (settings nil)
         (lisp (file-name-directory (locate-library "nelisp-native-load.el"))))
    (unwind-protect
        (progn
          (with-temp-file src
            (insert "(defun fx-spin (n) (let ((i 0)) (while (< i n) (setq i (1+ i))) i))\n"))
          (let* ((nelisp-aot-compiler-fixnum-loops t)
                 (nelisp-aot-compiler--fxloop-mutation mutation))
            (nelisp-artifact-compile-file src art nil nil nil nil nil 'neln 'required)
            (setq settings (nelisp-native-load-codegen-settings)))
          (with-temp-file probe
            (insert (format "(load %S nil t)\n" (expand-file-name "nelisp-native-load.el" lisp)))
            ;; The image has no compiler, so it enforces the defaults unless told
            ;; what this artifact was built with (the non-default flags are the point).
            (insert (format "(setq nelisp-native-load-expected-codegen-settings '%S)\n" settings))
            (insert (format "(defun qt (tag n pre inh) (setq quit-flag pre) (setq inhibit-quit inh)
  (princ (format \"%%s %%S flag=%%S\\n\" tag
    (condition-case e (nelisp-native-load-call (nelisp-native-load-artifact %S \"fx-spin\") (list n)) (quit 'QUIT) (error (list 'ERR e)))
    quit-flag)))
(qt \"quit\" 2000000000 t nil)
(qt \"inhibit\" 300000 t t)
(qt \"clear\" 300000 nil nil)\n" art)))
          (with-temp-buffer
            (let ((default-directory (file-name-as-directory home)))
              (call-process "bash" nil t nil "-c"
                            (let ((dump (getenv "NELISP_AOT_FLAT_DUMP")))
                              (if (and dump (not (string-empty-p dump)))
                                  ;; Flat heap-snapshot boot (the image has the prelude).
                                  (format "ulimit -v 8388608; exec timeout 300 taskset -c 6,22 target/nelisp --cold-load-from %s --eval %s < /dev/null"
                                          (shell-quote-argument dump)
                                          (shell-quote-argument
                                           (format "(progn (nemacs-runtime-dump-reinit) (load %S nil t))" probe)))
                                (format "ulimit -v 8388608; exec timeout 300 target/nelisp --load %s -- < /dev/null"
                                        (shell-quote-argument probe))))))
            (buffer-string)))
      (delete-directory dir t))))

;; Needs NELISP_AOT_DIFF_HOME (a checkout with target/nelisp).  A pending
;; `quit-flag' is serviced at the first poll, so a 2e9-iteration fast loop
;; stops after one budget slice; without the poll it runs to completion.
(ert-deftest nelisp-aot-fxloop/quit-is-serviced-in-a-long-fast-loop ()
  (let ((home (getenv "NELISP_AOT_DIFF_HOME")))
    (skip-unless (and home (not (string-empty-p home))))
    (unless (file-executable-p (expand-file-name "target/nelisp" home))
      (error "NELISP_AOT_DIFF_HOME=%s has no executable target/nelisp" home))
    (let ((out (nelisp-aot-fxloop-test--quit-run home nil)))
      (should (string-match-p "^quit QUIT flag=nil$" out))
      (should (string-match-p "^inhibit 300000 flag=t$" out))
      (should (string-match-p "^clear 300000 flag=nil$" out)))))

(ert-deftest nelisp-aot-fxloop/mutation-no-poll-is-detected ()
  "Control: with no poll the same loop runs to completion and ignores the quit."
  (let ((home (getenv "NELISP_AOT_DIFF_HOME")))
    (skip-unless (and home (not (string-empty-p home))))
    (unless (file-executable-p (expand-file-name "target/nelisp" home))
      (error "NELISP_AOT_DIFF_HOME=%s has no executable target/nelisp" home))
    (let ((out (nelisp-aot-fxloop-test--quit-run home 'no-poll)))
      (should-not (string-match-p "^quit QUIT" out))
      (should (string-match-p "^quit 2000000000 flag=t$" out)))))

(provide 'nelisp-aot-fxloop-test)
