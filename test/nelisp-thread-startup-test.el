;;; nelisp-thread-startup-test.el --- Genuine launch source models -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tb--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tb--form (name &optional old)
  (let* ((file (if (memq name '(nl_root_frame_at nl_thread_registry_entry nl_thread_registry_store_top
                                nl_thread_registry_add nl_thread_registry_add_at
                                nl_thread_registry_add_startup nl_thread_registry_add_startup_at
                                nl_thread_registry_rollback_startup nl_exit_signal_w nl_exit_raise_w))
                   "lisp/nelisp-cc-rootstack.el" "scripts/nelisp-standalone-build.el"))
         (path (expand-file-name (concat (if old "target/typed-save/thread-birth/seed/" "") file) tb--root)))
    (with-temp-buffer
      (insert-file-contents path) (goto-char (point-min))
      (when (search-forward (format "(defun %s " name) nil t)
        (goto-char (match-beginning 0)) (read (current-buffer))))))
(defun tb--host (tree)
  (cond ((atom tree) tree)
        ((eq (car tree) 'data-addr) (pcase (cadr tree) ('nl_thread_registry 800000) ('nl_rootstack_top 800008) ('nl_rootstack_region 100000) ('nl_exit_values 700000)))
        ((eq (car tree) 'extern-call) (cons (cadr tree) (mapcar #'tb--host (cddr tree))))
        ((memq (car tree) '(if while))
         (cons (car tree) (cons (list 'sst--truth (tb--host (cadr tree))) (mapcar #'tb--host (cddr tree)))))
        (t (cons (pcase (car tree) ('seq 'progn) ('shl 'ash) ('sar 'sst--sar) (_ (tb--host (car tree)))) (mapcar #'tb--host (cdr tree))))))
(defun tb--run (&optional config old mutant child)
  (let ((mem (make-hash-table :test #'eql)) (objects (make-hash-table :test #'eql))
        (symbols (make-hash-table :test #'equal)) (next 2000000) trace saved (root-calls 0)
        (conses 0) (buffer 900006) (form 900002) (parent 1024) (child-env 1048576))
    (cl-labels
        ((rd (p o) (gethash (+ p o) mem 0))
         (wr (p o v)
           (when (and (= (+ p o) 800000) (> v 0) (not old) (not (plist-get config :preload)))
             (let* ((e (rd (+ 800016 (* (- v 1) 16)) 0)) (slot (rd e 168)))
               (should (= slot (+ e 4128))) (should (/= (rd slot 0) 3))
               (should (= (rd slot 8) (+ 1 (* e 4)))) (should (= (rd slot 16) 1))
               (should (= (rd (+ 800016 (* (- v 1) 16)) 8) (+ e 4160)))))
           (push (list 'write p o v) trace) (puthash (+ p o) v mem) 1)
         (object (w) (or (gethash w objects) (error "Unrooted/dead object %S" w)))
         (collect ()
           (unless old
             (let ((live (make-hash-table :test #'eql)))
               (cl-labels ((mark (w)
                            (unless (gethash w live)
                              (puthash w t live)
                              (when (consp (gethash w objects))
                                (mark (car (gethash w objects))) (mark (cdr (gethash w objects)))))))
                 (mark form) (mark buffer)
                 (cl-loop for p from 100000 below (rd 800008 0) by 8 do (mark (rd p 0)))
                 (dotimes (i (rd 800000 0))
                   (let* ((entry (+ 800016 (* i 16))) (e (rd entry 0)))
                     (cl-loop for p from (+ e 4096) below (rd entry 8) by 8 do (mark (rd p 0)))))
                 (maphash (lambda (w value) (when (and (consp value) (not (gethash w live))) (remhash w objects))) objects)))))
         (consw (a b) (collect) (let ((w (+ (cl-incf next 8) 2))) (puthash w (cons a b) objects) (cl-incf conses) w))
         (decode (w) (let ((x (gethash w objects))) (if (consp x) (cons (decode (car x)) (decode (cdr x))) (or x (if (equal w 3) nil w)))))
         (reserve (env n)
           (cl-incf root-calls)
           (if (= root-calls (or (plist-get config :root-fail) -1)) 0
             (nl_root_frame_at env 0 n)))
         (call (name &rest args) (push (cons name args) trace) 0))
      (puthash form '(original . 3) objects) (puthash buffer 'BUFFER objects)
      (puthash 900014 'WRONG-BUFFER objects)
      (puthash 800008 100000 mem) (puthash (+ parent 112) (or (plist-get config :env-flags) 0) mem)
      (puthash 920014 'original-condition objects) (puthash 920006 'void-variable objects)
      (let ((kind (plist-get config :pending-before)))
        (puthash 268435472 (if (eq kind t) 1 (or kind 0)) mem))
      (puthash 700000 920014 mem) (puthash 700008 169 mem)
      (when (plist-get config :full) (puthash 800000 64 mem))
      (cl-letf (((symbol-function 'ptr-read-u64) #'rd) ((symbol-function 'heap-read-u64) #'rd)
                ((symbol-function 'ptr-write-u64) #'wr) ((symbol-function 'nl_rootstack_end) (lambda () 200000))
                ((symbol-function 'nl_root_mark) (lambda (_e) (rd 800008 0)))
                ((symbol-function 'nl_root_frame) #'reserve)
                ((symbol-function 'nl_root_release) (lambda (_e mark) (wr 800008 0 mark)))
                ((symbol-function 'atomic-fetch-add) (lambda (p n) (let ((v (rd p 0))) (wr p 0 (+ v n)) v)))
                ((symbol-function 'atomic-compare-exchange) (lambda (p a b) (if (= (rd p 0) a) (progn (wr p 0 b) 1) 0)))
                ((symbol-function 'wf_arg_ptr) (lambda (_a _i) form)) ((symbol-function 'nl_word_canon) #'identity)
                ((symbol-function 'nelisp_env_lookup_function_w)
                 (lambda (&rest _)
                   (call 'public-lookup)
                   (pcase (plist-get config :public)
                     ('missing 2) ('raising (error "Public getter must not run"))
                     (_ (if (plist-get config :lookup-fail) 2 910006)))))
                ((symbol-function 'wf_word_view) #'identity)
                ((symbol-function 'nl_apply_function_w)
                 (lambda (&rest _)
                   (call 'public-apply) (call 'capture buffer)
                   (if (plist-get config :capture-fail) 0 (if (eq (plist-get config :public) 'redefined) 900014 buffer))))
                ((symbol-function 'nl_sym_find_value_w)
                 (lambda (_env sym _pad)
                   (should (eq (gethash sym objects) 'nelisp--current-buffer))
                   (call 'capture buffer)
                   (when (plist-get config :private-pending)
                     (nl_exit_raise_w (let ((v (plist-get config :private-pending))) (if (eq v t) 1 v)) 920014 169))
                   (cond ((plist-get config :lookup-fail) 2)
                         ((plist-get config :capture-fail) 0)
                         (t buffer))))
                ((symbol-function 'nl_stash_void_variable)
                 (lambda (_env sym)
                   (should (eq (gethash sym objects) 'nelisp--current-buffer))
                   (should (cl-loop for p from 100000 below (rd 800008 0) by 8 thereis (= (rd p 0) sym)))
                   (call 'condition 'void-variable 'nelisp--current-buffer)
                   (nl_exit_signal_w 920006 (consw sym 3)) 1))
                ((symbol-function 'nl_val_clone_into) (lambda (word out) (wr out 0 word)))
                ((symbol-function 'alloc-bytes) (lambda (&rest _) (collect) (cl-incf next 32)))
                ((symbol-function 'nl_alloc_symbol_w)
                 (lambda (p n _pad)
                   (let ((name (apply #'string (cl-loop for i below n collect (logand 255 (ash (rd p (* (/ i 8) 8)) (- (* (% i 8) 8))))))))
                     (or (gethash name symbols) (let ((w (+ (cl-incf next 8) 6))) (puthash w (intern name) objects) (puthash name w symbols) w)))))
                ((symbol-function 'wf_bytecode_w_cons2) #'consw)
                ((symbol-function 'nl_thread_mirror_condition_init) (lambda () (call 'condition-init)))
                ((symbol-function 'nl_os_alloc_chunk) (lambda (_n) child-env))
                ((symbol-function 'nl_frame_stack_inherit) (lambda (&rest _) (call 'inherit) (if (plist-get config :inherit-fail) 1 0)))
                ((symbol-function 'nl_os_free_chunk) (lambda (&rest args) (apply #'call 'free args)))
                ((symbol-function 'bf_signal_memory_full) (lambda () (call 'memory-full)))
                ((symbol-function 'wf_bytecode_root_exhausted) (lambda () (call 'root-failure)))
                ((symbol-function 'nl_spin_zero) (lambda (_p) (call 'ack) (collect) (wr 268435688 0 0)))
                ((symbol-function 'nl_imm_int) (lambda (n) (+ (* n 4) 1)))
                ((symbol-function 'nelisp_eval_call_w)
                 (lambda (w env _pad) (collect) (call 'evaluate (decode w) env) 3))
                ((symbol-function 'nl_frame_stack_retire_env) (lambda (e _p) (call 'retire e)))
                ((symbol-function 'syscall-direct)
                 (lambda (nr &rest args)
                   (call 'syscall nr)
                   (pcase nr (9 (if (plist-get config :mmap-fail) -12 4194304))
                     (56 (if (plist-get config :clone-fail) -11 42))
                     (60 (throw 'tb-exit 0)) (_ 0)))))
        (unwind-protect
            (progn
              (dolist (n '(nl_copy_words nl_thread_startup_name nl_thread_capture_buffer nl_thread_startup_form nl_make_thread_env
                           nl_thread_run nl_thread_spawn_rollback nl_thread_spawn_dispatch nl_thread_spawn_start bf_thread_spawn_w
                           nl_root_frame_at nl_thread_registry_entry nl_thread_registry_store_top nl_thread_registry_add
                           nl_thread_registry_add_at nl_thread_registry_add_startup_at nl_thread_registry_add_startup
                           nl_thread_registry_rollback_startup nl_exit_signal_w nl_exit_raise_w))
                (let ((f (tb--form n old)))
                  (when (and (eq n 'nl_thread_capture_buffer) (plist-get config :capture-before))
                    (setq f (with-temp-buffer
                              (insert-file-contents (expand-file-name "target/typed-save/thread-birth/private-capture/before/builder.el" tb--root))
                              (search-forward "(defun nl_thread_capture_buffer ")
                              (goto-char (match-beginning 0)) (read (current-buffer)))))
                  (when (and (eq n 'nl_thread_capture_buffer) (plist-get config :kind-before))
                    (setq f (with-temp-buffer
                              (insert-file-contents (expand-file-name "target/typed-save/thread-birth/pending-kind/before/builder.el" tb--root))
                              (search-forward "(defun nl_thread_capture_buffer ")
                              (goto-char (match-beginning 0)) (read (current-buffer)))))
                  (when f
                    (push (cons n (and (fboundp n) (symbol-function n))) saved)
                    (when (and (eq mutant 'unrooted) (eq n 'nl_thread_registry_add_startup_at))
                      (setq f (cl-subst '(ptr-write-u64 slots 0 3) '(ptr-write-u64 slots 0 startup) f :test #'equal)))
                    (when (and (eq mutant 'early-count) (eq n 'nl_thread_registry_add_startup_at))
                      (setq f (cl-subst '(seq (ptr-write-u64 (data-addr nl_thread_registry) 0 (+ i 1)) (ptr-write-u64 entry 0 env))
                                       '(ptr-write-u64 entry 0 env) f :test #'equal)))
                    (when (and (eq mutant 'clone) (eq n 'nl_thread_spawn_dispatch))
                      (setq f (cl-subst '(> tid 0) '(< tid 0) f :test #'equal)))
                    (when (and (eq mutant 'buffer) (eq n 'nl_thread_capture_buffer))
                      (setq f (cl-subst '(setq word 900014)
                                       '(setq word (nl_sym_find_value_w env (ptr-read-u64 root 0) 0)) f :test #'equal)))
                    (fset n (eval (cons 'lambda (cddr (tb--host f))) t)))))
              (let* ((result (bf_thread_spawn_w 0 parent 0)) (slot (rd child-env 168))
                     (startup (and (> slot 0) (rd slot 0)))
                     (graph (and startup (decode startup)))
                     (body-word (and startup (not old) (car (object (cdr (object (cdr (object startup)))))))))
                (when child (catch 'tb-exit (nl_thread_run slot)))
                (list :result result :trace (reverse trace) :graph graph :count (rd 800000 0) :pending (rd 268435472 0)
                      :env-flags (rd parent 112) :exit-tag (decode (rd 700000 0)) :exit-value (decode (rd 700008 0))
                      :slot slot :done (and (> slot 0) (rd slot 16)) :top (rd 800008 0) :conses conses
                      :original-form-identical (eq body-word form))))
          (dolist (pair saved) (if (cdr pair) (fset (car pair) (cdr pair)) (fmakunbound (car pair)))))))))
(defun tb--positive (r)
  (should (= (plist-get r :result) 5)) (should (= (plist-get r :count) 1))
  (should (cl-find 'capture (plist-get r :trace) :key #'car))
  (should (= (plist-get r :top) 100000)) (should (= (plist-get r :conses) 13))
  (should (plist-get r :original-form-identical))
  (let ((graph (plist-get r :graph)) (trace (plist-get r :trace)))
    (should (eq (car graph) 'let))
    (should (equal (sort (mapcar #'car (cadr graph)) (lambda (a b) (string< (symbol-name a) (symbol-name b))))
                   '(nelisp--current-buffer nelisp-buffer--current)))
    (dolist (binding (cadr graph)) (should (equal (cadr binding) '(quote BUFFER))))
    (should (equal (caddr graph) '(original)))
    (should (< (cl-position 'capture trace :key #'car) (cl-position 'inherit trace :key #'car)))))
(ert-deftest tb-startup-genuine-source-and-root-handoff () (tb--positive (tb--run)))
(ert-deftest tb-old-source-desired-result-red ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/thread-birth/seed/lisp/nelisp-cc-rootstack.el" tb--root)))
  (should-error (tb--positive (tb--run nil t)) :type 'ert-test-failed))
(ert-deftest tb-root-and-registry-refusals ()
  (dolist (config '((:root-fail 1) (:root-fail 2) (:root-fail 3) (:full t) (:lookup-fail t) (:capture-fail t) (:inherit-fail t)))
    (let ((r (tb--run config)))
      (should (= (plist-get r :result) 0)) (should (= (plist-get r :top) 100000))
      (should (= (plist-get r :count) (if (plist-get config :full) 64 0)))
      (should-not (cl-find 'ack (plist-get r :trace) :key #'car)))))
(ert-deftest tb-pre-child-os-failures-owned-rollback ()
  (dolist (config '((:mmap-fail t) (:clone-fail t)))
    (let ((r (tb--run config)))
      (should (= (plist-get r :result) 0)) (should (= (plist-get r :count) 0))
      (should-not (cl-find 'ack (plist-get r :trace) :key #'car))
      (should (cl-find 'free (plist-get r :trace) :key #'car)))))
(ert-deftest tb-child-retirement-clears-form-before-done ()
  (let* ((r (tb--run nil nil nil t)) (trace (plist-get r :trace)))
    (should (= (plist-get r :done) 5))
    (should (< (cl-position 'evaluate trace :key #'car) (cl-position 'retire trace :key #'car)))
    (let ((clear (cl-position (list 'write (plist-get r :slot) 0 3) trace :test #'equal
                              :start (cl-position 'retire trace :key #'car)))
          (publish (cl-position (list 'write (+ (plist-get r :slot) 16) 0 5) trace :test #'equal)))
      (should (< (cl-position 'retire trace :key #'car) clear)) (should (< clear publish)))
    (should (= (plist-get r :count) 1))))
(ert-deftest tb-actual-source-mutants-rejected ()
  (tb--positive (tb--run))
  (dolist (mutant '(unrooted early-count buffer)) (should-error (tb--positive (tb--run nil nil mutant)) :type 'ert-test-failed))
  (let ((r (tb--run '(:clone-fail t) nil 'clone)))
    (should-error (should-not (cl-find 'ack (plist-get r :trace) :key #'car)) :type 'ert-test-failed)))
(ert-deftest tb-id2-registration-and-provider-unchanged ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/thread-birth/seed/lisp/nelisp-cc-rootstack.el" tb--root)))
  (dolist (name '(nl_thread_registry_add nl_thread_registry_add_at)) (should (equal (tb--form name) (tb--form name t)))))
(ert-deftest tb-direct-preflight-capacity-and-foreign-owner-unchanged ()
  (let ((memory (make-hash-table :test #'eql)) saved)
    (cl-labels ((rd (p o) (gethash (+ p o) memory 0))
                (wr (p o v) (puthash (+ p o) v memory) 1)
                (snapshot () (let (rows) (maphash (lambda (k v) (push (cons k v) rows)) memory) (sort rows (lambda (a b) (< (car a) (car b)))))))
      (cl-letf (((symbol-function 'ptr-read-u64) #'rd) ((symbol-function 'heap-read-u64) #'rd)
                ((symbol-function 'ptr-write-u64) #'wr))
        (unwind-protect
            (progn
              (dolist (n '(nl_thread_registry_entry nl_thread_registry_add_startup_at nl_thread_registry_rollback_startup nl_root_frame_at))
                (push (cons n (and (fboundp n) (symbol-function n))) saved)
                (fset n (eval (cons 'lambda (cddr (tb--host (tb--form n)))) t)))
              (dolist (case '((64 1048576 10 0 0) (-1 1048576 10 0 0)
                              (0 1048584 10 0 0) (0 2305843009213693952 10 0 0)
                              (0 1048576 13 0 0) (0 1048576 10 8 0) (0 1048576 10 0 1)))
                (clrhash memory)
                (pcase-let ((`(,i ,env ,startup ,shift ,owner) case))
                  (wr env 120 (+ env 4096 shift)) (wr env 168 owner)
                  (let ((before (snapshot)))
                    (should (= (nl_thread_registry_add_startup_at env startup i) -1))
                    (should (equal before (snapshot))))))
              (clrhash memory) (wr 1048576 120 (+ 1048576 4096))
              (let ((before (snapshot)))
                (should (= (nl_root_frame_at 1048576 800016 131073) 0))
                (should (equal before (snapshot))))
              (wr 800000 0 2) (wr (+ 800016 16) 0 2097152)
              (wr 1048576 168 (+ 1048576 4128))
              (let ((before (snapshot)))
                (should (= (nl_thread_registry_rollback_startup 1048576) 1))
                (should (equal before (snapshot)))))
          (dolist (pair saved) (if (cdr pair) (fset (car pair) (cdr pair)) (fmakunbound (car pair)))))))))
(ert-deftest tb-genuine-inheritance-checked-root-and-pending-status ()
  (let ((saved (and (fboundp 'nl_frame_stack_inherit) (symbol-function 'nl_frame_stack_inherit))))
    (unwind-protect
        (progn
          (fset 'nl_frame_stack_inherit (eval (cons 'lambda (cddr (tb--host (tb--form 'nl_frame_stack_inherit)))) t))
          (dolist (mode '(root-fail pending-before pending-after capture-fail push-fail success pending-before2 pending-after2 unrelated-env-flags))
            (let ((flag (pcase mode ('pending-before 1) ('pending-before2 2) (_ 0))) trace)
              (cl-letf (((symbol-function 'nl_root_mark) (lambda (_e) 100))
                        ((symbol-function 'nl_root_frame) (lambda (_e n) (should (= n 1)) (if (eq mode 'root-fail) 0 200)))
                        ((symbol-function 'nl_root_word) (lambda (&rest _) (ert-fail "Unrooted fallback")))
                        ((symbol-function 'nl_root_release) (lambda (_e mark) (should (= mark 100)) (push 'release trace)))
                        ((symbol-function 'wf_bytecode_root_exhausted) (lambda () (push 'root-failure trace)))
                        ((symbol-function 'heap-read-u64)
                         (lambda (p o) (cond ((and (= p 268435472) (= o 0)) flag)
                                            ((and (= p 1024) (= o 112)) 3)
                                            ((and (= p 200) (= o 0)) 3) (t 0))))
                        ((symbol-function 'ptr-write-u64) (lambda (&rest _) (push 'root-captured trace)))
                        ((symbol-function 'nl_alloc_vector) (lambda (_n) (push 'allocate trace) 500))
                        ((symbol-function 'nl_thread_parent_unshallow)
                         (lambda (_e) (push 'unshallow trace)
                           (when (memq mode '(pending-after pending-after2)) (setq flag (if (eq mode 'pending-after2) 2 1)))))
                        ((symbol-function 'nl_env_capture_lexical_with_filter_w) (lambda (&rest _) (push 'capture trace) (if (eq mode 'capture-fail) 0 3)))
                        ((symbol-function 'nl_record_type_word) (lambda (_e) 7))
                        ((symbol-function 'record-make) (lambda (&rest _) (push 'record trace)))
                        ((symbol-function 'record-slot-set) (lambda (&rest _) (push 'slot trace)))
                        ((symbol-function 'wf_word_view) #'identity)
                        ((symbol-function 'nl_env_push_captured) (lambda (&rest _) (push 'install trace) (when (eq mode 'push-fail) (setq flag 1)))))
                (should (= (nl_frame_stack_inherit 1024 4096 0 0) (if (memq mode '(success unrelated-env-flags)) 0 1)))
                (should (= (cl-count 'release trace) 1))
                (when (memq mode '(root-fail pending-before pending-before2)) (should-not (memq 'unshallow trace)) (should-not (memq 'allocate trace)))
                (when (memq mode '(root-fail pending-before pending-before2 pending-after pending-after2 capture-fail)) (should-not (memq 'install trace)))))))
      (if saved (fset 'nl_frame_stack_inherit saved) (fmakunbound 'nl_frame_stack_inherit)))))
(ert-deftest tb-private-buffer-capture-public-cell-independent ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/thread-birth/private-capture/before/builder.el" tb--root)))
  (dolist (mode '(missing redefined raising))
    (let ((r (tb--run (list :public mode))))
      (tb--positive r)
      (should-not (cl-find 'public-lookup (plist-get r :trace) :key #'car))
      (should-not (cl-find 'public-apply (plist-get r :trace) :key #'car))))
  ;; Execute the preserved sealed helper, not a missing-definition surrogate.
  (should-error (tb--positive (tb--run '(:public missing :capture-before t))) :type 'ert-test-failed))
(ert-deftest tb-private-buffer-capture-void-and-pending-ownership ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/thread-birth/private-capture/before/builder.el" tb--root)))
  (cl-labels ((refused (r)
               (should (= (plist-get r :result) 0)) (should (= (plist-get r :count) 0))
               (should (= (plist-get r :top) 100000))
               (should-not (cl-find 'inherit (plist-get r :trace) :key #'car))
               (should-not (cl-find 'syscall (plist-get r :trace) :key #'car)))
             (void-result (r)
               (refused r) (should (= (plist-get r :pending) 1))
               (should (eq (plist-get r :exit-tag) 'void-variable))
               (should (equal (plist-get r :exit-value) '(nelisp--current-buffer)))
               (should (member '(condition void-variable nelisp--current-buffer) (plist-get r :trace)))))
    (void-result (tb--run '(:lookup-fail t)))
    (should-error (void-result (tb--run '(:lookup-fail t :capture-before t))) :type 'ert-test-failed)
    (dolist (config '((:pending-before 1) (:pending-before 2) (:private-pending 1) (:private-pending 2) (:private-pending 1 :lookup-fail t) (:private-pending 2 :lookup-fail t)))
      (let ((r (tb--run config)))
        (refused r) (should (= (plist-get r :pending) (or (plist-get config :pending-before) (plist-get config :private-pending))))
        (should (eq (plist-get r :exit-tag) 'original-condition))
        (should (= (plist-get r :exit-value) 169))
        (should-not (cl-find 'condition (plist-get r :trace) :key #'car))))
    (dolist (flags '(1 2 3))
      (let ((r (tb--run (list :env-flags flags))))
        (tb--positive r) (should (= (plist-get r :pending) 0))
        (should (= (plist-get r :env-flags) flags))))
    (should-error (refused (tb--run '(:pending-before 2 :kind-before t))) :type 'ert-test-failed)
    (should-error (tb--positive (tb--run '(:env-flags 1 :kind-before t))) :type 'ert-test-failed)
    (let ((r (tb--run '(:root-fail 2))))
      (refused r) (should (cl-find 'root-failure (plist-get r :trace) :key #'car)))))
(provide 'nelisp-thread-startup-test)
