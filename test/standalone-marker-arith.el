;;; standalone-marker-arith.el --- markers in arithmetic, buffer-modified-p -*- lexical-binding: t; -*-
;; GNU accepts markers wherever `number-or-marker-p' is named, and provides
;; `buffer-modified-p' / `set-buffer-modified-p'.  Exits non-zero on mismatch.
(defvar nm--fail nil)
(defmacro nm--check (form expected)
  `(let ((got (condition-case e ,form (error (list 'ERR (car e))))))
     (unless (equal got ,expected)
       (setq nm--fail t)
       (princ (format "MISMATCH %S => %S (want %S)\n" ',form got ,expected)))))
(nelisp-marker-arith-call '(+ - * / < > <= >= = /= max min % mod)
 (lambda ()
(with-temp-buffer
  (insert "hello world abc")
  (let ((m (copy-marker 5)) (m2 (point-marker)) (nowhere (make-marker)))
    (nm--check (< m 9) t)
    (nm--check (> m 2) t)
    (nm--check (<= m m2) t)
    (nm--check (>= m 1) t)
    (nm--check (= m m) t)
    (nm--check (= 5 m) t)
    (nm--check (/= m 3) t)
    (nm--check (< 1 m 9) t)
    (nm--check (+ m 1) 6)
    (nm--check (+ m m) 10)
    (nm--check (- m 1) 4)
    (nm--check (- m) -5)
    (nm--check (* m 2) 10)
    (nm--check (/ m 1) 5)
        (nm--check (max m 1) 5)
    (nm--check (min m 9) 5)
    (nm--check (% m 2) 1)
    (nm--check (mod m 2) 1)
    (nm--check (+ nowhere 1) '(ERR error))
    (nm--check (+ 1 2) 3)
    (nm--check (+ 'a 1) '(ERR wrong-type-argument))
    (nm--check (set-buffer-modified-p nil) nil)
    (nm--check (buffer-modified-p) nil)
    (insert "x")
    (nm--check (buffer-modified-p) t)
    (nm--check (progn (set-buffer-modified-p nil) (buffer-modified-p)) nil)))))
(when nm--fail (kill-emacs 1))
(princ "OK\n")
