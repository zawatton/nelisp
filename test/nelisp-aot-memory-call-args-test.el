;;; nelisp-aot-memory-call-args-test.el --- Ordered GP read arguments -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-memory-call-test--wrap (n)
  (let ((v (logand n (1- (ash 1 64))))) (if (>= v (ash 1 63)) (- v (ash 1 64)) v)))
(defun nelisp-aot-memory-call-test--run (source)
  (let ((p (make-temp-file "memory-call-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp source p) (call-process p nil nil nil))
      (delete-file p))))
(defun nelisp-aot-memory-call-test--ref (n)
  (nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp))
(defun nelisp-aot-memory-call-test--load (slot)
  (nelisp-aot-compiler--make-ir 'ptr-read-u64
   :ptr (nelisp-aot-memory-call-test--ref slot)
   :offset (nelisp-aot-compiler--make-ir 'imm :value 0)))
(ert-deftest nelisp-aot-memory-call-args/preflight ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p nil)
         (nelisp-aot-compiler--promoted-slots nil)
         (read (nelisp-aot-memory-call-test--load 0))
         (node (nelisp-aot-compiler--make-ir 'call :name 'callee :args (list read read read))))
    (should (equal 2 (plist-get (nelisp-aot-compiler--x86-memory-call-args-plan node) :staged)))
    (dolist (n '(1 2 3))
      (should (= (1- n) (plist-get (nelisp-aot-compiler--x86-memory-call-args-plan
                                   (nelisp-aot-compiler--ir-with node :args (make-list n read))) :staged))))
    (dolist (property '(:varargs-p :fn-value :internal-boundary-disp))
      (should-not (nelisp-aot-compiler--x86-memory-call-args-plan
                   (nelisp-aot-compiler--ir-with node property t))))
    (dolist (bad (list (nelisp-aot-compiler--ir-with node :ret-class 'f64)
                       (nelisp-aot-compiler--ir-with node :args (make-list 7 read))
                       (nelisp-aot-compiler--ir-with node :args
                        (list read (nelisp-aot-compiler--make-ir 'call :name 'effect :args nil)))
                       (nelisp-aot-compiler--ir-with node :args
                        (list read (nelisp-aot-compiler--make-ir 'setq-local :slot 0 :value read)))
                       (nelisp-aot-compiler--ir-with node :args
                        (list (nelisp-aot-compiler--ir-with read :root-p t)))
                       (nelisp-aot-compiler--ir-with node :args
                        (list (nelisp-aot-compiler--ir-with read :class 'f64)))))
      (should-not (nelisp-aot-compiler--x86-memory-call-args-plan bad)))
    (dolist (mode '(checked lisp frame win64 argreg scratch))
      (let ((nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (nelisp-aot-compiler--runtime-entry-params (and (eq mode 'lisp) '(x)))
            (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p (eq mode 'frame))
            (nelisp-aot-compiler--abi (if (eq mode 'win64) 'win64 'sysv))
            (nelisp-aot-compiler--promoted-slots
             (pcase mode ('argreg '((0 . rdi))) ('scratch '((9 . r10))))))
        (should-not (nelisp-aot-compiler--x86-memory-call-args-plan node))))))
(defconst nelisp-aot-memory-call-test--configs '((1 0) (2 0) (2 1) (3 2) (6 0) (6 1) (6 5)))
(defun nelisp-aot-memory-call-test--args (n last)
  (cl-loop for k below n collect
           (if (> k last) `(+ (logxor v18 v17) ,(+ 31 k))
             (let ((read `(ptr-read-u64 p (* (+ i ,k) 8))))
               (cond ((= k 3) `(+ ,read (ptr-read-u64 p (* (+ i ,(1+ k)) 8))))
                     ((= k 5) `(+ (+ ,read (ptr-read-u64 p (* (+ i 6) 8)))
                                   (+ (ptr-read-u64 p (* (+ i 7) 8))
                                      (ptr-read-u64 p (* (+ i 8) 8)))))
                     (t read))))))
(defun nelisp-aot-memory-call-test--golden (args words x y)
  (let ((bindings `((p 0) (i 1) (v18 ,x) (v17 ,y))))
    (cl-letf (((symbol-function 'ptr-read-u64)
               (lambda (p off) (nth (/ (+ p off) 8) words))))
      (nelisp-aot-memory-call-test--wrap
       (cl-loop for a in args for k from 0 sum (* (eval `(let ,bindings ,a) t) (+ 3 (* k 2))))))))
(ert-deftest nelisp-aot-memory-call-args/gnu-native-fullword ()
  (let ((cases 0))
    (dolist (seed '(0 -1 1311768467139281697 -81985529216486896))
      (let ((words (cl-loop for k below 12 collect (logand (+ seed (* k 4294967311)) (1- (ash 1 64)))))
            (x 1099511627783) (y -17179869193))
        (dolist (config nelisp-aot-memory-call-test--configs)
          (let* ((n (car config)) (args (nelisp-aot-memory-call-test--args n (cadr config)))
                 (vars (cl-loop for k below n collect (intern (format "a%d" k))))
                 (sum (cons '+ (cl-loop for v in vars for k from 0 collect `(* ,v ,(+ 3 (* k 2))))))
                 (expected (nelisp-aot-memory-call-test--golden args words x y)))
            (should (= 0 (nelisp-aot-memory-call-test--run
                          `(seq (defun opaque (x) (+ x 17))
                                (defun callee ,vars ,sum)
                                (defun f (p i v18 v17) (opaque 0) (callee ,@args))
                                (defun run ()
                                  (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                                    ,@(cl-loop for v in words for k from 0 collect `(ptr-write-u64 p ,(* k 8) ,v))
                                    (if (= (f p 1 ,x ,y) ,expected) 0 1)))
                                (exit (run))))))
            (setq cases (1+ cases))))))
    (message "Memory GP argument GNU/native fullword cases:%d" cases)))
(ert-deftest nelisp-aot-memory-call-args/effects-and-word-guards ()
  (should (= 0 (nelisp-aot-memory-call-test--run
                 '(seq (defun opaque (x) (+ x 17))
                       (defun callee (a b) (- a b))
                       (defun f (p) (opaque 0)
                         (callee (ptr-read-u64 p 0)
                                 (seq (ptr-write-u64 p 0 9) (ptr-read-u64 p 0))))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u64 p 0 5) (if (= (f p) -4) 0 1)))
                       (exit (run))))))
  (should (= 0 (nelisp-aot-memory-call-test--run
                 '(seq (defun callee (x) x)
                       (defun tag (w)
                         (if (= (logand w 7) 2) (callee 7)
                           (if (= (logand w 7) 6)
                               (callee (logand (ptr-read-u8 (- w 6) 0) 63))
                             (callee 0))))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u8 p 0 141)
                           (if (= (+ (tag 2) (tag 3) (tag (+ p 6))) 20) 0 1)))
                       (exit (run)))))))
(defvar nelisp-aot-memory-call-test--current nil)
(ert-deftest nelisp-aot-memory-call-args/source-stages-only-two ()
  (let ((call (symbol-function 'nelisp-aot-compiler--emit-call))
        (push (symbol-function 'nelisp-aot-compiler--emit-temp-push))
        (pop (symbol-function 'nelisp-aot-compiler--emit-temp-pop))
        (pushes 0) (pops 0) (path (make-temp-file "memory-call-shape-")))
    (unwind-protect
        (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-call)
                   (lambda (node buf)
                     (let ((nelisp-aot-memory-call-test--current
                            (eq (nelisp-aot-compiler--ir-get node :name) 'callee)))
                       (funcall call node buf))))
                  ((symbol-function 'nelisp-aot-compiler--emit-temp-push)
                   (lambda (&rest args)
                     (when nelisp-aot-memory-call-test--current (cl-incf pushes)) (apply push args)))
                  ((symbol-function 'nelisp-aot-compiler--emit-temp-pop)
                   (lambda (&rest args)
                     (when nelisp-aot-memory-call-test--current (cl-incf pops)) (apply pop args))))
          (nelisp-aot-compile-sexp
           '(seq (defun callee (a b c) (+ a b c))
                 (defun f (p) (callee (ptr-read-u64 p 0) (ptr-read-u64 p 8) (ptr-read-u64 p 16)))
                 (exit 0)) path))
      (delete-file path))
    (message "Memory GP source marshalling: push%d pop%d" pushes pops)
    (should (= pushes 4)) (should (= pops 4))))
(defvar nelisp-aot-memory-call-test--stages nil)
(defvar nelisp-aot-memory-call-test--depths nil)
(defun nelisp-aot-memory-call-test--record (fn node)
  (let ((plan (funcall fn node)))
    (when plan
      (push (plist-get plan :staged) nelisp-aot-memory-call-test--stages)
      (push nelisp-aot-compiler--rsp-temp-depth nelisp-aot-memory-call-test--depths)) plan))
(ert-deftest nelisp-aot-memory-call-args/native-c-abi ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "memory-call-abi-" t))
         (c (expand-file-name "callee.c" dir)) (obj (expand-file-name "callee.o" dir))
         (probe (expand-file-name "probe.o" dir)) (bin (expand-file-name "probe" dir))
         (words (cl-loop for k below 12 collect (logand (+ -81985529216486896 (* k 4294967311)) (1- (ash 1 64)))))
         (nelisp-aot-memory-call-test--stages nil) (nelisp-aot-memory-call-test--depths nil) (cases 0))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\nuint64_t words[]={")
            (insert (mapconcat (lambda (v) (format "UINT64_C(%d)" v)) words ",")) (insert "};\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\nlea words(%rip),%rdi\\ncall probe\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (dolist (n '(1 2 3 6))
              (insert (format "uint64_t ext%d(%s){\n" n
                              (mapconcat (lambda (k) (format "uint64_t a%d" k)) (number-sequence 0 (1- n)) ",")))
              (insert "if((uintptr_t)__builtin_frame_address(0)&15)__builtin_trap();\nreturn ")
              (insert (mapconcat (lambda (k) (format "a%d*UINT64_C(%d)" k (+ 3 (* k 2)))) (number-sequence 0 (1- n)) "+"))
              (insert ";}\n")))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer"
                                    "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--x86-memory-call-args-plan :around #'nelisp-aot-memory-call-test--record)
          (dolist (config nelisp-aot-memory-call-test--configs)
            (dolist (nested '(nil t))
              (let* ((n (car config)) (args (nelisp-aot-memory-call-test--args n (cadr config)))
                     (vars (cl-loop for k below 19 collect (intern (format "v%d" k))))
                     (values (cl-loop for k below 19 collect (* (if (zerop (logand k 1)) 1 -1) (+ 1099511627783 (* k 4294967311)))))
                     (golden (nelisp-aot-memory-call-test--wrap
                              (+ (nelisp-aot-memory-call-test--golden args words (nth 18 values) (nth 17 values))
                                 (if nested (* (car values) (cadr values)) 0))))
                     (call `(extern-call ,(intern (format "ext%d" n)) ,@args))
                     (expr (if nested `(+ (* ,(car vars) ,(cadr vars)) ,call) call)))
                (nelisp-aot-compile-to-object
                 `(seq (defun seed (x) x)
                       (defun probe (p)
                         (let* ,(append (cl-mapcar (lambda (v n) (list v `(seed ,n))) vars values) '((i (seed 1))))
                           (if (= ,expr ,golden) 0 1)))) probe)
                (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj probe "-o" bin)))
                (should (= 0 (call-process bin nil nil nil))) (cl-incf cases))))
          (should (equal '(0 1 2) (sort (delete-dups nelisp-aot-memory-call-test--stages) #'<)))
          (should (member 0 nelisp-aot-memory-call-test--depths))
          (should (member 1 nelisp-aot-memory-call-test--depths))
          (message "Memory GP C ABI cases:%d; staging0/1/2, incomingdepth0/1" cases))
      (advice-remove 'nelisp-aot-compiler--x86-memory-call-args-plan #'nelisp-aot-memory-call-test--record)
      (delete-directory dir t))))
(provide 'nelisp-aot-memory-call-args-test)
