;;; standalone-abi-readerio-word-check.el --- Reader/IO WORD producers -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later

(let ((checks 0))
  (dolist (case '(("nil" nil 3) ("t" t 1) ("0" 0 1) ("-7" -7 2)
                  ("\"text\"" "text" 6) ("(nil t 0 -7)" (nil t 0 -7) 12)
                  ("[nil t -7]" [nil t -7] 10) ("'nil" (quote nil) 4)
                  ("1.25" 1.25 4)))
    (let ((result (read-from-string (car case))))
      (unless (and (equal (car result) (nth 1 case)) (= (cdr result) (nth 2 case)))
        (error "reader value/position changed: %S -> %S" case result))
      (setq checks (+ checks 1))))
  (unless (equal (read-from-string "あ nil t" 2 5) '(nil . 5))
    (error "multibyte character bounds changed"))
  (setq checks (+ checks 1))
  (dolist (value (list nil t 0 -7 "context" '(ctx . pair) [nil t -7]
                       (make-symbol "read-context") (make-bool-vector 3 t)))
    (let ((load-file-name value))
      (unless (eq (car (read-from-string "#$")) value)
        (error "load-file-name context identity changed: %S" value))
      (setq checks (+ checks 1))))
  (let* ((source (concat "(" (mapconcat (lambda (_) "nil") (make-list 90 nil) " ") ")"))
         (value (car (read-from-string source))))
    (unless (equal value (make-list 90 nil)) (error "reader pool growth changed"))
    (setq checks (+ checks 1)))
  (let ((cycle (car (read-from-string "#1=(a . #1#)"))))
    (unless (and (eq (car cycle) 'a) (eq cycle (cdr cycle)))
      (error "reader label identity changed"))
    (setq checks (+ checks 1)))
  (princ (format "ABI-READER-PUBLIC checks=%d PASS\n" checks)))

;; NATIVE-ONLY
(let ((checks 0))
  (unless (equal (nelisp--read-all-from-string-native "nil t 0 -7 [1 nil]")
                 '(nil t 0 -7 [1 nil]))
    (error "native read-all values changed"))
  (unless (null (nelisp--read-all-from-string-native " ; empty\n"))
    (error "native read-all EOF became a value"))
  (setq checks (+ checks 2))
  (dolist (value (list nil t 0 -7 "native-context" '(ctx . pair) [nil t -7]
                       (make-symbol "native-context") (make-bool-vector 3 t)))
    (let* ((load-file-name value)
           (result (nelisp--read-all-from-string-native "#$")))
      (unless (and (= (length result) 1) (eq (car result) value))
        (error "native reader context WORD changed: %S" value))
      (setq checks (+ checks 1))))
  (dolist (case '(("key\t\nother\tvalue\n" "key" "")
                  ("key\tfirst\nkey\tsecond\n" "key" "first")
                  ("other\tx\nkey\tlast" "key" "last")
                  ("other\tvalue\n" "key" "") ("" "key" "")))
    (unless (equal (str-kv-line (car case) (nth 1 case)) (nth 2 case))
      (error "key/value line result changed: %S" case))
    (setq checks (+ checks 1)))
  (dolist (case '((".\n..\na\nb\n" t nil ("a" "b"))
                  (".\n..\na\nb\n" nil nil ("." ".." "a" "b"))
                  ("" t nil nil) ("a\nb" t nil ("a"))))
    (unless (equal (nelisp--readdir-scan-raw (car case) (nth 1 case) (nth 2 case))
                   (nth 3 case))
      (error "directory list WORDs changed: %S" case))
    (setq checks (+ checks 1)))
  (unless (equal (nelisp--readdir-scan-raw (unibyte-string 46 0 46 46 0 97 0 98 0) t t)
                 '("a" "b"))
    (error "NUL-separated directory list changed"))
  (setq checks (+ checks 1))
  (dolist (code '(0 -7 17))
    ;; A valid completed process snapshot: no wait/kill or external child.
    (let* ((proc (vector 1886547811 0 -1 1 code -1))
           (status (nelisp-process-poll proc)))
      (unless (equal status (vector 0 1 code)) (error "process poll WORDs changed"))
      (setq checks (+ checks 1))))
  (let* ((root "target/codex/round3/readerio-fixtures/")
         (raw (rdf (concat root "bytes") t)))
    (unless (and (= (length raw) 3) (= (aref raw 0) 0)
                 (= (aref raw 1) 65) (= (aref raw 2) 255)
                 (not (multibyte-string-p raw)))
      (error "raw file bytes/tag changed"))
    (unless (equal (rdf (concat root "empty")) "") (error "empty file became nil"))
    (unless (null (rdf (concat root "missing"))) (error "missing file became a value"))
    (unless (equal (rdf (concat root "text")) "hello\n") (error "text file changed"))
    (unless (equal (sort (directory-files root nil "^[^.]") #'string<)
                   '("bytes" "empty" "text"))
      (error "directory scan changed"))
    (setq checks (+ checks 5)))
  (let ((sentinel (intern "abi-readerio-sentinel")))
    (unless (memq sentinel (nelisp--intern-table-symbols))
      (error "intern table list lost symbol identity"))
    (setq checks (+ checks 1)))
  (garbage-collect)
  (princ (format "ABI-READERIO-WORD checks=%d PASS\n" checks)))
