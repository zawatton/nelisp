(require 'ert)
(require 'nelisp-native-application-producer)
(require 'nelisp-cc-fxir-admission)
(defvar nelisp-version)
(defvar nnap-tx--callee nil)
(defvar nnap-tx--observer nil)
(defvar nnap-tx--compile-error nil)
(defvar nnap-tx--source-error nil)
(defvar nnap-tx--receipt-error nil)
(defvar nnap-tx--write-count 0)
(defvar nnap-tx--body-call-count 0)
(defvar nnap-tx--macro-context nil)
(defvar nnap-tx--analysis-refusals '(:m0-no-transform))
(defvar nnap-tx--receipt-hook nil)
(defvar nnap-tx--helper-hook nil)
(defvar nnap-tx--preflight-modes nil)
(defvar nnap-tx--compiled-identities nil)

(defun nnap-tx--native-constructor (form)
  (cons 'closure (cons '(t) (cons (nth 2 form) (nthcdr 3 form)))))

(defun nnap-tx--plan (forms)
  (let ((names (mapcar #'cadr forms)))
    (list :status :validated-inputs :names names
          :forms (mapcar (lambda (form) (cons (cadr form) form)) forms)
          :form-hashes
          (mapcar (lambda (form)
                    (cons (cadr form) (nelisp-cc-fxir-admission--digest form)))
                  forms))))

(defun nnap-tx--adapter (&optional fail-write fail-readback)
  (let ((writes 0) (reads (make-hash-table :test 'eq))
        (fail-readback-used nil))
    (list :lookup
          (lambda (name)
            (let ((count (1+ (gethash name reads 0))))
              (puthash name count reads)
              (if (and fail-readback (eq name fail-readback) (= count 2)
                       (not fail-readback-used))
                  (progn (setq fail-readback-used t) :foreign)
                (if (fboundp name) (symbol-function name) :unbound))))
          :bind
          (lambda (name closure)
            (setq writes (1+ writes) nnap-tx--write-count writes)
            (fset name closure)
            (when (and fail-write (= writes fail-write))
              (error "Injected private write failure")))
          :unbind (lambda (name) (when (fboundp name) (fmakunbound name))))))

(defun nnap-tx--run (plan adapter &optional mode)
  (let ((process-environment (copy-sequence process-environment))
        (nelisp-version "private-test")
        (original-receipt (symbol-function 'nelisp-native-application-producer--receipt)))
    (setenv "NELISP_PRODUCER_IMAGE_SHA256" (make-string 64 ?a))
    (cl-letf (((symbol-function 'emacs-version) (lambda () "NeLisp test"))
              ((symbol-function 'nelisp-native-application-producer-preflight)
               (lambda (&rest args) (push (nth 4 args) nnap-tx--preflight-modes) plan))
              ((symbol-function 'nelisp-native-application-producer--initialize-fx-helper)
               (lambda ()
                 (when nnap-tx--helper-hook (funcall nnap-tx--helper-hook))
                 '(:helper-sha256 "helper" :prelude-sha256 "prelude")))
              ((symbol-function 'nelisp-native-application-producer--construct)
               #'nnap-tx--native-constructor)
              ((symbol-function 'nelisp-native-application-producer--host-adapter)
               (lambda () adapter))
              ((symbol-function 'nelisp--fx-macros-used) (lambda (_) nnap-tx--macro-context))
              ((symbol-function 'nelisp-fxir-recompile)
               (lambda (closure)
                 (push closure nnap-tx--compiled-identities)
                 (when nnap-tx--observer (funcall nnap-tx--observer plan))
                 (when nnap-tx--compile-error (error "Injected compile failure"))
                 (let* ((body (car (nthcdr 3 closure)))
                        (callee (or nnap-tx--callee
                                    (and (consp body) (symbolp (car body)) (car body)))))
                   (if callee
                       (list (vector 16 (vector callee nil nil nil nil) 1) 1
                             `(:call 1 1 (:slot 0)))
                     (list [] 1 '(:slot 0))))))
              ((symbol-function 'nelisp-fxir-problems) (lambda (_ir _code _locals) nil))
              ((symbol-function 'nelisp-fxir-callees)
               (lambda (_ir code)
                 (if (> (length code) 1) (list (aref (aref code 1) 0)) nil)))
              ((symbol-function 'nelisp-cc-fxir-analysis-row)
               (lambda (&rest _) (list :valid t :refusals nnap-tx--analysis-refusals)))
              ((symbol-function 'nelisp-native-application-protocol-bytes)
               (lambda (path _limit)
                 (when (> nnap-tx--write-count 0)
                   (error "Unexpected source read after publication"))
                 (when nnap-tx--source-error
                   (error "Injected prepublication source read failure"))
                 (string-as-unibyte path)))
              ((symbol-function 'nelisp-native-application-producer--receipt)
               (lambda (&rest args)
                 (let ((receipt (apply original-receipt args)))
                   (when nnap-tx--receipt-hook (funcall nnap-tx--receipt-hook))
                   (when nnap-tx--receipt-error
                     (error "Injected receipt assembly failure"))
                   receipt))))
      (nelisp-native-application-producer-install
       "manifest" "names" "manifest-hash" "names-hash" (make-string 64 ?a) mode))))

(defun nnap-tx--assert-unbound (names)
  (dolist (name names) (should-not (fboundp name))))

(ert-deftest nnap-tx-registers-all-renamed-closures-before-compilation ()
  ;; Compiler and image APIs are mocked; this tests transaction orchestration only.
  (let* ((caller (make-symbol "nnap-tx-caller"))
         (callee (make-symbol "nnap-tx-callee"))
         (forms (list `(defun ,caller (x) (,callee x)) `(defun ,callee (x) x)))
         (plan (nnap-tx--plan forms))
         (adapter (nnap-tx--adapter))
         (nnap-tx--callee nil) (nnap-tx--compile-error nil)
         (nnap-tx--source-error nil) (nnap-tx--receipt-error nil)
         (nnap-tx--write-count 0) (nnap-tx--body-call-count 0)
         (nnap-tx--observer
          (lambda (source-plan)
            (dolist (entry (plist-get source-plan :forms))
              (let ((live (symbol-function (car entry))))
                (should (fboundp (car entry)))
                (should (nelisp-native-application-producer--closure-authentic-p
                         live (cdr entry) #'nnap-tx--native-constructor))))))
         result)
    (unwind-protect
        (progn
          (setq result (nnap-tx--run plan adapter))
          (should (eq (plist-get result :status) :installed))
          (should (stringp (plist-get result :producer-source-sha256)))
          (should (= nnap-tx--write-count 2))
          (should (= nnap-tx--body-call-count 0)))
      (dolist (name (plist-get plan :names))
        (when (fboundp name) (fmakunbound name))))))

(ert-deftest nnap-tx-rolls-back-write-readback-compile-and-receipt-failures ()
  (dolist (failure '(first-write second-write readback compile receipt))
    (let* ((first (make-symbol "nnap-tx-fail-first"))
           (second (make-symbol "nnap-tx-fail-second"))
           (plan (nnap-tx--plan (list `(defun ,first (x) x)
                                      `(defun ,second (x) x))))
           (names (plist-get plan :names))
           (adapter (nnap-tx--adapter (pcase failure ('first-write 1)
                                        ('second-write 2))
                                      (and (eq failure 'readback) first)))
           (nnap-tx--callee nil) (nnap-tx--observer nil)
           (nnap-tx--compile-error (eq failure 'compile))
           (nnap-tx--source-error nil)
           (nnap-tx--receipt-error (eq failure 'receipt))
           (nnap-tx--write-count 0))
      (should-error (nnap-tx--run plan adapter))
      (nnap-tx--assert-unbound names))))

(ert-deftest nnap-tx-source-pin-failure-precedes-all-writes ()
  (let* ((name (make-symbol "nnap-tx-source"))
         (plan (nnap-tx--plan (list `(defun ,name (x) x))))
         (nnap-tx--callee nil) (nnap-tx--observer nil)
         (nnap-tx--compile-error nil) (nnap-tx--source-error t)
         (nnap-tx--receipt-error nil) (nnap-tx--write-count 0))
    (should-error (nnap-tx--run plan (nnap-tx--adapter)))
    (should (= nnap-tx--write-count 0))
    (nnap-tx--assert-unbound (list name))))

(ert-deftest nnap-tx-requires-callable-external-provider-and-preserves-cells ()
  (dolist (kind '(integer unbound macro))
    (let* ((name (make-symbol "nnap-tx-provider-user"))
           (provider (make-symbol "nnap-tx-external"))
           (plan (nnap-tx--plan (list `(defun ,name (x) x))))
           (cell (pcase kind ('integer 17)
                   ('macro (cons 'macro '(lambda (x) x))))))
      (when cell (fset provider cell))
      (let ((nnap-tx--callee provider) (nnap-tx--observer nil)
            (nnap-tx--compile-error nil) (nnap-tx--source-error nil)
            (nnap-tx--receipt-error nil) (nnap-tx--write-count 0))
        (unwind-protect
            (progn
              (should-error (nnap-tx--run plan (nnap-tx--adapter)))
              (nnap-tx--assert-unbound (list name))
              (if cell (should (eq (symbol-function provider) cell))
                (should-not (fboundp provider))))
          (when (fboundp provider) (fmakunbound provider)))))))

(ert-deftest nnap-tx-keeps-valid-external-subr-witness-unchanged ()
  (let* ((name (make-symbol "nnap-tx-subr-user"))
         (plan (nnap-tx--plan (list `(defun ,name (x) x))))
         (original (symbol-function '+))
         (nnap-tx--callee '+) (nnap-tx--observer nil)
         (nnap-tx--compile-error nil) (nnap-tx--source-error nil)
         (nnap-tx--receipt-error nil) (nnap-tx--write-count 0)
         (nnap-tx--body-call-count 0))
    (unwind-protect
        (progn
          (should (eq (plist-get (nnap-tx--run plan (nnap-tx--adapter)) :status)
                      :installed))
          (should (eq (symbol-function '+) original)))
      (when (fboundp name) (fmakunbound name)))))

(ert-deftest nnap-tx-mutual-renamed-reordered-definitions-and-mode-forwarding ()
  (dolist (reverse '(nil t))
    (let* ((first (make-symbol "nnap-mutual-first"))
           (second (make-symbol "nnap-mutual-second"))
           (forms (list `(defun ,first (x)
                          (,second (progn (setq nnap-tx--body-call-count 1) (cons x x))))
                        `(defun ,second (x)
                           (,first (progn (setq nnap-tx--body-call-count 2) (cons x x))))))
           (plan (nnap-tx--plan (if reverse (reverse forms) forms)))
           (nnap-tx--body-call-count 0) (nnap-tx--write-count 0)
           (nnap-tx--preflight-modes nil)
           (nnap-tx--observer
            (lambda (_plan)
              (should (= nnap-tx--write-count 2))
              (dolist (entry (plist-get plan :forms))
                (should (equal (symbol-function (car entry))
                               (nnap-tx--native-constructor (cdr entry))))))))
      (unwind-protect
          (let ((receipt (nnap-tx--run plan (nnap-tx--adapter) :selected-definitions)))
            (should (eq (plist-get receipt :status) :installed))
            (should (equal nnap-tx--preflight-modes '(:selected-definitions :selected-definitions)))
            (should (= nnap-tx--body-call-count 0)))
        (mapc #'fmakunbound (plist-get plan :names))))))

(ert-deftest nnap-tx-refuses-omitted-callable-macro-global-and-dynamic-context ()
  (dolist (reason '(omitted macro global dynamic))
    (let* ((name (make-symbol "nnap-tx-context"))
           (provider (make-symbol "nnap-tx-omitted-callable"))
           (plan (nnap-tx--plan (list `(defun ,name (x) (,provider x)))))
           (nnap-tx--write-count 0)
           (nnap-tx--callee provider)
           (nnap-tx--macro-context (and (eq reason 'macro) '(when)))
           (nnap-tx--analysis-refusals
            (pcase reason ('global '(:mutable-global-or-alias))
                   ('dynamic '(:dynamic-binding)) (_ '(:m0-no-transform))))
           (cell (lambda (x) x)))
      (when (eq reason 'omitted)
        (setq plan (plist-put plan :omitted-definition-names (list provider))))
      (fset provider cell)
      (unwind-protect
          (progn
            (should-error (nnap-tx--run plan (nnap-tx--adapter)))
            (should (= nnap-tx--write-count 1))
            (should-not (fboundp name))
            (should (eq (symbol-function provider) cell)))
        (fmakunbound provider) (fmakunbound name)))))

(ert-deftest nnap-tx-rolls-back-provider-and-final-cell-context-drift ()
  (dolist (kind '(provider selected compiler-api))
    (let* ((name (make-symbol "nnap-tx-final-drift"))
           (provider (make-symbol "nnap-tx-final-provider"))
           (cell (lambda (x) x))
           (plan (nnap-tx--plan (list `(defun ,name (x) (,provider x)))))
           (nnap-tx--write-count 0) (nnap-tx--callee provider)
           (nnap-tx--receipt-hook
            (lambda ()
              (fset (pcase kind ('provider provider) ('selected name)
                           (_ 'nelisp-fxir-recompile))
                    (lambda (&rest _) :foreign)))))
      (fset provider cell)
      (unwind-protect
          (progn
            (should-error (nnap-tx--run plan (nnap-tx--adapter)))
            (should-not (fboundp name)))
        (fmakunbound provider) (fmakunbound name)))))

(ert-deftest nnap-tx-rechecks-helper-collisions-and-rejects-stubs ()
  (dolist (kind '(helper-collision stub))
    (let* ((name (make-symbol "nnap-tx-collision"))
           (plan (nnap-tx--plan (list `(defun ,name (x) x))))
           (nnap-tx--write-count 0)
           (cell (lambda (x) x))
           (nnap-tx--helper-hook (and (eq kind 'helper-collision)
                                     (lambda () (fset name cell))))
           (adapter (nnap-tx--adapter)))
      (when (eq kind 'stub)
        (setq adapter (plist-put adapter :bind (lambda (target _closure)
                                                (fset target (lambda (&rest _) nil))))))
      (unwind-protect
          (progn
            (should-error (nnap-tx--run plan adapter))
            (if (eq kind 'helper-collision)
                (progn (should (= nnap-tx--write-count 0))
                       (should (eq (symbol-function name) cell)))
              (should-not (fboundp name))))
        (fmakunbound name)))))

(ert-deftest nnap-tx-cleanup-failure-requires-discard-with-original-error ()
  (let* ((first (make-symbol "nnap-tx-clean-first"))
         (second (make-symbol "nnap-tx-clean-second"))
         (plan (nnap-tx--plan (list `(defun ,first (x) x) `(defun ,second (x) x))))
         (adapter (nnap-tx--adapter))
         (nnap-tx--write-count 0) (nnap-tx--compile-error t))
    (setq adapter (plist-put adapter :unbind
                             (lambda (name)
                               (if (eq name first) (error "Injected cleanup failure")
                                 (fmakunbound name)))))
    (unwind-protect
        (let* ((failure (should-error (nnap-tx--run plan adapter)
                                     :type 'nelisp-native-application-producer-discard-required))
               (details (cdr failure)))
          (should (string-match-p "Injected compile failure"
                                  (error-message-string (plist-get details :original-error))))
          (should (plist-get details :cleanup-errors))
          (should (fboundp first))
          (should-not (fboundp second)))
      (fmakunbound first) (fmakunbound second))))

(ert-deftest nnap-tx-preserves-foreign-provider-and-preexisting-output ()
  (let* ((name (make-symbol "nnap-tx-preserve"))
         (provider (make-symbol "nnap-tx-foreign"))
         (cell (lambda (x) x))
         (output (make-temp-file "nnap-preexisting-output-" nil nil "preserve"))
         (plan (nnap-tx--plan (list `(defun ,name (x) (,provider x)))))
         (nnap-tx--write-count 0) (nnap-tx--compile-error t))
    (fset provider cell)
    (unwind-protect
        (progn
          (should-error (nnap-tx--run plan (nnap-tx--adapter)))
          (should-not (fboundp name))
          (should (eq (symbol-function provider) cell))
          (should (equal (with-temp-buffer (insert-file-contents output) (buffer-string))
                         "preserve")))
      (fmakunbound provider) (fmakunbound name) (delete-file output))))

(ert-deftest nnap-tx-noop-cleanup-cannot-report-the-original-error-alone ()
  (let* ((name (make-symbol "nnap-tx-noop-cleanup"))
         (plan (nnap-tx--plan (list `(defun ,name (x) x))))
         (adapter (nnap-tx--adapter))
         (nnap-tx--write-count 0) (nnap-tx--compile-error t))
    (setq adapter (plist-put adapter :unbind (lambda (_) nil)))
    (unwind-protect
        (progn
          (should-error (nnap-tx--run plan adapter)
                        :type 'nelisp-native-application-producer-discard-required)
          (should (fboundp name)))
      (fmakunbound name))))

(ert-deftest nnap-tx-compiler-consumes-the-exact-live-prepared-identities ()
  (let* ((first (make-symbol "nnap-tx-eq-first"))
         (second (make-symbol "nnap-tx-eq-second"))
         (plan (nnap-tx--plan (list `(defun ,first (x) (,second (cons x x)))
                                  `(defun ,second (x) x))))
         (nnap-tx--compiled-identities nil) (nnap-tx--write-count 0))
    (unwind-protect
        (progn
          (should (eq (plist-get (nnap-tx--run plan (nnap-tx--adapter)) :status) :installed))
          (should (= (length nnap-tx--compiled-identities) 2))
          (cl-mapc (lambda (name closure) (should (eq (symbol-function name) closure)))
                   (plist-get plan :names) (reverse nnap-tx--compiled-identities)))
      (fmakunbound first) (fmakunbound second))))

(ert-deftest nnap-tx-quit-cleans-owned-cells-and-remains-a-quit ()
  (let* ((name (make-symbol "nnap-tx-quit"))
         (plan (nnap-tx--plan (list `(defun ,name (x) x))))
         (nnap-tx--write-count 0)
         (nnap-tx--observer (lambda (_) (signal 'quit nil)))
         caught)
    (unwind-protect
        (progn
          (condition-case nil (nnap-tx--run plan (nnap-tx--adapter))
            (quit (setq caught t)))
          (should caught)
          (should-not (fboundp name)))
      (fmakunbound name))))

(provide 'nelisp-native-application-private-transaction-test)
