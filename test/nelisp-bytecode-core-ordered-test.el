(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-aot-compiler--x86-ordered-jump-tables-enabled)
(defvar nelisp-ordered-test--force-off (getenv "NELISP_ORDERED_DISABLE"))
(defun nelisp-ordered-test--ref (&optional slot)
  (nelisp-aot-compiler--make-ir 'ref :var 'key :reg nil :slot (or slot 0)
                                :class 'gp :repr 'raw-i64 :root-p nil))
(defun nelisp-ordered-test--tree (cuts &optional ref leaf)
  "Build a balanced IR tree; LEAF receives an interval's ordinal."
  (let ((ref (or ref (nelisp-ordered-test--ref))) (ordinal 0))
    (cl-labels ((tree (xs)
                  (if (null xs)
                      (prog1 (if leaf (funcall leaf ordinal)
                               (nelisp-aot-compiler--make-ir 'imm :value ordinal))
                        (cl-incf ordinal))
                    (let ((middle (/ (length xs) 2)))
                      (nelisp-aot-compiler--make-ir
                       'if :id (make-symbol "ordered")
                       :test (nelisp-aot-compiler--make-ir
                              'cmp :op '< :repr 'raw-i64 :a ref
                              :b (nelisp-aot-compiler--make-ir 'imm :value (nth middle xs)))
                       :then (tree (cl-subseq xs 0 middle))
                       :else (tree (nthcdr (1+ middle) xs)))))))
      (tree cuts))))
(defmacro nelisp-ordered-test--context (&rest body)
  `(let ((nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--promoted-slots nil)
         (nelisp-aot-compiler--x86-jump-tables-enabled t)
         (nelisp-aot-compiler--x86-ordered-jump-tables-enabled
          (not nelisp-ordered-test--force-off))) ,@body))
(ert-deftest nelisp-bytecode-core-ordered/selector-and-interval-map ()
  (nelisp-ordered-test--context
   (let* ((cuts (number-sequence -28 28 4))
          (root (nelisp-ordered-test--tree cuts))
          (plan (and (fboundp 'nelisp-aot-compiler--x86-ordered-if-plan)
                     (nelisp-aot-compiler--x86-ordered-if-plan root))))
     (should plan)
     (should (equal (list (nth 1 plan) (nth 2 plan) (nth 7 plan)) '(-28 27 15)))
     (cl-loop for key from -28 to 27 do
              (should (= (nelisp-aot-compiler--ir-get (aref (nth 3 plan) (+ key 28)) :value)
                         (cl-count-if (lambda (cut) (<= cut key)) cuts))))
     (should (= 0 (nelisp-aot-compiler--ir-get (nth 5 plan) :value)))
     (should (= 15 (nelisp-aot-compiler--ir-get (nth 6 plan) :value))))))
(ert-deftest nelisp-bytecode-core-ordered/policy-shape-and-bounds ()
  (nelisp-ordered-test--context
   (let* ((cuts (number-sequence 0 28 2)) (root (nelisp-ordered-test--tree cuts)))
     (should (nelisp-aot-compiler--x86-ordered-if-plan root))
     (dolist (mode '(disabled direct win arm lisp rax r10))
       (let ((nelisp-aot-compiler--x86-jump-tables-enabled (not (eq mode 'disabled)))
             (nelisp-aot-compiler--emitting-defun-name 'ordered-owner)
             (nelisp-aot-compiler--x86-direct-only-defuns (and (eq mode 'direct) '(ordered-owner)))
             (nelisp-aot-compiler--abi (if (eq mode 'win) 'win64 'sysv))
             (nelisp-aot-compiler--arch (if (eq mode 'arm) 'aarch64 'x86_64))
             (nelisp-aot-compiler--runtime-entry-params (eq mode 'lisp))
             (nelisp-aot-compiler--promoted-slots (and (memq mode '(rax r10)) (list (cons 0 mode)))))
         (should-not (nelisp-aot-compiler--x86-ordered-if-plan root))))
     (dolist (bad-cuts (list (number-sequence 0 6) (number-sequence 0 2800 200)
                            (number-sequence 0 64 2)))
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan (nelisp-ordered-test--tree bad-cuts))))
     (dolist (field '(:var :class :repr :reg :root-p))
       (let* ((copy (copy-tree root t))
              (child (nelisp-aot-compiler--ir-get copy :then))
              (ref (copy-sequence (nelisp-aot-compiler--ir-get
                                   (nelisp-aot-compiler--ir-get child :test) :a))))
         (cl-loop for i from 1 below (length ref) by 2
                  when (eq (aref ref i) field) do (aset ref (1+ i) 'mismatch))
         (let ((test (nelisp-aot-compiler--ir-get child :test)))
           (cl-loop for i from 1 below (length test) by 2
                    when (eq (aref test i) :a) do (aset test (1+ i) ref)))
         (should-not (nelisp-aot-compiler--x86-ordered-if-plan copy))))
     (let* ((other (nelisp-ordered-test--tree cuts (nelisp-ordered-test--ref 1)))
            (foreign (nelisp-ordered-test--tree '(14) nil (lambda (_) other))))
       ;; Foreign subtrees are opaque, not fifteen additional decisions.
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan foreign)))
     (let* ((cyclic (nelisp-ordered-test--tree cuts))
            (test (nelisp-aot-compiler--ir-get cyclic :test)))
       (cl-loop for i from 1 below (length cyclic) by 2
                when (eq (aref cyclic i) :then) do (aset cyclic (1+ i) cyclic))
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan cyclic))
       (aset test 0 'unknown)
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan cyclic)))
     (let ((chain (nelisp-aot-compiler--make-ir 'imm :value 0)))
       (dolist (cut (number-sequence 9 0 -1))
         (setq chain (nelisp-ordered-test--tree
                      (list cut) nil (lambda (i) (if (= i 1) chain
                                                  (nelisp-aot-compiler--make-ir 'imm :value i))))))
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan chain)))
     (let* ((bad (nelisp-ordered-test--tree cuts))
            (test (nelisp-aot-compiler--ir-get bad :test)))
       (aset test 2 '<=)
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan bad))
       (aset test 2 '<)
       (cl-loop for i from 1 below (length test) by 2
                when (eq (aref test i) :b) do (aset test (1+ i) '[imm :value]))
       (should-not (nelisp-aot-compiler--x86-ordered-if-plan bad))))))
(ert-deftest nelisp-bytecode-core-ordered/shared-leaf-labels-and-equality-bytes ()
  (nelisp-ordered-test--context
   (let* ((shared (nelisp-aot-compiler--make-ir 'imm :value 19))
          (root (nelisp-ordered-test--tree (number-sequence 0 28 2) nil (lambda (_) shared)))
          (buf (nelisp-asm-x86_64-make-buffer 'sysv)) (emissions 0) spans)
     (let ((nelisp-aot-compiler--x86-inline-data-hook
            (list (lambda (_b _offset size) (push size spans)))))
       (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-value)
                  (lambda (n _b) (when (eq n shared) (cl-incf emissions)))))
         (should (nelisp-aot-compiler--emit-dense-if-x86 root buf))))
     (should (= emissions 1))
     (should (equal spans '(112)))
     ;; This resolves every table entry, including both unbounded tails.
     (should (stringp (nelisp-asm-x86_64-resolve-fixups buf))))
   (let ((source '(seq (defun ordered_eq (key)
                        (if (= key 0) 10 (if (= key 1) 11
                          (if (= key 2) 12 (if (= key 3) 13 99)))))))
         (dir (make-temp-file "nelisp-ordered-equality-" t)) bytes)
     (unwind-protect
         (dolist (enabled '(nil t))
           (let ((nelisp-aot-compiler--x86-ordered-jump-tables-enabled enabled)
                 (path (expand-file-name (if enabled "on.o" "off.o") dir)))
             (nelisp-aot-compile-to-object source path)
             (let ((current (with-temp-buffer (set-buffer-multibyte nil)
                                             (insert-file-contents-literally path) (buffer-string))))
               (if enabled (should (equal bytes current)) (setq bytes current)))))
       (delete-directory dir t)))))
(defun nelisp-ordered-test--form (cuts)
  (let ((ordinal 0))
    (cl-labels ((tree (xs)
                  (if (null xs)
                      (let ((tag (cl-incf ordinal)))
                        ;; The predicate's write is opaque and must run exactly
                        ;; once only for the selected leaf, before the call.
                        `(if (seq (ptr-write-u64 memory 8 (+ (ptr-read-u64 memory 8) 1)) (< key 0))
                             (seq (ptr-write-u64 memory 0 ,tag)
                                  (ordered_result key ,tag))
                           (seq (ptr-write-u64 memory 0 ,tag)
                                (ordered_result key ,tag))))
                    (let ((middle (/ (length xs) 2)))
                      `(if (< key ,(nth middle xs))
                           ,(tree (cl-subseq xs 0 middle))
                         ,(tree (nthcdr (1+ middle) xs)))))))
      (tree cuts))))
(defun nelisp-ordered-test--signed64 (x)
  (let ((x (logand x #xffffffffffffffff))) (if (>= x (ash 1 63)) (- x (ash 1 64)) x)))
(ert-deftest nelisp-bytecode-core-ordered/native-signed-tails-and-effects ()
  (nelisp-ordered-test--context
   (let ((dir (make-temp-file "nelisp-ordered-native-" t)) definitions checks)
     (unwind-protect
         (progn
           (dolist (start '(-28 -2147483648 2147483591))
             (let* ((cuts (number-sequence start (+ start 56) 4))
                    (name (intern (format "ordered_%s" (abs start))))
                    (inputs (delete-dups
                             (append (number-sequence -64 256)
                                     (cl-mapcan (lambda (x) (list (1- x) x (1+ x))) cuts)
                                     '(-9223372036854775808 9223372036854775807)))))
               (push `(defun ,name (key memory) ,(nelisp-ordered-test--form cuts)) definitions)
               (dolist (input inputs)
                 (let* ((tag (1+ (cl-count-if (lambda (cut) (<= cut input)) cuts)))
                        (expected (nelisp-ordered-test--signed64 (+ input (* tag 13)))))
                   (push `(seq (ptr-write-u64 memory 8 0)
                               (let ((value (,name ,input memory)))
                                 (if (and (= value ,expected)
                                          (= (ptr-read-u64 memory 0) ,tag)
                                          (= (ptr-read-u64 memory 8) 1)) 0 1))) checks)))))
           (dolist (enabled '(nil t))
             (let ((nelisp-aot-compiler--x86-ordered-jump-tables-enabled enabled)
                   (path (expand-file-name (if enabled "on" "off") dir)))
               (nelisp-aot-compile-sexp
                `(seq (defun ordered_result (x tag) (+ x (* tag 13)))
                      ,@(reverse definitions)
                      (defun run ()
                        (let ((memory (syscall-direct 9 0 4096 3 34 -1 0)) (failure 0))
                          ,@(mapcar (lambda (c) `(setq failure (logior failure ,c))) (reverse checks))
                          failure))
                      (exit (run))) path)
               (should (= 0 (call-process path nil nil nil))))))
       (delete-directory dir t)))))
(ert-deftest nelisp-bytecode-core-ordered/native-conditional-trap ()
  (nelisp-ordered-test--context
   (let ((dir (make-temp-file "nelisp-ordered-trap-" t)) (ordinal 0))
     (unwind-protect
         (cl-labels ((tree (cuts)
                       (if (null cuts)
                           (if (= (cl-incf ordinal) 6) '(ptr-read-u64 0 0) 0)
                         (let ((middle (/ (length cuts) 2)))
                           `(if (< key ,(nth middle cuts))
                                ,(tree (cl-subseq cuts 0 middle))
                              ,(tree (nthcdr (1+ middle) cuts)))))))
           (let ((body (tree (number-sequence 0 28 2))))
             (dolist (enabled '(nil t))
               (dolist (key '(-1 8))
                 (let ((nelisp-aot-compiler--x86-ordered-jump-tables-enabled enabled)
                       (default-directory dir)
                       (path (expand-file-name (format "trap-%s-%s" enabled key) dir)))
                   (nelisp-aot-compile-sexp
                    `(seq (defun ordered_fault (key) ,body) (exit (ordered_fault ,key))) path)
                   (let ((status (call-process "sh" nil nil nil "-c" "ulimit -c 0; exec \"$1\"" "sh" path)))
                     (if (= key -1) (should (equal status 0))
                       (should (stringp status)))))))))
       (delete-directory dir t)))))
(ert-deftest nelisp-bytecode-core-ordered/effect-context-table-and-native ()
  (nelisp-ordered-test--context
   (let ((dir (make-temp-file "nelisp-ordered-effect-" t))
         (cuts (number-sequence 0 28 2)) (ordinal 0) body checks)
     (unwind-protect
         (cl-labels ((tree (xs)
                       (if (null xs)
                           (let ((tag (cl-incf ordinal)))
                             `(seq (setq result ,tag)
                                   (ptr-write-u64 memory 0 ,tag)))
                         (let ((middle (/ (length xs) 2)))
                           `(if (< k ,(nth middle xs))
                                ,(tree (cl-subseq xs 0 middle))
                              ,(tree (nthcdr (1+ middle) xs)))))))
           (setq body (tree cuts))
           (dolist (key (append (number-sequence -64 256)
                               '(-9223372036854775808 9223372036854775807)))
             (push `(if (= (ordered_effect ,key memory)
                           ,(* 2 (1+ (cl-count-if (lambda (cut) (<= cut key)) cuts))))
                        0 1) checks))
           (dolist (enabled '(nil t))
             (let* ((nelisp-aot-compiler--x86-ordered-jump-tables-enabled enabled)
                    spans
                    (nelisp-aot-compiler--x86-inline-data-hook
                     (list (lambda (_buf _offset size) (push size spans))))
                    (path (expand-file-name (if enabled "on" "off") dir)))
               (nelisp-aot-compile-sexp
                `(seq (defun ordered_effect (key memory)
                        ;; The planner admits only a raw frame-slot local, as in
                        ;; the production owner; a register parameter is rejected.
                        (ptr-write-u64 memory 16 key)
                        (let ((k (ptr-read-u64 memory 16)) (result -1))
                          ,body
                          (+ result (ptr-read-u64 memory 0))))
                      (defun run ()
                        (let ((memory (syscall-direct 9 0 4096 3 34 -1 0)) (failure 0))
                          ,@(mapcar (lambda (c) `(setq failure (logior failure ,c)))
                                    (reverse checks))
                          failure))
                      (exit (run))) path)
               (should (= 0 (call-process path nil nil nil)))
               (if enabled (should (memq 112 spans))
                 (should-not (memq 112 spans))))))
       (delete-directory dir t)))))
(defvar nelisp-ordered-test--production-out nil)
(defvar nelisp-ordered-test--production-results nil)
(defun nelisp-ordered-test--production-emit (original owner _buf)
  (when (eq (nelisp-aot-compiler--ir-get owner :name) 'wf_bytecode_w_fast_run)
    (with-temp-file (expand-file-name "production-owner.el" nelisp-ordered-test--production-out)
      (prin1 owner (current-buffer)))
    (dolist (enabled '(nil t))
      (let* ((nelisp-aot-compiler--x86-ordered-jump-tables-enabled
              (and enabled (not nelisp-ordered-test--force-off)))
             (nelisp-state-production--out
              (expand-file-name (if enabled "on" "off") nelisp-ordered-test--production-out))
             (nelisp-state-production--objects nil) spans
             (nelisp-aot-compiler--x86-inline-data-hook
              (list (lambda (_b offset size) (push (cons offset size) spans)))))
        (make-directory nelisp-state-production--out t)
        ;; Keep the previously qualified scalar cache ON in both objects.
        (nelisp-state-production--object original owner t)
        (push (list enabled (cdr (car nelisp-state-production--objects)) (nreverse spans))
              nelisp-ordered-test--production-results)))
    (throw 'nelisp-ordered-production-complete t)))
(ert-deftest nelisp-bytecode-core-ordered/actual-producer-first-dispatch ()
  (require 'nelisp-codegen-state-production-test)
  (let* ((retained (getenv "NELISP_ORDERED_PRODUCTION_OUT"))
         (nelisp-ordered-test--production-out
          (or retained (make-temp-file "nelisp-ordered-producer-" t)))
         (nelisp-ordered-test--production-results nil)
         (max-lisp-eval-depth (max max-lisp-eval-depth 40000))
         (process-environment (copy-sequence process-environment))
         (nelisp-aot-compiler--x86-direct-only-defuns
          nelisp-standalone--direct-only-reader-defuns))
    (setenv "NELISP_READER_DYNAMIC" "1")
    (setenv "NELISP_STANDALONE_TARGET" "linux-x86_64")
    (make-directory nelisp-ordered-test--production-out t)
    (advice-add 'nelisp-aot-compiler--emit-defun :around #'nelisp-ordered-test--production-emit)
    (unwind-protect
        (progn
          (should (catch 'nelisp-ordered-production-complete
                    (nelisp-standalone--compile-to-unit
                     "applyfn-reader.o"
                     (nelisp-standalone--patch-autoload-lookups (nelisp-standalone--applyfn-source)))
                    nil))
          (let* ((on (assq t nelisp-ordered-test--production-results))
                 (off (assq nil nelisp-ordered-test--production-results))
                 ;; `nelisp-asm-x86_64-cmp-imm32' always emits REX.W 81 /7 imm32.
                 (bounds (regexp-quote (unibyte-string #x48 #x81 #xf8 6 0 0 0 #x0f #x8c))))
            (should on) (should off)
            (should (cl-find 744 (nth 2 on) :key #'cdr))
            (should-not (cl-find 744 (nth 2 off) :key #'cdr))
            (should (string-match-p bounds (nth 1 on)))
            ;; The table consumes the SAFE R8 cache of the first raw home.
            (should (string-match-p
                     (regexp-quote (unibyte-string #x49 #x89 #xc0 #x4c #x89 #xc0
                                                   #x48 #x81 #xf8 6 0 0 0))
                     (nth 1 on)))
            (should-not (string-match-p bounds (nth 1 off)))
            (dolist (object (list on off))
              (should (string-match-p
                       (regexp-quote (unibyte-string #x48 #x89 #x85 #xc0 #xfe #xff #xff))
                       (nth 1 object)))
              (should (string-match-p (regexp-quote (unibyte-string #x49 #x89 #xc0))
                                      (nth 1 object))))
            (with-temp-file (expand-file-name "table-spans.el" nelisp-ordered-test--production-out)
              (prin1 (mapcar (lambda (x) (list (car x) (nth 2 x)))
                             nelisp-ordered-test--production-results) (current-buffer)))))
      (advice-remove 'nelisp-aot-compiler--emit-defun #'nelisp-ordered-test--production-emit)
      (unless retained (delete-directory nelisp-ordered-test--production-out t)))))
(provide 'nelisp-bytecode-core-ordered-test)
