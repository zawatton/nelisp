(ert-deftest nelisp-native-tier-accepted-adoption-refusal-keeps-tier0-and-backs-off ()
  (nelisp-native-tier-test--state
    (let* ((entry (nelisp-native-tier-install 'tier-test-target fn)) (attempts 0))
      (puthash (plist-get entry :key)
               (lambda (_) (setq attempts (1+ attempts)) (error "Transient binding failure"))
               nelisp-native-tier--accepted)
      (dotimes (_ 4) (should (equal (tier-test-target 42) '(1 42))))
      (should (= attempts 1))
      (should (plist-get entry :refusal))
      (should (= 0 (plist-get entry :tier))))))
(ert-deftest nelisp-native-tier-restores-native-cache-environment ()
  ;; A standalone setenv updates the OS environment, independently of the
  ;; dynamically bound process-environment list. Model that on the host.
  (dolist (failure '(nil t))
    (nelisp-native-tier-test--state
      (let* ((entry (nelisp-native-tier-install 'tier-test-target fn))
             (job (nelisp-native-tier-test--completed-job entry))
             (external "parent-cache")
             (loader (symbol-function 'nelisp-native-cache-load)))
        (unwind-protect
            (cl-letf (((symbol-function 'getenv) (lambda (&rest _) external))
                      ((symbol-function 'setenv)
                       (lambda (_name value &rest _) (setq external value)))
                      ((symbol-function 'nelisp-native-cache-load)
                       (lambda (input)
                         (should (equal external (plist-get job :cache)))
                         (if failure (error "Artifact refused") (funcall loader input)))))
              (if failure (should-error (nelisp-native-tier--finish job))
                (nelisp-native-tier--finish job))
              (should (equal external "parent-cache")))
          (delete-directory (plist-get job :directory) t))))))
(provide 'nelisp-native-tier-test)
