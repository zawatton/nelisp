(ert-deftest nelisp-native-tier-final-identity-callback-cannot-clobber-user ()
  (nelisp-native-tier-test--state
    (let* ((entry (nelisp-native-tier-install 'tier-test-target fn))
           (job (nelisp-native-tier-test--completed-job entry))
           (current (lambda (_) 'user)) (calls 0)
           (identity (plist-get entry :identity)))
      (unwind-protect
          (cl-letf (((symbol-function 'nelisp-native-tier--identity)
                     (lambda (&rest _)
                       (setq calls (1+ calls))
                       (when (= calls 2) (fset 'tier-test-target current))
                       identity)))
            (should-error (nelisp-native-tier--finish job))
            (should (= calls 2))
            (should (eq current (symbol-function 'tier-test-target)))
            (should (= 0 (plist-get entry :tier))))
        (delete-directory (plist-get job :directory) t)))))
(ert-deftest nelisp-native-tier-tier0-owner-reused-with-distinct-live-constants ()
  (nelisp-native-tier-test--state
    (let ((second (make-byte-code 257 (unibyte-string 0 135) [old] 1)) (maps 0))
      (cl-letf (((symbol-function 'nelisp-native-cache-load)
                 (lambda (input-fn)
                   (setq maps (1+ maps))
                   (let ((factory (lambda (constants) (lambda (_) (aref constants 0)))))
                     (funcall nelisp-native-cache--unit-observer factory)
                     (funcall factory (nelisp-native-cache--constants input-fn))))))
        (let* ((a (nelisp-native-tier-install 'tier-test-target fn))
               (b (nelisp-native-tier-install 'tier-test-target second)))
          (should (= maps 1))
          (aset (aref fn 2) 0 'first)
          (aset (aref second 2) 0 'second)
          (should (eq 'first (funcall (car (plist-get a :cell)) nil)))
          (should (eq 'second (funcall (car (plist-get b :cell)) nil))))))))
(ert-deftest nelisp-native-tier-exhausted-budget-never-launches-compiler ()
  (nelisp-native-tier-test--state
    (let ((entry (nelisp-native-tier-install 'tier-test-target fn))
          (nelisp-native-budget--handles 512))
      (cl-letf (((symbol-function 'nelisp-native-tier--native-process-p) (lambda () t))
                ((symbol-function 'nelisp-native-tier--check-worker)
                 (lambda (&rest _) (ert-fail "exhausted budget reached worker launch"))))
        (nelisp-native-tier-request entry)
        (should-not nelisp-native-tier--pending)
        (should (plist-get (plist-get entry :refusal) :permanent))
        (should (equal (funcall (car (plist-get entry :cell)) 42) '(1 42)))))))
(ert-deftest nelisp-native-tier-exhausted-budget-refuses-actual-trusted-mapper ()
  (nelisp-native-cache-test--runtime
    (nelisp-native-cache-test--directory
      (pcase-let* ((`(,fn ,manifest ,header) (nelisp-native-cache-test--fixture))
                   (file (nelisp-native-cache-file fn))
                   (nelisp-native-budget--handles 0) (nelisp-native-budget--bytes 0))
        (nelisp-native-cache-test--write file header manifest)
        (let ((callable (nelisp-native-cache-load fn))
              (nelisp-native-budget-handle-limit 1))
          (cl-letf (((symbol-function 'nelisp-native-load--mmap)
                     (lambda (&rest _) (ert-fail "exhausted budget reached mmap"))))
            (should-error (nelisp-native-cache-load fn) :type 'nelisp-native-budget-exhausted)
            (should (= 12 (funcall callable 12 34)))))))))
(ert-deftest nelisp-native-tier-cancel-during-load-keeps-new-worker-ownership ()
  (nelisp-native-tier-test--state
    (let* ((entry (nelisp-native-tier-install 'tier-test-target fn))
           (job (nelisp-native-tier-test--completed-job entry))
           (next (list :entry (list :job nil) :process 'next :directory nil :released nil))
           (deleted 0) (old (car (plist-get entry :cell))))
      (setq nelisp-native-tier--pending job nelisp-native-tier--queue (list next))
      (cl-letf (((symbol-function 'nelisp-process-status) (lambda (_) 1))
                ((symbol-function 'nelisp-process-exit-status) (lambda (_) 0))
                ((symbol-function 'nelisp-process-delete) (lambda (_) (setq deleted (1+ deleted))))
                ((symbol-function 'nelisp-native-tier--launch-next)
                 (lambda ()
                   (unless nelisp-native-tier--pending
                     (setq nelisp-native-tier--pending (pop nelisp-native-tier--queue)))))
                ((symbol-function 'nelisp-native-cache-load)
                 (lambda (_) (nelisp-native-tier-cancel entry)
                       (funcall nelisp-native-cache--unit-observer (lambda (_) #'identity)) #'identity)))
        (nelisp-native-tier-poll)
        (should (eq next nelisp-native-tier--pending))
        (should (= deleted 1)) (should (= nelisp-native-tier--reaped 1))
        (should-not (plist-get entry :job))
        (should (eq old (car (plist-get entry :cell))))
        (should (= 0 (plist-get entry :tier)))))))
(ert-deftest nelisp-native-tier-worker-file-refusal-is-transient ()
