;;; nelisp-typed-save-toplevel-query-test.el --- Borrowed vector selection -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tsq--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tsq--extern (tree)
  (if (atom tree) tree
    (if (eq (car tree) 'extern-call) (mapcar #'tsq--extern (cdr tree))
      (mapcar #'tsq--extern tree))))
(defun tsq--form (name &optional old)
  (with-temp-buffer
    (insert-file-contents (expand-file-name (if old "target/typed-save/toplevel-query/builder-before.el"
                                            "scripts/nelisp-standalone-build.el") tsq--root))
    (goto-char (point-min))
    (unless (search-forward (concat "(defun " (symbol-name name) " ") nil t) (error "Missing actual owner %s" name))
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tsq--run (frames links &optional view old set-value mutant setter-old)
  "Model compact versus legacy-view transport, not native object layout proof."
  (let ((mem (make-hash-table :test #'eql)) (objs (make-hash-table :test #'eql))
        (backs (make-hash-table :test #'eql)) (next 100000) payloads saved writes)
    (cl-labels ((box (x) (let ((p (cl-incf next 8))) (puthash p x objs) p))
                (word (x) (cond ((vectorp x) (let ((p (box (copy-sequence x))))
                                              (push p payloads)
                                              (when view (puthash (+ p 8) (+ p 1000000) mem)
                                                    (puthash (+ p 1000000) p backs)) p))
                               ((consp x) (box (cons (word (car x)) (word (cdr x))))) ((null x) 3) (t x)))
                (obj (p) (gethash p objs))
                (tag (p) (cond ((vectorp (obj p)) 8) ((consp (obj p)) 7) ((= p 3) 0)
                               ((memq p '(101 102)) 4) (t 2)))
                (rd (p o) (let ((x (gethash (+ p o) mem 'absent)))
                            (if (eq x 'absent) (error "No legacy view field %s+%s" p o) x)))
                (slot (p n) (if (= p 1032) (rd p (* n 8)) (aref (obj p) n)))
                (decode (p) (cond ((vectorp (obj p)) (list 'vector (append (obj p) nil)))
                                  ((consp (obj p)) (list 'lean (car (obj p)) (cdr (obj p)))) (t p))))
      (puthash 1032 (box (vconcat (mapcar (lambda (names) (box (vector 3 (word names)))) frames))) mem)
      (puthash 1040 (+ 1 (* 4 (length frames))) mem)
      (let ((link 0))
        (dolist (spec (reverse links))
          (pcase-let* ((`(,depth ,events) spec) (p (+ next 8)) (aux (+ p 32)))
            (setq next (+ aux 488)) (dotimes (i 61) (puthash (+ aux (* i 8)) 3 mem))
            (puthash (+ p 8) link mem) (puthash (+ p 16) (+ aux 8) mem) (puthash (+ p 24) depth mem)
            (puthash (+ aux 96) 1 mem) (puthash (+ aux 8) (word events) mem) (setq link p)))
        (puthash 1176 (if links 9000 0) mem) (puthash 9016 link mem))
      (cl-letf (((symbol-function 'heap-read-u64) #'rd) ((symbol-function 'ptr-read-u64) #'rd)
                ;; Original cases have neither a scoped view nor N4 cuts.
                ((symbol-function 'nl_n4_binding_visible) (lambda (env &rest _) (should (= env 1000)) 1))
                ((symbol-function 'nl_n4_cut_rebase) (lambda (env &rest _) (should (= env 1000)) 0))
                ((symbol-function 'nl_record_slot_word) #'slot) ((symbol-function 'nelisp_frame_slot_raw_word) #'slot)
                ((symbol-function 'nl_vector_slot_word) #'slot) ((symbol-function 'vector-ref-ptr) #'slot)
                ((symbol-function 'vector-len) (lambda (p) (length (obj p))))
                ((symbol-function 'nl_cons_car_word) (lambda (p) (car (obj p))))
                ((symbol-function 'nl_cons_cdr_word) (lambda (p) (cdr (obj p))))
                ((symbol-function 'nl_val_tag) #'tag) ((symbol-function 'sexp-tag) #'tag)
                ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2)))
                ((symbol-function 'wf_bytecode_w_cons2) (lambda (&rest _) (error "Count0 fixture cannot spill")))
                ((symbol-function 'nelisp_symbol_key_equal) (lambda (a b) (if (= a b) 1 0)))
                ((symbol-function 'wf_dirty) (lambda () 0)) ((symbol-function 'nl_word_clone) #'identity)
                ((symbol-function 'vector-slot-set) (lambda (p n val) (push (list 'generic p n val) writes) (aset (obj p) n val) 0))
                ((symbol-function 'nl_vector_set_slot) (lambda (back n val) (let ((p (gethash back backs)))
                                                                              (should p) (aset (obj p) n val) 0)))
                ((symbol-function 'nelisp_env_setv_mirror_lazy) (lambda (&rest _) (push 'fallback writes) 0)))
        (unwind-protect
            (progn
              (dolist (n '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events
                           nl_ps_typed_saved nl_ps_outer_saved_select nl_ps_outer_saved nl_sb_toplevel_in_list
                           nl_sb_toplevel_walk nl_sb_toplevel_binding nl_n3_declared_default_raw_w))
                (unless (and old (eq n 'nl_ps_outer_saved_select))
                  (push (cons n (and (fboundp n) (symbol-function n))) saved)
                  (let ((f (copy-tree (tsq--form n (or old (and setter-old (eq n 'nl_n3_declared_default_raw_w)))))))
                    (pcase mutant
                      ('selector (when (eq n 'nl_sb_toplevel_binding)
                                   (setq f (cl-subst '(nl_ps_outer_saved_select env sym 0)
                                                    '(nl_ps_outer_saved_select env sym 1) f :test #'equal))))
                      ('ordering (when (eq n 'nl_ps_outer_saved_select)
                                   (setq f (cl-subst '(< at-depth oldest) '(<= at-depth oldest) f :test #'equal))))
                      ('target (when (eq n 'nl_n3_declared_default_raw_w)
                                 (setq f (cl-subst '(vector-slot-set binding 0 val)
                                                  '(vector-slot-set binding 1 val) f :test #'equal)))))
                    (when old
                      (when (memq n '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events))
                        (setf (nth 2 f) (cons 'env (nth 2 f))))
                      (cl-labels ((with-env (node)
                                    (if (atom node) node
                                      (if (and (memq (car node) '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events))
                                               (= (length node) 2))
                                          (list (car node) 'env (with-env (cadr node)))
                                        (mapcar #'with-env node)))))
                        (setq f (with-env f))))
                    (fset n (eval (cons 'lambda (cddr (sst--host-form (tsq--extern f)))) t)))))
              (let* ((answer (nl_sb_toplevel_binding 1000 101)) (before (decode answer))
                     (inclusive (decode (nl_ps_outer_saved 1000 101)))
                     (returned (and set-value (nl_n3_declared_default_raw_w 1000 101 set-value 0))))
                (list before (decode answer) inclusive returned
                      (and (= (tag answer) 8) (memq answer payloads) t) (nreverse writes))))
          (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s)))))))))
(defconst tsq--cases
  '((frame (([101 7])) nil (vector (101 7)))
    (typed nil ((0 ((13 [101 7 201])))) (vector (101 7 201)))
    (typed-before-general (([101 11])) ((0 ((1 3) (13 [101 7 201])))) (vector (101 7 201)))
    (typed-after-general (([101 7])) ((0 ((13 [101 11 201]) (1 3)))) (vector (101 7)))
    (nested nil ((0 ((13 [101 11 201]))) (0 ((13 [101 7 201])))) (vector (101 7 201)))
    (older-lean-later-frame (([101 11])) ((0 ((1 3) (101 . 7)))) (vector (101 11)))
    (older-lean-later-typed nil ((0 ((13 [101 11 201]) (101 . 7)))) (vector (101 11 201)))
    (wrong-name nil ((0 ((13 [102 7 201])))) 0)
    (wrong-kind nil ((0 ((9 [101 7 201])))) 0)
    (wrong-arity nil ((0 ((13 [101 7])))) 0)
    (dotted nil ((0 ((13 [101 7 201] . 99)))) 0)))
(ert-deftest tsq-vectors-only-chronology-and-legacy-ignore ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/toplevel-query/builder-before.el" tsq--root)))
  (dolist (c tsq--cases)
    (pcase-let ((`(,id ,frames ,links ,expected) c))
      (ert-info ((format "%s" id)) (should (equal expected (car (tsq--run frames links)))))))
  (should (equal (car (tsq--run '(([101 11])) '((0 ((1 3) (101 . 7)))) nil t)) '(vector (101 11))))
  (should (= (car (tsq--run nil '((0 ((13 [101 7 201])))) nil t)) 0)))
(ert-deftest tsq-compact-and-view-borrowed-setter ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/toplevel-query/builder-before.el" tsq--root)))
  (dolist (view '(nil t))
    (let ((r (tsq--run nil '((0 ((13 [101 7 201])))) view nil 55)))
      (should (equal (nth 1 r) '(vector (101 55 201)))) (should (= (nth 3 r) 101)) (should (nth 4 r))))
  (should (equal (nth 1 (tsq--run '(([101 7])) nil t t 55)) '(vector (101 55))))
  (let ((failure (should-error (tsq--run nil '((0 ((13 [101 7 201])))) nil nil 55 nil t) :type 'error)))
    (should (string-prefix-p "No legacy view field " (cadr failure))))
  (let ((r (tsq--run nil '((0 ((13 [102 7 201])))) nil nil 55)))
    (should (= (car r) 0)) (should (equal (nth 5 r) '(fallback)))))
(ert-deftest tsq-actual-selector-ordering-target-mutants ()
  (dolist (spec '((selector nil ((0 ((13 [101 11 201]) (101 . 7)))) nil (vector (101 11 201)))
                  (ordering (([101 11])) ((0 ((1 3) (13 [101 7 201])))) nil (vector (101 7 201)))
                  (target nil ((0 ((13 [101 7 201])))) 55 (vector (101 55 201)))))
    (pcase-let ((`(,mutant ,frames ,links ,value ,expected) spec))
      (let ((index (if value 1 0)))
        (should (equal expected (nth index (tsq--run frames links nil nil value))))
        (should-error (should (equal expected (nth index (tsq--run frames links nil nil value mutant))))
                      :type 'ert-test-failed)))))
(provide 'nelisp-typed-save-toplevel-query-test)
