;;; par-preload-window-split.el --- Batch split and window enumeration -*- lexical-binding: t; -*-

(delete-other-windows)
(let* ((old (selected-window))
       (frame (selected-frame))
       (height (window-total-height old))
       (width (window-total-width old)))
  (unwind-protect
      (let ((new (split-window)))
        (prin1 (list (eq (window-frame new) frame)
                     (eq (selected-window) old)
                     (equal (window-list frame 'nomini) (list old new))
                     (equal (window-list frame 'nomini new) (list new old))
                     (eq (frame-root-window frame) (window-parent new))
                     (= (+ (window-total-height old) (window-total-height new)) height)))
        (terpri)
        (delete-other-windows)
        (let ((right (split-window old -20 'right)))
          (prin1 (list (equal (window-list) (list old right))
                       (window-total-width right)
                       (= (+ (window-total-width old) (window-total-width right)) width)))
          (terpri)))
    (delete-other-windows))
  (prin1 (list (equal (window-list) (list old))
               (eq (selected-window) old)
               (= (window-total-height old) height)
               (= (window-total-width old) width)))
  (terpri))
