;;; nelisp-standalone-gc-discard-test.el --- native free-page discard route -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)

(defconst nelisp-standalone-gc-discard-test--page #x35000000)

(defun nelisp-standalone-gc-discard-test--find (name)
  (or (cl-find-if (lambda (f) (and (eq (car-safe f) 'defun)
                                   (eq (cadr f) name)))
                  (append (cdr nelisp-standalone--gc-source)
                          (cdr nelisp-standalone--arena-source)))
      (error "missing GC form %S" name)))

(defun nelisp-standalone-gc-discard-test--rewrite (form)
  (cond
   ((and (consp form) (eq (car form) 'data-addr))
    (pcase (cadr form)
      ('nl_alloc_check (+ nelisp-standalone-gc-discard-test--page 800000))
      ('nl_gc_diag (+ nelisp-standalone-gc-discard-test--page 800256))
      (_ form)))
   ((and (integerp form) (= form 268436160))
    (+ nelisp-standalone-gc-discard-test--page 1000))
   ((consp form)
    (cons (nelisp-standalone-gc-discard-test--rewrite (car form))
          (nelisp-standalone-gc-discard-test--rewrite (cdr form))))
   (t form)))

(defun nelisp-standalone-gc-discard-test--source ()
  (let ((names '(nl_hdr_bt nl_hdr_mark nl_gc_bt_ok
                 nl_gc_discard_free_block nl_gc_relink_free_chunk)))
    `(seq
      (defun nl_seq2 (_a b) b)
      (defun nl_gc_chunk_end (chunk)
        (+ (ptr-read-u64 chunk 0) (ptr-read-u64 chunk 8)))
      (defun nl_gc_relink_free_one (_hdr) 0)
      (defun nl_os_discard_free_pages (base size)
        (let ((i 0))
          (seq
           (ptr-write-u64 #x35080200 0 (+ (ptr-read-u64 #x35080200 0) 1))
           (ptr-write-u64 #x35080200 8 base)
           (ptr-write-u64 #x35080200 16 size)
           (while (< i size)
             (ptr-write-u8 (+ base i) 0 0)
             (setq i (+ i 1)))
           -1)))
      ,@(mapcar (lambda (n)
                  (nelisp-standalone-gc-discard-test--rewrite
                   (nelisp-standalone-gc-discard-test--find n))) names)
      (defun t_assert (ok code)
        (if (= ok 1) 0 (syscall-direct 60 code 0 0 0 0 0)))
      (defun t_guard (cell code)
        (seq
         ;; Each flag is tested against a valid, otherwise discardable block,
         ;; through the production caller, not a copy of its guard.
         (ptr-write-u64 #x35001000 0 (+ #x20000 2))
         (ptr-write-u64 #x35021000 0 (+ #x20000 1))
         (ptr-write-u64 #x35080200 0 0)
         (ptr-write-u64 cell 0 1)
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 0) code)
         (ptr-write-u64 cell 0 0)))
      (defun t_run ()
        (seq
         (t_assert (= (syscall-direct 9 #x35000000 1048576 3 50 -1 0)
                      #x35000000) 1)
         (ptr-write-u64 #x35000000 0 #x35000000)
         (ptr-write-u64 #x35000000 8 #x80000)
         (ptr-write-u64 #x35000000 24 #x35001000)
         (ptr-write-u64 #x35001000 0 (+ #x20000 2))
         (ptr-write-u64 #x35001000 8 7777)
         (ptr-write-u64 #x35021000 0 (+ #x20000 1))
         (ptr-write-u64 #x35041000 0 8)
         (ptr-write-u64 #x35080200 0 0)
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 1) 2)
         (t_assert (= (ptr-read-u64 #x35080200 8) #x35010000) 3)
         (t_assert (= (ptr-read-u64 #x35080200 16) 65536) 4)
         (t_assert (= (ptr-read-u64 #x35001000 0) (+ #x20000 2)) 5)
         (t_assert (= (ptr-read-u64 #x35001000 8) 7777) 6)
         ;; The live and malformed blocks must not reach the discard stub.
         (ptr-write-u64 #x35080200 0 0)
         (ptr-write-u64 #x35001000 0 (+ #x20000 1))
         (ptr-write-u64 #x35021000 0 (+ #x20000 1))
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 0) 7)
         (ptr-write-u64 #x35001000 0 8)
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 0) 8)
         (t_guard ,(+ nelisp-standalone-gc-discard-test--page 800000) 9)
         (t_guard ,(+ nelisp-standalone-gc-discard-test--page 800008) 10)
         (t_guard ,(+ nelisp-standalone-gc-discard-test--page 800288) 11)
         ;; A failed discard must not prevent processing the next free block.
         (ptr-write-u64 #x35001000 0 (+ #x20000 2))
         (ptr-write-u64 #x35021000 0 (+ #x20000 2))
         (ptr-write-u64 #x35021000 8 8888)
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 2) 12)
         (t_assert (= (ptr-read-u64 #x35080200 8) #x35030000) 13)
         (t_assert (= (ptr-read-u64 #x35021000 8) 8888) 14)
         ;; A valid short block and a block extending past the chunk end
         ;; must never reach the OS boundary.
         (ptr-write-u64 #x35080200 0 0)
         (ptr-write-u64 #x35001000 0 (+ 4096 2))
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 0) 15)
         (ptr-write-u64 #x35001000 0 (+ #x80000 2))
         (nl_gc_relink_free_chunk #x35000000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 0) 16)
         ;; Exactly 64 KiB fits when the header/link end on the boundary.
         ;; The stub really zeroes the requested range, so metadata sentinels
         ;; also detect a range that incorrectly includes the first 16 bytes.
         (ptr-write-u64 #x3500fff0 0 (+ 65552 2))
         (ptr-write-u64 #x3500fff0 8 9999)
         (ptr-write-u64 #x35010000 0 123)
         (ptr-write-u64 #x3501fff8 0 456)
         (ptr-write-u64 #x35020000 0 789)
         (nl_gc_discard_free_block #x3500fff0 #x35020000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 1) 17)
         (t_assert (= (ptr-read-u64 #x35080200 8) #x35010000) 18)
         (t_assert (= (ptr-read-u64 #x35080200 16) 65536) 19)
         (t_assert (= (ptr-read-u64 #x3500fff0 0) (+ 65552 2)) 20)
         (t_assert (= (ptr-read-u64 #x3500fff0 8) 9999) 21)
         (t_assert (= (ptr-read-u64 #x35010000 0) 0) 22)
         (t_assert (= (ptr-read-u64 #x3501fff8 0) 0) 23)
         (t_assert (= (ptr-read-u64 #x35020000 0) 789) 24)
         ;; An aligned header must exclude its entire first page range.
         (ptr-write-u64 #x35040000 0 (+ #x20000 2))
         (ptr-write-u64 #x35040000 8 12345)
         (nl_gc_discard_free_block #x35040000 #x35060000)
         (t_assert (= (ptr-read-u64 #x35080200 0) 2) 25)
         (t_assert (= (ptr-read-u64 #x35080200 8) #x35050000) 26)
         (t_assert (= (ptr-read-u64 #x35080200 16) 65536) 27)
         (t_assert (= (ptr-read-u64 #x35040000 0) (+ #x20000 2)) 28)
         (t_assert (= (ptr-read-u64 #x35040000 8) 12345) 29)
         0))
      (exit (t_run)))))

(ert-deftest nelisp-standalone-gc-discard-native-route ()
  (unless (and (eq system-type 'gnu/linux)
               (string-match-p "x86_64\\|amd64" system-configuration))
    (ert-skip "Requires Linux x86_64"))
  (let ((path (make-temp-file "nelisp-gc-discard-")))
    (unwind-protect
        (progn
          (nelisp-aot-compile-sexp
           (nelisp-standalone-gc-discard-test--source) path)
          (should (= (call-process path nil nil nil) 0)))
      (when (file-exists-p path) (delete-file path)))))
