;;; nelisp-typed-save-notify-one-test.el --- Genuine notification factoring -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tsn--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tsn--old ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "target/typed-save/notify-one/builder-before.el" tsn--root))
    (goto-char (point-min)) (search-forward "(defun nl_n3_pop_names ")
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tsn--form (name &optional source)
  (with-temp-buffer
    (insert-file-contents (expand-file-name (or source "scripts/nelisp-standalone-build.el") tsn--root))
    (goto-char (point-min))
    (unless (search-forward (concat "(defun " (symbol-name name) " ") nil t)
      (error "Missing actual notification helper %s" name))
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tsn--run (data &optional old failure direct mutant wrapper)
  (let ((objects (make-hash-table :test #'eql)) (next 10000) trace saved)
    (cl-labels ((word (x) (if (or (vectorp x) (consp x))
                             (let ((p (cl-incf next 8)))
                               (puthash p (if (vectorp x) x (cons (word (car x)) (word (cdr x)))) objects) p) x))
                (tag (p) (let ((x (gethash p objects))) (cond ((consp x) 7) ((vectorp x) 8) (t 2))))
                (value (slot) (aref (gethash (nth 1 slot) objects) (nth 2 slot))))
      (let ((input (word data)))
        (cl-letf (((symbol-function 'sexp-tag) #'tag) ((symbol-function 'nl_val_tag) #'tag)
                  ((symbol-function 'nl_cons_car_word) (lambda (p) (car (gethash p objects))))
                  ((symbol-function 'nl_cons_cdr_word) (lambda (p) (cdr (gethash p objects))))
                  ((symbol-function 'vector-ref-ptr) (lambda (p n) (list :slot p n)))
                  ((symbol-function 'nelisp_frame_slot_raw_word) (lambda (_p _n) 5))
                  ((symbol-function 'nl_record_slot_word) (lambda (_p n) (if (= n 0) 600 input)))
                  ((symbol-function 'nl_vector_slot_word) (lambda (_p _n) 700))
                  ((symbol-function 'heap-sexp-data) (lambda (_p) 0))
                  ((symbol-function 'alloc-bytes) (lambda (_size _alignment) 800))
                  ((symbol-function 'wf_write_nil) (lambda (_p) 0))
                  ((symbol-function 'nelisp_frame_pop)
                   (lambda (_frames _scratch) (push '(restore-frame) trace) 0))
                  ((symbol-function 'nl_n3_notify)
                   (lambda (env name val op)
                     (push (list 'notify env (value name) (value val) op) trace)
                     (if failure 1 0)))
                  ((symbol-function 'nl_n4_pop_repeat)
                   (lambda (_env _names depth status) (push (list 'repeat depth status) trace) status))
                  ((symbol-function 'nl_n4_pop_names_raw)
                   (lambda (_env _names depth status) (push (list 'raw depth status) trace) status)))
          (unwind-protect
              (progn
                (dolist (n (append (if old '(nl_n3_pop_names)
                                       '(nl_sb_migrated_default_vector nl_n3_notify_restore_one nl_n3_pop_names))
                                  (and wrapper '(nl_n3_pop))))
                  (push (cons n (and (fboundp n) (symbol-function n))) saved)
                  (let ((f (copy-tree (if (and old (eq n 'nl_n3_pop_names)) (tsn--old) (tsn--form n (and (eq n 'nl_sb_migrated_default_vector)
                                                                                  "lisp/nelisp-cc-frame-stack-find.el"))))))
                    (when (and (eq mutant 'operation) (eq n 'nl_n3_notify_restore_one))
                      (let ((call (sst--find f (lambda (x) (eq (car-safe x) 'nl_n3_notify)))))
                        (setf (nth 4 call) 2)))
                    (when (and (eq mutant 'order) (eq n 'nl_n3_pop_names))
                      (let ((seq (sst--find f (lambda (x) (eq (car-safe x) 'seq)))))
                        (setcdr seq (reverse (cdr seq)))))
                    (fset n (eval (cons 'lambda (cddr (sst--host-form f))) t))))
                (list (cond (wrapper (nl_n3_pop 100)) (direct (nl_n3_notify_restore_one 100 input))
                            (t (nl_n3_pop_names 100 input 2 7)))
                      (nreverse trace)))
            (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s))))))))))
(defconst tsn--cases
  '((nil 3 nil) (immediate 9 nil) (nonlist [101 7] nil)
    (nil-head (3 . 3) nil) (immediate-head (9 . 3) nil)
    (nonvector-repeat ((77 . 3) . 3) nil)
    (two-slot ([101 7] . 3) nil) (three-slot ([101 7 201] . 3) nil)
    (oldnil ([101 3] . 3) nil) (multiple ([101 7] [102 11] . 3) nil)
    (failure-continues ([101 7] [102 11] . 3) t)
    (vector-then-repeat ([101 7] (77 . 3) . 3) nil)))
(ert-deftest tsn-genuine-old-new-guards-traces ()
  (dolist (c tsn--cases)
    (pcase-let ((`(,id ,data ,failure) c))
      (ert-info ((format "%s" id))
        (should (equal (tsn--run data t failure) (tsn--run data nil failure)))))))
(ert-deftest tsn-direct-operation-and-ignored-failure ()
  (should (equal (tsn--run [101 7] nil nil t) '(0 ((notify 100 101 7 3)))))
  (should (equal (tsn--run [101 3 201] nil t t) '(1 ((notify 100 101 3 3)))))
  (should (equal (tsn--run '([101 7] [102 11] . 3) nil t)
                 '(7 ((notify 100 101 7 3) (notify 100 102 11 3) (raw 2 7))))))
(ert-deftest tsn-actual-operation-order-mutants-reject ()
  (let* ((data '([101 7] [102 11] . 3)) (expected (tsn--run data t)))
    (should (equal expected (tsn--run data)))
    (dolist (mutant '(operation order))
      (should-error (should (equal expected (tsn--run data nil nil nil mutant)))
                    :type 'ert-test-failed))))
(ert-deftest tsn-notifier-failure-does-not-skip-frame-restoration ()
  (let* ((data '([101 7] [102 11] . 3)) (old (tsn--run data t t nil nil t)))
    (should (equal old '(1 ((notify 100 101 7 3) (notify 100 102 11 3) (raw 1 0) (restore-frame)))))
    (should (equal old (tsn--run data nil t nil nil t)))))
(provide 'nelisp-typed-save-notify-one-test)
