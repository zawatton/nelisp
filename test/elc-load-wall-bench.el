;;; elc-load-wall-bench.el --- identical GNU bytecode measurement callers -*- lexical-binding: t; -*-
(declare-function mx-a "mxlib" (xs))
(declare-function mx-b "mxlib" (xs))
(defun elc-wall-time-a (count)
  (let ((i 0) (answer nil) (start (float-time)))
    (while (< i count)
      (setq answer (mx-a '(1 2 3 4 5 6)))
      (setq i (1+ i)))
    (list (- (float-time) start) answer)))
(defun elc-wall-time-b (count)
  (let ((i 0) (answer nil) (start (float-time)))
    (while (< i count)
      (setq answer (mx-b '(1 2 3 4 5 6)))
      (setq i (1+ i)))
    (list (- (float-time) start) answer)))
