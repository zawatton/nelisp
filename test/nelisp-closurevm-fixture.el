;;; nelisp-closurevm-fixture.el --- Closure semantics, same results on GNU and the VM -*- lexical-binding: t; -*-
;; With CV_REQUIRE_VM=1 the closures a phase-1 design covers must be VM records
;; (cv-vm), and closures over a variable must NOT be (cv-interp): they run on
;; the interpreter, so every semantic below holds by construction.
(defvar cv-count 0)
(defvar cv-g 0)
(defun cv-rec-p (fn)
  (and (boundp 'nelisp--fx-table) (vectorp (gethash (nthcdr 3 fn) nelisp--fx-table))))
(defun cv-warm (fn &rest args)
  "Apply FN enough times for a loop-free anonymous lambda to be compiled."
  (dotimes (_ 300) (apply fn args)))
(defun cv-vm (fn)
  (when (and (equal (getenv "CV_REQUIRE_VM") "1") (not (cv-rec-p fn)))
    (error "Closure did not reach VM: %S" fn)))
(defun cv-interp (fn)
  (when (and (equal (getenv "CV_REQUIRE_VM") "1") (cv-rec-p fn))
    (error "Closure over a variable must stay interpreted: %S" fn)))
(defun cv-check (name actual expected)
  (unless (equal actual expected) (error "%s: %S != %S" name actual expected))
  (setq cv-count (1+ cv-count))
  (princ (format "CV %s %S\n" name actual)))

;; ---- closures with no captured variable: VM ----
(defvar cv-sum (lambda (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s i)) (setq i (1+ i))) s)))
(funcall cv-sum 10)
(cv-check 'sum-loop (funcall cv-sum 100) 4950)
(cv-vm cv-sum)
;; a loop-free lambda applied a few times stays interpreted (boot lambdas)
(defvar cv-once (lambda (x) (+ x 1)))
(funcall cv-once 1) (funcall cv-once 2)
(cv-check 'few-calls (funcall cv-once 3) 4)
(cv-interp cv-once)
;; global mutation visible both ways, two closures sharing one variable
(defvar cv-inc (lambda () (setq cv-g (1+ cv-g))))
(defvar cv-get (lambda () cv-g))
(cv-warm cv-inc) (cv-warm cv-get)
(setq cv-g 10)
(cv-check 'outer-write-seen (funcall cv-get) 10)
(cv-check 'inner-write-seen (list (funcall cv-inc) cv-g (funcall cv-get)) '(11 11 11))
(cv-vm cv-inc) (cv-vm cv-get)
;; recursion through a global holding the closure itself
(defvar cv-rec (lambda (n) (if (= n 0) 0 (+ n (funcall cv-rec (1- n))))))
(cv-warm cv-rec 3)
(cv-check 'recursion (funcall cv-rec 50) 1275)
(cv-vm cv-rec)
;; re-entry: A calls B calls A with other arguments
(defvar cv-a nil) (defvar cv-b nil)
(setq cv-a (lambda (n) (if (> n 0) (+ 1 (funcall cv-b (1- n))) 0)))
(setq cv-b (lambda (n) (if (> n 0) (+ 10 (funcall cv-a (1- n))) 0)))
(cv-warm cv-a 2)
(cv-check 'reentry (funcall cv-a 5) 23)
(cv-vm cv-a) (cv-vm cv-b)
;; arity: optional and rest, and the interpreter's error for a wrong count
(defvar cv-ar (lambda (a &optional b &rest c) (list a b c)))
(cv-warm cv-ar 1)
(cv-check 'arity (list (funcall cv-ar 1) (funcall cv-ar 1 2 3 4)) '((1 nil nil) (1 2 (3 4))))
(cv-check 'arity-error (car (condition-case e (funcall cv-ar) (error e))) 'wrong-number-of-arguments)
(cv-vm cv-ar)
;; mapcar / mapc / funcall of an anonymous lambda
(cv-check 'mapcar-anonymous (mapcar (lambda (x) (* x x)) '(1 2 3)) '(1 4 9))
(cv-check 'funcall-anonymous (funcall (lambda (a b) (+ a b)) 3 4) 7)
(fset 'cv-fset (lambda (x) (+ x cv-g)))
(defalias 'cv-defalias (lambda (x) (* 2 x)))
(setq cv-g 5) (cv-fset 1) (cv-defalias 1)
(cv-check 'fset-defalias (list (cv-fset 1) (cv-defalias 4)) '(6 8))
;; mixed special, local and parameter inside one VM body
(defvar cv-mix (lambda (p) (let ((l (+ p 1))) (setq cv-g (+ cv-g l)) (list p l cv-g))))
(setq cv-g 0) (cv-warm cv-mix 1)
(setq cv-g 100)
(cv-check 'mixed-special-local (funcall cv-mix 3) '(3 4 104))
(cv-vm cv-mix)
;; a closure built by a function that returned, with a collection between
(defun cv-make () (lambda (x) (+ x cv-g)))
(let ((f (cv-make)))
  (setq cv-g 1)
  (garbage-collect)
  (funcall f 1) (garbage-collect) (funcall f 1)
  (setq cv-g 2)
  (cv-check 'after-frame-returned-gc (funcall f 40) 42))

;; ---- closures over a variable: interpreter, semantics preserved ----
(let* ((x 1) (inc (lambda () (setq x (+ x 1)))) (read (lambda () x)))
  (funcall inc) (funcall read)
  (cv-check 'cap-inner-write (funcall inc) 3)
  (cv-check 'cap-outer-sees x 3)
  (setq x 30)
  (cv-check 'cap-outer-write (funcall read) 30)
  (cv-check 'cap-shared (list (funcall inc) (funcall read)) '(31 31))
  (cv-check 'cap-mapcar (mapcar (lambda (n) (setq x (+ x n))) '(1 2 3)) '(32 34 37))
  (cv-interp inc) (cv-interp read))
(let ((x 0) (f nil))
  (setq f (lambda (n) (if (= n 0) x (setq x (+ x 1)) (funcall f (1- n)))))
  (funcall f 1)
  (cv-check 'cap-recursion (funcall f 5) 6)
  (cv-interp f))
(let* ((x 0) (inner (lambda () (setq x (+ x 10))))
       (outer (lambda () (setq x (+ x 1)) (funcall inner) (setq x (+ x 1)))))
  (funcall outer)
  (cv-check 'cap-reentry (funcall outer) 24)
  (cv-interp outer) (cv-interp inner))
(let* ((factory (lambda (x) (lambda () (setq x (+ x 1)))))
       (a (funcall factory 1)) (b (funcall factory 20)))
  (funcall a) (funcall b)
  (cv-check 'cap-same-code-different-env (list (funcall a) (funcall b)) '(3 22))
  (cv-interp a) (cv-interp b))
(let ((x (list 'live)) (f nil))
  (setq f (let ((y (list 'y))) (lambda () (garbage-collect) (setq x (cons 'new x)) (cons y x))))
  (garbage-collect)
  (funcall f)
  (cv-check 'cap-gc (funcall f) '((y) new new live))
  (cv-interp f))
(let ((x 5))
  (let ((f (lambda (p) (let ((l (* p 2))) (setq cv-g (+ cv-g x l)) (setq x (1+ x)) (list p l x cv-g)))))
    (setq cv-g 0) (funcall f 1)
    (cv-check 'cap-mixed (funcall f 2) '(2 4 7 17))
    (cv-check 'cap-mixed-outer x 7)
    (cv-interp f)))
(princ (format "CLOSUREVM COMPLETE checked=%d\n" cv-count))
(kill-emacs 0)
