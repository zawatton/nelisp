;;; nelisp-active-binding-query-test.el --- Query-only saved records -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst abq--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun abq--old ()
  "Read the genuine frozen definition, never a handwritten baseline."
  (with-temp-buffer
    (insert-file-contents (expand-file-name "target/binding-state/preservation/nelisp-standalone-build.el" abq--root))
    (goto-char (point-min)) (search-forward "(defun nl_sb_default_bound_here ")
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun abq--form (name)
  (or (cl-find-if (lambda (x) (eq (cadr x) name)) (cdr nelisp-standalone--n4-source))
      (error "Missing production definition %s" name)))
(defun abq--run (old frames links name buffer &optional mutant state-present arrays before-aux)
  (let* ((memory (make-hash-table :test #'eql)) (objects (make-hash-table :test #'eql))
         (next 100000) (saved nil) (env 1000) (fp 1032)
         (forbidden (make-hash-table :test #'eql)))
    (cl-labels ((box (x) (let ((id (cl-incf next 8))) (puthash id x objects) id))
                (word (x) (cond ((vectorp x) (box x))
                               ((consp x) (box (cons (word (car x)) (word (cdr x)))))
                               ((null x) 3) (t x)))
                (obj (w) (or (gethash w objects) w))
                (tag (w) (let ((x (obj w))) (cond ((vectorp x) 8) ((consp x) 7)
                                                                ((= w 3) 0) (t 2))))
                (slot (w n) (if (= w fp) (rd w (* n 8)) (aref (obj w) n)))
                (rd (p o) (when (gethash (+ p o) forbidden) (error "Dead array read %s" (+ p o)))
                    (or (gethash (+ p o) memory) (error "Invalid read %s+%s" p o))))
      (let ((backing (box (vconcat (mapcar (lambda (names) (box (vector 3 (word names)))) frames))))
            (state 9000) (link 0))
        (puthash (+ fp 0) backing memory) (puthash (+ fp 8) (+ 1 (* 4 (length frames))) memory)
        (cl-loop for events in (reverse links) for config in (reverse (or arrays (make-list (length links) nil))) do
          (let* ((p (+ next 8)) (aux (+ p 32))
                 (count (or (plist-get config :count) 1))
                 (live (if (and (= (logand count 3) 1) (<= 0 (ash count -2) 24)) (ash count -2) 0)))
            (setq next (+ aux (* 61 8)))
            (dotimes (i 61) (puthash (+ aux (* i 8)) 3 memory))
            (puthash (+ p 8) link memory) (puthash (+ p 16) (+ aux 8) memory)
            (puthash (+ p 24) 0 memory) (puthash (+ aux 8) (word events) memory)
            (puthash (+ aux 96) count memory)
            (dotimes (i 24)
              (let ((pair (nth i (plist-get config :pairs))) (slot (+ aux 104 (* i 16))))
                (when pair (puthash slot (car pair) memory) (puthash (+ slot 8) (word (cadr pair)) memory))
                (when (>= i live) (puthash slot t forbidden) (puthash (+ slot 8) t forbidden))))
            (setq link p)))
        (puthash (+ env 176) (if (or links state-present) state 0) memory)
        (puthash (+ state 16) link memory)
        ;; A different environment always has a matching record. It must
        ;; remain invisible to the query's owning env+32 frame stack.
        (puthash 2176 29000 memory) (puthash 29016 29100 memory)
        (puthash 29116 29208 memory) (puthash 29108 0 memory)
        (dotimes (i 61) (puthash (+ 29200 (* i 8)) 3 memory))
        (puthash 29296 5 memory) (puthash 29304 13 memory)
        (puthash 29312 (word (vector name 7 buffer)) memory)
        (puthash 29208 (word (list (list 13 (vector name 7 buffer)))) memory))
      (cl-letf (((symbol-function 'nelisp_frame_slot_raw_word) #'slot)
                ((symbol-function 'nl_record_slot_word) #'slot)
                ((symbol-function 'nl_vector_slot_word) #'slot)
                ((symbol-function 'vector-len) (lambda (w) (length (obj w))))
                ((symbol-function 'sexp-tag) #'tag) ((symbol-function 'nl_val_tag) #'tag)
                ((symbol-function 'nl_cons_car_word) (lambda (w) (car (obj w))))
                ((symbol-function 'nl_cons_cdr_word) (lambda (w) (cdr (obj w))))
                ((symbol-function 'nelisp_symbol_key_equal) (lambda (a b) (if (= a b) 1 0)))
                ((symbol-function 'bf_eq2) (lambda (a b) (if (or mutant (= a b)) 1 0)))
                ((symbol-function 'heap-read-u64) #'rd)
                ;; No suspended N4 cuts are modeled here, so every binding is visible.
                ((symbol-function 'nl_n4_binding_visible) (lambda (&rest _) 1))
                ((symbol-function 'wf_bytecode_w_int) (lambda (w) (ash w -2))))
        (unwind-protect
            (progn
              (dolist (n (if old '(nl_sb_default_bound_here)
                           '(nl_sb_saved_default_match nl_sb_aux_default_bound_here nl_sb_default_bound_here)))
                (push (cons n (and (fboundp n) (symbol-function n))) saved)
                (let ((f (cond ((and old (eq n 'nl_sb_default_bound_here)) (abq--old))
                               ((and before-aux (eq n 'nl_sb_aux_default_bound_here)) before-aux)
                               (t (abq--form n)))))
                  (fset n (eval (cons 'lambda (cddr (sst--host-form f))) t))))
              (let ((before (copy-hash-table memory)) (before-objects (make-hash-table :test #'eql)))
                ;; Copy conses AND vectors; shared mutable objects must not
                ;; let a write alter both the heap and its alleged snapshot.
                (maphash (lambda (k v) (puthash k (copy-tree v t) before-objects)) objects)
                (prog1 (nl_sb_default_bound_here fp name buffer)
                  (should (= (hash-table-count before) (hash-table-count memory)))
                  (maphash (lambda (k v) (should (equal v (gethash k memory)))) before)
                  (should (= (hash-table-count before-objects) (hash-table-count objects)))
                  (maphash (lambda (k v) (should (equal v (gethash k objects)))) before-objects))))
          (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s)))))))))
(defconst abq--cases
  '((frame-positive (([101 7 201])) nil 101 201 1 1)
    (frame-negative (([101 7 202])) nil 101 201 0 0)
    (aux-positive nil (((13 [101 7 201]))) 101 201 0 1)
    (nested-owner nil (((1 3)) ((13 [101 7 201]))) 101 201 0 1)
    (mixed-frame (([999 7 201])) (((1 3) (13 [101 7 201]))) 101 201 0 1)
    (other-buffer nil (((13 [101 7 202]))) 101 201 0 0)
    (other-name nil (((13 [102 7 201]))) 101 201 0 0)
    (short-vector nil (((13 [101 7]))) 101 201 0 0)
    (long-vector nil (((13 [101 7 201 9]))) 101 201 0 0)
    (cleanup-ignored nil (((5 [101 7 201]))) 101 201 0 0)
    (restore-ignored nil (((9 [101 7 201]))) 101 201 0 0)
    (unknown-ignored nil (((17 [101 7 201]))) 101 201 0 0)
    (bad-payload nil (((13 99))) 101 201 0 0)
    (short-event nil (((13))) 101 201 0 0)
    (dotted-event nil (((13 . 99))) 101 201 0 0)
    (dotted-payload-tail nil (((13 [101 7 201] . 99))) 101 201 0 0)
    (empty-event nil ((nil)) 101 201 0 0)
    (zero-state nil nil 101 201 0 0)
    (empty-event-list nil (nil) 101 201 0 0)
    (extra-payload nil (((13 [101 7 201] 99))) 101 201 0 0)
    (lean-symbol-ignored nil (((101 . 77))) 101 201 0 0)
    (duplicate nil (((13 [101 7 201]) (13 [101 7 201]))) 101 201 0 1)))
(ert-deftest abq-focused-old-new ()
  (skip-unless (file-exists-p (expand-file-name "target/binding-state/preservation/nelisp-standalone-build.el" abq--root)))
  (dolist (c abq--cases)
    (pcase-let ((`(,id ,frames ,links ,name ,buffer ,old ,new) c))
      (ert-info ((format "%s" id))
        (should (= old (abq--run t frames links name buffer)))
        (should (= new (abq--run nil frames links name buffer)))))))
(ert-deftest abq-wrong-buffer-mutant-is-rejected ()
  (should (= 0 (abq--run nil nil '(((13 [101 7 202]))) 101 201)))
  (should-error (should (= 0 (abq--run nil nil '(((13 [101 7 202]))) 101 201 t)))
                :type 'ert-test-failed))
(ert-deftest abq-existing-state-empty-link-chain ()
  (skip-unless (file-exists-p (expand-file-name "target/binding-state/preservation/nelisp-standalone-build.el" abq--root)))
  (dolist (old '(t nil))
    (should (= 0 (abq--run old nil nil 101 201 nil t)))))
(ert-deftest abq-no-producer-or-spilling-admission ()
  (dolist (name '(nl_sb_saved_default_match nl_sb_aux_default_bound_here))
    (dolist (forbidden '(wf_bytecode_w_link_events wf_bytecode_w_aux_unwinds
                         wf_bytecode_w_aux_spill alloc-bytes ptr-write-u64))
      (should-not (sst--find (abq--form name) (lambda (x) (eq x forbidden))))))
  (let (kinds)
    (cl-labels ((walk (x)
                 (when (consp x)
                   (when (eq (car x) 'wf_bytecode_unwind_push) (push (nth 3 x) kinds))
                   (mapc #'walk x))))
      (mapc #'walk nelisp-standalone--applyfn-bytecode-helpers))
    (should (equal (sort (delete-dups kinds) #'<) '(0 1 2)))))
(provide 'nelisp-active-binding-query-test)
