;;; nelisp-checked-promotion-env-test.el --- Finite genuine root flow -*- lexical-binding: t; -*-
(require 'nelisp-checked-promotion-test)
(defvar ce--catalog nil)
(defun ce--old-intern ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "../out/checked-promotion/raw-while/source-snapshot/lisp/nelisp-cc-nlstr-direct-ops.el" cp--root))
    (goto-char 1)
    (catch 'found
      (while t
        (let ((todo (list (read (current-buffer)))))
          (while todo (let ((x (pop todo)))
            (when (consp x) (if (eq (car x) 'defun)
                (when (eq (cadr x) 'nl_record_type_intern_own) (throw 'found x))
              (push (car x) todo) (push (cdr x) todo))))))))))
(defconst ce--providers
  '((nl_record_type_own_env . 2) (nl_record_type_intern_own_env . 2)
    (nl_record_type_own . 1) (nl_record_type_intern_own . 1)
    (nl_symbol_name_value . 3) (nl_symbol_name_value_create . 3)
    (nl_symname_copy32 . 3) (nl_root_mark . 1) (nl_root_mark_at . 2)
    (nl_root_frame . 2) (nl_root_frame_slow . 2) (nl_root_frame_at . 3)
    (nl_root_reserve_checked . 1) (nl_root_reserve_slot . 1) (nl_root_reserve_private . 3)
    (nl_root_release . 2) (nl_root_release_at . 3) (nl_rootstack_end . 0)
    (nl_rootstack_init . 0) (nl_thread_registry_entry . 1)
    (nl_thread_registry_find . 1) (nl_thread_registry_find_from . 3)
    (nl_thread_registry_store_top . 2) (nl_record_type_word . 1)
    (nl_record_slot_word . 2) (nl_word_payload . 1) (nl_frame_stack_promote_checked_new . 3)))
(defun ce--form (name)
  (unless ce--catalog
    (setq ce--catalog (make-hash-table))
    (dolist (file '("scripts/nelisp-standalone-build.el" "lisp/nelisp-cc-rootstack.el"
                    "lisp/nelisp-cc-nlstr-direct-ops.el" "lisp/nelisp-cc-val-load.el"
                    "lisp/nelisp-cc-sexp-clone-into.el" "lisp/nelisp-cc-string-blocks.el"))
      (with-temp-buffer
        (insert-file-contents (expand-file-name file cp--root)) (goto-char 1)
        (condition-case nil
            (while t
              (let ((todo (list (read (current-buffer)))))
                (while todo (let ((x (pop todo)))
                  (when (consp x) (if (eq (car x) 'defun) (puthash (cadr x) x ce--catalog)
                    (push (car x) todo) (push (cdr x) todo)))))))
          (end-of-file nil)))))
  (or (gethash name ce--catalog) (error "Missing finite provider %s" name)))
(defun ce--fn (form)
  (setq form (cp--lower form))
  (eval `(lambda ,(nth 2 form)
    (cl-macrolet
      ((seq (&rest xs) (cons 'progn xs))
       (if (test yes &rest no) `(cond ((let ((v ,test)) (cond ((eq v 0) nil) ((null v) nil) (t t))) ,yes) (t ,@no)))
       (or (&rest xs) (if (null xs) 0 `(let ((v ,(car xs))) (cond ((cond ((eq v 0) nil) ((null v) nil) (t t)) 1) (t (or ,@(cdr xs)))))))
       (and (&rest xs) (if (null xs) 1
                         `(let ((v ,(car xs))) (cond ((eq v 0) 0) ((null v) 0) (t (and ,@(cdr xs)))))))
       (cp--raw-while (test &rest body) `(while (let ((v ,test)) (cond ((eq v 0) nil) ((null v) nil) (t t))) ,@body))
       (extern-call (name &rest xs) (cons name xs))
       (data-addr (symbol) (unless (symbolp symbol) (error "Literal data identifier required"))
         `(funcall (symbol-function 'data-addr) ',symbol)))
      ,@(cdddr form))) t))
(defun ce--seal-manifest (path)
  "Check complete finite calls and source arities before executing any model."
  (let* ((leaves '((nl_val_tag . 1) (nl_symbol_name_entry_for . 3) (nl_symbol_name_copy_out . 2)
                   (nl_alloc_str_write_tag . 6) (nl_symbol_name_register . 4)
                   (nl_sexp_clone_into . 2) (nl_string_store_view . 2) (nl_val_clone_into . 2)
                   (wf_bytecode_root_exhausted . 0)))
         (intrinsics '(if seq let let* setq while or and = /= < <= > >= + - * logand logior
                       sar heap-read-u64 heap-read-u8 ptr-write-u64 data-addr
                       atomic-fetch-add atomic-compare-exchange alloc-bytes)) asts)
    (cl-labels ((scan (x)
                  (when (consp x)
                    (pcase (car x)
                      ((or 'let 'let*) (mapc (lambda (b) (scan (cadr b))) (cadr x)) (mapc #'scan (cddr x)))
                      ('setq (scan (caddr x)))
                      ('data-addr (unless (memq (cadr x) '(nl_rootstack_top nl_rootstack_region nl_thread_registry nl_frame_stack_registry))
                                    (error "Unknown data field %S" x)))
                      (_ (let ((target (if (eq (car x) 'extern-call) (cadr x) (car x))))
                           (unless (or (assq target ce--providers) (assq target leaves) (memq target intrinsics))
                             (error "Unknown finite call %s" target))
                           (mapc #'scan (if (eq (car x) 'extern-call) (cddr x) (cdr x)))))))))
      (dolist (pair (append ce--providers leaves))
        (let ((form (ce--form (car pair))))
          (unless (= (length (nth 2 form)) (cdr pair)) (error "Finite arity %s" (car pair)))
          (when (assq (car pair) ce--providers) (mapc #'scan (cdddr form)))
          (push (list (car pair) (nth 2 form) (secure-hash 'sha256 (prin1-to-string form))) asts)))
      (let* ((old (cadddr (ce--old-intern))) (new (cadddr (ce--form 'nl_record_type_intern_own))))
        (unless (and (equal (cadr old) (cadr new))
                     (equal (cl-subseq (caddr old) 0 3) (cl-subseq (caddr new) 0 3)))
          (error "Legacy cache-hit AST changed")))
      (with-temp-file path (prin1 (list :providers (nreverse asts) :intrinsics intrinsics
                                     :and 'RAW-zero-shortcircuit-boolean
                                     :boundaries 'explicit-controlled-not-native) (current-buffer))))))
(defvar ce--name-trace nil)
(defun ce--name-leaf (leaf allowed action)
  "Apply identical explicit name-domain checks to all three modeled leaves."
  (lambda (&rest args)
    (let* ((stringp (eq leaf 'alloc-str))
           (key (nth (if stringp 0 1) args))
           (kind (if stringp 1 (nth 0 args)))
           (len (nth (if stringp 1 2) args)))
      (should (= (length args) (pcase leaf ('entry-for 3) ('alloc-str 6) ('register 4))))
      (should (= kind 1)) (should (= len 3))
      (push (list leaf '(memq key allowed) key allowed (not (null (memq key allowed)))) ce--name-trace)
      (should (memq key allowed))
      (when stringp (should (= (nth 2 args) 3)) (should (= (nth 5 args) 14)))
      (apply action args))))
(defun ce--run (env mode &optional fail mutant scenario)
  (let ((mem (make-hash-table :test #'eql)) installed (next 500000) requests releases
        (present (memq mode '(cached legacy-hit))) (names (make-hash-table))
        (req 0) (exhausted 0) result before-release (roots 0) extra
        (worker 200000) (global 100000) (registry 91000) (type-relocated nil))
    (cl-labels ((rd (p o) (gethash (+ p o) mem 0))
                (wr (p o v) (puthash (+ p o) v mem) v)
                (top (e) (if (= e worker) (rd e 120) (rd 90000 0)))
                (snapshot () (list (rd 90000 0) (rd worker 120) (rd 91024 0) (rd 300000 120))))
      (wr 90000 0 global) (wr registry 0 1) (wr 91016 0 worker)
      (wr worker 120 (+ worker 4096)) (wr 91024 0 (+ worker 4096)) (wr 300000 120 304096)
      (wr 1000 0 1036) (wr 1000 8 2000) (wr 1000 48 777) (wr 4000 0 1006)
      (dotimes (i 4) (wr 1000 (+ 16 (* i 8)) (+ 5 (* i 4))))
      (wr 2000 0 4) (wr 2000 16 1234) (wr 2000 24 3)
      (wr 3000 80 (if present 8000 0))
      (when present (puthash 1234 t names))
      (when (plist-get scenario :setup) (funcall (plist-get scenario :setup) #'rd #'wr))
      (when (eq mode 'pending) (wr 268435472 0 2) (wr 268435544 0 17) (wr 70000 0 99))
      (let ((initial (snapshot)))
        (cl-letf (((symbol-function 'heap-read-u64) #'rd)
                  ((symbol-function 'heap-read-u8) (lambda (p o) (logand (rd p o) 255)))
                  ((symbol-function 'ptr-write-u64) #'wr)
                  ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
                  ((symbol-function 'data-addr)
                   (lambda (name) (or (cdr (assq name '((nl_rootstack_top . 90000) (nl_rootstack_region . 100000)
                                                     (nl_thread_registry . 91000) (nl_frame_stack_registry . 92000)))) (error "Unknown data identifier"))))
                  ((symbol-function 'atomic-fetch-add) (lambda (p n) (prog1 (rd p 0) (wr p 0 (+ (rd p 0) n)))))
                  ((symbol-function 'atomic-compare-exchange)
                   (lambda (p old new) (if (= (rd p 0) old) (progn (wr p 0 new) 1) 0)))
                  ((symbol-function 'nl_val_tag) (lambda (w) (rd w 0)))
                  ((symbol-function 'nl_symbol_name_entry_for)
                   (ce--name-leaf 'entry-for (or (plist-get scenario :allowed-keys) '(1234))
                     (lambda (_kind key _len) (if (gethash key names) (if (= key 1234) 3000 3128) 0))))
                  ((symbol-function 'nl_symbol_name_copy_out) (lambda (_entry out) (wr out 0 5) 1))
                  ((symbol-function 'nl_alloc_str_write_tag)
                   (ce--name-leaf 'alloc-str (or (plist-get scenario :allowed-keys) '(1234))
                   (lambda (_key _len _count out _buffer _tag)
                     (if (eq mode 'name-pending)
                         (progn (wr 268435472 0 1) (wr 268435544 0 1) (wr 70000 0 88) 0)
                       (wr out 0 5) 1))))
                  ((symbol-function 'nl_symbol_name_register)
                   (ce--name-leaf 'register (or (plist-get scenario :allowed-keys) '(1234))
                     (lambda (_kind key _len _view) (puthash key t names) 1)))
                  ((symbol-function 'nl_sexp_clone_into) (lambda (&rest _) (error "Unsupported name representation")))
                  ((symbol-function 'nl_string_store_view) (lambda (&rest _) (error "Unsupported canonical string")))
                  ((symbol-function 'alloc-bytes)
                   (lambda (n align) (let ((p next)) (cl-incf next 128) (should (= (mod p align) 0))
                     (when (and (= n 48) (eq mode 'relocate))
                       (setq type-relocated (rd roots 0)) (wr roots 0 8128)) p)))
                  ((symbol-function 'nl_val_clone_into)
                   (lambda (word destination)
                     (when (plist-get scenario :clone) (funcall (plist-get scenario :clone) #'rd #'wr))
                     (wr destination 0 word)))
                  ((symbol-function 'wf_bytecode_root_exhausted)
                   (lambda () (cl-incf exhausted) (wr 268435472 0 1) (wr 268435544 0 1) 0)))
          (unwind-protect
              (progn
                (dolist (pair ce--providers)
                  (let ((form (copy-tree (ce--form (car pair)))))
                    (should (= (length (nth 2 form)) (cdr pair)))
                    (when (eq mutant 'wrong-env)
                      (when (eq (car pair) 'nl_record_type_own_env)
                        (setq form (cl-subst '(nl_record_type_intern_own_env 0 word)
                                            '(nl_record_type_intern_own_env env word) form :test #'equal))))
                    (when (and (eq mutant 'skip-release) (eq (car pair) 'nl_record_type_intern_own_env))
                      (setq form (cl-subst 0 '(nl_root_release env mark) form :test #'equal)))
                    (when (and (eq mutant 'stale) (eq (car pair) 'nl_frame_stack_promote_checked_new))
                      (setq form (cl-subst 'type '(heap-read-u64 roots 0) form :test #'equal)))
                    (when (plist-get scenario :mutate)
                      (setq form (funcall (plist-get scenario :mutate) (car pair) form)))
                    (push (cons (car pair) (and (fboundp (car pair)) (symbol-function (car pair)))) installed)
                    (fset (car pair) (ce--fn form))
                    (when (and (eq (car pair) 'nl_frame_stack_promote_checked_new) (plist-get scenario :observe))
                      (let ((body (symbol-function (car pair))))
                        (fset (car pair) (lambda (e f w)
                          (funcall (plist-get scenario :observe) f) (funcall body e f w)))))))
                ;; Observe capacity BEFORE the genuine checked reserve, then
                ;; execute it unchanged. Genuine releases restore every top.
                (let ((body (symbol-function 'nl_root_reserve_checked)))
                  (fset 'nl_root_reserve_checked
                    (lambda (e) (cl-incf req) (push e requests)
                      (when (and fail (= req fail))
                        (if (= e worker) (wr e 120 (+ e 1052672))
                          (wr 90000 0 (+ global 4194304))))
                      (funcall body e))))
                (let* ((mark (nl_root_mark env))
                       (workspace (if (eq mode 'workspace-fail)
                                  (progn (if (= env worker) (wr env 120 (+ env 1052672))
                                           (wr 90000 0 (+ global 4194304))) (nl_root_frame env 2))
                                (nl_root_frame env 2)))
                       (workspace-top (top env)))
                  (setq roots workspace)
                  (unwind-protect
                      (progn (setq result (cond ((eq mode 'old-miss) (funcall (ce--fn (ce--old-intern)) 2000))
                                               ((memq mode '(legacy-hit legacy-miss)) (nl_record_type_intern_own 2000))
                                               ((plist-get scenario :invoke) (funcall (plist-get scenario :invoke) env roots))
                                               (t (nl_frame_stack_promote_checked_new env 1006 roots))))
                             (setq before-release (list (top env) workspace-top)))
                    (nl_root_release env mark)))
                (when (plist-get scenario :collect) (setq extra (funcall (plist-get scenario :collect) #'rd #'wr))))
            (dolist (pair installed) (if (cdr pair) (fset (car pair) (cdr pair)) (fmakunbound (car pair))))
            (when (plist-get scenario :cleanup)
              (funcall (plist-get scenario :cleanup) initial (snapshot)))))
        (list :result result :requests (nreverse requests) :before-release before-release :extra extra
              :initial initial :final (snapshot) :pending (rd 268435472 0) :epoch (rd 268435544 0)
              :payload (rd 70000 0) :exhausted exhausted :forward (rd 1000 48) :backing (rd 4000 0)
              :type (and result (/= result 0) (rd (- result 6) 8)) :type-relocated type-relocated)))))
(ert-deftest checked-promotion-env-real-root-lifetime ()
  ;; Needs the untracked out/ source snapshot next to the checkout.
  (skip-unless (file-exists-p (expand-file-name "../out/checked-promotion/raw-while/source-snapshot/lisp/nelisp-cc-nlstr-direct-ops.el" cp--root)))
  (let ((miss (ce--run 0 'legacy-miss)) (old (ce--run 0 'old-miss)) (hit (ce--run 0 'legacy-hit)))
    (should (equal (plist-get miss :result) (plist-get old :result)))
    (should (equal (plist-get miss :requests) (plist-get old :requests)))
    (should (equal (plist-get miss :requests) '(0 0 0 0)))
    (should-not (plist-get hit :requests))
    (should (equal (plist-get miss :initial) (plist-get miss :final)))
    (should (equal (plist-get hit :initial) (plist-get hit :final))))
  (dolist (env '(0 200000 300000))
    (dolist (mode '(cold cached pending name-pending workspace-fail relocate))
      (let ((row (ce--run env mode)))
        (should (equal (plist-get row :initial) (plist-get row :final)))
        (should (= (plist-get row :forward) 777)) (should (= (plist-get row :backing) 1006))
        (when (eq mode 'cold) (should (equal (plist-get row :requests) (make-list 4 env))))
        (when (eq mode 'cached) (should-not (plist-get row :requests)))
        (when (eq mode 'pending) (should (= (plist-get row :epoch) 17)) (should (= (plist-get row :payload) 99)))
        (when (eq mode 'name-pending) (should (= (plist-get row :payload) 88)))
        (when (eq mode 'relocate) (should (= (plist-get row :type) 8128)))))
    (dotimes (n 4)
      (let ((row (ce--run env 'cold (1+ n))))
        (should (= (plist-get row :result) 0))
        (should (equal (plist-get row :initial) (plist-get row :final)))
        (should (= (length (plist-get row :requests)) (max 2 (1+ n))))))))
(ert-deftest checked-promotion-env-specific-negative-witnesses ()
  (let ((row (ce--run 200000 'cold nil 'wrong-env)))
    (should (equal (plist-get row :requests) '(0 0 0 0))))
  (let* ((row (ce--run 200000 'cold nil 'skip-release)) (tops (plist-get row :before-release)))
    (should (> (car tops) (cadr tops)))
    (should (equal (plist-get row :initial) (plist-get row :final))))
  (let ((row (ce--run 0 'relocate nil 'stale)))
    (should (= (plist-get row :type) (plist-get row :type-relocated)))
    (should-not (= (plist-get row :type) 8128))))
(provide 'nelisp-checked-promotion-env-test)
