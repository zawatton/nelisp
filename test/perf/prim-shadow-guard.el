;;; prim-shadow-guard.el --- Alias cache invalidation parity -*- lexical-binding: t; -*-

(defvar ps-guard-effects 0)
(defvar ps-guard-buffer nil)
(defun ps-guard-retarget ()
  (setq ps-guard-effects (1+ ps-guard-effects))
  (defvaralias 'ps-ga 'ps-gc)
  nil)
(defun ps-guard-detach ()
  (setq ps-guard-effects (1+ ps-guard-effects))
  (makunbound 'ps-ga)
  (set 'ps-ga 33)
  nil)
(defun ps-guard-delete ()
  (setq ps-guard-effects (1+ ps-guard-effects))
  (internal-delete-indirect-variable 'ps-ga)
  (set 'ps-ga 34)
  nil)
(defun ps-guard-switch () (set-buffer ps-guard-buffer) nil)
(defun ps-guard-read () ps-ga)
(defun ps-guard-mid () (list ps-ga (ps-guard-retarget) ps-ga))
(defun ps-guard-unbind () (list ps-ga (ps-guard-detach) ps-ga))
(defun ps-guard-remove () (list ps-ga (ps-guard-delete) ps-ga))
(defun ps-guard-local () (list ps-ga (ps-guard-switch) ps-ga))
(defun ps-guard-source (ps-ga) ps-ga)
(defun ps-guard-base (ps-gb) ps-ga)
(defun ps-guard-prepare ()
  (makunbound 'ps-ga)
  (set 'ps-gb 11)
  (set 'ps-gc 22)
  (defvaralias 'ps-ga 'ps-gb))
(defun ps-guard-register (fn)
  (when (and (fboundp 'nelisp--fx-register) (nelisp--fx-active-p))
    (nelisp--fx-register fn)
    (let ((record (gethash (nthcdr 3 (symbol-function fn)) nelisp--fx-table)))
      (unless (vectorp record) (error "Guard test was not compiled: %S" fn))
      (when (memq fn '(ps-guard-mid ps-guard-unbind ps-guard-remove
                      ps-guard-local ps-guard-base ps-guard-uninterned))
        (unless (= (aref (aref record 0) 2) 18)
          (error "Guard opcode missing: %S" fn))))))
(defun ps-guard-call (fn)
  ;; Execute the inspected record itself; first-call registration is allowed
  ;; to replace a table entry, so a table witness alone is insufficient.
  (if (and (fboundp 'nelisp--fx-run) (nelisp--fx-active-p))
      (let ((record (gethash (nthcdr 3 (symbol-function fn)) nelisp--fx-table)))
        (nelisp--fx-run (aref record 0) (aref record 1)))
    (funcall fn)))

(dolist (fn '(ps-guard-mid ps-guard-unbind ps-guard-remove))
  (ps-guard-prepare)
  (setq ps-guard-effects 0)
  (ps-guard-register fn)
  (prin1 (list fn (ps-guard-call fn) ps-guard-effects)) (terpri))
(ps-guard-prepare)
;; Special-named formals are intentionally outside FX coverage. Their
;; interpreter semantics still must retain source/base lexical precedence.
(prin1 (list 'lexical (ps-guard-source 44) (ps-guard-base 55))) (terpri)
(let ((a (generate-new-buffer " *ps-guard-a*"))
      (b (generate-new-buffer " *ps-guard-b*")))
  (unwind-protect
      (with-current-buffer a
        (set (make-local-variable 'ps-gb) 61)
        (with-current-buffer b (set (make-local-variable 'ps-gb) 62))
        (setq ps-guard-buffer b)
        (ps-guard-register 'ps-guard-local)
        (prin1 (list 'local (ps-guard-call 'ps-guard-local))) (terpri))
    (kill-buffer a) (kill-buffer b)))
(dolist (pair '((ps-gnil . nil) (ps-gt . t) (ps-gvoid . ps-gb)))
  (let ((source (car pair)) (base (cdr pair)))
  (when (eq base 'ps-gb) (makunbound 'ps-gb))
  (defvaralias source base)
  (eval (list 'defun 'ps-guard-terminal nil source) t)
  (ps-guard-register 'ps-guard-terminal)
  (prin1 (list 'terminal base (condition-case e (ps-guard-call 'ps-guard-terminal) (error e))))
  (terpri)))
(let ((source (make-symbol "ps-u")) (base (make-symbol "ps-u")))
  (set base 71)
  (defvaralias source base)
  (eval (list 'defun 'ps-guard-uninterned nil source) t)
  (ps-guard-register 'ps-guard-uninterned)
  (prin1 (list 'uninterned (ps-guard-call 'ps-guard-uninterned))) (terpri))
(ps-guard-prepare)
(eval '(defun ps-guard-dynamic (ps-ga) (list ps-ga ps-gb)) nil)
(prin1 (list 'dynamic-formal (ps-guard-dynamic 77) ps-gb)) (terpri)
(dolist (args '((ps-gb ps-gconst1) (ps-gb &optional ps-gconst2)
                (ps-gb &rest ps-gconst3)))
  (defvaralias (car (last args)) 't)
  (setq ps-guard-effects 0)
  (eval (list 'defun 'ps-guard-constant args '(setq ps-guard-effects 1)) nil)
  (prin1 (list 'constant-formal args
               (condition-case e (ps-guard-constant 99 98) (error e))
               ps-guard-effects ps-gb)) (terpri))
(eval '(defun pswb-read () (list pswb-b pswb-c)) nil)
(eval '(defun pswb-watch (_sym _new op _where)
         (when (eq op 'let)
           (remove-variable-watcher 'pswb-b 'pswb-watch)
           (setq pswb-events
                 (condition-case e (defvaralias 'pswb-b 'pswb-c) (error e))))) nil)
(dolist (mode '(interpreter bytecode))
  (makunbound 'pswb-b)
  (set 'pswb-b 11) (set 'pswb-c 22) (set 'pswb-events nil)
  (add-variable-watcher 'pswb-b 'pswb-watch)
  (let ((body (if (eq mode 'interpreter)
                  (eval '(let ((pswb-b 77)) (pswb-read)) nil)
                (funcall (make-byte-code 0 (unibyte-string 193 24 194 32 41 135)
                                        [pswb-b 77 pswb-read] 1)))))
    (prin1 (list 'watcher-binding mode body pswb-b pswb-c pswb-events)) (terpri)))
(eval '(defun pswb-throw (_sym _new op _where)
         (when (eq op 'let)
           (remove-variable-watcher 'pswb-b 'pswb-throw)
           (garbage-collect)
           (throw 'ps-pending 'caught))) nil)
(dolist (mode '(interpreter bytecode))
  (makunbound 'pswb-b)
  (set 'pswb-b 11) (set 'pswb-c 22)
  (add-variable-watcher 'pswb-b 'pswb-throw)
  (let* ((result (catch 'ps-pending
                   (if (eq mode 'interpreter)
                       (eval '(let ((pswb-c 90)) (let ((pswb-b 77)) (pswb-read))) nil)
                     (eval (list 'let '((pswb-c 90))
                                 (list 'funcall
                                       (make-byte-code 0 (unibyte-string 193 24 194 32 41 135)
                                                       [pswb-b 77 pswb-read] 1))) nil))))
         (before (list pswb-b pswb-c))
         (alias (defvaralias 'pswb-b 'pswb-c)))
    (prin1 (list 'watcher-unwind mode result before alias pswb-b)) (terpri)))
(defun pswm-watch (_sym _new op _where)
  (when (eq op 'let)
    (remove-variable-watcher 'pswm-base 'pswm-watch)
    (setq pswm-event (condition-case e (defvaralias 'pswm-base 'pswm-third) (error e)))))
(set 'pswm-source 17) (makunbound 'pswm-base) (set 'pswm-third 23)
(add-variable-watcher 'pswm-base 'pswm-watch)
(defvaralias 'pswm-source 'pswm-base)
(prin1 (list 'migration-retarget pswm-event pswm-source pswm-base pswm-third)) (terpri)
(defun pswr-retarget (_sym _new op _where)
  (when (eq op 'let)
    (remove-variable-watcher 'pswr-base 'pswr-retarget)
    (defvaralias 'pswr-alias 'pswr-third)))
(defun pswr-read () (list pswr-alias pswr-base pswr-third))
(dolist (mode '(interpreter bytecode))
  (makunbound 'pswr-alias)
  (set 'pswr-base 11) (set 'pswr-third 22)
  (defvaralias 'pswr-alias 'pswr-base)
  (add-variable-watcher 'pswr-base 'pswr-retarget)
  (let ((body (if (eq mode 'interpreter)
                  (eval '(let ((pswr-alias 77)) (pswr-read)) nil)
                (funcall (make-byte-code 0 (unibyte-string 193 24 194 32 41 135)
                                        [pswr-alias 77 pswr-read] 1)))))
    (prin1 (list 'watcher-source-retarget mode body (pswr-read))) (terpri)))
(defun psws-retarget (_sym _new op _where)
  (when (eq op 'set)
    (remove-variable-watcher 'psws-base 'psws-retarget)
    (defvaralias 'psws-alias 'psws-third)
    (garbage-collect)))
(dolist (setter '(set set-default))
  (makunbound 'psws-alias)
  (set 'psws-base 11) (set 'psws-third 22)
  (defvaralias 'psws-alias 'psws-base)
  (add-variable-watcher 'psws-base 'psws-retarget)
  (prin1 (list 'watcher-write-retarget setter (funcall setter 'psws-alias 77)
               psws-alias psws-base psws-third)) (terpri))
(defun psws-detach (_sym _new op _where)
  (when (eq op 'set)
    (remove-variable-watcher 'psws-base 'psws-detach)
    (makunbound 'psws-alias)
    (garbage-collect)))
(dolist (setter '(set set-default))
  (makunbound 'psws-alias)
  (set 'psws-base 11)
  (defvaralias 'psws-alias 'psws-base)
  (add-variable-watcher 'psws-base 'psws-detach)
  (prin1 (list 'watcher-write-detach setter (funcall setter 'psws-alias 77)
               psws-alias psws-base)) (terpri))
(princ "SHADOW-GUARD-COMPLETE 24\n")
(kill-emacs 0)
