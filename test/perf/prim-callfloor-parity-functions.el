;;; prim-callfloor-parity-functions.el --- Calling convention corpus -*- lexical-binding: t; -*-

(defvar pcf-dynamic 7)
(defvar pcf-cleanup nil)
(defun pcf-optional (a &optional b c) (list a b c))
(defun pcf-rest (a &rest r) (cons a r))
(defun pcf-both (a &optional b &rest r) (list a b r))
(defun pcf-read-dynamic () pcf-dynamic)
(defun pcf-throw () (throw 'pcf-tag (pcf-read-dynamic)))
(defun pcf-closure (x) (lambda (y) (+ x y)))
(defun pcf-arguments ()
  (list (pcf-optional 1) (pcf-optional 1 2) (pcf-optional 1 2 3)
        (pcf-rest 1) (pcf-rest 1 2 3) (pcf-both 1)
        (pcf-both 1 2 3 4) (funcall #'pcf-optional 1 2)
        (apply #'pcf-both 1 '(2 3 4)) (apply #'pcf-rest '(1 2 3))))
(defun pcf-control ()
  (list (funcall (pcf-closure 11) 5)
        (let ((pcf-dynamic 19)) (pcf-read-dynamic))
        pcf-dynamic
        (catch 'pcf-tag
          (let ((pcf-dynamic 23))
            (unwind-protect (pcf-throw)
              (setq pcf-cleanup (pcf-read-dynamic)))))
        pcf-cleanup pcf-dynamic))
(defun pcf-few () (condition-case e (pcf-optional) (error e)))
(defun pcf-many () (condition-case e (pcf-optional 1 2 3 4) (error e)))
(defun pcf-builtin-few () (condition-case e (car) (error e)))
(defun pcf-builtin-many () (condition-case e (car 1 2) (error e)))
(defun pcf-apply-bad () (condition-case e (apply #'car 1) (error e)))
(defun pcf-literals ()
  (let ((reader (lambda () [1 "literal"]))
        (events nil))
    (let ((object (funcall reader)))
      (garbage-collect)
      (list ((lambda ())) ((lambda () nil t 17 "last"))
            (eq object (funcall reader))
            (let ((captured 23)) (funcall (lambda () captured)))
            (funcall (lambda () (push 'executed events) 31)) events
            (let ((empty (lambda () nil)))
              (condition-case e (funcall empty 1)
                (wrong-number-of-arguments (list (car e) (nth 2 e)))))))))

