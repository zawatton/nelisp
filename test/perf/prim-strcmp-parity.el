;;; prim-strcmp-parity.el --- GNU string comparison oracle -*- lexical-binding: t -*-

(defvar pc-count 0)
(defun pc-observe (form)
  (setq pc-count (1+ pc-count))
  (princ (format "%d %S\n" pc-count
                 (condition-case error-data (list 'value (eval form t))
                   (error (list 'condition error-data))))))
(dolist (op '(string-lessp string< string> string-greaterp string= string-equal))
  (dolist (pair '(("" "") ("" "a") ("a" "") ("ab" "abc") ("abc" "ab")
                  ("abc" "abc") ("abc" "abd") ("abd" "abc")
                  ("é" "λ") ("あい" "あう") ("A" "a")
                  (alpha beta) (nil nil) (t nil) ("nil" nil)
                  (7 7) ("a" 7) (7 "a") (nil 7)))
    (pc-observe (list op (list 'quote (car pair)) (list 'quote (cadr pair))))))
(dolist (a (list "" "ab" "abc" "ABC" "é" "É" "あ"
                 (unibyte-string 128) (unibyte-string 233)
                 (string-as-multibyte (unibyte-string 233))
                 (string-to-multibyte (unibyte-string 233))))
  (dolist (b (list "" "abc" "abcd" "ABC" "é" "É" "あ"
                   (unibyte-string 128) (unibyte-string 233)
                   (string-as-multibyte (unibyte-string 233))
                   (string-to-multibyte (unibyte-string 233))))
    (dolist (op '(string-lessp string< string> string-greaterp string= string-equal))
      (pc-observe (list op a b)))
    (dolist (ignore '(nil t))
      (pc-observe (list 'compare-strings a nil nil b nil nil ignore))
      (pc-observe (list 'string-prefix-p a b ignore)))))
(dolist (range '((nil nil) (0 nil) (0 0) (1 2) (-1 nil) (-3 -1)
                 (0 99) (99 99) (-4 nil) (2 1) (nil -4)
                 (1.0 nil) (nil 1.0) (bad nil) (nil bad)))
  (dolist (ignore '(nil t))
    (pc-observe (list 'compare-strings "abc" (list 'quote (car range))
                      (list 'quote (cadr range)) "ABC" nil nil ignore))
    (pc-observe (list 'compare-strings "abc" nil nil "ABC"
                      (list 'quote (car range)) (list 'quote (cadr range)) ignore))))
(dolist (form '((compare-strings 'abc nil nil "abc" nil nil)
                (compare-strings "abc" nil nil 'abc nil nil)
                (compare-strings 7 'bad nil 8 nil nil)
                (compare-strings "abc" 99 nil "abc" 'bad nil)
                (string-prefix-p 'a "abc") (string-prefix-p "a" 'abc)
                (string-prefix-p nil "abc") (string-prefix-p "a" 7)))
  (pc-observe form))
(princ (format "PC-PARITY-COMPLETE %d\n" pc-count))
