;;; marked/live sweep path, with real header/counter mutations -*- lexical-binding: t; -*-
(defun nl_gc_sweep_free_dead (p n) (syscall-direct 60 87 0 0 0 0 0))
(defun nl_gc_sweep_link_run (p end) (syscall-direct 60 88 0 0 0 0 0))
(defun ck_main (n r)
  (let ((arena (syscall-direct 9 268435456 8192 3 50 -1 0))
        (state (syscall-direct 9 402653184 8192 3 50 -1 0))
        (i 0) (j 0) (k 0) (p 0) (sum 0))
    (ptr-write-u64 268436160 0 268439040)
    (ptr-write-u64 268439040 0 268439552)
    (ptr-write-u64 268435664 0 0) (ptr-write-u64 268435584 0 0)
    (ptr-write-u64 (data-addr nl_boot_hole_map) 0 0)
    (ptr-write-u64 (data-addr nl_boot_hole_map) 8 0)
    (ptr-write-u64 (data-addr nl_boot_hole_map) 16 0)
    (ptr-write-u64 (data-addr nl_alloc_check) 8 0)
    (ptr-write-u64 (data-addr nl_gc_diag) 32 0)
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (ptr-write-u64 268435640 0 0) (ptr-write-u64 268435632 0 0)
        (ptr-write-u64 (data-addr nl_gc_stats) 16 0)
        (setq k 0)
        (while (< k 4)
          (setq p (+ 268439552 (* k 32)))
          (ptr-write-u64 p 0 (if (= (logand k 1) 0) 33 36))
          (ptr-write-u64 p 8 77) (setq k (+ k 1)))
        (setq sum (+ sum (nl_gc_sweep_merge_range 268439552 268439680)))
        (setq sum (+ sum (ptr-read-u64 268435640 0)))
        (setq sum (+ sum (ptr-read-u64 268435632 0)))
        (setq sum (+ sum (ptr-read-u64 (data-addr nl_gc_stats) 16)))
        (setq k 0)
        (while (< k 4)
          (setq p (+ 268439552 (* k 32)))
          (setq sum (+ sum (+ (ptr-read-u64 p 0) (ptr-read-u64 p 8))))
          (setq k (+ k 1)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) sum))
