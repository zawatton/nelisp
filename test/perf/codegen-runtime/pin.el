;;; pin.el --- reproduce pinned S5 source inputs -*- lexical-binding: t; -*-
;; CODEGEN_RUNTIME_SOURCE selects a callpath checkout; no live source is read
;; by normal measurements. Run this only when deliberately updating the pins.
(require 'json)
(let* ((here (file-name-directory (or load-file-name buffer-file-name)))
       (root (expand-file-name "../../.." here))
       (source (or (getenv "CODEGEN_RUNTIME_SOURCE")
                   (expand-file-name "../callpath-perf-20261021" root)))
       (revision (or (getenv "CODEGEN_RUNTIME_REVISION") "bf8b39924"))
       (names '(nl_root_frame nl_alloc_bytes nelisp_fnv1a_step4
                nelisp_symbol_key_equal nelisp_mirror_lookup_entry
                nelisp_eval_call_w nl_gc_sweep_merge_range nl_bytes_byte_at
                wf_bytecode_execute_frame wf_bytecode_w_fast_run))
       ;; These are exact same-unit helpers, not substitute implementations.
       (helpers '(nl_rootstack_end nl_alloc_pop_fast nl_alloc_pop_in_arena
                  nl_alloc_bytes_run nelisp_fnv1a_step))
       (units '(("scripts/nelisp-standalone-build.el"
                 nelisp-standalone--arena-source nelisp-standalone--gc-source
                 nelisp-standalone--shim-source
                 nelisp-standalone--applyfn-bytecode-helpers)
                ("lisp/nelisp-cc-rootstack.el" nelisp-cc-rootstack--source)
                ("lisp/nelisp-cc-fnv1a.el" nelisp-cc-fnv1a--source)
                ("lisp/nelisp-cc-mirror-lookup-entry.el"
                 nelisp-cc-mirror-lookup-entry--source)
                ("lisp/nelisp-cc-nlstr-direct-ops.el"
                 nelisp-cc-nlstr-direct-ops--str-bytes-ptr-source)))
       forms provenance)
  (add-to-list 'load-path (expand-file-name "lisp" source))
  (add-to-list 'load-path (expand-file-name "src" source))
  (add-to-list 'load-path (expand-file-name "scripts" source))
  (dolist (unit units)
    (let ((file (make-temp-file "codegen-runtime-pin-" nil ".el"))
          (default-directory source))
      (unwind-protect
          (progn
            (with-temp-file file
              (unless (zerop (call-process "git" nil t nil "show"
                                          (concat revision ":" (car unit))))
                (error "Cannot read pinned source %s:%s" revision (car unit)))
              (push (cons (car unit) (secure-hash 'sha256 (current-buffer))) provenance))
            (load file nil t))
        (delete-file file))
      (dolist (var (cdr unit))
        (let* ((value (symbol-value var))
               (body (if (eq (car value) 'seq) (cdr value) value)))
          (dolist (form body)
            (when (and (eq (car-safe form) 'defun)
                       (memq (cadr form) (append names helpers)))
              (push form forms)))))))
  (setq forms (nreverse forms))
  (dolist (name (append names helpers))
    (unless (assq name (mapcar (lambda (f) (cons (cadr f) f)) forms))
      (error "Missing source %s" name)))
  ;; heap-read is the build's raw memory transport intrinsic; normalization
  ;; is applied to BOTH compiler inputs, as in the pre-existing S5 study.
  (setq forms
        (car (read-from-string
              (replace-regexp-in-string
               "heap-read-u\\(8\\|16\\|32\\|64\\)" "ptr-read-u\\1"
               (prin1-to-string forms)))))
  (with-temp-file (expand-file-name "runtime.nl.el" here)
    (insert ";;; runtime.nl.el --- pinned callpath runtime bodies -*- lexical-binding: t; -*-\n")
    (insert ";; Generated by pin.el; see pins.json for source provenance.\n")
    (let ((print-level nil) (print-length nil))
      (dolist (form forms) (prin1 form (current-buffer)) (insert "\n"))))
  (with-temp-file (expand-file-name "pins.json" here)
    (insert (json-encode
             `((revision . ,(with-temp-buffer
                              (let ((default-directory source))
                                (call-process "git" nil t nil "rev-parse" revision))
                              (string-trim (buffer-string))))
               (source_files . ,provenance)
               (names . ,(vconcat names))
               (helpers . ,(vconcat helpers))
               (normalization . "heap-read-u8/u16/u32/u64 -> ptr-read-u8/u16/u32/u64")
               (gnu_mechanisms . ["bytecode.c:510-525 contiguous bc_frame stack"
                                  "bytecode.c:567-597 threaded NEXT dispatch"
                                  "bytecode.c:854-870 backedge GC/quit budget"
                                  "alloc.c:1668-1700 typed block free lists"]))))
    (insert "\n"))
  (princ (format "Pinned %d exact runtime functions\n" (length forms))))
