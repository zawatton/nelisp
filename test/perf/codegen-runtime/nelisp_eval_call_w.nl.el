;;; genuine nested evaluator entry, immediate-word path -*- lexical-binding: t; -*-
(defun ck_main (n r)
  (let ((state (syscall-direct 9 402653184 1048576 3 50 -1 0))
        (env (syscall-direct 9 536870912 65536 3 50 -1 0))
        (i 0) (j 0) (sum 0) (word 0))
    (ptr-write-u64 (data-addr nl_rootstack_top) 0 (data-addr nl_rootstack_region))
    (ptr-write-u64 (data-addr nl_thread_registry) 0 0)
    (ptr-write-u64 (data-addr nl_gc_loop_ctx) 8 0)
    (ptr-write-u64 (data-addr nl_gc_loop_ctx) 48 0)
    (ptr-write-u64 env 96 1)
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (setq word (+ (* i 4) 1))
        (setq sum (+ sum (nelisp_eval_call_w word env 0)))
        (setq sum (+ sum (ptr-read-u64 env 96)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) sum))
