;;; genuine arena validity and symbol-cell lookup path -*- lexical-binding: t; -*-
(defun nl_root_pin_slot_active (p) (syscall-direct 60 89 0 0 0 0 0))
(defun nl_rootstack_slot_active (p) (syscall-direct 60 90 0 0 0 0 0))
(defun nelisp_mirror_lookup_hashed (mirror key) (syscall-direct 60 91 0 0 0 0 0))
(defun ck_main (n r)
  (let ((metadata (syscall-direct 9 268435456 8192 3 50 -1 0))
        (arena (syscall-direct 9 536870912 65536 3 50 -1 0))
        (names (syscall-direct 9 553648128 8192 3 50 -1 0))
        (i 0) (j 0) (sum 0))
    (ptr-write-u64 268435456 0 65536)
    (ptr-write-u64 268436160 0 536871040)
    (ptr-write-u64 268436168 0 536871040)
    (ptr-write-u64 536871040 0 536870912)
    (ptr-write-u64 536871040 24 536871168)
    (ptr-write-u64 268436288 0 536870912)
    (ptr-write-u64 268436296 0 553656320)
    (ptr-write-u8 536871168 0 4)
    (ptr-write-u64 536871168 16 553652224)
    (ptr-write-u64 536871168 24 16)
    (ptr-write-u64 536871936 16 536872198)
    (ptr-write-u64 536872192 0 1024)
    (ptr-write-u64 536872192 40 536872454)
    (ptr-write-u64 536872448 0 2048)
    (ptr-write-u64 536872448 24 536872704)
    (ptr-write-u64 536872448 32 536872736)
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (ptr-write-u64 553652216 0 (+ 2 (logand i 1)))
        (setq sum (+ sum (- (nelisp_mirror_lookup_entry 536871942 536871168) 536870912)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) sum))
