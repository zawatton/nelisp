;;; allocator run/pop fixture with exact pinned helpers -*- lexical-binding: t; -*-
(defun nl_alloc_bytes_slow (size align) (syscall-direct 60 85 0 0 0 0 0))
(defun nl_gc_in_arena (p) (syscall-direct 60 86 0 0 0 0 0))
(defun ck_main (n r)
  (let ((arena (syscall-direct 9 268435456 8192 3 50 -1 0))
        (state (syscall-direct 9 402653184 8192 3 50 -1 0))
        (i 0) (j 0) (k 0) (p 0) (sum 0) (mode 0))
    (ptr-write-u64 268435456 0 8192)
    (ptr-write-u64 268436160 0 268439040)
    (ptr-write-u64 268439040 0 268435456)
    (ptr-write-u64 268439040 24 268439552)
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (setq mode (logand i 1))
        (ptr-write-u64 (data-addr nl_alloc_check) 0 0)
        (ptr-write-u64 (data-addr nl_alloc_diag) 0 0)
        (ptr-write-u64 (data-addr nl_gc_stats) 0 0)
        (ptr-write-u64 268435624 0 0) (ptr-write-u64 268435656 0 0)
        (ptr-write-u64 268435632 0 1)
        (ptr-write-u64 (data-addr nl_gc_diag) 48 268439552)
        (setq k 0)
        (while (< k 32) (ptr-write-u8 268439560 k 255) (setq k (+ k 1)))
        (if (= mode 0)
            (seq (ptr-write-u64 268435720 0 0)
                 (ptr-write-u64 (data-addr nl_freelist_small_mask) 0 0)
                 (ptr-write-u64 268439552 0 514))
          (seq (ptr-write-u64 268435720 0 268439560)
               (ptr-write-u64 (data-addr nl_freelist_small_mask) 0 8)
               (ptr-write-u64 268439552 0 42)
               (ptr-write-u64 268439560 0 0)))
        (setq p (nl_alloc_bytes 32 8))
        (setq sum (+ sum (- p 268439552)))
        (setq sum (+ sum (ptr-read-u64 268439552 0)))
        (setq sum (+ sum (ptr-read-u64 (data-addr nl_gc_stats) 0)))
        (if (= mode 0)
            (seq (setq sum (+ sum (ptr-read-u64 268439592 0)))
                 (setq sum (+ sum (- (ptr-read-u64 (data-addr nl_gc_diag) 48) 268439552))))
          (seq (setq sum (+ sum (ptr-read-u64 (data-addr nl_freelist_small_mask) 0)))
               (setq sum (+ sum (ptr-read-u64 268435720 0)))))
        (setq k 0)
        (while (< k 32) (setq sum (+ sum (ptr-read-u8 p k))) (setq k (+ k 1)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) sum))
