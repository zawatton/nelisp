;;; exact fast VM add1/goto loop; cold runtime boundaries trap -*- lexical-binding: t; -*-
(defun wf_bytecode_w_fast_entry (a b) (syscall-direct 60 84 0 0 0 0 0))
(defun wf_bytecode_w_unbound_p (a b) (syscall-direct 60 84 0 0 0 0 0))
(defun nl_word_payload (a) (syscall-direct 60 84 0 0 0 0 0))
(defun wf_bytecode_call (a b c d e) (syscall-direct 60 84 0 0 0 0 0))
(defun ck_main (n r)
  (let ((code (ck_mmap 4096)) (mem (ck_mmap 4096)) (bx (ck_mmap 4096))
        (i 0) (j 0) (s 0) (state 0))
    (ptr-write-u8 code 0 84) (ptr-write-u8 code 1 130)
    (ptr-write-u8 code 2 0) (ptr-write-u8 code 3 0)
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (ptr-write-u64 mem 0 1)
        (setq state (wf_bytecode_w_fast_run code 4 mem 2 0 0 0 1 0 bx))
        (setq s (+ s (+ state (ptr-read-u64 mem 0))))
        (setq i (+ i 1)))
      (setq j (+ j 1))) s))
