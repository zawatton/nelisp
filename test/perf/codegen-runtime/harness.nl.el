;;; harness.nl.el --- full-width result transport -*- lexical-binding: t; -*-
(defun ck_mmap (size) (syscall-direct 9 0 size 3 34 -1 0))
(defun cr_parse (buf got k)
  (let ((i 0) (field -1) (in 0) (n 0) (c 0))
    (while (< i got)
      (setq c (ptr-read-u8 buf i))
      (if (and (>= c 48) (<= c 57))
          (seq (if (= in 0) (seq (setq field (+ field 1)) (setq in 1)) 0)
               (if (= field k) (setq n (+ (* n 10) (- c 48))) 0))
        (setq in 0))
      (setq i (+ i 1))) n))
(defun cr_emit (value)
  (let ((buf (ck_mmap 4096)) (i 0) (digit 0))
    (while (< i 16)
      (setq digit (logand (shr value (* (- 15 i) 4)) 15))
      (ptr-write-u8 buf i (+ digit (if (< digit 10) 48 87)))
      (setq i (+ i 1)))
    (ptr-write-u8 buf 16 10)
    (syscall-direct 1 1 buf 17 0 0 0) 0))
(defun cr_start ()
  (let* ((buf (ck_mmap 4096)) (got (syscall-direct 0 0 buf 64 0 0 0)))
    (cr_emit (ck_main (cr_parse buf got 0) (cr_parse buf got 1)))))
