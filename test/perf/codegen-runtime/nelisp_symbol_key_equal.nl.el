;;; symbol/name equality fixture -*- lexical-binding: t; -*-
(defun ck_main (n r)
  (let ((p (ck_mmap 4096)) (data (ck_mmap 4096)) (i 0) (j 0) (s 0) (a 0) (b 0) (k 0))
    (while (< i 32) (ptr-write-u8 data i (+ 65 (logand i 15))) (setq i (+ i 1)))
    (setq i 0)
    (while (< i 8)
      (setq a (+ p (* i 32)))
      (ptr-write-u8 a 0 4) (ptr-write-u64 a 8 42)
      (ptr-write-u64 a 16 data) (ptr-write-u64 a 24 16)
      (setq i (+ i 1)))
    (ptr-write-u8 p 64 16) (ptr-write-u8 p 96 16)
    (ptr-write-u8 p 128 16) (ptr-write-u8 p 160 16) (ptr-write-u64 p 168 43)
    (ptr-write-u8 p 192 5) (ptr-write-u8 p 224 5)
    (ptr-write-u64 p 240 (+ data 16))
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (setq k (logand i 3)) (setq a (+ p (* k 64))) (setq b (+ a 32))
        (setq s (+ s (nelisp_symbol_key_equal a b)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) s))
