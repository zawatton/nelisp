;;; byte access fixture -*- lexical-binding: t; -*-
(defun ck_main (n r)
  (let ((data (ck_mmap 4096)) (i 0) (j 0) (s 0))
    (while (< i 32) (ptr-write-u8 data i (+ (* i 7) 3)) (setq i (+ i 1)))
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (setq s (+ s (nl_bytes_byte_at data (logand i 31))))
        (setq i (+ i 1)))
      (setq j (+ j 1))) s))
