;;; main-thread root-frame fast path -*- lexical-binding: t; -*-
(defun nl_root_frame_slow (env n) (syscall-direct 60 82 0 0 0 0 0))
(defun ck_main (n r)
  (let ((fixed (syscall-direct 9 402653184 8192 3 50 -1 0)) (i 0) (j 0) (s 0) (slots 0) (p 0) (k 0))
    (while (< j r)
      (setq i 0)
      (while (< i n)
        (setq slots (logand i 7))
        (ptr-write-u64 (data-addr nl_rootstack_top) 0 (data-addr nl_rootstack_region))
        (ptr-write-u64 (data-addr nl_thread_registry) 0 0)
        (setq p (nl_root_frame 0 slots))
        (setq s (+ s (- p (data-addr nl_rootstack_region))))
        (setq k 0)
        (while (< k slots)
          (setq s (+ s (ptr-read-u64 p (* k 8)))) (setq k (+ k 1)))
        (setq i (+ i 1)))
      (setq j (+ j 1))) s))
