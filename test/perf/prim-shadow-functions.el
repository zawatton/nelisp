;;; prim-shadow-functions.el --- Defvar shadow probes -*- lexical-binding: nil; -*-
;; Keep variables dynamic, including in the GNU bytecode reference.
(defvar ps-shadow)
(defun ps-shadow-init ()
  (let ((ps-shadow 7))
    (defvar ps-shadow 9)
    (list ps-shadow (boundp 'ps-shadow))))
(defun ps-shadow-nested ()
  (let ((ps-shadow 7))
    (list (let ((ps-shadow 8)) (defvar ps-shadow 9) ps-shadow) ps-shadow)))
(defun ps-shadow-gc ()
  (let ((ps-shadow 7))
    (eval '(defvar ps-shadow (progn (garbage-collect) 19)))
    ps-shadow))
(defun ps-shadow-default ()
  (let ((ps-shadow 7))
    (list (default-value 'ps-shadow) (default-boundp 'ps-shadow)
          (set-default 'ps-shadow 8) ps-shadow)))
(defun ps-shadow-inner () (let ((ps-shadow 8)) (defvar ps-shadow 29) ps-shadow))
(defun ps-shadow-mixed () (let ((ps-shadow 7)) (list (ps-shadow-inner) ps-shadow)))
(defun ps-shadow-void ()
  (let ((ps-shadow 7)) (makunbound 'ps-shadow) (defvar ps-shadow 39)
       (list (boundp 'ps-shadow)
             (condition-case e ps-shadow (error e)))))
(defun ps-shadow-bound ()
  (let ((ps-shadow 7)) (defvar ps-shadow (error "initializer must not run")) ps-shadow))
(defun ps-shadow-ignore (&rest _args) nil)
(defun ps-shadow-general-lean ()
  (add-variable-watcher 'ps-shadow #'ps-shadow-ignore)
  (let ((ps-shadow 7))
    (remove-variable-watcher 'ps-shadow #'ps-shadow-ignore)
    (list (let ((ps-shadow 8)) (eval '(defvar ps-shadow 49)) ps-shadow) ps-shadow)))
(defun ps-shadow-lean-general ()
  (let ((ps-shadow 7))
    (add-variable-watcher 'ps-shadow #'ps-shadow-ignore)
    (unwind-protect
        (list (let ((ps-shadow 8)) (eval '(defvar ps-shadow 59)) ps-shadow) ps-shadow)
      (remove-variable-watcher 'ps-shadow #'ps-shadow-ignore))))
(defvaralias 'ps-shadow-alias 'ps-shadow)
(defun ps-shadow-alias ()
  (let ((ps-shadow-alias 7)) (defvar ps-shadow-alias 69)
       (list ps-shadow-alias ps-shadow)))
(defun ps-shadow-initialize () (eval '(defvar ps-shadow 89)))
(defun ps-shadow-vm ()
  (let ((ps-shadow 7)) (ps-shadow-initialize) ps-shadow))
