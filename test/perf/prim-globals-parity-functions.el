;;; -*- lexical-binding: t -*-
(defvar pgs-global 10)
(defvar pgs-events nil)
(defconst pgs-constant 7)
(defun pgs-get () pgs-global)
(defun pgs-symbol-value () (symbol-value 'pgs-global))
(defun pgs-setq (v) (setq pgs-global v))
(defun pgs-set (v) (set 'pgs-global v))
(defun pgs-floor () (funcall (lambda () nil)))
(defun pgs-setq-nil (v) (setq nil v))
(defun pgs-setq-t (v) (setq t v))
(defun pgs-setq-keyword (v) (setq :pgs-key v))
(defun pgs-setq-constant (v) (setq pgs-constant v))
(defun pgs-set-constant (v) (set 'pgs-constant v))
(defun pgs-let (v)
  (let ((pgs-global v))
    (list (pgs-get) (pgs-symbol-value) (pgs-setq 31) (pgs-set 32) pgs-global)))
(defun pgs-lexical ()
  (let ((pgs-lexical 42))
    (list pgs-lexical (symbol-value 'pgs-lexical))))
(defun pgs-watch (symbol value operation where)
  (push (list symbol value operation (if (bufferp where) (buffer-name where) where)) pgs-events))
