;;; nelisp-typed-save-oldest-normalization-test.el --- Valid internal states -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tso--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tso--pairs (table)
  (let (pairs) (maphash (lambda (k v) (push (cons k v) pairs)) table) pairs))
(defun tso--form (name &optional old)
  (with-temp-buffer
    (insert-file-contents (expand-file-name
                          (if old "target/typed-save/oldest-normalization/valid-state-1/builder-before.el"
                            "scripts/nelisp-standalone-build.el") tso--root))
    (goto-char (point-min))
    (unless (search-forward (concat "(defun " (symbol-name name) " ") nil t) (error "Missing genuine owner %s" name))
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tso--run (frames links &optional old mutant caller classifier)
  "Execute genuine owners with trace-only tagged-object/memory primitives."
  (let ((mem (make-hash-table :test #'eql)) (objs (make-hash-table :test #'eql))
        (next 100000) (env 1000) (fp 1032) saved trace (allocs 0) payloads pending auxes
        (publications (make-hash-table)) (cleared (make-hash-table)) (pair-proof (make-hash-table)))
    (cl-labels ((box (x) (let ((p (cl-incf next 8))) (puthash p x objs) p))
                (word (x) (cond ((vectorp x) (let ((p (box (copy-sequence x)))) (push p payloads) p))
                               ((consp x) (box (cons (word (car x)) (word (cdr x))))) ((null x) 3) (t x)))
                (obj (p) (gethash p objs))
                (tag (p) (cond ((vectorp (obj p)) 8) ((consp (obj p)) 7) ((= p 3) 0)
                               ((memq p '(101 102 103)) 4) (t 2)))
                (slot (p n) (if (= p fp) (rd p (* n 8)) (aref (obj p) n)))
                (rd (p o) (let ((x (gethash (+ p o) mem 'missing)))
                            (if (eq x 'missing) (error "Invalid read %s+%s" p o) x)))
                (wr (p o v)
                  (rd p o)
                  (dolist (aux auxes)
                    (let ((address (+ p o)))
                      (when (= address (+ aux 8))
                        (should (consp (obj v)))
                        (should (= (cdr (obj v)) (rd aux 8)))
                        (puthash aux (1+ (gethash aux publications 0)) publications))
                      (when (<= (+ aux 104) address (+ aux 480))
                        (should (= v 3))
                        (should (> (gethash aux publications 0) 0))
                        (let* ((key-address (+ aux 104 (* 16 (/ (- address aux 104) 16))))
                               (epoch (gethash aux publications)))
                          (unless (equal (gethash key-address pair-proof) epoch)
                            (let* ((event (obj (car (obj (rd aux 8)))))
                                   (key (gethash key-address mem)) (value (gethash (+ key-address 8) mem))
                                   (tail (cdr event)))
                              (should (= (car event) key))
                              (unless (= key 1)
                                (should (or (= tail value)
                                            (and (= key 13) (consp (obj tail)) (= (car (obj tail)) value)))))
                              (puthash key-address epoch pair-proof))))
                        (puthash address t cleared))
                      (when (and (= address (+ aux 96)) (= v 1))
                        (dotimes (i (ash (rd aux 96) -2))
                          (should (gethash (+ aux 104 (* i 16)) cleared))
                          (should (gethash (+ aux 112 (* i 16)) cleared))
                          (should (= (rd aux (+ 104 (* i 16))) 3))
                          (should (= (rd aux (+ 112 (* i 16))) 3))))))
                  (push (list 'write (+ p o) v) trace) (puthash (+ p o) v mem) 1)
                (consw (a d) (cl-incf allocs) (push '(allocate-cons) trace) (box (cons a d)))
                (decode (p) (cond ((vectorp (obj p)) (list 'vector (append (obj p) nil)))
                                  ((consp (obj p)) (list 'lean (car (obj p)) (cdr (obj p)))) (t p))))
      (let ((backing (box (vconcat (mapcar (lambda (names) (box (vector 3 (word names)))) frames))))
            (link 0) (state 9000))
        (puthash fp backing mem) (puthash (+ fp 8) (+ 1 (* 4 (length frames))) mem)
        (dolist (spec (reverse links))
          (pcase-let* ((`(,depth ,events ,pairs) spec) (p (+ next 8)) (aux (+ p 32)))
            (setq next (+ aux 488)) (push aux auxes)
            (dotimes (i 61) (puthash (+ aux (* i 8)) 3 mem))
            (puthash (+ p 8) link mem) (puthash (+ p 16) (+ aux 8) mem) (puthash (+ p 24) depth mem)
            (puthash (+ aux 8) (word events) mem)
            (puthash (+ aux 96) (+ 1 (* 4 (min 24 (length pairs)))) mem)
            (cl-loop for pair in pairs for i from 0 do
                     (if (< i 24)
                         (progn (puthash (+ aux 104 (* i 16)) (car pair) mem)
                                (puthash (+ aux 112 (* i 16)) (word (cadr pair)) mem))
                       (push (list aux (car pair) (word (cadr pair))) pending)))
            (setq link p)))
        (puthash (+ env 176) (if links state 0) mem) (puthash (+ state 16) link mem))
      (cl-letf (((symbol-function 'heap-read-u64) #'rd) ((symbol-function 'ptr-read-u64) #'rd)
                ;; Original cases have neither a scoped view nor N4 cuts.
                ((symbol-function 'nl_n4_binding_visible) (lambda (e &rest _) (should (= e env)) 1))
                ((symbol-function 'nl_n4_cut_rebase) (lambda (e &rest _) (should (= e env)) 0))
                ((symbol-function 'ptr-write-u64) #'wr) ((symbol-function 'nl_record_slot_word) #'slot)
                ((symbol-function 'nelisp_frame_slot_raw_word) #'slot)
                ((symbol-function 'nl_vector_slot_word) #'slot) ((symbol-function 'vector-len) (lambda (p) (length (obj p))))
                ((symbol-function 'nl_cons_car_word) (lambda (p) (car (obj p))))
                ((symbol-function 'nl_cons_cdr_word) (lambda (p) (cdr (obj p))))
                ((symbol-function 'sexp-tag) #'tag) ((symbol-function 'nl_val_tag) #'tag)
                ((symbol-function 'wf_bytecode_w_cons2) #'consw)
                ((symbol-function 'wf_bytecode_w_int) (lambda (p) (ash p -2)))
                ((symbol-function 'nelisp_symbol_key_equal) (lambda (a b) (if (= a b) 1 0)))
                ((symbol-function 'bf_dynamic_lookup) (lambda (&rest _) 0))
                ((symbol-function 'wf_bytecode_w_unbound_p) (lambda (_env w) (if (= w 99) 1 0)))
                ((symbol-function 'nelisp_mirror_is_bound) (lambda (&rest _) 1))
                ((symbol-function 'wf_dirty) (lambda () 0)) ((symbol-function 'nl_word_clone) #'identity)
                ((symbol-function 'vector-slot-set) (lambda (p n v) (aset (obj p) n v) 0))
                ((symbol-function 'cons-set-cdr) (lambda (p v) (setcdr (obj p) v) 0)))
        (unwind-protect
            (progn
              (dolist (n '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events
                           nl_ps_typed_saved nl_ps_outer_saved_select nl_ps_outer_saved bf_defvar_init_mode bf_set_defvar_value_w))
                (unless (and old (memq n '(nl_ps_typed_saved nl_ps_outer_saved_select)))
                  (push (cons n (and (fboundp n) (symbol-function n))) saved)
                  (let ((f (copy-tree (tso--form n old))))
                    (pcase mutant
                      ('kind (when (eq n 'nl_ps_typed_saved)
                               (setq f (cl-subst '(= (nl_cons_car_word event) 9)
                                                '(= (nl_cons_car_word event) 13) f :test #'equal))))
                      ('chronology (when (eq n 'nl_ps_outer_saved_select)
                                     (setq f (cl-subst '(< at-depth oldest) '(<= at-depth oldest) f :test #'equal))))
                      ('order (when (eq n 'wf_bytecode_w_aux_spill)
                                (setq f (cl-subst '(+ aux (+ 104 (* (- (- cnt 1) i) 16)))
                                                 '(+ aux (+ 104 (* i 16))) f :test #'equal)))))
                    ;; Adapt the preserved old implementation's ABI only;
                    ;; its event/order/query body remains the genuine baseline.
                    (when old
                      (when (memq n '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events))
                        (setf (nth 2 f) (cons 'env (nth 2 f))))
                      (cl-labels ((with-env (node)
                                    (if (atom node) node
                                      (if (and (memq (car node) '(wf_bytecode_w_aux_spill wf_bytecode_w_aux_unwinds wf_bytecode_w_link_events))
                                               (= (length node) 2))
                                          (list (car node) 'env (with-env (cadr node)))
                                        (mapcar #'with-env node)))))
                        (setq f (with-env f))))
                    (fset n (eval (cons 'lambda (cddr (sst--host-form f))) t)))))
              (dolist (entry pending)
                (pcase-let ((`(,aux ,key ,value) entry))
                  (wf_bytecode_w_aux_spill env aux)
                  (puthash (+ aux 104) key mem) (puthash (+ aux 112) value mem) (puthash (+ aux 96) 5 mem)))
              (let* ((initial-payloads (copy-sequence payloads))
                     (answer (if classifier (nl_ps_typed_saved (word classifier) 101) (nl_ps_outer_saved env 101)))
                     (before (decode answer)) (mode (and caller (bf_defvar_init_mode env 101 0))))
                (when caller (bf_set_defvar_value_w env 101 55 0 3))
                (list before (decode answer) (and (= (tag answer) 8) (memq answer initial-payloads) t)
                      mode allocs (nreverse trace)
                      (sort (tso--pairs mem) (lambda (a b) (< (car a) (car b))))
                      (sort (mapcar (lambda (kv) (cons (car kv) (copy-tree (cdr kv) t))) (tso--pairs objs))
                            (lambda (a b) (< (car a) (car b)))))))
          (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s)))))))))
(defconst tso--cases
  '((legacy-frame (([101 7])) nil (vector (101 7)))
    (legacy-array nil ((0 nil ((101 7)))) (lean 101 7))
    (legacy-list nil ((0 ((101 . 7)) nil)) (lean 101 7))
    (legacy-before-general (([101 11])) ((0 nil ((101 7) (1 3)))) (lean 101 7))
    (legacy-after-general (([101 7])) ((0 nil ((1 3) (101 11)))) (vector (101 7)))
    (typed-array nil ((0 nil ((13 [101 7 201])))) (vector (101 7 201)))
    (typed-list nil ((0 ((13 [101 7 201])) nil)) (vector (101 7 201)))
    (array-before-general (([101 11])) ((0 nil ((13 [101 7 201]) (1 3)))) (vector (101 7 201)))
    (array-after-general (([101 7])) ((0 nil ((1 3) (13 [101 11 201])))) (vector (101 7)))
    (list-before-general (([101 11])) ((0 ((1 3) (13 [101 7 201])) nil)) (vector (101 7 201)))
    (list-after-general (([101 7])) ((0 ((13 [101 11 201]) (1 3)) nil)) (vector (101 7)))
    (mixed-typed-old nil ((0 nil ((13 [101 7 201]) (101 11)))) (vector (101 7 201)))
    (mixed-lean-old nil ((0 ((101 . 7)) ((13 [101 11 201])))) (lean 101 7))
    (nested-tie nil ((0 nil ((13 [101 11 201]))) (0 nil ((13 [101 7 201])))) (vector (101 7 201)))))
(ert-deftest tso-valid-legacy-identity-and-typed-chronology ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/oldest-normalization/valid-state-1/builder-before.el" tso--root)))
  (dolist (c tso--cases)
    (pcase-let ((`(,id ,frames ,links ,expected) c))
      (ert-info ((format "%s" id))
        (let ((new (tso--run frames links)))
          (should (equal expected (car new)))
          (when (memq id '(legacy-frame legacy-array legacy-list legacy-before-general legacy-after-general))
            (should (equal new (tso--run frames links t)))))))))
(ert-deftest tso-twentyfour-twentyfive-and-borrowed-setter ()
  (dolist (n '(24 25))
    (let* ((pairs (append '((13 [101 7 201])) (make-list (- n 1) '(102 11))))
           (result (tso--run nil (list (list 0 nil pairs)))))
      (should (equal (car result) '(vector (101 7 201)))) (should (nth 2 result))))
  (dolist (n '(24 25))
    (let ((pairs (append '((13 [101 7 201]) (1 3)) (make-list (- n 2) '(102 11)))))
      (should (equal (car (tso--run '(([101 11])) (list (list 0 nil pairs)))) '(vector (101 7 201)))))
    (let ((pairs (append (make-list (1- n) '(102 11)) '((13 [101 7 201])))))
      (should (equal (car (tso--run nil (list (list 0 nil pairs)))) '(vector (101 7 201))))))
  (let ((result (tso--run nil '((0 nil ((13 [101 99 201])))) nil nil t)))
    (should (= (nth 3 result) 3)) (should (equal (nth 1 result) '(vector (101 55 201))))
    (should (nth 2 result))))
(ert-deftest tso-genuine-old-typed-lookup-calibration ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/oldest-normalization/valid-state-1/builder-before.el" tso--root)))
  (should (= (car (tso--run nil '((0 nil ((13 [101 7 201])))) t)) 0))
  (should (equal (car (tso--run nil '((0 nil ((13 [101 7 201])))))) '(vector (101 7 201))))
  (dolist (old '(t nil))
    (let* ((result (tso--run nil '((0 nil ((13 [101 7 201])))) old))
           (write (cl-find-if (lambda (e) (eq (car e) 'write)) (nth 5 result)))
           (objects (nth 7 result)) (node (cdr (assq (nth 2 write) objects)))
           (event (cdr (assq (car node) objects))) (tail (cdr (assq (cdr event) objects)))
           (proper (and (consp tail) (= (cdr tail) 3)
                        (vectorp (cdr (assq (car tail) objects))))))
      (should (= (car event) 13)) (should (eq (not old) (and proper t))))))
(ert-deftest tso-classifier-only-adverse-shapes ()
  (dolist (event '((9 [101 7 201]) (13 [101 7]) (13 [101 7 201 9]) (13 . 99)
                   (13 [101 7 201] . 99) (13) (13 [102 7 201])))
    (should (= (car (tso--run nil nil nil nil nil event)) 0))))
(ert-deftest tso-executed-kind-chronology-order-mutants ()
  (dolist (spec '((kind nil ((0 nil ((13 [101 7 201])))))
                  (chronology (([101 11])) ((0 nil ((13 [101 7 201]) (1 3)))))
                  (order nil ((0 nil ((13 [101 7 201]) (101 11)))))))
    (pcase-let ((`(,mutant ,frames ,links) spec))
      (let ((expected '(vector (101 7 201))))
        (should (equal expected (car (tso--run frames links))))
        (should-error (should (equal expected (car (tso--run frames links nil mutant))))
                      :type 'ert-test-failed)))))
(provide 'nelisp-typed-save-oldest-normalization-test)
