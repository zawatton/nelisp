;;; nelisp-gc-cadence-test.el --- native debt-policy boundary checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(require 'nelisp-standalone-build)

(defun nelisp-gc-cadence-test--run (&optional old-policy)
  "Execute the real native policy, or OLD-POLICY as a negative control."
  (unless (and (eq system-type (quote gnu/linux))
               (string-match-p "x86_64\\|amd64" system-configuration))
    (ert-skip "Requires x86_64 Linux for the native GC probe"))
  (let* ((stats #x32000000) (pins #x32001000)
         (forms (mapcar (lambda (name)
                          (copy-tree (cl-find name (cdr nelisp-standalone--gc-source)
                                              :key #'cadr)))
                        '(nl_gc_debt_pct nl_gc_debt_floor nl_gc_debt_limit_for
                          nl_gc_debt_refresh_limit nl_gc_debt_rearm_for)))
         (path (make-temp-file "nelisp-cadence-native-")))
    (setq forms (cl-subst stats '(data-addr nl_gc_stats) forms :test #'equal))
    (setq forms (cl-subst pins '(data-addr nl_gc_conserv_state) forms :test #'equal))
    (when old-policy
      (setcdr (cddr (cl-find 'nl_gc_debt_limit_for forms :key #'cadr))
              '((let* ((fl (nl_gc_debt_floor))
                       (scaled (/ (* live (nl_gc_debt_pct)) 100)))
                  (if (< scaled fl) fl scaled)))))
    (unwind-protect
        (progn
          (nelisp-aot-compile-sexp
           `(seq
             ,@forms
             (defun cadence_case (live span override floor pinned expected)
               (ptr-write-u64 ,stats 16 live)
               (ptr-write-u64 268435568 0 268436480)
               (ptr-write-u64 ,stats 56 (if (= span 0) 0 (+ 268436480 span)))
               (ptr-write-u64 ,stats 48 override)
               (ptr-write-u64 ,stats 40 floor)
               (ptr-write-u64 ,pins 32 (if (> pinned 0) 4 0))
               (ptr-write-u64 ,pins 40 (if (> pinned 0) (- pinned 8) 0))
               (ptr-write-u64 ,pins 48 (if (> pinned 0) 1 0))
               (nl_gc_debt_refresh_limit)
               (if (= (nl_gc_debt_limit_for live) expected)
                   (if (= (ptr-read-u64 ,stats 8) expected)
                       (seq (nl_gc_debt_rearm_for live)
                            (if (= (ptr-read-u64 ,stats 8) expected) 0 1)) 1) 1))
             (defun cadence_main ()
               (syscall-direct 9 ,stats 4096 3 50 -1 0)
               (syscall-direct 9 ,pins 4096 3 50 -1 0)
               (syscall-direct 9 268435456 4096 3 50 -1 0)
               (+ (+ (cadence_case 200000000 100000000 0 0 0 600000000)
                     (cadence_case 200000000 1000000000 0 0 0 900000000))
                  (+ (cadence_case 0 0 0 0 0 16777216)
                     (+ (cadence_case 200000000 0 0 0 0 600000000)
                        (+ (cadence_case 134217727 290000000 0 0 0 402653181)
                           (+ (cadence_case 134217728 290000000 0 0 0 591989888)
                              (+ (cadence_case 200000000 290000000 0 0 0 789336704)
                                 (+ (cadence_case 200000000 290000000 301 0 0 602000000)
                                    (+ (cadence_case 200000000 290000000 1 0 0 16777216)
                                       (+ (cadence_case 200000000 290000000 0 1000000000 0 1000000000)
                                          (+ (cadence_case 340000000 268000000 0 0 100000000 887336704)
                                             (cadence_case 340000000 268000000 301 0 100000000 1023400000))))))))))))
             (exit (cadence_main))) path)
          (call-process path nil nil nil))
      (when (file-exists-p path) (delete-file path)))))

(ert-deftest nelisp-gc-cadence-native-policy-boundaries ()
  (should (eql 0 (nelisp-gc-cadence-test--run))))
(ert-deftest nelisp-gc-cadence-native-policy-old-is-red ()
  (should-not (eql 0 (nelisp-gc-cadence-test--run t))))
(defun nelisp-gc-cadence-test--index (&optional broken)
  "Compare the native bitmap and every page predecessor with a host oracle."
  (unless (and (eq system-type (quote gnu/linux))
               (string-match-p "x86_64\\|amd64" system-configuration))
    (ert-skip "Requires x86_64 Linux for the native GC probe"))
  (let* ((heap #x32000000) (map #x33000000) (entry (+ map 8192))
         (sizes '(16 24 40 4088 16 64 32 8000))
         (offset 0) (objects nil) (setup nil) (checks nil)
         (forms (mapcar (lambda (name)
                         (copy-tree (cl-find name (cdr nelisp-standalone--gc-source)
                                             :key #'cadr)))
                       '(nl_gc_index_bytes nl_gc_index_fill)))
         (path (make-temp-file "nelisp-cadence-index-")))
    (dotimes (i 40)
      (let ((size (nth (% i (length sizes)) sizes)))
        (push (+ heap offset 8) objects)
        (push `(ptr-write-u64 ,(+ heap offset) 0 ,size) setup)
        (setq offset (+ offset size))))
    (setq objects (nreverse objects))
    (let* ((bytes (* 8 (/ (+ (/ (+ offset 63) 64) 7) 8)))
           (words (make-vector (/ bytes 8) 0)))
      (dolist (obj objects)
        (let* ((bit (/ (- obj heap) 8)) (word (/ bit 64)))
          (aset words word (logior (aref words word) (ash 1 (% bit 64))))))
      (dotimes (i (length words))
        (push `(= (ptr-read-u64 ,map ,(* i 8)) ,(aref words i)) checks))
      (dotimes (i (/ (+ offset 4095) 4096))
        (let ((previous 0))
          (dolist (obj objects) (when (< obj (+ heap (* i 4096))) (setq previous obj)))
          (push `(= (ptr-read-u64 ,(+ map bytes) ,(* i 8)) ,previous) checks))))
    (when broken
      (setq forms (cl-subst '(setq boundary (+ boundary 8192))
                           '(setq boundary (+ boundary 4096)) forms :test #'equal)))
    (unwind-protect
        (progn
          (nelisp-aot-compile-sexp
           `(seq
             (defun nl_align_up (x a) (* (/ (+ x (- a 1)) a) a))
             ,@forms
             (defun cadence_index_main ()
               (syscall-direct 9 ,heap 131072 3 50 -1 0)
               (syscall-direct 9 ,map 16384 3 50 -1 0)
               ,@(nreverse setup)
               (ptr-write-u64 ,entry 0 ,heap)
               (ptr-write-u64 ,entry 8 ,(+ heap offset))
               (ptr-write-u64 ,entry 16 ,map)
               (if (= (nl_gc_index_fill ,entry) 1)
                   (if (and ,@(nreverse checks)) 0 1) 2))
             (exit (cadence_index_main))) path)
          (call-process path nil nil nil))
      (when (file-exists-p path) (delete-file path)))))

(ert-deftest nelisp-gc-cadence-native-index-oracle ()
  (should (eql 0 (nelisp-gc-cadence-test--index))))
(ert-deftest nelisp-gc-cadence-native-index-wrong-page-is-red ()
  (should-not (eql 0 (nelisp-gc-cadence-test--index t))))


(defun nelisp-gc-cadence-test--native (source)
  "Run SOURCE as a tiny Linux executable, including real unmapping."
  (unless (and (eq system-type 'gnu/linux)
               (string-match-p "x86_64\\|amd64" system-configuration))
    (ert-skip "Requires x86_64 Linux for the native GC probe"))
  (let ((path (make-temp-file "nelisp-cadence-reclaim-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp source path)
               (call-process path nil nil nil))
      (when (file-exists-p path) (delete-file path)))))

(defun nelisp-gc-cadence-test--reclaim (&optional mutation)
  "Exercise fresh-sweep release, failed release, guards and bin repair."
  (let* ((state #x33000000) (heap #x34000000)
         (forms (mapcar
                 (lambda (name)
                   (copy-tree (cl-find name (cdr nelisp-standalone--gc-source)
                                       :key #'cadr)))
                 '(nl_gc_chunk_cursor nl_gc_chunk_end nl_gc_bt_ok
                   nl_gc_chunk_all_free_step nl_gc_chunk_all_free_from
                   nl_gc_chunk_all_free nl_gc_freelist_purge_swept_chunk
                   nl_gc_reclaim_swept_chunks))))
    (dolist (binding `((nl_gc_loop_ctx . ,state)
                       (nl_thread_parallel_ctx . ,(+ state 64))
                       (nl_mxcache_epoch . ,(+ state 96))))
      (setq forms (cl-subst (cdr binding) `(data-addr ,(car binding))
                            forms :test #'equal)))
    (pcase mutation
      ('current (setq forms (cl-subst '(= chunk 0)
                                      '(= chunk (ptr-read-u64 268436168 0))
                                      forms :test #'equal)))
      ('restore (setq forms (cl-subst '(ptr-write-u64 (+ prev 48) 0 next)
                                      '(ptr-write-u64 (+ prev 48) 0 chunk)
                                      forms :test #'equal)))
      ('mask (setq forms (cl-subst 0 '(nl_freelist_large_mask_sync bin head)
                                   forms :test #'equal))))
    (nelisp-gc-cadence-test--native
     `(seq
       (defun nl_hdr_bt (hdr) (logand (ptr-read-u64 hdr 0) 4294967288))
       (defun nl_hdr_mark (hdr) (logand (ptr-read-u64 hdr 0) 7))
       (defun nl_freelist_large_bin (_bt) 0)
       (defun nl_freelist_large_head (_bin) ,(+ state 128))
       (defun nl_freelist_large_mask_sync (_bin head)
         (ptr-write-u64 ,state 136 (if (= (ptr-read-u64 head 0) 0) 0 1)))
       (defun nl_freelist_small_mask_sync_head (bt head)
         (ptr-write-u64 ,state 184
                        (if (and (= bt 16) (= head 268435696)
                                 (= (ptr-read-u64 head 0) 0)) 1 2)))
       ;; Validate routing and unlink only the target chunk's nodes. The
       ;; existing GC suite covers the production validated chain walker.
       (defun nl_gc_freelist_purge_chain (head base size want)
         (let ((prev 0) (node (ptr-read-u64 head 0)) (next 0))
           (ptr-write-u64 ,state 144 (+ (ptr-read-u64 ,state 144) 1))
           (if (and (= size 4096)
                    (or (and (= want 0) (= head ,(+ state 128)))
                        (and (= want 16) (= head 268435696)))) 0
             (ptr-write-u64 ,state 152 1))
           (while (> node 0)
             (setq next (ptr-read-u64 node 0))
             (if (and (>= node base) (< node (+ base size)))
                 (if (= prev 0) (ptr-write-u64 head 0 next)
                   (ptr-write-u64 prev 0 next))
               (setq prev node))
             (setq node next))
           0))
       (defun nl_gc_freelist_purge_chunk (_base _size)
         (ptr-write-u64 ,state 160 (+ (ptr-read-u64 ,state 160) 1)))
       (defun nl_os_reclaim_empty_chunk (base size)
         (if (= base ,(+ heap 8192)) 1 (syscall-direct 11 base size 0 0 0 0)))
       (defun nl_alloc_diag_chunk_reclaimed (size)
         (ptr-write-u64 ,state 168 (+ (ptr-read-u64 ,state 168) size)))
       (defun nl_alloc_diag_release_failed ()
         (ptr-write-u64 ,state 176 (+ (ptr-read-u64 ,state 176) 1)))
       ,@forms
       (defun reclaim_main ()
         (syscall-direct 9 268435456 4096 3 50 -1 0)
         (syscall-direct 9 ,state 4096 3 50 -1 0)
         ;; Inhibited and parallel paths must not even read this unmapped
         ;; descriptor. A misplaced guard segfaults the native probe.
         (ptr-write-u64 ,state 24 1)
         (nl_gc_reclaim_swept_chunks 0 123456)
         (ptr-write-u64 ,state 24 0)
         (ptr-write-u64 ,(+ state 64) 16 1)
         (nl_gc_reclaim_swept_chunks 0 123456)
         (ptr-write-u64 ,(+ state 64) 16 0)
         (syscall-direct 9 ,heap 16384 3 50 -1 0)
         ,@(cl-loop for i below 4 append
                    (let ((c (+ heap (* i 4096))))
                      `((ptr-write-u64 ,c 0 ,c)
                        (ptr-write-u64 ,c 8 4096)
                        (ptr-write-u64 ,c 16 4096)
                        (ptr-write-u64 ,c 24 ,(+ c (if (= i 3) 4080 64)))
                        (ptr-write-u64 ,c 48 ,(if (= i 3) 0 (+ c 4096)))
                        (ptr-write-u64 ,(+ c (if (= i 3) 4080 64)) 0
                                       ,(if (= i 3) 18 4034)))))
         (ptr-write-u64 268436160 0 ,heap)
         (ptr-write-u64 268436168 0 ,(+ heap 12288))
         (ptr-write-u64 268435456 0 4096)
         (ptr-write-u64 268436176 0 4)
         (ptr-write-u64 268436184 0 16384)
         (ptr-write-u64 ,(+ state 128) 0 ,(+ heap 4096 72))
         (ptr-write-u64 ,(+ heap 4096 72) 0 ,(+ heap 8192 72))
         (ptr-write-u64 268435696 0 ,(+ heap 12288 4088))
         (ptr-write-u64 ,state 136 1)
         (nl_gc_reclaim_swept_chunks ,heap ,heap)
         (if (and (= (ptr-read-u64 ,(+ heap 48) 0) ,(+ heap 8192))
                  (= (ptr-read-u64 ,(+ heap 8192 48) 0) ,(+ heap 12288))
                  (= (ptr-read-u64 268436176 0) 3)
                  (= (ptr-read-u64 268436184 0) 12288)
                  (= (ptr-read-u64 268436200 0) 4096)
                  (= (ptr-read-u64 ,state 96) 2)
                  (= (ptr-read-u64 ,state 136) 0)
                  (= (ptr-read-u64 ,state 144) 2)
                  (= (ptr-read-u64 ,state 152) 0)
                  (= (ptr-read-u64 ,state 160) 0)
                  (= (ptr-read-u64 ,state 168) 4096)
                  (= (ptr-read-u64 ,state 176) 1)
                  (= (ptr-read-u64 268435696 0) ,(+ heap 12288 4088)))
             ;; A noncoalesced diagnostic chunk requires the generic purge.
             (seq (ptr-write-u64 ,(+ heap 8192 64) 0 18)
                  (nl_gc_freelist_purge_swept_chunk ,(+ heap 8192)
                                                   ,(+ heap 8192) 4096)
                  (nl_gc_freelist_purge_swept_chunk ,(+ heap 12288)
                                                   ,(+ heap 12288) 4096)
                  (if (and (= (ptr-read-u64 ,state 160) 1)
                           (= (ptr-read-u64 ,state 144) 3)
                           (= (ptr-read-u64 ,state 152) 0)
                           (= (ptr-read-u64 ,state 184) 1)) 0 2)) 1))
       (exit (reclaim_main))))))

(ert-deftest nelisp-gc-cadence-native-swept-release ()
  (should (eql 0 (nelisp-gc-cadence-test--reclaim))))
(ert-deftest nelisp-gc-cadence-native-swept-release-mutations-are-red ()
  (dolist (mutation '(current restore mask))
    (should-not (eql 0 (nelisp-gc-cadence-test--reclaim mutation)))))

(defun nelisp-gc-cadence-test--fresh (&optional broken)
  "Check both sweep completion and skipped-collection release routing."
  (let* ((state #x33000000)
         (form (copy-tree (cl-find 'nl_gc_midform_collect
                                  (cdr nelisp-standalone--gc-source) :key #'cadr))))
    (setq form (cl-subst state '(data-addr nl_gc_loop_ctx) form :test #'equal)
          form (cl-subst (+ state 128) '(data-addr nl_gc_stats) form :test #'equal))
    (when broken
      (setq form (cl-subst '(>= (ptr-read-u64 855638144 24) before)
                          '(> (ptr-read-u64 855638144 24) before)
                          form :test #'equal)))
    (nelisp-gc-cadence-test--native
     `(seq
       (defun nl_gc_debt_due () 1)
       (defun nl_gc_collect_from_recorded_roots (_mode)
         (ptr-write-u64 ,(+ state 128) 24
                        (+ (ptr-read-u64 ,(+ state 128) 24)
                           (ptr-read-u64 ,state 64))))
       (defun nl_os_empty_chunk_reclaim_p () 1)
       (defun nl_gc_reclaim_swept_chunks (_prev _cur)
         (ptr-write-u64 ,state 72 (+ (ptr-read-u64 ,state 72) 1)))
       (defun nl_gc_reclaim_empty_chunks (_prev _cur)
         (ptr-write-u64 ,state 80 (+ (ptr-read-u64 ,state 80) 1)))
       (defun nl_gc_growth_rearm () 0)
       ,form
       (defun fresh_main ()
         (syscall-direct 9 268435456 4096 3 50 -1 0)
         (syscall-direct 9 ,state 4096 3 50 -1 0)
         (ptr-write-u64 268436160 0 ,(+ state 256))
         (ptr-write-u64 ,state 8 1)
         (ptr-write-u64 ,state 64 1)
         (nl_gc_midform_collect)
         (ptr-write-u64 ,state 64 0)
         (nl_gc_midform_collect)
         (if (and (= (ptr-read-u64 ,state 72) 1)
                  (= (ptr-read-u64 ,state 80) 1)
                  (= (ptr-read-u64 ,state 32) 2)) 0 1))
       (exit (fresh_main))))))

(ert-deftest nelisp-gc-cadence-native-release-needs-completed-sweep ()
  (should (eql 0 (nelisp-gc-cadence-test--fresh))))
(ert-deftest nelisp-gc-cadence-native-skipped-sweep-mutation-is-red ()
  (should-not (eql 0 (nelisp-gc-cadence-test--fresh t))))

(provide 'nelisp-gc-cadence-test)
