;;; nelisp-hashfast-native-fixture.el --- Public GNU/native parity -*- lexical-binding: t; -*-
(defvar hf-checks 0)
(defun hf-check (name condition)
  (setq hf-checks (1+ hf-checks))
  (unless condition (error "HASHFAST FAIL %s" name))
  (princ (format "HASHFAST %s PASS\n" name)))
(defun hf-condition (form)
  (condition-case e (eval form t) (error e)))
(dolist (test '(eq eql equal))
  (let ((h (make-hash-table :test test :size 17 :weakness 'key
                            :rehash-size 'ignored :rehash-threshold nil :purecopy t)))
    (hf-check (list 'constructor test)
              (and (eq (hash-table-test h) test) (>= (hash-table-size h) 17)
                   (eq (hash-table-weakness h) 'key)))
    (setq h (make-hash-table :test test))
    (let ((keys (make-vector 4096 nil)))
    (dotimes (i 4096) (aset keys i (+ 0.25 (float i))) (puthash (aref keys i) i h))
    (hf-check (list 'float-4096 test)
              (let ((ok t))
                (dotimes (i 4096) (unless (eq (gethash (aref keys i) h) i) (setq ok nil))) ok)))))
(hf-check 'nil-args (and (eq (hash-table-test (make-hash-table :test nil :size nil)) 'eql)
                        (= (hash-table-size (make-hash-table :size 0)) 0)))
(hf-check 'duplicates (eq (hash-table-test (make-hash-table :test 'eq :test 'bad :size 1 :size -1)) 'eq))
(hf-check 'weak-t (eq (hash-table-weakness (make-hash-table :weakness t)) 'key-and-value))
(dolist (pair '(((make-hash-table :test 17) wrong-type-argument symbolp 17)
                ((make-hash-table :test 'unknown) error "Invalid hash table test" unknown)
                ((make-hash-table :size -1) error "Invalid hash table size" -1)
                ((make-hash-table :weakness 'bad) error "Invalid hash table weakness" bad)
                ((make-hash-table :size) error "Odd number of arguments")
                ((make-hash-table :bad 1 :worse 2) error "Invalid keyword argument" :worse)
                ((make-hash-table :weakness '(key value)) error "Invalid hash table weakness" key value)
                ((make-hash-table :size '(1 2)) error "Invalid hash table size" 1 2)
                ((make-hash-table '(odd key) 1) error "Invalid keyword argument" odd key)
                ((make-hash-table :test '(a b)) wrong-type-argument symbolp (a b))))
  (hf-check (list 'error (car pair)) (equal (hf-condition (car pair)) (cdr pair))))
(define-hash-table-test 'hf-custom #'equal #'sxhash-equal)
(let ((h (make-hash-table :test 'hf-custom :size 1)))
  (puthash (list 1 2) 3 h)
  (hf-check 'custom (= (gethash (list 1 2) h) 3)))
(let ((h (make-hash-table :size 2)) (sum 0))
  (puthash nil 10 h) (puthash 'a 20 h)
  (hf-check 'maphash-return
            (null (maphash (lambda (k v) (setq sum (+ sum v))
                            (puthash k (1+ v) h) (remhash k h)) h)))
  (hf-check 'maphash-remove (and (= sum 30) (= (hash-table-count h) 0))))
(let ((h (make-hash-table :size 1)) (calls 0))
  (puthash 'first 1 h)
  (maphash (lambda (_ _) (setq calls (1+ calls))
             (when (= calls 1) (dotimes (i 32) (puthash i i h)))) h)
  (hf-check 'maphash-grow (and (> calls 0) (= (hash-table-count h) 33))))
(let ((h (make-hash-table)) (seen 0))
  (dotimes (i 4) (puthash (list i) (list i) h))
  (maphash (lambda (k v) (garbage-collect)
             (hf-check 'maphash-gc-value (equal k v)) (setq seen (1+ seen))) h)
  (hf-check 'maphash-gc (= seen 4)))
(dolist (seq (list (list 1 2 3) (vector 1 2 3) "あéx" (bool-vector t nil t)))
  (let ((seen nil))
    (hf-check 'mapc-return (eq (mapc (lambda (x) (push x seen)) seq) seq))
    (hf-check 'mapc-elements (equal (nreverse seen) (append seq nil)))))
(let ((seq (list (list 1) (list 2) (list 3))) (seen nil))
  (mapc (lambda (x) (garbage-collect) (push (car x) seen)) seq)
  (hf-check 'mapc-gc (equal (nreverse seen) '(1 2 3))))
(let ((seq (list 1 2 3)) (seen nil))
  (mapc (lambda (x) (push x seen) (setcdr seq nil)) seq)
  (hf-check 'mapc-shortened (equal seen '(1))))
(hf-check 'mapc-empty (and (null (mapc 'hf-undefined nil))
                          (equal (mapc 'hf-undefined []) [])))
(hf-check 'mapc-dotted (equal (hf-condition '(mapc 'hf-undefined '(1 . 2)))
                             '(wrong-type-argument listp 2)))
(let ((seq (list 1)))
  (setcdr seq seq)
  (hf-check 'mapc-circular (eq (car (condition-case e (mapc #'ignore seq) (error e))) 'circular-list)))
(hf-check 'mapc-char-table (eq (car (hf-condition '(mapc #'ignore (make-char-table 'hf-test))))
                              'wrong-type-argument))
(when (fboundp 'nelisp--build-digest)
  ;; These entries were inserted while producing the executable's cold image,
  ;; before this fixture was loaded. Check every surviving baked key at boot.
  (let ((h nelisp-stdlib--symbol-plists) (n 0))
    (hf-check 'cold-table-populated (> (hash-table-count h) 0))
    (maphash (lambda (k v)
               (unless (equal (gethash k h 'hf-absent) v) (error "Stale cold bucket"))
               (setq n (1+ n))) h)
    (hf-check 'cold-table-all-keys (= n (hash-table-count h))))
  ;; Simulate an old in-process schema while preserving the arena epoch. Its
  ;; hashes and buckets really are stale; the first lookup must reindex now.
  (dolist (test '(eq eql equal))
    (let* ((h (make-hash-table :test test)) (keys (list 'hf-symbol "bytes" 1.25))
           (i 0))
      (dolist (k keys) (puthash k (setq i (1+ i)) h))
      (let* ((m (car h)) (index (cdr h)) (hashes (aref m 12)) (next (aref m 14)) (head -1))
        (dotimes (j (length index)) (aset index j -1))
        (dotimes (j (length hashes))
          (when (>= (aref hashes j) 0)
            (aset hashes j 0) (aset next j head) (setq head j)))
        (aset index 0 head) (aset m 5 0))
      (setq i 0)
      (dolist (k keys)
        (hf-check (list 'live-schema-migration test) (= (gethash k h) (setq i (1+ i))))) )))
(princ (format "HASHFAST DONE checked=%d\n" hf-checks))
(kill-emacs 0)
