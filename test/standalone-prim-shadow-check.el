;;; standalone-prim-shadow-check.el --- Integrated alias/binding check -*- lexical-binding: nil; -*-
(load (expand-file-name "test/perf/prim-shadow-functions.el") nil t)
(defvar psc-count 0)
(defun psc-check (name actual expected)
  (unless (equal actual expected)
    (error "prim-shadow %S: %S expected %S" name actual expected))
  (setq psc-count (1+ psc-count)))
(dolist (row '((ps-shadow-init (7 t) 9)
               (ps-shadow-nested (8 7) 9)
               (ps-shadow-gc 7 19)
               (ps-shadow-mixed (8 7) 29)
               (ps-shadow-general-lean (8 7) 49)
               (ps-shadow-lean-general (8 7) 59)))
  (makunbound 'ps-shadow)
  (psc-check (car row) (funcall (car row)) (nth 1 row))
  (psc-check 'outer ps-shadow (nth 2 row)))
(makunbound 'ps-shadow)
(psc-check 'alias (ps-shadow-alias) '(7 7))
(psc-check 'alias-outer (boundp 'ps-shadow) nil)
;; Handwritten GNU bytecode proves defvar sees the lean unwind save even
;; when the initializer explicitly collects, without any host compiler.
(defun psc-initialize () (eval '(defvar ps-shadow (progn (garbage-collect) 79))))
(makunbound 'ps-shadow)
(psc-check 'lean-bytecode
           (funcall (make-byte-code 0 (unibyte-string 194 24 193 32 136 8 41 135)
                                    [ps-shadow psc-initialize 7] 1)) 7)
(psc-check 'lean-outer ps-shadow 79)
(princ (format "PRIM-SHADOW %d PASS\n" psc-count))
(kill-emacs 0)
