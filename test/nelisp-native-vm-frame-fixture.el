          (defun bf_wrong_number_of_args (func argc) (seq (ptr-write-u64 ,out 0 4) 1))
          ;; The ordinary JIT callback: 2 is a miss, 0 a stashed signal, any other word a value.
          (defun wf_bytecode_try_jit_frame_w (func args argc env frame words)
