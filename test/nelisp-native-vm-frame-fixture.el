  (setup 0 0) (emit `(ptr-write-u64 ,base 48 3)) (check `(= ,(call 0) 0)) (word base 10 newcode) (word base 11 newconstants) (word rec 2 (imm 257))
  ;; Existing nine-argument ABI stays exact and passes frame=0.
  (setup 0 0) (check `(= (wf_bytecode_execute ,code ,constants ,code 77 ,out 999 5 6 1) 0)) (word base 8 0) (word base 9 999) (word base 12 5) (word base 13 6) (word base 14 1)
  (let* ((source `(seq ,helper ,wrapper
          (defun nl_bind_clone_force_flag () 0) (defun nl_cons_alloc () 0) (defun nl_gc_in_arena (p) 0) (defun nl_gc_is_boot (p) 0)
          (defun nl_alloc_str (a b c) (syscall-direct 60 199 0 0 0 0 0)) (defun nl_alloc_symbol (a b c) (syscall-direct 60 199 0 0 0 0 0))
          (defun wf_bytecode_dynamic_function_frame (func formals frame argc env out) 2)
