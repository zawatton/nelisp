  (dolist (row '((-1 0 3) (32768 0 3) (257 0 4) (257 2 4)))
   (setup (nth 0 row) (nth 1 row)) (check `(= ,(call (nth 1 row)) 1)) (word out 0 (nth 2 row)) (word base 1 0))
  (dolist (mode '(1 2)) (setup 257 0) (emit `(ptr-write-u64 ,base 48 ,mode)) (check `(= ,(call 0) ,(if (= mode 1) 0 1))) (word base 0 1) (word base 1 0)
