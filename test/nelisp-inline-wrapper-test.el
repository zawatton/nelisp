;;; nelisp-inline-wrapper-test.el --- No-slot initializer wrappers -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-standalone-build)
(defvar nelisp-inline-wrapper-test--enabled t)
(defun nelisp-inline-wrapper-test--apply (source &optional disabled)
  (let ((nelisp-standalone--target 'linux-x86_64)
        (nelisp-standalone--inline-wrapper-initializers-enabled
         (and nelisp-inline-wrapper-test--enabled (not disabled))))
    (nelisp-standalone--inline-unit-source source)))
(defun nelisp-inline-wrapper-test--count (x name)
  (if (consp x) (+ (if (eq (car x) name) 1 0)
                   (nelisp-inline-wrapper-test--count (car x) name)
                   (nelisp-inline-wrapper-test--count (cdr x) name)) 0))
(defun nelisp-inline-wrapper-test--body (source name)
  (nth 3 (cl-find name (cdr source) :key #'cadr :test #'eq)))
(defun nelisp-inline-wrapper-test--eval (source name args)
  (let ((defs (cl-remove-if-not (lambda (d) (eq (car-safe d) 'defun)) (cdr source))))
    (eval `(cl-labels ,(mapcar (lambda (d) (cdr d)) defs) (,name ,@args)) t)))

(ert-deftest nelisp-inline-wrapper/source-scope-hygiene-and-guards ()
  (let* ((source '(seq
     (defun wi_target (x y) (cond ((= x 0) y) (t (+ x y))))
     (defun wi_forward (x y) (wi_target x y))
     (defun wi_parallel (x) (let ((x 17) (v (wi_forward x 2))) (+ x v)))
     (defun wi_sequential (x) (let* ((x 17) (v (wi_forward x 2))) (+ x v)))
     (defun wi_mutated (x) (let ((v (wi_forward x 2))) (setq x 9) (+ x v)))
     (defun wi_global () (let ((v (wi_forward unseen_global 2))) v))
     (defun wi_effect (x) (let ((v (wi_forward (seq (setq x 3) x) 2))) v))
     (defun wi_observer (x) (seq (aot-current-sp) (let ((v (wi_forward x 2))) v)))))
         (new (let ((nelisp-standalone--target 'linux-x86_64))
                (nelisp-standalone--inline-wrapper-initializers source source)))
         (old source))
    (dolist (n '(wi_parallel wi_sequential))
      (should (= 0 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new n) 'wi_forward)))
      (should (= 1 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body old n) 'wi_forward)))
      (dolist (v '(0 1 -1 4294967295 -4294967296))
        (should (= (nelisp-inline-wrapper-test--eval old n (list v))
                   (nelisp-inline-wrapper-test--eval new n (list v))))))
    (dolist (n '(wi_mutated wi_global wi_effect wi_observer))
      (ert-info ((format "unchanged caller %s" n))
        (should (= 1 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new n) 'wi_forward))))))
  (let* ((source '(seq (defvar wi_dynamic 0)
                       (defun wi_target (x) (cond ((= x 0) 0) (t x)))
                       (defun wi_forward (x) (wi_target x))
                       (defun wi_use (wi_dynamic) (let ((v (wi_forward wi_dynamic))) v))))
         (new (let ((nelisp-standalone--target 'linux-x86_64))
                (nelisp-standalone--inline-wrapper-initializers source source))))
    (should (= 1 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new 'wi_use) 'wi_forward))))
  (let* ((source '(seq
      (defun wi_name (x) (cond ((= x 0) 0) (t x)))
      (defun wi_collect (a b c) (cond ((= a 0) b) (t c)))
      (defun wi_labels (wi_name label) (wi_collect (ptr-read-u64 (data-addr label) 0) (wi_name wi_name) label))
      (defun wi_use (x y) (let ((v (wi_labels x y))) v))))
         (new (let ((nelisp-standalone--target 'linux-x86_64))
                (nelisp-standalone--inline-wrapper-initializers source source))))
    ;; WI_NAME in function position and LABEL as a data label stay unchanged.
    (should (equal (nelisp-inline-wrapper-test--body new 'wi_use)
                   '(let ((v (wi_collect (ptr-read-u64 (data-addr label) 0) (wi_name x) y))) v)))))

(ert-deftest nelisp-inline-wrapper/actual-ABI-and-runtime-policy-gates ()
  (let* ((source '(seq (defun wi_target (x) (cond ((= x 0) 0) (t x)))
                       (defun wi_forward (x) (wi_target x))
                       (defun wi_use (x) (let ((v (wi_forward x))) v))))
         (nelisp-standalone--target 'linux-x86_64))
    (cl-labels ((unchanged ()
      (equal source (nelisp-standalone--inline-wrapper-initializers source source))))
      (let ((nelisp-aot-compiler--abi 'win64)) (should (unchanged)))
      (let ((nelisp-aot-compiler--arch 'aarch64)) (should (unchanged)))
      (let ((nelisp-aot-compiler--checked-arith t)) (should (unchanged)))
      (cl-letf (((symbol-function 'nelisp-aot-compiler--lisp-values-p) (lambda () t)))
        (should (unchanged)))
      (let ((nelisp-aot-compiler--native-emit-enabled t))
        (cl-letf (((symbol-function 'nl-jit-call-out-2) #'ignore)) (should (unchanged)))))
    ;; Stop before parsing/emission: the actual per-call ABI override must
    ;; reach the shared helper, including before the later emitter binding.
    (dolist (abi '(sysv win64))
      (let ((seen nil))
        (cl-letf (((symbol-function 'nelisp-standalone--inline-unit-source)
                   (lambda (_) (setq seen nelisp-aot-compiler--abi) (throw 'seen t))))
          (catch 'seen (nelisp-standalone--compile-to-unit "wrapper-abi-proof" source abi)))
        (should (eq abi seen))))))

(ert-deftest nelisp-inline-wrapper/closed-genuine-park-and-negative-boundaries ()
  (let ((names '(nl_thread_registry_entry nl_thread_registry_find_from nl_thread_registry_find
                nl_thread_park_safepoint_at nl_thread_park_safepoint)) (defs nil))
    (cl-labels ((find-defs (x)
                 (when (consp x)
                   (when (and (eq (car x) 'defun) (memq (cadr x) names)) (push x defs))
                   (mapc #'find-defs x))))
      (with-temp-buffer
        (insert-file-contents "lisp/nelisp-cc-rootstack.el") (goto-char (point-min))
        (let (f) (while (setq f (condition-case nil (read (current-buffer)) (end-of-file nil)))
                  (find-defs f)))))
    (should (= 5 (length defs)))
    (let* ((probe '(defun wi_park (env) (let ((v (nl_thread_park_safepoint env))) v)))
           ;; The build lowers heap reads before the unit policy runs (compile-to-unit); the
           ;; word-heap line's rootstack source uses heap-read-u64, which the closed-wrapper
           ;; proof only accepts lowered.
           (source (nelisp-heap-accessors-lower (cons 'seq (append defs (list probe)))))
           (new (nelisp-inline-wrapper-test--apply source)))
      (should (= 0 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new 'wi_park) 'nl_thread_park_safepoint)))
      (should (= 1 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new 'wi_park) 'ptr-read-u64)))
      (dolist (bad '((aot-current-sp) (addr-of env) (extern-call opaque env) (quote nil)))
        (let ((changed (mapcar (lambda (d)
                      (if (eq (cadr d) 'nl_thread_registry_find)
                          `(defun nl_thread_registry_find (env) ,bad) d)) defs)))
          (should (= 1 (nelisp-inline-wrapper-test--count
                        (nelisp-inline-wrapper-test--body
                         (nelisp-inline-wrapper-test--apply
                          (nelisp-heap-accessors-lower (cons 'seq (append changed (list probe)))))
                         'wi_park) 'nl_thread_park_safepoint)))))))
  ;; Arithmetic with a literal actual must not expose a new overflowing fold.
  (let* ((source '(seq (defun wi_target (x) (cond ((= x 0) 0) (t x)))
                       (defun wi_arith (x) (wi_target (+ x 1)))
                       (defun wi_literal () (let ((v (wi_arith 9223372036854775807))) v))))
         (new (nelisp-inline-wrapper-test--apply source)))
    (should (= 1 (nelisp-inline-wrapper-test--count (nelisp-inline-wrapper-test--body new 'wi_literal) 'wi_arith)))))

(ert-deftest nelisp-inline-wrapper/reserved-syntax-cannot-be-disguised ()
  (let ((nelisp-standalone--target 'linux-x86_64))
    (dolist (source '((seq (defun + (x y) x)
                          (defun wi_bad (x) (+ x 1))
                          (defun wi_use (x) (let ((v (wi_bad x))) v)))
                     (seq (defun extern-call (x) x)
                          (defun wi_opaque (x) (extern-call x))
                          (defun wi_bad (x) (wi_opaque x))
                          (defun wi_use (x) (let ((v (wi_bad x))) v)))))
      (let ((new (nelisp-standalone--inline-wrapper-initializers source source)))
        (should (= 1 (nelisp-inline-wrapper-test--count
                      (nelisp-inline-wrapper-test--body new 'wi_use) 'wi_bad)))))))

(ert-deftest nelisp-inline-wrapper/native-fullword-slots-effects-and-WORD ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "wrapper-init-" t))
         (c (expand-file-name "probe.c" dir)) (co (expand-file-name "probe.o" dir))
         (o (expand-file-name "target.o" dir)) (exe (expand-file-name "probe" dir))
         (source '(seq
          (defun wi_target (a b) (cond ((= a 0) b) (t (+ a b))))
          (defun wi_forward (a b) (wi_target a b))
          (defun wi_probe (a b) (let ((v (wi_forward a b))) v))
          (defun wi_effect (p v)
            (let ((x (wi_forward (seq (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) 1)) 0)
                                (seq (ptr-write-u64 p 8 (+ (ptr-read-u64 p 0) 100)) v)))) x))
          (defun wi_sp (p)
            (let ((v (wi_forward (seq (ptr-write-u64 p 0 (aot-current-sp)) 0)
                                (seq (ptr-write-u64 p 8 (aot-current-sp)) (aot-current-sp))))) v))
          (defun wi_read (p) (seq (ptr-write-u64 p 0 (+ (ptr-read-u64 p 0) 1)) (ptr-read-u64 p 8)))
          (defun wi_read_forward (p v) (wi_target (wi_read p) v))
          (defun wi_read_probe (p v) (let ((x (wi_read_forward p v))) x))
          (defun wi_word (w)
            (cond ((= (logand w 1) 1) w) ((= (logand w 7) 2) 7)
                  ((= (logand w 7) 6) (logand (ptr-read-u8 (- w 6) 0) 63))
                  (t (ptr-read-u8 w 0))))
          (defun wi_word_forward (w) (wi_word w))
          (defun wi_word_probe (w) (let ((v (wi_word_forward w))) v))))
         (values '(0 1 -1 2 6 4294967295 -4294967296 1099511627783
                     -1099511627783 9223372036854775807 -9223372036854775808))
         (mask (1- (ash 1 64))) (old-slots nil))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;extern U wi_probe(U,U),wi_effect(U*,U),wi_sp(U*),wi_word_probe(U),wi_read_probe(U*,U);\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\nU run(void){U fail=0,p[2];\n")
            (dolist (a values)
              (let* ((b (logand (+ a 1099511627789) mask)) (expected (logand (if (= a 0) b (+ a b)) mask)))
                (insert (format "fail|=wi_probe(UINT64_C(%d),UINT64_C(%d))!=UINT64_C(%d);p[0]=1;p[1]=0;fail|=wi_effect(p,UINT64_C(%d))!=UINT64_C(%d)||p[0]!=2||p[1]!=102;\n"
                                (logand a mask) b expected b b))
                (insert (format "p[0]=5;p[1]=UINT64_C(%d);fail|=wi_read_probe(p,UINT64_C(%d))!=UINT64_C(%d)||p[0]!=6;\n"
                                (logand a mask) b expected))))
            (insert "U hdr[2]={174,0},box[2]={18,0};fail|=wi_word_probe(2)!=7||wi_word_probe((U)hdr+6)!=46||wi_word_probe((U)box)!=18||wi_word_probe(UINT64_MAX)!=UINT64_MAX;\n")
            (insert "p[0]=p[1]=0;U sp=wi_sp(p);fail|=sp!=p[1]||p[0]-p[1]!=8;return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-stack-protector" "-fno-pie" "-c" c "-o" co)))
          (dolist (disabled '(t nil))
            (let* ((new (nelisp-inline-wrapper-test--apply source disabled))
                   (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
                   (defs (nelisp-aot-compiler--collect-defuns (nelisp-aot-compiler--parse new)))
                   (slots (mapcar (lambda (d) (cons (nelisp-aot-compiler--ir-get d :name)
                                                   (nelisp-aot-compiler--ir-get d :rt-slot-count))) defs)))
              (if disabled (setq old-slots slots) (should (equal old-slots slots)))
              (nelisp-aot-compile-to-object new o)
              (should (= 0 (call-process "ld" nil nil nil "-o" exe co o)))
              (should (= 0 (call-process exe nil nil nil)))
              ;; Semantic checks precede the actual optimizer negative control.
              (unless disabled
                (should (= 0 (nelisp-inline-wrapper-test--count
                              (nelisp-inline-wrapper-test--body new 'wi_probe) 'wi_forward)))
                (should (= 0 (nelisp-inline-wrapper-test--count
                              (nelisp-inline-wrapper-test--body new 'wi_word_probe) 'wi_word_forward)))))))
      (delete-directory dir t))))

(provide 'nelisp-inline-wrapper-test)
