;;; standalone-abi-callback-word-check.el -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(let ((checked 0)
      (equal-function (symbol-function 'nelisp--equal-reference))
      (gc-function (symbol-function 'nelisp--gc-statistics))
      (values (list nil t 0 -7 1.25 "callback" '(a . b) [nil t]
                    (make-symbol "callback"))))
  (unwind-protect
      (progn
        (dolist (value values)
          (fset 'nelisp--equal-reference (lambda (_a _b) (garbage-collect) value))
          (unless (eq (equal 'a 'b) value) (error "equal callback WORD changed"))
          (setq checked (+ checked 1)))
        (fset 'nelisp--equal-reference equal-function)
        (dolist (value values)
          (fset 'nelisp--gc-statistics
                (lambda (snapshot)
                  (unless (and (vectorp snapshot) (= (length snapshot) 6)
                               (integerp (aref snapshot 0)))
                    (error "GC snapshot WORD vector changed"))
                  (setq checked (+ checked 1)) value))
          (unless (eq (garbage-collect) value) (error "GC callback WORD changed"))
          (setq checked (+ checked 1)))
        (fset 'nelisp--gc-statistics gc-function)
        (fmakunbound 'nelisp--equal-reference)
        (unless (equal '(a nil 0) '(a nil 0)) (error "missing equal fallback changed"))
        (when (equal [0 nil] [t nil]) (error "unequal fallback changed"))
        (setq checked (+ checked 2))
        (fset 'nelisp--equal-reference (lambda (_a _b) (signal 'arith-error '(equal-callback))))
        (unless (eq (condition-case e (equal 0 0) (error (car e))) 'arith-error)
          (error "equal callback condition changed"))
        (setq checked (+ checked 1))
        (fset 'nelisp--equal-reference equal-function)
        (fset 'nelisp--gc-statistics (lambda (_) (signal 'arith-error '(gc-callback))))
        (unless (eq (condition-case e (garbage-collect) (error (car e))) 'arith-error)
          (error "GC callback condition changed"))
        (setq checked (+ checked 1))
        (fmakunbound 'nelisp--gc-statistics)
        (unless (eq (condition-case e (garbage-collect) (error (car e))) 'void-function)
          (error "missing GC callback condition changed"))
        (setq checked (+ checked 1))
        (dolist (case '((t void-function) (0 invalid-function) (-7 invalid-function)))
          (fset 'nelisp--equal-reference (car case))
          (unless (eq (condition-case e (equal 0 0) (error (car e))) (nth 1 case))
            (error "invalid equal callback condition changed: %S" case))
          (fset 'nelisp--gc-statistics (car case))
          (unless (eq (condition-case e (garbage-collect) (error (car e))) (nth 1 case))
            (error "invalid GC callback condition changed: %S" case))
          (setq checked (+ checked 2)))
        (fset 'nelisp--equal-reference nil)
        (unless (equal 0 0) (error "nil equal callback fallback changed"))
        (fset 'nelisp--gc-statistics nil)
        (unless (eq (condition-case e (garbage-collect) (error (car e))) 'void-function)
          (error "nil GC callback condition changed"))
        (setq checked (+ checked 2)))
    (fset 'nelisp--equal-reference equal-function)
    (fset 'nelisp--gc-statistics gc-function))
  (princ (format "ABI-CALLBACK-WORD checked=%d PASS\n" checked)))
