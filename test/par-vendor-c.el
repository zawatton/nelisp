;;; par-vendor-c.el --- GNU language library parity -*- lexical-binding: t; -*-

(defun par-vendor-c--row (name thunk)
  (let ((print-gensym t))
    (princ name)
    (princ " ")
    (prin1 (if (getenv "NELISP_VENDOR_C_DEBUG")
               (funcall thunk)
             (condition-case err (funcall thunk) (error (car err)))))
    (terpri)))

(defun par-vendor-c--owner (symbol library &optional type)
  (let ((file (symbol-file symbol (or type 'defun))))
    (and file (equal (file-name-base file) library))))

(defun par-vendor-c--expansion (form)
  "Preserve uninterned symbol names in FORM across the two printers."
  (cond
   ((consp form)
    (cons (par-vendor-c--expansion (car form))
          (par-vendor-c--expansion (cdr form))))
   ((and (symbolp form) (not (eq (intern-soft (symbol-name form)) form)))
    (list :gensym (symbol-name form)))
   (t form)))

(defun par-vendor-c--inline ()
  (require 'inline)
  (eval '(define-inline par-vendor-c--add-one (x)
           (inline-quote (+ ,x 1))) t)
  (list (par-vendor-c--owner 'define-inline "inline")
        (funcall 'par-vendor-c--add-one 4)
        (functionp (get 'par-vendor-c--add-one 'compiler-macro))))

(defun par-vendor-c--generator ()
  (require 'generator)
  (let* ((start nil)
         (iterator (eval '(iter-lambda ()
                            (setq start t)
                            (let ((received (iter-yield :ready)))
                              (iter-yield received)))
                         '((start . nil)))))
    (setq iterator (funcall iterator))
    (list (par-vendor-c--owner 'iter-next "generator")
          start (iter-next iterator) (iter-next iterator 9)
          (condition-case nil (iter-next iterator)
            (iter-end-of-sequence :end)))))

(defun par-vendor-c--rx ()
  (require 'rx)
  (list (par-vendor-c--owner 'rx "rx")
        (macroexpand '(rx bos (group (+ digit)) eos))
        (rx-to-string '(not (syntax whitespace)) t)
        (string-match-p (rx bos (+ digit) eos) "123")))

(defun par-vendor-c--custom ()
  (eval '(defcustom par-vendor-c--option 4
           "Option used by the parity row."
           :type 'integer :group 'emacs
           :set (lambda (symbol value)
                  (set-default symbol (* 2 value)))) t)
  (let ((initial par-vendor-c--option))
    (custom-set-variables '(par-vendor-c--option 5))
    (list (par-vendor-c--owner 'defcustom "custom")
          initial par-vendor-c--option
          (eval (car (get 'par-vendor-c--option 'standard-value)) t)
          (get 'par-vendor-c--option 'saved-value))))

(defun par-vendor-c--cl-seq ()
  (require 'cl-seq)
  (list (par-vendor-c--owner 'cl-position "cl-seq")
        (cl-position 2 [2 1 2] :from-end t)
        (cl-remove-if #'oddp '(1 2 3 4))
        (cl-reduce #'+ [1 2 3] :initial-value 4)))

(defun par-vendor-c--cl-extra ()
  (require 'cl-extra)
  (list (par-vendor-c--owner 'cl-every "cl-extra")
        (cl-every #'characterp "hi")
        (cl-some #'+ [1 2] '(3 4))
        (cl-getf '(:a 1 :b 2) :b)))

(defun par-vendor-c--gv ()
  (require 'gv)
  (eval '(progn
           (defalias 'par-vendor-c--place #'car)
           (gv-define-simple-setter par-vendor-c--place setcar)) t)
  (list (par-vendor-c--owner 'gv-get "gv")
        (eval '(let ((cell (list 2)) (evaluations 0))
                 (list (cl-incf (par-vendor-c--place
                                 (progn (setq evaluations (1+ evaluations))
                                        cell))
                                3)
                       (car cell) evaluations)) t)))

(defun par-vendor-c--pcase ()
  (require 'pcase)
  (list (par-vendor-c--owner 'pcase "pcase")
        (eval '(pcase '(a . 2)
                 (`(a . ,(and (pred integerp) n)) (+ n 3))
                 (_ :miss)) t)
        (eval '(pcase-let* ((`(,x ,y) '(2 3))
                            ((and z (pred integerp)) (+ x y)))
                 z) t)))

(defun par-vendor-c--cl-macs ()
  (require 'cl-macs)
  (let ((gensym-counter 0)
        (cl--gensym-counter 0))
    (list (par-vendor-c--owner 'cl-loop "cl-macs")
          (eval '(cl-loop for x across [1 2 3] collect (* x 2)) t)
          (par-vendor-c--expansion (macroexpand '(cl-incf (car pair) 2))))))

(defun par-vendor-c--cl-lib ()
  (require 'cl-lib)
  (let ((cell (cons nil (list "a"))))
    (cl-pushnew (copy-sequence "a") (cdr cell) :test #'eq)
    (list (par-vendor-c--owner 'cl-constantly "cl-lib")
          (par-vendor-c--owner 'cl-pushnew "cl-lib")
          (funcall (cl-constantly 8) :ignored)
          (cl-adjoin "a" '("a" "b") :test #'equal)
          (cdr cell))))

(defun par-vendor-c--macroexp ()
  (require 'macroexp)
  (let ((expanded (macroexpand-all
                   '(when (and t x) (let ((y (or 2 3))) (+ y 4))))))
    (list (par-vendor-c--owner 'macroexpand-all "macroexp")
          (par-vendor-c--owner 'macroexpand-1 "macroexp")
          expanded
          (macroexpand-all '(par-vendor-c--local 7)
                           '((par-vendor-c--local . (lambda (x) (list '1+ x))))))))

(defun par-vendor-c--backquote ()
  (require 'backquote)
  (list (par-vendor-c--owner (intern "`") "backquote")
        (eval '(let ((x 2) (xs '(3 4))) `(1 ,x ,@xs . 5)) t)
        (macroexpand '`(a ,x ,@xs))
        (eval '(let ((x 2)) `[1 ,x ,@'(3 4)]) t)))

(defun par-vendor-c--cl-generic ()
  (require 'cl-generic)
  (eval '(progn
           (cl-defstruct par-vendor-c--parent value)
           (cl-defstruct (par-vendor-c--child (:include par-vendor-c--parent)))
           (cl-defgeneric par-vendor-c--dispatch (thing))
           (cl-defmethod par-vendor-c--dispatch ((thing par-vendor-c--parent))
             (par-vendor-c--parent-value thing))
           (cl-defmethod par-vendor-c--dispatch ((thing par-vendor-c--child))
             (+ 10 (cl-call-next-method)))
           (cl-defmethod par-vendor-c--dispatch ((thing integer))
             (1+ thing))) t)
  (let* ((child (make-par-vendor-c--child :value 2))
         (before (par-vendor-c--dispatch child))
         (number (par-vendor-c--dispatch 4))
         (cached (par-vendor-c--dispatch child)))
    (eval '(cl-defmethod par-vendor-c--dispatch ((thing par-vendor-c--child))
             (+ 20 (cl-call-next-method))) t)
    (list (par-vendor-c--owner 'cl-defmethod "cl-generic")
          before number cached (par-vendor-c--dispatch child))))

(defun par-vendor-c--nadvice ()
  (require 'nadvice)
  (fset 'par-vendor-c--target (lambda (n) (1+ n)))
  (let ((around (lambda (original n) (* 2 (funcall original n)))))
    (advice-add 'par-vendor-c--target :around around)
    (let ((advised (par-vendor-c--target 2))
          (member (and (advice-member-p around 'par-vendor-c--target) t)))
      (advice-remove 'par-vendor-c--target around)
      (list (par-vendor-c--owner 'advice-add "nadvice")
            advised member (par-vendor-c--target 2)))))

(defun par-vendor-c--cl-preloaded ()
  (require 'cl-preloaded)
  (list (par-vendor-c--owner 'cl-struct-define "cl-preloaded")
        (cl-type-of 3)
        (cl-type-of (current-buffer))
        (cl-type-of (cl--find-class 'integer))))

(defun par-vendor-c--oclosure ()
  (require 'oclosure)
  (let ((closure (eval '(progn
                          (oclosure-define (par-vendor-c--typed-closure
                                            (:predicate par-vendor-c--typed-p)))
                          (oclosure-lambda (par-vendor-c--typed-closure) (value)
                            (1+ value))) t)))
    (list (oclosure-type closure)
          (and (par-vendor-c--typed-p closure) t)
          (and (par-vendor-c--typed-p #'identity) t)
          (funcall closure 4))))

(defun par-vendor-c--byte-run ()
  (set-advertised-calling-convention 'par-vendor-c--byte-run '(one two) "31.1")
  (list (par-vendor-c--owner 'define-obsolete-face-alias "byte-run")
        (par-vendor-c--owner 'defun-declarations-alist "byte-run" 'defvar)
        (get-advertised-calling-convention 'par-vendor-c--byte-run)
        (and (assq 'gv-setter defun-declarations-alist) t)))

(defun par-vendor-c--subr ()
  (register-definition-prefixes "par-vendor-c" '("par-vendor-c--"))
  (list (par-vendor-c--owner 'register-definition-prefixes "subr")
        (par-vendor-c--owner 'rassq-delete-all "subr")
        (par-vendor-c--owner 'macrop "subr")
        (gethash "par-vendor-c--" definition-prefixes)
        (delete-consecutive-dups (list 1 1 2 3 1) t)
        (rassq-delete-all 2 (list (cons 'a 2) (cons 'b 3)))
        (and (macrop 'pcase) t)))

(defun par-vendor-c--loaddefs ()
  (let ((customize-package-emacs-version-alist nil))
    (add-to-list 'customize-package-emacs-version-alist
                 '(par-vendor-c . "31.1"))
    (list (par-vendor-c--owner 'customize-package-emacs-version-alist
                               "loaddefs" 'defvar)
          (assq 'par-vendor-c customize-package-emacs-version-alist))))

(defun par-vendor-c--bytecomp ()
  (require 'bytecomp)
  (let ((compiled (byte-compile '(lambda (x) (1+ x)))))
    (list (par-vendor-c--owner 'byte-compile "bytecomp")
          (byte-code-function-p compiled)
          (funcall compiled 5))))

(let* ((selection (getenv "NELISP_VENDOR_C_ROW"))
       (rows (if selection (list (intern selection))
               '(inline generator rx custom cl-seq cl-extra gv pcase
                 cl-macs cl-lib macroexp backquote byte-run subr
                 cl-generic nadvice cl-preloaded oclosure loaddefs bytecomp))))
  (dolist (name rows)
    (par-vendor-c--row name (intern (format "par-vendor-c--%s" name)))))
