;;; -*- lexical-binding: t; -*-
;; Word-model fixture for the VM's small arithmetic (wf_bytecode_small_arithmetic).
;; The operand stack is MEM, an array of 8-byte words (3afb0f0cc): an immediate
;; fixnum is (n<<2)|1, nil is 3, t is 7, and any other value is a pointer to a
;; 32-byte box whose first word is its tag (a physical Int box holds a full i64
;; at offset 8).  Results are written back as words.
(require 'cl-lib) (require 'nelisp-aot-compiler) (require 'nelisp-standalone-build)
(load (expand-file-name "nelisp-aot-test-runtime.el" (file-name-directory load-file-name)) nil t t)
(defun aa-def (n p) (or (cl-find-if (lambda (f) (eq (cadr f) n)) p) (error "Missing %S" n)))
(let* ((variant (or (getenv "AA_VARIANT") "positive")) (output (getenv "AA_OUTPUT"))
       (base #x38000000) (slots (+ base 256)) (table (+ base 4096)) (boxes (+ base #x200000))
       (pools (append nelisp-standalone--applyfn-bytecode-helpers nelisp-standalone--applyfn-core-helpers))
       (original (copy-tree (aa-def 'wf_bytecode_small_arithmetic pools)))
       (helper (copy-tree original)) (wrapper (copy-tree (aa-def 'wf_bytecode_call_primitive pools))) (rows nil) (init nil) (init-functions nil) (init-calls nil) (minval -2305843009213693952) (maxval 2305843009213693951)
       (box-alist nil) (box-count 0)
       (values (list (- (expt 2 63)) (- minval 1) minval (1+ minval) -1073741825 -1073741824 -2 -1 0 1 2 1073741823 1073741824 (1- maxval) maxval (1+ maxval) (1- (expt 2 63)))))
 (cl-labels ((box-of (tag payload)
               ;; Address of a 32-byte box with TAG and PAYLOAD, shared per (tag payload).
               (or (cdr (assoc (cons tag payload) box-alist))
                   (let ((addr (+ boxes (* box-count 32))))
                     (setq box-count (1+ box-count))
                     (push (cons (cons tag payload) addr) box-alist) addr)))
             (word-of (tag value)
               ;; The operand word of a TAG value carrying integer VALUE.
               (cond ((= tag 0) 3) ((= tag 1) 7)
                     ((and (= tag 2) (<= minval value maxval)) (+ (* value 4) 1))
                     (t (box-of tag value))))
             (add (op sp at av bt bv)
   (let* ((unary (memq op '(83 84))) (arith (memq op '(83 84 85 86 87 88 89 90 92 95))) (cmp (and (>= op 85) (<= op 89)))
          (value (cond ((= op 83) (1- av)) ((= op 84) (1+ av)) ((= op 85) (if (= av bv) 1 0)) ((= op 86) (if (> av bv) 1 0)) ((= op 87) (if (< av bv) 1 0)) ((= op 88) (if (<= av bv) 1 0)) ((= op 89) (if (>= av bv) 1 0)) ((= op 90) (- av bv)) ((= op 92) (+ av bv)) (t (* av bv))))
          (ok (and arith (>= sp (if unary 1 2)) (= at 2) (or unary (= bt 2))
                   (<= minval av maxval) (or unary (<= minval bv maxval))
                   (or (/= op 95) (and (<= -1073741824 av 1073741823) (<= -1073741824 bv 1073741823)))
                   (<= minval value maxval))))
    ;; Row: opcode sp left-word right-word expected-rc expected-result-word.
    (push (list op sp (word-of at av) (word-of bt bv) (if ok 0 2)
                (if ok (if cmp (if (= value 1) 7 3) (+ (* value 4) 1)) 0))
          rows))))
  (dolist (op '(83 84)) (dolist (a values) (add op 1 2 a 2 0)))
  (dolist (op '(85 86 87 88 89 90 92 95)) (dolist (a values) (dolist (b values) (add op 2 2 a 2 b))))
  (dolist (tag '(0 1 3 4 5 7 8 9 12 13 14 16 17 18))
   (dolist (op '(83 84 85 86 87 88 89 90 92 95)) (add op (if (memq op '(83 84)) 1 2) tag 1 2 2))
   (dolist (op '(85 86 87 88 89 90 92 95)) (add op 2 2 1 tag 2)))
  (dolist (op '(83 84 85 86 87 88 89 90 92 95 72 0 999)) (add op 0 2 1 2 2))
  (dolist (op '(72 0 999)) (add op 2 2 1 2 2)))
 (pcase variant
  ((or "bad-input-range" "bad-input-wrap") (dolist (check '((< a -2305843009213693952) (> a 2305843009213693951) (< b -2305843009213693952) (> b 2305843009213693951))) (setq helper (cl-subst nil check helper :test #'equal))))
  ;; A comparison answers the opposite truth word / the wrong falsity word.
  ("bad-truth" (setq helper (cl-subst '(if truth 3 3) '(if truth 7 3) helper :test #'equal)))
  ("bad-nil" (setq helper (cl-subst '(if truth 7 7) '(if truth 7 3) helper :test #'equal)))
  ("bad-difference" (setq helper (cl-subst '(+ a b) '(- a b) helper :test #'equal)))
  ("bad-compare-boundary" (setq helper (cl-subst '(<= a b) '(< a b) helper :test #'equal)))
  ("bad-tag" (setq helper (cl-subst nil '(or (/= (wf_bytecode_w_tag l) 2) (/= (wf_bytecode_w_tag r) 2)) helper :test #'equal)))
  ;; A result store that also clobbers the operand word above DST.
  ("bad-copy" (setq helper (cl-subst '(seq (ptr-write-u64 dst 0 w) (ptr-write-u64 dst 8 123)) '(ptr-write-u64 dst 0 w) helper :test #'equal)))
  ("bad-op" (setq helper (cl-subst '(- a 1) '(+ a 1) helper :test #'equal)))
  ("bad-product-bound" (setq helper (cl-subst nil '(and (= opcode 95) (or (< a -1073741824) (> a 1073741823) (< b -1073741824) (> b 1073741823))) helper :test #'equal)))
  ("bad-result-bound" (setq helper (cl-subst nil '(if (= w -1) 2 (seq (ptr-write-u64 dst 0 w) 0)) helper :test #'equal))))
 (unless (or (equal variant "positive") (not (equal helper original))) (error "Mutant did not change production AST %s" variant))
 (setq rows (nreverse rows))
 (when (equal variant "bad-input-wrap")
  (setq rows (cl-remove-if-not (let ((big (cdr (assoc (cons 2 (1- (expt 2 63))) box-alist)))) (lambda (row) (and (= (nth 0 row) 92) (= (nth 2 row) big) (= (nth 3 row) big)))) rows)))
 (cl-loop for row in rows for i from 0 do (cl-loop for value in row for j from 0 do (push `(ptr-write-u64 ,table ,(+ (* i 48) (* j 8)) ,value) init)))
 (dolist (entry box-alist) (push `(ptr-write-u64 ,(cdr entry) 0 ,(car (car entry))) init) (push `(ptr-write-u64 ,(cdr entry) 8 ,(cdr (car entry))) init))
 (setq init (nreverse init))
 (let ((serial 0))
  (while init
   (let ((chunk nil) (n 0) (name (intern (format "aa_init_%d" serial))))
    (while (and init (< n 256)) (push (pop init) chunk) (setq n (1+ n)))
    (push `(defun ,name () (seq ,@(nreverse chunk) 0)) init-functions)
    (push `(,name) init-calls) (setq serial (1+ serial)))))
 (let ((source `(seq ,@(nreverse init-functions) ,wrapper (defun wf_bytecode_call_primitive_slow (env mem sp op) (seq (ptr-write-u64 ,base 32 (+ (ptr-read-u64 ,base 32) 1)) 77)) ,helper
   (defun nl_alloc_bytes (size align) (seq (ptr-write-u64 ,base 0 (+ (ptr-read-u64 ,base 0) 1)) ,(+ base #x100000)))
   (defun audit_run () (let ((i 0) (failure 0) (row 0) (rc 0)) (seq
    (syscall-direct 9 ,base 16777216 3 50 -1 0) ,@(nreverse init-calls)
    (while (and (= failure 0) (< i ,(length rows)))
     (setq row (+ ,table (* i 48)))
     ;; Stack words 0/1 hold the operands; words 2/3 are canaries.
     (ptr-write-u64 ,slots 0 (ptr-read-u64 row 16)) (ptr-write-u64 ,slots 8 (ptr-read-u64 row 24))
     (ptr-write-u64 ,slots 16 12345) (ptr-write-u64 ,slots 24 54321)
     (setq rc (wf_bytecode_small_arithmetic ,slots (ptr-read-u64 row 8) (ptr-read-u64 row 0)))
     (if (/= rc (ptr-read-u64 row 32)) (setq failure 1) 0)
     (if (= rc 0)
       (if (and (= (ptr-read-u64 ,slots (* 8 (- (ptr-read-u64 row 8) (if (or (= (ptr-read-u64 row 0) 83) (= (ptr-read-u64 row 0) 84)) 1 2)))) (ptr-read-u64 row 40))
                (= (ptr-read-u64 ,slots 16) 12345) (= (ptr-read-u64 ,slots 24) 54321)
                ;; The word above the result keeps its operand value.
                (= (ptr-read-u64 ,slots 8) (ptr-read-u64 row 24))) 0 (setq failure 2))
       (if (and (= (ptr-read-u64 ,slots 0) (ptr-read-u64 row 16)) (= (ptr-read-u64 ,slots 8) (ptr-read-u64 row 24)) (= (ptr-read-u64 ,slots 16) 12345) (= (ptr-read-u64 ,slots 24) 54321)) 0 (setq failure 3)))
     (if (= (ptr-read-u64 ,base 0) 0) 0 (setq failure 5))
     ;; Restore original operands and exercise the actual wrapper as well.
     (ptr-write-u64 ,slots 0 (ptr-read-u64 row 16)) (ptr-write-u64 ,slots 8 (ptr-read-u64 row 24))
     (ptr-write-u64 ,slots 16 12345) (ptr-write-u64 ,slots 24 54321)
     (ptr-write-u64 ,base 32 0)
     (setq rc (wf_bytecode_call_primitive 0 ,slots (ptr-read-u64 row 8) (ptr-read-u64 row 0)))
     (if (= (ptr-read-u64 row 32) 0)
       (if (and (= rc 0) (= (ptr-read-u64 ,base 32) 0) (= (ptr-read-u64 ,slots (* 8 (- (ptr-read-u64 row 8) (if (or (= (ptr-read-u64 row 0) 83) (= (ptr-read-u64 row 0) 84)) 1 2)))) (ptr-read-u64 row 40)) (= (ptr-read-u64 ,slots 8) (ptr-read-u64 row 24)) (= (ptr-read-u64 ,slots 16) 12345) (= (ptr-read-u64 ,slots 24) 54321)) 0 (setq failure 6))
       (if (and (= rc 77) (= (ptr-read-u64 ,base 32) 1) (= (ptr-read-u64 ,slots 0) (ptr-read-u64 row 16)) (= (ptr-read-u64 ,slots 8) (ptr-read-u64 row 24)) (= (ptr-read-u64 ,slots 16) 12345) (= (ptr-read-u64 ,slots 24) 54321)) 0 (setq failure 7)))
     (setq i (+ i 1)))
    (ptr-write-u64 ,base 8 i) (ptr-write-u64 ,base 16 failure)
    (syscall-direct 1 1 ,base 24 0 0 0) failure)))
   (defun _start () (syscall-direct 60 (audit_run) 0 0 0 0 0)))))
  (let ((inhibit-message t))
   (nelisp-aot-test-runtime-link-units output "arithmetic-audit.o" source (list (nelisp-standalone--arena-base-slot-unit)) "_start"))
  (with-temp-file (concat output ".source.el") (prin1 source (current-buffer)))
  (with-temp-file (concat output ".original.el") (prin1 original (current-buffer)))
  (with-temp-file (concat output ".cases.el") (prin1 rows (current-buffer)))
  (princ (format "COMPARE-UNIT-COMPILED variant=%s cases=%d\n" variant (length rows)))))
