;;; nelisp-typed-save-array-query-test.el --- Genuine list/array query -*- lexical-binding: t; -*-
(require 'nelisp-active-binding-query-test)
(defun tsa--before ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "target/typed-save/array-query/builder-before.el" abq--root))
    (goto-char (point-min)) (search-forward "(defun nl_sb_aux_default_bound_here ")
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defconst tsa--cases
  '((array-one (nil) ((:count 5 :pairs ((13 [101 7 201])))) 0 1)
    (zero (nil) ((:count 1 :pairs ((13 [101 7 201])))) 0 0)
    (twentyfour-oldest (nil) ((:count 97 :pairs ((13 [101 7 201])))) 0 1)
    (overflow-list (((13 [101 7 201]))) ((:count 101)) 1 1)
    (overflow (nil) ((:count 101)) 0 0)
    (negative (nil) ((:count -3)) 0 0)
    (nonfixnum (nil) ((:count 3)) 0 0)
    (wrong-buffer (nil) ((:count 5 :pairs ((13 [101 7 202])))) 0 0)
    (wrong-name (nil) ((:count 5 :pairs ((13 [102 7 201])))) 0 0)
    (short (nil) ((:count 5 :pairs ((13 [101 7])))) 0 0)
    (long (nil) ((:count 5 :pairs ((13 [101 7 201 9])))) 0 0)
    (bad-payload (nil) ((:count 5 :pairs ((13 99)))) 0 0)
    (word1 (nil) ((:count 5 :pairs ((1 [101 7 201])))) 0 0)
    (symbol-key (nil) ((:count 5 :pairs ((100006 [101 7 201])))) 0 0)
    (other-marker (nil) ((:count 5 :pairs ((17 [101 7 201])))) 0 0)
    (list-preserved (((13 [101 7 201]))) ((:count 1)) 1 1)
    (nested (nil nil) ((:count 1) (:count 5 :pairs ((13 [101 7 201])))) 0 1)))
(ert-deftest tsa-genuine-list-only-before-array-after ()
  (dolist (c tsa--cases)
    (pcase-let ((`(,id ,links ,arrays ,before ,after) c))
      (ert-info ((format "%s" id))
        (should (= before (abq--run nil nil links 101 201 nil nil arrays (tsa--before))))
        (should (= after (abq--run nil nil links 101 201 nil nil arrays)))))))
(ert-deftest tsa-newest-and-mixed ()
  (let ((pairs (append (make-list 23 '(1 3)) '((13 [101 7 201])))))
    (should (= 0 (abq--run nil nil '(nil) 101 201 nil nil (list (list :count 97 :pairs pairs)) (tsa--before))))
    (should (= 1 (abq--run nil nil '(nil) 101 201 nil nil (list (list :count 97 :pairs pairs))))))
  (should (= 1 (abq--run nil '(([999 7 201])) '(((13 [101 7 201]))) 101 201 nil nil
                             '((:count 5 :pairs ((13 [102 7 201]))))))))
(ert-deftest tsa-wrong-buffer-actual-mutant ()
  (let ((a '((:count 5 :pairs ((13 [101 7 202]))))))
    (should (= 0 (abq--run nil nil '(nil) 101 201 nil nil a)))
    (should-error (should (= 0 (abq--run nil nil '(nil) 101 201 t nil a))) :type 'ert-test-failed)))
(provide 'nelisp-typed-save-array-query-test)
