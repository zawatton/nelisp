;;; par-init-byte-conversion.el --- Raw bytes and UTF-8 spans -*- lexical-binding: t; -*-

(let* ((bytes (append (make-list 17 97) '(227 129 130 195 169)
                      (make-list 9 98) '(192 128 193 191 224 128 128)
                      (make-list 8 99) '(248 136 128 128 128 195)))
       (input (apply #'unibyte-string bytes))
       (text (string-as-multibyte input))
       (roundtrip (string-as-unibyte text)))
  (prin1 (list 'mixed-spans (multibyte-string-p text)
               (length text) (string-bytes text)
               (append (substring text 16 21) nil)
               (append (substring text 28 37) nil)
               (append (substring text -3) nil)
               (equal input roundtrip)))
  (terpri)
  (aset input 16 ?x)
  (aset text 20 ?z)
  (prin1 (list 'independent (aref text 16) (aref input 23)
               (aref roundtrip 16)))
  (terpri))

(let* ((input (apply #'unibyte-string (make-list 17 32)))
       (text (string-as-multibyte input)))
  (prin1 (list 'ascii (multibyte-string-p text) (eq input text)
               (multibyte-string-p (string-as-multibyte ""))))
  (terpri))

(let* ((input (unibyte-string 194 65 237 160 128 248 143 191 190 128))
       (text (string-as-multibyte input)))
  (prin1 (list 'sequence-boundaries (append text nil)
               (equal input (string-as-unibyte text))))
  (terpri))
