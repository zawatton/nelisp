;;; nelisp-aot-interval-leaf-test.el --- Immutable complete leaf intervals -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-interval-leaf-test--alias ()
  '(defun alias_probe (a b c)
     (let* ((x (+ b 2)) (unused (+ a 1)) (alias x) (alias2 alias) (z (+ c 3))
            (s0 (+ z 4)) (s1 (+ s0 5)) (s2 (+ s1 6)) (s3 (+ s2 7))
            (s4 (+ s3 8)) (s5 (+ s4 9)) (s6 (+ s5 10)))
       (+ alias2 s6))))
(defun nelisp-aot-interval-leaf-test--parallel ()
  '(defun parallel_probe (a b c)
     (let ((x (+ a 1)) (y (+ a 2)) (z (+ b 3)))
       (let* ((s0 (+ x y)) (s1 (+ s0 z)) (s2 (+ s1 c))
              (s3 (+ s2 4)) (s4 (+ s3 5)) (s5 (+ s4 6)) (s6 (+ s5 7)) (s7 (+ s6 8))) s7))))
(defun nelisp-aot-interval-leaf-test--word ()
  '(defun word_probe (w a b)
     (let* ((k (if (= (logand w 7) 2) 7
                 (if (= (logand w 7) 6) (logand (ptr-read-u8 w -6) 63) 0)))
            (s0 (+ k a)) (s1 (+ s0 b)) (s2 (+ s1 1)) (s3 (+ s2 2))
            (s4 (+ s3 3)) (s5 (+ s4 4)) (s6 (+ s5 5)) (s7 (+ s6 6))
            (s8 (+ s7 7)) (s9 (+ s8 8))) (+ s9 k))))
(defvar nelisp-aot-interval-leaf-test--maps nil)
(defun nelisp-aot-interval-leaf-test--record (fn ir)
  (let ((state (funcall fn ir)))
    (when (plist-get state :interval-complete)
      (push (cons (nelisp-aot-compiler--ir-get ir :name) state) nelisp-aot-interval-leaf-test--maps))
    state))
(ert-deftest nelisp-aot-interval-leaf/native-fullword-ABI-alias-parallel-WORD ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "interval-leaf-" t))
         (c (expand-file-name "caller.c" dir)) (obj (expand-file-name "caller.o" dir))
         (target (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (nelisp-aot-interval-leaf-test--maps nil)
         (cases '((3 5 7) (-3 -5 -7) (1099511627783 -17179869193 4294967295)
                  (9223372036854775807 -9223372036854775808 0)
                  (-9223372036854775808 9223372036854775807 -1)
                  (9223372036854775807 9223372036854775807 9223372036854775807)))
         (mask (1- (ash 1 64))))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef int64_t I;extern U alias_probe(I,I,I),parallel_probe(I,I,I),word_probe(I,I,I);\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (insert "U verify(U(*fn)(I,I,I),I *v,U expected){register U b __asm__(\"rbx\")=101;register U x12 __asm__(\"r12\")=103;register U x13 __asm__(\"r13\")=107;register U x14 __asm__(\"r14\")=109;register U x15 __asm__(\"r15\")=113;\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));U result=fn(v[0],v[1],v[2]);\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));return result!=expected||b!=101||x12!=103||x13!=107||x14!=109||x15!=113;}\nU run(void){U fail=0;static unsigned char vec[16] __attribute__((aligned(8)))={141};\n")
            (dolist (v cases)
              (let ((a (nth 0 v)) (b (nth 1 v)) (c (nth 2 v)))
                (insert (format "{I v[]={%s};fail|=verify(alias_probe,v,UINT64_C(%d));fail|=verify(parallel_probe,v,UINT64_C(%d));}\n"
                                (mapconcat (lambda(x)(format "(I)UINT64_C(%d)" (logand x mask))) v ",")
                                (logand (+ b c 54) mask) (logand (+ (* 2 a) b c 36) mask)))
                (dolist (wk '(("2" . 7) ("3" . 0) ("(I)((uintptr_t)vec+6)" . 13)))
                  (insert (format "{I v[]={%s,(I)UINT64_C(%d),(I)UINT64_C(%d)};fail|=verify(word_probe,v,UINT64_C(%d));}\n"
                                  (car wk) (logand a mask) (logand b mask)
                                  (logand (+ (* 2 (cdr wk)) a b 36) mask))))))
            (insert "return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--x86-leaf-entry-plan :around #'nelisp-aot-interval-leaf-test--record)
          (nelisp-aot-compile-to-object `(seq ,(nelisp-aot-interval-leaf-test--alias)
                                        ,(nelisp-aot-interval-leaf-test--parallel)
                                        ,(nelisp-aot-interval-leaf-test--word)) target)
          (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
          (should (= 0 (call-process bin nil nil nil)))
          (dolist (name '(alias_probe parallel_probe word_probe))
            (let* ((state (cdr (assq name nelisp-aot-interval-leaf-test--maps)))
                   (pairs (plist-get state :promotions)))
              (should (plist-get state :frameless))
              (should (> (length pairs) (length (delete-dups (mapcar #'cdr pairs)))))
              ;; Parameters all overlap at entry before local reuse.
              (should (= 3 (length (delete-dups (mapcar (lambda(s)(cdr (assq s pairs))) '(0 1 2))))))))
          (message "Interval leaf:30 GNU fullword C ABI cases, alias/parallel reuse, cons/vector WORD guards and callee saves"))
      (advice-remove 'nelisp-aot-compiler--x86-leaf-entry-plan #'nelisp-aot-interval-leaf-test--record)
      (delete-directory dir t))))
(defun nelisp-aot-interval-leaf-test--run (program)
  (let ((p (make-temp-file "interval-leaf-probe-")))
    (unwind-protect (progn (nelisp-aot-compile-sexp program p) (call-process p nil nil nil)) (delete-file p))))
(ert-deftest nelisp-aot-interval-leaf/delayed-alias-read-negative-control ()
  (let ((program `(seq ,(nelisp-aot-interval-leaf-test--alias) (exit (- (alias_probe 3 5 7) 66))))
        (copy (symbol-function 'nelisp-aot-compiler--x86-copy-let-source-register)))
    (should (= 0 (nelisp-aot-interval-leaf-test--run program)))
    ;; Removing only the new scoped guard exposes the stale source alias:
    ;; its source register is reused by Z before ALIAS's final read.
    (cl-letf (((symbol-function 'nelisp-aot-compiler--x86-copy-let-source-register)
               (lambda(n) (let ((nelisp-aot-compiler--x86-interval-leaf-p nil)) (funcall copy n)))))
      (should-not (= 0 (nelisp-aot-interval-leaf-test--run program))))))
(ert-deftest nelisp-aot-interval-leaf/fallback-closure-and-deduped-saves ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil) (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--x86-loop-regs '(rbx r8 r9 r12 r13 r14 r15))
         (nelisp-aot-compiler--promoted-slots nil)
         (imm (lambda(n)(nelisp-aot-compiler--make-ir 'imm :value n)))
         (ref (lambda(n)(nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp)))
         (bind (lambda(s v b)(nelisp-aot-compiler--make-ir 'let-rt :slot s :value-ir v :body b)))
         (body (funcall ref 0))
         (old (list :promotions '((0 . rbx) (1 . r8) (2 . r9) (3 . r12) (4 . r13) (5 . r14) (6 . r15)) :gain 9)))
    (dotimes (i 9) (setq body (funcall bind (+ i 1) (funcall imm (+ i 1)) body)))
    (let ((ir (nelisp-aot-compiler--make-ir 'defun :name 'closed :param-regs '(rdi) :body body)))
      (should (nelisp-aot-compiler--x86-leaf-interval-plan ir old))
      (let ((nelisp-aot-compiler--native-emit-enabled t))
        (cl-letf (((symbol-function 'nl-jit-call-out-2) #'ignore))
          (should-not (nelisp-aot-compiler--x86-leaf-interval-plan ir old))))
      (dolist (bad (list
                   (nelisp-aot-compiler--make-ir 'setq-local :slot 0 :value-ir (funcall imm 1))
                   (nelisp-aot-compiler--make-ir 'call :name 'opaque :args nil)
                   (nelisp-aot-compiler--make-ir 'sexp-tag :ptr (funcall ref 0))
                   (nelisp-aot-compiler--make-ir 'shift :op 'shl :a (funcall ref 0) :b (funcall ref 0))
                   (nelisp-aot-compiler--make-ir 'while :test (funcall imm 0) :body nil)
                   (nelisp-aot-compiler--ir-with (funcall ref 0) :root-p t)
                   (nelisp-aot-compiler--ir-with (funcall ref 0) :class 'f64)
                   ;; A binding inside a scalar operand could delay/reorder reads.
                   (nelisp-aot-compiler--make-ir 'arith :op '+ :a (funcall ref 0)
                    :b (funcall bind 20 (funcall imm 1) (funcall ref 20)))))
        (let* ((changed (nelisp-aot-compiler--make-ir 'value-seq :forms (list body bad)))
               (badir (nelisp-aot-compiler--ir-with ir :body changed)))
          (should-not (nelisp-aot-compiler--x86-leaf-interval-plan badir old))))
        (dolist (key '(:gc-root-slots :variadic :rest-p :internal-entry))
        (let ((protected (nelisp-aot-compiler--ir-with ir key t)))
          (should (equal (nelisp-aot-compiler--x86-body-entry-plan protected nil)
                         (nelisp-aot-compiler--x86-leaf-entry-plan protected)))))
    (let ((shared (funcall ref 0)))
        (should-not (nelisp-aot-compiler--x86-leaf-interval-plan
                     (nelisp-aot-compiler--ir-with ir :body
                      (nelisp-aot-compiler--make-ir 'value-seq :forms (list body shared shared))) old))))
    (let* ((buf (nelisp-asm-x86_64-make-buffer)) (pushes nil) (pops nil)
           (nelisp-aot-compiler--rsp-temp-depth 0)
           (nelisp-aot-compiler--x86-leaf-entry-state
            '(:promotions ((0 . rbx) (1 . rbx) (2 . r12) (3 . r12)) :frameless t :interval-complete t))
           (push-fn (symbol-function 'nelisp-aot-compiler--emit-temp-push))
           (pop-fn (symbol-function 'nelisp-aot-compiler--emit-temp-pop)))
      (cl-letf (((symbol-function 'nelisp-aot-compiler--emit-temp-push)
                 (lambda(b r)(push r pushes)(funcall push-fn b r)))
                ((symbol-function 'nelisp-aot-compiler--emit-temp-pop)
                 (lambda(b r)(push r pops)(funcall pop-fn b r))))
        (nelisp-aot-compiler--emit-leaf-body-x86 (funcall imm 0) buf))
      (should (equal '(rbx r12) (nreverse pushes)))
      (should (equal '(r12 rbx) (nreverse pops))))))
(ert-deftest nelisp-aot-interval-leaf/offset-forwarding-scope-guard ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--checked-arith nil) (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--x86-call-containing-defun-p t)
         (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p nil)
         (nelisp-aot-compiler--promoted-slots '((0 . rbx) (1 . r8) (2 . r9) (3 . r12)))
         (imm (lambda(n)(nelisp-aot-compiler--make-ir 'imm :value n)))
         (ref (lambda(n)(nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp)))
         (load (nelisp-aot-compiler--make-ir 'ptr-read-u8 :ptr (funcall ref 2) :offset (funcall ref 3)))
         (index (nelisp-aot-compiler--make-ir 'let-rt :slot 3
                  :value-ir (nelisp-aot-compiler--make-ir 'arith :op '+ :a (funcall ref 1) :b (funcall imm 1)) :body load))
         (chain (nelisp-aot-compiler--make-ir 'let-rt :slot 2 :value-ir (funcall ref 0) :body index)))
    (let ((nelisp-aot-compiler--x86-interval-leaf-p nil))
      (should (nelisp-aot-compiler--x86-forward-load-offset chain)))
    (let ((nelisp-aot-compiler--x86-interval-leaf-p t))
      (should-not (nelisp-aot-compiler--x86-forward-load-offset chain)))))
(provide 'nelisp-aot-interval-leaf-test)
