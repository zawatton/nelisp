;;; nelisp-directcall-hash-test.el --- Hash argv transport checks -*- lexical-binding: t; -*-

(require 'nelisp-directcall-test)

(ert-deftest ndc2-descriptors-validate-arity-and-redefinition ()
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (name "gethash"))
       (puthash 10000 20006 mem) (puthash 10008 10018 mem)
       (puthash 10016 20022 mem) (puthash 10024 3 mem)
       (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'nl_val_tag) (lambda (w) (if (memq w '(20006 20022)) 4 7)))
                 ((symbol-function 'nl_sym_sid)
                  (lambda (w) (or (nelisp-standalone--sid (if (= w 20006) "builtin" name)) 0)))
                 ((symbol-function 'sexp-name-eq) (lambda (_ s) (if (equal name s) 1 0))))
         (dolist (spec '(("gethash" 101 2 3) ("puthash" 102 3 3)
                         ("remhash" 103 2 2) ("hash-table-count" 104 1 1)))
           (setq name (car spec))
           (should (= (nl_directcall_id 10002 20022 (nth 2 spec)) (cadr spec)))
           (should (= (nl_directcall_id 10002 20022 (nth 3 spec)) (cadr spec)))
           (should (= (nl_directcall_id 10002 20022 (1- (nth 2 spec))) 0))
           (should (= (nl_directcall_id 10002 20022 (1+ (nth 3 spec))) 0))
           ;; A warm hit cannot authorize a malformed or replaced cell.
           (puthash 10024 10002 mem)
           (should (= (nl_directcall_id 10002 20022 (nth 2 spec)) 0))
           (puthash 10024 3 mem)
           (puthash 30000 17 mem)       ; w2subr: a class-6 cell is header-checked
           (should (= (nl_directcall_id 30006 20022 (nth 2 spec)) 0))))))))

(defun ndc2--with-hash (thunk)
  "Execute the production argv wrappers with instrumented native operations."
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (events nil) (custom 3) (valid 1)
           (entry 1) (value 45) (count 7))
       (puthash 100 29 mem) (puthash 108 9006 mem) (puthash 116 77 mem)
       (puthash 200 999 mem)
       (cl-letf (((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i v) (puthash (+ p i) v mem)))
                 ((symbol-function 'bf_hash_table_p_raw) (lambda (_) valid))
                 ((symbol-function 'nl_ht_custom_function_w) (lambda (_ i) (push (list 'custom i) events) custom))
                 ((symbol-function 'nl_ht_find_in) (lambda (h k) (push (list 'find h k) events) entry))
                 ((symbol-function 'nl_ht_entry_value) (lambda (h i) (push (list 'value h i) events) value))
                 ((symbol-function 'nl_ht_put_values_w)
                  (lambda (k v h _) (push (list 'put k v h) events) v))
                 ((symbol-function 'nl_ht_identity_sync) (lambda (h) (push (list 'sync h) events) 0))
                 ((symbol-function 'nl_directcall_hash_rem)
                  (lambda (k h) (push (list 'remove k h) events) 3))
                 ((symbol-function 'nl_ht_meta_count) (lambda (h) (push (list 'count h) events) count))
                 ((symbol-function 'wf_dirty) (lambda () (push 'dirty events) 0))
                 ((symbol-function 'm5_fx_primitive_run) (lambda (&rest _) -3)))
         (funcall thunk mem (lambda () events)
                  (lambda (field v) (pcase field ('custom (setq custom v)) ('valid (setq valid v))
                                          ('entry (setq entry v)) ('value (setq value v))))))))))

(ert-deftest ndc2-gethash-hit-nil-and-default ()
  (ndc2--with-hash
   (lambda (mem events set)
     (should (= (nl_directcall_run 101 100 2 200 0) 0))
     (should (= (gethash 200 mem) 45))
     (should (member '(find 9006 29) (funcall events)))
     (funcall set 'value 3)
     (should (= (nl_directcall_run 101 100 3 200 0) 0))
     (should (= (gethash 200 mem) 3))
     (funcall set 'entry 0)
     (should (= (nl_directcall_run 101 100 3 200 0) 0))
     (should (= (gethash 200 mem) 77))
     (should (= (nl_directcall_run 101 100 2 200 0) 0))
     (should (= (gethash 200 mem) 3)))))

(ert-deftest ndc2-puthash-remhash-count-use-native-words ()
  (ndc2--with-hash
   (lambda (mem events _)
     (puthash 108 45 mem) (puthash 116 9006 mem)
     (should (= (nl_directcall_run 102 100 3 200 0) 0))
     (should (= (gethash 200 mem) 45))
     (should (member '(put 29 45 9006) (funcall events)))
     (should (memq 'dirty (funcall events)))
     (puthash 108 9006 mem)
     (should (= (nl_directcall_run 103 100 2 200 0) 0))
     (should (= (gethash 200 mem) 3))
     (should (member '(remove 29 9006) (funcall events)))
     (puthash 100 9006 mem)
     (should (= (nl_directcall_run 104 100 1 200 0) 0))
     (should (= (gethash 200 mem) 29)))))

(ert-deftest ndc2-custom-and-type-decline-before-effects ()
  (ndc2--with-hash
   (lambda (mem events set)
     (funcall set 'custom 50006)
     (dolist (id '(101 102 103))
       (should (= (nl_directcall_run id 100 (if (= id 102) 3 2) 200 0) -3))
       (should (= (gethash 200 mem) 999)))
     (should (equal (reverse (funcall events)) '((custom 2) (custom 3) (custom 4))))
     (funcall set 'valid 0)
     (dolist (id '(101 102 103 104))
       (should (= (nl_directcall_run id 100 (if (= id 102) 3 2) 200 0) -3)))
     (should (= (length (funcall events)) 3)))))

(ert-deftest ndc2-remhash-lowers-the-existing-native-operation ()
  (let* ((old (ndc--find 'nl_ht_rem_synced_w nelisp-standalone--applyfn-ht-helpers))
         (new (ndc--find 'nl_directcall_hash_rem (nelisp-standalone--directcall-defuns))))
    (should old) (should new)
    (cl-labels ((lower (x)
                  (cond ((equal x '(wf_arg_word args 0)) 'key)
                        ((equal x '(wf_arg_word args 1)) 'table)
                        ((consp x) (cons (lower (car x)) (lower (cdr x)))) (t x))))
      (should (equal (cdddr new) (lower (cdddr old)))))))

(ert-deftest ndc2-no-boxes-or-argument-spines ()
  (let ((forms (nelisp-standalone--directcall-defuns)))
    (dolist (name '(nl_directcall_hash_run nl_directcall_hash_rem))
      (let ((form (ndc--find name forms)))
        (should form)
        (dolist (forbidden '(wf_arg_ptr wf_arg_word nl_word_to_view nl_word_view
                            nl_cons_construct nl_ht_get_w nl_ht_put_w nl_ht_rem_w alloc-bytes))
          (should-not (ndc--contains forbidden form)))))))

(ert-deftest ndc2-argv-and-result-slot-span-native-allocation ()
  ;; dcproto: the argv and the result slot belong to the caller's rooted frame,
  ;; so the body writes its value straight into OUT (which roots a partial
  ;; result) between the backtrace record and its finish; no root frame is taken.
  (ndc--with-definitions
   (lambda (_)
     (let ((mem (make-hash-table :test #'eql)) (live nil) (lazy nil) (finished nil))
       (cl-letf (((symbol-function 'nl_directcall_id) (lambda (&rest _) 102))
                 ((symbol-function 'heap-read-u64) (lambda (p i) (gethash (+ p i) mem 0)))
                 ((symbol-function 'ptr-write-u64) (lambda (p i v) (puthash (+ p i) v mem)))
                 ((symbol-function 'nl_root_mark) (lambda (&rest _) (ert-fail "root mark")))
                 ((symbol-function 'nl_root_frame) (lambda (&rest _) (ert-fail "root frame")))
                 ((symbol-function 'nl_n4_push_words)
                  (lambda (_ name p n) (should (= name 20022)) (setq live t lazy (list p n)) 55))
                 ((symbol-function 'nl_val_tag) (lambda (_) 4))
                 ((symbol-function 'nl_directcall_run)
                  (lambda (id p n out _)
                    (should live) (should (equal lazy '(100 3)))
                    (should (equal (list id p n out) '(102 100 3 200)))
                    (puthash out 45 mem) 0))
                 ((symbol-function 'nl_n4_finish_w)
                  (lambda (w _env _pad frame) (should live) (should (= frame 55))
                    (should (= (gethash 200 mem) 45)) (setq live nil finished t) w)))
         (should (= (nl_directcall_invoke 50002 20022 100 3 1000 200) 0))
         (should (= (gethash 200 mem) 45))
         (should finished))))))

(provide 'nelisp-directcall-hash-test)
