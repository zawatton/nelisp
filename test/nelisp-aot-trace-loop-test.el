;;; nelisp-aot-trace-loop-test.el --- Ended call-free loop traces -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-aot-trace-loop-test--plans nil)
(defvar nelisp-aot-trace-loop-test--cold-emits 0)
(defvar nelisp-aot-trace-loop-test--named-emits 0)
(defun nelisp-aot-trace-loop-test--record (_node _buf plan)
  (push (list nelisp-aot-compiler--x86-trace-loop-owner _node plan)
        nelisp-aot-trace-loop-test--plans))
(defun nelisp-aot-trace-loop-test--cold (node _buf)
  (when (eq (nelisp-aot-compiler--ir-get node :name) 'external_cold)
    (should-not nelisp-aot-compiler--promoted-slots)
    (should-not nelisp-aot-compiler--x86-trace-loop-exits)
    (cl-incf nelisp-aot-trace-loop-test--cold-emits)))
(defun nelisp-aot-trace-loop-test--named (node _buf)
  (when (eq (nelisp-aot-compiler--ir-get node :name) 'internal_cold)
    (should-not nelisp-aot-compiler--promoted-slots)
    (should-not nelisp-aot-compiler--x86-trace-loop-exits)
    (should (= 0 nelisp-aot-compiler--rsp-temp-depth))
    (cl-incf nelisp-aot-trace-loop-test--named-emits)))
(defun nelisp-aot-trace-loop-test--internal ()
  '(defun internal_cold (p x y) (extern-call external_cold p x y)))
(defun nelisp-aot-trace-loop-test--tag ()
  '(if (= (logand word 1) 1)
       (if (= (logand word 3) 1) 2 (if (= word 3) 0 1))
     (if (= (logand word 7) 2) 7
       (if (= (logand word 7) 6) (logand (ptr-read-u8 word -6) 63)
         (ptr-read-u8 word 0)))))
(defun nelisp-aot-trace-loop-test--definition ()
  (let* ((bodies `((seq (setq acc (+ acc w)) (setq i (+ i 1)))
                   (seq (setq acc (logxor acc w)) (setq i (+ i 1)))
                   (seq (setq acc (- acc w)) (setq i (+ i 1)))
                   (seq (setq acc (+ acc i)) (setq i (+ i 1)))
                   (seq (setq acc (+ acc 7)) (setq i (+ i 1)))
                   (seq (setq acc (* acc 3)) (setq i (+ i 1)))
                   (seq (setq acc (logior acc w)) (setq i (+ i 1)))
                   (seq (setq acc (logand acc w)) (setq i (+ i 1)))
                   (seq (setq word (ptr-read-u64 p 24))
                        (setq acc (+ acc ,(nelisp-aot-trace-loop-test--tag))) (setq i (+ i 1)))
                   (seq (setq acc (internal_cold p acc w)) (setq i (+ i 1)))
                   (seq (setq w (extern-call external_cold p w acc))
                        (setq acc (+ acc w)) (setq i (+ i 1)))
                   (let* ((left acc) (next (internal_cold p (+ left 3) w)))
                     (seq (setq acc (logxor left next)) (setq i (+ i 1))))))
         (dispatch '(setq go 0)))
    (cl-loop for b in (reverse bodies) for k downfrom 11
             do (setq dispatch `(if (= raw ,k) ,b ,dispatch)))
    `(defun trace_probe (data p n seed)
       (let* ((i 0) (acc seed) (raw 0) (go 1) (w seed) (word 0))
         (while (and (> go 0) (< i n))
           (ptr-write-u64 p 8 (+ (ptr-read-u64 p 8) 1))
           (setq raw (ptr-read-u8 data i))
           (setq w (ptr-read-u64 p 16))
           ,dispatch)
         acc))))
(defun nelisp-aot-trace-loop-test--back ()
  '(defun back_probe (p)
     (let* ((pc 0) (prev 1) (back 3) (go 1))
       (while (> go 0)
         (seq (ptr-write-u64 p 8 (+ (ptr-read-u64 p 8) 1))
              (if (< pc prev) (seq (setq back (- back 1)) (if (= back 0) (setq go 0) 0)) 0)
              (setq prev pc))
         (if (= go 0) 0
           (if (= pc 0) (setq pc 1)
             (if (= pc 1) (setq pc 0)
               (seq (extern-call external_cold p pc back) (setq pc 2))))))
       (+ (* pc 100) back))))
(defun nelisp-aot-trace-loop-test--wrap (x) (logand x (1- (ash 1 64))))
(defun nelisp-aot-trace-loop-test--golden (n seed tag &optional stop)
  (let ((acc (nelisp-aot-trace-loop-test--wrap seed)) (w (nelisp-aot-trace-loop-test--wrap seed))
        (calls 0) (reads 0) (history 0) (go t))
    (cl-labels ((cold (x y)
                  (cl-incf calls)
                  (setq w (logxor w 11400714819323198485)
                        history (nelisp-aot-trace-loop-test--wrap (+ (* history 13) reads)))
                  (nelisp-aot-trace-loop-test--wrap (+ (logxor x y) calls w))))
      (dotimes (i n)
        (when go
          (cl-incf reads)
          (pcase (if (and stop (= i 5)) 12 (mod i 12))
            (0 (setq acc (+ acc w))) (1 (setq acc (logxor acc w)))
            (2 (setq acc (- acc w))) (3 (setq acc (+ acc i)))
            (4 (setq acc (+ acc 7))) (5 (setq acc (* acc 3)))
            (6 (setq acc (logior acc w))) (7 (setq acc (logand acc w)))
            (8 (setq acc (+ acc tag))) (9 (setq acc (cold acc w)))
            (10 (let ((next (cold w acc))) (setq acc (+ acc next))))
            (11 (setq acc (logxor acc (cold (+ acc 3) w))))
            (_ (setq go nil)))
          (setq acc (nelisp-aot-trace-loop-test--wrap acc)))))
    (list acc calls reads w history)))

(ert-deftest nelisp-aot-trace-loop/native-fullword-cold-reentry-WORD-and-callee-saves ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "trace-loop-" t))
         (c (expand-file-name "caller.c" dir)) (co (expand-file-name "caller.o" dir))
         (obj (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (collision-loop (nth 1 (nelisp-aot-trace-loop-test--capture)))
         (collision-defs
          (cl-loop for role in '("entry" "body" "test" "done" "cold0" "cold1" "cold2")
                   append (let* ((nelisp-aot-compiler--x86-trace-unit-names nil)
                                 (name (symbol-name (nelisp-aot-compiler--x86-trace-label collision-loop role))))
                            (list `(defun ,(intern name) () 0) `(defun ,(intern (concat name "-1")) () 0)))))
         (program `(seq ,@collision-defs (defun trace-entry () 0) (defun trace-body () 0)
                       (defun trace-test () 0) (defun trace-done () 0) (defun trace-cold () 0)
                       ,(nelisp-aot-trace-loop-test--internal)
                       ,(nelisp-aot-trace-loop-test--definition) ,(nelisp-aot-trace-loop-test--back)))
         (cases '(0 1 -1 4294967295 9223372036854775807 -9223372036854775808))
         (words '(("2" . 7) ("(U)(uintptr_t)(vector+6)" . 13) ("(U)(uintptr_t)slot" . 5)
                  ("1" . 2) ("3" . 0) ("7" . 1)))
         (nelisp-aot-trace-loop-test--plans nil) (nelisp-aot-trace-loop-test--cold-emits 0)
         (nelisp-aot-trace-loop-test--named-emits 0)
         (disabled-plans nil) (enabled-plans nil) (count 0))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef int64_t I;extern U trace_probe(unsigned char*,U*,I,U),back_probe(U*);\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n.globl external_cold\\nexternal_cold:\\nmov %rsp,%rax\\nand $15,%rax\\ncmp $8,%rax\\nje 1f\\nmovq $1,40(%rdi)\\n1:jmp external_cold_impl\\n\");\n")
            (insert "U external_cold_impl(U*p,U x,U y){p[0]++;p[2]^=UINT64_C(11400714819323198485);p[4]=p[4]*13+p[1];((unsigned char*)(uintptr_t)p[6])[p[1]-1]=0;__asm__ volatile(\"mov $731,%%r8;mov $733,%%r9;mov $739,%%r10;mov $743,%%r11\"::: \"r8\",\"r9\",\"r10\",\"r11\",\"cc\");return (x^y)+p[0]+p[2];}\n")
            (insert "U verify(unsigned char*d,U*p,I n,U seed,U expected){register U b __asm__(\"rbx\")=101;register U q __asm__(\"r12\")=103;register U r __asm__(\"r13\")=107;register U s __asm__(\"r14\")=109;register U t __asm__(\"r15\")=113;__asm__ volatile(\"\":\"+r\"(b),\"+r\"(q),\"+r\"(r),\"+r\"(s),\"+r\"(t));U v=trace_probe(d,p,n,seed);__asm__ volatile(\"\":\"+r\"(b),\"+r\"(q),\"+r\"(r),\"+r\"(s),\"+r\"(t));return v!=expected||b!=101||q!=103||r!=107||s!=109||t!=113;}\n")
            (insert "U run(void){U fail=0;static unsigned char vector[16] __attribute__((aligned(8)))={141};static unsigned char slot[16] __attribute__((aligned(8)))={5};unsigned char d[36];U p[8];\n")
            (dolist (seed cases)
              (dolist (word words)
                (dolist (spec '((0) (1) (9) (12) (24) (36) (36 t)))
                  (let* ((n (car spec)) (stop (cadr spec))
                         (g (nelisp-aot-trace-loop-test--golden n seed (cdr word) stop)))
                    (insert (format "for(int k=0;k<36;k++)d[k]=k%%12;%sfor(int k=0;k<8;k++)p[k]=0;p[2]=UINT64_C(%d);p[3]=%s;p[6]=(U)(uintptr_t)d;fail|=verify(d,p,%d,UINT64_C(%d),UINT64_C(%d));fail|=p[0]!=%d||p[1]!=%d||p[2]!=UINT64_C(%d)||p[4]!=UINT64_C(%d)||p[5];\n"
                                    (if stop "d[5]=12;" "") (nelisp-aot-trace-loop-test--wrap seed)
                                    (car word) n (nelisp-aot-trace-loop-test--wrap seed) (nth 0 g)
                                    (nth 1 g) (nth 2 g) (nth 3 g) (nth 4 g)))
                  (cl-incf count)))))
            (insert "for(int k=0;k<8;k++)p[k]=0;fail|=back_probe(p)!=0||p[1]!=5||p[0];fail|=verify(0,0,0,UINT64_C(9223372036854775808),UINT64_C(9223372036854775808));return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" co)))
          (advice-add 'nelisp-aot-compiler--emit-trace-loop-x86 :before #'nelisp-aot-trace-loop-test--record)
          (advice-add 'nelisp-aot-compiler--emit-extern-call :before #'nelisp-aot-trace-loop-test--cold)
          (advice-add 'nelisp-aot-compiler--emit-call :before #'nelisp-aot-trace-loop-test--named)
          ;; The disabled control passes semantics before inspecting maps.
          (dolist (disabled '(t nil))
            (setq nelisp-aot-trace-loop-test--plans nil)
            (let ((nelisp-aot-compiler--x86-trace-loops (not disabled))
                  (nelisp-aot-compiler--object-hidden-boundary-symbols nil))
              (nelisp-aot-compile-to-object program obj))
            (with-temp-buffer
              (let ((rc (call-process "gcc-14" nil t nil "-nostdlib" "-no-pie" co obj "-o" bin)))
                (unless (= rc 0)
                  (message "Trace link failure: %s" (buffer-string)))
                (should (= 0 rc))))
            (should (= 0 (call-process bin nil nil nil)))
            (if disabled (setq disabled-plans nelisp-aot-trace-loop-test--plans)
              (setq enabled-plans nelisp-aot-trace-loop-test--plans)))
          (should-not disabled-plans)
          (should (= 2 (length enabled-plans)))
          (should (= 6 nelisp-aot-trace-loop-test--cold-emits))
          (should (= 4 nelisp-aot-trace-loop-test--named-emits))
          (dolist (r enabled-plans)
            (let ((plan (nth 2 r)))
              (dolist (p (car (plist-get plan :plan))) (should (memq (car p) (plist-get plan :scope))))))
          (message "Trace loops: %d GNU fullword/WORD/reentry cases plus2 zero-trip/backedge cases per mode; all9 hot and3 cold arms; ABI sentinels/alignment/caller clobbers" count))
      (advice-remove 'nelisp-aot-compiler--emit-trace-loop-x86 #'nelisp-aot-trace-loop-test--record)
      (advice-remove 'nelisp-aot-compiler--emit-extern-call #'nelisp-aot-trace-loop-test--cold)
      (advice-remove 'nelisp-aot-compiler--emit-call #'nelisp-aot-trace-loop-test--named)
      (delete-directory dir t))))

(defun nelisp-aot-trace-loop-test--capture ()
  (let ((nelisp-aot-trace-loop-test--plans nil)
        (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (p (make-temp-file "trace-plan-" nil ".o")))
    (unwind-protect
        (progn
          (advice-add 'nelisp-aot-compiler--emit-trace-loop-x86 :before #'nelisp-aot-trace-loop-test--record)
          (nelisp-aot-compile-to-object `(seq ,(nelisp-aot-trace-loop-test--internal)
                                            ,(nelisp-aot-trace-loop-test--definition)) p)
          (should (= 1 (length nelisp-aot-trace-loop-test--plans)))
          (should-not nelisp-aot-compiler--x86-trace-unit-names)
          (car nelisp-aot-trace-loop-test--plans))
      (advice-remove 'nelisp-aot-compiler--emit-trace-loop-x86 #'nelisp-aot-trace-loop-test--record)
      (delete-file p))))
(defun nelisp-aot-trace-loop-test--replace (v old new)
  (cond ((eq v old) new)
        ((vectorp v) (vconcat (mapcar (lambda(x)(nelisp-aot-trace-loop-test--replace x old new)) v)))
        ((consp v) (cons (nelisp-aot-trace-loop-test--replace (car v) old new)
                        (nelisp-aot-trace-loop-test--replace (cdr v) old new)))
        (t v)))
(defun nelisp-aot-trace-loop-test--replan (record loop &optional owner)
  (let ((nelisp-aot-compiler--x86-trace-loop-owner
         (or owner (nelisp-aot-trace-loop-test--replace (nth 0 record) (nth 1 record) loop)))
        (nelisp-aot-compiler--x86-loop-regs '(rbx r8 r9 r12 r13 r14 r15))
        (nelisp-aot-compiler--x86-trace-unit-names '("trace_probe"))
        (nelisp-aot-compiler--promoted-slots nil)
        (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p nil))
    (nelisp-aot-compiler--x86-trace-loop-plan loop)))

(ert-deftest nelisp-aot-trace-loop/closed-control-lifetime-and-mode-fallbacks ()
  (let* ((r (nelisp-aot-trace-loop-test--capture)) (owner (nth 0 r)) (loop (nth 1 r))
         (ref (lambda(s)(nelisp-aot-compiler--make-ir 'ref :slot s :class 'gp)))
         (imm (lambda(x)(nelisp-aot-compiler--make-ir 'imm :value x)))
         (b (nelisp-aot-compiler--ir-get loop :body)))
    (should (nelisp-aot-trace-loop-test--replan r loop))
    ;; A call before a remaining statement is not a terminal edge.
    (let ((changed (nelisp-aot-compiler--ir-with loop :body
                     (append b (list (nelisp-aot-compiler--make-ir 'setq-local :slot 4 :value-ir (funcall imm 1)))))))
      (should-not (nelisp-aot-trace-loop-test--replan r changed)))
    (let ((changed (nelisp-aot-compiler--ir-with loop :body
                     (cons (nelisp-aot-compiler--make-ir 'call :name 'prefix_barrier :args nil) b))))
      (should-not (nelisp-aot-trace-loop-test--replan r changed)))
    ;; Test reads/effects and shared operand nodes are excluded.
    (let ((changed (nelisp-aot-compiler--ir-with loop :test
                     (nelisp-aot-compiler--make-ir 'ptr-read-u64 :ptr (funcall ref 0) :offset (funcall imm 0)))))
      (should-not (nelisp-aot-trace-loop-test--replan r changed)))
    (let* ((same (funcall ref 0))
           (changed (nelisp-aot-compiler--ir-with loop :test
                      (nelisp-aot-compiler--make-ir 'cmp :op '= :a same :b same))))
      (should-not (nelisp-aot-trace-loop-test--replan r changed)))
    ;; A slot defined elsewhere in the owner is not an ancestor here.
    (let* ((changed (nelisp-aot-compiler--ir-with loop :test
                      (nelisp-aot-compiler--make-ir 'cmp :op '> :a (funcall ref 999) :b (funcall imm 0))))
           (changed-owner (nelisp-aot-trace-loop-test--replace owner loop changed))
           (body (nelisp-aot-compiler--ir-get changed-owner :body))
           (unrelated (nelisp-aot-compiler--make-ir 'let-rt :slot 999 :value-ir (funcall imm 1) :body (funcall imm 0))))
      (setq changed-owner (nelisp-aot-compiler--ir-with changed-owner :body
                            (nelisp-aot-compiler--make-ir 'value-seq :forms (list unrelated body))))
      (should-not (nelisp-aot-trace-loop-test--replan r changed changed-owner)))
    (dolist (field '((:variadic . t) (:rest-p . t) (:optional-count . 1)
                     (:gc-root-slots . (0)) (:internal-entry . t) (:internal-hidden . (0))
                     (:self-tco-raw . t) (:param-class . f64)))
      (should-not (nelisp-aot-trace-loop-test--replan
                   r loop (nelisp-aot-compiler--ir-with owner (car field) (cdr field)))))
    (let ((observed (nelisp-aot-compiler--ir-with owner :body
                      (nelisp-aot-compiler--make-ir 'value-seq :forms
                        (list (nelisp-aot-compiler--ir-get owner :body)
                              (nelisp-aot-compiler--make-ir 'aot-current-sp))))))
      (should-not (nelisp-aot-trace-loop-test--replan r loop observed)))
    (let ((nelisp-aot-compiler--checked-arith t))
      (should-not (nelisp-aot-trace-loop-test--replan r loop)))
    (let ((nelisp-aot-compiler--abi 'win64))
      (should-not (nelisp-aot-trace-loop-test--replan r loop)))
    (cl-letf (((symbol-function 'nelisp-aot-compiler--lisp-values-p) (lambda()t)))
      (should-not (nelisp-aot-trace-loop-test--replan r loop)))
    (let ((nelisp-aot-compiler--native-emit-enabled t))
      (cl-letf (((symbol-function 'nl-jit-call-out-2) #'ignore))
        (should-not (nelisp-aot-trace-loop-test--replan r loop))))))

(ert-deftest nelisp-aot-trace-loop/ended-edges-do-not-forward-delayed-slot-reads ()
  (let* ((r (nelisp-aot-trace-loop-test--capture)) (trace (nth 2 r))
         (loop (nth 1 r)) (owner (nth 0 r)))
    (should (= 3 (length (plist-get trace :cold))))
    (should (= (length (plist-get trace :cold))
               (length (delete-dups (copy-sequence (plist-get trace :cold))))))
    (let* ((nelisp-aot-compiler--promoted-slots '((0 . r12) (1 . r13)))
           (nelisp-aot-compiler--x86-trace-loop-exits '((unused . edge)))
           (alias (nelisp-aot-compiler--make-ir 'let-rt :slot 1
                    :value-ir (nelisp-aot-compiler--make-ir 'ref :slot 0 :class 'gp)
                    :body (nelisp-aot-compiler--make-ir 'ref :slot 1 :class 'gp))))
      (should-not (nelisp-aot-compiler--x86-copy-let-source-register alias)))
    ;; The complete scope proof includes outer slots, not branch locals.
    (let ((scope (plist-get trace :scope)))
      (should (= (length scope) 10))
      (dolist (p (car (plist-get trace :plan))) (should (memq (car p) scope))))
    (should (nelisp-aot-trace-loop-test--replan r loop owner))))
