;;; nelisp-parity9-standalone.el --- GNU object/error differential -*- lexical-binding: t; -*-

(defmacro p9-case (form)
  `(princ (format "%S => %S\n" ',form
                  (condition-case e ,form (error (cons 'ERR e))))))

(p9-case (eq [] []))
(p9-case (eql (vector) (vector)))
(p9-case (eql (make-vector 0 0) (make-vector 0 1)))
(p9-case (eq [] (vector)))
(p9-case (eq [] (make-vector 0 (list 1))))
(p9-case (eq (read "[]") (read "[]")))
(p9-case (eq (apply #'vector nil) []))
(p9-case (eq (copy-sequence []) []))
(p9-case (eq (vconcat nil) []))
(p9-case (eq (make-vector 1 0) (make-vector 1 0)))
(p9-case (condition-case e (aset [] 0 0) (error e)))
(p9-case (let ((v (vector))) (garbage-collect) (eq v (make-vector 0 nil))))
(p9-case (let ((h (make-hash-table :test 'eq :weakness 'key)))
           (puthash (vector) 'live h) (garbage-collect)
           (gethash [] h)))

(defvar p9-bvec (make-byte-code 0 (unibyte-string 192 32 135) [vector] 1))
(defvar p9-bmake (make-byte-code 0 (unibyte-string 192 193 194 34 135) [make-vector 0 nil] 3))
(p9-case (eq (funcall p9-bvec) []))
(p9-case (eq (funcall p9-bmake) []))
(p9-case (equal (record 'p9-type 1) (record 'p9-type 1)))
(p9-case (equal (record 'p9-type) (record 'p9-type)))
(p9-case (equal (record 'p9-type 1) (record 'p9-other 1)))
(p9-case (equal (record 'p9-type 1) (record 'p9-type 2)))
(p9-case (equal (record 'p9-type 1) (record 'p9-type 1 2)))
(p9-case (equal (record 'p9-type 1) [p9-type 1]))
(p9-case (let ((r (record 'p9-type nil))) (aset r 1 r) (equal r r)))
(p9-case (equal (record 'p9-type (record 'p9-inner '(1 2)) [3 "a"])
                (record 'p9-type (record 'p9-inner '(1 2)) [3 "a"])))
(defvar p9-bequal
  (make-byte-code 0 (unibyte-string 192 193 154 135)
                  (vector (record 'p9-type '(1 2) [3]) (record 'p9-type '(1 2) [3])) 2))
(p9-case (funcall p9-bequal))
(p9-case (let ((h (make-hash-table :test 'equal)))
           (puthash (record 'p9-type '(1 2)) 'found h)
           (gethash (record 'p9-type '(1 2)) h)))
(p9-case (aset '(1 2) 0 0))
(p9-case (aset 5 0 0))
(p9-case (aset nil 0 0))
(p9-case (aset t 0 0))
(p9-case (aset 'p9-symbol 0 0))
(p9-case (aref '(1 2) 0))
(p9-case (aref 5 0))
(p9-case (aref nil 0))
(p9-case (aref t 0))
(p9-case (aref 'p9-symbol 0))
(defvar p9-baset (make-byte-code 0 (unibyte-string 192 193 194 195 35 135) [aset (1 2) 0 0] 4))
(p9-case (funcall p9-baset))
(defvar p9-baset-op (make-byte-code 0 (unibyte-string 192 193 194 73 135) [(1 2) 0 0] 3))
(defvar p9-baref-op (make-byte-code 0 (unibyte-string 192 193 72 135) [5 0] 2))
(p9-case (funcall p9-baset-op))
(p9-case (funcall p9-baref-op))
(p9-case (with-temp-buffer (setq fill-column 55)
                          (list fill-column (default-value 'fill-column))))
(p9-case (let ((old (default-value 'fill-column)))
           (with-temp-buffer (setq fill-column 41))
           (eq old (default-value 'fill-column))))
(princ "PARITY9 COMPLETE\n")
(kill-emacs 0)
