;;; nelisp-fxlet-unwind-test.el --- Generated event-root lifetime -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-standalone-build)

(defun fxlet-test--generated (name &optional allow-missing)
  (let ((definition (cl-find name (append (nelisp-standalone--target-bytecode-helpers)
                                         nelisp-standalone--applyfn-m5-helpers
                                         (cdr nelisp-standalone--n4-source)) :key #'cadr)))
    (if (not definition)
        (if allow-missing (lambda (&rest _) (error "Missing generated helper: %s" name))
          (error "Missing generated helper: %s" name))
      (eval `(lambda ,(nth 2 definition)
             (cl-macrolet ((seq (&rest forms) (cons 'progn forms)))
               ,@(cdddr definition))) t))))

(defmacro fxlet-test--with-events (&rest body)
  `(let ((memory (make-hash-table :test #'eql)) (cells (make-hash-table :test #'eql))
         (next 4000) (allocations 0) (pops nil))
     (puthash 1096 1 memory)
     (puthash 1008 3 memory)
     (cl-letf (((symbol-function 'ptr-read-u64) (lambda (p off) (gethash (+ p off) memory 3)))
               ((symbol-function 'heap-read-u64) (lambda (p off) (gethash (+ p off) memory 3)))
               ((symbol-function 'ptr-write-u64) (lambda (p off v) (puthash (+ p off) v memory)))
               ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
               ((symbol-function 'shl) #'ash)
               ((symbol-function 'wf_dirty) (lambda () 0))
               ;; These original cases model no scoped N4 view or live cuts.
               ((symbol-function 'nl_n4_cut_rebase) (lambda (env &rest _) (should (= env 0)) 0))
               ((symbol-function 'nl_n4_binding_visible) (lambda (env &rest _) (should (= env 0)) 1))
               ((symbol-function 'wf_bytecode_unbind)
                (lambda (_frames n) (push 'general pops) (should (= n 1)) 0))
               ((symbol-function 'wf_bytecode_w_cons2)
                (lambda (a d) (cl-incf allocations) (cl-incf next 8)
                  (puthash next (cons a d) cells) next))
               ((symbol-function 'nl_cons_car_word) (lambda (v) (car (gethash v cells))))
               ((symbol-function 'nl_cons_cdr_word) (lambda (v) (cdr (gethash v cells))))
               ((symbol-function 'wf_bytecode_w_consp) (lambda (v) (if (gethash v cells) 1 0)))
               ((symbol-function 'wf_bytecode_w_pop_lean) (fxlet-test--generated 'wf_bytecode_w_pop_lean))
               ((symbol-function 'wf_bytecode_w_aux_spill) (fxlet-test--generated 'wf_bytecode_w_aux_spill))
               ((symbol-function 'wf_bytecode_unwind_push) (fxlet-test--generated 'wf_bytecode_unwind_push))
               ((symbol-function 'm5_fx_general_event) (fxlet-test--generated 'm5_fx_general_event t))
               ((symbol-function 'm5_fx_pop_event) (fxlet-test--generated 'm5_fx_pop_event t))
               ((symbol-function 'm5_fx_unbind) (fxlet-test--generated 'm5_fx_unbind)))
       ,@body)))

(ert-deftest fxlet-real-varbind-fallback-records-without-cons ()
  (fxlet-test--with-events
   (let* ((definition (cl-find 'm5_fx_run_body nelisp-standalone--applyfn-m5-helpers :key #'cadr))
          (branch (cl-labels ((find-arm (node)
                               (when (consp node)
                                 (if (equal (car-safe (cdr node)) '(= op 20))
                                     (nth 2 node)
                                   (or (find-arm (car node)) (find-arm (cdr node)))))))
                    (find-arm definition)))
          (run (eval `(lambda ()
                        (let ((env 0) (aux 1000) (base 0) (pc 0) (stk 5000)
                              (sp 1) (nb 0) (status 0) (a 0) (r 0))
                          (cl-macrolet ((seq (&rest forms) (cons 'progn forms)))
                            ,branch)
                          (list sp nb status pc))) t)))
     (should branch)
     (cl-letf (((symbol-function 'wf_bytecode_w_lean_bind) (lambda (&rest _) 1))
               ((symbol-function 'wf_bytecode_varbind) (lambda (&rest _) 0)))
       (should (equal (funcall run) '(0 1 0 2))))
     (should (= allocations 0))
     (should (= (gethash 1096 memory) 5)))))

(ert-deftest fxlet-general-event-no-cons-and-clears-slots ()
  (fxlet-test--with-events
   (dotimes (_ 100)
     (m5_fx_general_event 0 1000)
     (should (= (m5_fx_pop_event 0 1000 1) 1))
     (should (= (gethash 1104 memory) 3))
     (should (= (gethash 1112 memory) 3)))
   (should (= allocations 0))
   (should (= (length pops) 100))
   (should (= (gethash 1096 memory) 1))))

(ert-deftest fxlet-mixed-partial-pop-counts-only-general-frames ()
  (fxlet-test--with-events
   ;; Outer general, then a symbol binding, then an inner general binding.
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (m5_fx_general_event 0 1000)
   (should (= (m5_fx_unbind 0 1000 2 2) 0))
   (should (= (gethash 2016 memory) 77))
   (should (= (length pops) 1))
   (should (= (gethash 1096 memory) 5))
   (should (= (m5_fx_pop_event 0 1000 1) 1))
   (should (= (length pops) 2))))

(ert-deftest fxlet-general-event-spill-24-25-preserves-order ()
  (fxlet-test--with-events
   (dotimes (_ 24) (m5_fx_general_event 0 1000))
   (should (= allocations 0))
   (m5_fx_general_event 0 1000)
   (should (= (gethash 1096 memory) 5))
   (should (= (m5_fx_pop_event 0 1000 1) 1))
   (let ((tail (gethash 1008 memory)) (count 0))
     (while (/= tail 3)
       (let ((event (nl_cons_car_word tail)))
         (should (= (nl_cons_car_word event) 1))
         (should (= (nl_cons_car_word (nl_cons_cdr_word event)) 3)))
       (cl-incf count)
       (setq tail (nl_cons_cdr_word tail)))
     (should (= count 24)))
   (dotimes (i 24)
     (should (= (gethash (+ 1104 (* i 16)) memory) 3))
     (should (= (gethash (+ 1112 (* i 16)) memory) 3)))))

(ert-deftest fxlet-general-event-never-pops-outside-frame-bound ()
  (fxlet-test--with-events
   (m5_fx_general_event 0 1000)
   (should (= (m5_fx_pop_event 0 1000 0) 0))
   (should-not pops)
   (should (= (gethash 1096 memory) 1))))

(ert-deftest fxlet-unwind-array-general-updates-remaining-once ()
  (fxlet-test--with-events
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (m5_fx_general_event 0 1000)
   (let ((unwind (fxlet-test--generated 'wf_bytecode_unwind_step)))
     (should (= (funcall unwind 0 1000 3 3) 0)))
   (should (= (length pops) 2))
   ;; Three binding events include only two general environment frames.
   (should (= (gethash 1024 memory) 5))
   (should (= (gethash 1072 memory) 3))
   (should (= (gethash 2016 memory) 77))))

(ert-deftest fxlet-mixed-spill-keeps-general-and-symbol-event-order ()
  (fxlet-test--with-events
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (m5_fx_general_event 0 1000)
   (wf_bytecode_w_aux_spill 0 1000)
   (let* ((tail (gethash 1008 memory))
          (newest (nl_cons_car_word tail))
          (middle (nl_cons_car_word (nl_cons_cdr_word tail)))
          (oldest (nl_cons_car_word (nl_cons_cdr_word (nl_cons_cdr_word tail)))))
     (should (= (nl_cons_car_word newest) 1))
     (should (= (nl_cons_car_word middle) 2006))
     (should (= (nl_cons_cdr_word middle) 77))
     (should (= (nl_cons_car_word oldest) 1)))
   (should (= (gethash 1096 memory) 1))))

(ert-deftest fxlet-thread-depth-includes-unspilled-general-records ()
  (fxlet-test--with-events
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (m5_fx_general_event 0 1000)
   (puthash 6016 1008 memory)
   (puthash 6024 4 memory)
   (cl-letf (((symbol-function 'wf_bytecode_w_link_events) (fxlet-test--generated 'wf_bytecode_w_link_events))
             ((symbol-function 'wf_bytecode_w_aux_unwinds) (fxlet-test--generated 'wf_bytecode_w_aux_unwinds))
             ((symbol-function 'nl_val_tag)
              (lambda (v) (cond ((gethash v cells) 7) ((= v 1) 2) ((= v 2006) 4) (t 0))))
             ((symbol-function 'wf_bytecode_w_int) (lambda (v) (ash v -2))))
     (should (= (funcall (fxlet-test--generated 'nl_thread_lean_depth) 0 6000) 6)))))

(ert-deftest fxlet-thread-unshallow-uses-complete-mixed-event-depth ()
  (fxlet-test--with-events
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (m5_fx_general_event 0 1000)
   (puthash 176 7000 memory)
   (puthash 7016 6000 memory)
   (puthash 6016 1008 memory)
   (puthash 6024 4 memory)
   (puthash 6008 0 memory)
   (let (converted)
     (cl-letf (((symbol-function 'wf_bytecode_w_link_events) (fxlet-test--generated 'wf_bytecode_w_link_events))
               ((symbol-function 'wf_bytecode_w_aux_unwinds) (fxlet-test--generated 'wf_bytecode_w_aux_unwinds))
               ((symbol-function 'nl_thread_lean_depth) (fxlet-test--generated 'nl_thread_lean_depth))
               ((symbol-function 'nl_val_tag)
                (lambda (v) (cond ((gethash v cells) 7) ((= v 1) 2) ((= v 2006) 4) (t 0))))
               ((symbol-function 'wf_bytecode_w_int) (lambda (v) (ash v -2)))
               ((symbol-function 'nl_thread_unshallow_lean_one)
                (lambda (_env event depth) (push (list (nl_cons_car_word event) depth) converted) 0)))
       (funcall (fxlet-test--generated 'nl_thread_unshallow_lean_at) 0 5))
     (should (equal converted '((2006 5)))))))

(ert-deftest fxlet-parent-unshallow-does-not-skip-first-descending-depth ()
  (fxlet-test--with-events
   ;; Actual owner schedule: entry depth10, general then symbol, current11.
   ;; Missing wanted11 on the first pass cannot be repaired by later passes.
   (m5_fx_general_event 0 1000)
   (puthash 1120 2006 memory)
   (puthash 1128 77 memory)
   (puthash 1096 9 memory)
   (puthash 168 0 memory)
   (puthash 176 7000 memory)
   (puthash 7016 6000 memory)
   (puthash 6016 1008 memory)
   (puthash 6024 10 memory)
   (puthash 6008 0 memory)
   (let (converted)
     (cl-letf (((symbol-function 'wf_bytecode_w_link_events) (fxlet-test--generated 'wf_bytecode_w_link_events))
               ((symbol-function 'wf_bytecode_w_aux_unwinds) (fxlet-test--generated 'wf_bytecode_w_aux_unwinds))
               ((symbol-function 'nl_thread_lean_depth) (fxlet-test--generated 'nl_thread_lean_depth))
               ((symbol-function 'nl_thread_unshallow_lean_at) (fxlet-test--generated 'nl_thread_unshallow_lean_at))
               ((symbol-function 'nl_val_tag)
                (lambda (v) (cond ((gethash v cells) 7) ((= v 1) 2) ((= v 2006) 4) (t 0))))
               ((symbol-function 'wf_bytecode_w_int) (lambda (v) (ash v -2)))
               ((symbol-function 'nl_record_slot_word) (lambda (_frame slot) (if (= slot 1) 45 3)))
               ((symbol-function 'nl_vector_slot_word) (lambda (&rest _) 8000))
               ((symbol-function 'nl_frame_stack_promote_env) (lambda (&rest _) 0))
               ((symbol-function 'nl_thread_unshallow_names) (lambda (&rest _) 0))
               ((symbol-function 'nl_thread_registry_find) (lambda (&rest _) 0))
               ;; Root-stack intrinsics (lisp/nelisp-cc-rootstack.el) that the
               ;; generated body now uses to root its frame; model a bump stack.
               ((symbol-function 'nl_thread_parent_unshallow_rooted)
                (fxlet-test--generated 'nl_thread_parent_unshallow_rooted))
               ((symbol-function 'nl_root_mark) (lambda (_env) 0))
               ((symbol-function 'nl_root_frame) (lambda (_env n) (cl-incf next (* 8 n)) next))
               ((symbol-function 'nl_root_release) (lambda (&rest _) 0))
               ((symbol-function 'nl_thread_unshallow_lean_one)
                (lambda (_env event depth) (push (list (nl_cons_car_word event) depth) converted) 0)))
       (funcall (fxlet-test--generated 'nl_thread_parent_unshallow) 0))
     (should (equal converted '((2006 11)))))))

(ert-deftest fxlet-consumed-event-root-ends-at-unwind-return ()
  ;; Execute the generator's actual unwinder with a bounded mock memory.
  ;; The event must remain rooted during dispatch and be released on return.
  (let* ((definition (cl-find 'wf_bytecode_unwind_step
                              (nelisp-standalone--target-bytecode-helpers) :key #'cadr))
         (body (cdddr definition))
         (fn (eval `(lambda (env aux target remaining)
                      (cl-macrolet ((seq (&rest forms) (cons 'progn forms)))
                        ,@body)) t))
         (mem (make-hash-table :test #'eql))
         (event 3000)
         (seen nil))
    (puthash 1008 2000 mem)
    (puthash 1096 1 mem)
    (cl-letf (((symbol-function 'ptr-read-u64)
               (lambda (p off) (gethash (+ p off) mem)))
              ((symbol-function 'ptr-write-u64)
               (lambda (p off value) (puthash (+ p off) value mem)))
              ((symbol-function 'sar) (lambda (v n) (ash v (- n))))
              ((symbol-function 'shl) #'ash)
              ((symbol-function 'wf_bytecode_w_consp) (lambda (v) (if (= v 2000) 1 0)))
              ((symbol-function 'wf_bytecode_handlers_cross_unwind) (lambda (&rest _) 0))
              ((symbol-function 'nl_cons_car_word) (lambda (_) event))
              ((symbol-function 'nl_cons_cdr_word) (lambda (_) 3))
              ((symbol-function 'wf_bytecode_w_lean_event_p) (lambda (_) 1))
              ((symbol-function 'wf_bytecode_w_lean_unbind)
               (lambda (_env current)
                 (should (eq (gethash 1072 mem) event))
                 (setq seen current)
                 0)))
      (should (= (funcall fn 0 1000 3 0) 0)))
    (should (eq seen event))
    (should (equal (gethash 1008 mem) 3))
    (should (equal (gethash 1072 mem) 3))))

(provide 'nelisp-fxlet-unwind-test)
