;;; nelisp-hashfast-test.el --- Hash/walker production IR checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(defconst hf--root (file-name-directory (directory-file-name
                                       (file-name-directory load-file-name))))
(defun hf--definition (name &optional source)
  "Read one exact DSL definition; reject an absent or ambiguous name."
  (with-temp-buffer
    (insert-file-contents (or source (getenv "HF_SOURCE")
                             (expand-file-name "scripts/nelisp-standalone-build.el" hf--root)))
    (let ((pattern (concat "(defun " (symbol-name name) " ")) form)
      (goto-char (point-min))
      (unless (search-forward pattern nil t) (error "Missing %s" name))
      (goto-char (match-beginning 0))
      (setq form (read (current-buffer)))
      (when (search-forward pattern nil t) (error "Ambiguous %s" name))
      form)))
(defun hf--host (form)
  "Adapt IR syntax and boolean convention, retaining production logic."
  (cond ((atom form) form)
        ((memq (car form) '(if while))
         (cons (car form) (cons `(hf--truth ,(hf--host (cadr form)))
                                (mapcar #'hf--host (cddr form)))))
        (t (cons (pcase (car form) ('seq 'progn) ('shr 'hf--shr)
                        ('sar 'hf--sar) ('shl 'ash) (_ (car form)))
                 (mapcar #'hf--host (cdr form))))))
(defun hf--truth (x) (and x (not (equal x 0))))
(defun hf--shr (x n) (ash (logand x #xffffffffffffffff) (- n)))
(defun hf--sar (x n) (ash x (- n)))
(defun hf--install (names)
  (dolist (name names) (eval (hf--host (hf--definition name)) t)))

(ert-deftest hf-float-distribution ()
  ;; Every key is distinct, with all mantissa information above bit 31.
  ;; The seed maps this entire family to one eq/eql/equal bucket.
  (hf--install '(bf_identity_hash nl_ht_key_hash nl_ht_hash_index))
  (condition-case nil (hf--install '(nl_ht_float_hash)) (error nil))
  (cl-letf (((symbol-function 'nl_word_tag64) (lambda (_) 3))
            ((symbol-function 'heap-sexp-tag-word) (lambda (_) 3))
            ((symbol-function 'nl_float_bits) #'identity))
    (dolist (size '(256 1024 4096))
      (dolist (hashfn (list #'bf_identity_hash (lambda (p) (nl_ht_key_hash p 8))))
        (let ((buckets (make-hash-table :test 'eql)))
          (dotimes (i size)
            (let* ((bits (+ #x3ff0000000000000 (ash i 40)))
                   (hash (funcall hashfn bits))
                   (bucket (nl_ht_hash_index hash (* size 2))))
              (should (and (>= hash 0) (<= hash #x3fffffff)))
              (puthash bucket (1+ (gethash bucket buckets 0)) buckets)))
          (should (> (hash-table-count buckets) (/ size 2)))
          (maphash (lambda (_ count) (should (<= count 4))) buckets))))))

(ert-deftest hf-adapter-zero-false-control ()
  (should (= (eval (hf--host '(if 0 1 2)) t) 2))
  (should (= (eval (hf--host '(if 1 1 2)) t) 1)))

(ert-deftest hf-maphash-mutating-storage ()
  (hf--install '(wf_maphash_w))
  ;; Replacements model the root frame and tagged table slots; the walk and
  ;; callback dispatch are the production IR. A callback replaces all backing
  ;; vectors, removes a future entry, grows the capacity, and runs a nil key.
  (let ((roots (make-hash-table :test 'eql))
        (meta (vector 0 0 0 3 nil 0 0 0 nil nil 0
                      (vector nil 10 'b 20 'c 30) (vector 1 2 3)))
        (seen nil) (released nil))
    (cl-letf (((symbol-function 'wf_arg_word) (lambda (_ i) (if (= i 0) 'callback 'table)))
              ((symbol-function 'bf_hash_table_p_raw) (lambda (_) 1))
              ((symbol-function 'nl_root_mark) (lambda (_) 17))
              ((symbol-function 'nl_root_words) (lambda (_ _) 1024))
              ((symbol-function 'nl_word_canon) #'identity)
              ((symbol-function 'ptr-write-u64) (lambda (p off v) (puthash (+ p off) v roots)))
              ((symbol-function 'heap-read-u64) (lambda (p off) (gethash (+ p off) roots)))
              ((symbol-function 'nl_root_release) (lambda (_ mark) (setq released mark)))
              ((symbol-function 'nl_ht_meta_slot) (lambda (_) meta))
              ((symbol-function 'nl_ht_int) (lambda (m i) (aref m i)))
              ((symbol-function 'nl_ht_marker_word) (lambda (m i) (aref m i)))
              ((symbol-function 'nl_vector_slot_word) (lambda (v i) (aref v i)))
              ((symbol-function 'wf_word_view) #'identity)
              ((symbol-function 'wf_cb_kind) (lambda (&rest _) 0))
              ((symbol-function 'nelisp_cons_construct_w)
               (lambda (a b _) (cons a (if (equal b 3) nil b))))
              ((symbol-function 'nl_apply_function_w)
               (lambda (_ args _env _pad)
                 (push args seen)
                 (when (= (length seen) 1)
                   (setq meta (copy-sequence meta))
                   (aset meta 3 4)
                   (aset meta 11 (vector nil 10 'b 200 'gone 30 'new 40))
                   (aset meta 12 (vector -1 2 -1 4)))
                 3)))
      (should (= (wf_maphash_w 'args 99) 3))
      (should (equal (nreverse seen) '((nil 10) (b 200) (new 40))))
      (should (= released 17)))))

;; cbroute: native mapc/maphash enter a bytecode callee through
;; `wf_cb_call_words' (the Bcall frame entry) with the argument words in the
;; rooted frame, not through a consed argument list.
(defun hf--cb-run (kind-value target-after bytecode-status &optional name-check)
  "Walk a 3-entry table with `wf_maphash_w'.  Answers (RESULT DIRECT OLD)."
  (hf--install '(wf_maphash_w wf_cb_call_words))
  (let ((roots (make-hash-table :test 'eql))
        (meta (vector 0 0 0 3 nil 0 0 0 nil nil 0
                      (vector 1 10 2 20 3 30) (vector 1 2 3)))
        (direct nil) (old nil) (calls 0))
    (cl-letf (((symbol-function 'wf_arg_word) (lambda (_ i) (if (= i 0) 'callback 'table)))
              ((symbol-function 'bf_hash_table_p_raw) (lambda (_) 1))
              ((symbol-function 'nl_root_mark) (lambda (_) 17))
              ((symbol-function 'nl_root_words) (lambda (_ _) 1024))
              ((symbol-function 'nl_word_canon) #'identity)
              ((symbol-function 'ptr-write-u64) (lambda (p off v) (puthash (+ p off) v roots)))
              ((symbol-function 'heap-read-u64) (lambda (p off) (gethash (+ p off) roots)))
              ((symbol-function 'nl_root_release) (lambda (&rest _) nil))
              ((symbol-function 'nl_ht_meta_slot) (lambda (_) meta))
              ((symbol-function 'nl_ht_int) (lambda (m i) (aref m i)))
              ((symbol-function 'nl_ht_marker_word) (lambda (m i) (aref m i)))
              ((symbol-function 'nl_vector_slot_word) (lambda (v i) (aref v i)))
              ((symbol-function 'wf_word_view) #'identity)
              ((symbol-function 'wf_cb_kind)
               (lambda (_env r tslot _argc) (puthash (+ r tslot) 100 roots) kind-value))
              ((symbol-function 'wf_cb_target)
               (lambda (_env _fw) (if (and target-after (> calls 0)) target-after 100)))
              ((symbol-function 'nl_n4_push_words) (lambda (&rest _) 0))
              ((symbol-function 'nl_n4_finish_w) (lambda (w &rest _) w))
              ((symbol-function 'wf_bytecode_w_function)
               (lambda (func mem first argc _env outw out)
                 (cl-incf calls)
                 (should (= func 100))
                 (should (= outw (+ mem 24)))
                 (should (= first 4))
                 (should (= out 0))
                 (push (list argc (gethash (+ mem 32) roots) (gethash (+ mem 40) roots))
                       direct)
                 (puthash outw 555 roots)
                 (if (functionp bytecode-status) (funcall bytecode-status calls)
                   bytecode-status)))
              ((symbol-function 'nelisp_cons_construct_w)
               (lambda (a b _) (cons a (if (equal b 3) nil b))))
              ((symbol-function 'nl_apply_function_w)
               (lambda (_ args _env _pad) (push args old) 3)))
      (list (wf_maphash_w 'args 99) (nreverse direct) (nreverse old)))))

(ert-deftest hf-maphash-bytecode-direct-route ()
  (let ((r (hf--cb-run 2 nil 0)))
    (should (= (car r) 3))
    (should (equal (cadr r) '((2 1 10) (2 2 20) (2 3 30))))
    (should (null (nth 2 r)))))

(ert-deftest hf-maphash-bytecode-signal-stops-walk ()
  (let ((r (hf--cb-run 2 nil (lambda (n) (if (= n 2) 1 0)))))
    (should (= (car r) 0))
    (should (= (length (cadr r)) 2))
    (should (null (nth 2 r)))))

(ert-deftest hf-maphash-bytecode-not-covered-uses-old-route ()
  (let ((r (hf--cb-run 2 nil 2)))
    (should (= (car r) 3))
    (should (equal (nth 2 r) '((1 10) (2 20) (3 30))))))

(ert-deftest hf-maphash-symbol-cell-change-uses-old-route ()
  ;; Kind 1 (a symbol): after the first element the cell holds another
  ;; function, so the remaining elements take the old route.
  (let ((r (hf--cb-run 1 200 0)))
    (should (= (car r) 3))
    (should (equal (cadr r) '((2 1 10))))
    (should (equal (nth 2 r) '((2 20) (3 30))))))

(ert-deftest hf-maphash-non-bytecode-callee-keeps-old-route ()
  (let ((r (hf--cb-run 0 nil 0)))
    (should (null (cadr r)))
    (should (equal (nth 2 r) '((1 10) (2 20) (3 30))))))

(ert-deftest hf-constructor-reference-gnu-errors ()
  (let* ((source (expand-file-name "scripts/nelisp-stdlib-prelude.el" hf--root))
         (form (condition-case nil
                   (hf--definition 'nelisp--make-hash-table-reference source)
                 (error (hf--definition 'make-hash-table source)))))
    (setcar (cdr form) 'hf--construct)
    (eval form t)
    (eval (hf--definition 'nelisp--signal-invalid source) t)
    (cl-letf (((symbol-function 'nelisp--hash-new) (lambda (&rest args) args)))
      (should (equal (hf--construct :test nil :size nil) '(eql 0 nil)))
      (should (equal (hf--construct :test 'eq :test 'bad :size 2 :size -1) '(eq 2 nil)))
      (should (equal (hf--construct :weakness t) '(eql 0 key-and-value)))
      (should (equal (hf--construct :rehash-size 'anything :purecopy t) '(eql 0 nil)))
      (should (equal (condition-case e (hf--construct :test 17) (error e))
                     '(wrong-type-argument symbolp 17)))
      (should (equal (condition-case e (hf--construct :test 'invalid) (error e))
                     '(error "Invalid hash table test" invalid)))
      (should (equal (condition-case e (hf--construct :size -1) (error e))
                     '(error "Invalid hash table size" -1)))
      (should (equal (condition-case e (hf--construct :weakness 'bad) (error e))
                     '(error "Invalid hash table weakness" bad)))
      (should (equal (condition-case e (hf--construct :size) (error e))
                     '(error "Odd number of arguments")))
      (should (equal (condition-case e (hf--construct :bad 1 :worse 2) (error e))
                     '(error "Invalid keyword argument" :worse)))
      (should (equal (condition-case e (hf--construct :weakness '(key value)) (error e))
                     '(error "Invalid hash table weakness" key value)))
      (should (equal (condition-case e (hf--construct :size '(1 2)) (error e))
                     '(error "Invalid hash table size" 1 2)))
      (should (equal (condition-case e (hf--construct '(odd key) 1) (error e))
                     '(error "Invalid keyword argument" odd key))))))

(ert-deftest hf-mapc-reference-bool-and-list-mutation ()
  (let* ((source (expand-file-name "scripts/nelisp-stdlib-prelude.el" hf--root))
         (form (condition-case nil (hf--definition 'nelisp--mapc-reference source)
                 (error (hf--definition 'mapc source))))
         (seen nil) (bits (bool-vector t nil t)))
    (setcar (cdr form) 'hf--mapc)
    (eval form t)
    (cl-letf (((symbol-function 'nelisp--check-seq-list) #'identity))
      (should (eq (hf--mapc (lambda (x) (push x seen)) bits) bits))
      (should (equal (nreverse seen) '(t nil t)))
      (let ((seq (list 1 2 3)))
        (setq seen nil)
        (should (eq (hf--mapc (lambda (x) (push x seen) (setcdr seq nil)) seq) seq))
        (should (equal seen '(1))))
      (should (equal (hf--mapc 'hf-no-such-function []) [])))))

(ert-deftest hf-test-mode-cached-and-migrated ()
  (hf--install '(nl_ht_test_mode))
  (let ((meta (make-vector 15 0)) (reads 0) (reindexes 0))
    (aset meta 2 'eq)
    (cl-letf (((symbol-function 'nl_cons_car_word) (lambda (_) meta))
              ((symbol-function 'heap-sexp-tag-word) (lambda (_) 8))
              ((symbol-function 'vector-len) #'length)
              ((symbol-function 'vector-ref-ptr) #'aref)
              ((symbol-function 'sexp-tag) (lambda (_) 4))
              ((symbol-function 'heap-sexp-length) (lambda (_) 2))
              ((symbol-function 'heap-sexp-data) (lambda (_) 4096))
              ((symbol-function 'heap-read-u8)
               (lambda (_ i) (cl-incf reads) (aref "eq" i)))
              ((symbol-function 'nl_ht_int) #'aref)
              ((symbol-function 'nl_ht_set_int) #'aset)
              ((symbol-function 'nl_ht_reindex)
               (lambda (_ recompute)
                 (should (= recompute 1)) (cl-incf reindexes)
                 ;; The migration must publish its cache before recursing.
                 (should (= (nl_ht_test_mode 'table) 1)) 0)))
      (should (= (nl_ht_test_mode 'table) 1))
      (dotimes (_ 10) (should (= (nl_ht_test_mode 'table) 1)))
      (should (= reads 2))
      (should (= reindexes 1)))))

(ert-deftest hf-symbol-stable-arena-id ()
  (hf--install '(bf_identity_hash nl_ht_key_hash))
  (condition-case nil (hf--install '(nl_ht_symbol_hash)) (error nil))
  (let ((base #x10000000) (offset #x1000040))
    (cl-letf (((symbol-function 'nl_word_tag64) (lambda (_) 4))
              ((symbol-function 'heap-sexp-tag-word) (lambda (_) 4))
              ((symbol-function 'nl_ht_str_hash) (lambda (_) (error "Symbol name was hashed")))
              ((symbol-function 'heap-read-u64)
               (lambda (p off)
                 (cond ((= p 268436288) base)
                       ((= p 268436296) (+ base #x2000000))
                       ((= p 4096) (+ base offset))
                       ((= p 8192) 11)
                       ((= p base) (should (= off (+ (* 11 16) 8))) (+ base offset))
                       (t (error "Unexpected read %S %S" p off))))))
      (let ((view (bf_identity_hash 4096))
            (object (bf_identity_hash 8198)))
        (should (= view object))
        (should (= view (nl_ht_key_hash 4096 8)))
        ;; Relocate the entire intern arena without changing the identifier.
        (setq base #x20000000)
        (should (= view (bf_identity_hash 4096)))
        (should (= object (bf_identity_hash 8198)))))))

(ert-deftest hf-string-word-loads-and-boundaries ()
  (hf--install '(nl_ht_str_hash nl_ht_str_hash_loop nl_ht_str_hash_bytes))
  (condition-case nil (hf--install '(nl_ht_hash_words)) (error nil))
  (let ((bytes nil) (words 0) (singles 0))
    (cl-labels ((read-byte (_ i)
                  (should (and (>= i 0) (< i (length bytes))))
                  (cl-incf singles) (aref bytes i))
                (read-word (_ i)
                  (should (and (>= i 0) (<= (+ i 8) (length bytes))))
                  (cl-incf words)
                  (let ((word 0))
                    (dotimes (j 8) (setq word (+ word (ash (aref bytes (+ i j)) (* j 8)))))
                    word)))
      (cl-letf (((symbol-function 'm5_strlen) (lambda (_) (length bytes)))
                ((symbol-function 'nl_bi_strptr) (lambda (_) 4096))
                ((symbol-function 'm5_byte_at) #'read-byte)
                ((symbol-function 'heap-read-u8) #'read-byte)
                ((symbol-function 'heap-read-u64) #'read-word))
        (dolist (n '(0 1 7 8 9 15 16 31 32 127 128 129 4096))
          (setq bytes (make-string n ?x) words 0 singles 0)
          (let ((h (nl_ht_str_hash 8192)))
            (should (= h (nl_ht_str_hash 8192)))
            (when (= n 128)
              (should (= words 32)) (should (= singles 0)))))))))

(provide 'nelisp-hashfast-test)
