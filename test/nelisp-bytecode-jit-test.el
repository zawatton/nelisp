(ert-deftest nelisp-bytecode-jit/generic-native-entry-error-does-not-replay-and-recovers ()
  (let* ((function (byte-compile '(lambda (x) (+ x 1))))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--hot-counts (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--pending-queue nil)
         (nelisp-bytecode-jit--pending-identities (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--compile-failures (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--dispatch-active nil)
         (nelisp-bytecode-jit--interpreter-fallback-count 0)
         (nelisp-bytecode-jit--native-call-count 0)
         (native-calls 0)
         (replays 0))
         (cl-letf (((symbol-function 'nelisp-bytecode-jit--compile-ir)
               (lambda (_function ir)
                 (nelisp-bytecode-jit-test--candidate-handle ir)))
              ((symbol-function 'nelisp-native-load-raw-call)
               (lambda (_handle _arguments)
                 (setq native-calls (1+ native-calls))
                 (if (= native-calls 1)
                     (signal 'file-error '("mock native entry failed"))
                   9))))
      (let ((failure
             (should-error
              (if (nelisp-bytecode-jit-test--dispatch-prepared function 8)
                  'native-result
                (setq replays (1+ replays)))
              :type 'file-error)))
        (should (equal failure '(file-error "mock native entry failed"))))
      (should (= native-calls 1))
      (should (= replays 0))
      (should (= nelisp-bytecode-jit--interpreter-fallback-count 0))
      (should-not nelisp-bytecode-jit--dispatch-active)
      (should (equal (nelisp-bytecode-jit-test--dispatch-prepared function 8) [t 9]))
      (should (= native-calls 2)))))

