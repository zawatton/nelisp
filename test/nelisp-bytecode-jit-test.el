;;; nelisp-bytecode-jit-test.el --- P5 narrow lowering tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-jit)

(defun nelisp-bytecode-jit-test--dispatch-prepared (function &rest arguments)
  "Prepare eligible FUNCTION explicitly, then exercise the VM dispatch hook."
  (let ((ir (nelisp-bytecode-jit--decode-ir function)))
    (when (and ir (nelisp-bytecode-jit--safe-ir-p ir arguments))
      (nelisp-bytecode-jit-prepare function)))
  (apply #'nelisp-bytecode-jit--runtime-dispatch function arguments))

(defun nelisp-bytecode-jit-test--install-ready-handle (function ir handle)
  "Install an explicitly marked test fixture for FUNCTION, IR, and HANDLE."
  (puthash function
           (list :state 'ready
                 :identity (nelisp-bytecode-jit--cache-identity function)
                 :ir ir :handle handle)
           nelisp-bytecode-jit--handles))

(defun nelisp-bytecode-jit-test--candidate-handle (ir &optional entry)
  "Return a metadata-complete mock candidate compatible with IR."
  (cond
   ((nelisp-bytecode-jit--boxed-integerp-ir-p ir)
    (list :entry (or entry 4096) :arity (plist-get ir :arity)
          :abi 'integer :param-repr 'sexp-ptr :return-repr 'raw-bool))
   ((nelisp-bytecode-jit--boxed-result-ir-p ir)
    (list :entry (or entry 4096) :arity (plist-get ir :arity)
          :abi 'boxed :param-repr 'sexp-ptr
          :return-repr (if (nelisp-bytecode-jit--boxed-object-boolean-ir-p ir)
                           'raw-bool 'sexp-ptr)))
   (t (list :entry (or entry 4096) :arity (plist-get ir :arity)
            :abi 'integer :param-repr 'raw-i64 :return-repr 'raw-i64))))

(ert-deftest nelisp-bytecode-jit/runtime-dispatch-queues-once-and-drains-outside-vm ()
  (let* ((function (byte-compile '(lambda (x) (1+ x))))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--deferred-preparation-enabled t)
         (nelisp-bytecode-jit--runtime-identity-cache :unset)
         (nelisp-bytecode-jit--handles (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--pending-identities (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--compile-failures (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--pending-queue nil)
         (nelisp-bytecode-jit--dispatch-active nil)
         (compile-calls 0)
         (identity-calls 0))
    (cl-letf (((symbol-function 'nelisp-native-load--running-binary-sha256)
               (lambda () (setq identity-calls (1+ identity-calls)) "image-a"))
              ((symbol-function 'nelisp-bytecode-jit--compile-ir)
               (lambda (_function _ir)
                 (setq compile-calls (1+ compile-calls))
                 (should (= (nelisp-bytecode-jit-drain-pending) 0))
                 '(:entry 4096 :arity 1 :abi integer
                   :param-repr raw-i64 :return-repr raw-i64)))
              ((symbol-function 'nelisp-native-load-raw-call)
               (lambda (_handle arguments) (1+ (car arguments)))))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 8))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 8))
      (should (= compile-calls 0))
      (should (= (length nelisp-bytecode-jit--pending-queue) 1))
      (let ((nelisp-bytecode-jit--dispatch-active t))
        (should (= (nelisp-bytecode-jit-drain-pending) 0)))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (= compile-calls 1))
      (should (= identity-calls 1))
      (should (= (length nelisp-bytecode-jit--pending-queue) 0))
      (should (equal (nelisp-bytecode-jit--runtime-dispatch function 8) [t 9]))
      (should (= identity-calls 1)))))

(ert-deftest nelisp-bytecode-jit/preparation-failure-is-terminal-until-identity-changes ()
  (let* ((function (byte-compile '(lambda (x) (1+ x))))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--deferred-preparation-enabled t)
         (nelisp-bytecode-jit--runtime-identity-cache :unset)
         (nelisp-bytecode-jit--handles (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--pending-identities (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--compile-failures (make-hash-table :test 'eq))
         (nelisp-native-load-raw-runtime-abi-v2 "abi-a")
         (nelisp-bytecode-jit--pending-queue nil)
         (compile-calls 0)
         (image "image-a"))
    (cl-letf (((symbol-function 'nelisp-native-load--running-binary-sha256)
               (lambda () image))
              ((symbol-function 'nelisp-bytecode-jit--compile-ir)
               (lambda (&rest _)
                 (setq compile-calls (1+ compile-calls))
                 (error "terminal compile failure"))))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 4))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 4))
      (should (= (length nelisp-bytecode-jit--pending-queue) 1))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (= compile-calls 1))
      (should (= (hash-table-count nelisp-bytecode-jit--compile-failures) 1))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 4))
      (should (= compile-calls 1))
      (should (= (length nelisp-bytecode-jit--pending-queue) 0))
      (setq image "image-b"
            nelisp-bytecode-jit--runtime-identity-cache :unset)
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 4))
      (should (= (length nelisp-bytecode-jit--pending-queue) 1))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (= compile-calls 2))
      (should (= (hash-table-count nelisp-bytecode-jit--compile-failures) 1))
      (setq nelisp-native-load-raw-runtime-abi-v2 "abi-b")
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 4))
      (should (= (length nelisp-bytecode-jit--pending-queue) 1))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (= compile-calls 3))
      (should (= (hash-table-count nelisp-bytecode-jit--compile-failures) 1)))))

(ert-deftest nelisp-bytecode-jit/bytecode-payload-change-invalidates-ready-handle ()
  (let* ((function (byte-compile '(lambda (x) (1+ x))))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--deferred-preparation-enabled t)
         (nelisp-bytecode-jit--runtime-identity-cache :unset)
