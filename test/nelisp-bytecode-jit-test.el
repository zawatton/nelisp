(ert-deftest nelisp-bytecode-jit/runtime-dispatch-failure-captures-opt-in-diagnostics ()
  (let* ((diagnostic-dir (make-temp-file "nelisp-jit-runtime-diagnostic-" t))
         (process-environment (copy-sequence process-environment))
