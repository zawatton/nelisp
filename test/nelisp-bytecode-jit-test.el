         (nelisp-bytecode-jit--handles (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--native-call-count 0)
         (nelisp-bytecode-jit--interpreter-fallback-count 0)
         (observed nil))
    (cl-letf (((symbol-function 'nelisp-bytecode-jit--compile-ir)
               (lambda (_function ir)
                 (nelisp-bytecode-jit-test--candidate-handle ir)))
              ((symbol-function 'nelisp-native-load-call)
               (lambda (handle arguments)
                 (setq observed (list handle arguments))
