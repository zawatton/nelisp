(ert-deftest nelisp-bytecode-jit/lowers-backward-loop-from-cfg-stack-state ()
  (let* ((function
          (byte-compile
           '(lambda (n) (let ((i 0)) (while (< i n) (setq i (1+ i))) i))))
         (ir (nelisp-bytecode-jit--decode-ir function)))
    (should ir)
    (should (equal (plist-get (plist-get ir :loop) :header) 1))
    (should (equal (plist-get (plist-get ir :loop) :backedge) 8))
    (should (equal (plist-get ir :expression)
                   '(let ((nelisp-bc-loop-s0 0) (nelisp-bc-loop-s1 x0))
                      (while (< nelisp-bc-loop-s0 nelisp-bc-loop-s1)
                        (let ((nelisp-bc-loop-next0
                               (1+ nelisp-bc-loop-s0)))
                          (setq nelisp-bc-loop-s0 nelisp-bc-loop-next0)))
                      nelisp-bc-loop-s0)))
    (let* ((aot-form (nelisp-bytecode-jit--aot-form
                      (plist-get ir :expression)))
           (body (nth 2 (nth 2 aot-form))))
      (should (equal (cadar (cadr body))
                     '(+ nelisp-bc-loop-s0 1))))
    (dolist (case '((-4 . 0) (0 . 0) (1 . 1) (9 . 9)))
      (should (= (funcall function (car case)) (cdr case)))
      (should (nelisp-bytecode-jit--safe-ir-p ir (list (car case)))))
    (should-not
     (nelisp-bytecode-jit--safe-ir-p ir (list most-positive-fixnum)))))

