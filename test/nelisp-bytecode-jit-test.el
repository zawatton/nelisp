         (native-calls 0)
         (handle '(:entry 4096 :arity 1 :abi boxed
                   :param-repr sexp-ptr :return-repr raw-bool))
         (cycle (list 'a)))
    (setcdr cycle cycle)
    (cl-letf (((symbol-function 'nelisp-artifact-compile-file)
               (lambda (&rest _args) nil))
              ((symbol-function 'nelisp-native-load-artifact)
               (lambda (&rest _args) handle))
              ((symbol-function 'nelisp-native-load-call)
               (lambda (&rest _args)
                 (setq native-calls (1+ native-calls))
                 (error "unsupported values must never enter the native loader"))))
      (dolist (function functions)
        (should (nelisp-bytecode-jit-prepare function)))
      (dolist (case `((,symbolp-function ,(make-symbol "jit-uninterned"))
                      (,consp-function (a . b))
                      (,listp-function (a . b))
