         (nelisp-bytecode-jit--interpreter-fallback-count 0))
    (unwind-protect
        (progn
          (setenv "NELISP_JIT_DIAGNOSTIC_DIR" diagnostic-dir)
          (cl-letf (((symbol-function 'nelisp-native-load-raw-compile-file)
                     (lambda (&rest _)
                       (error "mock raw compiler failure")))
                    ((symbol-function 'nelisp-native-load-raw-artifact)
