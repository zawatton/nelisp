    (should (nelisp-bytecode-jit--safe-ir-p
             ir '((frame-configuration state))))
    (should-not (nelisp-bytecode-jit--safe-ir-p ir '((frame-configuration . state))))
    (should-not (nelisp-bytecode-jit--safe-ir-p ir (list (make-symbol "loose"))))))

