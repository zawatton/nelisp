         (handle '(:entry 4096 :arity 1 :abi boxed
                   :param-repr sexp-ptr :return-repr raw-bool)))
    (cl-letf (((symbol-function 'nelisp-artifact-compile-file)
               (lambda (source artifact &rest args)
                 (setq compile-calls (1+ compile-calls))
                 (should (string-suffix-p ".neln" artifact))
                 (should (eq (car (last args)) 'neln))
                 (with-temp-buffer
                   (insert-file-contents source)
                   (should (equal (buffer-string)
                                  ";;; -*- lexical-binding: t; -*-\n(defun nl_bc_jit_entry (x0) (stringp x0))\n")))))
              ((symbol-function 'nelisp-native-load-artifact)
               (lambda (_artifact name)
                 (should (equal name "nl_bc_jit_entry"))
                 handle))
              ((symbol-function 'nelisp-native-load-call)
               (lambda (actual args)
                 (setq boxed-calls (1+ boxed-calls))
                 (should (eq actual handle))
                 (if (stringp (car args)) t nil))))
      ;; Before preparation, real Lisp behavior remains in the VM.
      (should (eq (funcall function "a") t))
      (should (null (funcall function 17)))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function "a"))
      (should (= compile-calls 0))
      (should-not (nelisp-bytecode-jit-prepare unsupported))
      (should-not (nelisp-bytecode-jit-test--dispatch-prepared unsupported '(a)))
      (should (eq (nelisp-bytecode-jit-prepare function) handle))
      (should (eq (nelisp-bytecode-jit-prepare function) handle))
      (should (= compile-calls 1))
      (should (= nelisp-bytecode-jit--compile-count 1))
      (should (equal (nelisp-bytecode-jit-test--dispatch-prepared function "a")
                     [t t]))
      (should (equal (nelisp-bytecode-jit-test--dispatch-prepared function 17)
                     [t nil]))
      (should (= boxed-calls 2))
      (should (= nelisp-bytecode-jit--native-call-count 2)))))

(ert-deftest nelisp-bytecode-jit/unboxable-object-predicates-fall-back-before-native-call ()
  (let* ((consp-function (byte-compile '(lambda (x) (consp x))))
         (listp-function (byte-compile '(lambda (x) (listp x))))
         (symbolp-function (byte-compile '(lambda (x) (symbolp x))))
         (functions (list consp-function listp-function symbolp-function))
         (nelisp-bytecode-jit--handles (make-hash-table :test 'eq))
