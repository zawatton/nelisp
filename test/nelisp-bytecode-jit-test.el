(ert-deftest nelisp-bytecode-jit/prepare-failure-captures-opt-in-diagnostics ()
  (let* ((diagnostic-dir (make-temp-file "nelisp-jit-diagnostic-test-" t))
         (process-environment (copy-sequence process-environment))
         source artifact manifest)
    (unwind-protect
        (let ((function (byte-compile '(lambda (x) (consp x)))))
          (setenv "NELISP_JIT_DIAGNOSTIC_DIR" diagnostic-dir)
          (cl-letf (((symbol-function 'nelisp-artifact-compile-file)
                     (lambda (src out &rest _args)
                       (setq source src artifact out manifest (concat out ".manifest.el"))
                       (with-temp-file out (insert "artifact"))
                       (with-temp-file manifest
                         (prin1 '( :body-offset 8 :param-repr sexp-ptr
                                   :return-repr raw-bool)
                                (current-buffer)))))
                    ((symbol-function 'nelisp-native-load-artifact)
                     (lambda (&rest _args)
                       (error ":no-body-offset mocked load failure"))))
            (should-error (nelisp-bytecode-jit-prepare function)))
          (should (file-exists-p source))
          (should (file-exists-p artifact))
          (should (file-exists-p manifest))
          (let* ((records (directory-files diagnostic-dir t "^failure-.*\\.el$"))
                 (record (with-temp-buffer
                           (insert-file-contents (car records))
                           (read (current-buffer)))))
            (should (= (length records) 1))
            (should (eq (plist-get record :ir-status) 'valid))
            (should (plist-get record :ir-eligible))
            (should (equal (plist-get record :opcode-bytes) '(58 135)))
            (should (string-match-p ":no-body-offset"
                                    (plist-get record :error)))
