(ert-deftest nelisp-bytecode-jit/decodes-only-complete-unary-return-streams ()
  (let ((add1 (make-byte-code 257 (unibyte-string 84 135) [] 2))
        (sub1 (make-byte-code 257 (unibyte-string 83 135) [] 2))
