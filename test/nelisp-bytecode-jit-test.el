(ert-deftest nelisp-bytecode-jit/vendor-fixnump-opcode-168-ir-and-safe-fallback ()
  (let* ((function
          (make-byte-code
           257 (unibyte-string 137 168 133 14 0 8 1 88 133 14 0
                               137 9 88 135)
           [most-negative-fixnum most-positive-fixnum] 3))
         (code (aref function 1))
         (constants (aref function 2))
         (ir (nelisp-bytecode-jit--decode-ir function))
         (rows (nelisp-bytecode-jit--decode-instructions code constants))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--hot-counts (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--native-call-count 0))
    (should
     (equal (secure-hash 'sha256
                         (prin1-to-string
                          (list (aref function 0) code constants
                                (aref function 3))))
            "102e639e742351efbc457d8517db951ead880750dbc9eb1b96409f5fe063762d"))
    (should (equal (mapcar (lambda (row) (aref row 1)) rows)
                   '(137 168 133 8 1 88 133 137 9 88 135)))
    (should (equal (plist-get ir :expression)
                   '(if (integerp x0)
                        (if (<= most-negative-fixnum x0)
                            (<= x0 most-positive-fixnum)
                          (<= most-negative-fixnum x0))
                      (integerp x0))))
    (dolist (case '((17 . t) (-17 . t) ("text" . nil) (symbol . nil)
                    (nil . nil) ((1+ most-positive-fixnum) . nil)))
      (should (eq (funcall function (car case)) (cdr case))))
    (should (nelisp-bytecode-jit--safe-ir-p ir '(17)))
    (should (nelisp-bytecode-jit--safe-ir-p ir '("text")))
    (should-not (nelisp-bytecode-jit--safe-ir-p ir '(1.5)))
    (should-not (nelisp-bytecode-jit--safe-ir-p
                 ir (list (1+ most-positive-fixnum))))
    (should-not
     (nelisp-bytecode-jit-test--dispatch-prepared
      function (1+ most-positive-fixnum)))
    (should (= nelisp-bytecode-jit--native-call-count 0))))

