         (compile-calls 0))
    (cl-letf (((symbol-function 'nelisp-native-load--running-binary-sha256)
               (lambda () "stable-image"))
              ((symbol-function 'nelisp-bytecode-jit--compile-ir)
               (lambda (_function _ir)
                 (setq compile-calls (1+ compile-calls))
                 (list :entry compile-calls :arity 1 :abi 'integer
                       :param-repr 'raw-i64 :return-repr 'raw-i64)))
              ((symbol-function 'nelisp-bytecode-jit--execute-ir)
               (lambda (_ir handle arguments)
                 (list (plist-get handle :entry) (car arguments)))))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 10))
      (should (nelisp-bytecode-jit--validated-handle-p
               (nelisp-bytecode-jit--decode-ir function)
               (nelisp-bytecode-jit--cache-identity function)
               '(:entry 4096 :arity 1 :abi integer
                 :param-repr raw-i64 :return-repr raw-i64)))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (nelisp-bytecode-jit--ready-handle
               function (nelisp-bytecode-jit--decode-ir function)
               (nelisp-bytecode-jit--cache-identity function)))
      (should (equal (nelisp-bytecode-jit--runtime-dispatch function 11)
                     [t (1 11)]))
      (let ((bytecode (aref function 1)))
        (aset bytecode 0 83))
      (should-not (nelisp-bytecode-jit--runtime-dispatch function 12))
      (should (= (nelisp-bytecode-jit-drain-pending) 1))
      (should (= compile-calls 2))
      (should (equal (nelisp-bytecode-jit--runtime-dispatch function 13)
                     [t (2 13)])))))

