      (should (= nelisp-bytecode-jit--native-call-count 0)))))

(ert-deftest nelisp-bytecode-jit/boxed-predicates-dispatch-safe-symbols-and-lists ()
  (let* ((cases (list (cons 'symbolp
                            (byte-compile '(lambda (x) (symbolp x))))
                      (cons 'consp
                            (byte-compile '(lambda (x) (consp x))))
                      (cons 'listp
                            (byte-compile '(lambda (x) (listp x))))))
         (nelisp-bytecode-jit-threshold 1)
         (nelisp-bytecode-jit--handles (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--hot-counts (make-hash-table :test 'eq))
         (nelisp-bytecode-jit--compile-count 0)
         (nelisp-bytecode-jit--native-call-count 0)
         (native-calls 0)
         current-predicate)
    (cl-letf (((symbol-function 'nelisp-artifact-compile-file)
               (lambda (source _artifact &rest _args)
                 (with-temp-buffer
                   (insert-file-contents source)
                   (goto-char (point-min))
                   (when (re-search-forward "(\\(symbolp\\|consp\\|listp\\) x0)" nil t)
                     (setq current-predicate (intern (match-string 1)))))))
              ((symbol-function 'nelisp-native-load-artifact)
               (lambda (&rest _args)
                 (list :entry 4096 :arity 1 :abi 'boxed
                       :param-repr 'sexp-ptr :return-repr 'raw-bool
                       :predicate current-predicate)))
              ((symbol-function 'nelisp-native-load-call)
               (lambda (handle arguments)
                 (setq native-calls (1+ native-calls))
                 (funcall (plist-get handle :predicate) (car arguments)))))
      (dolist (case cases)
        (let* ((predicate (car case))
               (function (cdr case))
               (argument (if (eq predicate 'symbolp) 'jit-interned '(a b)))
               (vm-value (funcall function argument)))
          (should (nelisp-bytecode-jit-prepare function))
          (should (equal (nelisp-bytecode-jit-test--dispatch-prepared
                          function argument)
                         (vector t vm-value)))
          (should (equal vm-value (funcall function argument)))))
      (should (= native-calls 3))
      (should (= nelisp-bytecode-jit--native-call-count 3))
      (let* ((nested '(a (b c)))
             (consp-nested
              (nelisp-bytecode-jit-test--dispatch-prepared
               (cdr (assq 'consp cases)) nested))
             (listp-nested
              (nelisp-bytecode-jit-test--dispatch-prepared
               (cdr (assq 'listp cases)) nested)))
        (should-not consp-nested)
        (should-not listp-nested)
        (should (= native-calls 3))
        (should (= nelisp-bytecode-jit--native-call-count 3))
        (should (funcall (cdr (assq 'consp cases)) nested))
        (should (funcall (cdr (assq 'listp cases)) nested))
        (should (= native-calls 3))))))

