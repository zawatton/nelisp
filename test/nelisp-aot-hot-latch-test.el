                  (unless (= status 0) (message "Native failure: %s" (buffer-string)))
                  (should (= status 0)))
                (push (buffer-string) outputs))))
          (should (equal (car outputs) (cadr outputs)))
          (should (= (car gauges) 0))
          ;; Semantic and frame/FLAGS checks have already passed on both binaries.
          (princ (format "SEMANTICS on/off fullword/frame/RAX/FLAGS PASS %s" (car outputs)))
          (should (> (cadr gauges) 0)))
      (delete-directory dir t))))
(defun nelisp-aot-hot-latch-test--evidence ()
  (let* ((defs (nelisp-aot-hot-latch-test--defs))
         (owner (cl-find 'loop13 defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name))))
         (node (nelisp-aot-hot-latch-test--loop owner))
         (trace (nelisp-aot-hot-latch-test--plan defs)))
    (list owner node trace)))
(ert-deftest nelisp-aot-hot-latch/finite-bijection-and-private-namespace ()
  (pcase-let* ((`(,owner ,node ,trace) (nelisp-aot-hot-latch-test--evidence))
               (before (secure-hash 'sha256 (prin1-to-string owner)))
               (latch (nelisp-aot-compiler--x86-hot-latch-plan node trace))
               (tail (plist-get latch :tail)) (cold (plist-get latch :cold-tail))
               (copies (plist-get latch :bijection)) (ae (plist-get trace :affine))
               (cold-ae (plist-get latch :cold-affine)))
    (should latch) (should (= 14 (hash-table-count copies)))
    (should (eq (gethash tail copies) cold)) (should-not (eq tail cold))
    (should (> (plist-get latch :work-used) 0)) (should (<= (plist-get latch :work-used) 8192))
    (dolist (key '(:lhs :expression :update :mismatch))
      (should (eq (plist-get cold-ae key) (gethash (plist-get ae key) copies)))
      (should-not (eq (plist-get ae key) (plist-get cold-ae key))))
    (dolist (key '(:base :iv :coefficient :reg)) (should (eql (plist-get ae key) (plist-get cold-ae key))))
    (maphash (lambda (a b)
               (should-not (eq a b))
               (should (= (length a) (length b)))
               (cl-loop for i from 1 below (length a) by 2 do
                        (should (eq (aref a i) (aref b i)))
                        (if (eq (aref a i) :id)
                            (should-not (eq (aref a (1+ i)) (aref b (1+ i))))
                          (should (equal (aref b (1+ i))
                                         (or (gethash (aref a (1+ i)) copies) (aref a (1+ i)))))))) copies)
    (let* ((id (nelisp-aot-compiler--ir-get cold :id))
           (hostile (list (symbol-name id) (concat (symbol-name id) "-else")
                          (concat (symbol-name id) "-end")
                          (symbol-name (plist-get latch :hot-bound))
                          (symbol-name (plist-get latch :cleanup))))
           (fact (copy-sequence (plist-get trace :fact)))
           (other (copy-sequence trace)))
      (setq fact (plist-put fact :unit-names (append hostile (plist-get fact :unit-names))))
      (setq other (plist-put other :fact fact))
      (let* ((q (nelisp-aot-compiler--x86-hot-latch-plan node other))
             (cid (nelisp-aot-compiler--ir-get (plist-get q :cold-tail) :id)))
        (should q)
        (dolist (name (list (symbol-name cid) (concat (symbol-name cid) "-else")
                           (concat (symbol-name cid) "-end")
                           (symbol-name (plist-get q :hot-bound)) (symbol-name (plist-get q :cleanup))))
          (should-not (member name hostile)))))
    (should (equal before (secure-hash 'sha256 (prin1-to-string owner))))
    (should (equal (sort (delete-dups (mapcar #'car (plist-get (plist-get trace :fact) :guarded-body)))
                         (lambda (a b) (string-lessp (symbol-name a) (symbol-name b))))
                   (sort (copy-sequence '(:mov :alu :load :store :cmp :jcc :jmp :label :fallback))
                         (lambda (a b) (string-lessp (symbol-name a) (symbol-name b))))))))
(ert-deftest nelisp-aot-hot-latch/context-metadata-sharing-and-budget-fallbacks ()
  (pcase-let ((`(,_owner ,node ,trace) (nelisp-aot-hot-latch-test--evidence)))
    (dolist (name '(nelisp-aot-compiler--checked-arith nelisp-aot-compiler--runtime-entry-params
                    nelisp-aot-compiler--promoted-slots nelisp-aot-compiler--x86-frame-read-aliases
                    nelisp-aot-compiler--x86-trace-write-through nelisp-aot-compiler--x86-trace-loop-exits
                    nelisp-aot-compiler--x86-shrink-wrap-state nelisp-aot-compiler--x86-leaf-entry-state
                    nelisp-aot-compiler--x86-tco-entry-state nelisp-aot-compiler--x86-index-forward-frame-sensitive-p))
      (cl-progv (list name) (list t) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace))))
    (let ((nelisp-aot-compiler--rsp-temp-depth 1)) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace)))
    (let ((nelisp-aot-compiler--arch 'aarch64)) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace)))
    (let ((nelisp-aot-compiler--abi 'win64)) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace)))
    (let ((nelisp-aot-compiler--x86-hot-latches nil)) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace)))
    (dolist (names (list nil '(bad) (make-list 8193 "public")))
      (let* ((fact (plist-put (copy-sequence (plist-get trace :fact)) :unit-names names))
             (other (plist-put (copy-sequence trace) :fact fact)))
        (should-not (nelisp-aot-compiler--x86-hot-latch-plan node other))))
    (let* ((names (list "public"))
           (fact (plist-put (copy-sequence (plist-get trace :fact)) :unit-names names))
           (other (plist-put (copy-sequence trace) :fact fact)))
      (setcdr names names) (should-not (nelisp-aot-compiler--x86-hot-latch-plan node other))))
  (dolist (change '(guard-value guard-op header-unknown ref-f64 rhs-f64 rhs-unknown shared cycle))
    (pcase-let* ((`(,_owner ,node ,trace) (nelisp-aot-hot-latch-test--evidence))
                (a (plist-get trace :affine)) (expr (plist-get a :expression))
                (mul (nelisp-aot-compiler--ir-get expr :b))
                (guard (nelisp-aot-compiler--ir-get (nelisp-aot-compiler--ir-get node :test) :test)))
      (pcase change
        ('guard-value (nelisp-aot-hot-latch-test--set (nelisp-aot-compiler--ir-get guard :b) :value 2))
        ('guard-op (nelisp-aot-hot-latch-test--set guard :op '>))
        ('header-unknown (aset guard 3 :unknown))
        ('ref-f64 (nelisp-aot-hot-latch-test--set (plist-get a :lhs) :class 'f64))
        ('rhs-f64 (nelisp-aot-hot-latch-test--set expr :repr 'f64))
        ('rhs-unknown (aset expr 3 :unknown))
        ('shared (nelisp-aot-hot-latch-test--set
                  (nelisp-aot-compiler--ir-get (plist-get a :update) :value-ir) :a
                  (nelisp-aot-compiler--ir-get mul :a)))
        ('cycle (nelisp-aot-hot-latch-test--set expr :a expr)))
      (should-not (nelisp-aot-compiler--x86-hot-latch-plan node trace)))))
(defvar nelisp-aot-hot-latch-test--namespace-plans nil)
(defun nelisp-aot-hot-latch-test--namespace-record (old node trace)
  (let ((p (funcall old node trace)))
    (message "Namespace preflight: affine=%s latch=%s" (and (plist-get trace :affine) t) (and p t))
    (when p (setf (alist-get (nelisp-aot-compiler--ir-get node :id)
                            nelisp-aot-hot-latch-test--namespace-plans) p)) p))
(defun nelisp-aot-hot-latch-test--namespace-source (exports &optional direct)
  (let* ((source (copy-tree (nelisp-aot-hot-latch-test--source)))
         (guarded (cl-find 'guarded (cdr source) :key #'cadr))
         (other (copy-tree (cl-find 'loop13 (cdr source) :key #'cadr)))
         (bad '(syscall-direct 60 1 0 0 0 0 0)) (index 0) checks)
    (setcar (cdr other) 'other_loop)
    ;; Keep G enabled: a real post-loop assignment prevents BASE copy alias.
    (dolist (f (list (cl-find 'loop13 (cdr source) :key #'cadr) other))
      (let ((forms (caddr (cadddr f))))
        (setcdr (cdr forms) (cons '(setq base (+ base 0)) (cddr forms)))))
    (setcar (cdddr guarded)
            (cl-subst '(ptr-write-u64 env 0 0) '(ptr-write-u64 env 0 1)
                      (cadddr guarded) :test #'equal))
    (setq source (append source (list other '(defun native_slow (env) 71))))
    (dolist (name exports)
      (push `(if (= ,(if direct (list name 5) `(call-ptr (addr-of ,name) 5)) ,(+ 78 index)) 0 ,bad) checks)
      (setq source (append source (list `(defun ,name (x) (+ x ,(+ 73 index))))))
      (cl-incf index))
    (append source
            (list `(defun _start ()
                     (seq (syscall-direct 9 805306368 8192 3 50 -1 0)
                          ,@(nreverse checks)
                          (ptr-write-u64 805306368 0 0)
                          (ptr-write-u64 805306368 8 132)
                          (ptr-write-u64 805306368 112 0)
                          (if (= (loop13 1 1 100 805306368 4 5 6 7 8 9 10 11 12) 98) 0 ,bad)
                          (ptr-write-u64 805306368 0 0)
                          (ptr-write-u64 805306368 8 132)
                          (if (= (other_loop 1 1 100 805306368 4 5 6 7 8 9 10 11 12) 98) 0 ,bad)
                          (syscall-direct 60 0 0 0 0 0 0)))))))

(defvar nelisp-aot-hot-latch-test--defined-labels nil)
(defun nelisp-aot-hot-latch-test--label-record (_buf name)
  (push name nelisp-aot-hot-latch-test--defined-labels))
(defun nelisp-aot-hot-latch-test--entry-record (old ir buf)
  (prog1 (funcall old ir buf)
    (let ((name (nelisp-aot-compiler--ir-get ir :name)))
      (should (assq name (nelisp-asm-x86_64-buffer-labels buf)))
      (push name nelisp-aot-hot-latch-test--defined-labels))))
(defun nelisp-aot-hot-latch-test--namespace-native-entry (dir exports)
  ;; Independent GNU entry tests the generated object's genuine ABI exports.
  ;; The compiler-generated executable driver has a separately recorded
  ;; baseline SIGSEGV; it is not used as a runtime acceptance fixture here.
  (let ((asm (expand-file-name "entry.s" dir)) (obj (expand-file-name "entry.o" dir))
        (index 0))
    (with-temp-file asm
      (insert ".text\n.globl ai_namespace_native_entry\nai_namespace_native_entry:\n"
              "mov $9,%rax\nmov $805306368,%rdi\nmov $8192,%rsi\nmov $3,%rdx\nmov $50,%r10\nmov $-1,%r8\nxor %r9,%r9\nsyscall\n")
      (dolist (name exports)
        (insert (format "mov $5,%%rdi\ncall \"%s\"\ncmp $%d,%%rax\njne ai_namespace_fail\n"
                        name (+ 78 index)))
        (cl-incf index))
      (dolist (owner '(loop13 other_loop))
        (insert "movq $0,805306368\nmovq $132,805306376\nmovq $0,805306480\n"
                "sub $8,%rsp\npush $12\npush $11\npush $10\npush $9\npush $8\npush $7\npush $6\n"
                "mov $1,%rdi\nmov $1,%rsi\nmov $100,%rdx\nmov $805306368,%rcx\nmov $4,%r8\nmov $5,%r9\n"
                (format "call \"%s\"\n" owner)
                "add $64,%rsp\ncmp $98,%rax\njne ai_namespace_fail\n"))
      (insert "xor %rdi,%rdi\njmp ai_namespace_exit\nai_namespace_fail:\nmov $1,%rdi\nai_namespace_exit:\nmov $60,%rax\nsyscall\n.section .note.GNU-stack,\"\",@progbits\n"))
    (should (= 0 (call-process "as" nil nil nil "--64" "-o" obj asm))) obj))
(defun nelisp-aot-hot-latch-test--compile-namespace (mode source exe object)
  (pcase mode
    ('unit (let ((unit (nelisp-standalone--compile-to-unit "hot-latch-unit" source)))
             (nelisp-link-units exe (list unit) "_start")))
    ('object (nelisp-aot-compile-to-object source object))
    ('executable
     ;; Actual executable frontend emission/inventory is checked independently
     ;; of its baseline-failing compiler-generated public-call driver.
     (let ((entry (cl-find '_start (cdr source) :key #'cadr)))
       (nelisp-aot-compile-sexp
        (append (list 'seq) (cl-remove entry (cdr source) :test #'eq)
                (list (cadddr entry))) exe)))))
(defun nelisp-aot-hot-latch-test--namespace-unsafe (old node trace)
  ;; Deliberately broken private-name policy: restore the original first
  ;; unchecked candidates.  Derived control labels then alias public names.
  (let ((p (funcall old node trace)))
    (when p
      (let ((base (format "trace-%s-" (nelisp-aot-compiler--ir-get node :id))))
        (nelisp-aot-hot-latch-test--set (plist-get p :cold-tail) :id
                                       (make-symbol (concat base "hot-latch-cold1")))
        (setq p (plist-put p :hot-bound (make-symbol (concat base "hot-latch-bound2"))))
        (setq p (plist-put p :cleanup (make-symbol (concat base "hot-latch-cleanup3")))))) p))
(defvar nelisp-aot-hot-latch-test--namespace-modes '(object executable unit))
(ert-deftest nelisp-aot-hot-latch/two-owner-three-frontend-derived-public-collisions ()
  (require 'nelisp-standalone-build)
  (let* ((dir (make-temp-file "hot-latch-namespace-" t))
         (exe (expand-file-name "p" dir)) (object (expand-file-name "p.o" dir))
         (nelisp-standalone--target 'linux-x86_64)
         (nelisp-aot-compiler--object-hidden-boundary-symbols nil)
         (nelisp-aot-compiler--allow-external-user-calls t)
         (nelisp-aot-compiler--x86-trivial-call-folding nil)
         (nelisp-aot-compiler--x86-partial-call-folding nil)
         (placeholders (cl-loop for n below 10 collect (intern (format "ai_namespace_public_%d" n)))))
    (unwind-protect
        (progn
          (advice-add 'nelisp-aot-compiler--x86-hot-latch-plan :around #'nelisp-aot-hot-latch-test--namespace-record)
          (advice-add 'nelisp-aot-compiler--emit-defun :around #'nelisp-aot-hot-latch-test--entry-record)
          (advice-add 'nelisp-asm-x86_64-define-label :before #'nelisp-aot-hot-latch-test--label-record)
          (advice-add 'nelisp-asm-x86_64--define-label-inline :before #'nelisp-aot-hot-latch-test--label-record)
          (dolist (mode nelisp-aot-hot-latch-test--namespace-modes)
            (let ((nelisp-aot-hot-latch-test--namespace-plans nil)
                  (nelisp-aot-hot-latch-test--defined-labels nil))
              ;; The same number of source IFs preserves original control IDs.
              (nelisp-aot-hot-latch-test--compile-namespace
               mode (nelisp-aot-hot-latch-test--namespace-source placeholders) exe object)
              (should (= 2 (length nelisp-aot-hot-latch-test--namespace-plans)))
              (let ((ids (mapcar #'car nelisp-aot-hot-latch-test--namespace-plans)) exports)
                (dolist (entry nelisp-aot-hot-latch-test--namespace-plans)
                  (let* ((p (cdr entry)) (id (nelisp-aot-compiler--ir-get (plist-get p :cold-tail) :id)))
                    (setq exports (append exports (list (intern (symbol-name id)) (intern (concat (symbol-name id) "-else"))
                                                         (intern (concat (symbol-name id) "-end"))
                                                         (intern (symbol-name (plist-get p :hot-bound)))
                                                         (intern (symbol-name (plist-get p :cleanup))))))))
                (setq nelisp-aot-hot-latch-test--namespace-plans nil
                      nelisp-aot-hot-latch-test--defined-labels nil)
                (let* ((source (nelisp-aot-hot-latch-test--namespace-source exports))
                       (source-hash (secure-hash 'sha256 (prin1-to-string source))))
                  (nelisp-aot-hot-latch-test--compile-namespace mode source exe object)
                  (should (equal source-hash (secure-hash 'sha256 (prin1-to-string source))))
                  (should (equal ids (mapcar #'car nelisp-aot-hot-latch-test--namespace-plans)))
                  (dolist (name (append exports '(loop13 other_loop)))
                    (should (memq name nelisp-aot-hot-latch-test--defined-labels)))
                  (dolist (entry nelisp-aot-hot-latch-test--namespace-plans)
                    (let* ((p (cdr entry)) (id (nelisp-aot-compiler--ir-get (plist-get p :cold-tail) :id)))
                      (dolist (name (list (symbol-name id) (concat (symbol-name id) "-else")
                                         (concat (symbol-name id) "-end")
                                         (symbol-name (plist-get p :hot-bound)) (symbol-name (plist-get p :cleanup))))
                        (should-not (member name (mapcar #'symbol-name exports))))))
                  (when (eq mode 'object)
                    (let ((entry (nelisp-aot-hot-latch-test--namespace-native-entry dir exports)))
                      (dolist (enabled '(nil t))
                        (let ((nelisp-aot-compiler--x86-hot-latches enabled))
                          (nelisp-aot-compile-to-object source object))
                        (should (= 0 (call-process "ld" nil nil nil "-e" "ai_namespace_native_entry" "-o" exe entry object)))
                        (should (= 0 (call-process exe nil nil nil))))
                      (message "AI namespace GNU entry: both semantic runs PASS before gauge"))
                    ;; Broken printed-name protection must genuinely fail.
                    (advice-add 'nelisp-aot-compiler--x86-hot-latch-plan :around #'nelisp-aot-hot-latch-test--namespace-unsafe)
                    (unwind-protect
                        (should-error (nelisp-aot-compile-to-object source object) :type 'nelisp-asm-x86_64-error)
                      (advice-remove 'nelisp-aot-compiler--x86-hot-latch-plan #'nelisp-aot-hot-latch-test--namespace-unsafe)))))))
          (message "AI two owners: object/GNUld runtime + all3 frontend public/derived inventory PASS"))
      (advice-remove 'nelisp-aot-compiler--x86-hot-latch-plan #'nelisp-aot-hot-latch-test--namespace-record)
      (advice-remove 'nelisp-aot-compiler--emit-defun #'nelisp-aot-hot-latch-test--entry-record)
      (advice-remove 'nelisp-asm-x86_64-define-label #'nelisp-aot-hot-latch-test--label-record)
      (advice-remove 'nelisp-asm-x86_64--define-label-inline #'nelisp-aot-hot-latch-test--label-record)
      (delete-directory dir t))))
(provide 'nelisp-aot-hot-latch-test)
