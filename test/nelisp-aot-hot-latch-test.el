         (owner (cl-find 'loop13 defs :key (lambda(d)(nelisp-aot-compiler--ir-get d :name))))
         slots outputs gauges)
    (nelisp-aot-compiler--walk-ir owner
     (lambda(n)(when (eq (aref n 0) 'let-rt)
                 (push (cons (nelisp-aot-compiler--ir-get n :var) (nelisp-aot-compiler--ir-get n :slot)) slots))))
