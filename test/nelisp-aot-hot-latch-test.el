;;; nelisp-aot-hot-latch-test.el --- Closed modulo64 recurrence -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defvar nelisp-aot-hot-latch-test--enabled t)
(defvar nelisp-aot-hot-latch-test--plans nil)
(defun nelisp-aot-hot-latch-test--source ()
  '(seq
    (defun slow (env) (extern-call native_slow env))
    (defun guarded (env)
      (let ((entry (if (= (ptr-read-u64 805306368 0) 0) 0 (slow env))))
        (if (= entry 0)
            (let ((v (ptr-read-u64 env 8)))
              (seq (ptr-write-u64 env 0 1)
                   (ptr-write-u64 env 8 (+ v 32))
                   (logxor v (ptr-read-u64 env 112))))
          entry)))
    (defun loop13 (start n basein env p4 p5 p6 p7 p8 p9 p10 p11 p12)
      (let* ((base basein) (i start) (valid n))
        (seq
         (while (if (= valid 1) (< i 7) 0)
           (let ((result (guarded env)))
             (if (= result (+ base (* i 32)))
                 (setq i (+ i 1))
               (setq valid 0))))
         (ptr-write-u64 env 16 i)
         (ptr-write-u64 env 24 base)
         (ptr-write-u64 env 32 valid)
         (logxor (logxor i base) valid))))
    (defun wordtag (w)
      (if (= (logand w 7) 2) 7
        (if (= (logand w 7) 6) (logand (ptr-read-u8 (- w 6) 0) 63)
          (ptr-read-u8 w 0))))))
(defun nelisp-aot-hot-latch-test--defs ()
  (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
        (nelisp-aot-compiler--allow-external-user-calls t))
    (nelisp-aot-compiler--collect-defuns
     (nelisp-aot-compiler--parse (nelisp-aot-hot-latch-test--source)))))
(defun nelisp-aot-hot-latch-test--loop (owner)
  (let (loop)
    (nelisp-aot-compiler--walk-ir owner (lambda (n) (when (eq (aref n 0) 'while) (setq loop n)))) loop))
(defun nelisp-aot-hot-latch-test--plan (defs &optional pool)
  (let* ((owner (cl-find 'loop13 defs :key (lambda (d) (nelisp-aot-compiler--ir-get d :name))))
         (nelisp-aot-compiler--x86-trace-loop-owner owner)
         (nelisp-aot-compiler--x86-trace-unit-names (mapcar (lambda (d) (symbol-name (nelisp-aot-compiler--ir-get d :name))) defs))
         (nelisp-aot-compiler--x86-guarded-body-facts (nelisp-aot-compiler--x86-guarded-body-facts defs))
         (nelisp-aot-compiler--rsp-temp-depth 0)
         (nelisp-aot-compiler--x86-loop-regs (or pool '(rbx r8 r9 r12 r13 r14 r15))))
    (nelisp-aot-compiler--x86-deferred-loop-plan (nelisp-aot-hot-latch-test--loop owner))))
(defun nelisp-aot-hot-latch-test--set (node key value)
  (aset node (1+ (cl-position key (append node nil))) value))
(defvar nelisp-aot-hot-latch-test--edges nil)
(defvar nelisp-aot-hot-latch-test--cleanup-slots nil)
(defun nelisp-aot-hot-latch-test--record (old node trace)
  (let ((plan (funcall old node trace)))
    (message "Latch preflight: affine=%s selected=%s" (and (plist-get trace :affine) t) (and plan t))
    (setq nelisp-aot-hot-latch-test--cleanup-slots (mapcar #'car (car (plist-get trace :plan))))
    (push (and plan t) nelisp-aot-hot-latch-test--plans) plan))
(defun nelisp-aot-hot-latch-test--snapshot (buf rax-address flags-address)
  (nelisp-aot-compiler--x86-op buf t (unibyte-string #x89) 'rax (list :mem nil nil 1 rax-address))
  (nelisp-asm-x86_64-emit-bytes buf (unibyte-string #x9C))
  (nelisp-aot-compiler--x86-op buf t (unibyte-string #x8F) 0 (list :mem nil nil 1 flags-address)))
(defun nelisp-aot-hot-latch-test--before (node buf)
  (let ((a nelisp-aot-compiler--x86-affine-loop-state))
    (when (or (eq node (plist-get a :update)) (eq node (plist-get a :mismatch)))
      (nelisp-aot-hot-latch-test--snapshot buf 805306408 805306416))))
(defun nelisp-aot-hot-latch-test--after (node buf)
  (when (eq node (plist-get nelisp-aot-compiler--x86-affine-loop-state :update))
    (nelisp-aot-hot-latch-test--snapshot buf 805306440 805306448)))
(defun nelisp-aot-hot-latch-test--cleanup (pairs _written _saved buf &rest _)
  (when (and pairs (equal (mapcar #'car pairs) nelisp-aot-hot-latch-test--cleanup-slots))
    (nelisp-aot-hot-latch-test--snapshot buf 805310560 805310568)))
