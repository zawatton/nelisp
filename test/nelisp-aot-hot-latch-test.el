          (dolist (disabled '(nil t))
            (let ((nelisp-aot-compiler--object-hidden-boundary-symbols nil)
                  (nelisp-aot-compiler--allow-external-user-calls t)
                  (nelisp-aot-compiler--x86-hot-latches (and nelisp-aot-hot-latch-test--enabled (not disabled)))
                  (nelisp-aot-hot-latch-test--plans nil)
                  (nelisp-aot-hot-latch-test--edges nil))
              (advice-add 'nelisp-aot-compiler--x86-hot-latch-plan :around #'nelisp-aot-hot-latch-test--record)
              (advice-add 'nelisp-aot-compiler--emit-effect-unpromoted :before #'nelisp-aot-hot-latch-test--before)
              (advice-add 'nelisp-aot-compiler--emit-promotion-cleanup-x86 :before #'nelisp-aot-hot-latch-test--cleanup)
              (advice-add 'nelisp-aot-compiler--emit-effect :after #'nelisp-aot-hot-latch-test--after)
              (unwind-protect (nelisp-aot-compile-to-object (nelisp-aot-hot-latch-test--source) o)
                (advice-remove 'nelisp-aot-compiler--x86-hot-latch-plan #'nelisp-aot-hot-latch-test--record)
                (advice-remove 'nelisp-aot-compiler--emit-effect-unpromoted #'nelisp-aot-hot-latch-test--before)
                (advice-remove 'nelisp-aot-compiler--emit-promotion-cleanup-x86 #'nelisp-aot-hot-latch-test--cleanup)
                (advice-remove 'nelisp-aot-compiler--emit-effect #'nelisp-aot-hot-latch-test--after))
              (push (cl-count t nelisp-aot-hot-latch-test--plans) gauges)
