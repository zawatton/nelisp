;;; nelisp-typed-save-restore-one-test.el --- Genuine restore factoring -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'nelisp-bytecode-stackset-fast-test)
(defconst tsr--root (file-name-directory (directory-file-name (file-name-directory load-file-name))))
(defun tsr--old ()
  (with-temp-buffer
    (insert-file-contents (expand-file-name "target/typed-save/restore-one/builder-before.el" tsr--root))
    (goto-char (point-min)) (search-forward "(defun nl_sb_restore_list ")
    (goto-char (match-beginning 0)) (read (current-buffer))))
(defun tsr--form (name)
  (or (cl-find-if (lambda (f) (eq (cadr f) name)) (cdr nelisp-standalone--n4-source))
      (error "Missing actual production helper %s" name)))
(defun tsr--run (data &optional old failure direct mutant)
  (let ((objects (make-hash-table :test #'eql)) (next 10000) trace stashed saved)
    (cl-labels ((word (x) (if (or (vectorp x) (consp x))
                             (let ((p (cl-incf next 8)))
                               (puthash p (if (vectorp x) x (cons (word (car x)) (word (cdr x)))) objects) p)
                           x))
                (tag (w) (let ((x (gethash w objects))) (cond ((vectorp x) 8) ((consp x) 7) (t 2)))))
      (let ((input (word data)))
        (cl-letf (((symbol-function 'sexp-tag) #'tag)
                  ((symbol-function 'nl_cons_car_word) (lambda (p) (car (gethash p objects))))
                  ((symbol-function 'nl_cons_cdr_word) (lambda (p) (cdr (gethash p objects))))
                  ((symbol-function 'vector-ref-ptr) (lambda (p n) (list :slot p n)))
                  ((symbol-function 'nl_vector_slot_word) (lambda (p n) (aref (gethash p objects) n)))
                  ((symbol-function 'nl_sb_set)
                   (lambda (env slot value)
                     (let ((name (aref (gethash (nth 1 slot) objects) (nth 2 slot))))
                       (push (list env name value) trace)
                       (if (member (length trace) failure) (progn (setq stashed t) 1) 0)))))
          (unwind-protect
              (progn
                (dolist (n (if old '(nl_sb_restore_list) '(nl_sb_restore_one nl_sb_restore_list)))
                  (push (cons n (and (fboundp n) (symbol-function n))) saved)
                  (let ((f (copy-tree (if old (tsr--old) (tsr--form n)))))
                    (when (and mutant (eq n 'nl_sb_restore_one))
                      (setq f (cl-subst (if (eq mutant 'name) '(vector-ref-ptr item 1)
                                         '(nl_vector_slot_word item 0))
                                       (if (eq mutant 'name) '(vector-ref-ptr item 0)
                                         '(nl_vector_slot_word item 1)) f :test #'equal)))
                    (when (and (eq mutant 'order) (eq n 'nl_sb_restore_list))
                      (let ((body (sst--find f (lambda (x) (and (consp x) (eq (car x) 'seq))))))
                        (setcdr body (reverse (cdr body)))))
                    (fset n (eval (cons 'lambda (cddr (sst--host-form f))) t))))
                (list (if direct (nl_sb_restore_one 100 input) (nl_sb_restore_list 100 input))
                      (nreverse trace) stashed))
            (dolist (s saved) (if (cdr s) (fset (car s) (cdr s)) (fmakunbound (car s))))))))))
(defconst tsr--cases
  '((nil 3 nil) (immediate 9 nil) (nonlist [101 7] nil)
    (nil-item (3 . 3) nil) (immediate-item (9 . 3) nil)
    (nonvector-item ((77 . 3) . 3) nil)
    (one ([101 7] . 3) nil) (oldnil ([101 3] . 3) nil)
    (oldimmediate ([101 9] . 3) nil)
    (multiple ([101 7] [102 11] . 3) nil)
    (mixed (3 [101 7] 9 [102 11] . 3) nil)
    (failure-first ([101 7] [102 11] . 3) (1))
    (failure-last ([101 7] [102 11] . 3) (2))))
(ert-deftest tsr-genuine-old-new-list ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/restore-one/builder-before.el" tsr--root)))
  (dolist (c tsr--cases)
    (pcase-let ((`(,id ,data ,failure) c))
      (ert-info ((format "%s" id))
        (let ((old (tsr--run data t failure)) (new (tsr--run data nil failure)))
          (should (equal old new)) (should (= (car new) 0)))))))
(ert-deftest tsr-direct-vector-does-not-rebuild-list ()
  (should (equal (tsr--run [101 3] nil nil t) '(0 ((100 101 3)) nil)))
  (should (equal (tsr--run [101 9] nil '(1) t) '(1 ((100 101 9)) t)))
  (dolist (item '(3 9 (77 . 3))) (should (equal (tsr--run item nil nil t) '(0 nil nil))))
  (dolist (sym '(cons-make-with-clone nelisp_cons_construct wf_bytecode_w_cons2 alloc-bytes))
    (should-not (sst--find (tsr--form 'nl_sb_restore_one) (lambda (x) (eq x sym))))))
(ert-deftest tsr-actual-slot-name-order-mutants-reject ()
  (skip-unless (file-exists-p (expand-file-name "target/typed-save/restore-one/builder-before.el" tsr--root)))
  (let* ((data '([101 7] [102 11] . 3)) (expected (tsr--run data t)))
    (should (equal expected (tsr--run data)))
    (dolist (mutant '(name value order))
      (should-error (should (equal expected (tsr--run data nil nil nil mutant)))
                    :type 'ert-test-failed))))
(provide 'nelisp-typed-save-restore-one-test)
