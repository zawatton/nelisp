;;; nelisp-aot-terminal-caller-test.el --- Caller regs before barriers -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'ert)
(require 'cl-lib)
(require 'nelisp-aot-compiler)
(defun nelisp-aot-terminal-caller-test--imm (n) (nelisp-aot-compiler--make-ir 'imm :value n))
(defun nelisp-aot-terminal-caller-test--ref (n) (nelisp-aot-compiler--make-ir 'ref :slot n :class 'gp))
(defun nelisp-aot-terminal-caller-test--op (op a b) (nelisp-aot-compiler--make-ir 'arith :op op :a a :b b))
(defun nelisp-aot-terminal-caller-test--wrap (n)
  (let ((v (logand n (1- (ash 1 64))))) (if (>= v (ash 1 63)) (- v (ash 1 64)) v)))
(defun nelisp-aot-terminal-caller-test--run (program)
  (let ((p (make-temp-file "terminal-caller-")))
    (unwind-protect
        (progn (nelisp-aot-compile-sexp program p) (call-process p nil nil nil))
      (delete-file p))))
(ert-deftest nelisp-aot-terminal-caller/closed-preflight ()
  (let* ((nelisp-aot-compiler--arch 'x86_64) (nelisp-aot-compiler--abi 'sysv)
         (nelisp-aot-compiler--os 'linux) (nelisp-aot-compiler--checked-arith nil)
         (nelisp-aot-compiler--runtime-entry-params nil)
         (nelisp-aot-compiler--native-emit-enabled nil)
         (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p nil)
         (p (nelisp-aot-terminal-caller-test--ref 0))
         (a (nelisp-aot-terminal-caller-test--ref 3))
         (zero (nelisp-aot-terminal-caller-test--imm 0))
         (barrier (nelisp-aot-compiler--make-ir 'call :name 'slow :args (list p a)))
         (store (nelisp-aot-compiler--make-ir 'ptr-write-u64 :ptr p :offset zero :val a))
         (state (list :promotions '((0 . rbx) (1 . r8) (2 . r9) (3 . r12) (4 . r13))
                      :forward '((0 0 rdi) (3 3 rcx)) :terminal-barriers (list barrier) :gain 9))
         (body (nelisp-aot-compiler--make-ir 'value-seq :forms (list store barrier)))
         (ir (nelisp-aot-compiler--make-ir 'defun :name 'probe :body body)))
    (let ((new (nelisp-aot-compiler--x86-terminal-caller-plan ir state)))
      (should (equal '(rbx r8 r9 rdx rcx) (mapcar #'cdr (plist-get new :promotions))))
      (should (equal (mapcar #'car (plist-get state :promotions))
                     (mapcar #'car (plist-get new :promotions))))
      (should (equal (plist-get state :forward) (plist-get new :forward)))
      (should (equal (plist-get state :terminal-barriers) (plist-get new :terminal-barriers)))
      (should (equal '(rbx r8 r9 r12 r13) (mapcar #'cdr (plist-get state :promotions)))))
    (let* ((cmp (nelisp-aot-compiler--make-ir 'cmp :op '< :a p :b a))
           (value-if (nelisp-aot-compiler--make-ir 'if :id 'v :test cmp :then p :else a))
           (var-shift (nelisp-aot-compiler--make-ir 'shift :op 'shl :a p :b a))
           (general-store (nelisp-aot-compiler--ir-with
                           (nelisp-aot-compiler--ir-with store :offset
                            (nelisp-aot-terminal-caller-test--op '* a a))
                           :val (nelisp-aot-terminal-caller-test--op '+ p a))))
      (dolist (bad (list (nelisp-aot-terminal-caller-test--op '/ p a)
                         (nelisp-aot-terminal-caller-test--op '% p a) var-shift
                         (nelisp-aot-compiler--make-ir 'sexp-tag :arg p)
                         (nelisp-aot-compiler--make-ir 'sexp-int-unwrap :arg p)
                         (nelisp-aot-compiler--make-ir 'call :name 'early :args nil)
                         (nelisp-aot-compiler--make-ir 'addr-of :name 'observer)
                         (nelisp-aot-compiler--ir-with store :val (nelisp-aot-terminal-caller-test--ref 99))
                         general-store
                         (nelisp-aot-compiler--make-ir 'let-rt :slot 8 :value-ir value-if :body p)
                         (nelisp-aot-terminal-caller-test--op '+ cmp p)
                         (nelisp-aot-compiler--make-ir 'logic :op 'and :forms (list var-shift))
                         (nelisp-aot-compiler--make-ir 'while
                          :test (nelisp-aot-compiler--make-ir 'cmp :op '=
                                 :a (nelisp-aot-terminal-caller-test--op 'logand p (nelisp-aot-terminal-caller-test--imm 7))
                                 :b (nelisp-aot-terminal-caller-test--imm 6)) :body nil)
                         (nelisp-aot-compiler--ir-with p :class 'f64)
                         (nelisp-aot-compiler--ir-with p :root-p t)))
        (let* ((badbody (nelisp-aot-compiler--make-ir 'value-seq :forms (list bad barrier)))
               (badir (nelisp-aot-compiler--ir-with ir :body badbody)))
          (should (eq state (nelisp-aot-compiler--x86-terminal-caller-plan badir state)))))
      ;; This conditional value is in test position, so it uses direct jumps.
      (let ((branch (nelisp-aot-compiler--make-ir 'if :id 'b :test cmp :then zero :else cmp)))
        (should (nelisp-aot-compiler--x86-terminal-caller-body-p
                 (nelisp-aot-compiler--make-ir 'if :id 'outer :test branch :then p :else barrier)
                 (list barrier) '((0 . rbx) (3 . rdx))))))
    (dolist (mode '(checked lisp frame win64))
      (let ((nelisp-aot-compiler--checked-arith (eq mode 'checked))
            (nelisp-aot-compiler--runtime-entry-params (and (eq mode 'lisp) '(x)))
            (nelisp-aot-compiler--x86-index-forward-frame-sensitive-p (eq mode 'frame))
            (nelisp-aot-compiler--abi (if (eq mode 'win64) 'win64 'sysv)))
        (should (eq state (nelisp-aot-compiler--x86-terminal-caller-plan ir state)))))
    (let ((nelisp-aot-compiler--native-emit-enabled t))
      (cl-letf (((symbol-function 'nl-jit-call-out-2) #'ignore))
        (should (eq state (nelisp-aot-compiler--x86-terminal-caller-plan ir state)))))))
(defconst nelisp-aot-terminal-caller-test--repetitions '(16 14 4 8 12 4))
(defun nelisp-aot-terminal-caller-test--target ()
  `(defun target (a b c d e f)
     (setq c (+ c 1)) (setq d (+ d 2))
     (if (> f 0) (extern-call slow a b c d e f)
       (+ ,@(cl-mapcan (lambda (v n) (make-list n v))
                       '(a b c d e f) nelisp-aot-terminal-caller-test--repetitions)))))
(defun nelisp-aot-terminal-caller-test--golden (values)
  (let ((v (copy-sequence values)))
    (setf (nth 2 v) (+ (nth 2 v) 1) (nth 3 v) (+ (nth 3 v) 2))
    (nelisp-aot-terminal-caller-test--wrap
     (cl-loop for x in v for k in (if (> (nth 5 v) 0) '(1 3 5 7 9 11)
                                   nelisp-aot-terminal-caller-test--repetitions)
              sum (* x k)))))
(defvar nelisp-aot-terminal-caller-test--plans nil)
(defun nelisp-aot-terminal-caller-test--record (fn ir)
  (let ((state (funcall fn ir)))
    (when (eq (nelisp-aot-compiler--ir-get ir :name) 'target)
      (push (plist-get state :promotions) nelisp-aot-terminal-caller-test--plans)) state))
(ert-deftest nelisp-aot-terminal-caller/native-callee-saves-and-abi-cycle ()
  (skip-unless (and (executable-find "gcc-14") (eq system-type 'gnu/linux)))
  (let* ((dir (make-temp-file "terminal-caller-abi-" t))
         (c (expand-file-name "caller.c" dir)) (obj (expand-file-name "caller.o" dir))
         (target (expand-file-name "target.o" dir)) (bin (expand-file-name "probe" dir))
         (nelisp-aot-terminal-caller-test--plans nil)
         (cases '((3 5 7 11 13 -1) (3 5 7 11 13 1)
                  (-3 -5 -7 -11 -13 -1) (-3 -5 -7 -11 -13 1)
                  (1099511627783 -17179869193 4294967295 -7 281474976710655 -1)
                  (1099511627783 -17179869193 4294967295 -7 281474976710655 1)
                  (9223372036854775807 -9223372036854775808 9223372036854775807 -9223372036854775808 -1 -1)
                  (9223372036854775807 -9223372036854775808 9223372036854775807 -9223372036854775808 -1 1))))
    (unwind-protect
        (progn
          (with-temp-file c
            (insert "#include <stdint.h>\ntypedef uint64_t U;typedef int64_t I;\nextern U target(I,I,I,I,I,I);\n")
            (insert "__attribute__((noinline)) U slow(U a,U b,U c,U d,U e,U f){if((uintptr_t)__builtin_frame_address(0)&15)__builtin_trap();U r=a+3*b+5*c+7*d+9*e+11*f;__asm__ volatile(\"mov $13,%%rdx;mov $17,%%rcx\"::: \"rdx\",\"rcx\");return r;}\n")
            (insert "__asm__(\".text\\n.globl _start\\n_start:\\ncall run\\nmov %rax,%rdi\\nmov $60,%eax\\nsyscall\\n\");\n")
            (insert "U verify(I *v,U expected){register U b __asm__(\"rbx\")=101;register U x12 __asm__(\"r12\")=103;register U x13 __asm__(\"r13\")=107;register U x14 __asm__(\"r14\")=109;register U x15 __asm__(\"r15\")=113;\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));U result=target(v[0],v[1],v[2],v[3],v[4],v[5]);\n")
            (insert "__asm__ volatile(\"\":\"+r\"(b),\"+r\"(x12),\"+r\"(x13),\"+r\"(x14),\"+r\"(x15));return result!=expected||b!=101||x12!=103||x13!=107||x14!=109||x15!=113;}\nU run(void){U fail=0;\n")
            (dolist (values cases)
              (insert (format "{I v[]={%s};fail|=verify(v,UINT64_C(%d));}\n"
                              (mapconcat (lambda (v) (format "(I)UINT64_C(%d)" (logand v (1- (ash 1 64))))) values ",")
                              (logand (nelisp-aot-terminal-caller-test--golden values) (1- (ash 1 64))))))
            (insert "return fail;}\n"))
          (should (= 0 (call-process "gcc-14" nil nil nil "-O2" "-fno-omit-frame-pointer" "-fno-stack-protector" "-fno-pie" "-c" c "-o" obj)))
          (advice-add 'nelisp-aot-compiler--x86-terminal-entry-plan :around #'nelisp-aot-terminal-caller-test--record)
          (nelisp-aot-compile-to-object `(seq ,(nelisp-aot-terminal-caller-test--target)) target)
          (should (= 0 (call-process "gcc-14" nil nil nil "-nostdlib" "-no-pie" obj target "-o" bin)))
          (should (= 0 (call-process bin nil nil nil)))
          (should (eq 'rdx (cdr (assq 3 (car nelisp-aot-terminal-caller-test--plans)))))
          (should (eq 'rcx (cdr (assq 2 (car nelisp-aot-terminal-caller-test--plans)))))
          (message "Terminal caller:8 GNU fullword fast/cold cases; ABI RCX/RDX cycle, RBX/R12-R15 preserved"))
      (advice-remove 'nelisp-aot-compiler--x86-terminal-entry-plan #'nelisp-aot-terminal-caller-test--record)
      (delete-directory dir t))))
(ert-deftest nelisp-aot-terminal-caller/word-control-retains-ordinary-map ()
  (should (= 0 (nelisp-aot-terminal-caller-test--run
                 '(seq (defun finish (kind a b c d e) (+ kind a b c d e))
                       (defun guarded (w a b c d e)
                         (let ((kind (if (= (logand w 7) 2) 7
                                       (if (= (logand w 7) 6)
                                           (logand (ptr-read-u8 (- w 6) 0) 63) 0))))
                           (finish kind (+ a a a a) (+ b b b b)
                                   (+ c c c c) (+ d d d d) (+ e e e e))))
                       (defun run ()
                         (let ((p (syscall-direct 9 0 4096 3 34 -1 0)))
                           (ptr-write-u8 p 0 141)
                           (if (= (+ (guarded 2 1 2 3 4 5) (guarded 3 1 2 3 4 5)
                                     (guarded (+ p 6) 1 2 3 4 5)) 200) 0 1)))
                       (exit (run)))))))
(provide 'nelisp-aot-terminal-caller-test)
