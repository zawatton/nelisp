;;; standalone-cl-struct-gv.el --- General record accessor GV regression -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'gv)
(cl-defstruct nelisp-gv-parent first second)
(cl-defstruct (nelisp-gv-child (:include nelisp-gv-parent)) third)
(let ((object (make-nelisp-gv-child :first 1 :second 2 :third 3))
      (rhs-count 0) (place-count 0) order)
  (setf (nelisp-gv-parent-second
         (progn (setq place-count (1+ place-count))
                (push 'place order) object))
        (progn (setq rhs-count (1+ rhs-count)) (push 'rhs order) 42))
  (unless (and (= rhs-count 1) (= place-count 1)
               (equal (reverse order) '(place rhs))
               (= (nelisp-gv-parent-first object) 1)
               (= (nelisp-gv-parent-second object) 42)
               (= (nelisp-gv-child-third object) 3))
    (error "Inherited record slot or setter evaluation mismatch"))
  (setf (nelisp-gv-parent-first object) nil)
  (cl-pushnew 7 (nelisp-gv-parent-first object))
  (unless (equal (nelisp-gv-parent-first object) '(7))
    (error "Generalized accessor cl-pushnew mismatch")))
(princ "GENERAL-STRUCT-GV-PASS\n")
