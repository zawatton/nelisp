;; applyfn2 GNU-parity corpus (wordroute rows plus apply/funcall rows below): the builtins that got generated argv word entries, called from
;; compiled source (fx), through funcall and apply, with wrong argument counts, wrong types
;; (the first bad argument named), &rest edge cases, fset redefinition and advice.  Each row
;; prints NAME => RESULT; run on GNU Emacs 31.1 -Q --batch and on NeLisp, then compare.
(defun wr-norm (x)
  (cond ((subrp x) (list 'subr))
        ((and (consp x) (not (proper-list-p x))) (cons (wr-norm (car x)) (wr-norm (cdr x))))
        ((consp x) (mapcar #'wr-norm x))
        (t x)))
(defmacro wr-row (name form)
  `(princ (format "%s => %S\n" ,name
                  (condition-case err (wr-norm ,form) (error (list 'ERR (car err) (wr-norm (cdr err))))))))
