                                  (and (/= op 48)
                                       (list depth (cdr (assq pc (plist-get certificate :frame-immediates)))))))
            ('constant (copy-slot (+ (plist-get certificate :constant-base) arg) after))
            ('copy (copy-slot (- depth arg) after))
            ((or 'varref 'varset)
             (call (cdr (assq (if (eq kind 'varset) 'set 'symbol-value)
                              (plist-get certificate :provider-roots)))
                   (append (list (+ (plist-get certificate :constant-base) arg))
                           (and (eq kind 'varset) (list depth))))
             (when (eq kind 'varref) (copy-slot (plist-get certificate :result) after)))
            ('stack-set (copy-slot depth (- depth arg)))
            ('discard-n (when (/= 0 (logand arg 128)) (copy-slot depth after)))
            ((or 'primitive 'call)
             (let ((inputs (number-sequence (if (eq kind 'call) (+ (- depth arg) 1)
                                             (+ (- depth arg) 1)) depth)))
               ;; GNU Bindent_to supplies its optional MINIMUM as nil.
               ;; The existing exit triple already owns an authenticated nil.
               (when (= op 106)
                 (setq inputs (append inputs (list (+ (plist-get certificate :quit-base) 2)))))
               (when (and (eq kind 'primitive) (not (plist-get certificate :handler-p))
                          (memq op '(83 84 85 86 87 88 89 90 91 92 95)))
                 (let ((left (car inputs)) (right (or (cadr inputs) (car inputs))))
                   (emit (pcase op (83 'fixnum-dec) (84 'fixnum-inc) (85 'fixnum-eq)
                                  (86 'fixnum-gt) (87 'fixnum-lt) (88 'fixnum-le) (89 'fixnum-ge)
                                  (90 'fixnum-sub) (91 'fixnum-neg) (92 'fixnum-add) (95 'fixnum-mul))
                         (list (cons 'left-tag (* left 32)) (cons 'left-value (+ (* left 32) 8))
                               (cons 'right-tag (* right 32)) (cons 'right-value (+ (* right 32) 8))
                               (cons 'output-tag (* after 32)) (cons 'output-value (+ (* after 32) 8))
                               (cons 'output-pad1 (+ (* after 32) 16)) (cons 'output-pad2 (+ (* after 32) 24))
                               (cons 'slow (list 'arithmetic-slow pc)) (cons 'done (list 'arithmetic-done pc))))
                   (label (list 'arithmetic-slow pc))))
               (call (if (eq kind 'call) (- depth arg)
                       (cdr (assq (nth 1 (nelisp-native-funcall-v2-primitive op))
                                  (plist-get certificate :provider-roots)))) inputs)
               (copy-slot (plist-get certificate :result) after)
               (label (list 'arithmetic-done pc))
               (when (memq op '(144 145))
                 (frame-call (if (= op 144) 1 2)
                             (append (list (cdr (assq pc (plist-get certificate :frame-immediates))))
                                     (and (= op 144) (list after)))))))
            ('branch
             (if (= op 130) (emit 'jump (list (cons 'target arg)))
               (emit (if (memq op '(131 133)) 'nil-branch 'nonnull-branch)
                     (list (cons 'source depth) (cons 'tag-offset 0) (cons 'target arg)))))
            ('switch
             (let* ((info (assq pc (plist-get certificate :switch-targets)))
                    (table-name (list 'table pc)))
               (call (plist-get certificate :switch-root) (list (1- depth) depth (nth 1 info)))
               (emit 'switch (list (cons 'source (plist-get certificate :result)) (cons 'payload-offset 8)
                                   (cons 'target (aref row 2)) (cons 'table table-name)))
               (push (list table-name (nth 2 info)) tables)))
            ('return (emit 'return (list (cons 'status (+ 512 depth))
                                          (cons 'epilogue (if (plist-get certificate :frame-p) 'finish 'epilogue))))))
          (push (list pc start position) ranges)))
      ;; All ordinary quit edges share one rooted exit materialization.
      (label 'quit)
      (dotimes (i 3) (copy-slot (+ (plist-get certificate :quit-base) i)
                                (+ (plist-get certificate :exit-root-base) i)))
      (emit 'return (list (cons 'status (+ 1024 (plist-get certificate :exit-root-base)))
                               (cons 'epilogue (if (plist-get certificate :frame-p) 'finish 'epilogue))))
      (label 'bad) (emit 'bad nil)
      (when (plist-get certificate :frame-p)
        (label 'finish) (emit 'status-save nil)
        (when (plist-get certificate :handler-p)
          (emit 'status-branch (list (cons 'status (+ 1024 (plist-get certificate :exit-root-base)))
                                    (cons 'target 'leave)))
          (frame 11 (plist-get certificate :exit-root-base) (plist-get certificate :frame-result) 'landing-failure)
          (emit 'switch (list (cons 'source (plist-get certificate :frame-result)) (cons 'payload-offset 8)
                              (cons 'target 'bad) (cons 'table 'handler-table)))
          (push (list 'handler-table (plist-get (plist-get certificate :frame-analysis) :targets)) tables))
        (label 'leave)
        (frame 3 (plist-get certificate :staging) (plist-get certificate :frame-result) 'leave-failure)
        (emit 'status-restore nil) (emit 'jump (list (cons 'target 'epilogue)))
        (when (plist-get certificate :handler-p)
          (label 'landing-failure) (emit 'status-save nil) (emit 'jump (list (cons 'target 'leave))))
        (dolist (failure '(frame-failure leave-failure))
          (label failure) (emit 'status-save nil)
          (emit 'status-branch (list (cons 'status (+ 1024 (1+ (plist-get certificate :frame-result))))
                                    (cons 'target (if (eq failure 'frame-failure) 'finish 'epilogue))))
          (dotimes (i 3)
            (raw-copy (+ (plist-get certificate :frame-result) 1 i)
                      (+ (plist-get certificate :exit-root-base) i)))
          (emit 'return (list (cons 'status (+ 1024 (plist-get certificate :exit-root-base)))
                              (cons 'epilogue (if (eq failure 'frame-failure) 'finish 'epilogue))))))
      (label 'epilogue) (emit 'epilogue nil)
      (setq tables (nreverse tables))
      (dolist (table tables)
        (label (car table))
        (let ((bytes (make-string (* 4 (plist-get certificate :code-size)) 0)))
          (push bytes chunks) (setq position (+ position (length bytes)))))
      (let ((text (apply #'concat (nreverse chunks))))
        (dolist (fix fixups)
          (let ((offset (car fix)) (target (gethash (cadr fix) labels)))
            (unless target (error "Template unresolved label %S" (cadr fix)))
            (nelisp-native-template-patch32 text offset (- target (+ offset 4)))))
        (dolist (table tables)
          (let ((base (gethash (car table) labels)) (allowed (make-vector (plist-get certificate :code-size) nil)))
            (dolist (pc (cadr table)) (aset allowed pc t))
            (dotimes (pc (length allowed))
              (nelisp-native-template-patch32 text (+ base (* pc 4))
                                              (- (gethash (if (aref allowed pc) pc 'bad) labels) base)))))
        (list :text text :relocs (nreverse relocs) :pc-ranges (nreverse ranges))))))
(defun nelisp-native-template-manifest (recipe certificate assembled)
  "Publish an ordinary raw-v2 container with explicit template proof semantics."
  (let* ((text (plist-get assembled :text)) (size (length text))
         (gc (nelisp-native-load--raw-v2-contract)) (symbols (nelisp-native-load--raw-v2-symbols))
         (imports
          (mapcar (lambda (name)
                    (list :name name :kind 'func :index
                          (if (equal name "nl_root_pin_slot_v2")
                              (nelisp-native-load--raw-v2-conditional-import-index name)
                            (cl-position name nelisp-native-load-bridgeable-symbols :test #'equal))
                          :address-mode (if (equal name "nl_root_pin_slot_v2") 'conditional-root-slot-v1 'native-bridgeable-v1)
                          :abi (nelisp-native-load--runtime-abi-v2) :arity 6
                          :params '(u64 u64 u64 u64 u64 u64) :return 'u64))
                  (sort (delete-dups (mapcar (lambda (r) (plist-get r :symbol)) (plist-get assembled :relocs))) #'string<)))
         (exports (list (list :name nelisp-native-template-entry :value 0 :size size :arity 4
                             :params '(u64 u64 u64 u64) :return 'u64 :type 'func :abi (nelisp-native-load--runtime-abi-v2))))
         (manifest
          (list :format nelisp-native-load-raw-artifact-format-v2 :kind 'raw-runtime
                :runtime-kind 'gc-arena :runtime-abi (nelisp-native-load--runtime-abi-v2)
                :layout-id nelisp-native-load-raw-layout-id-v2 :arch nelisp-native-load-raw-supported-arch
                :binary-sha256 (nelisp-native-load-running-binary-sha256) :runtime-opt-in t
                :gc-contract-hash (nelisp-native-load--raw-v2-contract-hash gc)
                :gc-address-mode 'runtime-bridge-v1
                :gc-entries (cl-loop for p in gc for i from 0 collect
                                     (list :name (car p) :arity (cdr p) :index i :return 'u64 :abi (nelisp-native-load--runtime-abi-v2)))
                :gc-table-magic nelisp-native-load-raw-gc-table-magic :gc-table-count (length gc)
                :resolver-contract-version nelisp-native-load-raw-v2-import-contract-version
                :resolver-contract-hash (nelisp-native-load--raw-v2-import-contract-hash symbols)
                :native-template-proof-version nelisp-native-template-proof-version
                :native-template-proof (list :library nelisp-native-template-library-sha256 :input recipe
                                             :certificate certificate :pc-ranges (plist-get assembled :pc-ranges))
                :native (list :raw-abi (nelisp-native-load--runtime-abi-v2) :object-format 'nelisp-aot-raw-unit-v2
                              :text-size size :text-base64 (base64-encode-string text t)
                              :object-sha256 (secure-hash 'sha256 text) :object-size size
                              :exports exports :symbols exports :imports imports :extern-symbols (mapcar (lambda (i) (plist-get i :name)) imports)
                              :relocs (plist-get assembled :relocs) :data-size 0 :bss-size 0))))
    (when (nelisp-native-load--windows-p)
      (setq manifest (append manifest (list :target (nelisp-native-load--target-v2)))))
    (let* ((unsigned (nelisp-native-template--print manifest))
           (digest (secure-hash 'sha256 unsigned))
           (signed (append manifest (list :artifact-sha256 digest))))
      (when nelisp-native-template--serialization-receiver
        (funcall nelisp-native-template--serialization-receiver signed
                 (concat (substring unsigned 0 -1) " :artifact-sha256 "
                         (prin1-to-string digest) ")")))
      signed)))
(defun nelisp-native-template-bounded-data-p (value)
  "Bound inert proof data before plist traversal, printing or copying."
  (let ((todo (list (cons value 0))) (budget 20000) (valid t))
    (while (and todo valid (> budget 0))
      (let* ((item (pop todo)) (node (car item)) (depth (cdr item)))
        (setq budget (1- budget))
        (cond ((> depth 256) (setq valid nil))
              ((or (null node) (symbolp node) (numberp node)) nil)
              ((stringp node) (unless (<= (length node) 1048576) (setq valid nil)))
              ((consp node) (push (cons (car node) (1+ depth)) todo)
               (push (cons (cdr node) depth) todo))
              ((vectorp node)
               (if (> (length node) 4096) (setq valid nil)
                 (dotimes (i (length node)) (push (cons (aref node i) (1+ depth)) todo))))
              (t (setq valid nil)))))
    (and valid (null todo))))
(defun nelisp-native-template-check (manifest)
  "Authenticate input, root and patch proof plus exact emission.
No SSA, AST, optimizer or AOT compiler is involved. Producer compilation calls
its validator once. Explicit checked loads reconstruct the proof."
  (condition-case err
      (progn
        (unless (and (nelisp-native-template-bounded-data-p manifest)
                     (equal (plist-get manifest :native-template-proof-version) nelisp-native-template-proof-version))
          (error "Template proof shape/version refused"))
        (let* ((library (nelisp-native-template-open-library))
               (recipe (plist-get (plist-get manifest :native-template-proof) :input))
               (certificate (nelisp-native-template-validate recipe))
               (assembled (nelisp-native-template-assemble certificate library))
               (expected (nelisp-native-template-manifest recipe certificate assembled)))
          (unless (equal manifest expected) (error "Template proof/emission refused")))
        nil)
    (error (list (list :template-refused err)))))
(defun nelisp-native-template-compile (function)
  "Compile, validate once and atomically publish with the common trusted mapper."
  (unless (and (eq nelisp-native-cache-mode 'shared-v2)
               (eq nelisp-native-cache-guard-mode 'off))
    (error "Unsupported template compilation mode"))
  (let ((file (nelisp-native-cache-file function)))
    (unless file (error "Template cache identity unavailable"))
    (unless (file-exists-p file)
      ;; Library authentication happens before validation, copying or mapping.
      (let* ((serialized nil)
             (nelisp-native-template--serialization-receiver
              (lambda (manifest bytes) (setq serialized (cons manifest bytes))))
             (library (nelisp-native-template-open-library))
             (recipe (nelisp-native-template-recipe (nelisp-native-cache--function function)))
             (certificate (nelisp-native-template-validate recipe))
             (assembled (nelisp-native-template-assemble certificate library))
             (manifest (nelisp-native-template-manifest recipe certificate assembled))
             (_bounded (unless (nelisp-native-template-bounded-data-p manifest)
                         (error "Template publication proof bound refused")))
             (header (list :nelisp-native-cache 1 :canonical-manifest 'prebuilt-v1 :backend 'template
                           :abi (nelisp-native-cache-abi-hash) :input (nelisp-native-cache--input-hash function)
                           :entry nelisp-native-template-entry :arity (plist-get certificate :arity)
                           :root-count (plist-get certificate :root-count) :exit-root-base (plist-get certificate :exit-root-base)
                           :initializers (plist-get certificate :initializers)))
             ;; As in-house: a Windows temporary carries the owner and
             ;; protected DACL from creation; a plain file inherits an
             ;; Administrators owner on elevated tokens and is refused.
             (temporary (funcall (if (nelisp-native-load--windows-p)
                                     #'nelisp-native-windows-temporary #'make-temp-file)
                                 (expand-file-name ".publish-" (file-name-directory file)))))
        (unwind-protect
            (let ((coding-system-for-write 'utf-8-unix))
              (write-region (concat (nelisp-native-template--print header) "\n"
                                    (if (eq manifest (car serialized)) (cdr serialized)
                                      (nelisp-native-template--print manifest)) "\n") nil temporary nil 'silent)
              (nelisp-native-cache--publish temporary file)
              (setq nelisp-native-template--compile-count (1+ nelisp-native-template--compile-count)))
          (when (file-exists-p temporary) (delete-file temporary)))))
    file))
(provide 'nelisp-native-template)
