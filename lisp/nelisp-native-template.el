(defun nelisp-native-template-recipe (function)
  "Freeze readable input, retaining live switch tables only as constant roots."
  (unless (byte-code-function-p function) (error "Template requires materialized bytecode"))
  (unless (<= 4 (length function) 6) (error "Template function metadata refused"))
  (let ((constants (copy-sequence (aref function 2))) (live nil) (targets nil))
    (dotimes (i (length constants))
      (when (hash-table-p (aref constants i))
        (unless (<= (hash-table-count (aref constants i)) 4096)
          (error "Template switch table bound refused"))
        (maphash (lambda (_key target) (push target targets)) (aref constants i))
        (push i live) (aset constants i nil)))
    (let ((recipe (list :descriptor (aref function 0) :code-base64 (base64-encode-string (aref function 1) t)
                        :constants constants :stack-depth (aref function 3)
                        :function-length (length function)
                        :metadata (and (> (length function) 4) (aref function 4))
                        :interactive (and (> (length function) 5) (aref function 5)))))
      (when live (setq recipe (append recipe (list :live-hash-constants (nreverse live)
                                                  :switch-targets targets))))
      (unless (nelisp-native-template-bounded-data-p recipe)
        (error "Template relocation refused: unreadable constant/metadata; bytecode retained"))
      recipe)))
(defconst nelisp-native-template-compiler-modules
  '("lisp/nelisp-native-template.el" "lisp/nelisp-native-template-stencils.el"
    "lisp/nelisp-bytecode-native-rooted-cfg-contract.el" "lisp/nelisp-native-cache.el"
