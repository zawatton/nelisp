            ('bind (frame-call 1 (list (+ (plist-get certificate :constant-base) arg) depth)))
            ('unbind (frame-call 2 (list (cdr (assq pc (plist-get certificate :frame-immediates))))))
            ('frame (frame-call (pcase op (142 4) ((or 97 114) 5) (138 6) (140 7))
                                (and (= op 142) (list depth))))
