;;; nelisp-stdlib-where-is.el --- Reverse lookup of real sparse keymaps -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
(require 'nelisp-bytecode-compiler-input)
(defvar nelisp-stdlib-where-is--dialect-owner
  (symbol-function 'nelisp-bytecode-compiler-input-dialect))
(defvar nelisp-stdlib-where-is--owners nil)
(defun nelisp-stdlib-where-is--finite-list (value)
  "Validate a finite proper keymap spine before traversing its cells."
  (let ((slow value) (fast value))
    (while (consp fast)
      (setq fast (cdr fast))
      (when (consp fast)
        (setq fast (cdr fast) slow (cdr slow))
        (when (eq slow fast) (signal 'circular-list (list value)))))
    (when fast (signal 'wrong-type-argument (list 'listp fast))))
  value)
(defun nelisp-stdlib-where-is--live-p ()
  (dolist (owner nelisp-stdlib-where-is--owners)
    (unless (eq (symbol-function (car owner)) (cdr owner))
      (error "Reverse key lookup owner changed: %S" (car owner)))))
(defun nelisp-stdlib-where-is--unwrap (binding noindirect)
  (cond
   (noindirect binding)
   ((eq (car-safe binding) 'menu-item) (nth 2 binding))
   ((and (consp binding) (stringp (car binding))) (cdr binding))
   (t binding)))
(defun nelisp-stdlib-where-is--map (binding)
  (when (and (symbolp binding) (fboundp binding))
    (setq binding (indirect-function binding)))
  (and (keymapp binding) binding))
(defun nelisp-stdlib-where-is--normalize-sequence (key)
  "Normalize raw key events using the source-owned key sequence rule."
  (if (stringp key)
      (vconcat
       (if (multibyte-string-p key)
           (append key nil)
         (mapcar (lambda (c)
                   (if (> c 127)
                       (logxor c (logior 128 ?\M-\C-@))
                     c))
                 key)))
    key))
(defun nelisp-stdlib-where-is--events (event)
  (if (or (vectorp event) (stringp event))
      (nelisp-stdlib-where-is--normalize-sequence event)
    (vector event)))
(defun nelisp-stdlib-where-is--non-key-p (events)
  (let ((index 0) excluded)
    (while (< index (length events))
      (let ((event (aref events index)))
        (when (and (symbolp event) (get event 'non-key-event))
          (setq excluded t)))
      (setq index (1+ index)))
    excluded))
(defun nelisp-stdlib-where-is--entries (map prefix ancestors)
  "Enumerate actual sparse bindings breadth first, with inherited bindings."
  (let ((queue (list (list map prefix ancestors))) entries)
    (while queue
      (let* ((node (car queue)) (current (car node))
             (keys-prefix (cadr node)) (lineage (nth 2 node)))
        (setq queue (cdr queue))
        (while current
          (when (memq current lineage) (error "Cyclic keymap ancestry"))
          (push current lineage)
          (let ((tail (cdr current)))
            (nelisp-stdlib-where-is--finite-list tail)
            (while (and (consp tail) (not (eq (car tail) 'keymap)))
              (let ((item (car tail)))
                (cond
                 ((consp item)
                  (let* ((event (car item)) (raw (cdr item))
                         (binding (nelisp-stdlib-where-is--unwrap raw nil))
                         (submap (nelisp-stdlib-where-is--map binding))
                         (keys (vconcat keys-prefix (nelisp-stdlib-where-is--events event))))
                    (when (consp event) (error "Range key event reverse lookup unavailable"))
                    (unless (nelisp-stdlib-where-is--non-key-p keys)
                      (if submap
                          (setq queue (append queue (list (list submap keys lineage))))
                        (setq entries (append entries (list (cons keys raw))))))))
                 ((or (stringp item) (null item)) nil)
                 (t (error "Dense keymap reverse lookup unavailable"))))
              (setq tail (cdr tail)))
            (setq current (and (keymapp tail) tail))))))
    entries))
(defun nelisp-stdlib-where-is--lookup-map (map keys ancestors)
  "Resolve real prefix maps and inherited bindings in stored event vectors."
  (when (memq map ancestors) (error "Cyclic keymap lookup"))
  (let ((tail (cdr map)) binding found)
    (nelisp-stdlib-where-is--finite-list tail)
    (while (and (consp tail) (not found) (not (eq (car tail) 'keymap)))
      (let ((item (car tail)))
        (when (consp item)
          (let* ((events (nelisp-stdlib-where-is--events (car item)))
                 (count (length events)))
            (when (and (<= count (length keys))
                       (equal events (substring keys 0 count)))
              (setq binding (nelisp-stdlib-where-is--unwrap (cdr item) nil))
              (if (= count (length keys))
                  (setq found t)
                (let ((prefix-map (nelisp-stdlib-where-is--map binding)))
                  (setq binding
                        (if prefix-map
                            (nelisp-stdlib-where-is--lookup-map
                             prefix-map (substring keys count) (cons map ancestors))
                          count)
                        found t)))))))
      (setq tail (cdr tail)))
    (if found binding
      (when (keymapp tail)
        (nelisp-stdlib-where-is--lookup-map tail keys (cons map ancestors))))))
(defun nelisp-stdlib-where-is--lookup (maps keys)
  (let (binding)
    (while (and maps (null binding))
      (setq binding (nelisp-stdlib-where-is--lookup-map (car maps) keys nil)
            maps (cdr maps)))
    binding))
(defun nelisp-stdlib-where-is--remap (maps definition)
  (let (seen next)
    (while (and (symbolp definition)
                (setq next (nelisp-stdlib-where-is--lookup maps (vector 'remap definition))))
      (when (memq definition seen) (error "Cyclic command remapping"))
      (push definition seen)
      (setq definition (nelisp-stdlib-where-is--unwrap next nil)))
    definition))
(defun nelisp-stdlib-where-is--find
    (definition &optional keymap firstonly noindirect no-remap)
  "Find genuine sparse key bindings, including menus, parents, and remapping.
Active-map enumeration and preferred-modifier selection are refused when their
real runtime owners are unavailable.  No fabricated binding list is returned."
  (nelisp-stdlib-where-is--live-p)
  (when (and firstonly (not (eq firstonly 'non-ascii)))
    (error "Preferred-modifier reverse lookup unavailable"))
  (when (and noindirect (consp definition))
    (error "Raw menu-object reverse lookup unavailable"))
  (let ((maps
         (cond
          ((null keymap)
           (unless (fboundp 'current-active-maps)
             (error "Active keymap enumeration unavailable"))
           (current-active-maps))
          ((keymapp keymap)
           (unless (and (boundp 'global-map) (keymapp global-map))
             (error "Actual global keymap unavailable"))
           (list keymap global-map))
          ((consp keymap) (nelisp-stdlib-where-is--finite-list keymap) keymap)
          (t (signal 'wrong-type-argument (list 'keymapp keymap)))))
        entries seen keys)
    (dolist (map maps)
      (unless (keymapp map) (signal 'wrong-type-argument (list 'keymapp map)))
      (setq entries (append entries (nelisp-stdlib-where-is--entries map [] nil))))
    (let ((target (if no-remap definition
                    (nelisp-stdlib-where-is--remap maps definition))))
      (dolist (entry entries)
        (let* ((sequence (car entry))
               (remap (eq (aref sequence 0) 'remap))
               (effective (nelisp-stdlib-where-is--unwrap
                           (nelisp-stdlib-where-is--lookup maps sequence) nil))
               (binding (if noindirect (cdr entry) effective)))
          (unless (member sequence seen)
            (push sequence seen)
            (when (and (or (not noindirect)
                           (equal effective (nelisp-stdlib-where-is--unwrap (cdr entry) nil)))
                       (or no-remap (not remap))
                       (equal (if (or no-remap remap) binding
                                (nelisp-stdlib-where-is--remap maps binding))
                              target))
              (setq keys (append keys (list sequence))))))))
    (if firstonly (car keys) keys)))
(defun nelisp-stdlib-where-is-install ()
  "Install sparse reverse lookup only on a genuinely verified standalone."
  (unless (eq (symbol-function 'nelisp-bytecode-compiler-input-dialect)
              nelisp-stdlib-where-is--dialect-owner)
    (error "Reverse lookup evidence owner changed"))
  (let ((evidence (nelisp-bytecode-compiler-input-dialect)))
    (unless (and (eq (plist-get evidence :status) 'pinned)
                 (equal (plist-get evidence :dialect) "GNU Emacs 31.1"))
      (error "Reverse lookup requires verified GNU31 dialect"))
    (if (not (eq (plist-get evidence :runtime-evidence) 'standalone-build-verified))
        'preserved
      (unless nelisp-stdlib-where-is--owners
        (setq nelisp-stdlib-where-is--owners
              (mapcar (lambda (name) (cons name (symbol-function name)))
                      '(keymapp indirect-function nelisp-stdlib-where-is--normalize-sequence
                        nelisp-stdlib-where-is--finite-list))))
      (nelisp-stdlib-where-is--live-p)
      (fset 'where-is-internal #'nelisp-stdlib-where-is--find)
      'installed)))
(provide 'nelisp-stdlib-where-is)
