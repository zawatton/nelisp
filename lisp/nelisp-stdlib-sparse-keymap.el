(require 'nelisp-bytecode-compiler-input)
(defvar nelisp-stdlib-sparse-keymap--dialect-owner
  (symbol-function 'nelisp-bytecode-compiler-input-dialect))
(defvar nelisp-stdlib-sparse-keymap--owners nil)
(defun nelisp-stdlib-sparse-keymap--finite-list (value)
  "Validate a finite proper keymap spine before traversing its cells."
  (let ((slow value) (fast value))
    (while (consp fast)
      (setq fast (cdr fast))
      (when (consp fast)
        (setq fast (cdr fast) slow (cdr slow))
        (when (eq slow fast) (signal 'circular-list (list value)))))
    (when fast (signal 'wrong-type-argument (list 'listp fast))))
  value)
(defun nelisp-stdlib-sparse-keymap--normalize-sequence (key)
  "Normalize raw key events using the source-owned key sequence rule."
  (if (stringp key)
      (vconcat
       (if (multibyte-string-p key)
           (append key nil)
         (mapcar (lambda (c)
                   (if (> c 127)
                       (logxor c (logior 128 ?\M-\C-@))
                     c))
                 key)))
    key))
(defun nelisp-stdlib-sparse-keymap--get-keyelt (object)
  "Mirror GNU Emacs 31.1 src/keymap.c:get_keyelt.  See the block
comment above this definition for which two binding shapes this
unwraps and why."
  (let (seen)
   (catch 'nelisp-stdlib-sparse-keymap--get-keyelt-done
    (while t
      (when (consp object)
        (when (memq object seen) (signal 'circular-list (list object)))
        (push object seen))
      (cond
       ((not (consp object)) (throw 'nelisp-stdlib-sparse-keymap--get-keyelt-done object))
       ((eq (car object) 'menu-item)
        (if (consp (cdr object))
            (let ((rest (cdr (cdr object))))
              (setq object (if (consp rest) (car rest) rest)))
          (throw 'nelisp-stdlib-sparse-keymap--get-keyelt-done object)))
       ((stringp (car object)) (setq object (cdr object)))
       (t (throw 'nelisp-stdlib-sparse-keymap--get-keyelt-done object)))))))
(defun nelisp-stdlib-sparse-keymap--live-p ()
  (dolist (owner nelisp-stdlib-sparse-keymap--owners)
    (unless (eq (symbol-function (car owner)) (cdr owner))
      (error "Sparse keymap owner changed: %S" (car owner)))))
(defun nelisp-stdlib-sparse-keymap--keymapp (object)
  "Recognize live prefix symbols and unloaded GNU keymap autoloads.
Follow actual function cells without loading or calling their definitions."
  (nelisp-stdlib-sparse-keymap--live-p)
  (let ((original object) (seen nil))
    (while (and (symbolp object) object (fboundp object))
      (when (memq object seen)
        (signal 'cyclic-function-indirection (list original)))
      (push object seen)
      (setq object (symbol-function object)))
    (and (consp object)
         (or (eq (car object) 'keymap)
             (and (symbolp original) (eq (car object) 'autoload)
                  (eq (nth 4 object) 'keymap)))
         t)))
(defun nelisp-stdlib-sparse-keymap--map (map)
  (when (and (symbolp map) (fboundp map)) (setq map (indirect-function map)))
  (unless (and (consp map) (eq (car map) 'keymap))
    (signal 'wrong-type-argument (list 'keymapp map)))
  map)
(defun nelisp-stdlib-sparse-keymap--prefix (binding)
  (when (and (symbolp binding) (fboundp binding))
    (setq binding (indirect-function binding)))
  (and (consp binding) (eq (car binding) 'keymap) binding))
(defun nelisp-stdlib-sparse-keymap--events (key)
  (unless (or (stringp key) (vectorp key))
    (signal 'wrong-type-argument (list 'arrayp key)))
  (let ((events (nelisp-stdlib-sparse-keymap--normalize-sequence key)) (index 0) decoded)
    (while (< index (length events))
      (let ((event (aref events index)))
        (unless (or (symbolp event) (and (integerp event) (>= event 0)))
          (error "Unsupported sparse key event: %S" event))
        ;; Meta events address the actual escape-prefix map.  Use the real
        ;; public override when present, otherwise the existing ESC parser.
        (when (and (integerp event) (/= 0 (logand event 134217728)))
          (let ((prefix (if (boundp 'meta-prefix-char) (symbol-value 'meta-prefix-char)
                          (aref (key-parse "ESC") 0))))
            (unless (integerp prefix) (error "Meta prefix is unavailable"))
            (push prefix decoded)
            (setq event (logand event (lognot 134217728)))))
        (push event decoded))
      (setq index (1+ index)))
    (vconcat (nreverse decoded))))
(defun nelisp-stdlib-sparse-keymap--parent (map)
  (let ((tail (cdr map)))
    (while (and (consp tail) (not (eq (car tail) 'keymap)))
      (setq tail (cdr tail)))
    (and (consp tail) (eq (car tail) 'keymap) tail)))
(defun nelisp-stdlib-sparse-keymap--character-event-p (event)
  "Return non-nil for an unmodified character address in a real char-table."
  (and (integerp event) (>= event 0) (<= event (max-char))))
(defun nelisp-stdlib-sparse-keymap--table (map)
  (let ((tail (cdr map)) table)
    (while (and (consp tail) (not table) (not (eq (car tail) 'keymap)))
      (when (char-table-p (car tail)) (setq table (car tail)))
      (setq tail (cdr tail)))
    table))
(defun nelisp-stdlib-sparse-keymap--own (map event)
  (let ((tail (cdr map)) found)
    (while (and (consp tail) (not found) (not (eq (car tail) 'keymap)))
      (when (and (consp (car tail)) (equal (caar tail) event))
        (setq found (car tail)))
      (setq tail (cdr tail)))
    (or found
        (let ((table (nelisp-stdlib-sparse-keymap--table map)))
          (when (and table (nelisp-stdlib-sparse-keymap--character-event-p event))
            (let ((binding (aref table event)))
              (and binding (cons event (if (eq binding t) nil binding)))))))))
(defun nelisp-stdlib-sparse-keymap--put (map event definition remove)
  (let ((previous map) (tail (cdr map)) found)
    (while (and (consp tail) (not found) (not (eq (car tail) 'keymap)))
      (if (and (consp (car tail)) (equal (caar tail) event))
          (setq found tail)
        (setq previous tail tail (cdr tail))))
    (cond ((and (nelisp-stdlib-sparse-keymap--table map)
                (nelisp-stdlib-sparse-keymap--character-event-p event))
           (aset (nelisp-stdlib-sparse-keymap--table map) event
                 (cond (remove nil) ((null definition) t) (t definition))))
          (found (if remove (setcdr previous (cdr found))
                  (setcdr (car found) definition)))
          ((not remove)
           (let ((anchor (if (char-table-p (cadr map)) (cdr map) map)))
             (setcdr anchor (cons (cons event definition) (cdr anchor))))))
    definition))
(defun nelisp-stdlib-sparse-keymap--normalize (map)
  "Convert legacy full-vector entries without inventing or dropping bindings."
  (nelisp-stdlib-sparse-keymap--finite-list (cdr map))
  (let ((previous map) (tail (cdr map)) legacy)
    (while (and (consp tail) (not (eq (car tail) 'keymap)))
      (let ((item (car tail)))
        (cond
         ((and (consp item) (or (vectorp (car item)) (stringp (car item))))
          (push item legacy)
          (setcdr previous (cdr tail))
          (setq tail (cdr tail)))
         ((or (consp item) (stringp item) (null item) (char-table-p item))
          (setq previous tail tail (cdr tail)))
         (t (error "Dense sparse-keymap adaptation unavailable")))))
    (dolist (item legacy)
      (nelisp-stdlib-sparse-keymap--define-events
       map (nelisp-stdlib-sparse-keymap--events (car item)) (cdr item) nil)))
  map)
(defun nelisp-stdlib-sparse-keymap--raw (map event ancestors)
  (when (memq map ancestors) (error "Cyclic keymap parent"))
  (nelisp-stdlib-sparse-keymap--normalize map)
  (let ((entry (nelisp-stdlib-sparse-keymap--own map event)))
    (if entry (cdr entry)
      (let ((parent (nelisp-stdlib-sparse-keymap--parent map)))
        (when parent
          (nelisp-stdlib-sparse-keymap--raw parent event (cons map ancestors)))))))
(defun nelisp-stdlib-sparse-keymap--define-events (map events definition remove)
  (when (> (length events) 0)
   (let ((index 0))
    (while (< index (1- (length events)))
      (let* ((event (aref events index))
             (entry (nelisp-stdlib-sparse-keymap--own map event))
             (binding (and entry (nelisp-stdlib-sparse-keymap--get-keyelt (cdr entry)))))
        (unless binding
          (let* ((inherited (nelisp-stdlib-sparse-keymap--raw map event nil))
                 (prefix (make-sparse-keymap)))
            (when (nelisp-stdlib-sparse-keymap--prefix (nelisp-stdlib-sparse-keymap--get-keyelt inherited))
              (set-keymap-parent prefix (nelisp-stdlib-sparse-keymap--prefix
                                        (nelisp-stdlib-sparse-keymap--get-keyelt inherited))))
            (nelisp-stdlib-sparse-keymap--put map event prefix nil)
            (setq binding prefix)))
        (unless (nelisp-stdlib-sparse-keymap--prefix binding)
          (error "Key sequence starts with non-prefix key"))
        (setq map (nelisp-stdlib-sparse-keymap--prefix binding))
        (nelisp-stdlib-sparse-keymap--normalize map))
      (setq index (1+ index)))
    (nelisp-stdlib-sparse-keymap--put map (aref events index) definition remove))))
(defun nelisp-stdlib-sparse-keymap--define (map key definition &optional remove)
  "Store real scalar event bindings in real prefix maps."
  (nelisp-stdlib-sparse-keymap--live-p)
  (setq map (nelisp-stdlib-sparse-keymap--map map))
  (let ((events (nelisp-stdlib-sparse-keymap--events key)))
    (when (> (length events) 0)
      (nelisp-stdlib-sparse-keymap--normalize map)
      (nelisp-stdlib-sparse-keymap--define-events map events definition remove))))
(defun nelisp-stdlib-sparse-keymap--lookup (map key &optional accept-default)
  "Resolve scalar events, prefixes and parent bindings in actual sparse maps."
  (nelisp-stdlib-sparse-keymap--live-p)
  (setq map (nelisp-stdlib-sparse-keymap--map map))
  (let ((events (nelisp-stdlib-sparse-keymap--events key)) (index 0) binding done)
    (if (= (length events) 0) map
      (while (and (not done) (< index (length events)))
        (setq binding (nelisp-stdlib-sparse-keymap--raw map (aref events index) nil))
        (when (and (null binding) accept-default)
          (setq binding (nelisp-stdlib-sparse-keymap--raw map t nil)))
        (setq binding (nelisp-stdlib-sparse-keymap--get-keyelt binding) index (1+ index))
        (if (= index (length events)) (setq done t)
          (if (nelisp-stdlib-sparse-keymap--prefix binding)
              (setq map (nelisp-stdlib-sparse-keymap--prefix binding))
            (setq binding index done t))))
      binding)))
(defun nelisp-stdlib-sparse-keymap--enumerate (function keymap &optional sort-first)
  "Enumerate actual event bindings after adapting legacy vector-key storage.
Visit real character-table ranges and inherited bindings without flattening
  prefix maps.  Sorted enumeration is outside this standalone provider."
  (nelisp-stdlib-sparse-keymap--live-p)
  (if sort-first
      (error "Sorted keymap enumeration provider is unavailable")
    (let ((map (nelisp-stdlib-sparse-keymap--map keymap)) seen)
      (while map
        (when (memq map seen) (error "Cyclic keymap parent"))
        (push map seen)
        (nelisp-stdlib-sparse-keymap--normalize map)
        (let ((tail (cdr map)))
          (while (and (consp tail) (not (eq (car tail) 'keymap)))
            (let ((item (car tail)))
              (cond
               ((char-table-p item)
                (unless (fboundp 'map-char-table)
                  (error "Character-table enumeration provider is unavailable"))
                (map-char-table
                 (lambda (event definition)
                   ;; map-char-table lends a reused range cons.  The public
                   ;; keymap callback owns its event, as in GNU map-keymap.
                   (when definition
                     (funcall function (if (consp event) (copy-tree event) event)
                              (if (eq definition t) nil definition)))) item))
               ((consp item) (funcall function (car item) (cdr item)))))
            (setq tail (cdr tail))))
        (setq map (nelisp-stdlib-sparse-keymap--parent map))))
    nil))
(defun nelisp-stdlib-sparse-keymap-install ()
  "Install source-owned sparse key semantics without changing GNU hosts."
  (unless (eq (symbol-function 'nelisp-bytecode-compiler-input-dialect)
              nelisp-stdlib-sparse-keymap--dialect-owner)
    (error "Sparse keymap evidence owner changed"))
  (let ((evidence (nelisp-bytecode-compiler-input-dialect)))
    (unless (and (eq (plist-get evidence :status) 'pinned)
                 (equal (plist-get evidence :dialect) "GNU Emacs 31.1"))
      (error "Sparse keymaps require verified GNU31 dialect"))
    (if (not (eq (plist-get evidence :runtime-evidence) 'standalone-build-verified))
        'preserved
      (unless nelisp-stdlib-sparse-keymap--owners
        (fset 'keymapp #'nelisp-stdlib-sparse-keymap--keymapp)
        (setq nelisp-stdlib-sparse-keymap--owners
              (mapcar (lambda (name) (cons name (symbol-function name)))
                      '(keymapp nelisp-stdlib-sparse-keymap--keymapp symbol-function fboundp
                        memq nth symbolp signal
                        indirect-function make-sparse-keymap set-keymap-parent
                        key-parse char-table-p max-char aref aset map-char-table
                        nelisp-stdlib-sparse-keymap--normalize-sequence nelisp-stdlib-sparse-keymap--get-keyelt
                        nelisp-stdlib-sparse-keymap--finite-list))))
      (nelisp-stdlib-sparse-keymap--live-p)
      (fset 'define-key #'nelisp-stdlib-sparse-keymap--define)
      (fset 'lookup-key #'nelisp-stdlib-sparse-keymap--lookup)
      (fset 'map-keymap #'nelisp-stdlib-sparse-keymap--enumerate)
      'installed)))
(provide 'nelisp-stdlib-sparse-keymap)
